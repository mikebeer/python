/* =========================================================================
   PY.CREXX  --  a Python 3 subset interpreter written in CREXX (Level B)

   Usage:
       crexx py.crexx -args [-c code] [file.py [arg ...]]
   With no file the program is read from standard input.
   ========================================================================= */
options levelb numeric_classic
import rxfnsb
import rxfloat
import rxsocket
import rxplatform
import _rxsysb
namespace py expose rc_exit obuf h_out h_err h_in stdin_eof rnd_s nsargs,
   sargs wsch nameboot clsboot bboot aliasboot kwlist ops2 tx tlen tp,
   lx_brk lx_nind lnum ntk tk_t tk_s tk_i tk_l tk_f ind_s tpp pe pe_msg,
   nnode n_t n_a n_b n_c n_d n_e n_y n_s n_ln n_ic n_ig n_iv nal al psp ps,
   nsc cursc sc_kind sc_par sc_n sc_fl sc_id sc_rf0 sc_cd scm nrf rf_node,
   rf_sc rf_dep ncv cv_name cv_slot cv_scope comp_result npq pq_name pq_def,
   pq_kind nfd fd_np fd_nk fd_ps fd_vs fd_ks fd_nr fd_ns fd_fl fd_cd,
   fd_body fd_cx fd_gd fd_name fd_mod npr pr_name pr_def pr_kind pr_slot,
   ncd cd_name cd_body cd_ns cd_cv0 cd_cv1 cd_obj cd_sc nob wd nct ctl ny,
   yl gcthr gcmin gcfix gcpoison gsp gstk fo_head sfl bfl nbfl orph_h dd_fh,
   de_fh maxfs gc_count gn_fh gn_nx gsf gc_freed ob_k ob_c ob_n ob_p ob_x,
   ob_y ob_s ob_f ob_g nat_skip bm_names npcx_f npcx_d cx_re cx_im cx_re2,
   cx_im2 cr_r cr_i nat_at nsl sl sl_a sl_b sl_n chr_oop nnid nid_name nidm,
   ncls cl_name cl_base cl_ns cl_flags cl_obj cl_dflt ca sm cgen kcls opd,
   ropd iopd cmpd cmpr bimap modattr modo bi_name bi_oop range_oop,
   identity_oop ndd nde dd_head dd_tail dd_n de_key de_val de_next de_live,
   de_hk dmap nvp vp fcm fcs cfl ncf npw fl_head gfb asp ast asn cdepth unw,
   unw_v exc_cur ev_self ev_bm ea_np ea_nk depth_guard ngn ngs gn_fd gn_fb,
   gn_st gn_sp gn_rb gn_val gs_n gs_s gs_a gs_b nfl fl_h fl_mode fl_txt,
   fl_pos bq brm sg mg sq sr fx_d fx_q fx_e fneg_max nmod pypath script_dir,
   mod_name mod_file mod_pkg mod_pdir mod_ispkg mod_sc mod_fb mod_obj,
   mod_dyn modx hyb cur_mi parse_mi parse_dyn cur_msc ndyn dyn_mi dyn_slot,
   dyn_val nbn bn_sc bn_name bn_slot sys_modules syspath nsyspath imp_file,
   imp_ispkg imp_pdir imp_quiet natives shadow cl_mod cl_bt cl_ms cl_mn,
   cl_bs cl_bn mro_a bs_a nmro nbs nca ca_c ca_n nis is_c is_n is_s gn_ret,
   gen_throw mod_fsz parse_dyn_init fmt_nested fmt_auto_in fmt_auto_out,
   fnattr dd_own bl_a bl_n sq_a sq_s sq_e sq_p sup_c npn nfh npf npta nptb,
   nptc npsel np_sc nprs nprn npcat npco npcc npcd npcs npit npax npnb npes,
   npip npfp npxp npnf npls npstr npsm npnd np_sep np_ip np_fp np_es np_ds,
   np_de nti ntf nts ntn ntnd ntfb ntfi ntff npfl npil np_outer np_n,
   np_inner np_axn np_hasax np_axv np_ddof np_nidT

arg av = .string[]
if av.0 >= 1 then do
  if av[1] == "--noinit" then exit 0
end
call init
memstat = 0
if av.0 >= 1 then do
  if av[1] == "--noboot" then exit 0
end
script = ""
code = ""
have_code = 0
nfiles = 0
ia = 1
do while ia <= av.0
  oa = av[ia]
  if left(oa, 9) == "--pypath=" & nfiles = 0 & have_code = 0 then pypath = substr(oa, 10)
  else if oa == "--memstat" & nfiles = 0 & have_code = 0 then memstat = 1
  else if left(oa, 10) == "--gcstress" & nfiles = 0 & have_code = 0 then do
    gcfix = substr(oa, 12) as .int
    gcpoison = 1
    gcmin = gcfix
    gcthr = gcfix
  end
  else if left(oa, 8) == "--gcfix=" & nfiles = 0 & have_code = 0 then do
    gcfix = substr(oa, 9) as .int
    gcmin = gcfix
    gcthr = gcfix
  end
  else if oa == "--nogc" & nfiles = 0 & have_code = 0 then do
    gcmin = 2000000000
    gcthr = 2000000000
  end
  else if oa == "-c" & ia < av.0 & nfiles = 0 & have_code = 0 then do
    ia = ia + 1
    code = av[ia]
    have_code = 1
    nsargs = nsargs + 1
    sargs[nsargs] = "-c"
  end
  else if (oa == "-h" | oa == "--help") & nfiles = 0 & have_code = 0 then do
    say "usage: py [-c code | file.py] [arg ...]"
    exit 0
  end
  else do
    if nfiles = 0 & have_code = 0 then do
      script = oa
      nfiles = 1
    end
    nsargs = nsargs + 1
    sargs[nsargs] = oa
  end
  ia = ia + 1
end
if nfiles = 1 then do
  ip = lastpos("/", script)
  if ip > 1 then script_dir = left(script, ip - 1)
  else if ip = 1 then script_dir = "/"
end
call boot
if have_code = 1 then rc_exit = run_source(code, "<string>")
else if nfiles = 1 then do
  utxt = read_file(script)
  if utxt == "" & file_exists(script) = 0 then do
    call errs "py: can't open file '" || script || "': [Errno 2] No such file or directory" || '0a'x
    rc_exit = 2
  end
  else rc_exit = run_source(utxt, script)
end
else do
  utxt = ""
  eofl = 0
  line = ""
  do forever
    line = ""
    assembler freadline line, h_in
    assembler feof eofl, h_in
    if eofl > 0 & length(line) = 0 then leave
    utxt = utxt || line || '0a'x
  end
  rc_exit = run_source(utxt, "<stdin>")
end
call flush_out
if memstat = 1 then call errs "memstat nob=" || nob || " nsl=" || nsl || " nvp=" || nvp || " npn=" || npn || " nde=" || nde || " ndd=" || ndd || " ngn=" || ngn || " ngs=" || ngs || " gcs=" || gc_count || " freed=" || gc_freed || " nid=" || nnid || " nmro=" || nmro || '0a'x
exit rc_exit

/* ---------------------------------------------------------------------
   Reading a whole file
   --------------------------------------------------------------------- */
read_file: procedure = .string
  arg fn = .string
  fid = .int
  eof = .int
  rcx = .int
  line = .string
  acc = .string
  chunk = .string
  nl = .int
  rmode = .string
  rmode = "r"
  fid = 0
  assembler fopen fid, fn, rmode
  if fid = 0 then return ""
  acc = ""
  chunk = ""
  nl = 0
  eof = 0
  do while eof = 0
    line = ""
    assembler freadline line, fid
    assembler feof eof, fid
    if eof > 0 & length(line) = 0 then leave
    if right(line, 1) == '0d'x then line = left(line, length(line) - 1)
    chunk = chunk || line || '0a'x
    nl = nl + 1
    if nl >= 100 then do
      acc = acc || chunk
      chunk = ""
      nl = 0
    end
  end
  assembler fclose rcx, fid
  return acc || chunk

file_exists: procedure = .int
  arg fn = .string
  fid = .int
  rcx = .int
  rmode = .string
  rmode = "r"
  fid = 0
  assembler fopen fid, fn, rmode
  if fid = 0 then return 0
  assembler fclose rcx, fid
  return 1

/* ---------------------------------------------------------------------
   Running a program text; returns the process exit code
   --------------------------------------------------------------------- */
run_source: procedure = .int
  arg src = .string, name = .string
  body = .int
  sc = .int
  rcode = .int
  e = .int
  c = .int
  a = .int
  s = .string
  v = .int
  mi = .int
  i = .int
  mi = new_module("__main__", name, 0, "")
  call reg_module "__main__", mod_obj[mi]
  body = parse_module(src, mi)
  if pe = 1 then do
    call errs "  File " || '"' || name || '"' || '0a'x || pe_msg || '0a'x
    return 1
  end
  sc = mod_sc[mi]
  mod_fsz[mi] = sc_n[sc] + 1 + 64
  if mod_dyn[mi] = 1 then mod_fsz[mi] = mod_fsz[mi] + 512
  gfb = alloc_frame(mod_fsz[mi])
  mod_fb[mi] = gfb
  cur_mi = mi
  call setg mi, "__name__", mkstr("__main__")
  call setg mi, "__file__", mkstr(name)
  call setg mi, "__package__", 2
  do i = 1 to ndyn
    if dyn_mi[i] = mi then vp[gfb + dyn_slot[i]] = dyn_val[i]
  end
  unw = 0
  exc_cur = 0
  call ex body, gfb
  if unw = 0 then return 0
  rcode = 1
  if unw = 4 then do
    e = unw_v
    unw = 0
    c = ob_c[e % 2]
    if cls_issub(c, 47) = 1 then do
      a = exc_args(e)
      if ob_n[a % 2] = 0 then return 0
      v = sl[ob_p[a % 2]]
      if v = 2 then return 0
      if numkind(v) = 1 then return ival(v) // 256
      call errs str_of(v) || '0a'x
      return 1
    end
    s = str_of(e)
    unw = 0
    call errs "Traceback (most recent call last):" || '0a'x
    call errs '  File "' || name || '", line 1, in <module>' || '0a'x
    if s == "" then call errs cl_name[c] || '0a'x
    else call errs cl_name[c] || ": " || s || '0a'x
    return 1
  end
  unw = 0
  return 0

/* ---------------------------------------------------------------------
   init: declare and initialise all shared state
   --------------------------------------------------------------------- */
init: procedure = .void
  rc_exit = 0
  obuf = ""
  h_out = _open("stdout", "w")
  h_err = _open("stderr", "w")
  h_in = _open("stdin", "r")
  stdin_eof = 0
  rnd_s = 12345
  nsargs = 0
  sargs = .string[]
  wsch = '20090a0b0c0d'x
  nameboot = "add all any append appendleft argmax argmin args astype bit_length capitalize casefold center clear clip close closed conjugate copy count cumsum"
  nameboot = nameboot || " decode denominator difference difference_update discard dot dtype encode endswith expandtabs extend fill find flatten flush format fromhex fromkeys"
  nameboot = nameboot || " from_bytes get getter hex imag index insert intersection intersection_update isalnum isalpha isascii isdecimal isdigit isdisjoint isidentifier islower"
  nameboot = nameboot || " isnumeric isspace issubset issuperset istitle isupper is_integer item items join keys ljust lower lstrip max mean min most_common name ndim numerator"
  nameboot = nameboot || " partition pop popitem popleft prod ravel read readline readlines real remove removeprefix removesuffix replace reshape reverse rfind rindex rjust"
  nameboot = nameboot || " round rpartition rsplit rstrip send setdefault setter shape size sort split splitlines start startswith std step stop strip sum swapcase"
  nameboot = nameboot || " symmetric_difference throw title tolist to_bytes translate transpose union update upper value values var write writelines zfill __abs__ __add__"
  nameboot = nameboot || " __and__ __bases__ __bool__ __call__ __class__ __contains__ __delattr__ __delitem__ __dict__ __divmod__ __doc__ __enter__ __eq__ __exit__ __float__"
  nameboot = nameboot || " __floordiv__ __format__ __func__ __getattribute__ __getattr__ __getitem__ __ge__ __gt__ __hash__ __index__ __init__ __int__ __invert__ __iter__"
  nameboot = nameboot || " __len__ __le__ __lshift__ __lt__ __matmul__ __missing__ __module__ __mod__ __mro__ __mul__ __name__ __neg__ __new__ __next__ __ne__ __or__ __pos__"
  nameboot = nameboot || " __pow__ __qualname__ __radd__ __rdivmod__ __repr__ __rfloordiv__ __rmod__ __rmul__ __round__ __rpow__ __rshift__ __rsub__ __rtruediv__ __self__"
  nameboot = nameboot || " __setattr__ __setitem__ __str__ __sub__ __truediv__ __xor__"
  clsboot = "object/0/1/1 type/1/1/1 int/1/1/1 float/1/1/1 bool/3/1/1 str/1/1/1 list/1/1/1 tuple/1/1/1 dict/1/1/1 set/1/1/1 range/1/1/1 NoneType/1/1/0"
  clsboot = clsboot || " function/1/1/0 builtin_function_or_method/1/1/0 method/1/1/0 generator/1/1/0 iterator/1/1/0 module/1/1/0 slice/1/1/1 ellipsis/1/1/0"
