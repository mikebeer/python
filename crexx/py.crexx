/* ---------------------------------------------------------------------
   boot: special objects, classes, built-in functions, modules
   --------------------------------------------------------------------- */
fld: procedure = .string
  arg spec = .string, k = .int
  p = .int
  q = .int
  i = .int
  p = 1
  do i = 2 to k
    p = pos("/", spec, p) + 1
  end
  q = pos("/", spec, p)
  if q = 0 then return substr(spec, p)
  return substr(spec, p, q - p)

boot: procedure = .void
  i = .int
  c = .int
  o = .int
  nm = .string
  spec = .string
  w = .string
  p = .int
  l = .int
  t = .int
  /* None, True, False, Ellipsis, NotImplemented are objects 1 to 5 */
  o = newobj(1)
  o = newobj(2)
  o = newobj(2)
  o = newobj(27)
  o = newobj(28)
  do i = 1 to words(nameboot)
    o = nameid(word(nameboot, i))
  end
  do i = 1 to words(clsboot)
    spec = word(clsboot, i)
    c = define_class(fld(spec, 1), fld(spec, 2) as .int)
    cl_flags[c] = fld(spec, 3) as .int
    if fld(spec, 4) == "1" then bimap[fld(spec, 1)] = cl_obj[c] as .string
  end
  range_oop = cl_obj[11]
  do i = 1 to words(bboot)
    nm = word(bboot, i)
    p = lastpos(".", nm)
    bi_name[i] = substr(nm, p + 1)
    o = newobj(13)
    ob_x[o % 2] = i
    bi_oop[i] = o
    if p > 0 then modattr[nm] = o as .string
    else if left(nm, 1) \== "_" then bimap[nm] = o as .string
  end
  do i = 1 to words(aliasboot)
    spec = word(aliasboot, i)
    p = pos("=", spec)
    modattr[left(spec, p - 1)] = bi_oop[substr(spec, p + 1) as .int] as .string
  end
  identity_oop = bi_oop[44]
  /* kind -> class */
  kcls[1] = 12
  kcls[2] = 5
  kcls[3] = 3
  kcls[4] = 3
  kcls[5] = 4
  kcls[6] = 6
  kcls[7] = 7
  kcls[8] = 8
  kcls[9] = 9
  kcls[10] = 10
  kcls[11] = 11
  kcls[12] = 13
  kcls[13] = 14
  kcls[14] = 15
  kcls[15] = 14
  kcls[16] = 2
  kcls[18] = 18
  kcls[19] = 16
  kcls[20] = 17
  kcls[21] = 19
  kcls[22] = 22
  kcls[23] = 23
  kcls[24] = 24
  kcls[25] = 25
  kcls[26] = 26
  kcls[27] = 20
  kcls[28] = 21
  /* operator method names */
  w = "add sub mul truediv floordiv mod pow lshift rshift and or xor matmul"
  do i = 1 to 13
    opd[i] = nameid("__" || word(w, i) || "__")
    ropd[i] = nameid("__r" || word(w, i) || "__")
    iopd[i] = nameid("__i" || word(w, i) || "__")
  end
  cmpd[3] = nameid("__lt__")
  cmpd[4] = nameid("__le__")
  cmpd[5] = nameid("__gt__")
  cmpd[6] = nameid("__ge__")
  cmpr[3] = nameid("__gt__")
  cmpr[4] = nameid("__ge__")
  cmpr[5] = nameid("__lt__")
  cmpr[6] = nameid("__le__")
  call cls_set 27, 118, bi_oop[42]
  call cls_set 1, 118, bi_oop[43]
  /* module constants */
  modattr["math.pi"] = mkfloat(3.141592653589793) as .string
  modattr["math.e"] = mkfloat(2.718281828459045) as .string
  modattr["math.tau"] = mkfloat(6.283185307179586) as .string
  modattr["math.inf"] = mkfloat(f_inf()) as .string
  modattr["math.nan"] = mkfloat(f_nan()) as .string
  modattr["sys.maxsize"] = mkbig("9223372036854775807") as .string
  modattr["sys.version"] = mkstr("3.12.0 (crexx)") as .string
  modattr["sys.platform"] = mkstr("linux") as .string
  modattr["sys.stdout"] = mk_file(1, "<stdout>") as .string
  modattr["sys.stderr"] = mk_file(2, "<stderr>") as .string
  modattr["sys.stdin"] = mk_file(3, "<stdin>") as .string
  l = mklist(nsargs + 1)
  if nsargs = 0 then call list_append l, mkstr("")
  do i = 1 to nsargs
    if i = 1 & sargs[1] == "-c" then call list_append l, mkstr("-c")
    else call list_append l, mkstr(sargs[i])
  end
  modattr["sys.argv"] = l as .string
  modattr["string.ascii_lowercase"] = mkstr("abcdefghijklmnopqrstuvwxyz") as .string
  modattr["string.ascii_uppercase"] = mkstr("ABCDEFGHIJKLMNOPQRSTUVWXYZ") as .string
  modattr["string.ascii_letters"] = mkstr("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ") as .string
  modattr["string.digits"] = mkstr("0123456789") as .string
  modattr["string.hexdigits"] = mkstr("0123456789abcdefABCDEF") as .string
  modattr["string.octdigits"] = mkstr("01234567") as .string
  modattr["string.punctuation"] = mkstr("!" || '"' || "#$%&'()*+,-./:;<=>?@[" || "\" || "]^_`{|}~") as .string
  modattr["string.whitespace"] = mkstr(" " || '090a0d0b0c'x) as .string
  modattr["os.sep"] = mkstr("/") as .string
  modattr["os.linesep"] = mkstr('0a'x) as .string
  modattr["os.name"] = mkstr("posix") as .string
  bimap["__name__"] = mkstr("__main__") as .string
  bimap["NotImplemented"] = 10 as .string
  bimap["Ellipsis"] = 8 as .string
  bimap["frozenset"] = cl_obj[10] as .string
  return

/* ---------------------------------------------------------------------
   Lexer: Python source -> token arrays (with NEWLINE / INDENT / DEDENT)
   --------------------------------------------------------------------- */
isletter: procedure = .int
  arg c = .string
  if c == "" then return 0
  if c >>= "a" & c <<= "z" then return 1
  if c >>= "A" & c <<= "Z" then return 1
  if c == "_" then return 1
  if c2d(c) >= 128 then return 1
  return 0

isdigit: procedure = .int
  arg c = .string
  if c == "" then return 0
  if c >>= "0" & c <<= "9" then return 1
  return 0

addtok: procedure = .void
  arg t = .int, s = .string, i = .int
  ntk = ntk + 1
  tk_t[ntk] = t
  tk_s[ntk] = s
  tk_i[ntk] = i
  tk_l[ntk] = lnum
  return

/* process backslash escapes of a (non raw) string body */
unescape: procedure = .string
  arg raw = .string
  r = .string
  p = .int
  q = .int
  c = .string
  v = .int
  n = .int
  if pos("\", raw) = 0 then return raw
  r = ""
  p = 1
  n = length(raw)
  do while p <= n
    q = pos("\", raw, p)
    if q = 0 then do
      r = r || substr(raw, p)
      leave
    end
    r = r || substr(raw, p, q - p)
    c = substr(raw, q + 1, 1)
    p = q + 2
    select
      when c == "n" then r = r || '0a'x
      when c == "t" then r = r || '09'x
      when c == "r" then r = r || '0d'x
      when c == "0" then r = r || '00'x
      when c == "a" then r = r || '07'x
      when c == "b" then r = r || '08'x
      when c == "f" then r = r || '0c'x
      when c == "v" then r = r || '0b'x
      when c == '0a'x then nop
      when c == "x" then do
        v = x2d(substr(raw, p, 2))
        r = r || utf8_chr(v)
        p = p + 2
      end
      when c == "u" then do
        v = x2d(substr(raw, p, 4))
        r = r || utf8_chr(v)
        p = p + 4
      end
      when c == "U" then do
        v = x2d(substr(raw, p, 8))
        r = r || utf8_chr(v)
        p = p + 8
      end
      when c == "" then r = r || "\"
      when c == "\" | c == "'" | c == '"' then r = r || c
      otherwise r = r || "\" || c
    end
  end
  return r

utf8_chr: procedure = .string
  arg v = .int
  if v < 128 then return d2c(v)
  if v < 2048 then return d2c(192 + v % 64) || d2c(128 + v // 64)
  if v < 65536 then return d2c(224 + v % 4096) || d2c(128 + (v % 64) // 64) || d2c(128 + v // 64)
  return d2c(240 + v % 262144) || d2c(128 + (v % 4096) // 64) || d2c(128 + (v % 64) // 64) || d2c(128 + v // 64)

/* lex the text src into tokens appended to the token arrays.
   sub = 1: a fragment (no indentation processing) */
lex_text: procedure = .void
  arg src = .string, sub = .int
  sv_tx = .string
  sv_tlen = .int
  sv_tp = .int
  sv_brk = .int
  sv_nind = .int
  sv_line = .int
  atbol = .int
  col = .int
  q = .int
  q2 = .int
  c = .string
  d = .string
  s = .string
  id = .string
  body = .string
  isf = .int
  isr = .int
  isb = .int
  trip = .int
  p = .int
  endp = .int
  quote = .string
  nflag = .int
  v = .int
  radix = .int
  fr = .string
  ex = .string
  dg = .string
  neg = .int
  w = .int
  ok = .int
  op = .string
  lastt = .int
  sv_tx = tx
  sv_tlen = tlen
  sv_tp = tp
  sv_brk = lx_brk
  sv_nind = lx_nind
  sv_line = lnum
  tx = src
  tlen = length(tx)
  tp = 1
  lx_brk = 0
  lx_nind = 1
  ind_s[1] = 0
  if sub = 1 then atbol = 0
  else atbol = 1
  if sub = 0 then lnum = 1
  do forever
    if atbol = 1 & lx_brk = 0 then do
      col = 0
      q = tp
      do while q <= tlen
        c = substr(tx, q, 1)
        if c == " " then col = col + 1
        else if c == '09'x then col = col + 8 - (col // 8)
        else if c == '0c'x then col = 0
        else leave
        q = q + 1
      end
      if q > tlen then do
        tp = q
        leave
      end
      c = substr(tx, q, 1)
      if c == '0a'x then do
        tp = q + 1
        lnum = lnum + 1
        iterate
      end
      if c == "#" then do
        q2 = pos('0a'x, tx, q)
        if q2 = 0 then do
          tp = tlen + 1
          leave
        end
        tp = q2 + 1
        lnum = lnum + 1
        iterate
      end
      tp = q
      if col > ind_s[lx_nind] then do
        lx_nind = lx_nind + 1
        ind_s[lx_nind] = col
        call addtok 2, "", 0
      end
      else if col < ind_s[lx_nind] then do
        do while col < ind_s[lx_nind]
          lx_nind = lx_nind - 1
          call addtok 3, "", 0
        end
      end
      atbol = 0
    end
    if tp > tlen then leave
    c = substr(tx, tp, 1)
    if c == " " | c == '09'x | c == '0c'x then do
      tp = tp + 1
      iterate
    end
    if c == '0a'x then do
      tp = tp + 1
      if lx_brk = 0 then do
        if ntk > 0 then do
          if tk_t[ntk] \= 1 & sub = 0 then call addtok 1, "", 0
        end
        atbol = 1
      end
      lnum = lnum + 1
      iterate
    end
    if c == "#" then do
      q2 = pos('0a'x, tx, tp)
      if q2 = 0 then tp = tlen + 1
      else tp = q2
      iterate
    end
    if c == "\" then do
      if substr(tx, tp + 1, 1) == '0a'x then do
        tp = tp + 2
        lnum = lnum + 1
        iterate
      end
      tp = tp + 1
      iterate
    end
    d = substr(tx, tp + 1, 1)
    /* ---- identifiers, keywords, string prefixes ---- */
    if isletter(c) = 1 then do
      q = tp
      do while q <= tlen
        d = substr(tx, q, 1)
        if isletter(d) = 1 | isdigit(d) = 1 then q = q + 1
        else leave
      end
      id = substr(tx, tp, q - tp)
      d = substr(tx, q, 1)
      if (d == '"' | d == "'") & length(id) <= 2 then do
        s = lower(id)
        if s == "r" | s == "b" | s == "f" | s == "u" | s == "rb" | s == "br" | s == "fr" | s == "rf" then do
          isr = 0
          isb = 0
          isf = 0
          if pos("r", s) > 0 then isr = 1
          if pos("b", s) > 0 then isb = 1
          if pos("f", s) > 0 then isf = 1
          tp = q
          call lex_string isr, isf, isb
          iterate
        end
      end
      tp = q
      if pos(" " || id || " ", kwlist) > 0 then call addtok 10, id, 0
      else call addtok 4, id, 0
      iterate
    end
    /* ---- numbers ---- */
    if isdigit(c) = 1 | (c == "." & isdigit(d) = 1) then do
      call lex_number
      iterate
    end
    /* ---- strings ---- */
    if c == '"' | c == "'" then do
      call lex_string 0, 0, 0
      iterate
    end
    /* ---- operators ---- */
    op = substr(tx, tp, 3)
    if op == "**=" | op == "//=" | op == ">>=" | op == "<<=" | op == "..." then do
      call addtok 9, op, 0
      tp = tp + 3
      iterate
    end
    op = substr(tx, tp, 2)
    if pos(" " || op || " ", ops2) > 0 then do
      call addtok 9, op, 0
      tp = tp + 2
      iterate
    end
    if pos(c, "([{") > 0 then lx_brk = lx_brk + 1
    if pos(c, ")]}") > 0 then do
      if lx_brk > 0 then lx_brk = lx_brk - 1
    end
    call addtok 9, c, 0
    tp = tp + 1
  end
  if sub = 0 then do
    if ntk > 0 then do
      if tk_t[ntk] \= 1 & tk_t[ntk] \= 3 & tk_t[ntk] \= 2 then call addtok 1, "", 0
    end
    do while lx_nind > 1
      lx_nind = lx_nind - 1
      call addtok 3, "", 0
    end
  end
  call addtok 0, "", 0
  tx = sv_tx
  tlen = sv_tlen
  tp = sv_tp
  lx_brk = sv_brk
  lx_nind = sv_nind
  if sub = 1 then lnum = sv_line
  return

/* string literal at tx[tp] (the quote); prefix flags raw / f / bytes */
lex_string: procedure = .void
  arg isr = .int, isf = .int, isb = .int
  quote = .string
  trip = .int
  q = .int
  p = .int
  body = .string
  c = .string
  n = .int
  endp = .int
  quote = substr(tx, tp, 1)
  trip = 0
  if substr(tx, tp + 1, 2) == quote || quote then do
    trip = 1
    q = tp + 3
  end
  else q = tp + 1
  p = q
  endp = 0
  do while p <= tlen
    c = substr(tx, p, 1)
    if c == "\" then do
      p = p + 2
      iterate
    end
    if c == quote then do
      if trip = 0 then do
        endp = p
        leave
      end
      if substr(tx, p + 1, 2) == quote || quote then do
        endp = p
        leave
      end
    end
    if c == '0a'x & trip = 0 then leave
    p = p + 1
  end
  if endp = 0 then do
    call perr "EOL while scanning string literal"
    tp = tlen + 1
    return
  end
  body = substr(tx, q, endp - q)
  n = 0
  q = pos('0a'x, body)
  do while q > 0
    n = n + 1
    q = pos('0a'x, body, q + 1)
  end
  if trip = 1 then tp = endp + 3
  else tp = endp + 1
  if isf = 1 then do
    if isr = 1 then call addtok 8, body, 3
    else call addtok 8, body, 1
  end
  else if isr = 1 then call addtok 8, body, 0
  else call addtok 8, unescape(body), 0
  lnum = lnum + n
  return

lex_number: procedure = .void
  q = .int
  p = .int
  c = .string
  d = .string
  dg = .string
  fr = .string
  ex = .string
  isf = .int
  v = .int
  radix = .int
  neg = .int
  nd = .int
  s = .string
  big = .string
  q = tp
  c = substr(tx, tp, 1)
  d = lower(substr(tx, tp + 1, 1))
  if c == "0" & (d == "x" | d == "o" | d == "b") then do
    if d == "x" then radix = 16
    else if d == "o" then radix = 8
    else radix = 2
    q = tp + 2
    s = ""
    do while q <= tlen
      c = lower(substr(tx, q, 1))
      if c == "_" then do
        q = q + 1
        iterate
      end
      if isdigit(c) = 1 then nd = c as .int
      else if c >>= "a" & c <<= "f" then nd = c2d(c) - 87
      else leave
      if nd >= radix then leave
      s = s || c
      q = q + 1
    end
    tp = q
    if s == "" then s = "0"
    if length(s) <= 15 & radix = 16 then call addtok 5, "", x2d(s)
    else do
      /* general: accumulate in a decimal string */
      big = "0"
      do p = 1 to length(s)
        c = substr(s, p, 1)
        if isdigit(c) = 1 then nd = c as .int
        else nd = c2d(c) - 87
        big = sadd(smul(big, radix as .string), nd as .string)
      end
      call tok_bigint big
    end
    return
  end
  dg = ""
  do while q <= tlen
    c = substr(tx, q, 1)
    if isdigit(c) = 1 then dg = dg || c
    else if c \== "_" then leave
    q = q + 1
  end
  fr = ""
  isf = 0
  if substr(tx, q, 1) == "." then do
    isf = 1
    q = q + 1
    do while q <= tlen
      c = substr(tx, q, 1)
      if isdigit(c) = 1 then fr = fr || c
      else if c \== "_" then leave
      q = q + 1
    end
  end
  ex = ""
  c = substr(tx, q, 1)
  if c == "e" | c == "E" then do
    p = q + 1
    neg = 0
    if substr(tx, p, 1) == "-" then do
      neg = 1
      p = p + 1
    end
    else if substr(tx, p, 1) == "+" then p = p + 1
    if isdigit(substr(tx, p, 1)) = 1 then do
      v = p
      do while v <= tlen & isdigit(substr(tx, v, 1)) = 1
        v = v + 1
      end
      ex = substr(tx, p, v - p)
      if neg = 1 then ex = "-" || ex
      isf = 1
      q = v
    end
  end
  tp = q
  if isf = 1 then do
    if dg == "" then dg = "0"
    if fr == "" then fr = "0"
    s = dg || "." || fr
    if ex \== "" then s = s || "e" || ex
    ntk = ntk + 1
    tk_t[ntk] = 7
    tk_s[ntk] = s
    tk_i[ntk] = 0
    tk_l[ntk] = lnum
    tk_f[ntk] = parse_flt(s)
    return
  end
  if length(dg) > 18 then call tok_bigint dg
  else call addtok 5, "", dg as .int
  return

tok_bigint: procedure = .void
  arg s = .string
  if length(s) <= 18 then call addtok 5, "", mag_clean(s) as .int
  else call addtok 6, mag_clean(s), 0
  return

/* ---------------------------------------------------------------------
   Parser: tokens -> node arrays, with scope resolution
   --------------------------------------------------------------------- */
perr: procedure = .void
  arg msg = .string
  if pe = 0 then do
    pe = 1
    pe_msg = "SyntaxError: " || msg || " (line " || tk_l[tpp] || ")"
  end
  tpp = ntk
  return

mk: procedure = .int
  arg t = .int, a = .int, b = .int, c = .int
  nnode = nnode + 1
  n_t[nnode] = t
  n_a[nnode] = a
  n_b[nnode] = b
  n_c[nnode] = c
  n_d[nnode] = 0
  n_y[nnode] = 0
  n_s[nnode] = ""
  n_ln[nnode] = tk_l[tpp]
  n_ic[nnode] = 0
  n_ig[nnode] = 0
  n_iv[nnode] = 0
  return nnode

mkc: procedure = .int
  arg oop = .int
  return mk(14, oop, 0, 0)

at: procedure = .int
  arg s = .string
  if tk_s[tpp] \== s then return 0
  if tk_t[tpp] = 9 | tk_t[tpp] = 10 then return 1
  return 0

atnext: procedure = .int
  arg s = .string
  if tk_s[tpp + 1] \== s then return 0
  if tk_t[tpp + 1] = 9 | tk_t[tpp + 1] = 10 then return 1
  return 0

accept: procedure = .int
  arg s = .string
  if at(s) = 1 then do
    tpp = tpp + 1
    return 1
  end
  return 0

expect: procedure = .void
  arg s = .string
  if at(s) = 1 then tpp = tpp + 1
  else call perr "expected '" || s || "'"
  return

expect_name: procedure = .string
  r = .string
  if tk_t[tpp] = 4 then do
    r = tk_s[tpp]
    tpp = tpp + 1
    return r
  end
  call perr "expected a name"
  return "?"

/* list of node ids pushed on ps since base -> al; returns al start */
plist: procedure = .int
  arg base = .int
  st = .int
  i = .int
  st = nal + 1
  do i = base + 1 to psp
    nal = nal + 1
    al[nal] = ps[i]
  end
  psp = base
  return st

/* ---- scopes ---- */
scope_push: procedure = .int
  arg kind = .int
  s = .int
  nsc = nsc + 1
  s = nsc
  sc_kind[s] = kind
  sc_par[s] = cursc
  sc_n[s] = 2
  sc_fl[s] = 0
  sc_id[s] = 0
  sc_rf0[s] = nrf + 1
  sc_cd[s] = 0
  if cursc > 0 then do
    sc_cd[s] = sc_cd[cursc]
    if sc_kind[cursc] = 3 then sc_cd[s] = sc_id[cursc]
  end
  cursc = s
  return s

/* bind a name in the current scope: returns its slot (0 if declared global/nonlocal) */
bind_name: procedure = .int
  arg name = .string
  key = .string
  v = .string
  sl0 = .int
  key = cursc || "|" || name
  v = scm[key]
  if v == "" then do
    sl0 = sc_n[cursc]
    sc_n[cursc] = sl0 + 1
    scm[key] = sl0 as .string
    if sc_kind[cursc] = 3 then do
      ncv = ncv + 1
      cv_name[ncv] = name
      cv_slot[ncv] = sl0
      cv_scope[ncv] = cursc
    end
    return sl0
  end
  return v as .int

mkname: procedure = .int
  arg name = .string
  n = .int
  n = mk(35, 0, 0, 0)
  n_s[n] = name
  nrf = nrf + 1
  rf_node[nrf] = n
  rf_sc[nrf] = cursc
  rf_dep[nrf] = 0
  return n

/* mark all enclosing function scopes as having inner scopes (frames stay alive) */
mark_closure: procedure = .void
  s = .int
  s = cursc
  do while s > 0
    if (sc_fl[s] // 4) < 2 then sc_fl[s] = sc_fl[s] + 2
    s = sc_par[s]
  end
  return

builtin_lookup: procedure = .int
  arg name = .string
  v = .string
  v = bimap[name]
  if v == "" then return 0
  return v as .int

/* resolve all pending references of scope sc (called when the scope ends) */
scope_end: procedure = .void
  arg sc = .int
  r = .int
  n = .int
  name = .string
  v = .string
  slot = .int
  par = .int
  b = .int
  do r = sc_rf0[sc] to nrf
    if rf_sc[r] = sc then do
      n = rf_node[r]
      name = n_s[n]
      v = scm[sc || "|" || name]
      slot = 0
      if v \== "" then slot = v as .int
      if sc_kind[sc] = 3 & rf_dep[r] > 0 then slot = 0
      if sc_kind[sc] = 1 then do
        /* module scope: global slot, builtin, or error */
        if slot > 0 then do
          n_t[n] = 27
          n_a[n] = slot
        end
        else do
          b = builtin_lookup(name)
          if b > 0 then do
            n_t[n] = 14
            n_a[n] = b
          end
          else n_t[n] = 36
        end
        rf_sc[r] = 0
      end
      else if slot = -1 then do
        /* declared global: module slot (create when needed) */
        v = scm["1|" || name]
        if v == "" then do
          slot = sc_n[1]
          sc_n[1] = slot + 1
          scm["1|" || name] = slot as .string
        end
        else slot = v as .int
        n_t[n] = 27
        n_a[n] = slot
        rf_sc[r] = 0
      end
      else if slot > 0 then do
        if rf_dep[r] = 0 then do
          n_t[n] = 34
          n_a[n] = slot
        end
        else do
          n_t[n] = 51
          n_a[n] = slot
          n_b[n] = rf_dep[r]
        end
        rf_sc[r] = 0
      end
      else do
        /* not local: look in the enclosing scope */
        rf_sc[r] = sc_par[sc]
        rf_dep[r] = rf_dep[r] + 1
      end
    end
  end
  cursc = sc_par[sc]
  return

/* ---- expressions ---- */
p_test: procedure = .int
  c = .int
  e = .int
  f = .int
  if at("lambda") = 1 then return p_lambda()
  e = p_or()
  if at("if") = 1 then do
    tpp = tpp + 1
    c = p_or()
    call expect "else"
    f = p_test()
    return mk(30, c, e, f)
  end
  return e

p_or: procedure = .int
  l = .int
  r = .int
  l = p_and()
  do while at("or") = 1
    tpp = tpp + 1
    r = p_and()
    l = mk(38, l, r, 0)
  end
  return l

p_and: procedure = .int
  l = .int
  r = .int
  l = p_not()
  do while at("and") = 1
    tpp = tpp + 1
    r = p_not()
    l = mk(1, l, r, 0)
  end
  return l

p_not: procedure = .int
  x = .int
  if at("not") = 1 then do
    tpp = tpp + 1
    x = p_not()
    return mk(37, x, 0, 0)
  end
  return p_cmp()

cmp_op: procedure = .int
  t = .int
  s = .string
  t = tk_t[tpp]
  s = tk_s[tpp]
  if t = 9 then do
    if s == "==" then return 1
    if s == "!=" then return 2
    if s == "<" then return 3
    if s == "<=" then return 4
    if s == ">" then return 5
    if s == ">=" then return 6
    return 0
  end
  if t = 10 then do
    if s == "in" then return 7
    if s == "is" then do
      if tk_s[tpp + 1] == "not" & tk_t[tpp + 1] = 10 then return 10
      return 9
    end
    if s == "not" then do
      if tk_s[tpp + 1] == "in" & tk_t[tpp + 1] = 10 then return 8
    end
  end
  return 0

p_cmp: procedure = .int
  l = .int
  r = .int
  op = .int
  base = .int
  cnt = .int
  st = .int
  k = .int
  n = .int
  l = p_bin(1)
  op = cmp_op()
  if op = 0 then return l
  base = psp
  psp = psp + 1
  ps[psp] = l
  cnt = 1
  do while op > 0
    if op = 10 | op = 8 then tpp = tpp + 2
    else tpp = tpp + 1
    r = p_bin(1)
    cnt = cnt + 1
    psp = psp + 1
    ps[psp] = r
    psp = psp + 1
    ps[psp] = op
    op = cmp_op()
  end
  /* ps: l, r1, op1, r2, op2 ... -> operands then ops */
  if cnt = 2 then do
    n = mk(11, ps[base + 1], ps[base + 2], ps[base + 3])
    psp = base
    return n
  end
  st = nal + 1
  nal = nal + 1
  al[nal] = ps[base + 1]
  do k = 1 to cnt - 1
    nal = nal + 1
    al[nal] = ps[base + 1 + k * 2 - 1]
  end
  do k = 1 to cnt - 1
    nal = nal + 1
    al[nal] = ps[base + 1 + k * 2]
  end
  psp = base
  return mk(9, st, cnt, 0)

bin_op: procedure = .int
  arg lvl = .int
  s = .string
  if tk_t[tpp] \= 9 then return 0
  s = tk_s[tpp]
  select
    when lvl = 1 then do
      if s == "|" then return 11
    end
    when lvl = 2 then do
      if s == "^" then return 12
    end
    when lvl = 3 then do
      if s == "&" then return 10
    end
    when lvl = 4 then do
      if s == "<<" then return 8
      if s == ">>" then return 9
    end
    when lvl = 5 then do
      if s == "+" then return 1
      if s == "-" then return 2
    end
    otherwise do
      if s == "*" then return 3
      if s == "/" then return 4
      if s == "//" then return 5
      if s == "%" then return 6
      if s == "@" then return 13
    end
  end
  return 0

p_bin: procedure = .int
  arg lvl = .int
  l = .int
  r = .int
  op = .int
  if lvl > 6 then return p_factor()
  l = p_bin(lvl + 1)
  do forever
    op = bin_op(lvl)
    if op = 0 then leave
    tpp = tpp + 1
    r = p_bin(lvl + 1)
    l = mk(6, l, r, op)
  end
  return l

p_factor: procedure = .int
  x = .int
  v = .int
  f = .float
  if at("-") = 1 then do
    tpp = tpp + 1
    x = p_factor()
    if n_t[x] = 14 & n_a[x] // 2 \= 0 & n_a[x] > -1000000000000000 & n_a[x] < 1000000000000000 then do
      n_a[x] = 1 - (n_a[x] - 1)
      return x
    end
    if n_t[x] = 14 then do
      if ob_k[n_a[x] % 2] = 5 then do
        f = ob_f[n_a[x] % 2]
        return mkc(mkfloat(0.0 - f))
      end
    end
    return mk(50, x, 0, 1)
  end
  if at("+") = 1 then do
    tpp = tpp + 1
    x = p_factor()
    return mk(50, x, 0, 2)
  end
  if at("~") = 1 then do
    tpp = tpp + 1
    x = p_factor()
    return mk(50, x, 0, 3)
  end
  return p_power()

p_power: procedure = .int
  b = .int
  e = .int
  b = p_atomexpr()
  if at("**") = 1 then do
    tpp = tpp + 1
    e = p_factor()
    return mk(6, b, e, 7)
  end
  return b

/* does the bracketed construct starting at tpp contain a 'for' at depth 0 ? */
has_for: procedure = .int
  i = .int
  dep = .int
  i = tpp
  dep = 0
  do forever
    if tk_t[i] = 0 then return 0
    if tk_t[i] = 9 then do
      if pos(tk_s[i], "([{") > 0 & length(tk_s[i]) = 1 then dep = dep + 1
      else if pos(tk_s[i], ")]}") > 0 & length(tk_s[i]) = 1 then do
        dep = dep - 1
        if dep < 0 then return 0
      end
      else if dep = 0 & tk_s[i] == "," then return 0
    end
    else if tk_t[i] = 10 & dep = 0 then do
      if tk_s[i] == "for" then return 1
    end
    i = i + 1
  end
  return 0

p_atomexpr: procedure = .int
  e = .int
  e = p_atom()
  do forever
    if at("(") = 1 then e = p_call(e)
    else if at("[") = 1 then e = p_subscript(e)
    else if at(".") = 1 then do
      tpp = tpp + 1
      e = mk(4, e, 0, 0)
      n_s[e] = expect_name()
      n_b[e] = nameid(n_s[e])
    end
    else leave
  end
  return e

p_call: procedure = .int
  arg f = .int
  base = .int
  a = .int
  n = .int
  st = .int
  cnt = .int
  flags = .int
  nm = .string
  sc = .int
  tpp = tpp + 1
  base = psp
  flags = 0
  /* zero-argument super() inside a method */
  if n_t[f] = 35 & n_s[f] == "super" & at(")") = 1 then do
    tpp = tpp + 1
    n_t[f] = 47
    if rf_node[nrf] = f then rf_sc[nrf] = 0
    n_a[f] = sc_cd[cursc]
    n_b[f] = 0
    sc = cursc
    do while sc > 0 & sc_par[sc] > 0 & sc_kind[sc_par[sc]] \= 3
      n_b[f] = n_b[f] + 1
      sc = sc_par[sc]
    end
    return f
  end
  do while at(")") = 0 & tk_t[tpp] \= 0
    if at("*") = 1 then do
      tpp = tpp + 1
      a = p_test()
      a = mk(45, a, 0, 0)
      flags = 1
    end
    else if at("**") = 1 then do
      tpp = tpp + 1
      a = p_test()
      a = mk(19, a, 0, 0)
      flags = 1
    end
    else if tk_t[tpp] = 4 & tk_t[tpp + 1] = 9 & tk_s[tpp + 1] == "=" then do
      nm = tk_s[tpp]
      tpp = tpp + 2
      a = p_test()
      a = mk(32, a, 0, 0)
      n_s[a] = nm
      flags = 1
    end
    else if has_for() = 1 then a = p_comp(0, "")
    else a = p_test()
    psp = psp + 1
    ps[psp] = a
    if accept(",") = 0 then leave
  end
  call expect ")"
  cnt = psp - base
  st = plist(base)
  n = mk(8, f, st, cnt)
  n_d[n] = flags
  return n

p_subscript: procedure = .int
  arg o = .int
  base = .int
  a = .int
  b = .int
  c = .int
  cnt = .int
  tup = .int
  st = .int
  tpp = tpp + 1
  base = psp
  tup = 0
  do forever
    a = 0
    b = 0
    c = 0
    if at(":") = 0 then a = p_test_star()
    if at(":") = 1 then do
      tpp = tpp + 1
      if at(":") = 0 & at("]") = 0 & at(",") = 0 then b = p_test()
      if at(":") = 1 then do
        tpp = tpp + 1
        if at("]") = 0 & at(",") = 0 then c = p_test()
      end
      a = mk(44, a, b, c)
    end
    psp = psp + 1
    ps[psp] = a
    if at(",") = 1 then do
      tpp = tpp + 1
      tup = 1
      if at("]") = 1 then leave
    end
    else leave
  end
  call expect "]"
  cnt = psp - base
  if cnt = 1 & tup = 0 then do
    a = ps[psp]
    psp = base
  end
  else do
    st = plist(base)
    a = mk(49, st, cnt, 0)
  end
  return mk(46, o, a, 0)

p_test_star: procedure = .int
  x = .int
  if at("*") = 1 then do
    tpp = tpp + 1
    x = p_bin(1)
    return mk(45, x, 0, 0)
  end
  return p_test()

/* comma separated expressions (a tuple when there is a comma) */
p_testlist: procedure = .int
  base = .int
  a = .int
  cnt = .int
  st = .int
  comma = .int
  base = psp
  comma = 0
  do forever
    a = p_test_star()
    psp = psp + 1
    ps[psp] = a
    if at(",") = 1 then do
      tpp = tpp + 1
      comma = 1
      if tk_t[tpp] = 1 | tk_t[tpp] = 0 | at("=") = 1 | at(")") = 1 | at(":") = 1 | at(";") = 1 | at("]") = 1 then leave
    end
    else leave
  end
  if comma = 0 then do
    a = ps[psp]
    psp = base
    return a
  end
  cnt = psp - base
  st = plist(base)
  return mk(49, st, cnt, 0)

/* target list for 'for' loops / comprehensions: stops before 'in' */
p_targetlist: procedure = .int
  base = .int
  a = .int
  cnt = .int
  st = .int
  comma = .int
  base = psp
  comma = 0
  do forever
    if at("*") = 1 then do
      tpp = tpp + 1
      a = p_bin(1)
      a = mk(45, a, 0, 0)
    end
    else a = p_bin(1)
    psp = psp + 1
    ps[psp] = a
    if at(",") = 1 then do
      tpp = tpp + 1
      comma = 1
      if at("in") = 1 then leave
    end
    else leave
  end
  if comma = 0 then do
    a = ps[psp]
    psp = base
    return a
  end
  cnt = psp - base
  st = plist(base)
  return mk(49, st, cnt, 0)

/* turn an expression node into an assignment target (binds names) */
mk_target: procedure = .void
  arg n = .int
  t = .int
  i = .int
  dmy = .int
  t = n_t[n]
  if t = 35 then dmy = bind_name(n_s[n])
  else if t = 49 | t = 33 then do
    do i = 0 to n_b[n] - 1
      call mk_target al[n_a[n] + i]
    end
  end
  else if t = 45 then call mk_target n_a[n]
  else if t = 4 | t = 46 then nop
  else call perr "cannot assign to expression"
  return

p_atom: procedure = .int
  t = .int
  s = .string
  n = .int
  x = .int
  base = .int
  cnt = .int
  st = .int
  t = tk_t[tpp]
  s = tk_s[tpp]
  if t = 4 then do
    tpp = tpp + 1
    return mkname(s)
  end
  if t = 5 then do
    n = mkc(tk_i[tpp] * 2 + 1)
    tpp = tpp + 1
    return n
  end
  if t = 6 then do
    n = mkc(mkbig(s))
    tpp = tpp + 1
    return n
  end
  if t = 7 then do
    n = mkc(mkfloat(tk_f[tpp]))
    tpp = tpp + 1
    return n
  end
  if t = 8 then return p_strings()
  if t = 10 then do
    if s == "None" then do
      tpp = tpp + 1
      return mkc(2)
    end
    if s == "True" then do
      tpp = tpp + 1
      return mkc(4)
    end
    if s == "False" then do
      tpp = tpp + 1
      return mkc(6)
    end
    if s == "yield" then return p_yield()
    if s == "await" then do
      tpp = tpp + 1
      return p_atomexpr()
    end
    if s == "lambda" then return p_lambda()
  end
  if t = 9 then do
    if s == "(" then do
      tpp = tpp + 1
      if at(")") = 1 then do
        tpp = tpp + 1
        return mk(49, 0, 0, 0)
      end
      if at("yield") = 1 then do
        x = p_yield()
        call expect ")"
        return x
      end
      if has_for() = 1 then do
        x = p_comp(0, ")")
        return x
      end
      x = p_test_star()
      if at(",") = 1 then do
        base = psp
        psp = psp + 1
        ps[psp] = x
        do while accept(",") = 1
          if at(")") = 1 then leave
          x = p_test_star()
          psp = psp + 1
          ps[psp] = x
        end
        call expect ")"
        cnt = psp - base
        st = plist(base)
        return mk(49, st, cnt, 0)
      end
      call expect ")"
      if n_t[x] = 45 then call perr "can't use starred expression here"
      return x
    end
    if s == "[" then do
      tpp = tpp + 1
      if at("]") = 1 then do
        tpp = tpp + 1
        return mk(33, 0, 0, 0)
      end
      if has_for() = 1 then return p_comp(1, "]")
      base = psp
      do forever
        x = p_test_star()
        psp = psp + 1
        ps[psp] = x
        if accept(",") = 0 then leave
        if at("]") = 1 then leave
      end
      call expect "]"
      cnt = psp - base
      st = plist(base)
      return mk(33, st, cnt, 0)
    end
    if s == "{" then return p_brace()
    if s == "..." then do
      tpp = tpp + 1
      return mkc(8)
    end
  end
  call perr "invalid syntax near '" || s || "'"
  return mkc(2)

/* adjacent string literals (with f-strings) */
p_strings: procedure = .int
  acc = .string
  base = .int
  cnt = .int
  st = .int
  n = .int
  isf = .int
  anyf = .int
  fl = .int
  x = .int
  acc = ""
  anyf = 0
  base = psp
  do while tk_t[tpp] = 8
    fl = tk_i[tpp]
    if fl = 0 then acc = acc || tk_s[tpp]
    else do
      anyf = 1
      /* flush literal accumulated so far */
      if acc \== "" then do
        psp = psp + 1
        ps[psp] = mkc(mkstr(acc))
        acc = ""
      end
      isf = 0
      if fl = 3 then isf = 1
      call fstring_parts tk_s[tpp], isf
    end
    tpp = tpp + 1
  end
  if anyf = 0 then return mkc(mkstr(acc))
  if acc \== "" then do
    psp = psp + 1
    ps[psp] = mkc(mkstr(acc))
  end
  cnt = psp - base
  st = plist(base)
  return mk(24, st, cnt, 0)

/* parse an f-string body into parts pushed on ps (raw flag: no escapes) */
fstring_parts: procedure = .void
  arg raw = .string, isr = .int
  i = .int
  n = .int
  c = .string
  lit = .string
  j = .int
  dep = .int
  q = .string
  stop = .int
  ex = .string
  conv = .int
  spec = .int
  x = .int
  f = .int
  ch = .string
  nx = .string
  sp = .string
  dbg = .int
  fm = .int
  k = .int
  endj = .int
  base2 = .int
  cnt2 = .int
  st2 = .int
  i = 1
  n = length(raw)
  lit = ""
  do while i <= n
    c = substr(raw, i, 1)
    if c == "{" then do
      if substr(raw, i + 1, 1) == "{" then do
        lit = lit || "{"
        i = i + 2
        iterate
      end
      if lit \== "" then do
        psp = psp + 1
        if isr = 1 then ps[psp] = mkc(mkstr(lit))
        else ps[psp] = mkc(mkstr(unescape(lit)))
        lit = ""
      end
      /* find the end of the expression */
      j = i + 1
      dep = 0
      stop = 0
      do while j <= n & stop = 0
        ch = substr(raw, j, 1)
        nx = substr(raw, j + 1, 1)
        if ch == "'" | ch == '"' then do
          k = pos(ch, raw, j + 1)
          if k = 0 then j = n + 1
          else j = k + 1
          iterate
        end
        if ch == "(" | ch == "[" | ch == "{" then dep = dep + 1
        else if ch == ")" | ch == "]" then dep = dep - 1
        else if ch == "}" then do
          if dep = 0 then stop = 1
          else dep = dep - 1
        end
        else if dep = 0 & ch == "!" & nx \== "=" then stop = 1
        else if dep = 0 & ch == ":" then stop = 1
        else if dep = 0 & ch == "=" & nx \== "=" & substr(raw, j - 1, 1) \== "=" & substr(raw, j - 1, 1) \== "!" & substr(raw, j - 1, 1) \== "<" & substr(raw, j - 1, 1) \== ">" then stop = 2
        if stop = 0 then j = j + 1
      end
      ex = substr(raw, i + 1, j - i - 1)
      conv = 0
      spec = 0
      dbg = 0
      if stop = 2 then do
        dbg = 1
        lit = ex || "="
        j = j + 1
        ch = substr(raw, j, 1)
      end
      ch = substr(raw, j, 1)
      if ch == "!" then do
        conv = c2d(substr(raw, j + 1, 1))
        j = j + 2
        ch = substr(raw, j, 1)
      end
      if ch == ":" then do
        /* format spec up to the matching close brace; may hold nested fields */
        k = j + 1
        dep = 0
        do while k <= n
          ch = substr(raw, k, 1)
          if ch == "{" then dep = dep + 1
          else if ch == "}" then do
            if dep = 0 then leave
            dep = dep - 1
          end
          k = k + 1
        end
        sp = substr(raw, j + 1, k - j - 1)
        j = k
        base2 = psp
        call fstring_parts sp, 1
        if psp = base2 + 1 & n_t[ps[psp]] = 14 then do
          spec = ps[psp]
          psp = base2
        end
        else if psp = base2 then spec = mkc(mkstr(""))
        else do
          cnt2 = psp - base2
          st2 = plist(base2)
          spec = mk(24, st2, cnt2, 0)
        end
      end
      if substr(raw, j, 1) \== "}" then do
        call perr "f-string: expecting '}'"
        return
      end
      x = sub_expr(ex)
      if dbg = 1 then do
        psp = psp + 1
        ps[psp] = mkc(mkstr(lit))
        lit = ""
        if conv = 0 & spec = 0 then conv = 114
      end
      f = mk(21, x, conv, spec)
      psp = psp + 1
      ps[psp] = f
      i = j + 1
      iterate
    end
    if c == "}" then do
      if substr(raw, i + 1, 1) == "}" then i = i + 1
      lit = lit || "}"
      i = i + 1
      iterate
    end
    lit = lit || c
    i = i + 1
  end
  if lit \== "" then do
    psp = psp + 1
    if isr = 1 then ps[psp] = mkc(mkstr(lit))
    else ps[psp] = mkc(mkstr(unescape(lit)))
  end
  return

/* parse an expression from text (f-string fields) */
sub_expr: procedure = .int
  arg text = .string
  svt = .int
  base = .int
  x = .int
  svt = tpp
  base = ntk + 1
  call lex_text text, 1
  tpp = base
  x = p_testlist()
  tpp = svt
  return x

p_yield: procedure = .int
  x = .int
  tpp = tpp + 1
  if (sc_fl[cursc] // 2) = 0 then sc_fl[cursc] = sc_fl[cursc] + 1
  if at("from") = 1 then do
    tpp = tpp + 1
    x = p_test()
    x = mk(55, x, 0, 0)
    n_y[x] = 1
    return x
  end
  x = 0
  if tk_t[tpp] \= 1 & at(")") = 0 & at("=") = 0 & at(";") = 0 & at("]") = 0 & tk_t[tpp] \= 0 then x = p_testlist()
  x = mk(54, x, 0, 0)
  n_y[x] = 1
  return x

/* ---- brace displays ---- */
p_brace: procedure = .int
  k = .int
  v = .int
  base = .int
  cnt = .int
  st = .int
  n = .int
  isdict = .int
  tpp = tpp + 1
  if at("}") = 1 then do
    tpp = tpp + 1
    return mk(18, 0, 0, 0)
  end
  if has_for() = 1 then return p_comp(2, "}")
  base = psp
  isdict = -1
  do forever
    if at("**") = 1 then do
      tpp = tpp + 1
      v = p_bin(1)
      psp = psp + 1
      ps[psp] = 0
      psp = psp + 1
      ps[psp] = v
      isdict = 1
    end
    else do
      k = p_test_star()
      if at(":") = 1 then do
        tpp = tpp + 1
        v = p_test()
        psp = psp + 1
        ps[psp] = k
        psp = psp + 1
        ps[psp] = v
        isdict = 1
      end
      else do
        psp = psp + 1
        ps[psp] = k
        isdict = 0
      end
    end
    if accept(",") = 0 then leave
    if at("}") = 1 then leave
  end
  call expect "}"
  cnt = psp - base
  st = plist(base)
  if isdict = 1 then return mk(18, st, cnt % 2, 0)
  return mk(43, st, cnt, 0)

/* comprehension: kind 0 generator, 1 list, 2 set or dict; closer is the closing token.
   The element has not been parsed yet. */
p_comp: procedure = .int
  arg kind = .int, closer = .string
  sc = .int
  par = .int
  fd = .int
  elt = .int
  keyn = .int
  isdict = .int
  cl0 = .int
  ncl = .int
  i = .int
  tgt = .int
  itr = .int
  firstit = .int
  body = .int
  cond = .int
  n = .int
  dmy = .int
  c0 = .int
  k = .int
  ck = .int
  x = .int
  par = cursc
  nfd = nfd + 1
  fd = nfd
  sc = scope_push(4)
  sc_id[sc] = fd
  dmy = bind_name(".0")
  dmy = bind_name(".r")
  if kind = 0 then sc_fl[sc] = 1
  /* element (and key) */
  keyn = 0
  isdict = 0
  elt = p_test_star()
  if kind = 2 & at(":") = 1 then do
    tpp = tpp + 1
    keyn = elt
    elt = p_test()
    isdict = 1
  end
  /* for clauses: stored on the parse stack as (target, iter, ncond, conds...) */
  cl0 = psp
  ncl = 0
  firstit = 0
  do while at("for") = 1
    tpp = tpp + 1
    tgt = p_targetlist()
    call mk_target tgt
    call expect "in"
    if ncl = 0 then do
      cursc = par
      itr = p_or()
      cursc = sc
      firstit = itr
      itr = mk(34, 2, 0, 0)
    end
    else itr = p_or()
    ncl = ncl + 1
    psp = psp + 1
    ps[psp] = tgt
    psp = psp + 1
    ps[psp] = itr
    c0 = psp + 1
    psp = psp + 1
    ps[psp] = 0
    do while at("if") = 1
      tpp = tpp + 1
      cond = p_or()
      psp = psp + 1
      ps[psp] = cond
      ps[c0] = ps[c0] + 1
    end
  end
  if closer \== "" then call expect closer
  /* innermost statement */
  if kind = 0 then do
    x = mk(54, elt, 0, 0)
    n_y[x] = 1
    body = mk(20, x, 0, 0)
    n_y[body] = 1
  end
  else do
    ck = 1
    if kind = 2 & isdict = 0 then ck = 4
    if kind = 2 & isdict = 1 then ck = 3
    body = mk(13, elt, keyn, ck)
  end
  call build_comp_nest cl0, ncl, body
  body = comp_result
  psp = cl0
  fd_body[fd] = body
  call finish_scope_fd fd, sc, 0
  call scope_end sc
  if kind = 0 then call mark_closure
  if kind = 0 then n = mk(26, fd, 0, firstit)
  else n = mk(12, fd, ck, firstit)
  return n

/* nest 'for'/'if' statements around body; clauses are on ps from cl0+1 */
build_comp_nest: procedure = .void
  arg cl0 = .int, ncl = .int, body = .int
  pos0 = .int
  starts = .int[]
  i = .int
  p = .int
  nc2 = .int
  j = .int
  cur = .int
  tgt = .int
  itr = .int
  cnd = .int
  f = .int
  p = cl0 + 1
  do i = 1 to ncl
    starts[i] = p
    p = p + 3 + ps[p + 2]
  end
  cur = body
  do i = ncl to 1 by -1
    p = starts[i]
    nc2 = ps[p + 2]
    do j = nc2 to 1 by -1
      cnd = ps[p + 2 + j]
      cur = mk(29, cnd, cur, 0)
      n_y[cur] = n_y[n_b[cur]]
    end
    f = mk(22, ps[p], ps[p + 1], cur)
    n_d[f] = 0
    n_y[f] = n_y[cur]
    cur = f
  end
  comp_result = cur
  return

/* ---- lambda and parameters ---- */
p_params: procedure = .int
  arg endtok = .string, ann = .int
  base = .int
  mode = .int
  nm = .string
  d = .int
  kind = .int
  base = npq
  mode = 0
  do while at(endtok) = 0 & tk_t[tpp] \= 0
    if at("*") = 1 then do
      tpp = tpp + 1
      mode = 2
      if tk_t[tpp] = 4 then do
        nm = expect_name()
        if ann = 1 & accept(":") = 1 then d = p_test()
        npq = npq + 1
        pq_name[npq] = nm
        pq_def[npq] = 0
        pq_kind[npq] = 1
      end
    end
    else if at("**") = 1 then do
      tpp = tpp + 1
      nm = expect_name()
      if ann = 1 & accept(":") = 1 then d = p_test()
      npq = npq + 1
      pq_name[npq] = nm
      pq_def[npq] = 0
      pq_kind[npq] = 3
    end
    else if at("/") = 1 then tpp = tpp + 1
    else do
      nm = expect_name()
      if ann = 1 & accept(":") = 1 then d = p_test()
      d = 0
      if accept("=") = 1 then d = p_test()
      npq = npq + 1
      pq_name[npq] = nm
      pq_def[npq] = d
      pq_kind[npq] = mode
    end
    if accept(",") = 0 then leave
  end
  return base

/* create the function record for scope sc from the parameter records after base */
setup_params: procedure = .void
  arg fd = .int, base = .int
  i = .int
  dmy = .int
  np = .int
  nk = .int
  k = .int
  fd_ps[fd] = npr + 1
  np = 0
  nk = 0
  fd_vs[fd] = 0
  fd_ks[fd] = 0
  do i = base + 1 to npq
    npr = npr + 1
    pr_name[npr] = pq_name[i]
    pr_def[npr] = pq_def[i]
    pr_kind[npr] = pq_kind[i]
    pr_slot[npr] = bind_name(pq_name[i])
    k = pq_kind[i]
    if k = 0 then np = np + 1
    else if k = 1 then fd_vs[fd] = pr_slot[npr]
    else if k = 2 then nk = nk + 1
    else fd_ks[fd] = pr_slot[npr]
  end
  fd_np[fd] = np
  fd_nk[fd] = nk
  fd_cx[fd] = 0
  if fd_vs[fd] > 0 | fd_ks[fd] > 0 | nk > 0 then fd_cx[fd] = 1
  fd_nr[fd] = npr - fd_ps[fd] + 1
  return

finish_scope_fd: procedure = .void
  arg fd = .int, sc = .int, isl = .int
  fd_ns[fd] = sc_n[sc]
  fd_fl[fd] = sc_fl[sc]
  fd_cd[fd] = sc_cd[sc]
  return

p_lambda: procedure = .int
  fd = .int
  sc = .int
  base = .int
  body = .int
  r = .int
  n = .int
  tpp = tpp + 1
  base = p_params(":", 0)
  call expect ":"
  nfd = nfd + 1
  fd = nfd
  sc = scope_push(2)
  sc_id[sc] = fd
  call setup_params fd, base
  npq = base
  body = p_test()
  r = mk(41, body, 0, 0)
  fd_body[fd] = r
  fd_name[fd] = "<lambda>"
  call finish_scope_fd fd, sc, 1
  call scope_end sc
  call mark_closure
  n = mk(25, fd, 0, 0)
  return n

/* ---- statements ---- */
p_file: procedure = .int
  base = .int
  s = .int
  cnt = .int
  st = .int
  base = psp
  do while tk_t[tpp] \= 0
    if tk_t[tpp] = 1 then tpp = tpp + 1
    else do
      call p_stmt
    end
  end
  cnt = psp - base
  st = plist(base)
  return mkseq(st, cnt)

mkseq: procedure = .int
  arg st = .int, cnt = .int
  n = .int
  i = .int
  y = .int
  n = mk(42, st, cnt, 0)
  y = 0
  do i = 0 to cnt - 1
    if n_y[al[st + i]] = 1 then y = 1
  end
  n_y[n] = y
  return n

/* parse one statement (possibly several simple statements) and push its node(s) on ps */
p_stmt: procedure = .void
  n = .int
  s = .string
  t = .int
  t = tk_t[tpp]
  s = tk_s[tpp]
  if t = 10 then do
    select
      when s == "if" then do
        n = p_if()
        psp = psp + 1
        ps[psp] = n
        return
      end
      when s == "while" then do
        n = p_while()
        psp = psp + 1
        ps[psp] = n
        return
      end
      when s == "for" then do
        n = p_for()
        psp = psp + 1
        ps[psp] = n
        return
      end
      when s == "try" then do
        n = p_try()
        psp = psp + 1
        ps[psp] = n
        return
      end
      when s == "with" then do
        n = p_with()
        psp = psp + 1
        ps[psp] = n
        return
      end
      when s == "def" then do
        n = p_def(0, 0)
        psp = psp + 1
        ps[psp] = n
        return
      end
      when s == "class" then do
        n = p_class(0, 0)
        psp = psp + 1
        ps[psp] = n
        return
      end
      when s == "async" then do
        tpp = tpp + 1
        return
      end
      otherwise nop
    end
  end
  if t = 9 & s == "@" then do
    n = p_decorated()
    psp = psp + 1
    ps[psp] = n
    return
  end
  if t = 2 then do
    call perr "unexpected indent"
    return
  end
  call p_simple_line
  return

/* simple statements separated by ';' up to the end of line */
p_simple_line: procedure = .void
  n = .int
  do forever
    n = p_simple()
    psp = psp + 1
    ps[psp] = n
    if accept(";") = 1 then do
      if tk_t[tpp] = 1 | tk_t[tpp] = 0 then leave
    end
    else leave
  end
  if tk_t[tpp] = 1 then tpp = tpp + 1
  else if tk_t[tpp] \= 0 & tk_t[tpp] \= 3 then call perr "invalid syntax near '" || tk_s[tpp] || "'"
  return

/* suite after ':' ; returns a node */
p_suite: procedure = .int
  base = .int
  cnt = .int
  st = .int
  n = .int
  depth_save = .int
  if tk_t[tpp] = 1 then do
    tpp = tpp + 1
    if tk_t[tpp] \= 2 then do
      call perr "expected an indented block"
      return mk(39, 0, 0, 0)
    end
    tpp = tpp + 1
    base = psp
    do while tk_t[tpp] \= 3 & tk_t[tpp] \= 0
      if tk_t[tpp] = 1 then tpp = tpp + 1
      else call p_stmt
    end
    if tk_t[tpp] = 3 then tpp = tpp + 1
    cnt = psp - base
    st = plist(base)
    return mkseq(st, cnt)
  end
  base = psp
  call p_simple_line
  cnt = psp - base
  st = plist(base)
  return mkseq(st, cnt)

p_if: procedure = .int
  c = .int
  b = .int
  e = .int
  n = .int
  tpp = tpp + 1
  c = p_test()
  call expect ":"
  b = p_suite()
  e = 0
  if at("elif") = 1 then e = p_if_elif()
  else if at("else") = 1 then do
    tpp = tpp + 1
    call expect ":"
    e = p_suite()
  end
  n = mk(29, c, b, e)
  n_y[n] = 0
  if n_y[b] = 1 then n_y[n] = 1
  if e > 0 then do
    if n_y[e] = 1 then n_y[n] = 1
  end
  return n

p_if_elif: procedure = .int
  return p_if()

p_while: procedure = .int
  c = .int
  b = .int
  e = .int
  n = .int
  tpp = tpp + 1
  c = p_test()
  call expect ":"
  b = p_suite()
  e = 0
  if at("else") = 1 then do
    tpp = tpp + 1
    call expect ":"
    e = p_suite()
  end
  n = mk(52, c, b, e)
  if n_y[b] = 1 then n_y[n] = 1
  if e > 0 then do
    if n_y[e] = 1 then n_y[n] = 1
  end
  return n

p_for: procedure = .int
  tgt = .int
  it = .int
  b = .int
  e = .int
  n = .int
  tpp = tpp + 1
  tgt = p_targetlist()
  call mk_target tgt
  call expect "in"
  it = p_testlist()
  call expect ":"
  b = p_suite()
  e = 0
  if at("else") = 1 then do
    tpp = tpp + 1
    call expect ":"
    e = p_suite()
  end
  n = mk(22, tgt, it, b)
  n_d[n] = e
  if n_y[b] = 1 then n_y[n] = 1
  if e > 0 then do
    if n_y[e] = 1 then n_y[n] = 1
  end
  return n

p_try: procedure = .int
  body = .int
  hs = .int
  hc = .int
  el = .int
  fin = .int
  n = .int
  h = .int
  ty = .int
  nm = .int
  hb = .int
  base = .int
  y = .int
  i = .int
  tpp = tpp + 1
  call expect ":"
  body = p_suite()
  base = psp
  y = n_y[body]
  el = 0
  fin = 0
  do while at("except") = 1
    tpp = tpp + 1
    ty = 0
    nm = 0
    if at(":") = 0 then do
      ty = p_test()
      if accept("as") = 1 then do
        nm = mkname(expect_name())
        call mk_target nm
      end
      else if accept(",") = 1 then do
        call perr "invalid except clause"
      end
    end
    call expect ":"
    hb = p_suite()
    if n_y[hb] = 1 then y = 1
    h = mk(28, ty, nm, hb)
    psp = psp + 1
    ps[psp] = h
  end
  hc = psp - base
  hs = plist(base)
  if at("else") = 1 then do
    tpp = tpp + 1
    call expect ":"
    el = p_suite()
    if n_y[el] = 1 then y = 1
  end
  if at("finally") = 1 then do
    tpp = tpp + 1
    call expect ":"
    fin = p_suite()
    if n_y[fin] = 1 then y = 1
  end
  n = mk(48, body, hs, hc)
  n_d[n] = el
  n_e[n] = fin
  n_y[n] = y
  return n

p_with: procedure = .int
  ctx = .int
  tgt = .int
  b = .int
  n = .int
  tpp = tpp + 1
  ctx = p_test()
  tgt = 0
  if accept("as") = 1 then do
    tgt = p_bin(1)
    call mk_target tgt
  end
  if accept(",") = 1 then do
    /* with a, b: -> nested with */
    b = p_with_rest()
  end
  else do
    call expect ":"
    b = p_suite()
  end
  n = mk(53, ctx, tgt, b)
  if n_y[b] = 1 then n_y[n] = 1
  return n

p_with_rest: procedure = .int
  ctx = .int
  tgt = .int
  b = .int
  n = .int
  ctx = p_test()
  tgt = 0
  if accept("as") = 1 then do
    tgt = p_bin(1)
    call mk_target tgt
  end
  if accept(",") = 1 then b = p_with_rest()
  else do
    call expect ":"
    b = p_suite()
  end
  n = mk(53, ctx, tgt, b)
  if n_y[b] = 1 then n_y[n] = 1
  return n

p_decorated: procedure = .int
  base = .int
  x = .int
  cnt = .int
  st = .int
  n = .int
  base = psp
  do while at("@") = 1
    tpp = tpp + 1
    x = p_test()
    psp = psp + 1
    ps[psp] = x
    if tk_t[tpp] = 1 then tpp = tpp + 1
  end
  cnt = psp - base
  st = plist(base)
  if at("def") = 1 then return p_def(st, cnt)
  if at("class") = 1 then return p_class(st, cnt)
  call perr "decorator must precede def or class"
  return mk(39, 0, 0, 0)

p_def: procedure = .int
  arg decst = .int, deccnt = .int
  name = .string
  tn = .int
  base = .int
  fd = .int
  sc = .int
  body = .int
  n = .int
  dmy = .int
  tpp = tpp + 1
  name = expect_name()
  tn = mkname(name)
  dmy = bind_name(name)
  call expect "("
  base = p_params(")", 1)
  call expect ")"
  if accept("->") = 1 then dmy = p_test()
  call expect ":"
  nfd = nfd + 1
  fd = nfd
  sc = scope_push(2)
  sc_id[sc] = fd
  call setup_params fd, base
  fd_name[fd] = name
  npq = base
  body = p_suite()
  fd_body[fd] = body
  call finish_scope_fd fd, sc, 0
  call scope_end sc
  call mark_closure
  n = mk(16, fd, tn, decst)
  n_d[n] = deccnt
  return n

p_class: procedure = .int
  arg decst = .int, deccnt = .int
  name = .string
  tn = .int
  cd = .int
  sc = .int
  body = .int
  n = .int
  dmy = .int
  basen = .int
  nb2 = .int
  i = .int
  tpp = tpp + 1
  name = expect_name()
  tn = mkname(name)
  dmy = bind_name(name)
  basen = 0
  if accept("(") = 1 then do
    if at(")") = 0 then do
      basen = p_test()
      do while accept(",") = 1
        if at(")") = 0 then dmy = p_test()
      end
    end
    call expect ")"
  end
  call expect ":"
  ncd = ncd + 1
  cd = ncd
  sc = scope_push(3)
  sc_id[sc] = cd
  cd_sc[cd] = sc
  cd_name[cd] = name
  cd_cv0[cd] = ncv + 1
  body = p_suite()
  cd_body[cd] = body
  cd_ns[cd] = sc_n[sc]
  cd_cv1[cd] = ncv
  call scope_end sc
  call mark_closure
  n = mk(10, cd, tn, basen)
  n_d[n] = decst
  n_e[n] = deccnt
  return n

/* ---- simple statements ---- */
p_simple: procedure = .int
  s = .string
  t = .int
  n = .int
  x = .int
  y = .int
  base = .int
  cnt = .int
  st = .int
  op = .int
  dmy = .int
  nm = .string
  t = tk_t[tpp]
  s = tk_s[tpp]
  if t = 10 then do
    select
      when s == "pass" then do
        tpp = tpp + 1
        return mk(39, 0, 0, 0)
      end
      when s == "break" then do
        tpp = tpp + 1
        return mk(7, 0, 0, 0)
      end
      when s == "continue" then do
        tpp = tpp + 1
        return mk(15, 0, 0, 0)
      end
      when s == "return" then do
        tpp = tpp + 1
        x = 0
        if tk_t[tpp] \= 1 & tk_t[tpp] \= 0 & at(";") = 0 then x = p_testlist()
        return mk(41, x, 0, 0)
      end
      when s == "raise" then do
        tpp = tpp + 1
        x = 0
        y = 0
        if tk_t[tpp] \= 1 & tk_t[tpp] \= 0 & at(";") = 0 then do
          x = p_test()
          if accept("from") = 1 then y = p_test()
        end
        return mk(40, x, y, 0)
      end
      when s == "global" | s == "nonlocal" then do
        tpp = tpp + 1
        do forever
          nm = expect_name()
          if s == "global" then scm[cursc || "|" || nm] = "-1"
          else scm[cursc || "|" || nm] = "-2"
          if accept(",") = 0 then leave
        end
        return mk(39, 0, 0, 0)
      end
      when s == "del" then do
        tpp = tpp + 1
        base = psp
        do forever
          x = p_bin(1)
          call mk_target x
          psp = psp + 1
          ps[psp] = x
          if accept(",") = 0 then leave
          if tk_t[tpp] = 1 then leave
        end
        cnt = psp - base
        st = plist(base)
        return mk(17, st, cnt, 0)
      end
      when s == "assert" then do
        tpp = tpp + 1
        x = p_test()
        y = 0
        if accept(",") = 1 then y = p_test()
        return mk(2, x, y, 0)
      end
      when s == "import" then return p_import()
      when s == "from" then return p_from()
      otherwise nop
    end
  end
  /* expression statement / assignment */
  x = p_testlist()
  if at("=") = 1 then do
    base = psp
    psp = psp + 1
    ps[psp] = x
    do while accept("=") = 1
      if at("yield") = 1 then x = p_yield()
      else x = p_testlist()
      psp = psp + 1
      ps[psp] = x
    end
    /* last is the value, others are targets */
    y = ps[psp]
    psp = psp - 1
    do op = base + 1 to psp
      call mk_target ps[op]
    end
    cnt = psp - base
    st = plist(base)
    n = mk(3, y, st, cnt)
    n_y[n] = n_y[y]
    return n
  end
  if tk_t[tpp] = 9 then do
    op = aug_op()
    if op > 0 then do
      tpp = tpp + 1
      call mk_target x
      if at("yield") = 1 then y = p_yield()
      else y = p_testlist()
      n = mk(5, x, y, op)
      return n
    end
    if at(":") = 1 then do
      /* annotated assignment */
      tpp = tpp + 1
      dmy = p_test()
      if accept("=") = 1 then do
        y = p_testlist()
        call mk_target x
        base = psp
        psp = psp + 1
        ps[psp] = x
        st = plist(base)
        return mk(3, y, st, 1)
      end
      return mk(39, 0, 0, 0)
    end
  end
  n = mk(20, x, 0, 0)
  n_y[n] = n_y[x]
  return n

aug_op: procedure = .int
  s = .string
  s = tk_s[tpp]
  if s == "+=" then return 1
  if s == "-=" then return 2
  if s == "*=" then return 3
  if s == "/=" then return 4
  if s == "//=" then return 5
  if s == "%=" then return 6
  if s == "**=" then return 7
  if s == "<<=" then return 8
  if s == ">>=" then return 9
  if s == "&=" then return 10
  if s == "|=" then return 11
  if s == "^=" then return 12
  if s == "@=" then return 13
  return 0

dotted_name: procedure = .string
  r = .string
  r = expect_name()
  do while at(".") = 1
    tpp = tpp + 1
    r = r || "." || expect_name()
  end
  return r

p_import: procedure = .int
  full = .string
  alias = .string
  tn = .int
  base = .int
  n = .int
  cnt = .int
  st = .int
  dmy = .int
  tpp = tpp + 1
  base = psp
  do forever
    full = dotted_name()
    alias = full
    if pos(".", full) > 0 then alias = left(full, pos(".", full) - 1)
    if accept("as") = 1 then alias = expect_name()
    tn = mkname(alias)
    dmy = bind_name(alias)
    n = mk(31, tn, 0, 0)
    n_s[n] = full
    psp = psp + 1
    ps[psp] = n
    if accept(",") = 0 then leave
  end
  cnt = psp - base
  if cnt = 1 then do
    n = ps[psp]
    psp = base
    return n
  end
  st = plist(base)
  return mkseq(st, cnt)

p_from: procedure = .int
  full = .string
  nm = .string
  alias = .string
  tn = .int
  base = .int
  n = .int
  cnt = .int
  st = .int
  dmy = .int
  paren = .int
  tpp = tpp + 1
  full = dotted_name()
  call expect "import"
  paren = accept("(")
  base = psp
  if at("*") = 1 then do
    tpp = tpp + 1
    n = mk(23, 0, 0, 0)
    n_s[n] = full
    n_d[n] = 1
    return n
  end
  do forever
    nm = expect_name()
    alias = nm
    if accept("as") = 1 then alias = expect_name()
    tn = mkname(alias)
    dmy = bind_name(alias)
    psp = psp + 1
    ps[psp] = mkc(mkstr(nm))
    psp = psp + 1
    ps[psp] = tn
    if accept(",") = 0 then leave
    if paren = 1 & at(")") = 1 then leave
  end
  if paren = 1 then call expect ")"
  cnt = (psp - base) % 2
  st = plist(base)
  n = mk(23, st, cnt, 0)
  n_s[n] = full
  return n

/* ---------------------------------------------------------------------
   Objects.  An oop is 2*index for heap objects, 2*n+1 for small integers.
   --------------------------------------------------------------------- */
newobj: procedure = .int
  arg kind = .int
  nob = nob + 1
  ob_k[nob] = kind
  return nob * 2

mkint: procedure = .int
  arg n = .int
  if n > 999999999999999999 | n < 0 - 999999999999999999 then return big_norm(n as .string)
  return n * 2 + 1

ival: procedure = .int
  arg x = .int
  if x // 2 \= 0 then return (x - 1) % 2
  if x = 4 then return 1
  return 0

mkstr: procedure = .int
  arg s = .string
  o = .int
  nob = nob + 1
  ob_k[nob] = 6
  ob_s[nob] = s
  return nob * 2

mkfloat: procedure = .int
  arg f = .float
  nob = nob + 1
  ob_k[nob] = 5
  ob_f[nob] = f
  return nob * 2

mkbool: procedure = .int
  arg b = .int
  if b = 1 then return 4
  return 6

/* big integer from a decimal string (may need normalising) */
mkbig: procedure = .int
  arg s = .string
  nob = nob + 1
  ob_k[nob] = 4
  ob_s[nob] = s
  return nob * 2

alloc_slots: procedure = .int
  arg n = .int
  st = .int
  st = nsl + 1
  nsl = nsl + n
  if n > 0 then sl[nsl] = 0
  return st

mklist: procedure = .int
  arg cap = .int
  o = .int
  o = newobj(7)
  if cap < 4 then cap = 4
  ob_p[o % 2] = alloc_slots(cap)
  ob_x[o % 2] = cap
  return o

mktuple: procedure = .int
  arg n = .int
  o = .int
  o = newobj(8)
  ob_p[o % 2] = alloc_slots(n)
  ob_n[o % 2] = n
  ob_x[o % 2] = n
  return o

list_append: procedure = .void
  arg o = .int, v = .int
  i = .int
  ix = .int
  n = .int
  cap = .int
  st = .int
  nst = .int
  ix = o % 2
  n = ob_n[ix]
  cap = ob_x[ix]
  if n >= cap then do
    cap = cap * 2
    if cap < 4 then cap = 4
    st = ob_p[ix]
    nst = alloc_slots(cap)
    do i = 0 to n - 1
      sl[nst + i] = sl[st + i]
    end
    ob_p[ix] = nst
    ob_x[ix] = cap
  end
  sl[ob_p[ix] + n] = v
  ob_n[ix] = n + 1
  return

/* make room for at least n elements */
list_reserve: procedure = .void
  arg o = .int, need = .int
  i = .int
  ix = .int
  n = .int
  st = .int
  nst = .int
  ix = o % 2
  if need <= ob_x[ix] then return
  n = ob_n[ix]
  st = ob_p[ix]
  nst = alloc_slots(need)
  do i = 0 to n - 1
    sl[nst + i] = sl[st + i]
  end
  ob_p[ix] = nst
  ob_x[ix] = need
  return

tup_of_list: procedure = .int
  arg l = .int
  t = .int
  i = .int
  n = .int
  n = ob_n[l % 2]
  t = mktuple(n)
  do i = 0 to n - 1
    sl[ob_p[t % 2] + i] = sl[ob_p[l % 2] + i]
  end
  return t

/* a tuple holding ast[base+from .. base+to] */
tup_from_ast: procedure = .int
  arg from = .int, upto = .int
  t = .int
  i = .int
  n = .int
  n = upto - from + 1
  if n < 0 then n = 0
  t = mktuple(n)
  do i = 0 to n - 1
    sl[ob_p[t % 2] + i] = ast[from + i]
  end
  return t

list_get: procedure = .int
  arg o = .int, i = .int
  return sl[ob_p[o % 2] + i]

/* ---- names, classes ---- */
nameid: procedure = .int
  arg name = .string
  v = .string
  v = nidm[name]
  if v \== "" then return v as .int
  nnid = nnid + 1
  nid_name[nnid] = name
  nidm[name] = nnid as .string
  return nnid

define_class: procedure = .int
  arg name = .string, base = .int
  c = .int
  o = .int
  ncls = ncls + 1
  c = ncls
  cl_name[c] = name
  cl_base[c] = base
  cl_ns[c] = 0
  cl_flags[c] = 0
  o = newobj(16)
  ob_x[o % 2] = c
  cl_obj[c] = o
  if base > 0 then cl_flags[c] = cl_flags[base]
  return c

/* look a name id up through the class chain: oop or 0 */
cls_find: procedure = .int
  arg c = .int, nid = .int
  v = .string
  do while c > 0
    v = ca[c || "." || nid]
    if v \== "" then return v as .int
    c = cl_base[c]
  end
  return 0

/* the class in whose own table the name is found (0 when absent) */
cls_owner: procedure = .int
  arg c = .int, nid = .int
  v = .string
  do while c > 0
    v = ca[c || "." || nid]
    if v \== "" then return c
    c = cl_base[c]
  end
  return 0

cls_set: procedure = .void
  arg c = .int, nid = .int, v = .int
  ca[c || "." || nid] = v as .string
  cgen = cgen + 1
  return

cls_issub: procedure = .int
  arg c = .int, base = .int
  do while c > 0
    if c = base then return 1
    c = cl_base[c]
  end
  return 0

cls_of: procedure = .int
  arg x = .int
  k = .int
  if x // 2 \= 0 then return 3
  k = ob_k[x % 2]
  if k = 17 then return ob_c[x % 2]
  return kcls[k]

kind_of: procedure = .int
  arg x = .int
  if x // 2 \= 0 then return 3
  return ob_k[x % 2]

/* instance attributes: slot map per class */
inst_new: procedure = .int
  arg c = .int
  o = .int
  o = newobj(17)
  ob_c[o % 2] = c
  ob_n[o % 2] = cl_ns[c] + 2
  ob_p[o % 2] = alloc_slots(cl_ns[c] + 2)
  return o

inst_get: procedure = .int
  arg o = .int, nid = .int
  v = .string
  v = sm[ob_c[o % 2] || "." || nid]
  if v == "" then return 0
  return sl[ob_p[o % 2] + (v as .int) - 1]

inst_set: procedure = .void
  arg o = .int, nid = .int, val = .int
  ix = .int
  c = .int
  v = .string
  slot = .int
  nn = .int
  st = .int
  nst = .int
  i = .int
  ix = o % 2
  c = ob_c[ix]
  v = sm[c || "." || nid]
  if v == "" then do
    cl_ns[c] = cl_ns[c] + 1
    slot = cl_ns[c]
    sm[c || "." || nid] = slot as .string
    cgen = cgen + 1
  end
  else slot = v as .int
  if slot > ob_n[ix] then do
    nn = cl_ns[c] + 2
    if nn <= slot then nn = slot + 2
    st = ob_p[ix]
    nst = alloc_slots(nn)
    do i = 0 to ob_n[ix] - 1
      sl[nst + i] = sl[st + i]
    end
    ob_p[ix] = nst
    ob_n[ix] = nn
  end
  sl[ob_p[ix] + slot - 1] = val
  return

inst_del: procedure = .int
  arg o = .int, nid = .int
  v = .string
  slot = .int
  v = sm[ob_c[o % 2] || "." || nid]
  if v == "" then return 0
  slot = v as .int
  if sl[ob_p[o % 2] + slot - 1] = 0 then return 0
  sl[ob_p[o % 2] + slot - 1] = 0
  return 1

/* ---- exceptions ---- */
exc_new: procedure = .int
  arg c = .int, msg = .string
  o = .int
  t = .int
  o = inst_new(c)
  t = mktuple(1)
  sl[ob_p[t % 2]] = mkstr(msg)
  call inst_set o, 4, t
  return o

exc_new0: procedure = .int
  arg c = .int
  o = .int
  o = inst_new(c)
  call inst_set o, 4, mktuple(0)
  return o

/* raise a built-in exception: sets the unwind state and returns 0 */
raise_exc: procedure = .int
  arg c = .int, msg = .string
  unw = 4
  unw_v = exc_new(c, msg)
  return 0

raise_obj: procedure = .int
  arg e = .int
  unw = 4
  unw_v = e
  return 0

type_name: procedure = .string
  arg x = .int
  return cl_name[cls_of(x)]

/* ---- truth ---- */
truthy: procedure = .int
  arg x = .int
  k = .int
  m = .int
  r = .int
  if x // 2 \= 0 then do
    if x = 1 then return 0
    return 1
  end
  if x = 4 then return 1
  if x = 6 | x = 2 then return 0
  k = ob_k[x % 2]
  select
    when k = 6 then do
      if length(ob_s[x % 2]) > 0 then return 1
      return 0
    end
    when k = 7 | k = 8 then do
      if ob_n[x % 2] > 0 then return 1
      return 0
    end
    when k = 9 | k = 10 then do
      if dd_n[ob_x[x % 2]] > 0 then return 1
      return 0
    end
    when k = 5 then do
      if ob_f[x % 2] = 0.0 then return 0
      return 1
    end
    when k = 4 then return 1
    when k = 11 then do
      if range_len(x) > 0 then return 1
      return 0
    end
    when k = 17 then do
      m = cls_find(ob_c[x % 2], 101)
      if m > 0 then do
        r = call0(m, x)
        if r = 0 then return 0
        return truthy(r)
      end
      m = cls_find(ob_c[x % 2], 121)
      if m > 0 then do
        r = call0(m, x)
        if r = 0 then return 0
        return truthy(r)
      end
      return 1
    end
    otherwise return 1
  end
  return 1

/* ---- dictionaries and sets ---- */
dict_new: procedure = .int
  arg kind = .int
  o = .int
  o = newobj(kind)
  ndd = ndd + 1
  dd_head[ndd] = 0
  dd_tail[ndd] = 0
  dd_n[ndd] = 0
  ob_x[o % 2] = ndd
  return o

dict_find: procedure = .int
  arg d = .int, key = .string
  v = .string
  v = dmap[d || "|" || key]
  if v == "" then return 0
  return v as .int

dict_put: procedure = .void
  arg d = .int, key = .string, k = .int, v = .int
  e = .int
  e = dict_find(d, key)
  if e > 0 then do
    de_val[e] = v
    return
  end
  nde = nde + 1
  e = nde
  de_key[e] = k
  de_val[e] = v
  de_next[e] = 0
  de_live[e] = 1
  de_hk[e] = key
  if dd_tail[d] > 0 then de_next[dd_tail[d]] = e
  else dd_head[d] = e
  dd_tail[d] = e
  dd_n[d] = dd_n[d] + 1
  dmap[d || "|" || key] = e as .string
  return

dict_del: procedure = .int
  arg d = .int, key = .string
  e = .int
  e = dict_find(d, key)
  if e = 0 then return 0
  de_live[e] = 0
  dd_n[d] = dd_n[d] - 1
  dmap[d || "|" || key] = ""
  return e

dict_clear: procedure = .void
  arg d = .int
  e = .int
  e = dd_head[d]
  do while e > 0
    if de_live[e] = 1 then do
      de_live[e] = 0
      dmap[d || "|" || de_hk[e]] = ""
    end
    e = de_next[e]
  end
  dd_head[d] = 0
  dd_tail[d] = 0
  dd_n[d] = 0
  return

/* first live entry at or after e */
de_live_from: procedure = .int
  arg e = .int
  do while e > 0
    if de_live[e] = 1 then return e
    e = de_next[e]
  end
  return 0

/* a dict key string for hashing: ints and equal floats agree */
hashkey: procedure = .string
  arg x = .int
  k = .int
  f = .float
  s = .string
  m = .int
  r = .int
  i = .int
  n = .int
  if x // 2 \= 0 then return "i" || ((x - 1) % 2)
  k = ob_k[x % 2]
  select
    when k = 6 then return "s" || ob_s[x % 2]
    when k = 2 then do
      if x = 4 then return "i1"
      return "i0"
    end
    when k = 1 then return "N"
    when k = 4 then return "i" || ob_s[x % 2]
    when k = 5 then do
      f = ob_f[x % 2]
      if f = rxfloat..floor(f) & f > -900000000000000000.0 & f < 900000000000000000.0 then return "i" || (rxfloat..trunc(f) as .int)
      return "f" || float_repr(f)
    end
    when k = 8 then do
      s = "t("
      n = ob_n[x % 2]
      do i = 0 to n - 1
        s = s || length(hashkey(sl[ob_p[x % 2] + i])) || ":" || hashkey(sl[ob_p[x % 2] + i]) || ","
      end
      return s || ")"
    end
    when k = 17 then do
      m = cls_find(ob_c[x % 2], 116)
      if m > 0 then do
        r = call0(m, x)
        if r = 0 then return "?"
        return "h" || ival(r)
      end
      return "o" || x
    end
    otherwise return "o" || x
  end
  return "o" || x

dget: procedure = .int
  arg d = .int, key = .int
  return dict_find(ob_x[d % 2], hashkey(key))

dset: procedure = .void
  arg d = .int, key = .int, v = .int
  call dict_put ob_x[d % 2], hashkey(key), key, v
  return

mkrange: procedure = .int
  arg a = .int, b = .int, c = .int
  o = .int
  o = newobj(11)
  ob_n[o % 2] = a
  ob_x[o % 2] = b
  ob_y[o % 2] = c
  return o

range_len: procedure = .int
  arg r = .int
  a = .int
  b = .int
  c = .int
  a = ob_n[r % 2]
  b = ob_x[r % 2]
  c = ob_y[r % 2]
  if c > 0 then do
    if b <= a then return 0
    return (b - a + c - 1) % c
  end
  if a <= b then return 0
  return (a - b - c - 1) % (0 - c)

/* ---------------------------------------------------------------------
   Arbitrary-precision integers on decimal strings (as in the Smalltalk interpreter)
   --------------------------------------------------------------------- */
mag_clean: procedure = .string
  arg s = .string
  p = .int
  p = verify(s, "0", "N")
  if p = 0 then return "0"
  return substr(s, p)

mag_cmp: procedure = .int
  arg a = .string, b = .string
  if length(a) < length(b) then return -1
  if length(a) > length(b) then return 1
  if a == b then return 0
  if a << b then return -1
  return 1

mag_add: procedure = .string
  arg a = .string, b = .string
  r = .string
  i = .int
  j = .int
  x = .int
  y = .int
  c = .int
  s = .int
  piece = .string
  i = length(a)
  j = length(b)
  c = 0
  r = ""
  do while i > 0 | j > 0 | c > 0
    x = 0
    y = 0
    if i > 0 then do
      if i > 9 then x = substr(a, i - 8, 9) as .int
      else x = substr(a, 1, i) as .int
      i = i - 9
    end
    if j > 0 then do
      if j > 9 then y = substr(b, j - 8, 9) as .int
      else y = substr(b, 1, j) as .int
      j = j - 9
    end
    s = x + y + c
    if s >= 1000000000 then do
      s = s - 1000000000
      c = 1
    end
    else c = 0
    piece = s as .string
    if i > 0 | j > 0 | c > 0 then piece = right(copies("0", 9) || piece, 9)
    r = piece || r
  end
  return mag_clean(r)

/* a >= b */
mag_sub: procedure = .string
  arg a = .string, b = .string
  r = .string
  i = .int
  j = .int
  x = .int
  y = .int
  c = .int
  s = .int
  piece = .string
  i = length(a)
  j = length(b)
  c = 0
  r = ""
  do while i > 0
    if i > 9 then x = substr(a, i - 8, 9) as .int
    else x = substr(a, 1, i) as .int
    i = i - 9
    y = 0
    if j > 0 then do
      if j > 9 then y = substr(b, j - 8, 9) as .int
      else y = substr(b, 1, j) as .int
      j = j - 9
    end
    s = x - y - c
    if s < 0 then do
      s = s + 1000000000
      c = 1
    end
    else c = 0
    piece = s as .string
    if i > 0 then piece = right(copies("0", 9) || piece, 9)
    r = piece || r
  end
  return mag_clean(r)

mag_mul: procedure = .string
  arg a = .string, b = .string
  la = .int
  lb = .int
  i = .int
  j = .int
  k = .int
  x = .int
  c = .int
  t = .int
  r = .string
  piece = .string
  al0 = .int[]
  bl0 = .int[]
  rl = .int[]
  if a == "0" | b == "0" then return "0"
  la = 0
  i = length(a)
  do while i > 0
    la = la + 1
    if i > 9 then al0[la] = substr(a, i - 8, 9) as .int
    else al0[la] = substr(a, 1, i) as .int
    i = i - 9
  end
  lb = 0
  i = length(b)
  do while i > 0
    lb = lb + 1
    if i > 9 then bl0[lb] = substr(b, i - 8, 9) as .int
    else bl0[lb] = substr(b, 1, i) as .int
    i = i - 9
  end
  do k = 1 to la + lb
    rl[k] = 0
  end
  do i = 1 to la
    c = 0
    x = al0[i]
    do j = 1 to lb
      t = x * bl0[j] + rl[i + j - 1] + c
      c = t % 1000000000
      rl[i + j - 1] = t // 1000000000
    end
    k = i + lb
    do while c > 0
      t = rl[k] + c
      c = t % 1000000000
      rl[k] = t // 1000000000
      k = k + 1
    end
  end
  k = la + lb
  do while k > 1 & rl[k] = 0
    k = k - 1
  end
  r = rl[k] as .string
  do i = k - 1 to 1 by -1
    piece = rl[i] as .string
    r = r || right(copies("0", 9) || piece, 9)
  end
  return mag_clean(r)

/* truncated division of magnitudes: quotient in bq, remainder in brm */
mag_divmod: procedure = .void
  arg a = .string, b = .string
  i = .int
  r = .string
  q = .string
  d = .int
  qd = .int
  bn = .int
  rn = .int
  chunk = .int
  cur = .int
  p = .int
  l = .int
  piece = .string
  if mag_cmp(a, b) < 0 then do
    bq = "0"
    brm = a
    return
  end
  if length(b) <= 9 then do
    bn = b as .int
    rn = 0
    q = ""
    l = length(a)
    /* first chunk length so the rest are 9 digits */
    p = l // 9
    if p = 0 then p = 9
    cur = 1
    do while cur <= l
      chunk = substr(a, cur, p) as .int
      cur = cur + p
      rn = rn * (10 ** length(substr(a, cur - p, p))) + chunk
      qd = rn % bn
      rn = rn // bn
      piece = right(copies("0", 9) || qd, 9)
      q = q || piece
      p = 9
    end
    bq = mag_clean(q)
    brm = rn as .string
    return
  end
  r = "0"
  q = ""
  do i = 1 to length(a)
    r = mag_clean(r || substr(a, i, 1))
    qd = 0
    do while mag_cmp(r, b) >= 0
      r = mag_sub(r, b)
      qd = qd + 1
    end
    q = q || qd
  end
  bq = mag_clean(q)
  brm = r
  return

/* signed string helpers: s is "123" or "-123" */
sgn_split: procedure = .void
  arg s = .string
  if left(s, 1) == "-" then do
    sg = -1
    mg = substr(s, 2)
  end
  else do
    sg = 1
    mg = s
  end
  return

sgn_make: procedure = .string
  arg sgv = .int, mgv = .string
  if mgv == "0" then return "0"
  if sgv < 0 then return "-" || mgv
  return mgv

sadd: procedure = .string
  arg a = .string, b = .string
  sa = .int
  sb = .int
  ma = .string
  mb = .string
  c = .int
  call sgn_split a
  sa = sg
  ma = mg
  call sgn_split b
  sb = sg
  mb = mg
  if sa = sb then return sgn_make(sa, mag_add(ma, mb))
  c = mag_cmp(ma, mb)
  if c = 0 then return "0"
  if c > 0 then return sgn_make(sa, mag_sub(ma, mb))
  return sgn_make(sb, mag_sub(mb, ma))

sneg: procedure = .string
  arg a = .string
  if a == "0" then return "0"
  if left(a, 1) == "-" then return substr(a, 2)
  return "-" || a

ssub: procedure = .string
  arg a = .string, b = .string
  return sadd(a, sneg(b))

smul: procedure = .string
  arg a = .string, b = .string
  sa = .int
  sb = .int
  ma = .string
  mb = .string
  call sgn_split a
  sa = sg
  ma = mg
  call sgn_split b
  sb = sg
  mb = mg
  return sgn_make(sa * sb, mag_mul(ma, mb))

/* truncated quotient and remainder: results in sq, sr */
sdivmod: procedure = .void
  arg a = .string, b = .string
  sa = .int
  sb = .int
  ma = .string
  mb = .string
  call sgn_split a
  sa = sg
  ma = mg
  call sgn_split b
  sb = sg
  mb = mg
  call mag_divmod ma, mb
  sq = sgn_make(sa * sb, bq)
  sr = sgn_make(sa, brm)
  return

scmp: procedure = .int
  arg a = .string, b = .string
  sa = .int
  sb = .int
  ma = .string
  mb = .string
  call sgn_split a
  sa = sg
  ma = mg
  call sgn_split b
  sb = sg
  mb = mg
  if ma == "0" then sa = 0
  if mb == "0" then sb = 0
  if sa < sb then return -1
  if sa > sb then return 1
  if sa = 0 then return 0
  if sa > 0 then return mag_cmp(ma, mb)
  return mag_cmp(mb, ma)


/* decimal string of an integer oop (small, bool or big) */
num_str: procedure = .string
  arg x = .int
  if x // 2 \= 0 then return ival(x) as .string
  if ob_k[x % 2] = 4 then return ob_s[x % 2]
  return ival(x) as .string

/* oop for an integer given as a (signed) decimal string */
big_norm: procedure = .int
  arg s0 = .string
  s = .string
  neg = .int
  s = s0
  neg = 0
  if left(s, 1) == "-" then do
    neg = 1
    s = substr(s, 2)
  end
  s = mag_clean(s)
  if length(s) <= 18 then do
    if neg = 1 then return (0 - (s as .int)) * 2 + 1
    return (s as .int) * 2 + 1
  end
  if neg = 1 then s = "-" || s
  return mkbig(s)

/* integer power of a decimal string (exponent >= 0) */
big_pow: procedure = .string
  arg b = .string, e = .int
  r = .string
  p = .string
  r = "1"
  p = b
  do while e > 0
    if e // 2 = 1 then r = smul(r, p)
    e = e % 2
    if e > 0 then p = smul(p, p)
  end
  return r

/* integer string of a float's truncation (|f| large) */
float_to_istr: procedure = .string
  arg f = .float
  neg = .int
  x = .float
  neg = 0
  x = f
  if x < 0.0 then do
    neg = 1
    x = 0.0 - x
  end
  call float_exact x
  if fx_q >= 0 then fx_d = fx_d || copies("0", fx_q)
  else do
    if length(fx_d) + fx_q <= 0 then fx_d = "0"
    else fx_d = left(fx_d, length(fx_d) + fx_q)
  end
  if neg = 1 & fx_d \== "0" then return "-" || fx_d
  return fx_d

/* oop for the truncation of a float (0 if nan or inf) */
float_to_int: procedure = .int
  arg f = .float
  if f \= f then return 0
  if finf(f) \= 0 then return 0
  if f > -900000000000000000.0 & f < 900000000000000000.0 then return (rxfloat..trunc(f) as .int) * 2 + 1
  return big_norm(float_to_istr(f))

/* 0 finite or nan, 1 +inf, 2 -inf */
finf: procedure = .int
  arg f = .float
  d = .float
  if f \= f then return 0
  d = f - f
  if d = 0.0 then return 0
  if f > 0.0 then return 1
  return 2

f_inf: procedure = .float
  z = .float
  z = 1.0e308
  z = z * 10.0
  return z

f_nan: procedure = .float
  z = .float
  z = f_inf()
  return z - z

/* exact decimal expansion of the finite non-negative float x:  x = fx_d * 10 ** fx_q
   (fx_d has no leading or trailing zeros; x = 0 gives "0") */
float_exact: procedure = .void
  arg f = .float
  x = .float
  e = .int
  m = .int
  k = .int
  z = .int
  x = f
  if x = 0.0 then do
    fx_d = "0"
    fx_q = 0
    return
  end
  e = 0
  do while x >= 38685626227668133590597632.0
    x = x / 4294967296.0
    e = e + 32
  end
  do while x >= 9007199254740992.0
    x = x / 2.0
    e = e + 1
  end
  do while x < 4503599627370496.0
    if x < 1048576.0 then do
      x = x * 4294967296.0
      e = e - 32
    end
    else do
      x = x * 2.0
      e = e - 1
    end
  end
  m = rxfloat..trunc(x) as .int
  if e >= 0 then do
    fx_d = smul(m as .string, big_pow("2", e))
    fx_q = 0
  end
  else do
    fx_d = smul(m as .string, big_pow("5", 0 - e))
    fx_q = e
  end
  /* strip trailing zeros */
  k = length(fx_d)
  z = k
  do while z > 1 & substr(fx_d, z, 1) == "0"
    z = z - 1
  end
  if z < k then do
    fx_q = fx_q + (k - z)
    fx_d = left(fx_d, z)
  end
  return

/* n significant digits (correctly rounded, half even) of |f|; the decimal exponent of the
   first digit is left in fx_e */
float_digits: procedure = .string
  arg f = .float, n = .int
  l = .int
  head = .string
  rest = .string
  up = .int
  first = .string
  lastd = .int
  call float_exact f
  l = length(fx_d)
  fx_e = l - 1 + fx_q
  if fx_d == "0" then do
    fx_e = 0
    return copies("0", n)
  end
  if l <= n then return fx_d || copies("0", n - l)
  head = left(fx_d, n)
  rest = substr(fx_d, n + 1)
  first = left(rest, 1)
  up = 0
  if first >>= "6" then up = 1
  else if first == "5" then do
    if length(rest) > 1 then up = 1
    else do
      lastd = right(head, 1) as .int
      if lastd // 2 = 1 then up = 1
    end
  end
  if up = 1 then do
    head = mag_add(head, "1")
    if length(head) > n then do
      head = left(head, n)
      fx_e = fx_e + 1
    end
  end
  return head

/* parse a decimal float literal string; handles overflow / underflow without a panic */
parse_flt: procedure = .float
  arg s0 = .string
  s = .string
  p = .int
  ex = .int
  mant = .string
  ip = .int
  y = .float
  z = .float
  s = lower(s0)
  p = pos("e", s)
  ex = 0
  mant = s
  if p > 0 then do
    mant = left(s, p - 1)
    s = substr(s, p + 1)
    if left(s, 1) == "+" then s = substr(s, 2)
    ex = s as .int
  end
  ip = pos(".", mant)
  if ip = 0 then ip = length(mant) + 1
  if ex + ip - 1 > 310 then return f_inf()
  if ex + ip - 1 < -330 then return 0.0
  if ex >= -290 & ex <= 290 then return (mant || "e" || ex) as .float
  if ex > 290 then do
    y = (mant || "e290") as .float
    z = rxfloat..pow10((ex - 290) as .float)
    return y * z
  end
  y = (mant || "e-290") as .float
  z = rxfloat..pow10((ex + 290) as .float)
  return y * z

/* shortest repr that round-trips (as Python's repr) */
float_repr: procedure = .string
  arg f = .float
  x = .float
  neg = .int
  n = .int
  d = .string
  dexp = .int
  ds = .string
  y = .float
  ok = .int
  l = .int
  mant = .string
  es = .string
  if f \= f then return "nan"
  if finf(f) = 1 then return "inf"
  if finf(f) = 2 then return "-inf"
  if f = 0.0 then do
    if fl_negzero(f) = 1 then return "-0.0"
    return "0.0"
  end
  x = f
  neg = 0
  if x < 0.0 then do
    neg = 1
    x = 0.0 - x
  end
  ok = 0
  do n = 15 to 17
    d = float_digits(x, n)
    dexp = fx_e
    if n = 17 | dexp < -300 then ok = 1
    else do
      y = (left(d, 1) || "." || substr(d, 2) || "e" || dexp) as .float
      if y = x then ok = 1
    end
    if ok = 1 then leave
  end
  /* strip trailing zeros */
  l = length(d)
  do while l > 1 & substr(d, l, 1) == "0"
    l = l - 1
  end
  ds = left(d, l)
  if dexp >= -4 & dexp < 16 then do
    if dexp >= 0 then do
      if length(ds) <= dexp + 1 then mant = ds || copies("0", dexp + 1 - length(ds)) || ".0"
      else mant = left(ds, dexp + 1) || "." || substr(ds, dexp + 2)
    end
    else mant = "0." || copies("0", 0 - dexp - 1) || ds
  end
  else do
    mant = left(ds, 1)
    if length(ds) > 1 then mant = mant || "." || substr(ds, 2)
    if dexp < 0 then es = "-"
    else es = "+"
    d = abs(dexp) as .string
    if length(d) < 2 then d = "0" || d
    mant = mant || "e" || es || d
  end
  if neg = 1 then return "-" || mant
  return mant

fl_negzero: procedure = .int
  arg f = .float
  s = .string
  s = f as .string
  if left(s, 1) == "-" then return 1
  return 0

/* fixed notation with nd decimals (C printf %.{nd}f) */
float_fixed: procedure = .string
  arg f = .float, nd = .int
  x = .float
  neg = .int
  d = .string
  q = .int
  r = .string
  cut = .int
  head = .string
  rest = .string
  up = .int
  first = .string
  lastd = .int
  ip = .string
  fp = .string
  if f \= f then return "nan"
  if finf(f) = 1 then return "inf"
  if finf(f) = 2 then return "-inf"
  x = f
  neg = 0
  if x < 0.0 then do
    neg = 1
    x = 0.0 - x
  end
  else if x = 0.0 then do
    if fl_negzero(f) = 1 then neg = 1
  end
  call float_exact x
  d = fx_d
  q = fx_q + nd
  if d == "0" then r = "0"
  else if q >= 0 then r = d || copies("0", q)
  else do
    cut = 0 - q
    if cut > length(d) then r = "0"
    else do
      head = left(d, length(d) - cut)
      rest = right(d, cut)
      if head == "" then head = "0"
      first = left(rest, 1)
      up = 0
      if first >>= "6" then up = 1
      else if first == "5" then do
        if length(rest) > 1 then up = 1
        else do
          lastd = right(head, 1) as .int
          if lastd // 2 = 1 then up = 1
        end
      end
      if up = 1 then head = mag_add(head, "1")
      r = head
    end
  end
  r = mag_clean(r)
  if nd > 0 then do
    if length(r) <= nd then r = copies("0", nd - length(r) + 1) || r
    ip = left(r, length(r) - nd)
    fp = right(r, nd)
    r = ip || "." || fp
  end
  if neg = 1 then return "-" || r
  return r

/* scientific notation with nd digits after the point: d.ddde+XX */
float_sci: procedure = .string
  arg f = .float, nd = .int, upper = .int
  x = .float
  neg = .int
  d = .string
  es = .string
  ee = .string
  if f \= f then return "nan"
  if finf(f) = 1 then return "inf"
  if finf(f) = 2 then return "-inf"
  x = f
  neg = 0
  if x < 0.0 then do
    neg = 1
    x = 0.0 - x
  end
  d = float_digits(x, nd + 1)
  if x = 0.0 then fx_e = 0
  if nd > 0 then d = left(d, 1) || "." || substr(d, 2)
  if fx_e < 0 then es = "-"
  else es = "+"
  ee = abs(fx_e) as .string
  if length(ee) < 2 then ee = "0" || ee
  if upper = 1 then d = d || "E" || es || ee
  else d = d || "e" || es || ee
  if neg = 1 then return "-" || d
  return d

/* ---------------------------------------------------------------------
   Arithmetic, comparison, equality, containment
   --------------------------------------------------------------------- */
numkind: procedure = .int
  arg x = .int
  k = .int
  if x // 2 \= 0 then return 1
  k = ob_k[x % 2]
  if k = 2 then return 1
  if k = 4 then return 2
  if k = 5 then return 3
  return 0

tofloat: procedure = .float
  arg x = .int
  if x // 2 \= 0 then return ((x - 1) % 2) as .float
  if ob_k[x % 2] = 2 then do
    if x = 4 then return 1.0
    return 0.0
  end
  if ob_k[x % 2] = 4 then return parse_flt(ob_s[x % 2])
  return ob_f[x % 2]

err_binop: procedure = .int
  arg sym = .string, x = .int, y = .int
  return raise_exc(38, "unsupported operand type(s) for " || sym || ": '" || type_name(x) || "' and '" || type_name(y) || "'")

op_sym: procedure = .string
  arg op = .int
  select
    when op = 1 then return "+"
    when op = 2 then return "-"
    when op = 3 then return "*"
    when op = 4 then return "/"
    when op = 5 then return "//"
    when op = 6 then return "%"
    when op = 7 then return "** or pow()"
    when op = 8 then return "<<"
    when op = 9 then return ">>"
    when op = 10 then return "&"
    when op = 11 then return "|"
    when op = 12 then return "^"
    when op = 13 then return "@"
    otherwise return "?"
  end
  return "?"

/* arithmetic on two numbers (kinds: 1 small/bool, 2 big, 3 float) */
numarith: procedure = .int
  arg op = .int, x = .int, y = .int
  kx = .int
  ky = .int
  fx = .float
  fy = .float
  a = .int
  b = .int
  q = .int
  r = .int
  sx = .string
  sy = .string
  fa = .float
  fb2 = .float
  res = .int
  m = .int
  kx = numkind(x)
  ky = numkind(y)
  if kx = 3 | ky = 3 then do
    fx = tofloat(x)
    fy = tofloat(y)
    select
      when op = 1 then return mkfloat(fx + fy)
      when op = 2 then return mkfloat(fx - fy)
      when op = 3 then return mkfloat(fx * fy)
      when op = 4 then do
        if fy = 0.0 then do
          if ky = 3 | kx = 3 then return raise_exc(30, "float division by zero")
          return raise_exc(30, "division by zero")
        end
        return mkfloat(fx / fy)
      end
      when op = 5 then do
        if fy = 0.0 then return raise_exc(30, "float floor division by zero")
        return mkfloat(rxfloat..floor(fx / fy))
      end
      when op = 6 then do
        if fy = 0.0 then return raise_exc(30, "float modulo by zero")
        fa = fx - fy * rxfloat..floor(fx / fy)
        return mkfloat(fa)
      end
      when op = 7 then do
        if fx = 0.0 & fy < 0.0 then return raise_exc(30, "0.0 cannot be raised to a negative power")
        return mkfloat(rxfloat..pow(fx, fy))
      end
      otherwise return err_binop(op_sym(op), x, y)
    end
  end
  if kx = 1 & ky = 1 then do
    a = ival(x)
    b = ival(y)
    select
      when op = 1 then return mkint(a + b)
      when op = 2 then return mkint(a - b)
      when op = 3 then do
        fa = a as .float
        fb2 = b as .float
        if rxfloat..fabs(fa * fb2) < 900000000000000000.0 then return mkint(a * b)
        return big_norm(smul(a as .string, b as .string))
      end
      when op = 4 then do
        if b = 0 then return raise_exc(30, "division by zero")
        return mkfloat((a as .float) / (b as .float))
      end
      when op = 5 | op = 6 then do
        if b = 0 then return raise_exc(30, "integer division or modulo by zero")
        q = a % b
        r = a // b
        if r \= 0 & ((r < 0) \= (b < 0)) then do
          q = q - 1
          r = r + b
        end
        if op = 5 then return mkint(q)
        return mkint(r)
      end
      when op = 7 then return int_pow(x, y)
      when op = 8 then do
        if b < 0 then return raise_exc(36, "negative shift count")
        if b < 60 & a > -1000000 & a < 1000000 & b < 40 then return mkint(a * (2 ** b))
        return big_norm(smul(a as .string, big_pow("2", b)))
      end
      when op = 9 then do
        if b < 0 then return raise_exc(36, "negative shift count")
        if b > 62 then do
          if a < 0 then return mkint(-1)
          return mkint(0)
        end
        assembler ishr r, a, b
        return mkint(r)
      end
      when op = 10 then do
        assembler iand r, a, b
        return mkint(r)
      end
      when op = 11 then do
        assembler ior r, a, b
        return mkint(r)
      end
      when op = 12 then do
        assembler ixor r, a, b
        return mkint(r)
      end
      otherwise return err_binop(op_sym(op), x, y)
    end
  end
  /* at least one big integer */
  sx = num_str(x)
  sy = num_str(y)
  select
    when op = 1 then return big_norm(sadd(sx, sy))
    when op = 2 then return big_norm(ssub(sx, sy))
    when op = 3 then return big_norm(smul(sx, sy))
    when op = 4 then do
      if sy == "0" then return raise_exc(30, "division by zero")
      return mkfloat(tofloat(x) / tofloat(y))
    end
    when op = 5 | op = 6 then do
      if sy == "0" then return raise_exc(30, "integer division or modulo by zero")
      call sdivmod sx, sy
      if sr \== "0" & ((left(sx, 1) == "-") \= (left(sy, 1) == "-")) then do
        if op = 5 then return big_norm(ssub(sq, "1"))
        return big_norm(sadd(sr, sy))
      end
      if op = 5 then return big_norm(sq)
      return big_norm(sr)
    end
    when op = 7 then return int_pow(x, y)
    when op = 8 then do
      if ky \= 1 then return raise_exc(31, "shift count too large")
      b = ival(y)
      if b < 0 then return raise_exc(36, "negative shift count")
      return big_norm(smul(sx, big_pow("2", b)))
    end
    when op = 9 then do
      if ky \= 1 then return mkint(0)
      b = ival(y)
      call sdivmod sx, big_pow("2", b)
      if sr \== "0" & left(sx, 1) == "-" then return big_norm(ssub(sq, "1"))
      return big_norm(sq)
    end
    otherwise return raise_exc(38, "bitwise operation on huge integers is not supported")
  end
  return 0

int_pow: procedure = .int
  arg x = .int, y = .int
  a = .int
  b = .int
  r = .int
  est = .float
  fa = .float
  if numkind(y) = 2 then do
    return raise_exc(31, "exponent too large")
  end
  b = ival(y)
  if b < 0 then do
    if numkind(x) = 1 & ival(x) = 0 then return raise_exc(30, "0.0 cannot be raised to a negative power")
    return mkfloat(rxfloat..pow(tofloat(x), b as .float))
  end
  if numkind(x) = 1 then do
    a = ival(x)
    if a = 0 | a = 1 then do
      if b = 0 then return mkint(1)
      return mkint(a)
    end
    if a = -1 then do
      if b // 2 = 0 then return mkint(1)
      return mkint(-1)
    end
    fa = a as .float
    est = (b as .float) * rxfloat..log10(rxfloat..fabs(fa))
    if est < 17.0 then do
      r = 1
      do while b > 0
        if b // 2 = 1 then r = r * a
        b = b % 2
        if b > 0 then a = a * a
      end
      return mkint(r)
    end
  end
  return big_norm(big_pow(num_str(x), b))

arith: procedure = .int
  arg op = .int, x = .int, y = .int
  kx = .int
  ky = .int
  m = .int
  r = .int
  o = .int
  i = .int
  n = .int
  s = .string
  cnt = .int
  e = .int
  d = .int
  p = .int
  q = .int
  kx = kind_of(x)
  ky = kind_of(y)
  if numkind(x) > 0 & numkind(y) > 0 then return numarith(op, x, y)
  if kx = 17 | ky = 17 then do
    if kx = 17 then do
      m = cls_find(ob_c[x % 2], opd[op])
      if m > 0 then do
        r = call2(m, x, y)
        if r \= 10 then return r
        if unw > 0 then return 0
      end
    end
    if ky = 17 then do
      m = cls_find(ob_c[y % 2], ropd[op])
      if m > 0 then do
        r = call2(m, y, x)
        if r \= 10 then return r
        if unw > 0 then return 0
      end
    end
    return err_binop(op_sym(op), x, y)
  end
  select
    when op = 1 then do
      if kx = 6 & ky = 6 then return mkstr(ob_s[x % 2] || ob_s[y % 2])
      if kx = 7 & ky = 7 then do
        o = mklist(ob_n[x % 2] + ob_n[y % 2])
        call list_extend_from o, x
        call list_extend_from o, y
        return o
      end
      if kx = 8 & ky = 8 then do
        n = ob_n[x % 2] + ob_n[y % 2]
        o = mktuple(n)
        do i = 0 to ob_n[x % 2] - 1
          sl[ob_p[o % 2] + i] = sl[ob_p[x % 2] + i]
        end
        do i = 0 to ob_n[y % 2] - 1
          sl[ob_p[o % 2] + ob_n[x % 2] + i] = sl[ob_p[y % 2] + i]
        end
        return o
      end
    end
    when op = 3 then do
      if (kx = 6 | kx = 7 | kx = 8) & numkind(y) = 1 then return seq_repeat(x, ival(y))
      if (ky = 6 | ky = 7 | ky = 8) & numkind(x) = 1 then return seq_repeat(y, ival(x))
    end
    when op = 6 then do
      if kx = 6 then return fmt_percent(ob_s[x % 2], y)
    end
    when op = 11 | op = 10 | op = 2 | op = 12 then do
      if kx = 10 & ky = 10 then return set_op(op, x, y)
      if kx = 9 & ky = 9 & op = 11 then do
        o = dict_copy(x)
        call dict_update o, y
        return o
      end
    end
    otherwise nop
  end
  return err_binop(op_sym(op), x, y)

seq_repeat: procedure = .int
  arg x = .int, n = .int
  k = .int
  o = .int
  i = .int
  j = .int
  m = .int
  k = ob_k[x % 2]
  if n < 0 then n = 0
  if k = 6 then return mkstr(copies(ob_s[x % 2], n))
  m = ob_n[x % 2]
  if k = 7 then o = mklist(m * n)
  else o = mktuple(m * n)
  if k = 7 then do
    do i = 1 to n
      do j = 0 to m - 1
        call list_append o, sl[ob_p[x % 2] + j]
      end
    end
  end
  else do
    do i = 0 to n - 1
      do j = 0 to m - 1
        sl[ob_p[o % 2] + i * m + j] = sl[ob_p[x % 2] + j]
      end
    end
  end
  return o

list_extend_from: procedure = .void
  arg o = .int, src = .int
  i = .int
  do i = 0 to ob_n[src % 2] - 1
    call list_append o, sl[ob_p[src % 2] + i]
  end
  return

dict_copy: procedure = .int
  arg x = .int
  o = .int
  e = .int
  d = .int
  o = dict_new(ob_k[x % 2])
  d = ob_x[x % 2]
  e = dd_head[d]
  do while e > 0
    if de_live[e] = 1 then call dict_put ob_x[o % 2], de_hk[e], de_key[e], de_val[e]
    e = de_next[e]
  end
  return o

dict_update: procedure = .void
  arg o = .int, src = .int
  e = .int
  e = dd_head[ob_x[src % 2]]
  do while e > 0
    if de_live[e] = 1 then call dict_put ob_x[o % 2], de_hk[e], de_key[e], de_val[e]
    e = de_next[e]
  end
  return

set_op: procedure = .int
  arg op = .int, x = .int, y = .int
  o = .int
  e = .int
  dx = .int
  dy = .int
  dx = ob_x[x % 2]
  dy = ob_x[y % 2]
  o = dict_new(10)
  e = dd_head[dx]
  do while e > 0
    if de_live[e] = 1 then do
      if op = 11 then call dict_put ob_x[o % 2], de_hk[e], de_key[e], 4
      else if op = 10 then do
        if dict_find(dy, de_hk[e]) > 0 then call dict_put ob_x[o % 2], de_hk[e], de_key[e], 4
      end
      else if op = 2 then do
        if dict_find(dy, de_hk[e]) = 0 then call dict_put ob_x[o % 2], de_hk[e], de_key[e], 4
      end
      else do
        if dict_find(dy, de_hk[e]) = 0 then call dict_put ob_x[o % 2], de_hk[e], de_key[e], 4
      end
    end
    e = de_next[e]
  end
  if op = 11 | op = 12 then do
    e = dd_head[dy]
    do while e > 0
      if de_live[e] = 1 then do
        if op = 11 then call dict_put ob_x[o % 2], de_hk[e], de_key[e], 4
        else do
          if dict_find(dx, de_hk[e]) = 0 then call dict_put ob_x[o % 2], de_hk[e], de_key[e], 4
        end
      end
      e = de_next[e]
    end
  end
  return o

unary: procedure = .int
  arg op = .int, x = .int
  k = .int
  a = .int
  r = .int
  m = .int
  k = numkind(x)
  if op = 1 then do
    if k = 1 then return mkint(0 - ival(x))
    if k = 3 then return mkfloat(0.0 - ob_f[x % 2])
    if k = 2 then return big_norm(sneg(ob_s[x % 2]))
    if kind_of(x) = 17 then do
      m = cls_find(ob_c[x % 2], 125)
      if m > 0 then return call1(m, x)
    end
    return raise_exc(38, "bad operand type for unary -: '" || type_name(x) || "'")
  end
  if op = 2 then do
    if k = 1 then return mkint(ival(x))
    if k > 0 then return x
    return raise_exc(38, "bad operand type for unary +: '" || type_name(x) || "'")
  end
  if k = 1 then do
    a = ival(x)
    assembler inot r, a
    return mkint(r)
  end
  if k = 2 then return big_norm(ssub(sneg(ob_s[x % 2]), "1"))
  return raise_exc(38, "bad operand type for unary ~: '" || type_name(x) || "'")

/* numeric comparison: -1, 0, 1 or 2 (unordered) */
numcmp: procedure = .int
  arg x = .int, y = .int
  kx = .int
  ky = .int
  fx = .float
  fy = .float
  a = .int
  b = .int
  kx = numkind(x)
  ky = numkind(y)
  if kx = 3 | ky = 3 then do
    fx = tofloat(x)
    fy = tofloat(y)
    if fx \= fx | fy \= fy then return 2
    if fx < fy then return -1
    if fx > fy then return 1
    return 0
  end
  if kx = 1 & ky = 1 then do
    a = ival(x)
    b = ival(y)
    if a < b then return -1
    if a > b then return 1
    return 0
  end
  return scmp(num_str(x), num_str(y))

/* equality of two values; returns 0/1 (errors set unw) */
py_eq: procedure = .int
  arg x = .int, y = .int
  kx = .int
  ky = .int
  i = .int
  n = .int
  e = .int
  m = .int
  r = .int
  d = .int
  if x = y then do
    if x // 2 = 0 then do
      if ob_k[x % 2] = 5 then do
        if ob_f[x % 2] \= ob_f[x % 2] then return 0
      end
    end
    return 1
  end
  if x // 2 \= 0 & y // 2 \= 0 then return 0
  kx = kind_of(x)
  ky = kind_of(y)
  if numkind(x) > 0 & numkind(y) > 0 then do
    if numcmp(x, y) = 0 then return 1
    return 0
  end
  if kx = 6 & ky = 6 then do
    if ob_s[x % 2] == ob_s[y % 2] then return 1
    return 0
  end
  if kx = 17 then do
    m = cls_find(ob_c[x % 2], 109)
    if m > 0 then do
      r = call2(m, x, y)
      if r = 0 then return 0
      if r = 10 then return 0
      return truthy(r)
    end
    return 0
  end
  if ky = 17 then do
    m = cls_find(ob_c[y % 2], 109)
    if m > 0 then do
      r = call2(m, y, x)
      if r = 0 then return 0
      if r = 10 then return 0
      return truthy(r)
    end
    return 0
  end
  if (kx = 7 & ky = 7) | (kx = 8 & ky = 8) then do
    n = ob_n[x % 2]
    if n \= ob_n[y % 2] then return 0
    do i = 0 to n - 1
      if py_eq(sl[ob_p[x % 2] + i], sl[ob_p[y % 2] + i]) = 0 then return 0
      if unw > 0 then return 0
    end
    return 1
  end
  if kx = 9 & ky = 9 then do
    if dd_n[ob_x[x % 2]] \= dd_n[ob_x[y % 2]] then return 0
    e = dd_head[ob_x[x % 2]]
    do while e > 0
      if de_live[e] = 1 then do
        d = dict_find(ob_x[y % 2], de_hk[e])
        if d = 0 then return 0
        if py_eq(de_val[e], de_val[d]) = 0 then return 0
      end
      e = de_next[e]
    end
    return 1
  end
  if kx = 10 & ky = 10 then do
    if dd_n[ob_x[x % 2]] \= dd_n[ob_x[y % 2]] then return 0
    e = dd_head[ob_x[x % 2]]
    do while e > 0
      if de_live[e] = 1 then do
        if dict_find(ob_x[y % 2], de_hk[e]) = 0 then return 0
      end
      e = de_next[e]
    end
    return 1
  end
  if kx = 11 & ky = 11 then do
    if range_len(x) = 0 & range_len(y) = 0 then return 1
    if range_len(x) = range_len(y) & ob_n[x % 2] = ob_n[y % 2] & ob_y[x % 2] = ob_y[y % 2] then return 1
    return 0
  end
  if kx = 14 & ky = 14 then do
    if ob_x[x % 2] = ob_x[y % 2] & ob_y[x % 2] = ob_y[y % 2] then return 1
  end
  return 0

cmp_res: procedure = .int
  arg op = .int, c = .int
  if op = 3 then do
    if c < 0 then return 4
    return 6
  end
  if op = 4 then do
    if c <= 0 then return 4
    return 6
  end
  if op = 5 then do
    if c > 0 then return 4
    return 6
  end
  if c >= 0 then return 4
  return 6

/* rich comparison; op is CMP_LT .. CMP_GE; result is a bool oop or 0 on error */
py_cmp: procedure = .int
  arg op = .int, x = .int, y = .int
  kx = .int
  ky = .int
  c = .int
  m = .int
  r = .int
  nid = .int
  rnid = .int
  i = .int
  n = .int
  n2 = .int
  eq = .int
  a = .int
  b = .int
  s1 = .string
  s2 = .string
  kx = numkind(x)
  ky = numkind(y)
  if kx > 0 & ky > 0 then do
    c = numcmp(x, y)
    if c = 2 then return 6
    return cmp_res(op, c)
  end
  kx = kind_of(x)
  ky = kind_of(y)
  if kx = 6 & ky = 6 then do
    s1 = ob_s[x % 2]
    s2 = ob_s[y % 2]
    c = 1
    if s1 << s2 then c = -1
    else if s1 == s2 then c = 0
    return cmp_res(op, c)
  end
  if (kx = 7 & ky = 7) | (kx = 8 & ky = 8) then do
    n = ob_n[x % 2]
    n2 = ob_n[y % 2]
    i = 0
    do while i < n & i < n2
      a = sl[ob_p[x % 2] + i]
      b = sl[ob_p[y % 2] + i]
      eq = py_eq(a, b)
      if unw > 0 then return 0
      if eq = 0 then do
        /* the first differing element decides */
        return py_cmp(op, a, b)
      end
      i = i + 1
    end
    c = 1
    if n < n2 then c = -1
    else if n = n2 then c = 0
    return cmp_res(op, c)
  end
  if kx = 10 & ky = 10 then do
    return set_cmp(op, x, y)
  end
  if kx = 17 | ky = 17 then do
    nid = cmpd[op]
    rnid = cmpr[op]
    if kx = 17 then do
      m = cls_find(ob_c[x % 2], nid)
      if m > 0 then do
        r = call2(m, x, y)
        if r \= 10 then return r
        if unw > 0 then return 0
      end
    end
    if ky = 17 then do
      m = cls_find(ob_c[y % 2], rnid)
      if m > 0 then do
        r = call2(m, y, x)
        if r \= 10 then return r
        if unw > 0 then return 0
      end
    end
  end
  s1 = "<"
  if op = 4 then s1 = "<="
  if op = 5 then s1 = ">"
  if op = 6 then s1 = ">="
  return raise_exc(38, "'" || s1 || "' not supported between instances of '" || type_name(x) || "' and '" || type_name(y) || "'")

set_cmp: procedure = .int
  arg op = .int, x = .int, y = .int
  sub = .int
  e = .int
  dx = .int
  dy = .int
  dx = ob_x[x % 2]
  dy = ob_x[y % 2]
  /* op LE: x subset of y ; GE: y subset of x ; LT/GT proper */
  if op = 4 | op = 3 then do
    e = dd_head[dx]
    do while e > 0
      if de_live[e] = 1 then do
        if dict_find(dy, de_hk[e]) = 0 then return 6
      end
      e = de_next[e]
    end
    if op = 3 & dd_n[dx] = dd_n[dy] then return 6
    return 4
  end
  e = dd_head[dy]
  do while e > 0
    if de_live[e] = 1 then do
      if dict_find(dx, de_hk[e]) = 0 then return 6
    end
    e = de_next[e]
  end
  if op = 5 & dd_n[dx] = dd_n[dy] then return 6
  return 4

/* x in container: 0/1, errors set unw */
py_contains: procedure = .int
  arg c = .int, x = .int
  k = .int
  i = .int
  n = .int
  e = .int
  m = .int
  r = .int
  it = .int
  v = .int
  a = .int
  b = .int
  st = .int
  k = kind_of(c)
  select
    when k = 6 then do
      if kind_of(x) \= 6 then do
        call raise_exc 38, "'in <string>' requires string as left operand, not " || type_name(x)
        return 0
      end
      if pos(ob_s[x % 2], ob_s[c % 2]) > 0 | ob_s[x % 2] == "" then return 1
      return 0
    end
    when k = 7 | k = 8 then do
      n = ob_n[c % 2]
      do i = 0 to n - 1
        if py_eq(sl[ob_p[c % 2] + i], x) = 1 then return 1
        if unw > 0 then return 0
      end
      return 0
    end
    when k = 9 | k = 10 then do
      if dict_find(ob_x[c % 2], hashkey(x)) > 0 then return 1
      return 0
    end
    when k = 11 then do
      if numkind(x) \= 1 then return 0
      v = ival(x)
      a = ob_n[c % 2]
      b = ob_x[c % 2]
      st = ob_y[c % 2]
      if st > 0 then do
        if v < a | v >= b then return 0
      end
      else do
        if v > a | v <= b then return 0
      end
      if (v - a) // st = 0 then return 1
      return 0
    end
    when k = 17 then do
      m = cls_find(ob_c[c % 2], 104)
      if m > 0 then do
        r = call2(m, c, x)
        if r = 0 then return 0
        return truthy(r)
      end
      it = iter_new(c)
      if it = 0 then return 0
      do forever
        v = iter_next(it)
        if v = 0 then leave
        if py_eq(v, x) = 1 then return 1
        if unw > 0 then return 0
      end
      return 0
    end
    when k = 19 | k = 20 then do
      do forever
        v = iter_next(c)
        if v = 0 then leave
        if py_eq(v, x) = 1 then return 1
      end
      return 0
    end
    otherwise do
      call raise_exc 38, "argument of type '" || type_name(c) || "' is not iterable"
      return 0
    end
  end
  return 0

/* ---------------------------------------------------------------------
   repr and str
   --------------------------------------------------------------------- */
repr_str: procedure = .string
  arg s = .string
  q = .string
  r = .string
  i = .int
  n = .int
  c = .string
  v = .int
  q = "'"
  if pos("'", s) > 0 & pos('"', s) = 0 then q = '"'
  r = q
  n = length(s)
  do i = 1 to n
    c = substr(s, i, 1)
    if c == q | c == "\" then r = r || "\" || c
    else if c == '0a'x then r = r || "\n"
    else if c == '09'x then r = r || "\t"
    else if c == '0d'x then r = r || "\r"
    else do
      v = c2d(c)
      if v < 32 | v = 127 then r = r || "\x" || right(d2x(v), 2, "0")
      else r = r || c
    end
  end
  return r || q

repr_of: procedure = .string
  arg x = .int
  k = .int
  s = .string
  i = .int
  n = .int
  m = .int
  r = .int
  e = .int
  d = .int
  first = .int
  c = .int
  if x // 2 \= 0 then return ((x - 1) % 2) as .string
  k = ob_k[x % 2]
  select
    when k = 6 then return repr_str(ob_s[x % 2])
    when k = 5 then return float_repr(ob_f[x % 2])
    when k = 4 then return ob_s[x % 2]
    when k = 2 then do
      if x = 4 then return "True"
      return "False"
    end
    when k = 1 then return "None"
    when k = 7 | k = 8 then do
      n = ob_n[x % 2]
      if depth_guard > 200 then return "..."
      depth_guard = depth_guard + 1
      if k = 7 then s = "["
      else s = "("
      do i = 0 to n - 1
        if i > 0 then s = s || ", "
        s = s || repr_of(sl[ob_p[x % 2] + i])
        if unw > 0 then do
          depth_guard = depth_guard - 1
          return ""
        end
      end
      depth_guard = depth_guard - 1
      if k = 8 & n = 1 then s = s || ","
      if k = 7 then return s || "]"
      return s || ")"
    end
    when k = 9 then do
      if depth_guard > 200 then return "{...}"
      depth_guard = depth_guard + 1
      s = "{"
      first = 1
      e = dd_head[ob_x[x % 2]]
      do while e > 0
        if de_live[e] = 1 then do
          if first = 0 then s = s || ", "
          first = 0
          s = s || repr_of(de_key[e]) || ": " || repr_of(de_val[e])
          if unw > 0 then do
            depth_guard = depth_guard - 1
            return ""
          end
        end
        e = de_next[e]
      end
      depth_guard = depth_guard - 1
      return s || "}"
    end
    when k = 10 then do
      if dd_n[ob_x[x % 2]] = 0 then return "set()"
      s = "{"
      first = 1
      e = dd_head[ob_x[x % 2]]
      do while e > 0
        if de_live[e] = 1 then do
          if first = 0 then s = s || ", "
          first = 0
          s = s || repr_of(de_key[e])
        end
        e = de_next[e]
      end
      return s || "}"
    end
    when k = 11 then do
      s = "range(" || ob_n[x % 2] || ", " || ob_x[x % 2]
      if ob_y[x % 2] \= 1 then s = s || ", " || ob_y[x % 2]
      return s || ")"
    end
    when k = 12 then return "<function " || fd_name[ob_x[x % 2]] || " at 0x" || right(d2x(x * 8), 12, "0") || ">"
    when k = 13 then return "<built-in function " || bi_name[ob_x[x % 2]] || ">"
    when k = 16 then do
      c = ob_x[x % 2]
      if cl_flags[c] // 2 = 1 then return "<class '" || cl_name[c] || "'>"
      return "<class '__main__." || cl_name[c] || "'>"
    end
    when k = 18 then return "<module '" || ob_s[x % 2] || "'>"
    when k = 14 then return "<bound method " || fd_name[ob_x[ob_x[x % 2] % 2]] || " of " || repr_of(ob_y[x % 2]) || ">"
    when k = 19 then return "<generator object " || fd_name[gn_fd[ob_x[x % 2]]] || " at 0x" || right(d2x(x * 8), 12, "0") || ">"
    when k = 20 then return "<iterator object at 0x" || right(d2x(x * 8), 12, "0") || ">"
    when k = 28 then return "NotImplemented"
    when k = 27 then return "Ellipsis"
    when k = 17 then do
      m = cls_find(ob_c[x % 2], 128)
      if m > 0 then do
        r = call1(m, x)
        if r = 0 then return ""
        if kind_of(r) \= 6 then do
          call raise_exc 38, "__repr__ returned non-string (type " || type_name(r) || ")"
          return ""
        end
        return ob_s[r % 2]
      end
      if cls_issub(ob_c[x % 2], 27) = 1 then return exc_repr(x)
      return "<__main__." || cl_name[ob_c[x % 2]] || " object at 0x" || right(d2x(x * 8), 12, "0") || ">"
    end
    otherwise return "<object at 0x" || right(d2x(x * 8), 12, "0") || ">"
  end
  return "?"

exc_args: procedure = .int
  arg x = .int
  a = .int
  a = inst_get(x, 4)
  if a = 0 then return mktuple(0)
  return a

exc_repr: procedure = .string
  arg x = .int
  a = .int
  s = .string
  a = exc_args(x)
  s = repr_of(a)
  if ob_n[a % 2] = 1 then s = left(s, length(s) - 2) || ")"
  return cl_name[ob_c[x % 2]] || s

exc_str: procedure = .string
  arg x = .int
  a = .int
  a = exc_args(x)
  if ob_n[a % 2] = 0 then return ""
  if ob_n[a % 2] = 1 then do
    if cls_issub(ob_c[x % 2], 35) = 1 then return repr_of(sl[ob_p[a % 2]])
    return str_of(sl[ob_p[a % 2]])
  end
  return repr_of(a)

str_of: procedure = .string
  arg x = .int
  k = .int
  m = .int
  r = .int
  if x // 2 \= 0 then return ((x - 1) % 2) as .string
  k = ob_k[x % 2]
  if k = 6 then return ob_s[x % 2]
  if k = 17 then do
    m = cls_find(ob_c[x % 2], 132)
    if m > 0 then do
      r = call1(m, x)
      if r = 0 then return ""
      if kind_of(r) \= 6 then do
        call raise_exc 38, "__str__ returned non-string (type " || type_name(r) || ")"
        return ""
      end
      return ob_s[r % 2]
    end
    if cls_issub(ob_c[x % 2], 27) = 1 then return exc_str(x)
  end
  return repr_of(x)

/* ---------------------------------------------------------------------
   Frames, calls, attributes
   --------------------------------------------------------------------- */
alloc_frame: procedure = .int
  arg size = .int
  fb = .int
  i = .int
  fb = fl_head[size]
  if fb > 0 then fl_head[size] = vp[fb]
  else do
    fb = nvp + 1
    nvp = nvp + size
  end
  do i = 0 to size - 1
    vp[fb + i] = 0
  end
  return fb

free_frame: procedure = .void
  arg fb = .int, size = .int
  vp[fb] = fl_head[size]
  fl_head[size] = fb
  return

/* push an argument on the staging stack */
push: procedure = .void
  arg v = .int
  asp = asp + 1
  ast[asp] = v
  asn[asp] = ""
  return

/* insert v before the first argument at ast[base+1 ..] (total entries = tot) */
ast_insert: procedure = .void
  arg base = .int, tot = .int, v = .int
  i = .int
  do i = tot to 1 by -1
    ast[base + i + 1] = ast[base + i]
    asn[base + i + 1] = asn[base + i]
  end
  ast[base + 1] = v
  asn[base + 1] = ""
  asp = base + tot + 1
  return

call0: procedure = .int
  arg f = .int, a = .int
  return call1(f, a)

call1: procedure = .int
  arg f = .int, a = .int
  base = .int
  r = .int
  base = asp
  call push a
  r = docall(f, base, 1, 0)
  asp = base
  return r

call2: procedure = .int
  arg f = .int, a = .int, b = .int
  base = .int
  r = .int
  base = asp
  call push a
  call push b
  r = docall(f, base, 2, 0)
  asp = base
  return r

call3: procedure = .int
  arg f = .int, a = .int, b = .int, c = .int
  base = .int
  r = .int
  base = asp
  call push a
  call push b
  call push c
  r = docall(f, base, 3, 0)
  asp = base
  return r

callz: procedure = .int
  arg f = .int
  base = .int
  r = .int
  base = asp
  r = docall(f, base, 0, 0)
  asp = base
  return r

/* call f with the arguments ast[base+1 .. base+na] positional and na+1 .. na+nk keywords */
docall: procedure = .int
  arg f = .int, base = .int, na = .int, nk = .int
  k = .int
  r = .int
  m = .int
  c = .int
  if f // 2 \= 0 then return raise_exc(38, "'int' object is not callable")
  k = ob_k[f % 2]
  select
    when k = 12 then return callfunc(f, base, na, nk)
    when k = 13 then return bcall(ob_x[f % 2], base, na, nk)
    when k = 14 then do
      call ast_insert base, na + nk, ob_y[f % 2]
      return docall(ob_x[f % 2], base, na + 1, nk)
    end
    when k = 15 then return bmeth(ob_y[f % 2], ob_x[f % 2], base, na, nk)
    when k = 16 then return instantiate(ob_x[f % 2], base, na, nk)
    when k = 17 then do
      m = cls_find(ob_c[f % 2], 102)
      if m = 0 then return raise_exc(38, "'" || type_name(f) || "' object is not callable")
      call ast_insert base, na + nk, f
      return docall(m, base, na + 1, nk)
    end
    when k = 23 then return docall(ob_x[f % 2], base, na, nk)
    otherwise return raise_exc(38, "'" || type_name(f) || "' object is not callable")
  end
  return 0

fd_missing: procedure = .int
  arg fd = .int, names = .string, cnt = .int
  if cnt = 1 then return raise_exc(38, fd_name[fd] || "() missing 1 required positional argument: " || names)
  return raise_exc(38, fd_name[fd] || "() missing " || cnt || " required positional arguments: " || names)

/* general argument binding; returns 1 or 0 (error) */
bind_args: procedure = .int
  arg f = .int, fd = .int, nf = .int, base = .int, na = .int, nk = .int
  i = .int
  j = .int
  np = .int
  r0 = .int
  nr = .int
  kd = .int
  nm = .string
  found = .int
  sl0 = .int
  kw = .int
  miss = .string
  nmiss = .int
  d = .int
  extra = .int
  t = .int
  np = fd_np[fd]
  r0 = fd_ps[fd]
  nr = fd_nr[fd]
  /* positional */
  do i = 1 to na
    if i <= np then vp[nf + 1 + i] = ast[base + i]
  end
  if na > np then do
    if fd_vs[fd] = 0 then do
      call raise_exc 38, fd_name[fd] || "() takes " || np || " positional argument" || plural(np) || " but " || na || " were given"
      return 0
    end
    vp[nf + fd_vs[fd]] = tup_from_ast(base + np + 1, base + na)
  end
  else if fd_vs[fd] > 0 then vp[nf + fd_vs[fd]] = mktuple(0)
  if fd_ks[fd] > 0 then vp[nf + fd_ks[fd]] = dict_new(9)
  /* keywords */
  do kw = 1 to nk
    nm = asn[base + na + kw]
    found = 0
    do j = 1 to nr
      kd = pr_kind[r0 + j - 1]
      if (kd = 0 | kd = 2) & pr_name[r0 + j - 1] == nm then do
        if vp[nf + pr_slot[r0 + j - 1]] \= 0 then do
          call raise_exc 38, fd_name[fd] || "() got multiple values for argument '" || nm || "'"
          return 0
        end
        vp[nf + pr_slot[r0 + j - 1]] = ast[base + na + kw]
        found = 1
        leave
      end
    end
    if found = 0 then do
      if fd_ks[fd] > 0 then call dset vp[nf + fd_ks[fd]], mkstr(nm), ast[base + na + kw]
      else do
        call raise_exc 38, fd_name[fd] || "() got an unexpected keyword argument '" || nm || "'"
        return 0
      end
    end
  end
  /* defaults and missing */
  nmiss = 0
  miss = ""
  do j = 1 to nr
    kd = pr_kind[r0 + j - 1]
    if kd = 0 | kd = 2 then do
      if vp[nf + pr_slot[r0 + j - 1]] = 0 then do
        d = sl[ob_p[f % 2] + j - 1]
        if d \= 0 then vp[nf + pr_slot[r0 + j - 1]] = d
        else do
          nmiss = nmiss + 1
          if nmiss > 1 then miss = miss || " and "
          miss = miss || "'" || pr_name[r0 + j - 1] || "'"
        end
      end
    end
  end
  if nmiss > 0 then do
    call fd_missing fd, miss, nmiss
    return 0
  end
  return 1

plural: procedure = .string
  arg n = .int
  if n = 1 then return ""
  return "s"

callfunc: procedure = .int
  arg f = .int, base = .int, na = .int, nk = .int
  fd = .int
  nf = .int
  size = .int
  np = .int
  i = .int
  r = .int
  d = .int
  ok = .int
  fx = .int
  fd = ob_x[f % 2]
  size = fd_ns[fd]
  np = fd_np[fd]
  nf = alloc_frame(size)
  vp[nf + 1] = ob_y[f % 2]
  if nk = 0 & fd_cx[fd] = 0 & na <= np then do
    do i = 1 to na
      vp[nf + 1 + i] = ast[base + i]
    end
    if na < np then do
      do i = na + 1 to np
        d = sl[ob_p[f % 2] + i - 1]
        if d = 0 then do
          call free_frame nf, size
          return fd_missing(fd, "'" || pr_name[fd_ps[fd] + i - 1] || "'", 1)
        end
        vp[nf + 1 + i] = d
      end
    end
  end
  else do
    ok = bind_args(f, fd, nf, base, na, nk)
    if ok = 0 then do
      call free_frame nf, size
      return 0
    end
  end
  if fd_fl[fd] // 2 = 1 then return gen_new(fd, nf)
  cdepth = cdepth + 1
  if cdepth > 900 then do
    cdepth = cdepth - 1
    return raise_exc(43, "maximum recursion depth exceeded")
  end
  call ex fd_body[fd], nf
  cdepth = cdepth - 1
  if unw = 1 then do
    unw = 0
    r = unw_v
  end
  else if unw = 0 then r = 2
  else r = 0
  if (fd_fl[fd] // 4) < 2 then call free_frame nf, size
  return r

/* instantiate a class */
instantiate: procedure = .int
  arg c = .int, base = .int, na = .int, nk = .int
  inst = .int
  init = .int
  r = .int
  fl = .int
  fl = cl_flags[c]
  if fl // 2 = 1 & (fl // 4) < 2 then return bcall_type(c, base, na, nk)
  inst = inst_new(c)
  if (fl // 4) >= 2 then do
    call inst_set inst, 4, tup_from_ast(base + 1, base + na)
  end
  init = cls_find(c, 118)
  if init > 0 then do
    call ast_insert base, na + nk, inst
    r = docall(init, base, na + 1, nk)
    if r = 0 then return 0
    if r \= 2 then return raise_exc(38, "__init__() should return None, not '" || type_name(r) || "'")
  end
  else if na + nk > 0 & (fl // 4) < 2 then return raise_exc(38, cl_name[c] || "() takes no arguments")
  return inst

/* ---------------------------------------------------------------------
   Attributes
   --------------------------------------------------------------------- */
no_attr: procedure = .int
  arg o = .int, nid = .int
  if kind_of(o) = 16 then return raise_exc(41, "type object '" || cl_name[ob_x[o % 2]] || "' has no attribute '" || nid_name[nid] || "'")
  if kind_of(o) = 18 then return raise_exc(41, "module '" || ob_s[o % 2] || "' has no attribute '" || nid_name[nid] || "'")
  return raise_exc(41, "'" || type_name(o) || "' object has no attribute '" || nid_name[nid] || "'")

mkbmeth: procedure = .int
  arg fn = .int, slf = .int
  o = .int
  o = newobj(14)
  ob_x[o % 2] = fn
  ob_y[o % 2] = slf
  return o

/* a value found in a class table, as seen from instance o (o = 0 for the class itself) */
bind_attr: procedure = .int
  arg v = .int, o = .int, c = .int
  k = .int
  k = kind_of(v)
  if k = 12 | k = 13 then do
    if o = 0 then return v
    return mkbmeth(v, o)
  end
  if k = 22 then do
    if o = 0 then return v
    return call1(ob_x[v % 2], o)
  end
  if k = 23 then return ob_x[v % 2]
  if k = 24 then return mkbmeth(ob_x[v % 2], cl_obj[c])
  return v

getattr_obj: procedure = .int
  arg o = .int, nid = .int, node = .int
  k = .int
  ix = .int
  c = .int
  s = .string
  v = .int
  slot = .int
  m = .int
  k = kind_of(o)
  if k = 17 then do
    ix = o % 2
    c = ob_c[ix]
    if node > 0 then do
      if n_ic[node] = c & n_iv[node] < 0 then do
        v = sl[ob_p[ix] - n_iv[node] - 1]
        if v \= 0 then return v
      end
    end
    s = sm[c || "." || nid]
    if s \== "" then do
      slot = s as .int
      v = sl[ob_p[ix] + slot - 1]
      if v \= 0 then do
        if node > 0 then do
          n_ic[node] = c
          n_iv[node] = 0 - slot
        end
        return v
      end
    end
    v = cls_find(c, nid)
    if v > 0 then return bind_attr(v, o, c)
    if nid = 103 then return cl_obj[c]
    m = cls_find(c, 114)
    if m > 0 then return call2(m, o, mkstr(nid_name[nid]))
    if nid = 106 then return inst_dict(o)
    return no_attr(o, nid)
  end
  if k = 16 then do
    c = ob_x[o % 2]
    v = cls_find(c, nid)
    if v > 0 then do
      if kind_of(v) = 24 then return mkbmeth(ob_x[v % 2], o)
      if kind_of(v) = 23 then return ob_x[v % 2]
      return v
    end
    if nid = 124 | nid = 127 then return mkstr(cl_name[c])
    if nid = 100 then do
      if cl_base[c] = 0 then return mktuple(0)
      v = mktuple(1)
      sl[ob_p[v % 2]] = cl_obj[cl_base[c]]
      return v
    end
    if nid = 123 then return cls_mro(c)
    if nid = 122 then return mkstr("__main__")
    if nid = 107 then return 2
    if nid = 103 then return cl_obj[2]
    return no_attr(o, nid)
  end
  if k = 18 then do
    s = modattr[ob_s[o % 2] || "." || nid_name[nid]]
    if s \== "" then return s as .int
    return no_attr(o, nid)
  end
  if k = 25 then do
    c = cl_base[ob_x[ob_y[o % 2] % 2]]
    v = cls_find(c, nid)
    if v = 0 then return raise_exc(41, "'super' object has no attribute '" || nid_name[nid] || "'")
    return bind_attr(v, ob_x[o % 2], c)
  end
  if k = 12 then do
    if nid = 124 | nid = 127 then return mkstr(fd_name[ob_x[o % 2]])
    if nid = 107 then return 2
    if nid = 103 then return cl_obj[13]
    return no_attr(o, nid)
  end
  if k = 13 then do
    if nid = 124 then return mkstr(bi_name[ob_x[o % 2]])
    return no_attr(o, nid)
  end
  if k = 14 then do
    if nid = 124 then return mkstr(fd_name[ob_x[ob_x[o % 2] % 2]])
    if nid = 129 then return ob_y[o % 2]
    if nid = 113 then return ob_x[o % 2]
    return no_attr(o, nid)
  end
  if k = 22 then do
    if nid = 80 then return mkbmethb(o, nid)
    if nid = 29 then return mkbmethb(o, nid)
    return no_attr(o, nid)
  end
  if nid = 103 then return cl_obj[cls_of(o)]
  if nid = 124 & k = 19 then return mkstr(fd_name[gn_fd[ob_x[o % 2]]])
  if k = 3 | k = 2 | k = 4 then do
    if nid = 66 | nid = 58 then return o
    if nid = 30 then return mkint(0)
    if nid = 16 then return mkint(1)
  end
  if k = 5 then do
    if nid = 66 then return o
    if nid = 30 then return mkfloat(0.0)
  end
  if k = 11 then do
    if nid = 84 then return mkint(ob_n[o % 2])
    if nid = 87 then return mkint(ob_x[o % 2])
    if nid = 86 then return mkint(ob_y[o % 2])
  end
  if k = 26 then do
    if nid = 57 then return mkstr(ob_s[o % 2])
    if nid = 11 then return mkbool(ob_c[o % 2])
  end
  return mkbmethb(o, nid)

inst_dict: procedure = .int
  arg o = .int
  d = .int
  c = .int
  s = .string
  i = .int
  d = dict_new(9)
  return d

cls_mro: procedure = .int
  arg c = .int
  l = .int
  l = mklist(4)
  do while c > 0
    call list_append l, cl_obj[c]
    c = cl_base[c]
  end
  return tup_of_list(l)

mkbmethb: procedure = .int
  arg o = .int, nid = .int
  b = .int
  b = newobj(15)
  ob_x[b % 2] = nid
  ob_y[b % 2] = o
  return b

/* attribute lookup for a call: a plain function found in the class is returned unbound
   with ev_self set to the receiver; built-in type methods return 1 with ev_bm = 1 */
getattr_call: procedure = .int
  arg o = .int, nid = .int, node = .int
  k = .int
  c = .int
  v = .int
  s = .string
  ix = .int
  slot = .int
  ev_self = 0
  ev_bm = 0
  k = kind_of(o)
  if k = 17 then do
    ix = o % 2
    c = ob_c[ix]
    if node > 0 then do
      if n_ic[node] = c & n_ig[node] = cgen & n_iv[node] > 0 then do
        ev_self = o
        return n_iv[node]
      end
    end
    s = sm[c || "." || nid]
    if s \== "" then do
      slot = s as .int
      v = sl[ob_p[ix] + slot - 1]
      if v \= 0 then return v
    end
    v = cls_find(c, nid)
    if v > 0 then do
      if kind_of(v) = 12 then do
        ev_self = o
        if node > 0 & s == "" then do
          n_ic[node] = c
          n_ig[node] = cgen
          n_iv[node] = v
        end
        return v
      end
      return bind_attr(v, o, c)
    end
    return getattr_obj(o, nid, 0)
  end
  if k = 6 | k = 7 | k = 9 | k = 8 | k = 10 | k = 5 | k = 3 | k = 4 | k = 2 | k = 19 | k = 26 | k = 11 then do
    if nid = 103 | nid = 124 then return getattr_obj(o, nid, 0)
    if (k = 3 | k = 4 | k = 2 | k = 5) & (nid = 66 | nid = 30) then return getattr_obj(o, nid, 0)
    ev_bm = 1
    ev_self = o
    return 1
  end
  if k = 25 then do
    c = cl_base[ob_x[ob_y[o % 2] % 2]]
    v = cls_find(c, nid)
    if v = 0 then return raise_exc(41, "'super' object has no attribute '" || nid_name[nid] || "'")
    ev_self = ob_x[o % 2]
    if kind_of(v) = 12 | kind_of(v) = 13 then return v
    return bind_attr(v, ob_x[o % 2], c)
  end
  if k = 16 then do
    c = ob_x[o % 2]
    v = cls_find(c, nid)
    if v > 0 then do
      if kind_of(v) = 24 then return mkbmeth(ob_x[v % 2], o)
      if kind_of(v) = 23 then return ob_x[v % 2]
      return v
    end
    if cl_flags[c] // 2 = 1 then do
      /* str.upper(s) style unbound call of a builtin type method */
      ev_bm = 2
      ev_self = c
      return 1
    end
  end
  return getattr_obj(o, nid, 0)

setattr_obj: procedure = .void
  arg o = .int, nid = .int, v = .int
  k = .int
  c = .int
  p = .int
  r = .int
  k = kind_of(o)
  if k = 17 then do
    c = ob_c[o % 2]
    p = cls_find(c, nid)
    if p > 0 then do
      if kind_of(p) = 22 then do
        if ob_y[p % 2] = 0 then do
          r = raise_exc(41, "can't set attribute '" || nid_name[nid] || "'")
          return
        end
        r = call2(ob_y[p % 2], o, v)
        return
      end
    end
    p = cls_find(c, 130)
    if p > 0 & nid \= 103 then do
      r = call3(p, o, mkstr(nid_name[nid]), v)
      return
    end
    call inst_set o, nid, v
    return
  end
  if k = 16 then do
    call cls_set ob_x[o % 2], nid, v
    return
  end
  if k = 12 then return
  r = raise_exc(41, "'" || type_name(o) || "' object has no attribute '" || nid_name[nid] || "'")
  return

/* ---------------------------------------------------------------------
   Items, slices, targets, iterators
   --------------------------------------------------------------------- */
mkchr: procedure = .int
  arg ch = .string
  c = .int
  c = c2d(ch)
  if c < 256 & length(ch) = 1 then do
    if chr_oop[c + 1] = 0 then chr_oop[c + 1] = mkstr(ch)
    return chr_oop[c + 1]
  end
  return mkstr(ch)

/* normalise slice bounds for a sequence of length n; result in sl_a (start), sl_b (step), sl_n (count) */
slice_calc: procedure = .int
  arg n = .int, lo = .int, hi = .int, st = .int
  step = .int
  lower = .int
  upper = .int
  start = .int
  stop = .int
  v = .int
  if st = 2 | st = 0 then step = 1
  else do
    if numkind(st) \= 1 then return raise_exc(38, "slice indices must be integers or None or have an __index__ method")
    step = ival(st)
  end
  if step = 0 then return raise_exc(36, "slice step cannot be zero")
  if step > 0 then do
    lower = 0
    upper = n
  end
  else do
    lower = -1
    upper = n - 1
  end
  if lo = 2 | lo = 0 then do
    if step > 0 then start = lower
    else start = upper
  end
  else do
    if numkind(lo) \= 1 then return raise_exc(38, "slice indices must be integers or None or have an __index__ method")
    start = ival(lo)
    if start < 0 then start = start + n
    if start < lower then start = lower
    if start > upper then start = upper
  end
  if hi = 2 | hi = 0 then do
    if step > 0 then stop = upper
    else stop = lower
  end
  else do
    if numkind(hi) \= 1 then return raise_exc(38, "slice indices must be integers or None or have an __index__ method")
    stop = ival(hi)
    if stop < 0 then stop = stop + n
    if stop < lower then stop = lower
    if stop > upper then stop = upper
  end
  sl_a = start
  sl_b = step
  if step > 0 then do
    if stop > start then sl_n = (stop - start - 1) % step + 1
    else sl_n = 0
  end
  else do
    if start > stop then sl_n = (start - stop - 1) % (0 - step) + 1
    else sl_n = 0
  end
  return 1

getslice: procedure = .int
  arg o = .int, lo = .int, hi = .int, st = .int
  k = .int
  r = .int
  i = .int
  p = .int
  s = .string
  res = .string
  t = .int
  k = kind_of(o)
  if k = 6 then do
    s = ob_s[o % 2]
    r = slice_calc(length(s), lo, hi, st)
    if r = 0 then return 0
    if sl_b = 1 then return mkstr(substr(s, sl_a + 1, sl_n))
    res = ""
    p = sl_a
    do i = 1 to sl_n
      res = res || substr(s, p + 1, 1)
      p = p + sl_b
    end
    return mkstr(res)
  end
  if k = 7 | k = 8 then do
    r = slice_calc(ob_n[o % 2], lo, hi, st)
    if r = 0 then return 0
    if k = 7 then t = mklist(sl_n)
    else t = mktuple(sl_n)
    p = sl_a
    do i = 0 to sl_n - 1
      if k = 7 then call list_append t, sl[ob_p[o % 2] + p]
      else sl[ob_p[t % 2] + i] = sl[ob_p[o % 2] + p]
      p = p + sl_b
    end
    return t
  end
  if k = 11 then do
    r = slice_calc(range_len(o), lo, hi, st)
    if r = 0 then return 0
    return mkrange(ob_n[o % 2] + sl_a * ob_y[o % 2], ob_n[o % 2] + (sl_a + sl_n * sl_b) * ob_y[o % 2], sl_b * ob_y[o % 2])
  end
  if k = 17 then do
    r = cls_find(ob_c[o % 2], 115)
    if r > 0 then do
      t = newobj(21)
      ob_n[t % 2] = lo
      ob_x[t % 2] = hi
      ob_y[t % 2] = st
      return call2(r, o, t)
    end
  end
  return raise_exc(38, "'" || type_name(o) || "' object is not subscriptable")

idx_int: procedure = .int
  arg x = .int
  if x // 2 \= 0 then return (x - 1) % 2
  if ob_k[x % 2] = 2 then return ival(x)
  return 0

getitem: procedure = .int
  arg o = .int, ix = .int
  k = .int
  i = .int
  n = .int
  e = .int
  m = .int
  t = .int
  s = .string
  a = .int
  st = .int
  if o // 2 \= 0 then return raise_exc(38, "'int' object is not subscriptable")
  k = ob_k[o % 2]
  if k = 7 | k = 8 then do
    if ix // 2 = 0 & ob_k[ix % 2] \= 2 then do
      if ob_k[ix % 2] = 21 then return getslice(o, ob_n[ix % 2], ob_x[ix % 2], ob_y[ix % 2])
      if kind_of(ix) = 17 then do
        m = cls_find(ob_c[ix % 2], 117)
        if m > 0 then ix = call1(m, ix)
      end
      else return raise_exc(38, "list indices must be integers or slices, not " || type_name(ix))
    end
    i = idx_int(ix)
    n = ob_n[o % 2]
    if i < 0 then i = i + n
    if i < 0 | i >= n then do
      if k = 7 then return raise_exc(34, "list index out of range")
      return raise_exc(34, "tuple index out of range")
    end
    return sl[ob_p[o % 2] + i]
  end
  if k = 9 then do
    e = dict_find(ob_x[o % 2], hashkey(ix))
    if e > 0 then return de_val[e]
    if ob_y[o % 2] \= 0 then do
      t = callz(ob_y[o % 2])
      if t = 0 then return 0
      call dict_put ob_x[o % 2], hashkey(ix), ix, t
      return t
    end
    return raise_key(ix)
  end
  if k = 6 then do
    if ix // 2 = 0 & ob_k[ix % 2] = 21 then return getslice(o, ob_n[ix % 2], ob_x[ix % 2], ob_y[ix % 2])
    if ix // 2 = 0 & ob_k[ix % 2] \= 2 then return raise_exc(38, "string indices must be integers, not '" || type_name(ix) || "'")
    i = idx_int(ix)
    s = ob_s[o % 2]
    n = length(s)
    if i < 0 then i = i + n
    if i < 0 | i >= n then return raise_exc(34, "string index out of range")
    return mkchr(substr(s, i + 1, 1))
  end
  if k = 11 then do
    if ix // 2 = 0 & ob_k[ix % 2] = 21 then return getslice(o, ob_n[ix % 2], ob_x[ix % 2], ob_y[ix % 2])
    i = idx_int(ix)
    n = range_len(o)
    if i < 0 then i = i + n
    if i < 0 | i >= n then return raise_exc(34, "range object index out of range")
    return mkint(ob_n[o % 2] + i * ob_y[o % 2])
  end
  if k = 17 then do
    m = cls_find(ob_c[o % 2], 115)
    if m > 0 then return call2(m, o, ix)
    return raise_exc(38, "'" || type_name(o) || "' object is not subscriptable")
  end
  if k = 16 then return o
  return raise_exc(38, "'" || type_name(o) || "' object is not subscriptable")

raise_key: procedure = .int
  arg key = .int
  e = .int
  t = .int
  e = inst_new(35)
  t = mktuple(1)
  sl[ob_p[t % 2]] = key
  call inst_set e, 4, t
  return raise_obj(e)

setitem: procedure = .void
  arg o = .int, ix = .int, v = .int
  k = .int
  i = .int
  n = .int
  m = .int
  r = .int
  it = .int
  src = .int
  newl = .int
  j = .int
  cnt = .int
  if o // 2 \= 0 then do
    r = raise_exc(38, "'int' object does not support item assignment")
    return
  end
  k = ob_k[o % 2]
  if k = 7 then do
    if ix // 2 = 0 & ob_k[ix % 2] = 21 then do
      call setslice o, ob_n[ix % 2], ob_x[ix % 2], ob_y[ix % 2], v
      return
    end
    if ix // 2 = 0 & ob_k[ix % 2] \= 2 then do
      r = raise_exc(38, "list indices must be integers or slices, not " || type_name(ix))
      return
    end
    i = idx_int(ix)
    n = ob_n[o % 2]
    if i < 0 then i = i + n
    if i < 0 | i >= n then do
      r = raise_exc(34, "list assignment index out of range")
      return
    end
    sl[ob_p[o % 2] + i] = v
    return
  end
  if k = 9 then do
    call dict_put ob_x[o % 2], hashkey(ix), ix, v
    return
  end
  if k = 17 then do
    m = cls_find(ob_c[o % 2], 131)
    if m > 0 then do
      r = call3(m, o, ix, v)
      return
    end
  end
  r = raise_exc(38, "'" || type_name(o) || "' object does not support item assignment")
  return

setslice: procedure = .void
  arg o = .int, lo = .int, hi = .int, st = .int, v = .int
  r = .int
  src = .int
  newl = .int
  i = .int
  j = .int
  n = .int
  cnt = .int
  p = .int
  n = ob_n[o % 2]
  r = slice_calc(n, lo, hi, st)
  if r = 0 then return
  src = iter_list(v)
  if src = 0 then return
  if sl_b = 1 then do
    newl = mklist(n + ob_n[src % 2])
    do i = 0 to sl_a - 1
      call list_append newl, sl[ob_p[o % 2] + i]
    end
    do i = 0 to ob_n[src % 2] - 1
      call list_append newl, sl[ob_p[src % 2] + i]
    end
    do i = sl_a + sl_n to n - 1
      call list_append newl, sl[ob_p[o % 2] + i]
    end
    ob_p[o % 2] = ob_p[newl % 2]
    ob_n[o % 2] = ob_n[newl % 2]
    ob_x[o % 2] = ob_x[newl % 2]
    return
  end
  if ob_n[src % 2] \= sl_n then do
    r = raise_exc(36, "attempt to assign sequence of size " || ob_n[src % 2] || " to extended slice of size " || sl_n)
    return
  end
  p = sl_a
  do i = 0 to sl_n - 1
    sl[ob_p[o % 2] + p] = sl[ob_p[src % 2] + i]
    p = p + sl_b
  end
  return

delitem: procedure = .void
  arg o = .int, ix = .int
  k = .int
  i = .int
  n = .int
  m = .int
  r = .int
  e = .int
  j = .int
  newl = .int
  k = kind_of(o)
  if k = 7 then do
    if ix // 2 = 0 & ob_k[ix % 2] = 21 then do
      r = slice_calc(ob_n[o % 2], ob_n[ix % 2], ob_x[ix % 2], ob_y[ix % 2])
      if r = 0 then return
      newl = mklist(ob_n[o % 2])
      do i = 0 to ob_n[o % 2] - 1
        j = 0
        if sl_b > 0 then do
          if i >= sl_a & i < sl_a + sl_n * sl_b & (i - sl_a) // sl_b = 0 then j = 1
        end
        else do
          if i <= sl_a & i > sl_a + sl_n * sl_b & (sl_a - i) // (0 - sl_b) = 0 then j = 1
        end
        if j = 0 then call list_append newl, sl[ob_p[o % 2] + i]
      end
      ob_p[o % 2] = ob_p[newl % 2]
      ob_n[o % 2] = ob_n[newl % 2]
      ob_x[o % 2] = ob_x[newl % 2]
      return
    end
    i = idx_int(ix)
    n = ob_n[o % 2]
    if i < 0 then i = i + n
    if i < 0 | i >= n then do
      r = raise_exc(34, "list assignment index out of range")
      return
    end
    do j = i to n - 2
      sl[ob_p[o % 2] + j] = sl[ob_p[o % 2] + j + 1]
    end
    ob_n[o % 2] = n - 1
    return
  end
  if k = 9 | k = 10 then do
    e = dict_del(ob_x[o % 2], hashkey(ix))
    if e = 0 then r = raise_key(ix)
    return
  end
  if k = 17 then do
    m = cls_find(ob_c[o % 2], 105)
    if m > 0 then do
      r = call2(m, o, ix)
      return
    end
  end
  r = raise_exc(38, "'" || type_name(o) || "' object doesn't support item deletion")
  return

/* ---- assignment targets ---- */
store: procedure = .void
  arg t = .int, v = .int, fb = .int
  tt = .int
  f = .int
  d = .int
  o = .int
  r = .int
  tt = n_t[t]
  if tt = 34 then do
    vp[fb + n_a[t]] = v
    return
  end
  if tt = 27 then do
    vp[gfb + n_a[t]] = v
    return
  end
  if tt = 51 then do
    f = fb
    do d = 1 to n_b[t]
      f = vp[f + 1]
    end
    vp[f + n_a[t]] = v
    return
  end
  if tt = 4 then do
    o = ev(n_a[t], fb)
    if o = 0 then return
    call setattr_obj o, n_b[t], v
    return
  end
  if tt = 46 then do
    o = ev(n_a[t], fb)
    if o = 0 then return
    if n_t[n_b[t]] = 44 then do
      d = n_b[t]
      call setitem o, eval_slice(d, fb), v
      return
    end
    d = ev(n_b[t], fb)
    if d = 0 then return
    call setitem o, d, v
    return
  end
  if tt = 49 | tt = 33 then do
    call unpack t, v, fb
    return
  end
  r = raise_exc(38, "cannot assign")
  return

/* build a slice object from a N_SLICE node */
eval_slice: procedure = .int
  arg n = .int, fb = .int
  lo = .int
  hi = .int
  st = .int
  o = .int
  lo = 2
  hi = 2
  st = 2
  if n_a[n] > 0 then do
    lo = ev(n_a[n], fb)
    if lo = 0 then return 0
  end
  if n_b[n] > 0 then do
    hi = ev(n_b[n], fb)
    if hi = 0 then return 0
  end
  if n_c[n] > 0 then do
    st = ev(n_c[n], fb)
    if st = 0 then return 0
  end
  o = newobj(21)
  ob_n[o % 2] = lo
  ob_x[o % 2] = hi
  ob_y[o % 2] = st
  return o

unpack: procedure = .void
  arg t = .int, v = .int, fb = .int
  src = .int
  n = .int
  cnt = .int
  star = .int
  i = .int
  j = .int
  before = .int
  after = .int
  mid = .int
  item = .int
  r = .int
  tg = .int
  if kind_of(v) = 7 | kind_of(v) = 8 then src = v
  else do
    src = iter_list(v)
    if src = 0 then return
  end
  n = ob_n[src % 2]
  cnt = n_b[t]
  star = -1
  do i = 0 to cnt - 1
    if n_t[al[n_a[t] + i]] = 45 then star = i
  end
  if star < 0 then do
    if n \= cnt then do
      if n > cnt then r = raise_exc(36, "too many values to unpack (expected " || cnt || ")")
      else r = raise_exc(36, "not enough values to unpack (expected " || cnt || ", got " || n || ")")
      return
    end
    do i = 0 to cnt - 1
      call store al[n_a[t] + i], sl[ob_p[src % 2] + i], fb
      if unw > 0 then return
    end
    return
  end
  before = star
  after = cnt - 1 - star
  if n < before + after then do
    r = raise_exc(36, "not enough values to unpack (expected at least " || (before + after) || ", got " || n || ")")
    return
  end
  do i = 0 to before - 1
    call store al[n_a[t] + i], sl[ob_p[src % 2] + i], fb
    if unw > 0 then return
  end
  mid = mklist(n - before - after)
  do i = before to n - after - 1
    call list_append mid, sl[ob_p[src % 2] + i]
  end
  call store n_a[al[n_a[t] + star]], mid, fb
  if unw > 0 then return
  do i = 0 to after - 1
    call store al[n_a[t] + star + 1 + i], sl[ob_p[src % 2] + n - after + i], fb
    if unw > 0 then return
  end
  return

/* ---------------------------------------------------------------------
   Iterators
   --------------------------------------------------------------------- */
mkiter: procedure = .int
  arg sub = .int, x = .int, y = .int
  o = .int
  o = newobj(20)
  ob_n[o % 2] = sub
  ob_x[o % 2] = x
  ob_y[o % 2] = y
  return o

iter_new: procedure = .int
  arg x = .int
  k = .int
  m = .int
  r = .int
  it = .int
  if x // 2 \= 0 then return raise_exc(38, "'int' object is not iterable")
  k = ob_k[x % 2]
  select
    when k = 7 | k = 8 then return mkiter(1, x, 0)
    when k = 6 then return mkiter(2, x, 0)
    when k = 11 then do
      it = mkiter(3, ob_n[x % 2], ob_x[x % 2])
      ob_c[it % 2] = ob_y[x % 2]
      return it
    end
    when k = 9 | k = 10 then return mkiter(4, x, dd_head[ob_x[x % 2]])
    when k = 19 | k = 20 then return x
    when k = 17 then do
      m = cls_find(ob_c[x % 2], 120)
      if m > 0 then do
        r = call1(m, x)
        if r = 0 then return 0
        if kind_of(r) = 19 | kind_of(r) = 20 then return r
        if kind_of(r) = 17 then do
          if cls_find(ob_c[r % 2], 126) > 0 then return mkiter(7, r, 0)
        end
        if kind_of(r) = 7 | kind_of(r) = 8 then return mkiter(1, r, 0)
        return raise_exc(38, "iter() returned non-iterator of type '" || type_name(r) || "'")
      end
      m = cls_find(ob_c[x % 2], 115)
      if m > 0 then return mkiter(13, x, 0)
      return raise_exc(38, "'" || type_name(x) || "' object is not iterable")
    end
    when k = 26 then do
      return mkiter(14, x, 0)
    end
    otherwise return raise_exc(38, "'" || type_name(x) || "' object is not iterable")
  end
  return 0

/* next item or 0 (exhausted, or an exception is pending in unw) */
iter_next: procedure = .int
  arg it = .int
  ix = .int
  sub = .int
  i = .int
  src = .int
  v = .int
  e = .int
  s = .string
  step = .int
  t = .int
  n = .int
  j = .int
  k = .int
  r = .int
  m = .int
  ix = it % 2
  if ob_k[ix] = 19 then return gen_resume(ob_x[ix], 2)
  sub = ob_n[ix]
  select
    when sub = 1 then do
      src = ob_x[ix]
      i = ob_y[ix]
      if i >= ob_n[src % 2] then return 0
      ob_y[ix] = i + 1
      return sl[ob_p[src % 2] + i]
    end
    when sub = 3 then do
      v = ob_x[ix]
      step = ob_c[ix]
      if step > 0 then do
        if v >= ob_y[ix] then return 0
      end
      else do
        if v <= ob_y[ix] then return 0
      end
      ob_x[ix] = v + step
      return v * 2 + 1
    end
    when sub = 2 then do
      src = ob_x[ix]
      i = ob_y[ix]
      s = ob_s[src % 2]
      if i >= length(s) then return 0
      ob_y[ix] = i + 1
      return mkchr(substr(s, i + 1, 1))
    end
    when sub = 4 | sub = 5 | sub = 6 then do
      e = de_live_from(ob_y[ix])
      if e = 0 then return 0
      ob_y[ix] = de_next[e]
      if sub = 4 then return de_key[e]
      if sub = 6 then return de_val[e]
      t = mktuple(2)
      sl[ob_p[t % 2]] = de_key[e]
      sl[ob_p[t % 2] + 1] = de_val[e]
      return t
    end
    when sub = 7 then do
      r = call1(cls_find(ob_c[ob_x[ix] % 2], 126), ob_x[ix])
      if r = 0 then do
        if unw = 4 then do
          if cls_issub(ob_c[unw_v % 2], 45) = 1 then unw = 0
        end
      end
      return r
    end
    when sub = 8 then do
      v = iter_next(ob_x[ix])
      if v = 0 then return 0
      t = mktuple(2)
      sl[ob_p[t % 2]] = ob_y[ix] * 2 + 1
      sl[ob_p[t % 2] + 1] = v
      ob_y[ix] = ob_y[ix] + 1
      return t
    end
    when sub = 9 then do
      n = ob_c[ix]
      t = mktuple(n)
      do j = 0 to n - 1
        v = iter_next(sl[ob_p[ix] + j])
        if v = 0 then return 0
        sl[ob_p[t % 2] + j] = v
      end
      return t
    end
    when sub = 10 then do
      n = ob_c[ix]
      m = asp
      do j = 0 to n - 1
        v = iter_next(sl[ob_p[ix] + j])
        if v = 0 then do
          asp = m
          return 0
        end
        call push v
      end
      r = docall(ob_x[ix], m, n, 0)
      asp = m
      return r
    end
    when sub = 11 then do
      do forever
        v = iter_next(ob_y[ix])
        if v = 0 then return 0
        if ob_x[ix] = 0 then do
          if truthy(v) = 1 then return v
        end
        else do
          r = call1(ob_x[ix], v)
          if r = 0 then return 0
          if truthy(r) = 1 then return v
        end
        if unw > 0 then return 0
      end
    end
    when sub = 12 then do
      src = ob_x[ix]
      i = ob_y[ix]
      if i < 0 then return 0
      ob_y[ix] = i - 1
      if kind_of(src) = 6 then return mkchr(substr(ob_s[src % 2], i + 1, 1))
      return sl[ob_p[src % 2] + i]
    end
    when sub = 13 then do
      i = ob_y[ix]
      r = call2(cls_find(ob_c[ob_x[ix] % 2], 115), ob_x[ix], mkint(i))
      if r = 0 then do
        if unw = 4 then do
          if cls_issub(ob_c[unw_v % 2], 34) = 1 | cls_issub(ob_c[unw_v % 2], 45) = 1 then unw = 0
        end
        return 0
      end
      ob_y[ix] = i + 1
      return r
    end
    when sub = 14 then do
      return file_readline(ob_x[ix], 1)
    end
    when sub = 15 then do
      do forever
        src = ob_x[ix]
        if src = 0 then do
          if ob_y[ix] >= ob_n[ob_c[ix] % 2] then return 0
          src = iter_new(sl[ob_p[ob_c[ix] % 2] + ob_y[ix]])
          if src = 0 then return 0
          ob_x[ix] = src
          ob_y[ix] = ob_y[ix] + 1
        end
        v = iter_next(src)
        if v \= 0 then return v
        if unw > 0 then return 0
        ob_x[ix] = 0
      end
    end
    when sub = 16 then do
      v = ob_x[ix]
      ob_x[ix] = v + ob_y[ix]
      return v * 2 + 1
    end
    when sub = 17 then do
      if ob_c[ix] = 1 then return 0
      v = iter_next(ob_y[ix])
      if v = 0 then return 0
      r = call1(ob_x[ix], v)
      if r = 0 then return 0
      if truthy(r) = 1 then return v
      ob_c[ix] = 1
      return 0
    end
    when sub = 18 then do
      /* ob_x source, ob_y next index, ob_n2 handled via slots: stop, step, current */
      do while sl[ob_p[ix] + 2] < ob_y[ix]
        v = iter_next(ob_x[ix])
        if v = 0 then return 0
        sl[ob_p[ix] + 2] = sl[ob_p[ix] + 2] + 1
      end
      if sl[ob_p[ix]] >= 0 & ob_y[ix] >= sl[ob_p[ix]] then return 0
      v = iter_next(ob_x[ix])
      if v = 0 then return 0
      sl[ob_p[ix] + 2] = sl[ob_p[ix] + 2] + 1
      ob_y[ix] = ob_y[ix] + sl[ob_p[ix] + 1]
      return v
    end
    otherwise return 0
  end
  return 0

/* all items of an iterable as a new list (0 on error) */
iter_list: procedure = .int
  arg x = .int
  k = .int
  l = .int
  it = .int
  v = .int
  i = .int
  n = .int
  e = .int
  k = kind_of(x)
  if k = 7 | k = 8 then do
    n = ob_n[x % 2]
    l = mklist(n)
    do i = 0 to n - 1
      sl[ob_p[l % 2] + i] = sl[ob_p[x % 2] + i]
    end
    ob_n[l % 2] = n
    return l
  end
  if k = 9 | k = 10 then do
    l = mklist(dd_n[ob_x[x % 2]])
    e = dd_head[ob_x[x % 2]]
    do while e > 0
      if de_live[e] = 1 then call list_append l, de_key[e]
      e = de_next[e]
    end
    return l
  end
  it = iter_new(x)
  if it = 0 then return 0
  l = mklist(8)
  do forever
    v = iter_next(it)
    if v = 0 then leave
    call list_append l, v
  end
  if unw > 0 then return 0
  return l

/* ---------------------------------------------------------------------
   Evaluator
   --------------------------------------------------------------------- */
unbound: procedure = .int
  arg n = .int
  if n_t[n] = 27 | n_t[n] = 36 then return raise_exc(39, "name '" || n_s[n] || "' is not defined")
  return raise_exc(40, "cannot access local variable '" || n_s[n] || "' where it is not associated with a value")

make_func: procedure = .int
  arg fd = .int, fb = .int
  f = .int
  j = .int
  nr = .int
  dn = .int
  v = .int
  f = newobj(12)
  ob_x[f % 2] = fd
  ob_y[f % 2] = fb
  nr = fd_nr[fd]
  ob_p[f % 2] = alloc_slots(nr + 1)
  do j = 1 to nr
    dn = pr_def[fd_ps[fd] + j - 1]
    if dn > 0 then do
      v = ev(dn, fb)
      if v = 0 then return 0
      sl[ob_p[f % 2] + j - 1] = v
    end
  end
  return f

/* evaluate complex call arguments (star / keyword); returns 1 or 0 */
eval_cargs: procedure = .int
  arg n = .int, fb = .int, base = .int
  i = .int
  a = .int
  v = .int
  t = .int
  l = .int
  j = .int
  e = .int
  d = .int
  ea_nk = 0
  do i = 0 to n_c[n] - 1
    a = al[n_b[n] + i]
    t = n_t[a]
    if t = 45 then do
      v = ev(n_a[a], fb)
      if v = 0 then return 0
      l = iter_list(v)
      if l = 0 then return 0
      do j = 0 to ob_n[l % 2] - 1
        call push sl[ob_p[l % 2] + j]
      end
    end
    else if t \= 32 & t \= 19 then do
      v = ev(a, fb)
      if v = 0 then return 0
      call push v
    end
  end
  ea_np = asp - base
  do i = 0 to n_c[n] - 1
    a = al[n_b[n] + i]
    t = n_t[a]
    if t = 32 then do
      v = ev(n_a[a], fb)
      if v = 0 then return 0
      call push v
      asn[asp] = n_s[a]
      ea_nk = ea_nk + 1
    end
    else if t = 19 then do
      v = ev(n_a[a], fb)
      if v = 0 then return 0
      if kind_of(v) \= 9 then do
        call raise_exc 38, "argument after ** must be a mapping, not " || type_name(v)
        return 0
      end
      e = dd_head[ob_x[v % 2]]
      do while e > 0
        if de_live[e] = 1 then do
          if kind_of(de_key[e]) \= 6 then do
            call raise_exc 38, "keywords must be strings"
            return 0
          end
          call push de_val[e]
          asn[asp] = ob_s[de_key[e] % 2]
          ea_nk = ea_nk + 1
        end
        e = de_next[e]
      end
    end
  end
  return 1

ev: procedure = .int
  arg n = .int, fb = .int
  t = .int
  v = .int
  l = .int
  r = .int
  op = .int
  o = .int
  ix = .int
  c = .int
  i = .int
  cnt = .int
  st = .int
  a = .int
  f = .int
  d = .int
  base = .int
  fnode = .int
  fv = .int
  selfo = .int
  bm = .int
  nargs = .int
  ck = .int
  k = .int
  s = .string
  e = .int
  fd = .int
  nf = .int
  it = .int
  size = .int
  sub = .int
  tv = .int
  s2 = .string
  t = n_t[n]
  if t = 34 then do
    v = vp[fb + n_a[n]]
    if v = 0 then return unbound(n)
    return v
  end
  if t = 14 then return n_a[n]
  if t = 6 then do
    l = ev(n_a[n], fb)
    if l = 0 then return 0
    r = ev(n_b[n], fb)
    if r = 0 then return 0
    op = n_c[n]
    if l // 2 \= 0 & r // 2 \= 0 then do
      if op = 1 then do
        v = l + r - 1
        if v < 1999999999999999999 & v > 0 - 1999999999999999999 then return v
      end
      else if op = 2 then do
        v = l - r + 1
        if v < 1999999999999999999 & v > 0 - 1999999999999999999 then return v
      end
    end
    return arith(op, l, r)
  end
  if t = 11 then do
    l = ev(n_a[n], fb)
    if l = 0 then return 0
    r = ev(n_b[n], fb)
    if r = 0 then return 0
    op = n_c[n]
    if l // 2 \= 0 & r // 2 \= 0 then do
      tv = 0
      select
        when op = 1 then do
          if l = r then tv = 1
        end
        when op = 2 then do
          if l \= r then tv = 1
        end
        when op = 3 then do
          if l < r then tv = 1
        end
        when op = 4 then do
          if l <= r then tv = 1
        end
        when op = 5 then do
          if l > r then tv = 1
        end
        when op = 6 then do
          if l >= r then tv = 1
        end
        otherwise tv = 2
      end
      if tv = 1 then return 4
      if tv = 0 then return 6
    end
    return cmp_general(op, l, r)
  end
  if t = 8 then do
    fnode = n_a[n]
    base = asp
    selfo = 0
    bm = 0
    if n_t[fnode] = 4 then do
      o = ev(n_a[fnode], fb)
      if o = 0 then return 0
      fv = getattr_call(o, n_b[fnode], fnode)
      if fv = 0 then return 0
      selfo = ev_self
      bm = ev_bm
    end
    else do
      fv = ev(fnode, fb)
      if fv = 0 then return 0
    end
    if selfo > 0 & bm = 0 then call push selfo
    ck = 0
    if n_d[n] = 0 then do
      nargs = n_c[n]
      st = n_b[n]
      do i = 0 to nargs - 1
        a = ev(al[st + i], fb)
        if a = 0 then do
          asp = base
          return 0
        end
        asp = asp + 1
        ast[asp] = a
        asn[asp] = ""
      end
      cnt = asp - base
    end
    else do
      if eval_cargs(n, fb, base) = 0 then do
        asp = base
        return 0
      end
      cnt = ea_np
      ck = ea_nk
    end
    if bm = 1 then r = bmeth(selfo, n_b[fnode], base, cnt, ck)
    else if bm = 2 then r = bmeth_unbound(selfo, n_b[fnode], base, cnt, ck)
    else r = docall(fv, base, cnt, ck)
    asp = base
    return r
  end
  if t = 4 then do
    o = ev(n_a[n], fb)
    if o = 0 then return 0
    return getattr_obj(o, n_b[n], n)
  end
  if t = 27 then do
    v = vp[gfb + n_a[n]]
    if v = 0 then return unbound(n)
    return v
  end
  if t = 46 then do
    o = ev(n_a[n], fb)
    if o = 0 then return 0
    ix = n_b[n]
    if n_t[ix] = 44 then do
      l = 2
      r = 2
      c = 2
      if n_a[ix] > 0 then do
        l = ev(n_a[ix], fb)
        if l = 0 then return 0
      end
      if n_b[ix] > 0 then do
        r = ev(n_b[ix], fb)
        if r = 0 then return 0
      end
      if n_c[ix] > 0 then do
        c = ev(n_c[ix], fb)
        if c = 0 then return 0
      end
      return getslice(o, l, r, c)
    end
    ix = ev(ix, fb)
    if ix = 0 then return 0
    if ix // 2 \= 0 & o // 2 = 0 then do
      if ob_k[o % 2] = 7 then do
        i = (ix - 1) % 2
        if i >= 0 & i < ob_n[o % 2] then return sl[ob_p[o % 2] + i]
      end
    end
    return getitem(o, ix)
  end
  if t = 51 then do
    f = fb
    do d = 1 to n_b[n]
      f = vp[f + 1]
    end
    v = vp[f + n_a[n]]
    if v = 0 then return unbound(n)
    return v
  end
  if t = 1 then do
    l = ev(n_a[n], fb)
    if l = 0 then return 0
    if l = 4 then return ev(n_b[n], fb)
    if l = 6 | l = 2 | l = 1 then return l
    if truthy(l) = 0 then do
      if unw > 0 then return 0
      return l
    end
    return ev(n_b[n], fb)
  end
  if t = 38 then do
    l = ev(n_a[n], fb)
    if l = 0 then return 0
    if l = 4 then return l
    if l = 6 | l = 2 | l = 1 then return ev(n_b[n], fb)
    if truthy(l) = 1 then return l
    if unw > 0 then return 0
    return ev(n_b[n], fb)
  end
  if t = 37 then do
    l = ev(n_a[n], fb)
    if l = 0 then return 0
    if truthy(l) = 1 then return 6
    if unw > 0 then return 0
    return 4
  end
  if t = 30 then do
    c = ev(n_a[n], fb)
    if c = 0 then return 0
    if c = 4 then return ev(n_b[n], fb)
    if c = 6 | c = 2 then return ev(n_c[n], fb)
    v = truthy(c)
    if unw > 0 then return 0
    if v = 1 then return ev(n_b[n], fb)
    return ev(n_c[n], fb)
  end
  if t = 50 then do
    l = ev(n_a[n], fb)
    if l = 0 then return 0
    return unary(n_c[n], l)
  end
  if t = 9 then do
    cnt = n_b[n]
    st = n_a[n]
    l = ev(al[st], fb)
    if l = 0 then return 0
    do i = 1 to cnt - 1
      r = ev(al[st + i], fb)
      if r = 0 then return 0
      v = cmp_general(al[st + cnt + i - 1], l, r)
      if v = 0 then return 0
      if v = 6 then return v
      if truthy(v) = 0 then return 6
      l = r
    end
    return 4
  end
  if t = 49 | t = 33 | t = 43 then do
    cnt = n_b[n]
    st = n_a[n]
    if t = 43 then do
      o = dict_new(10)
      do i = 0 to cnt - 1
        a = al[st + i]
        if n_t[a] = 45 then do
          v = ev(n_a[a], fb)
          if v = 0 then return 0
          l = iter_list(v)
          if l = 0 then return 0
          do d = 0 to ob_n[l % 2] - 1
            call dset o, sl[ob_p[l % 2] + d], 4
          end
        end
        else do
          v = ev(a, fb)
          if v = 0 then return 0
          call dset o, v, 4
        end
      end
      return o
    end
    o = mklist(cnt)
    do i = 0 to cnt - 1
      a = al[st + i]
      if n_t[a] = 45 then do
        v = ev(n_a[a], fb)
        if v = 0 then return 0
        l = iter_list(v)
        if l = 0 then return 0
        do d = 0 to ob_n[l % 2] - 1
          call list_append o, sl[ob_p[l % 2] + d]
        end
      end
      else do
        v = ev(a, fb)
        if v = 0 then return 0
        call list_append o, v
      end
    end
    if t = 49 then return tup_of_list(o)
    return o
  end
  if t = 18 then do
    o = dict_new(9)
    st = n_a[n]
    do i = 0 to n_b[n] - 1
      a = al[st + 2 * i]
      if a = 0 then do
        v = ev(al[st + 2 * i + 1], fb)
        if v = 0 then return 0
        if kind_of(v) \= 9 then return raise_exc(38, "'" || type_name(v) || "' object is not a mapping")
        call dict_update o, v
      end
      else do
        l = ev(a, fb)
        if l = 0 then return 0
        v = ev(al[st + 2 * i + 1], fb)
        if v = 0 then return 0
        call dset o, l, v
      end
    end
    return o
  end
  if t = 24 then do
    s = ""
    st = n_a[n]
    do i = 0 to n_b[n] - 1
      a = al[st + i]
      if n_t[a] = 14 then s = s || ob_s[n_a[a] % 2]
      else do
        s2 = fmt_node(a, fb)
        if unw > 0 then return 0
        s = s || s2
      end
    end
    return mkstr(s)
  end
  if t = 25 then return make_func(n_a[n], fb)
  if t = 12 then do
    fd = n_a[n]
    it = ev(n_c[n], fb)
    if it = 0 then return 0
    size = fd_ns[fd]
    nf = alloc_frame(size)
    vp[nf + 1] = fb
    vp[nf + 2] = it
    k = n_b[n]
    if k = 1 then o = mklist(8)
    else if k = 3 then o = dict_new(9)
    else o = dict_new(10)
    vp[nf + 3] = o
    call ex fd_body[fd], nf
    if (fd_fl[fd] // 4) < 2 then call free_frame nf, size
    if unw > 0 then return 0
    return o
  end
  if t = 26 then do
    fd = n_a[n]
    it = ev(n_c[n], fb)
    if it = 0 then return 0
    size = fd_ns[fd]
    nf = alloc_frame(size)
    vp[nf + 1] = fb
    vp[nf + 2] = it
    return gen_new(fd, nf)
  end
  if t = 47 then do
    f = fb
    do d = 1 to n_b[n]
      f = vp[f + 1]
    end
    o = newobj(25)
    ob_x[o % 2] = vp[f + 2]
    ob_y[o % 2] = cd_obj[n_a[n]]
    return o
  end
  if t = 36 then return unbound(n)
  if t = 45 then return raise_exc(52, "can't use starred expression here")
  if t = 54 | t = 55 then return raise_exc(42, "yield used in an unsupported position")
  return raise_exc(42, "cannot evaluate node " || t)

/* comparison of any two values; returns a bool oop or 0 */
cmp_general: procedure = .int
  arg op = .int, l = .int, r = .int
  v = .int
  if op = 1 | op = 2 then do
    v = py_eq(l, r)
    if unw > 0 then return 0
    if op = 2 then v = 1 - v
    if v = 1 then return 4
    return 6
  end
  if op = 9 then return mkbool(is_same(l, r))
  if op = 10 then return mkbool(1 - is_same(l, r))
  if op = 7 | op = 8 then do
    v = py_contains(r, l)
    if unw > 0 then return 0
    if op = 8 then v = 1 - v
    if v = 1 then return 4
    return 6
  end
  return py_cmp(op, l, r)

is_same: procedure = .int
  arg l = .int, r = .int
  if l = r then return 1
  if l // 2 = 0 & r // 2 = 0 then do
    if ob_k[l % 2] = 6 & ob_k[r % 2] = 6 then do
      if ob_s[l % 2] == ob_s[r % 2] & length(ob_s[l % 2]) <= 1 then return 1
    end
  end
  return 0

/* format one replacement field of an f-string */
fmt_node: procedure = .string
  arg a = .int, fb = .int
  v = .int
  sp = .string
  sv = .int
  conv = .int
  v = ev(n_a[a], fb)
  if v = 0 then return ""
  conv = n_b[a]
  if conv = 114 | conv = 97 then v = mkstr(repr_of(v))
  else if conv = 115 then v = mkstr(str_of(v))
  if unw > 0 then return ""
  sp = ""
  if n_c[a] > 0 then do
    sv = ev(n_c[a], fb)
    if sv = 0 then return ""
    sp = ob_s[sv % 2]
  end
  return format_value(v, sp)

/* ---------------------------------------------------------------------
   Statements
   --------------------------------------------------------------------- */
exc_matches: procedure = .int
  arg exc = .int, ty = .int
  i = .int
  k = .int
  k = kind_of(ty)
  if k = 16 then return cls_issub(ob_c[exc % 2], ob_x[ty % 2])
  if k = 8 then do
    do i = 0 to ob_n[ty % 2] - 1
      if exc_matches(exc, sl[ob_p[ty % 2] + i]) = 1 then return 1
    end
    return 0
  end
  call raise_exc 38, "catching classes that do not inherit from BaseException is not allowed"
  return 0

do_raise: procedure = .void
  arg v = .int
  e = .int
  k = .int
  r = .int
  k = kind_of(v)
  if k = 16 then do
    if cls_issub(ob_x[v % 2], 27) = 0 then do
      r = raise_exc(38, "exceptions must derive from BaseException")
      return
    end
    e = instantiate(ob_x[v % 2], asp + 0, 0, 0)
    if e = 0 then return
    unw = 4
    unw_v = e
    return
  end
  if k = 17 then do
    if cls_issub(ob_c[v % 2], 27) = 1 then do
      unw = 4
      unw_v = v
      return
    end
  end
  r = raise_exc(38, "exceptions must derive from BaseException")
  return

/* the in-place version of a binary operator */
aug_op_apply: procedure = .int
  arg op = .int, cur = .int, v = .int
  k = .int
  m = .int
  l = .int
  k = kind_of(cur)
  if k = 7 & op = 1 then do
    l = iter_list(v)
    if l = 0 then return 0
    call list_extend_from cur, l
    return cur
  end
  if k = 7 & op = 3 & numkind(v) = 1 then do
    l = seq_repeat(cur, ival(v))
    ob_p[cur % 2] = ob_p[l % 2]
    ob_n[cur % 2] = ob_n[l % 2]
    ob_x[cur % 2] = ob_x[l % 2]
    return cur
  end
  if k = 10 & kind_of(v) = 10 & (op = 11 | op = 10 | op = 2 | op = 12) then do
    l = set_op(op, cur, v)
    ob_x[cur % 2] = ob_x[l % 2]
    return cur
  end
  if k = 9 & op = 11 & kind_of(v) = 9 then do
    call dict_update cur, v
    return cur
  end
  if k = 17 then do
    m = cls_find(ob_c[cur % 2], iopd[op])
    if m > 0 then return call2(m, cur, v)
  end
  return arith(op, cur, v)

ex: procedure = .void
  arg n = .int, fb = .int
  t = .int
  v = .int
  i = .int
  c = .int
  tv = .int
  r = .int
  o = .int
  ix = .int
  brk = .int
  st = .int
  cnt = .int
  it = .int
  a = .int
  b = .int
  stp = .int
  tg = .int
  itn = .int
  d = .int
  f = .int
  hs = .int
  h = .int
  ty = .int
  sv = .int
  sv2 = .int
  svc = .int
  m = .int
  ex1 = .int
  ex2 = .int
  base = .int
  tt = .int
  op = .int
  nm = .string
  s2 = .string
  ok_range = .int
  t = n_t[n]
  if t = 20 then do
    v = ev(n_a[n], fb)
    return
  end
  if t = 3 then do
    v = ev(n_a[n], fb)
    if v = 0 then return
    st = n_b[n]
    do i = 0 to n_c[n] - 1
      tg = al[st + i]
      tt = n_t[tg]
      if tt = 34 then vp[fb + n_a[tg]] = v
      else do
        call store tg, v, fb
        if unw > 0 then return
      end
    end
    return
  end
  if t = 42 then do
    st = n_a[n]
    do i = 0 to n_b[n] - 1
      call ex al[st + i], fb
      if unw > 0 then return
    end
    return
  end
  if t = 41 then do
    if n_a[n] = 0 then unw_v = 2
    else do
      v = ev(n_a[n], fb)
      if v = 0 then return
      unw_v = v
    end
    unw = 1
    return
  end
  if t = 29 then do
    c = ev(n_a[n], fb)
    if c = 0 then return
    if c = 4 then tv = 1
    else if c = 6 | c = 2 then tv = 0
    else do
      tv = truthy(c)
      if unw > 0 then return
    end
    if tv = 1 then call ex n_b[n], fb
    else if n_c[n] > 0 then call ex n_c[n], fb
    return
  end
  if t = 22 then do
    tg = n_a[n]
    itn = n_b[n]
    brk = 0
    /* fast path: for x in range(...) */
    if n_t[itn] = 8 then do
      if n_t[n_a[itn]] = 14 & n_a[n_a[itn]] = range_oop & n_d[itn] = 0 & n_c[itn] >= 1 & n_c[itn] <= 3 then do
        cnt = n_c[itn]
        st = n_b[itn]
        a = 0
        b = 0
        stp = 1
        ok_range = 1
        v = ev(al[st], fb)
        if v = 0 then return
        if v // 2 = 0 then ok_range = 0
        if cnt = 1 then b = (v - 1) % 2
        else do
          a = (v - 1) % 2
          v = ev(al[st + 1], fb)
          if v = 0 then return
          if v // 2 = 0 then ok_range = 0
          b = (v - 1) % 2
          if cnt = 3 then do
            v = ev(al[st + 2], fb)
            if v = 0 then return
            if v // 2 = 0 then ok_range = 0
            stp = (v - 1) % 2
            if stp = 0 then do
              r = raise_exc(36, "range() arg 3 must not be zero")
              return
            end
          end
        end
        if ok_range = 1 then do
          i = a
          do forever
            if stp > 0 then do
              if i >= b then leave
            end
            else do
              if i <= b then leave
            end
            if n_t[tg] = 34 then vp[fb + n_a[tg]] = i * 2 + 1
            else do
              call store tg, i * 2 + 1, fb
              if unw > 0 then return
            end
            call ex n_c[n], fb
            if unw > 0 then do
              if unw = 2 then do
                unw = 0
                brk = 1
                leave
              end
              else if unw = 3 then unw = 0
              else return
            end
            i = i + stp
          end
          if brk = 0 & n_d[n] > 0 then call ex n_d[n], fb
          return
        end
      end
    end
    v = ev(itn, fb)
    if v = 0 then return
    it = iter_new(v)
    if it = 0 then return
    do forever
      v = iter_next(it)
      if v = 0 then do
        if unw > 0 then return
        leave
      end
      if n_t[tg] = 34 then vp[fb + n_a[tg]] = v
      else do
        call store tg, v, fb
        if unw > 0 then return
      end
      call ex n_c[n], fb
      if unw > 0 then do
        if unw = 2 then do
          unw = 0
          brk = 1
          leave
        end
        else if unw = 3 then unw = 0
        else return
      end
    end
    if brk = 0 & n_d[n] > 0 then call ex n_d[n], fb
    return
  end
  if t = 52 then do
    brk = 0
    do forever
      c = ev(n_a[n], fb)
      if c = 0 then return
      if c = 4 then tv = 1
      else if c = 6 | c = 2 then tv = 0
      else do
        tv = truthy(c)
        if unw > 0 then return
      end
      if tv = 0 then leave
      call ex n_b[n], fb
      if unw > 0 then do
        if unw = 2 then do
          unw = 0
          brk = 1
          leave
        end
        else if unw = 3 then unw = 0
        else return
      end
    end
    if brk = 0 & n_c[n] > 0 then call ex n_c[n], fb
    return
  end
  if t = 5 then do
    tg = n_a[n]
    tt = n_t[tg]
    op = n_c[n]
    if tt = 4 then do
      o = ev(n_a[tg], fb)
      if o = 0 then return
      c = getattr_obj(o, n_b[tg], tg)
      if c = 0 then return
      v = ev(n_b[n], fb)
      if v = 0 then return
      r = aug_op_apply(op, c, v)
      if r = 0 then return
      call setattr_obj o, n_b[tg], r
      return
    end
    if tt = 46 then do
      o = ev(n_a[tg], fb)
      if o = 0 then return
      ix = ev(n_b[tg], fb)
      if ix = 0 then return
      c = getitem(o, ix)
      if c = 0 then return
      v = ev(n_b[n], fb)
      if v = 0 then return
      r = aug_op_apply(op, c, v)
      if r = 0 then return
      call setitem o, ix, r
      return
    end
    c = ev(tg, fb)
    if c = 0 then return
    v = ev(n_b[n], fb)
    if v = 0 then return
    if c // 2 \= 0 & v // 2 \= 0 & op = 1 then do
      r = c + v - 1
      if r >= 1999999999999999999 | r <= 0 - 1999999999999999999 then r = arith(op, c, v)
    end
    else r = aug_op_apply(op, c, v)
    if r = 0 then return
    call store tg, r, fb
    return
  end
  if t = 7 then do
    unw = 2
    return
  end
  if t = 15 then do
    unw = 3
    return
  end
  if t = 39 then return
  if t = 13 then do
    if n_c[n] = 3 then do
      ix = ev(n_b[n], fb)
      if ix = 0 then return
    end
    v = ev(n_a[n], fb)
    if v = 0 then return
    if n_c[n] = 1 then call list_append vp[fb + 3], v
    else if n_c[n] = 3 then call dset vp[fb + 3], ix, v
    else call dset vp[fb + 3], v, 4
    return
  end
  if t = 16 then do
    f = make_func(n_a[n], fb)
    if f = 0 then return
    do i = n_d[n] to 1 by -1
      v = ev(al[n_c[n] + i - 1], fb)
      if v = 0 then return
      f = call1(v, f)
      if f = 0 then return
    end
    call store n_b[n], f, fb
    return
  end
  if t = 10 then do
    call exec_class n, fb
    return
  end
  if t = 48 then do
    call exec_try n, fb
    return
  end
  if t = 40 then do
    if n_a[n] = 0 then do
      if exc_cur = 0 then do
        r = raise_exc(42, "No active exception to reraise")
        return
      end
      unw = 4
      unw_v = exc_cur
      return
    end
    v = ev(n_a[n], fb)
    if v = 0 then return
    call do_raise v
    return
  end
  if t = 2 then do
    c = ev(n_a[n], fb)
    if c = 0 then return
    tv = truthy(c)
    if unw > 0 then return
    if tv = 1 then return
    if n_b[n] > 0 then do
      v = ev(n_b[n], fb)
      if v = 0 then return
      unw = 4
      o = inst_new(46)
      tt = mktuple(1)
      sl[ob_p[tt % 2]] = v
      call inst_set o, 4, tt
      unw_v = o
      return
    end
    unw = 4
    unw_v = exc_new0(46)
    return
  end
  if t = 53 then do
    call exec_with n, fb
    return
  end
  if t = 17 then do
    do i = 0 to n_b[n] - 1
      call del_target al[n_a[n] + i], fb
      if unw > 0 then return
    end
    return
  end
  if t = 31 then do
    v = mod_get(n_s[n])
    if v = 0 then do
      r = raise_exc(51, "No module named '" || n_s[n] || "'")
      return
    end
    call store n_a[n], v, fb
    return
  end
  if t = 23 then do
    v = mod_get(n_s[n])
    if v = 0 then do
      r = raise_exc(51, "No module named '" || n_s[n] || "'")
      return
    end
    do i = 0 to n_b[n] - 1
      nm = ob_s[na_const(al[n_a[n] + 2 * i]) % 2]
      s2 = modattr[n_s[n] || "." || nm]
      if s2 == "" then do
        r = raise_exc(50, "cannot import name '" || nm || "' from '" || n_s[n] || "'")
        return
      end
      call store al[n_a[n] + 2 * i + 1], s2 as .int, fb
    end
    return
  end
  r = raise_exc(42, "cannot execute node " || t)
  return

na_const: procedure = .int
  arg n = .int
  return n_a[n]

del_target: procedure = .void
  arg tg = .int, fb = .int
  tt = .int
  o = .int
  ix = .int
  i = .int
  r = .int
  tt = n_t[tg]
  if tt = 35 | tt = 34 | tt = 27 | tt = 51 then do
    r = ev(tg, fb)
    if r = 0 then return
    call store tg, 0, fb
    return
  end
  if tt = 46 then do
    o = ev(n_a[tg], fb)
    if o = 0 then return
    if n_t[n_b[tg]] = 44 then ix = eval_slice(n_b[tg], fb)
    else ix = ev(n_b[tg], fb)
    if ix = 0 then return
    call delitem o, ix
    return
  end
  if tt = 4 then do
    o = ev(n_a[tg], fb)
    if o = 0 then return
    if kind_of(o) = 17 then do
      if inst_del(o, n_b[tg]) = 0 then r = raise_exc(41, n_s[tg])
      return
    end
    r = raise_exc(41, n_s[tg])
    return
  end
  if tt = 49 | tt = 33 then do
    do i = 0 to n_b[tg] - 1
      call del_target al[n_a[tg] + i], fb
      if unw > 0 then return
    end
    return
  end
  r = raise_exc(52, "cannot delete")
  return

exec_class: procedure = .void
  arg n = .int, fb = .int
  cd = .int
  bo = .int
  bc = .int
  c = .int
  nf = .int
  j = .int
  v = .int
  i = .int
  r = .int
  cobj = .int
  size = .int
  cd = n_a[n]
  bc = 1
  if n_c[n] > 0 then do
    bo = ev(n_c[n], fb)
    if bo = 0 then return
    if kind_of(bo) \= 16 then do
      r = raise_exc(38, "bases must be types")
      return
    end
    bc = ob_x[bo % 2]
  end
  c = define_class(cd_name[cd], bc)
  if (cl_flags[c] // 2) = 1 then cl_flags[c] = cl_flags[c] - 1
  cl_dflt[c] = cl_dflt[bc]
  cobj = cl_obj[c]
  cd_obj[cd] = cobj
  size = cd_ns[cd]
  nf = alloc_frame(size)
  vp[nf + 1] = fb
  call ex cd_body[cd], nf
  if unw > 0 then return
  do j = cd_cv0[cd] to cd_cv1[cd]
    if cv_scope[j] = cd_sc[cd] then do
      v = vp[nf + cv_slot[j]]
      if v \= 0 then call cls_set c, nameid(cv_name[j]), v
    end
  end
  v = cobj
  do i = n_e[n] to 1 by -1
    r = ev(al[n_d[n] + i - 1], fb)
    if r = 0 then return
    v = call1(r, v)
    if v = 0 then return
  end
  call store n_b[n], v, fb
  return

exec_try: procedure = .void
  arg n = .int, fb = .int
  hs = .int
  hc = .int
  i = .int
  h = .int
  ty = .int
  tv = .int
  exc = .int
  matched = .int
  sv_unw = .int
  sv_v = .int
  sv_cur = .int
  r = .int
  hs = n_b[n]
  hc = n_c[n]
  call ex n_a[n], fb
  if unw = 4 & hc > 0 then do
    exc = unw_v
    matched = 0
    do i = 0 to hc - 1
      h = al[hs + i]
      if n_a[h] = 0 then matched = 1
      else do
        unw = 0
        ty = ev(n_a[h], fb)
        if ty = 0 then do
          /* error while evaluating the exception type */
          leave
        end
        tv = exc_matches(exc, ty)
        if unw > 0 then leave
        unw = 4
        unw_v = exc
        if tv = 1 then matched = 1
      end
      if matched = 1 then do
        unw = 0
        if n_b[h] > 0 then call store n_b[h], exc, fb
        sv_cur = exc_cur
        exc_cur = exc
        call ex n_c[h], fb
        exc_cur = sv_cur
        if n_b[h] > 0 then do
          sv_unw = unw
          sv_v = unw_v
          unw = 0
          call store n_b[h], 0, fb
          unw = sv_unw
          unw_v = sv_v
        end
        leave
      end
    end
  end
  else if unw = 0 & n_d[n] > 0 then call ex n_d[n], fb
  if n_e[n] > 0 then do
    sv_unw = unw
    sv_v = unw_v
    unw = 0
    call ex n_e[n], fb
    if unw = 0 then do
      unw = sv_unw
      unw_v = sv_v
    end
  end
  return

exec_with: procedure = .void
  arg n = .int, fb = .int
  ctx = .int
  en = .int
  exm = .int
  r = .int
  sv_unw = .int
  sv_v = .int
  exc = .int
  k = .int
  ctx = ev(n_a[n], fb)
  if ctx = 0 then return
  k = kind_of(ctx)
  if k = 26 then do
    if n_b[n] > 0 then call store n_b[n], ctx, fb
    if unw > 0 then return
    call ex n_c[n], fb
    sv_unw = unw
    sv_v = unw_v
    unw = 0
    call file_close ctx
    unw = sv_unw
    unw_v = sv_v
    return
  end
  if k \= 17 then do
    r = raise_exc(41, "__enter__")
    return
  end
  en = cls_find(ob_c[ctx % 2], 108)
  exm = cls_find(ob_c[ctx % 2], 110)
  if en = 0 | exm = 0 then do
    r = raise_exc(41, "__enter__")
    return
  end
  r = call1(en, ctx)
  if r = 0 then return
  if n_b[n] > 0 then do
    call store n_b[n], r, fb
    if unw > 0 then return
  end
  call ex n_c[n], fb
  if unw = 0 then do
    r = call_exit(exm, ctx, 2, 2)
    return
  end
  if unw = 4 then do
    exc = unw_v
    unw = 0
    r = call_exit(exm, ctx, cl_obj[ob_c[exc % 2]], exc)
    if unw > 0 then return
    if r \= 0 then do
      if truthy(r) = 1 then return
    end
    unw = 4
    unw_v = exc
    return
  end
  sv_unw = unw
  sv_v = unw_v
  unw = 0
  r = call_exit(exm, ctx, 2, 2)
  if unw = 0 then do
    unw = sv_unw
    unw_v = sv_v
  end
  return

call_exit: procedure = .int
  arg exm = .int, ctx = .int, a = .int, b = .int
  base = .int
  r = .int
  base = asp
  call push ctx
  call push a
  call push b
  call push 2
  r = docall(exm, base, 4, 0)
  asp = base
  return r

/* ---------------------------------------------------------------------
   Generators: resumable statement machine with an explicit record stack
   --------------------------------------------------------------------- */
ydepth: procedure = .int
  arg n = .int
  t = .int
  m = .int
  d = .int
  i = .int
  h = .int
  t = n_t[n]
  m = 0
  if t = 42 then do
    do i = 0 to n_b[n] - 1
      if n_y[al[n_a[n] + i]] = 1 then do
        d = ydepth(al[n_a[n] + i])
        if d > m then m = d
      end
    end
    return m + 1
  end
  if t = 29 then do
    if n_y[n_b[n]] = 1 then m = ydepth(n_b[n])
    if n_c[n] > 0 then do
      if n_y[n_c[n]] = 1 then do
        d = ydepth(n_c[n])
        if d > m then m = d
      end
    end
    return m + 1
  end
  if t = 52 then do
    if n_y[n_b[n]] = 1 then m = ydepth(n_b[n])
    if n_c[n] > 0 then do
      if n_y[n_c[n]] = 1 then do
        d = ydepth(n_c[n])
        if d > m then m = d
      end
    end
    return m + 1
  end
  if t = 22 then do
    if n_y[n_c[n]] = 1 then m = ydepth(n_c[n])
    if n_d[n] > 0 then do
      if n_y[n_d[n]] = 1 then do
        d = ydepth(n_d[n])
        if d > m then m = d
      end
    end
    return m + 1
  end
  if t = 48 then do
    if n_y[n_a[n]] = 1 then m = ydepth(n_a[n])
    do i = 0 to n_c[n] - 1
      h = al[n_b[n] + i]
      if n_y[n_c[h]] = 1 then do
        d = ydepth(n_c[h])
        if d > m then m = d
      end
    end
    if n_d[n] > 0 then do
      if n_y[n_d[n]] = 1 then do
        d = ydepth(n_d[n])
        if d > m then m = d
      end
    end
    if n_e[n] > 0 then do
      if n_y[n_e[n]] = 1 then do
        d = ydepth(n_e[n])
        if d > m then m = d
      end
    end
    return m + 1
  end
  if t = 53 then do
    if n_y[n_c[n]] = 1 then m = ydepth(n_c[n])
    return m + 1
  end
  return 1

gen_new: procedure = .int
  arg fd = .int, nf = .int
  g = .int
  o = .int
  cap = .int
  if fd_gd[fd] = 0 then fd_gd[fd] = ydepth(fd_body[fd]) + 2
  cap = fd_gd[fd]
  ngn = ngn + 1
  g = ngn
  gn_fd[g] = fd
  gn_fb[g] = nf
  gn_st[g] = 0
  gn_sp[g] = 0
  gn_rb[g] = ngs
  gn_val[g] = 2
  ngs = ngs + cap + 1
  gs_n[ngs] = 0
  o = newobj(19)
  ob_x[o % 2] = g
  return o

gpush: procedure = .void
  arg rb = .int, sp = .int, node = .int
  gs_n[rb + sp] = node
  gs_s[rb + sp] = 0
  gs_a[rb + sp] = 0
  gs_b[rb + sp] = 0
  return

/* an error / control transfer is pending: find the record that handles it.
   returns the new stack pointer, or -1 when the generator is finished. */
gx_unw: procedure = .int
  arg g = .int, sp = .int
  rb = .int
  fb = .int
  n = .int
  t = .int
  st = .int
  i = .int
  h = .int
  exc = .int
  ty = .int
  tv = .int
  matched = .int
  body = .int
  sv_cur = .int
  rb = gn_rb[g]
  fb = gn_fb[g]
  do while sp > 0
    n = gs_n[rb + sp]
    t = n_t[n]
    if t = 52 | t = 22 then do
      if unw = 2 then do
        unw = 0
        return sp - 1
      end
      if unw = 3 then do
        unw = 0
        return sp
      end
    end
    else if t = 48 then do
      st = gs_s[rb + sp]
      if st = 1 & unw = 4 & n_c[n] > 0 then do
        exc = unw_v
        matched = 0
        do i = 0 to n_c[n] - 1
          h = al[n_b[n] + i]
          if n_a[h] = 0 then matched = 1
          else do
            unw = 0
            ty = ev(n_a[h], fb)
            if ty = 0 then leave
            tv = exc_matches(exc, ty)
            if unw > 0 then leave
            unw = 4
            unw_v = exc
            if tv = 1 then matched = 1
          end
          if matched = 1 then do
            unw = 0
            if n_b[h] > 0 then call store n_b[h], exc, fb
            gs_s[rb + sp] = 2
            body = n_c[h]
            if n_y[body] = 1 then do
              sp = sp + 1
              call gpush rb, sp, body
              return sp
            end
            sv_cur = exc_cur
            exc_cur = exc
            call ex body, fb
            exc_cur = sv_cur
            if unw = 0 then return sp
            leave
          end
        end
        if unw = 0 then return sp
      end
      st = gs_s[rb + sp]
      if n_e[n] > 0 & st >= 1 & st <= 3 then do
        gs_b[rb + sp] = unw
        gs_a[rb + sp] = unw_v
        unw = 0
        gs_s[rb + sp] = 4
        if n_y[n_e[n]] = 1 then do
          sp = sp + 1
          call gpush rb, sp, n_e[n]
          return sp
        end
        call ex n_e[n], fb
        if unw = 0 then do
          unw = gs_b[rb + sp]
          unw_v = gs_a[rb + sp]
        end
      end
    end
    sp = sp - 1
  end
  return -1

gen_resume: procedure = .int
  arg g = .int, sent = .int
  rb = .int
  sp = .int
  fb = .int
  n = .int
  t = .int
  st = .int
  ch = .int
  v = .int
  y = .int
  c = .int
  tv = .int
  b = .int
  it = .int
  fd = .int
  r = .int
  h = .int
  if gn_st[g] = 3 then return 0
  if gn_st[g] = 2 then return raise_exc(36, "generator already executing")
  rb = gn_rb[g]
  fb = gn_fb[g]
  fd = gn_fd[g]
  if gn_st[g] = 0 then do
    sp = 1
    call gpush rb, 1, fd_body[fd]
  end
  else sp = gn_sp[g]
  gn_val[g] = sent
  gn_st[g] = 2
  do forever
    if sp = 0 then do
      gn_st[g] = 3
      return 0
    end
    n = gs_n[rb + sp]
    st = gs_s[rb + sp]
    t = n_t[n]
    if t = 42 then do
      if st >= n_b[n] then sp = sp - 1
      else do
        ch = al[n_a[n] + st]
        gs_s[rb + sp] = st + 1
        if n_y[ch] = 1 then do
          sp = sp + 1
          call gpush rb, sp, ch
        end
        else do
          call ex ch, fb
          if unw > 0 then do
            sp = gx_unw(g, sp)
            if sp < 0 then leave
          end
        end
      end
    end
    else if t = 20 | t = 3 then do
      if t = 20 then y = n_a[n]
      else y = n_a[n]
      if n_t[y] = 54 then do
        if st = 0 then do
          if n_a[y] = 0 then v = 2
          else v = ev(n_a[y], fb)
          if v = 0 then do
            sp = gx_unw(g, sp)
            if sp < 0 then leave
          end
          else do
            gs_s[rb + sp] = 1
            gn_sp[g] = sp
            gn_st[g] = 1
            return v
          end
        end
        else do
          if t = 3 then do
            do b = 0 to n_c[n] - 1
              call store al[n_b[n] + b], gn_val[g], fb
            end
            if unw > 0 then do
              sp = gx_unw(g, sp)
              if sp < 0 then leave
              iterate
            end
          end
          sp = sp - 1
        end
      end
      else if n_t[y] = 55 then do
        if st = 0 then do
          v = ev(n_a[y], fb)
          if v \= 0 then it = iter_new(v)
          else it = 0
          if it = 0 then do
            sp = gx_unw(g, sp)
            if sp < 0 then leave
            iterate
          end
          gs_a[rb + sp] = it
          gs_s[rb + sp] = 1
        end
        v = iter_next(gs_a[rb + sp])
        if v = 0 then do
          if unw > 0 then do
            sp = gx_unw(g, sp)
            if sp < 0 then leave
          end
          else sp = sp - 1
        end
        else do
          gn_sp[g] = sp
          gn_st[g] = 1
          return v
        end
      end
      else sp = sp - 1
    end
    else if t = 29 then do
      if st = 0 then do
        c = ev(n_a[n], fb)
        if c = 0 then tv = -1
        else tv = truthy(c)
        if unw > 0 then do
          sp = gx_unw(g, sp)
          if sp < 0 then leave
          iterate
        end
        gs_s[rb + sp] = 1
        if tv = 1 then b = n_b[n]
        else b = n_c[n]
        if b > 0 then do
          if n_y[b] = 1 then do
            sp = sp + 1
            call gpush rb, sp, b
          end
          else do
            call ex b, fb
            if unw > 0 then do
              sp = gx_unw(g, sp)
              if sp < 0 then leave
            end
          end
        end
      end
      else sp = sp - 1
    end
    else if t = 52 then do
      if st = 0 then do
        c = ev(n_a[n], fb)
        if c = 0 then tv = -1
        else tv = truthy(c)
        if unw > 0 then do
          sp = gx_unw(g, sp)
          if sp < 0 then leave
          iterate
        end
        if tv = 1 then do
          if n_y[n_b[n]] = 1 then do
            sp = sp + 1
            call gpush rb, sp, n_b[n]
          end
          else do
            call ex n_b[n], fb
            if unw > 0 then do
              sp = gx_unw(g, sp)
              if sp < 0 then leave
            end
          end
        end
        else do
          gs_s[rb + sp] = 2
          if n_c[n] > 0 then do
            if n_y[n_c[n]] = 1 then do
              sp = sp + 1
              call gpush rb, sp, n_c[n]
            end
            else do
              call ex n_c[n], fb
              if unw > 0 then do
                sp = gx_unw(g, sp)
                if sp < 0 then leave
              end
            end
          end
        end
      end
      else sp = sp - 1
    end
    else if t = 22 then do
      if st = 0 then do
        v = ev(n_b[n], fb)
        if v \= 0 then it = iter_new(v)
        else it = 0
        if it = 0 then do
          sp = gx_unw(g, sp)
          if sp < 0 then leave
          iterate
        end
        gs_a[rb + sp] = it
        gs_s[rb + sp] = 1
        st = 1
      end
      if st = 1 then do
        v = iter_next(gs_a[rb + sp])
        if v = 0 then do
          if unw > 0 then do
            sp = gx_unw(g, sp)
            if sp < 0 then leave
            iterate
          end
          gs_s[rb + sp] = 2
          if n_d[n] > 0 then do
            if n_y[n_d[n]] = 1 then do
              sp = sp + 1
              call gpush rb, sp, n_d[n]
            end
            else do
              call ex n_d[n], fb
              if unw > 0 then do
                sp = gx_unw(g, sp)
                if sp < 0 then leave
              end
            end
          end
        end
        else do
          call store n_a[n], v, fb
          if unw > 0 then do
            sp = gx_unw(g, sp)
            if sp < 0 then leave
            iterate
          end
          if n_y[n_c[n]] = 1 then do
            sp = sp + 1
            call gpush rb, sp, n_c[n]
          end
          else do
            call ex n_c[n], fb
            if unw > 0 then do
              sp = gx_unw(g, sp)
              if sp < 0 then leave
            end
          end
        end
      end
      else sp = sp - 1
    end
    else if t = 48 then do
      if st = 0 then do
        gs_s[rb + sp] = 1
        sp = sp + 1
        call gpush rb, sp, n_a[n]
      end
      else if st = 1 then do
        /* body finished normally */
        if n_d[n] > 0 then do
          gs_s[rb + sp] = 3
          if n_y[n_d[n]] = 1 then do
            sp = sp + 1
            call gpush rb, sp, n_d[n]
          end
          else do
            call ex n_d[n], fb
            if unw > 0 then do
              sp = gx_unw(g, sp)
              if sp < 0 then leave
            end
          end
        end
        else if n_e[n] > 0 then do
          gs_s[rb + sp] = 4
          gs_b[rb + sp] = 0
          if n_y[n_e[n]] = 1 then do
            sp = sp + 1
            call gpush rb, sp, n_e[n]
          end
          else do
            call ex n_e[n], fb
            if unw > 0 then do
              sp = gx_unw(g, sp)
              if sp < 0 then leave
            end
          end
        end
        else sp = sp - 1
      end
      else if st = 2 | st = 3 then do
        if n_e[n] > 0 then do
          gs_s[rb + sp] = 4
          gs_b[rb + sp] = 0
          if n_y[n_e[n]] = 1 then do
            sp = sp + 1
            call gpush rb, sp, n_e[n]
          end
          else do
            call ex n_e[n], fb
            if unw > 0 then do
              sp = gx_unw(g, sp)
              if sp < 0 then leave
            end
          end
        end
        else sp = sp - 1
      end
      else do
        /* finally finished: re-raise what was pending */
        b = gs_b[rb + sp]
        if b > 0 then do
          unw = b
          unw_v = gs_a[rb + sp]
          sp = gx_unw(g, sp - 1)
          if sp < 0 then leave
        end
        else sp = sp - 1
      end
    end
    else do
      r = raise_exc(42, "unsupported statement containing yield")
      sp = gx_unw(g, sp)
      if sp < 0 then leave
    end
  end
  /* the generator ended: sp < 0 */
  gn_st[g] = 3
  if unw = 1 then unw = 0
  return 0

/* ---------------------------------------------------------------------
   Built-in functions, type constructors, exceptions
   --------------------------------------------------------------------- */
kwarg: procedure = .int
  arg base = .int, na = .int, nk = .int, name = .string
  j = .int
  do j = 1 to nk
    if asn[base + na + j] == name then return ast[base + na + j]
  end
  return 0

nargs_err: procedure = .int
  arg fname = .string, na = .int, lo = .int, hi = .int
  if lo = hi then do
    if lo = 1 then return raise_exc(38, fname || "() takes exactly one argument (" || na || " given)")
    return raise_exc(38, fname || "() takes exactly " || lo || " arguments (" || na || " given)")
  end
  if na < lo then return raise_exc(38, fname || "() takes at least " || lo || " argument" || plural(lo) || " (" || na || " given)")
  return raise_exc(38, fname || "() takes at most " || hi || " argument" || plural(hi) || " (" || na || " given)")

/* integer argument check: 1 when v is an int-like small integer, else raises */
chk_int: procedure = .int
  arg v = .int
  if numkind(v) = 1 then return 1
  if numkind(v) = 2 then do
    call raise_exc 31, "Python int too large to convert to C long"
    return 0
  end
  call raise_exc 38, "'" || type_name(v) || "' object cannot be interpreted as an integer"
  return 0

py_lt: procedure = .int
  arg a = .int, b = .int
  r = .int
  if a // 2 \= 0 & b // 2 \= 0 then do
    if a < b then return 1
    return 0
  end
  r = py_cmp(3, a, b)
  if r = 0 then return 0
  if r = 4 then return 1
  if r = 6 then return 0
  return truthy(r)

/* ---- output ---- */
outs: procedure = .void
  arg s = .string
  obuf = obuf || s
  if length(obuf) > 3000 then call flush_out
  return

flush_out: procedure = .void
  rcx = .int
  if length(obuf) > 0 then do
    assembler fwrite h_out, obuf
    obuf = ""
  end
  assembler fflush rcx, h_out
  return

errs: procedure = .void
  arg s = .string
  rcx = .int
  call flush_out
  assembler fwrite h_err, s
  assembler fflush rcx, h_err
  return

bi_print: procedure = .int
  arg base = .int, na = .int, nk = .int
  sep = .string
  endv = .string
  out = .string
  i = .int
  j = .int
  v = .int
  fo = .int
  s = .string
  nm = .string
  sep = " "
  endv = '0a'x
  fo = 0
  do j = 1 to nk
    nm = asn[base + na + j]
    v = ast[base + na + j]
    if nm == "sep" then do
      if v \= 2 then do
        if kind_of(v) \= 6 then return raise_exc(38, "sep must be None or a string, not " || type_name(v))
        sep = ob_s[v % 2]
      end
    end
    else if nm == "end" then do
      if v \= 2 then do
        if kind_of(v) \= 6 then return raise_exc(38, "end must be None or a string, not " || type_name(v))
        endv = ob_s[v % 2]
      end
    end
    else if nm == "file" then fo = v
    else if nm == "flush" then nop
    else return raise_exc(38, "'" || nm || "' is an invalid keyword argument for print()")
  end
  out = ""
  do i = 1 to na
    if i > 1 then out = out || sep
    v = ast[base + i]
    if v // 2 = 0 then do
      if ob_k[v % 2] = 6 then do
        out = out || ob_s[v % 2]
        iterate
      end
    end
    s = str_of(v)
    if unw > 0 then return 0
    out = out || s
  end
  out = out || endv
  if fo > 0 & fo \= 2 then do
    if kind_of(fo) \= 26 then return raise_exc(41, "'" || type_name(fo) || "' object has no attribute 'write'")
    call file_write fo, out
    if unw > 0 then return 0
  end
  else call outs out
  return 2

bi_len: procedure = .int
  arg x = .int
  k = .int
  m = .int
  k = kind_of(x)
  select
    when k = 6 then return mkint(length(ob_s[x % 2]))
    when k = 7 | k = 8 then return mkint(ob_n[x % 2])
    when k = 9 | k = 10 then return mkint(dd_n[ob_x[x % 2]])
    when k = 11 then return mkint(range_len(x))
    when k = 17 then do
      m = cls_find(ob_c[x % 2], 121)
      if m > 0 then do
        m = call1(m, x)
        if m = 0 then return 0
        return m
      end
    end
    otherwise nop
  end
  return raise_exc(38, "object of type '" || type_name(x) || "' has no len()")

bi_abs: procedure = .int
  arg x = .int
  s = .string
  if x // 2 \= 0 then do
    if x < 1 then return mkint(0 - ival(x))
    return x
  end
  select
    when ob_k[x % 2] = 5 then return mkfloat(rxfloat..fabs(ob_f[x % 2]))
    when ob_k[x % 2] = 4 then do
      s = ob_s[x % 2]
      if left(s, 1) == "-" then return mkbig(substr(s, 2))
      return x
    end
    when ob_k[x % 2] = 2 then return mkint(ival(x))
    otherwise nop
  end
  return raise_exc(38, "bad operand type for abs(): '" || type_name(x) || "'")

bi_minmax: procedure = .int
  arg base = .int, na = .int, nk = .int, ismax = .int
  keyf = .int
  dflt = .int
  l = .int
  i = .int
  best = .int
  bestk = .int
  v = .int
  kv = .int
  c = .int
  n = .int
  fname = .string
  fname = "min"
  if ismax = 1 then fname = "max"
  keyf = kwarg(base, na, nk, "key")
  if keyf = 2 then keyf = 0
  dflt = kwarg(base, na, nk, "default")
  if na = 0 then return raise_exc(38, fname || " expected at least 1 argument, got 0")
  if na = 1 then do
    l = iter_list(ast[base + 1])
    if l = 0 then return 0
  end
  else l = tup_from_ast(base + 1, base + na)
  n = ob_n[l % 2]
  if n = 0 then do
    if dflt \= 0 then return dflt
    return raise_exc(36, fname || "() arg is an empty sequence")
  end
  best = sl[ob_p[l % 2]]
  bestk = best
  if keyf \= 0 then do
    bestk = call1(keyf, best)
    if bestk = 0 then return 0
  end
  do i = 1 to n - 1
    v = sl[ob_p[l % 2] + i]
    kv = v
    if keyf \= 0 then do
      kv = call1(keyf, v)
      if kv = 0 then return 0
    end
    if ismax = 1 then c = py_lt(bestk, kv)
    else c = py_lt(kv, bestk)
    if unw > 0 then return 0
    if c = 1 then do
      best = v
      bestk = kv
    end
  end
  return best

bi_sum: procedure = .int
  arg base = .int, na = .int, nk = .int
  acc = .int
  it = .int
  v = .int
  st = .int
  if na < 1 then return nargs_err("sum", na, 1, 2)
  acc = mkint(0)
  if na >= 2 then acc = ast[base + 2]
  st = kwarg(base, na, nk, "start")
  if st \= 0 then acc = st
  it = iter_new(ast[base + 1])
  if it = 0 then return 0
  do forever
    v = iter_next(it)
    if v = 0 then leave
    if acc // 2 \= 0 & v // 2 \= 0 then do
      acc = acc + v - 1
      if acc >= 1999999999999999999 | acc <= 0 - 1999999999999999999 then acc = arith(1, acc - v + 1, v)
    end
    else acc = arith(1, acc, v)
    if acc = 0 then return 0
  end
  if unw > 0 then return 0
  return acc

/* in-place stable merge sort of list o by key function keyf (0 = none) */
sort_list: procedure = .int
  arg o = .int, keyf = .int, rev = .int
  n = .int
  i = .int
  w = .int
  lo = .int
  mid = .int
  hi = .int
  a = .int
  b = .int
  d = .int
  p = .int
  x = .int
  y = .int
  t = .int
  kv = .int
  vals = .int[]
  keys = .int[]
  src = .int[]
  dst = .int[]
  n = ob_n[o % 2]
  if n < 2 then return 1
  p = ob_p[o % 2]
  do i = 1 to n
    vals[i] = sl[p + i - 1]
    keys[i] = vals[i]
    if keyf \= 0 then do
      kv = call1(keyf, vals[i])
      if kv = 0 then return 0
      keys[i] = kv
    end
    src[i] = i
  end
  w = 1
  do while w < n
    lo = 1
    do while lo <= n
      mid = lo + w
      hi = lo + 2 * w
      if mid > n + 1 then mid = n + 1
      if hi > n + 1 then hi = n + 1
      a = lo
      b = mid
      d = lo
      do while a < mid & b < hi
        x = keys[src[b]]
        y = keys[src[a]]
        if rev = 1 then do
          t = x
          x = y
          y = t
        end
        if x // 2 \= 0 & y // 2 \= 0 then do
          if x < y then t = 1
          else t = 0
        end
        else do
          t = py_lt(x, y)
          if unw > 0 then return 0
        end
        if t = 1 then do
          dst[d] = src[b]
          b = b + 1
        end
        else do
          dst[d] = src[a]
          a = a + 1
        end
        d = d + 1
      end
      do while a < mid
        dst[d] = src[a]
        a = a + 1
        d = d + 1
      end
      do while b < hi
        dst[d] = src[b]
        b = b + 1
        d = d + 1
      end
      lo = lo + 2 * w
    end
    do i = 1 to n
      src[i] = dst[i]
    end
    w = w * 2
  end
  p = ob_p[o % 2]
  do i = 1 to n
    sl[p + i - 1] = vals[src[i]]
  end
  return 1

bi_sorted: procedure = .int
  arg base = .int, na = .int, nk = .int
  l = .int
  keyf = .int
  rev = .int
  r = .int
  if na \= 1 then return nargs_err("sorted", na, 1, 1)
  l = iter_list(ast[base + 1])
  if l = 0 then return 0
  keyf = kwarg(base, na, nk, "key")
  if keyf = 2 then keyf = 0
  rev = 0
  r = kwarg(base, na, nk, "reverse")
  if r \= 0 then do
    rev = truthy(r)
    if unw > 0 then return 0
  end
  if sort_list(l, keyf, rev) = 0 then return 0
  return l

bi_round: procedure = .int
  arg base = .int, na = .int, nk = .int
  x = .int
  nd = .int
  hasnd = .int
  f = .float
  fl = .float
  df = .float
  p = .int
  q = .int
  r = .int
  s = .string
  if na < 1 | na > 2 then return nargs_err("round", na, 1, 2)
  x = ast[base + 1]
  hasnd = 0
  if na = 2 then do
    if ast[base + 2] \= 2 then do
      if chk_int(ast[base + 2]) = 0 then return 0
      hasnd = 1
      nd = ival(ast[base + 2])
    end
  end
  if numkind(x) = 1 | numkind(x) = 2 then do
    if hasnd = 0 | nd >= 0 then return mkint(ival(x))
    if numkind(x) = 2 then return x
    p = 10 ** (0 - nd)
    if nd < -17 then return mkint(0)
    q = ival(x) % p
    r = ival(x) // p
    if r < 0 then do
      q = q - 1
      r = r + p
    end
    if r * 2 > p then q = q + 1
    else if r * 2 = p then do
      if q // 2 \= 0 then q = q + 1
    end
    return mkint(q * p)
  end
  if numkind(x) = 3 then do
    f = ob_f[x % 2]
    if hasnd = 0 then do
      if f \= f then return raise_exc(36, "cannot convert float NaN to integer")
      if finf(f) \= 0 then return raise_exc(31, "cannot convert float infinity to integer")
      fl = rxfloat..floor(f)
      df = f - fl
      if df < 0.5 then return float_to_int(fl)
      if df > 0.5 then return float_to_int(fl + 1.0)
      if rxfloat..floor(fl / 2.0) * 2.0 = fl then return float_to_int(fl)
      return float_to_int(fl + 1.0)
    end
    if f \= f | finf(f) \= 0 then return x
    if nd > 300 then return x
    if nd < 0 then do
      p = 0 - nd
      fl = rxfloat..pow10(p as .float)
      return mkfloat(ob_f[bi_round_f(f / fl) % 2] * fl)
    end
    s = float_fixed(f, nd)
    return mkfloat(parse_flt(s))
  end
  return raise_exc(38, "type " || type_name(x) || " doesn't define __round__ method")

/* round a float half-even to an integral float */
bi_round_f: procedure = .int
  arg f = .float
  fl = .float
  df = .float
  fl = rxfloat..floor(f)
  df = f - fl
  if df < 0.5 then return mkfloat(fl)
  if df > 0.5 then return mkfloat(fl + 1.0)
  if rxfloat..floor(fl / 2.0) * 2.0 = fl then return mkfloat(fl)
  return mkfloat(fl + 1.0)

bi_divmod: procedure = .int
  arg a = .int, b = .int
  q = .int
  r = .int
  t = .int
  q = arith(5, a, b)
  if q = 0 then return 0
  r = arith(6, a, b)
  if r = 0 then return 0
  t = mktuple(2)
  sl[ob_p[t % 2]] = q
  sl[ob_p[t % 2] + 1] = r
  return t

bi_pow: procedure = .int
  arg base = .int, na = .int
  r = .int
  e = .int
  m = .int
  b = .int
  one = .int
  if na < 2 | na > 3 then return nargs_err("pow", na, 2, 3)
  if na = 2 then return arith(7, ast[base + 1], ast[base + 2])
  b = ast[base + 1]
  e = ast[base + 2]
  m = ast[base + 3]
  if numkind(b) \= 1 & numkind(b) \= 2 then return raise_exc(38, "pow() 3rd argument not allowed unless all arguments are integers")
  if numkind(e) \= 1 | numkind(m) = 0 then return raise_exc(38, "pow() 3rd argument not allowed unless all arguments are integers")
  if ival(e) < 0 & numkind(e) = 1 then return raise_exc(36, "pow() 2nd argument cannot be negative when 3rd argument specified")
  if num_str(m) == "0" then return raise_exc(36, "pow() 3rd argument cannot be 0")
  one = mkint(1)
  r = arith(6, one, m)
  b = arith(6, b, m)
  e = ival(e)
  do while e > 0
    if e // 2 = 1 then do
      r = arith(6, arith(3, r, b), m)
    end
    e = e % 2
    if e > 0 then b = arith(6, arith(3, b, b), m)
  end
  return r

bi_chr: procedure = .int
  arg x = .int
  v = .int
  if chk_int(x) = 0 then return 0
  v = ival(x)
  if v < 0 | v > 1114111 then return raise_exc(36, "chr() arg not in range(0x110000)")
  return mkchr(utf8_chr(v))

bi_ord: procedure = .int
  arg x = .int
  s = .string
  n = .int
  c = .int
  if kind_of(x) \= 6 then return raise_exc(38, "ord() expected string of length 1, but " || type_name(x) || " found")
  s = ob_s[x % 2]
  n = length(s)
  if n \= 1 then return raise_exc(38, "ord() expected a character, but string of length " || n || " found")
  c = c2d(s)
  return mkint(c)

bi_radix: procedure = .int
  arg x = .int, rdx = .int
  s = .string
  neg = .string
  pre = .string
  if numkind(x) = 0 | numkind(x) = 3 then return raise_exc(38, "'" || type_name(x) || "' object cannot be interpreted as an integer")
  s = num_str(x)
  neg = ""
  if left(s, 1) == "-" then do
    neg = "-"
    s = substr(s, 2)
  end
  if rdx = 16 then pre = "0x"
  else if rdx = 8 then pre = "0o"
  else pre = "0b"
  return mkstr(neg || pre || radix_str(s, rdx))

/* is class c (or any class of the tuple t) a base of class d */
bi_isinstance: procedure = .int
  arg x = .int, ty = .int, sub = .int
  k = .int
  i = .int
  r = .int
  c = .int
  k = kind_of(ty)
  if k = 16 then do
    if sub = 1 then c = x
    else c = cls_of(x)
    return mkbool(cls_issub(c, ob_x[ty % 2]))
  end
  if k = 8 then do
    do i = 0 to ob_n[ty % 2] - 1
      r = bi_isinstance(x, sl[ob_p[ty % 2] + i], sub)
      if r = 0 then return 0
      if r = 4 then return r
    end
    return 6
  end
  if sub = 1 then return raise_exc(38, "issubclass() arg 2 must be a class, a tuple of classes, or a union")
  return raise_exc(38, "isinstance() arg 2 must be a type, a tuple of types, or a union")

/* clear a pending AttributeError; 1 if there was one */
swallow_attr: procedure = .int
  if unw = 4 then do
    if cls_issub(ob_c[unw_v % 2], 41) = 1 then do
      unw = 0
      return 1
    end
  end
  return 0

bi_getattr: procedure = .int
  arg base = .int, na = .int
  r = .int
  o = .int
  if na < 2 | na > 3 then return nargs_err("getattr", na, 2, 3)
  o = ast[base + 1]
  if kind_of(ast[base + 2]) \= 6 then return raise_exc(38, "getattr(): attribute name must be string")
  r = getattr_obj(o, nameid(ob_s[ast[base + 2] % 2]), 0)
  if r = 0 & na = 3 then do
    if swallow_attr() = 1 then return ast[base + 3]
  end
  return r

bi_hasattr: procedure = .int
  arg o = .int, nm = .int
  r = .int
  if kind_of(nm) \= 6 then return raise_exc(38, "hasattr(): attribute name must be string")
  r = getattr_obj(o, nameid(ob_s[nm % 2]), 0)
  if r = 0 then do
    if swallow_attr() = 1 then return 6
    return 0
  end
  return 4

bi_setattr: procedure = .int
  arg o = .int, nm = .int, v = .int
  if kind_of(nm) \= 6 then return raise_exc(38, "setattr(): attribute name must be string")
  call setattr_obj o, nameid(ob_s[nm % 2]), v
  if unw > 0 then return 0
  return 2

bi_delattr: procedure = .int
  arg o = .int, nm = .int
  if kind_of(nm) \= 6 then return raise_exc(38, "delattr(): attribute name must be string")
  if kind_of(o) = 17 then do
    if inst_del(o, nameid(ob_s[nm % 2])) = 1 then return 2
  end
  return raise_exc(41, ob_s[nm % 2])

bi_callable: procedure = .int
  arg x = .int
  k = .int
  k = kind_of(x)
  if k = 12 | k = 13 | k = 14 | k = 15 | k = 16 then return 4
  if k = 17 then do
    if cls_find(ob_c[x % 2], 102) > 0 then return 4
  end
  return 6

bi_next: procedure = .int
  arg base = .int, na = .int
  it = .int
  v = .int
  m = .int
  if na < 1 | na > 2 then return nargs_err("next", na, 1, 2)
  it = ast[base + 1]
  if kind_of(it) = 17 then do
    m = cls_find(ob_c[it % 2], 126)
    if m = 0 then return raise_exc(38, "'" || type_name(it) || "' object is not an iterator")
    v = call1(m, it)
    if v = 0 & na = 2 then do
      if unw = 4 then do
        if cls_issub(ob_c[unw_v % 2], 45) = 1 then do
          unw = 0
          return ast[base + 2]
        end
      end
    end
    return v
  end
  if kind_of(it) \= 19 & kind_of(it) \= 20 then return raise_exc(38, "'" || type_name(it) || "' object is not an iterator")
  v = iter_next(it)
  if v = 0 then do
    if unw > 0 then return 0
    if na = 2 then return ast[base + 2]
    unw = 4
    unw_v = exc_new0(45)
    return 0
  end
  return v

bi_iter: procedure = .int
  arg x = .int
  return iter_new(x)

bi_anyall: procedure = .int
  arg x = .int, isany = .int
  it = .int
  v = .int
  t = .int
  it = iter_new(x)
  if it = 0 then return 0
  do forever
    v = iter_next(it)
    if v = 0 then leave
    t = truthy(v)
    if unw > 0 then return 0
    if isany = 1 & t = 1 then return 4
    if isany = 0 & t = 0 then return 6
  end
  if unw > 0 then return 0
  if isany = 1 then return 6
  return 4

strhash: procedure = .int
  arg s = .string
  h = .int
  i = .int
  n = .int
  h = 5381
  n = length(s)
  do i = 1 to n
    h = (h * 33 + c2d(substr(s, i, 1))) // 1000000007
  end
  return h

bi_hash: procedure = .int
  arg x = .int
  k = .int
  m = .int
  r = .int
  h = .int
  i = .int
  if x // 2 \= 0 then return x
  k = ob_k[x % 2]
  select
    when k = 6 then return mkint(strhash(ob_s[x % 2]))
    when k = 2 then return mkint(ival(x))
    when k = 5 then do
      if ob_f[x % 2] = rxfloat..floor(ob_f[x % 2]) & rxfloat..fabs(ob_f[x % 2]) < 900000000000000000.0 then return float_to_int(ob_f[x % 2])
      return mkint(strhash(float_repr(ob_f[x % 2])))
    end
    when k = 4 then return mkint(strhash(ob_s[x % 2]))
    when k = 8 then do
      h = 3430008
      do i = 0 to ob_n[x % 2] - 1
        r = bi_hash(sl[ob_p[x % 2] + i])
        if r = 0 then return 0
        h = (h * 1000003 + ival(r)) // 1000000007
      end
      return mkint(h)
    end
    when k = 1 then return mkint(1)
    when k = 7 | k = 9 | k = 10 then return raise_exc(38, "unhashable type: '" || type_name(x) || "'")
    when k = 17 then do
      m = cls_find(ob_c[x % 2], 116)
      if m > 0 then return call1(m, x)
      return mkint(x)
    end
    otherwise return mkint(x)
  end
  return mkint(x)

bi_input: procedure = .int
  arg base = .int, na = .int
  line = .string
  e = .int
  if na >= 1 then call outs str_of(ast[base + 1])
  call flush_out
  if stdin_eof = 1 then return raise_exc(55, "EOF when reading a line")
  line = ""
  assembler freadline line, h_in
  assembler feof e, h_in
  if e > 0 & length(line) = 0 then do
    stdin_eof = 1
    return raise_exc(55, "EOF when reading a line")
  end
  if right(line, 1) == '0d'x then line = left(line, length(line) - 1)
  return mkstr(line)

bi_reversed: procedure = .int
  arg x = .int
  k = .int
  l = .int
  k = kind_of(x)
  if k = 7 | k = 8 then return mkiter(12, x, ob_n[x % 2] - 1)
  if k = 6 then return mkiter(12, x, length(ob_s[x % 2]) - 1)
  l = iter_list(x)
  if l = 0 then return 0
  return mkiter(12, l, ob_n[l % 2] - 1)

bi_enumerate: procedure = .int
  arg base = .int, na = .int, nk = .int
  it = .int
  st = .int
  if na < 1 | na > 2 then return nargs_err("enumerate", na, 1, 2)
  it = iter_new(ast[base + 1])
  if it = 0 then return 0
  st = 0
  if na = 2 then st = ast[base + 2]
  if kwarg(base, na, nk, "start") \= 0 then st = kwarg(base, na, nk, "start")
  if st = 0 then st = mkint(0)
  if chk_int(st) = 0 then return 0
  return mkiter(8, it, ival(st))

bi_zip: procedure = .int
  arg base = .int, na = .int
  o = .int
  j = .int
  it = .int
  if na = 0 then return mkiter(1, mktuple(0), 0)
  o = mkiter(9, 0, 0)
  ob_p[o % 2] = alloc_slots(na)
  ob_c[o % 2] = na
  do j = 0 to na - 1
    it = iter_new(ast[base + 1 + j])
    if it = 0 then return 0
    sl[ob_p[o % 2] + j] = it
  end
  return o

bi_map: procedure = .int
  arg base = .int, na = .int
  o = .int
  j = .int
  it = .int
  if na < 2 then return nargs_err("map", na, 2, 2)
  o = mkiter(10, ast[base + 1], 0)
  ob_p[o % 2] = alloc_slots(na - 1)
  ob_c[o % 2] = na - 1
  do j = 1 to na - 1
    it = iter_new(ast[base + 1 + j])
    if it = 0 then return 0
    sl[ob_p[o % 2] + j - 1] = it
  end
  return o

bi_filter: procedure = .int
  arg f = .int, x = .int
  it = .int
  o = .int
  it = iter_new(x)
  if it = 0 then return 0
  if f = 2 then f = 0
  return mkiter(11, f, it)

bi_format: procedure = .int
  arg base = .int, na = .int
  sp = .string
  s = .string
  if na < 1 | na > 2 then return nargs_err("format", na, 1, 2)
  sp = ""
  if na = 2 then do
    if kind_of(ast[base + 2]) \= 6 then return raise_exc(38, "format() argument 2 must be str, not " || type_name(ast[base + 2]))
    sp = ob_s[ast[base + 2] % 2]
  end
  s = format_value(ast[base + 1], sp)
  if unw > 0 then return 0
  return mkstr(s)

/* exception __init__(slf, *args) */
bi_exc_init: procedure = .int
  arg base = .int, na = .int
  call inst_set ast[base + 1], 4, tup_from_ast(base + 2, base + na)
  return 2

bi_super: procedure = .int
  arg base = .int, na = .int
  o = .int
  if na \= 2 then return raise_exc(38, "super() argument 1 must be type, not nothing")
  o = newobj(25)
  ob_x[o % 2] = ast[base + 2]
  ob_y[o % 2] = ast[base + 1]
  return o

bi_exit: procedure = .int
  arg base = .int, na = .int
  e = .int
  e = inst_new(47)
  if na >= 1 then call inst_set e, 4, tup_from_ast(base + 1, base + 1)
  else call inst_set e, 4, mktuple(0)
  return raise_obj(e)

/* integer value of a decimal / radix string; 0 with ValueError when invalid */
parse_int: procedure = .int
  arg s0 = .string, bs = .int
  s = .string
  neg = .int
  i = .int
  n = .int
  c = .string
  d = .int
  v = .int
  acc = .string
  digs = .string
  ok = .int
  ch2 = .string
  s = strip(s0)
  neg = 0
  if left(s, 1) == "-" then do
    neg = 1
    s = substr(s, 2)
  end
  else if left(s, 1) == "+" then s = substr(s, 2)
  ch2 = lower(left(s, 2))
  if (bs = 16 | bs = 0) & ch2 == "0x" then do
    s = substr(s, 3)
    bs = 16
  end
  else if (bs = 8 | bs = 0) & ch2 == "0o" then do
    s = substr(s, 3)
    bs = 8
  end
  else if (bs = 2 | bs = 0) & ch2 == "0b" then do
    s = substr(s, 3)
    bs = 2
  end
  if bs = 0 then bs = 10
  ok = 1
  if s == "" then ok = 0
  if left(s, 1) == "_" | right(s, 1) == "_" | pos("__", s) > 0 then ok = 0
  if ok = 1 then do
    if pos("_", s) > 0 then s = changestr("_", s, "")
    n = length(s)
    digs = ""
    do i = 1 to n
      c = lower(substr(s, i, 1))
      if isdigit(c) = 1 then d = c as .int
      else if c >>= "a" & c <<= "z" then d = c2d(c) - 87
      else d = 99
      if d >= bs then do
        ok = 0
        leave
      end
    end
  end
  if ok = 0 then return raise_exc(36, "invalid literal for int() with base " || bs || ": " || repr_str(s0))
  if bs = 10 then do
    if neg = 1 then return big_norm("-" || s)
    return big_norm(s)
  end
  if n <= 12 then do
    v = 0
    do i = 1 to n
      c = lower(substr(s, i, 1))
      if isdigit(c) = 1 then d = c as .int
      else d = c2d(c) - 87
      v = v * bs + d
    end
    if neg = 1 then v = 0 - v
    return mkint(v)
  end
  acc = "0"
  do i = 1 to n
    c = lower(substr(s, i, 1))
    if isdigit(c) = 1 then d = c as .int
    else d = c2d(c) - 87
    acc = sadd(smul(acc, bs as .string), d as .string)
  end
  if neg = 1 then acc = sneg(acc)
  return big_norm(acc)

parse_float_str: procedure = .int
  arg s0 = .string
  s = .string
  neg = .int
  i = .int
  n = .int
  c = .string
  seen_dot = .int
  seen_e = .int
  nd = .int
  ok = .int
  mant = .string
  ex = .string
  p = .int
  l = .string
  f = .float
  s = strip(s0)
  neg = 0
  if left(s, 1) == "-" then do
    neg = 1
    s = substr(s, 2)
  end
  else if left(s, 1) == "+" then s = substr(s, 2)
  l = lower(s)
  if l == "inf" | l == "infinity" then do
    f = f_inf()
    if neg = 1 then f = 0.0 - f
    return mkfloat(f)
  end
  if l == "nan" then return mkfloat(f_nan())
  if pos("_", s) > 0 then s = changestr("_", s, "")
  n = length(s)
  ok = 1
  seen_dot = 0
  seen_e = 0
  nd = 0
  i = 1
  do while i <= n
    c = substr(s, i, 1)
    if isdigit(c) = 1 then nd = nd + 1
    else if c == "." & seen_dot = 0 & seen_e = 0 then seen_dot = 1
    else if (c == "e" | c == "E") & seen_e = 0 & nd > 0 then do
      seen_e = 1
      if substr(s, i + 1, 1) == "+" | substr(s, i + 1, 1) == "-" then i = i + 1
      if isdigit(substr(s, i + 1, 1)) = 0 then ok = 0
    end
    else do
      ok = 0
      leave
    end
    i = i + 1
  end
  if nd = 0 | n = 0 then ok = 0
  if ok = 0 then return raise_exc(36, "could not convert string to float: " || repr_str(s0))
  l = lower(s)
  p = pos("e", l)
  ex = ""
  mant = l
  if p > 0 then do
    mant = left(l, p - 1)
    ex = substr(l, p)
  end
  if left(mant, 1) == "." then mant = "0" || mant
  if right(mant, 1) == "." then mant = mant || "0"
  if pos(".", mant) = 0 then mant = mant || ".0"
  f = parse_flt(mant || ex)
  if neg = 1 then f = 0.0 - f
  return mkfloat(f)

/* int(...) */
ctor_int: procedure = .int
  arg base = .int, na = .int, nk = .int
  x = .int
  bs = .int
  f = .float
  m = .int
  if na = 0 then return mkint(0)
  x = ast[base + 1]
  bs = 10
  if na >= 2 then do
    if chk_int(ast[base + 2]) = 0 then return 0
    bs = ival(ast[base + 2])
  end
  else if kwarg(base, na, nk, "base") \= 0 then bs = ival(kwarg(base, na, nk, "base"))
  else bs = -1
  if kind_of(x) = 6 then do
    if bs = -1 then bs = 10
    return parse_int(ob_s[x % 2], bs)
  end
  if bs \= -1 then return raise_exc(38, "int() can't convert non-string with explicit base")
  select
    when numkind(x) = 1 then return mkint(ival(x))
    when numkind(x) = 2 then return x
    when numkind(x) = 3 then do
      f = ob_f[x % 2]
      if f \= f then return raise_exc(36, "cannot convert float NaN to integer")
      if finf(f) \= 0 then return raise_exc(31, "cannot convert float infinity to integer")
      return float_to_int(f)
    end
    when kind_of(x) = 17 then do
      m = cls_find(ob_c[x % 2], 119)
      if m = 0 then m = cls_find(ob_c[x % 2], 117)
      if m > 0 then return call1(m, x)
    end
    otherwise nop
  end
  return raise_exc(38, "int() argument must be a string, a bytes-like object or a real number, not '" || type_name(x) || "'")

ctor_float: procedure = .int
  arg base = .int, na = .int
  x = .int
  m = .int
  if na = 0 then return mkfloat(0.0)
  x = ast[base + 1]
  if kind_of(x) = 6 then return parse_float_str(ob_s[x % 2])
  if numkind(x) > 0 then return mkfloat(tofloat(x))
  if kind_of(x) = 17 then do
    m = cls_find(ob_c[x % 2], 111)
    if m > 0 then return call1(m, x)
  end
  return raise_exc(38, "float() argument must be a string or a real number, not '" || type_name(x) || "'")

ctor_dict: procedure = .int
  arg base = .int, na = .int, nk = .int
  o = .int
  x = .int
  j = .int
  it = .int
  v = .int
  p = .int
  l = .int
  o = dict_new(9)
  if na > 1 then return raise_exc(38, "dict expected at most 1 argument, got " || na)
  if na = 1 then do
    x = ast[base + 1]
    if kind_of(x) = 9 then call dict_update o, x
    else do
      it = iter_new(x)
      if it = 0 then return 0
      do forever
        v = iter_next(it)
        if v = 0 then leave
        l = iter_list(v)
        if l = 0 then return 0
        if ob_n[l % 2] \= 2 then return raise_exc(36, "dictionary update sequence element has length " || ob_n[l % 2] || "; 2 is required")
        call dset o, sl[ob_p[l % 2]], sl[ob_p[l % 2] + 1]
      end
      if unw > 0 then return 0
    end
  end
  do j = 1 to nk
    call dset o, mkstr(asn[base + na + j]), ast[base + na + j]
  end
  return o

ctor_set: procedure = .int
  arg base = .int, na = .int
  o = .int
  l = .int
  i = .int
  o = dict_new(10)
  if na = 0 then return o
  l = iter_list(ast[base + 1])
  if l = 0 then return 0
  do i = 0 to ob_n[l % 2] - 1
    call dset o, sl[ob_p[l % 2] + i], 4
  end
  return o

ctor_range: procedure = .int
  arg base = .int, na = .int
  a = .int
  b = .int
  c = .int
  i = .int
  if na < 1 | na > 3 then return nargs_err("range", na, 1, 3)
  do i = 1 to na
    if chk_int(ast[base + i]) = 0 then return 0
  end
  a = 0
  c = 1
  if na = 1 then b = ival(ast[base + 1])
  else do
    a = ival(ast[base + 1])
    b = ival(ast[base + 2])
    if na = 3 then c = ival(ast[base + 3])
  end
  if c = 0 then return raise_exc(36, "range() arg 3 must not be zero")
  return mkrange(a, b, c)

/* constructor call of a built-in type class c */
bcall_type: procedure = .int
  arg c = .int, base = .int, na = .int, nk = .int
  x = .int
  l = .int
  o = .int
  select
    when c = 11 then return ctor_range(base, na)
    when c = 3 then return ctor_int(base, na, nk)
    when c = 6 then do
      if na = 0 then return mkstr("")
      if kind_of(ast[base + 1]) = 6 then return ast[base + 1]
      return mkstr(str_of(ast[base + 1]))
    end
    when c = 4 then return ctor_float(base, na)
    when c = 5 then do
      if na = 0 then return 6
      return mkbool(truthy(ast[base + 1]))
    end
    when c = 7 then do
      if na = 0 then return mklist(4)
      return iter_list(ast[base + 1])
    end
    when c = 8 then do
      if na = 0 then return mktuple(0)
      if kind_of(ast[base + 1]) = 8 then return ast[base + 1]
      l = iter_list(ast[base + 1])
      if l = 0 then return 0
      return tup_of_list(l)
    end
    when c = 9 then return ctor_dict(base, na, nk)
    when c = 10 then return ctor_set(base, na)
    when c = 1 then return inst_new(1)
    when c = 2 then do
      if na = 1 then return cl_obj[cls_of(ast[base + 1])]
      return raise_exc(38, "type() takes 1 or 3 arguments")
    end
    when c = 22 then do
      o = newobj(22)
      ob_x[o % 2] = ast[base + 1]
      ob_y[o % 2] = 0
      if na >= 2 then ob_y[o % 2] = ast[base + 2]
      return o
    end
    when c = 23 then do
      o = newobj(23)
      ob_x[o % 2] = ast[base + 1]
      return o
    end
    when c = 24 then do
      o = newobj(24)
      ob_x[o % 2] = ast[base + 1]
      return o
    end
    otherwise nop
  end
  return raise_exc(38, "cannot create '" || cl_name[c] || "' instances")

/* call of a built-in function */
bcall: procedure = .int
  arg bid = .int, base = .int, na = .int, nk = .int
  r = .int
  x = .int
  rs = .string
  select
    when bid = 1 then return bi_print(base, na, nk)
    when bid = 2 then do
      if na \= 1 then return nargs_err("len", na, 1, 1)
      return bi_len(ast[base + 1])
    end
    when bid = 3 then do
      if na \= 2 then return nargs_err("isinstance", na, 2, 2)
      return bi_isinstance(ast[base + 1], ast[base + 2], 0)
    end
    when bid = 4 then return bi_minmax(base, na, nk, 0)
    when bid = 5 then return bi_minmax(base, na, nk, 1)
    when bid = 6 then do
      if na \= 1 then return nargs_err("abs", na, 1, 1)
      return bi_abs(ast[base + 1])
    end
    when bid = 7 then return bi_sum(base, na, nk)
    when bid = 8 then return bi_sorted(base, na, nk)
    when bid = 9 then return bi_enumerate(base, na, nk)
    when bid = 10 then return bi_zip(base, na)
    when bid = 11 then return bi_map(base, na)
    when bid = 12 then do
      if na \= 2 then return nargs_err("filter", na, 2, 2)
      return bi_filter(ast[base + 1], ast[base + 2])
    end
    when bid = 13 then do
      if na \= 1 then return nargs_err("repr", na, 1, 1)
      rs = repr_of(ast[base + 1])
      if unw > 0 then return 0
      return mkstr(rs)
    end
    when bid = 14 then do
      if na \= 1 then return nargs_err("ascii", na, 1, 1)
      rs = repr_of(ast[base + 1])
      if unw > 0 then return 0
      return mkstr(rs)
    end
    when bid = 15 then do
      if na \= 1 then return nargs_err("any", na, 1, 1)
      return bi_anyall(ast[base + 1], 1)
    end
    when bid = 16 then do
      if na \= 1 then return nargs_err("all", na, 1, 1)
      return bi_anyall(ast[base + 1], 0)
    end
    when bid = 17 then return bi_round(base, na, nk)
    when bid = 18 then do
      if na \= 2 then return nargs_err("divmod", na, 2, 2)
      return bi_divmod(ast[base + 1], ast[base + 2])
    end
    when bid = 19 then return bi_pow(base, na)
    when bid = 20 then do
      if na \= 1 then return nargs_err("chr", na, 1, 1)
      return bi_chr(ast[base + 1])
    end
    when bid = 21 then do
      if na \= 1 then return nargs_err("ord", na, 1, 1)
      return bi_ord(ast[base + 1])
    end
    when bid = 22 then do
      if na \= 1 then return nargs_err("hex", na, 1, 1)
      return bi_radix(ast[base + 1], 16)
    end
    when bid = 23 then do
      if na \= 1 then return nargs_err("oct", na, 1, 1)
      return bi_radix(ast[base + 1], 8)
    end
    when bid = 24 then do
      if na \= 1 then return nargs_err("bin", na, 1, 1)
      return bi_radix(ast[base + 1], 2)
    end
    when bid = 25 then do
      if na \= 2 then return nargs_err("issubclass", na, 2, 2)
      if kind_of(ast[base + 1]) \= 16 then return raise_exc(38, "issubclass() arg 1 must be a class")
      return bi_isinstance(ob_x[ast[base + 1] % 2], ast[base + 2], 1)
    end
    when bid = 26 then return bi_getattr(base, na)
    when bid = 27 then do
      if na \= 2 then return nargs_err("hasattr", na, 2, 2)
      return bi_hasattr(ast[base + 1], ast[base + 2])
    end
    when bid = 28 then do
      if na \= 3 then return nargs_err("setattr", na, 3, 3)
      return bi_setattr(ast[base + 1], ast[base + 2], ast[base + 3])
    end
    when bid = 29 then do
      if na \= 2 then return nargs_err("delattr", na, 2, 2)
      return bi_delattr(ast[base + 1], ast[base + 2])
    end
    when bid = 30 then do
      if na \= 1 then return nargs_err("callable", na, 1, 1)
      return bi_callable(ast[base + 1])
    end
    when bid = 31 then return bi_next(base, na)
    when bid = 32 then do
      if na \= 1 then return nargs_err("iter", na, 1, 1)
      return iter_new(ast[base + 1])
    end
    when bid = 33 then do
      if na \= 1 then return nargs_err("id", na, 1, 1)
      return mkint(ast[base + 1])
    end
    when bid = 34 then do
      if na \= 1 then return nargs_err("hash", na, 1, 1)
      return bi_hash(ast[base + 1])
    end
    when bid = 35 then return bi_input(base, na)
    when bid = 36 then return bi_open(base, na, nk)
    when bid = 37 then do
      if na \= 1 then return nargs_err("reversed", na, 1, 1)
      return bi_reversed(ast[base + 1])
    end
    when bid = 38 then return bi_format(base, na)
    when bid = 39 then return bi_super(base, na)
    when bid = 42 then return bi_exc_init(base, na)
    when bid = 43 then return 2
    when bid = 40 then return bi_exit(base, na)
    when bid = 41 then return bi_exit(base, na)
    when bid = 46 then do
      return sl[ob_p[ast[base + 1] % 2] + 1]
    end
    when bid = 44 then do
      if na >= 1 then return ast[base + 1]
      return 2
    end
    when bid = 45 then do
      if na >= 1 & (kind_of(ast[base + 1]) = 12 | kind_of(ast[base + 1]) = 16) then return ast[base + 1]
      return identity_oop
    end
    otherwise nop
  end
  if bid >= 47 then return bcall_mod(bid, base, na, nk)
  return raise_exc(38, "unsupported built-in function")

/* ---------------------------------------------------------------------
   Methods of the built-in types
   --------------------------------------------------------------------- */
/* a method called on a built-in value; arguments at ast[base+1 ..] */
bmeth: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  k = .int
  k = kind_of(o)
  select
    when k = 6 then return meth_str(o, nid, base, na, nk)
    when k = 7 then return meth_list(o, nid, base, na, nk)
    when k = 9 then return meth_dict(o, nid, base, na, nk)
    when k = 10 then return meth_set(o, nid, base, na, nk)
    when k = 8 then return meth_tuple(o, nid, base, na, nk)
    when k = 3 | k = 4 | k = 2 | k = 5 then return meth_num(o, nid, base, na, nk)
    when k = 19 | k = 20 then return meth_gen(o, nid, base, na, nk)
    when k = 26 then return meth_file(o, nid, base, na, nk)
    when k = 22 then do
      if nid = 80 | nid = 29 then do
        k = newobj(22)
        ob_x[k % 2] = ob_x[o % 2]
        ob_y[k % 2] = ob_y[o % 2]
        if nid = 80 then ob_y[k % 2] = ast[base + 1]
        else ob_x[k % 2] = ast[base + 1]
        return k
      end
    end
    otherwise nop
  end
  return meth_common(o, nid, base, na, nk)

/* unbound call  type.method(receiver, args...) */
bmeth_unbound: procedure = .int
  arg c = .int, nid = .int, base = .int, na = .int, nk = .int
  if c = 9 & nid = 27 then return dict_fromkeys(base, na)
  if na < 1 then return raise_exc(38, "descriptor '" || nid_name[nid] || "' of '" || cl_name[c] || "' object needs an argument")
  return bmeth(ast[base + 1], nid, base + 1, na - 1, nk)

meth_common: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  r = .int
  select
    when nid = 121 then return bi_len(o)
    when nid = 132 then do
      r = str_of(o)
      if unw > 0 then return 0
      return mkstr(r)
    end
    when nid = 128 then do
      r = repr_of(o)
      if unw > 0 then return 0
      return mkstr(r)
    end
    when nid = 120 then return iter_new(o)
    when nid = 126 then do
      r = iter_next(o)
      if r = 0 then do
        if unw > 0 then return 0
        unw = 4
        unw_v = exc_new0(45)
        return 0
      end
      return r
    end
    when nid = 104 then do
      r = py_contains(o, ast[base + 1])
      if unw > 0 then return 0
      return mkbool(r)
    end
    when nid = 115 then return getitem(o, ast[base + 1])
    when nid = 109 then do
      r = py_eq(o, ast[base + 1])
      if unw > 0 then return 0
      return mkbool(r)
    end
    when nid = 116 then return bi_hash(o)
    when nid = 101 then do
      r = truthy(o)
      if unw > 0 then return 0
      return mkbool(r)
    end
    otherwise nop
  end
  return no_attr(o, nid)

/* ---------------------------------------------------------------------
   str
   --------------------------------------------------------------------- */
is_ws: procedure = .int
  arg c = .string
  if c == "" then return 0
  if pos(c, wsch) > 0 then return 1
  return 0

/* mode: 1 left, 2 right, 3 both ; chars "" = white space */
str_strip: procedure = .string
  arg s = .string, chars = .string, mode = .int
  i = .int
  j = .int
  n = .int
  n = length(s)
  i = 1
  j = n
  if mode // 2 = 1 then do
    if chars == "" then do
      do while i <= n & is_ws(substr(s, i, 1)) = 1
        i = i + 1
      end
    end
    else do
      do while i <= n & pos(substr(s, i, 1), chars) > 0
        i = i + 1
      end
    end
  end
  if mode >= 2 then do
    if chars == "" then do
      do while j >= i & is_ws(substr(s, j, 1)) = 1
        j = j - 1
      end
    end
    else do
      do while j >= i & pos(substr(s, j, 1), chars) > 0
        j = j - 1
      end
    end
  end
  if j < i then return ""
  return substr(s, i, j - i + 1)

split_ws: procedure = .int
  arg s = .string, maxsplit = .int
  l = .int
  n = .int
  i = .int
  j = .int
  l = mklist(8)
  n = length(s)
  i = 1
  do forever
    do while i <= n & is_ws(substr(s, i, 1)) = 1
      i = i + 1
    end
    if i > n then leave
    if maxsplit >= 0 & ob_n[l % 2] >= maxsplit then do
      call list_append l, mkstr(substr(s, i))
      leave
    end
    j = i
    do while j <= n & is_ws(substr(s, j, 1)) = 0
      j = j + 1
    end
    call list_append l, mkstr(substr(s, i, j - i))
    i = j
  end
  return l

rsplit_ws: procedure = .int
  arg s = .string, maxsplit = .int
  l = .int
  n = .int
  j = .int
  i = .int
  t = .int
  a = .int
  b = .int
  l = mklist(8)
  n = length(s)
  j = n
  do forever
    do while j >= 1 & is_ws(substr(s, j, 1)) = 1
      j = j - 1
    end
    if j < 1 then leave
    if maxsplit >= 0 & ob_n[l % 2] >= maxsplit then do
      call list_append l, mkstr(left(s, j))
      leave
    end
    i = j
    do while i >= 1 & is_ws(substr(s, i, 1)) = 0
      i = i - 1
    end
    call list_append l, mkstr(substr(s, i + 1, j - i))
    j = i
  end
  /* reverse */
  a = 0
  b = ob_n[l % 2] - 1
  do while a < b
    t = sl[ob_p[l % 2] + a]
    sl[ob_p[l % 2] + a] = sl[ob_p[l % 2] + b]
    sl[ob_p[l % 2] + b] = t
    a = a + 1
    b = b - 1
  end
  return l

split_sep: procedure = .int
  arg s = .string, sep = .string, maxsplit = .int
  l = .int
  p = .int
  i = .int
  ls = .int
  l = mklist(8)
  ls = length(sep)
  i = 1
  do forever
    if maxsplit >= 0 & ob_n[l % 2] >= maxsplit then leave
    p = pos(sep, s, i)
    if p = 0 then leave
    call list_append l, mkstr(substr(s, i, p - i))
    i = p + ls
  end
  call list_append l, mkstr(substr(s, i))
  return l

rsplit_sep: procedure = .int
  arg s = .string, sep = .string, maxsplit = .int
  l = .int
  p = .int
  e = .int
  ls = .int
  a = .int
  b = .int
  t = .int
  l = mklist(8)
  ls = length(sep)
  e = length(s)
  do forever
    if maxsplit >= 0 & ob_n[l % 2] >= maxsplit then leave
    p = 0
    if e >= ls then p = lastpos(sep, s, e)
    if p = 0 then leave
    call list_append l, mkstr(substr(s, p + ls, e - p - ls + 1))
    e = p - 1
  end
  call list_append l, mkstr(left(s, e))
  a = 0
  b = ob_n[l % 2] - 1
  do while a < b
    t = sl[ob_p[l % 2] + a]
    sl[ob_p[l % 2] + a] = sl[ob_p[l % 2] + b]
    sl[ob_p[l % 2] + b] = t
    a = a + 1
    b = b - 1
  end
  return l

str_replace: procedure = .string
  arg s = .string, old = .string, new = .string, cnt = .int
  r = .string
  p = .int
  i = .int
  n = .int
  lo = .int
  c = .int
  if old == "" then do
    n = length(s)
    r = ""
    c = 0
    do i = 1 to n
      if cnt < 0 | c < cnt then do
        r = r || new
        c = c + 1
      end
      r = r || substr(s, i, 1)
    end
    if cnt < 0 | c < cnt then r = r || new
    return r
  end
  lo = length(old)
  r = ""
  i = 1
  c = 0
  do forever
    if cnt >= 0 & c >= cnt then leave
    p = pos(old, s, i)
    if p = 0 then leave
    r = r || substr(s, i, p - i) || new
    i = p + lo
    c = c + 1
  end
  return r || substr(s, i)

/* normalise optional [start, end] arguments (from ast[base+first ..]) to 0-based start and end */
slice_args: procedure = .int
  arg n = .int, base = .int, na = .int, first = .int
  st = .int
  en = .int
  st = 0
  en = n
  if na >= first then do
    if ast[base + first] \= 2 then do
      if chk_int(ast[base + first]) = 0 then return 0
      st = ival(ast[base + first])
      if st < 0 then st = st + n
      if st < 0 then st = 0
    end
  end
  if na >= first + 1 then do
    if ast[base + first + 1] \= 2 then do
      if chk_int(ast[base + first + 1]) = 0 then return 0
      en = ival(ast[base + first + 1])
      if en < 0 then en = en + n
      if en < 0 then en = 0
      if en > n then en = n
    end
  end
  sl_a = st
  sl_n = en
  return 1

str_title: procedure = .string
  arg s = .string
  r = .string
  i = .int
  n = .int
  c = .string
  prev = .int
  r = ""
  prev = 0
  n = length(s)
  do i = 1 to n
    c = substr(s, i, 1)
    if isletter(c) = 1 & c \== "_" then do
      if prev = 1 then r = r || lower(c)
      else r = r || upper(c)
      prev = 1
    end
    else do
      r = r || c
      prev = 0
    end
  end
  return r

str_swapcase: procedure = .string
  arg s = .string
  r = .string
  i = .int
  n = .int
  c = .string
  r = ""
  n = length(s)
  do i = 1 to n
    c = substr(s, i, 1)
    if c >>= "a" & c <<= "z" then r = r || upper(c)
    else if c >>= "A" & c <<= "Z" then r = r || lower(c)
    else r = r || c
  end
  return r

/* character class test: 1 alpha, 2 digit, 3 alnum, 4 space, 5 identifier */
str_isclass: procedure = .int
  arg s = .string, cls = .int
  i = .int
  n = .int
  c = .string
  a = .int
  d = .int
  n = length(s)
  if n = 0 then return 0
  do i = 1 to n
    c = substr(s, i, 1)
    a = 0
    if c >>= "a" & c <<= "z" then a = 1
    else if c >>= "A" & c <<= "Z" then a = 1
    else if c2d(c) >= 128 then a = 1
    d = isdigit(c)
    if cls = 1 & a = 0 then return 0
    if cls = 2 & d = 0 then return 0
    if cls = 3 & a = 0 & d = 0 then return 0
    if cls = 4 & is_ws(c) = 0 then return 0
    if cls = 5 then do
      if a = 0 & c \== "_" then do
        if d = 0 | i = 1 then return 0
      end
    end
  end
  return 1

str_pad_arg: procedure = .string
  arg base = .int, na = .int, idx = .int
  v = .int
  if na < idx then return " "
  v = ast[base + idx]
  if kind_of(v) \= 6 | length(ob_s[v % 2]) \= 1 then do
    call raise_exc 38, "The fill character must be exactly one character long"
    return " "
  end
  return ob_s[v % 2]

meth_str: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  s = .string
  a = .string
  b = .string
  n = .int
  i = .int
  j = .int
  p = .int
  r = .int
  v = .int
  l = .int
  c = .int
  t = .string
  w = .int
  m = .int
  f = .string
  st = .int
  en = .int
  x = .string
  s = ob_s[o % 2]
  select
    when nid = 51 then do
      if na \= 1 then return nargs_err("join", na, 1, 1)
      l = iter_list(ast[base + 1])
      if l = 0 then return 0
      n = ob_n[l % 2]
      t = ""
      do i = 0 to n - 1
        v = sl[ob_p[l % 2] + i]
        if kind_of(v) \= 6 then return raise_exc(38, "sequence item " || i || ": expected str instance, " || type_name(v) || " found")
        if i > 0 then t = t || s
        t = t || ob_s[v % 2]
      end
      return mkstr(t)
    end
    when nid = 95 then return mkstr(upper(s))
    when nid = 54 | nid = 7 then return mkstr(lower(s))
    when nid = 88 | nid = 55 | nid = 77 then do
      a = ""
      if na >= 1 then do
        if ast[base + 1] \= 2 then a = ob_s[ast[base + 1] % 2]
      end
      m = 3
      if nid = 55 then m = 1
      if nid = 77 then m = 2
      return mkstr(str_strip(s, a, m))
    end
    when nid = 82 | nid = 76 then do
      a = ""
      w = 0
      m = -1
      if na >= 1 then do
        if ast[base + 1] \= 2 then do
          if kind_of(ast[base + 1]) \= 6 then return raise_exc(38, "must be str or None, not " || type_name(ast[base + 1]))
          a = ob_s[ast[base + 1] % 2]
          w = 1
          if a == "" then return raise_exc(36, "empty separator")
        end
      end
      if na >= 2 then m = ival(ast[base + 2])
      if kwarg(base, na, nk, "maxsplit") \= 0 then m = ival(kwarg(base, na, nk, "maxsplit"))
      if kwarg(base, na, nk, "sep") \= 0 then do
        if kwarg(base, na, nk, "sep") \= 2 then do
          a = ob_s[kwarg(base, na, nk, "sep") % 2]
          w = 1
        end
      end
      if nid = 82 then do
        if w = 0 then return split_ws(s, m)
        return split_sep(s, a, m)
      end
      if w = 0 then return rsplit_ws(s, m)
      return rsplit_sep(s, a, m)
    end
    when nid = 70 then do
      if na < 2 then return nargs_err("replace", na, 2, 3)
      if kind_of(ast[base + 1]) \= 6 | kind_of(ast[base + 2]) \= 6 then return raise_exc(38, "replace() argument must be str")
      m = -1
      if na >= 3 then m = ival(ast[base + 3])
      return mkstr(str_replace(s, ob_s[ast[base + 1] % 2], ob_s[ast[base + 2] % 2], m))
    end
    when nid = 24 | nid = 72 | nid = 31 | nid = 73 | nid = 14 then do
      if na < 1 then return nargs_err(nid_name[nid], na, 1, 3)
      if kind_of(ast[base + 1]) \= 6 then return raise_exc(38, "must be str, not " || type_name(ast[base + 1]))
      a = ob_s[ast[base + 1] % 2]
      if slice_args(length(s), base, na, 2) = 0 then return 0
      st = sl_a
      en = sl_n
      if st > en | st > length(s) then do
        if nid = 14 then return mkint(0)
        if nid = 24 | nid = 72 then return mkint(-1)
        return raise_exc(36, "substring not found")
      end
      t = substr(s, st + 1, en - st)
      if nid = 14 then do
        if a == "" then return mkint(length(t) + 1)
        return mkint(countstr(a, t))
      end
      if a == "" then do
        if nid = 72 | nid = 73 then return mkint(en)
        return mkint(st)
      end
      if nid = 24 | nid = 31 then p = pos(a, t)
      else p = lastpos(a, t)
      if p = 0 then do
        if nid = 24 | nid = 72 then return mkint(-1)
        return raise_exc(36, "substring not found")
      end
      return mkint(p - 1 + st)
    end
    when nid = 85 | nid = 21 then do
      if na < 1 then return nargs_err(nid_name[nid], na, 1, 3)
      if slice_args(length(s), base, na, 2) = 0 then return 0
      st = sl_a
      en = sl_n
      if st > en then return 6
      t = substr(s, st + 1, en - st)
      v = ast[base + 1]
      if kind_of(v) = 6 then do
        l = 1
        i = 0
        j = 0
      end
      else if kind_of(v) = 8 then do
        l = ob_n[v % 2]
        i = 0
      end
      else return raise_exc(38, nid_name[nid] || " first arg must be str or a tuple of str, not " || type_name(v))
      do j = 0 to l - 1
        if kind_of(v) = 6 then a = ob_s[v % 2]
        else a = ob_s[sl[ob_p[v % 2] + j] % 2]
        n = length(a)
        if n <= length(t) then do
          if nid = 85 then do
            if left(t, n) == a then return 4
          end
          else do
            if n = 0 then return 4
            if right(t, n) == a then return 4
          end
        end
      end
      return 6
    end
    when nid = 36 then return mkbool(str_isclass(s, 1))
    when nid = 39 | nid = 38 | nid = 43 then return mkbool(str_isclass(s, 2))
    when nid = 35 then return mkbool(str_isclass(s, 3))
    when nid = 44 then return mkbool(str_isclass(s, 4))
    when nid = 41 then return mkbool(str_isclass(s, 5))
    when nid = 48 then do
      if upper(s) == s & lower(s) \== s then return 4
      return 6
    end
    when nid = 42 then do
      if lower(s) == s & upper(s) \== s then return 4
      return 6
    end
    when nid = 47 then do
      if str_title(s) == s & upper(s) \== lower(s) then return 4
      return 6
    end
    when nid = 37 then do
      do i = 1 to length(s)
        if c2d(substr(s, i, 1)) >= 128 then return 6
      end
      return 4
    end
    when nid = 6 then return mkstr(upper(left(s, 1)) || lower(substr(s, 2)))
    when nid = 91 then return mkstr(str_title(s))
    when nid = 89 then return mkstr(str_swapcase(s))
    when nid = 8 | nid = 53 | nid = 74 then do
      if na < 1 then return nargs_err(nid_name[nid], na, 1, 2)
      if chk_int(ast[base + 1]) = 0 then return 0
      w = ival(ast[base + 1])
      f = str_pad_arg(base, na, 2)
      if unw > 0 then return 0
      n = length(s)
      if w <= n then return o
      m = w - n
      if nid = 53 then return mkstr(s || copies(f, m))
      if nid = 74 then return mkstr(copies(f, m) || s)
      i = m % 2 + (m // 2) * (w // 2)
      return mkstr(copies(f, i) || s || copies(f, m - i))
    end
    when nid = 99 then do
      if chk_int(ast[base + 1]) = 0 then return 0
      w = ival(ast[base + 1])
      n = length(s)
      if w <= n then return o
      if left(s, 1) == "-" | left(s, 1) == "+" then return mkstr(left(s, 1) || copies("0", w - n) || substr(s, 2))
      return mkstr(copies("0", w - n) || s)
    end
    when nid = 59 | nid = 75 then do
      if na \= 1 then return nargs_err(nid_name[nid], na, 1, 1)
      if kind_of(ast[base + 1]) \= 6 then return raise_exc(38, "must be str, not " || type_name(ast[base + 1]))
      a = ob_s[ast[base + 1] % 2]
      if a == "" then return raise_exc(36, "empty separator")
      if nid = 59 then p = pos(a, s)
      else p = lastpos(a, s)
      v = mktuple(3)
      if p = 0 then do
        if nid = 59 then do
          sl[ob_p[v % 2]] = o
          sl[ob_p[v % 2] + 1] = mkstr("")
          sl[ob_p[v % 2] + 2] = mkstr("")
        end
        else do
          sl[ob_p[v % 2]] = mkstr("")
          sl[ob_p[v % 2] + 1] = mkstr("")
          sl[ob_p[v % 2] + 2] = o
        end
        return v
      end
      sl[ob_p[v % 2]] = mkstr(left(s, p - 1))
      sl[ob_p[v % 2] + 1] = ast[base + 1]
      sl[ob_p[v % 2] + 2] = mkstr(substr(s, p + length(a)))
      return v
    end
    when nid = 26 then return fmt_format(s, base, na, nk)
    when nid = 83 then do
      l = mklist(8)
      m = 0
      if na >= 1 then m = truthy(ast[base + 1])
      if kwarg(base, na, nk, "keepends") \= 0 then m = truthy(kwarg(base, na, nk, "keepends"))
      n = length(s)
      i = 1
      do while i <= n
        j = i
        do while j <= n & substr(s, j, 1) \== '0a'x & substr(s, j, 1) \== '0d'x
          j = j + 1
        end
        p = j
        if j <= n then do
          if substr(s, j, 1) == '0d'x & substr(s, j + 1, 1) == '0a'x then j = j + 2
          else j = j + 1
        end
        if m = 1 then call list_append l, mkstr(substr(s, i, j - i))
        else call list_append l, mkstr(substr(s, i, p - i))
        i = j
      end
      return l
    end
    when nid = 20 | nid = 15 then return o
    when nid = 68 then do
      a = ob_s[ast[base + 1] % 2]
      if length(a) <= length(s) then do
        if left(s, length(a)) == a then return mkstr(substr(s, length(a) + 1))
      end
      return o
    end
    when nid = 69 then do
      a = ob_s[ast[base + 1] % 2]
      if length(a) <= length(s) & length(a) > 0 then do
        if right(s, length(a)) == a then return mkstr(left(s, length(s) - length(a)))
      end
      return o
    end
    when nid = 22 then do
      w = 8
      if na >= 1 then w = ival(ast[base + 1])
      t = ""
      c = 0
      do i = 1 to length(s)
        a = substr(s, i, 1)
        if a == '09'x then do
          m = w - (c // w)
          t = t || copies(" ", m)
          c = c + m
        end
        else if a == '0a'x then do
          t = t || a
          c = 0
        end
        else do
          t = t || a
          c = c + 1
        end
      end
      return mkstr(t)
    end
    when nid = 92 then return o
    otherwise nop
  end
  return meth_common(o, nid, base, na, nk)

/* ---------------------------------------------------------------------
   list
   --------------------------------------------------------------------- */
meth_list: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  ix = .int
  n = .int
  p = .int
  i = .int
  j = .int
  v = .int
  l = .int
  r = .int
  keyf = .int
  rev = .int
  st = .int
  en = .int
  t = .int
  ix = o % 2
  select
    when nid = 2 then do
      if na \= 1 then return nargs_err("append", na, 1, 1)
      call list_append o, ast[base + 1]
      return 2
    end
    when nid = 60 then do
      n = ob_n[ix]
      if n = 0 then return raise_exc(34, "pop from empty list")
      i = n - 1
      if na >= 1 then do
        if chk_int(ast[base + 1]) = 0 then return 0
        i = ival(ast[base + 1])
        if i < 0 then i = i + n
        if i < 0 | i >= n then return raise_exc(34, "pop index out of range")
      end
      p = ob_p[ix]
      v = sl[p + i]
      do j = i to n - 2
        sl[p + j] = sl[p + j + 1]
      end
      ob_n[ix] = n - 1
      return v
    end
    when nid = 23 then do
      if na \= 1 then return nargs_err("extend", na, 1, 1)
      l = iter_list(ast[base + 1])
      if l = 0 then return 0
      call list_extend_from o, l
      return 2
    end
    when nid = 32 then do
      if na \= 2 then return nargs_err("insert", na, 2, 2)
      if chk_int(ast[base + 1]) = 0 then return 0
      n = ob_n[ix]
      i = ival(ast[base + 1])
      if i < 0 then i = i + n
      if i < 0 then i = 0
      if i > n then i = n
      call list_reserve o, n + 1
      p = ob_p[ix]
      do j = n - 1 to i by -1
        sl[p + j + 1] = sl[p + j]
      end
      sl[p + i] = ast[base + 2]
      ob_n[ix] = n + 1
      return 2
    end
    when nid = 67 then do
      if na \= 1 then return nargs_err("remove", na, 1, 1)
      n = ob_n[ix]
      p = ob_p[ix]
      do i = 0 to n - 1
        r = py_eq(sl[p + i], ast[base + 1])
        if unw > 0 then return 0
        if r = 1 then do
          do j = i to n - 2
            sl[p + j] = sl[p + j + 1]
          end
          ob_n[ix] = n - 1
          return 2
        end
      end
      return raise_exc(36, "list.remove(x): x not in list")
    end
    when nid = 31 | nid = 14 then do
      if na < 1 then return nargs_err(nid_name[nid], na, 1, 3)
      n = ob_n[ix]
      p = ob_p[ix]
      st = 0
      en = n
      if nid = 31 then do
        if slice_args(n, base, na, 2) = 0 then return 0
        st = sl_a
        en = sl_n
      end
      j = 0
      do i = st to en - 1
        r = py_eq(sl[p + i], ast[base + 1])
        if unw > 0 then return 0
        if r = 1 then do
          if nid = 31 then return mkint(i)
          j = j + 1
        end
      end
      if nid = 14 then return mkint(j)
      return raise_exc(36, repr_of(ast[base + 1]) || " is not in list")
    end
    when nid = 81 then do
      keyf = kwarg(base, na, nk, "key")
      if keyf = 2 then keyf = 0
      rev = 0
      r = kwarg(base, na, nk, "reverse")
      if r \= 0 then rev = truthy(r)
      if sort_list(o, keyf, rev) = 0 then return 0
      return 2
    end
    when nid = 71 then do
      n = ob_n[ix]
      p = ob_p[ix]
      i = 0
      j = n - 1
      do while i < j
        t = sl[p + i]
        sl[p + i] = sl[p + j]
        sl[p + j] = t
        i = i + 1
        j = j - 1
      end
      return 2
    end
    when nid = 13 then return iter_list(o)
    when nid = 9 then do
      ob_n[ix] = 0
      return 2
    end
    when nid = 62 then do
      n = ob_n[ix]
      if n = 0 then return raise_exc(34, "pop from an empty deque")
      p = ob_p[ix]
      v = sl[p]
      do j = 0 to n - 2
        sl[p + j] = sl[p + j + 1]
      end
      ob_n[ix] = n - 1
      return v
    end
    when nid = 3 then do
      n = ob_n[ix]
      call list_reserve o, n + 1
      p = ob_p[ix]
      do j = n - 1 to 0 by -1
        sl[p + j + 1] = sl[p + j]
      end
      sl[p] = ast[base + 1]
      ob_n[ix] = n + 1
      return 2
    end
    otherwise nop
  end
  return meth_common(o, nid, base, na, nk)

meth_tuple: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  n = .int
  p = .int
  i = .int
  j = .int
  r = .int
  n = ob_n[o % 2]
  p = ob_p[o % 2]
  if nid = 31 | nid = 14 then do
    if na < 1 then return nargs_err(nid_name[nid], na, 1, 3)
    j = 0
    do i = 0 to n - 1
      r = py_eq(sl[p + i], ast[base + 1])
      if unw > 0 then return 0
      if r = 1 then do
        if nid = 31 then return mkint(i)
        j = j + 1
      end
    end
    if nid = 14 then return mkint(j)
    return raise_exc(36, "tuple.index(x): x not in tuple")
  end
  return meth_common(o, nid, base, na, nk)

/* ---------------------------------------------------------------------
   dict
   --------------------------------------------------------------------- */
dict_fill: procedure = .int
  arg o = .int, x = .int
  it = .int
  v = .int
  l = .int
  if kind_of(x) = 9 then do
    call dict_update o, x
    return 1
  end
  it = iter_new(x)
  if it = 0 then return 0
  do forever
    v = iter_next(it)
    if v = 0 then leave
    l = iter_list(v)
    if l = 0 then return 0
    if ob_n[l % 2] \= 2 then do
      call raise_exc 36, "dictionary update sequence element has length " || ob_n[l % 2] || "; 2 is required"
      return 0
    end
    call dset o, sl[ob_p[l % 2]], sl[ob_p[l % 2] + 1]
  end
  if unw > 0 then return 0
  return 1

dict_fromkeys: procedure = .int
  arg base = .int, na = .int
  o = .int
  l = .int
  i = .int
  v = .int
  if na < 1 | na > 2 then return nargs_err("fromkeys", na, 1, 2)
  o = dict_new(9)
  v = 2
  if na = 2 then v = ast[base + 2]
  l = iter_list(ast[base + 1])
  if l = 0 then return 0
  do i = 0 to ob_n[l % 2] - 1
    call dset o, sl[ob_p[l % 2] + i], v
  end
  return o

meth_dict: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  d = .int
  e = .int
  l = .int
  t = .int
  v = .int
  j = .int
  last = .int
  r = .int
  it = .int
  a = .int
  d = ob_x[o % 2]
  select
    when nid = 28 then do
      if na < 1 | na > 2 then return nargs_err("get", na, 1, 2)
      e = dict_find(d, hashkey(ast[base + 1]))
      if e > 0 then return de_val[e]
      if na = 2 then return ast[base + 2]
      return 2
    end
    when nid = 50 then do
      l = mklist(dd_n[d])
      e = dd_head[d]
      do while e > 0
        if de_live[e] = 1 then do
          t = mktuple(2)
          sl[ob_p[t % 2]] = de_key[e]
          sl[ob_p[t % 2] + 1] = de_val[e]
          call list_append l, t
        end
        e = de_next[e]
      end
      return l
    end
    when nid = 52 | nid = 96 then do
      l = mklist(dd_n[d])
      e = dd_head[d]
      do while e > 0
        if de_live[e] = 1 then do
          if nid = 52 then call list_append l, de_key[e]
          else call list_append l, de_val[e]
        end
        e = de_next[e]
      end
      return l
    end
    when nid = 79 then do
      if na < 1 | na > 2 then return nargs_err("setdefault", na, 1, 2)
      e = dict_find(d, hashkey(ast[base + 1]))
      if e > 0 then return de_val[e]
      v = 2
      if na = 2 then v = ast[base + 2]
      call dset o, ast[base + 1], v
      return v
    end
    when nid = 60 then do
      if na < 1 | na > 2 then return nargs_err("pop", na, 1, 2)
      e = dict_find(d, hashkey(ast[base + 1]))
      if e = 0 then do
        if na = 2 then return ast[base + 2]
        return raise_key(ast[base + 1])
      end
      v = de_val[e]
      r = dict_del(d, de_hk[e])
      return v
    end
    when nid = 61 then do
      last = 0
      e = dd_head[d]
      do while e > 0
        if de_live[e] = 1 then last = e
        e = de_next[e]
      end
      if last = 0 then return raise_exc(35, "popitem(): dictionary is empty")
      t = mktuple(2)
      sl[ob_p[t % 2]] = de_key[last]
      sl[ob_p[t % 2] + 1] = de_val[last]
      r = dict_del(d, de_hk[last])
      return t
    end
    when nid = 94 then do
      if na >= 1 then do
        if dict_fill(o, ast[base + 1]) = 0 then return 0
      end
      do j = 1 to nk
        call dset o, mkstr(asn[base + na + j]), ast[base + na + j]
      end
      return 2
    end
    when nid = 13 then do
      t = dict_copy(o)
      ob_y[t % 2] = ob_y[o % 2]
      return t
    end
    when nid = 9 then do
      call dict_clear d
      return 2
    end
    when nid = 56 then do
      l = meth_dict(o, 50, base, 0, 0)
      /* stable sort by count, descending */
      a = newobj(13)
      ob_x[a % 2] = 46
      if sort_list(l, a, 1) = 0 then return 0
      if na >= 1 then do
        t = mklist(4)
        do j = 0 to ival(ast[base + 1]) - 1
          if j < ob_n[l % 2] then call list_append t, sl[ob_p[l % 2] + j]
        end
        return t
      end
      return l
    end
    otherwise nop
  end
  return meth_common(o, nid, base, na, nk)

/* ---------------------------------------------------------------------
   set
   --------------------------------------------------------------------- */
meth_set: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  d = .int
  e = .int
  l = .int
  t = .int
  v = .int
  i = .int
  j = .int
  r = .int
  x = .int
  ok = .int
  d = ob_x[o % 2]
  select
    when nid = 1 then do
      if na \= 1 then return nargs_err("add", na, 1, 1)
      call dset o, ast[base + 1], 4
      return 2
    end
    when nid = 19 then do
      r = dict_del(d, hashkey(ast[base + 1]))
      return 2
    end
    when nid = 67 then do
      r = dict_del(d, hashkey(ast[base + 1]))
      if r = 0 then return raise_key(ast[base + 1])
      return 2
    end
    when nid = 60 then do
      e = de_live_from(dd_head[d])
      if e = 0 then return raise_exc(35, "pop from an empty set")
      v = de_key[e]
      r = dict_del(d, de_hk[e])
      return v
    end
    when nid = 13 then do
      return dict_copy(o)
    end
    when nid = 9 then do
      call dict_clear d
      return 2
    end
    when nid = 93 | nid = 33 | nid = 17 | nid = 90 then do
      t = dict_copy(o)
      do i = 1 to na
        x = ast[base + i]
        if kind_of(x) \= 10 then do
          l = iter_list(x)
          if l = 0 then return 0
          x = dict_new(10)
          do j = 0 to ob_n[l % 2] - 1
            call dset x, sl[ob_p[l % 2] + j], 4
          end
        end
        if nid = 93 then t = set_op(11, t, x)
        else if nid = 33 then t = set_op(10, t, x)
        else if nid = 17 then t = set_op(2, t, x)
        else t = set_op(12, t, x)
      end
      return t
    end
    when nid = 94 | nid = 34 | nid = 18 then do
      do i = 1 to na
        x = ast[base + i]
        if kind_of(x) \= 10 then do
          l = iter_list(x)
          if l = 0 then return 0
          x = dict_new(10)
          do j = 0 to ob_n[l % 2] - 1
            call dset x, sl[ob_p[l % 2] + j], 4
          end
        end
        if nid = 94 then t = set_op(11, o, x)
        else if nid = 34 then t = set_op(10, o, x)
        else t = set_op(2, o, x)
        ob_x[o % 2] = ob_x[t % 2]
      end
      return 2
    end
    when nid = 45 | nid = 46 | nid = 40 then do
      x = ast[base + 1]
      if kind_of(x) \= 10 then do
        l = iter_list(x)
        if l = 0 then return 0
        x = dict_new(10)
        do j = 0 to ob_n[l % 2] - 1
          call dset x, sl[ob_p[l % 2] + j], 4
        end
      end
      if nid = 45 then return set_cmp(4, o, x)
      if nid = 46 then return set_cmp(6, o, x)
      t = set_op(10, o, x)
      if dd_n[ob_x[t % 2]] = 0 then return 4
      return 6
    end
    otherwise nop
  end
  return meth_common(o, nid, base, na, nk)

/* ---------------------------------------------------------------------
   numbers, generators, files
   --------------------------------------------------------------------- */
meth_num: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  s = .string
  f = .float
  if nid = 5 then do
    s = num_str(o)
    if left(s, 1) == "-" then s = substr(s, 2)
    if s == "0" then return mkint(0)
    return mkint(length(radix_str(s, 2)))
  end
  if nid = 49 then do
    if kind_of(o) \= 5 then return 4
    f = ob_f[o % 2]
    if f = rxfloat..floor(f) & rxfloat..fabs(f) < 1.0e300 then return 4
    return 6
  end
  if nid = 12 then return o
  return meth_common(o, nid, base, na, nk)

meth_gen: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  v = .int
  if nid = 78 then do
    if kind_of(o) \= 19 then return no_attr(o, nid)
    v = gen_resume(ob_x[o % 2], ast[base + 1])
    if v = 0 then do
      if unw > 0 then return 0
      unw = 4
      unw_v = exc_new0(45)
      return 0
    end
    return v
  end
  if nid = 10 then do
    if kind_of(o) = 19 then gn_st[ob_x[o % 2]] = 3
    return 2
  end
  return meth_common(o, nid, base, na, nk)

/* ---------------------------------------------------------------------
   Files, modules (math random sys time itertools functools collections copy)
   --------------------------------------------------------------------- */
mk_file: procedure = .int
  arg id = .int, name = .string
  o = .int
  o = newobj(26)
  ob_x[o % 2] = id
  ob_s[o % 2] = name
  ob_c[o % 2] = 0
  return o

bi_open: procedure = .int
  arg base = .int, na = .int, nk = .int
  fn = .string
  mode = .string
  md = .string
  fid = .int
  rcx = .int
  eof = .int
  line = .string
  acc = .string
  chunk = .string
  nl = .int
  id = .int
  v = .int
  if na < 1 then return nargs_err("open", na, 1, 2)
  if kind_of(ast[base + 1]) \= 6 then return raise_exc(38, "expected str, bytes or os.PathLike object, not " || type_name(ast[base + 1]))
  fn = ob_s[ast[base + 1] % 2]
  mode = "r"
  if na >= 2 then mode = ob_s[ast[base + 2] % 2]
  v = kwarg(base, na, nk, "mode")
  if v \= 0 then mode = ob_s[v % 2]
  md = left(mode, 1)
  if md \== "r" & md \== "w" & md \== "a" & md \== "x" then return raise_exc(36, "invalid mode: " || repr_str(mode))
  nfl = nfl + 1
  id = nfl
  fl_mode[id] = md
  fl_pos[id] = 1
  fl_txt[id] = ""
  fid = 0
  if md == "r" then do
    md = "r"
    assembler fopen fid, fn, md
    if fid = 0 then do
      nfl = nfl - 1
      return raise_exc(54, "[Errno 2] No such file or directory: " || repr_str(fn))
    end
    acc = ""
    chunk = ""
    nl = 0
    eof = 0
    do while eof = 0
      line = ""
      assembler freadline line, fid
      assembler feof eof, fid
      if eof > 0 & length(line) = 0 then leave
      chunk = chunk || line || '0a'x
      nl = nl + 1
      if nl >= 100 then do
        acc = acc || chunk
        chunk = ""
        nl = 0
      end
    end
    assembler fclose rcx, fid
    fl_txt[id] = acc || chunk
    fl_h[id] = 0
  end
  else do
    if md == "x" then md = "w"
    assembler fopen fid, fn, md
    if fid = 0 then do
      nfl = nfl - 1
      return raise_exc(53, "[Errno 13] Permission denied: " || repr_str(fn))
    end
    fl_h[id] = fid
  end
  return mk_file(id, fn)

file_write: procedure = .void
  arg fo = .int, txt = .string
  id = .int
  r = .int
  fid = .int
  id = ob_x[fo % 2]
  if ob_c[fo % 2] = 1 then do
    r = raise_exc(36, "I/O operation on closed file.")
    return
  end
  if id = 1 then call outs txt
  else if id = 2 then call errs txt
  else if id = 3 | fl_mode[id] == "r" then r = raise_exc(53, "not writable")
  else do
    fid = fl_h[id]
    assembler fwrite fid, txt
  end
  return

file_close: procedure = .void
  arg fo = .int
  id = .int
  rcx = .int
  fid = .int
  id = ob_x[fo % 2]
  if ob_c[fo % 2] = 1 | id <= 3 then return
  ob_c[fo % 2] = 1
  if fl_mode[id] \== "r" then do
    fid = fl_h[id]
    assembler fclose rcx, fid
  end
  return

/* next line including its newline; 0 at the end of the file in iteration mode, "" otherwise */
file_readline: procedure = .int
  arg fo = .int, itermode = .int
  id = .int
  line = .string
  e = .int
  p = .int
  t = .string
  id = ob_x[fo % 2]
  if ob_c[fo % 2] = 1 then return raise_exc(36, "I/O operation on closed file.")
  if id = 3 then do
    if stdin_eof = 1 then do
      if itermode = 1 then return 0
      return mkstr("")
    end
    line = ""
    assembler freadline line, h_in
    assembler feof e, h_in
    if e > 0 & length(line) = 0 then do
      stdin_eof = 1
      if itermode = 1 then return 0
      return mkstr("")
    end
    if right(line, 1) == '0d'x then line = left(line, length(line) - 1)
    return mkstr(line || '0a'x)
  end
  if fl_mode[id] \== "r" then return raise_exc(53, "not readable")
  t = fl_txt[id]
  if fl_pos[id] > length(t) then do
    if itermode = 1 then return 0
    return mkstr("")
  end
  p = pos('0a'x, t, fl_pos[id])
  if p = 0 then p = length(t)
  line = substr(t, fl_pos[id], p - fl_pos[id] + 1)
  fl_pos[id] = p + 1
  return mkstr(line)

meth_file: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  id = .int
  l = .int
  v = .int
  s = .string
  it = .int
  n = .int
  line = .string
  e = .int
  id = ob_x[o % 2]
  select
    when nid = 97 then do
      if na \= 1 then return nargs_err("write", na, 1, 1)
      if kind_of(ast[base + 1]) \= 6 then return raise_exc(38, "write() argument must be str, not " || type_name(ast[base + 1]))
      call file_write o, ob_s[ast[base + 1] % 2]
      if unw > 0 then return 0
      return mkint(length(ob_s[ast[base + 1] % 2]))
    end
    when nid = 64 then return file_readline(o, 0)
    when nid = 63 then do
      if ob_c[o % 2] = 1 then return raise_exc(36, "I/O operation on closed file.")
      s = ""
      if id = 3 then do
        do while stdin_eof = 0
          line = ""
          assembler freadline line, h_in
          assembler feof e, h_in
          if e > 0 & length(line) = 0 then do
            stdin_eof = 1
            leave
          end
          s = s || line || '0a'x
        end
        return mkstr(s)
      end
      if fl_mode[id] \== "r" then return raise_exc(53, "not readable")
      s = substr(fl_txt[id], fl_pos[id])
      if na >= 1 then do
        if ast[base + 1] \= 2 then do
          n = ival(ast[base + 1])
          if n >= 0 then s = left(s, n)
        end
      end
      fl_pos[id] = fl_pos[id] + length(s)
      return mkstr(s)
    end
    when nid = 65 then do
      l = mklist(8)
      do forever
        v = file_readline(o, 1)
        if v = 0 then leave
        call list_append l, v
      end
      if unw > 0 then return 0
      return l
    end
    when nid = 98 then do
      it = iter_new(ast[base + 1])
      if it = 0 then return 0
      do forever
        v = iter_next(it)
        if v = 0 then leave
        call file_write o, str_of(v)
        if unw > 0 then return 0
      end
      return 2
    end
    when nid = 10 then do
      call file_close o
      return 2
    end
    when nid = 25 then do
      if id = 1 then call flush_out
      return 2
    end
    when nid = 108 then return o
    when nid = 110 then do
      call file_close o
      return 6
    end
    otherwise nop
  end
  return meth_common(o, nid, base, na, nk)

/* ---------------------------------------------------------------------
   modules
   --------------------------------------------------------------------- */
mod_get: procedure = .int
  arg name = .string
  v = .string
  o = .int
  v = modo[name]
  if v \== "" then return v as .int
  if pos(" " || name || " ", " math random sys time itertools functools collections string copy typing __future__ os ") = 0 then return 0
  o = newobj(18)
  ob_s[o % 2] = name
  modo[name] = o as .string
  return o

/* float value of a numeric argument; raises TypeError otherwise */
mf: procedure = .float
  arg v = .int
  if numkind(v) = 0 then do
    call raise_exc 38, "must be real number, not " || type_name(v)
    return 0.0
  end
  return tofloat(v)

domain_err: procedure = .int
  return raise_exc(36, "math domain error")

rnd_next: procedure = .int
  rnd_s = (rnd_s * 48271) // 2147483647
  return rnd_s

rnd_below: procedure = .int
  arg n = .int
  r = .int
  r = rnd_next()
  if n > 2000000000 then r = r * 2147483647 + rnd_next()
  return r // n

rnd_float: procedure = .float
  a = .int
  b = .int
  a = rnd_next()
  b = rnd_next()
  return ((a * 2147483647 + b) as .float) / 4611686014132420609.0

gcd2: procedure = .int
  arg a = .int, b = .int
  t = .int
  do while b \= 1
    if b = 0 then leave
    t = arith(6, a, b)
    a = b
    b = t
  end
  if numkind(a) = 3 then return a
  return bi_abs(a)

seq_items: procedure = .int
  arg x = .int
  return iter_list(x)

/* itertools.product / permutations / combinations: eager, result is an iterator over a list */
it_combin: procedure = .int
  arg kind = .int, pool = .int, r = .int
  n = .int
  res = .int
  idx = .int[]
  i = .int
  j = .int
  t = .int
  used = .int[]
  k = .int
  n = ob_n[pool % 2]
  res = mklist(16)
  if r > n | r < 0 then return mkiter(1, res, 0)
  if kind = 1 then do
    /* combinations: idx[1..r] hold 0-based positions */
    do i = 1 to r
      idx[i] = i - 1
    end
    do forever
      t = mktuple(r)
      do i = 1 to r
        sl[ob_p[t % 2] + i - 1] = sl[ob_p[pool % 2] + idx[i]]
      end
      call list_append res, t
      i = r
      do while i >= 1 & idx[i] = i - 1 + n - r
        i = i - 1
      end
      if i < 1 then leave
      idx[i] = idx[i] + 1
      do j = i + 1 to r
        idx[j] = idx[j - 1] + 1
      end
    end
    return mkiter(1, res, 0)
  end
  /* permutations: odometer over positions without repetition (lexicographic by index) */
  if r = 0 then do
    call list_append res, mktuple(0)
    return mkiter(1, res, 0)
  end
  do i = 1 to n
    used[i] = 0
  end
  k = 1
  idx[1] = 0
  do while k >= 1
    /* idx[k] is the last index tried at position k (0 = none yet); advance to the next unused one */
    if idx[k] >= 1 then used[idx[k]] = 0
    j = idx[k] + 1
    do while j <= n & used[j] = 1
      j = j + 1
    end
    if j > n then do
      idx[k] = 0
      k = k - 1
      iterate
    end
    idx[k] = j
    used[j] = 1
    if k = r then do
      t = mktuple(r)
      do i = 1 to r
        sl[ob_p[t % 2] + i - 1] = sl[ob_p[pool % 2] + idx[i] - 1]
      end
      call list_append res, t
    end
    else do
      k = k + 1
      idx[k] = 0
    end
  end
  return mkiter(1, res, 0)

it_product: procedure = .int
  arg base = .int, na = .int
  pools = .int
  i = .int
  j = .int
  l = .int
  res = .int
  t = .int
  idx = .int[]
  sz = .int[]
  p = .int
  pools = mklist(na + 1)
  do i = 1 to na
    l = iter_list(ast[base + i])
    if l = 0 then return 0
    call list_append pools, l
    sz[i] = ob_n[l % 2]
    idx[i] = 0
    if sz[i] = 0 then return mkiter(1, mklist(4), 0)
  end
  res = mklist(16)
  do forever
    t = mktuple(na)
    do i = 1 to na
      sl[ob_p[t % 2] + i - 1] = sl[ob_p[sl[ob_p[pools % 2] + i - 1] % 2] + idx[i]]
    end
    call list_append res, t
    p = na
    do while p >= 1
      idx[p] = idx[p] + 1
      if idx[p] < sz[p] then leave
      idx[p] = 0
      p = p - 1
    end
    if p < 1 then leave
  end
  return mkiter(1, res, 0)

deep_copy: procedure = .int
  arg x = .int
  k = .int
  o = .int
  i = .int
  e = .int
  v = .int
  c = .int
  k = kind_of(x)
  if k = 7 | k = 8 then do
    if k = 7 then o = mklist(ob_n[x % 2])
    else o = mktuple(ob_n[x % 2])
    do i = 0 to ob_n[x % 2] - 1
      v = deep_copy(sl[ob_p[x % 2] + i])
      if v = 0 then return 0
      if k = 7 then call list_append o, v
      else sl[ob_p[o % 2] + i] = v
    end
    return o
  end
  if k = 9 | k = 10 then do
    o = dict_new(k)
    ob_y[o % 2] = ob_y[x % 2]
    e = dd_head[ob_x[x % 2]]
    do while e > 0
      if de_live[e] = 1 then do
        v = deep_copy(de_val[e])
        call dict_put ob_x[o % 2], de_hk[e], deep_copy(de_key[e]), v
      end
      e = de_next[e]
    end
    return o
  end
  if k = 17 then do
    c = ob_c[x % 2]
    o = inst_new(c)
    ob_n[o % 2] = ob_n[x % 2]
    ob_p[o % 2] = alloc_slots(ob_n[x % 2])
    do i = 0 to ob_n[x % 2] - 1
      v = sl[ob_p[x % 2] + i]
      if v \= 0 then v = deep_copy(v)
      sl[ob_p[o % 2] + i] = v
    end
    return o
  end
  return x

/* built-in functions of the library modules */
bcall_mod: procedure = .int
  arg bid = .int, base = .int, na = .int, nk = .int
  x = .float
  y = .float
  z = .float
  v = .int
  w = .int
  r = .int
  l = .int
  i = .int
  n = .int
  o = .int
  it = .int
  acc = .int
  f = .int
  s = .string
  a = .int
  b = .int
  st = .int
  if bid <= 83 & na >= 1 then do
    /* functions of one or two floats */
    if bid <= 67 | bid = 66 then do
      x = mf(ast[base + 1])
      if unw > 0 then return 0
      if na >= 2 then do
        y = mf(ast[base + 2])
        if unw > 0 then return 0
      end
    end
  end
  select
    when bid = 47 then do
      if x < 0.0 then return domain_err()
      return mkfloat(rxfloat..sqrt(x))
    end
    when bid = 48 | bid = 49 | bid = 50 then do
      v = ast[base + 1]
      if numkind(v) = 1 | numkind(v) = 2 then return mkint(ival(v))
      if numkind(v) \= 3 then do
        if kind_of(v) = 17 then do
          w = cls_find(ob_c[v % 2], nameid("__floor__"))
          if w > 0 then return call1(w, v)
        end
        return raise_exc(38, "must be real number, not " || type_name(v))
      end
      if x \= x then return raise_exc(36, "cannot convert float NaN to integer")
      if finf(x) \= 0 then return raise_exc(31, "cannot convert float infinity to integer")
      if bid = 48 then return float_to_int(rxfloat..floor(x))
      if bid = 49 then return float_to_int(rxfloat..ceil(x))
      return float_to_int(rxfloat..trunc(x))
    end
    when bid = 51 then return mkfloat(rxfloat..fabs(x))
    when bid = 52 then do
      if x = 0.0 & y < 0.0 then return domain_err()
      if x < 0.0 & y \= rxfloat..floor(y) then return domain_err()
      return mkfloat(rxfloat..pow(x, y))
    end
    when bid = 53 then return mkfloat(rxfloat..sin(x))
    when bid = 54 then return mkfloat(rxfloat..cos(x))
    when bid = 55 then return mkfloat(rxfloat..tan(x))
    when bid = 56 then do
      if x > 1.0 | x < -1.0 then return domain_err()
      return mkfloat(rxfloat..asin(x))
    end
    when bid = 57 then do
      if x > 1.0 | x < -1.0 then return domain_err()
      return mkfloat(rxfloat..acos(x))
    end
    when bid = 58 then return mkfloat(rxfloat..atan(x))
    when bid = 59 then return mkfloat(rxfloat..atan2(x, y))
    when bid = 60 then return mkfloat(rxfloat..sinh(x))
    when bid = 61 then return mkfloat(rxfloat..cosh(x))
    when bid = 67 then return mkfloat(rxfloat..tanh(x))
    when bid = 62 then do
      z = rxfloat..exp(x)
      if finf(z) = 1 & x < 1000000.0 then return raise_exc(31, "math range error")
      return mkfloat(z)
    end
    when bid = 63 | bid = 64 | bid = 65 then do
      if numkind(ast[base + 1]) = 2 then do
        /* huge integers: use the digit count */
        s = ob_s[ast[base + 1] % 2]
        if left(s, 1) == "-" then return domain_err()
        z = rxfloat..log10(parse_flt("0." || s)) + (length(s) as .float)
        if bid = 64 then return mkfloat(z)
        if bid = 65 then return mkfloat(z / rxfloat..log10(2.0))
        z = z * 2.302585092994046
      end
      else do
        if x <= 0.0 then return domain_err()
        if bid = 64 then return mkfloat(rxfloat..log10(x))
        if bid = 65 then return mkfloat(rxfloat..log2(x))
        z = rxfloat..log(x)
      end
      if na >= 2 then do
        if y <= 0.0 then return domain_err()
        z = z / rxfloat..log(y)
      end
      return mkfloat(z)
    end
    when bid = 66 then return mkfloat(rxfloat..hypot(x, y))
    when bid = 68 then do
      x = mf(ast[base + 1])
      if x \= x then return 4
      return 6
    end
    when bid = 69 then do
      x = mf(ast[base + 1])
      if finf(x) \= 0 then return 4
      return 6
    end
    when bid = 70 then do
      x = mf(ast[base + 1])
      if x \= x then return 6
      if finf(x) \= 0 then return 6
      return 4
    end
    when bid = 71 then do
      x = mf(ast[base + 1])
      return mkfloat(x * 180.0 / 3.141592653589793)
    end
    when bid = 72 then do
      x = mf(ast[base + 1])
      return mkfloat(x * 3.141592653589793 / 180.0)
    end
    when bid = 73 then do
      x = mf(ast[base + 1])
      y = mf(ast[base + 2])
      x = rxfloat..fabs(x)
      if y < 0.0 | fl_negzero(y) = 1 then x = 0.0 - x
      return mkfloat(x)
    end
    when bid = 74 then do
      x = mf(ast[base + 1])
      y = mf(ast[base + 2])
      if y = 0.0 then return domain_err()
      return mkfloat(rxfloat..fmod(x, y))
    end
    when bid = 75 then do
      x = mf(ast[base + 1])
      return mkfloat(rxfloat..cbrt(x))
    end
    when bid = 76 then do
      it = iter_new(ast[base + 1])
      if it = 0 then return 0
      z = 0.0
      do forever
        v = iter_next(it)
        if v = 0 then leave
        z = z + mf(v)
      end
      if unw > 0 then return 0
      return mkfloat(z)
    end
    when bid = 77 then do
      it = iter_new(ast[base + 1])
      if it = 0 then return 0
      acc = mkint(1)
      if na >= 2 then acc = ast[base + 2]
      do forever
        v = iter_next(it)
        if v = 0 then leave
        acc = arith(3, acc, v)
        if acc = 0 then return 0
      end
      if unw > 0 then return 0
      return acc
    end
    when bid = 78 | bid = 79 then do
      acc = mkint(0)
      if bid = 79 then acc = mkint(1)
      do i = 1 to na
        v = ast[base + i]
        if numkind(v) \= 1 & numkind(v) \= 2 then return raise_exc(38, "'" || type_name(v) || "' object cannot be interpreted as an integer")
        if bid = 78 then acc = gcd2(acc, v)
        else do
          if num_str(acc) == "0" | num_str(v) == "0" then acc = mkint(0)
          else do
            w = gcd2(acc, v)
            acc = bi_abs(arith(5, arith(3, acc, v), w))
          end
        end
      end
      return acc
    end
    when bid = 80 then do
      v = ast[base + 1]
      if numkind(v) \= 1 then return raise_exc(38, "'" || type_name(v) || "' object cannot be interpreted as an integer")
      n = ival(v)
      if n < 0 then return raise_exc(36, "factorial() not defined for negative values")
      acc = mkint(1)
      do i = 2 to n
        acc = arith(3, acc, mkint(i))
      end
      return acc
    end
    when bid = 81 then do
      v = ast[base + 1]
      if numkind(v) \= 1 & numkind(v) \= 2 then return raise_exc(38, "'" || type_name(v) || "' object cannot be interpreted as an integer")
      if left(num_str(v), 1) == "-" then return raise_exc(36, "isqrt() argument must be nonnegative")
      if numkind(v) = 1 then do
        n = rxfloat..floor(rxfloat..sqrt(ival(v) as .float)) as .int
        do while n * n > ival(v)
          n = n - 1
        end
        do while (n + 1) * (n + 1) <= ival(v)
          n = n + 1
        end
        return mkint(n)
      end
      /* Newton iteration on big integers */
      a = v
      b = arith(5, arith(1, a, mkint(1)), mkint(2))
      do while py_lt(b, a) = 1
        a = b
        b = arith(5, arith(1, a, arith(5, v, a)), mkint(2))
      end
      return a
    end
    when bid = 82 | bid = 83 then do
      if numkind(ast[base + 1]) \= 1 | numkind(ast[base + 2]) \= 1 then return raise_exc(38, "comb() arguments must be integers")
      n = ival(ast[base + 1])
      i = ival(ast[base + 2])
      if n < 0 | i < 0 then return raise_exc(36, "n must be a non-negative integer")
      if i > n then return mkint(0)
      if bid = 82 & i > n - i then i = n - i
      acc = mkint(1)
      do w = 0 to i - 1
        acc = arith(3, acc, mkint(n - w))
        if bid = 82 then acc = arith(5, acc, mkint(w + 1))
      end
      return acc
    end
    when bid = 84 then do
      if na >= 1 & numkind(ast[base + 1]) = 1 then rnd_s = (abs(ival(ast[base + 1])) // 2147483646) + 1
      else if na >= 1 then rnd_s = (strhash(str_of(ast[base + 1])) // 2147483646) + 1
      else rnd_s = (time("US") as .int) // 2147483646 + 1
      return 2
    end
    when bid = 85 then return mkfloat(rnd_float())
    when bid = 86 then do
      if chk_int(ast[base + 1]) = 0 | chk_int(ast[base + 2]) = 0 then return 0
      a = ival(ast[base + 1])
      b = ival(ast[base + 2])
      if b < a then return raise_exc(36, "empty range for randrange() (" || a || ", " || (b + 1) || ", " || (b + 1 - a) || ")")
      return mkint(a + rnd_below(b - a + 1))
    end
    when bid = 87 then do
      if chk_int(ast[base + 1]) = 0 then return 0
      a = 0
      st = 1
      if na = 1 then b = ival(ast[base + 1])
      else do
        a = ival(ast[base + 1])
        b = ival(ast[base + 2])
        if na >= 3 then st = ival(ast[base + 3])
      end
      if st = 0 then return raise_exc(36, "zero step for randrange()")
      if st > 0 then n = (b - a + st - 1) % st
      else n = (a - b - st - 1) % (0 - st)
      if n <= 0 then return raise_exc(36, "empty range in randrange(" || a || ", " || b || ")")
      return mkint(a + st * rnd_below(n))
    end
    when bid = 88 then do
      x = mf(ast[base + 1])
      y = mf(ast[base + 2])
      return mkfloat(x + (y - x) * rnd_float())
    end
    when bid = 89 then do
      l = iter_list(ast[base + 1])
      if l = 0 then return 0
      n = ob_n[l % 2]
      if n = 0 then return raise_exc(34, "Cannot choose from an empty sequence")
      return sl[ob_p[l % 2] + rnd_below(n)]
    end
    when bid = 90 then do
      l = ast[base + 1]
      if kind_of(l) \= 7 then return raise_exc(38, "shuffle() requires a list")
      n = ob_n[l % 2]
      do i = n - 1 to 1 by -1
        w = rnd_below(i + 1)
        v = sl[ob_p[l % 2] + i]
        sl[ob_p[l % 2] + i] = sl[ob_p[l % 2] + w]
        sl[ob_p[l % 2] + w] = v
      end
      return 2
    end
    when bid = 91 then do
      l = iter_list(ast[base + 1])
      if l = 0 then return 0
      if chk_int(ast[base + 2]) = 0 then return 0
      n = ob_n[l % 2]
      b = ival(ast[base + 2])
      if b > n | b < 0 then return raise_exc(36, "Sample larger than population or is negative")
      do i = 0 to b - 1
        w = i + rnd_below(n - i)
        v = sl[ob_p[l % 2] + i]
        sl[ob_p[l % 2] + i] = sl[ob_p[l % 2] + w]
        sl[ob_p[l % 2] + w] = v
      end
      o = mklist(b)
      do i = 0 to b - 1
        call list_append o, sl[ob_p[l % 2] + i]
      end
      return o
    end
    when bid = 92 then do
      z = ((date("UN") as .int) * 86400) as .float
      z = z + ((time("US") as .int) as .float) / 1000000.0
      return mkfloat(z)
    end
    when bid = 93 | bid = 94 | bid = 95 then do
      z = ((time("US") as .int) as .float) / 1000000.0
      return mkfloat(z)
    end
    when bid = 96 then return 2
    when bid = 97 then do
      o = mkiter(15, 0, 0)
      ob_c[o % 2] = tup_from_ast(base + 1, base + na)
      return o
    end
    when bid = 98 then do
      a = 0
      b = 1
      if na >= 1 then a = ival(ast[base + 1])
      if na >= 2 then b = ival(ast[base + 2])
      return mkiter(16, a, b)
    end
    when bid = 99 then do
      it = iter_new(ast[base + 1])
      if it = 0 then return 0
      a = 0
      b = -1
      st = 1
      if na = 2 then do
        if ast[base + 2] \= 2 then b = ival(ast[base + 2])
      end
      else do
        if ast[base + 2] \= 2 then a = ival(ast[base + 2])
        if ast[base + 3] \= 2 then b = ival(ast[base + 3])
        if na >= 4 then st = ival(ast[base + 4])
      end
      o = mkiter(18, it, a)
      ob_p[o % 2] = alloc_slots(3)
      sl[ob_p[o % 2]] = b
      sl[ob_p[o % 2] + 1] = st
      sl[ob_p[o % 2] + 2] = 0
      return o
    end
    when bid = 100 then do
      it = iter_new(ast[base + 2])
      if it = 0 then return 0
      o = mkiter(17, ast[base + 1], it)
      ob_c[o % 2] = 0
      return o
    end
    when bid = 101 then do
      v = kwarg(base, na, nk, "repeat")
      if v \= 0 then do
        l = iter_list(ast[base + 1])
        if l = 0 then return 0
        n = ival(v)
        do i = 2 to n
          ast[base + i] = l
        end
        na = n
        ast[base + 1] = l
      end
      return it_product(base, na)
    end
    when bid = 102 | bid = 103 then do
      l = iter_list(ast[base + 1])
      if l = 0 then return 0
      n = ob_n[l % 2]
      b = n
      if na >= 2 then b = ival(ast[base + 2])
      if bid = 102 then return it_combin(1, l, b)
      return it_combin(2, l, b)
    end
    when bid = 104 then do
      it = iter_new(ast[base + 1])
      if it = 0 then return 0
      o = mklist(8)
      acc = 0
      do forever
        v = iter_next(it)
        if v = 0 then leave
        if acc = 0 then acc = v
        else if na >= 2 then do
          acc = call2(ast[base + 2], acc, v)
          if acc = 0 then return 0
        end
        else do
          acc = arith(1, acc, v)
          if acc = 0 then return 0
        end
        call list_append o, acc
      end
      if unw > 0 then return 0
      return mkiter(1, o, 0)
    end
    when bid = 105 then do
      if na < 2 then return nargs_err("reduce", na, 2, 3)
      it = iter_new(ast[base + 2])
      if it = 0 then return 0
      if na >= 3 then acc = ast[base + 3]
      else do
        acc = iter_next(it)
        if acc = 0 then do
          if unw > 0 then return 0
          return raise_exc(38, "reduce() of empty iterable with no initial value")
        end
      end
      f = ast[base + 1]
      do forever
        v = iter_next(it)
        if v = 0 then leave
        acc = call2(f, acc, v)
        if acc = 0 then return 0
      end
      if unw > 0 then return 0
      return acc
    end
    when bid = 106 then do
      if na \= 2 then return raise_exc(38, "partial() supports one bound argument")
      return mkbmeth(ast[base + 1], ast[base + 2])
    end
    when bid = 107 then do
      o = dict_new(9)
      if na >= 1 then do
        if ast[base + 1] \= 2 then ob_y[o % 2] = ast[base + 1]
      end
      return o
    end
    when bid = 108 then do
      o = dict_new(9)
      if na >= 1 then do
        it = iter_new(ast[base + 1])
        if it = 0 then return 0
        do forever
          v = iter_next(it)
          if v = 0 then leave
          a = dict_find(ob_x[o % 2], hashkey(v))
          if a > 0 then de_val[a] = de_val[a] + 2
          else call dset o, v, 3
        end
        if unw > 0 then return 0
      end
      return o
    end
    when bid = 109 then return ctor_dict(base, na, nk)
    when bid = 110 then do
      if na = 0 then return mklist(4)
      return iter_list(ast[base + 1])
    end
    when bid = 111 then do
      v = ast[base + 1]
      if kind_of(v) = 7 then return iter_list(v)
      if kind_of(v) = 9 then return dict_copy(v)
      if kind_of(v) = 10 then return dict_copy(v)
      if kind_of(v) = 17 then do
        o = deep_copy(v)
        return o
      end
      return v
    end
    when bid = 112 then return deep_copy(ast[base + 1])
    otherwise nop
  end
  return raise_exc(38, "unsupported library function")

/* ---------------------------------------------------------------------
   Formatting: format specs, % operator, str.format
   --------------------------------------------------------------------- */
group3: procedure = .string
  arg d = .string, sep = .string
  r = .string
  n = .int
  i = .int
  n = length(d)
  if n <= 3 then return d
  r = ""
  do i = n to 1 by -3
    if i - 3 >= 1 then r = sep || substr(d, i - 2, 3) || r
    else r = substr(d, 1, i) || r
  end
  return r

radix_str: procedure = .string
  arg s = .string, rdx = .int
  digs = .string
  neg = .int
  r = .string
  q = .string
  d = .int
  n = .int
  v = .int
  digs = "0123456789abcdef"
  neg = 0
  if left(s, 1) == "-" then do
    neg = 1
    s = substr(s, 2)
  end
  if s == "0" then return "0"
  r = ""
  if length(s) <= 18 then do
    v = s as .int
    do while v > 0
      d = v // rdx
      r = substr(digs, d + 1, 1) || r
      v = v % rdx
    end
  end
  else do
    do while s \== "0"
      call mag_divmod s, rdx as .string
      d = brm as .int
      r = substr(digs, d + 1, 1) || r
      s = bq
    end
  end
  if neg = 1 then return "-" || r
  return r

/* pad / align a field.  align: < > ^ = ; numeric parts: sign, prefix, body */
fmt_pad: procedure = .string
  arg sign = .string, body = .string, fill = .string, align = .string, width = .int
  n = .int
  pad = .int
  lp = .int
  s = .string
  s = sign || body
  n = length(s)
  if n >= width then return s
  pad = width - n
  if fill == "" then fill = " "
  if align == "<" then return s || copies(fill, pad)
  if align == "^" then do
    lp = pad % 2
    return copies(fill, lp) || s || copies(fill, pad - lp)
  end
  if align == "=" then return sign || copies(fill, pad) || body
  return copies(fill, pad) || s

format_value: procedure = .string
  arg v = .int, spec = .string
  fill = .string
  align = .string
  sgn = .string
  alt = .int
  zero = .int
  width = .int
  grp = .string
  prec = .int
  ty = .string
  i = .int
  n = .int
  c = .string
  k = .int
  s = .string
  neg = .int
  body = .string
  f = .float
  x = .float
  sign = .string
  m = .int
  r = .int
  pre = .string
  hasprec = .int
  if spec == "" then return str_of(v)
  k = kind_of(v)
  if k = 17 then do
    m = cls_find(ob_c[v % 2], 112)
    if m > 0 then do
      r = call2(m, v, mkstr(spec))
      if r = 0 then return ""
      return ob_s[r % 2]
    end
  end
  fill = ""
  align = ""
  sgn = ""
  alt = 0
  zero = 0
  width = 0
  grp = ""
  prec = -1
  ty = ""
  i = 1
  n = length(spec)
  if n >= 2 & pos(substr(spec, 2, 1), "<>^=") > 0 then do
    fill = substr(spec, 1, 1)
    align = substr(spec, 2, 1)
    i = 3
  end
  else if n >= 1 & pos(substr(spec, 1, 1), "<>^=") > 0 then do
    align = substr(spec, 1, 1)
    i = 2
  end
  c = substr(spec, i, 1)
  if c == "+" | c == "-" | c == " " then do
    sgn = c
    i = i + 1
  end
  if substr(spec, i, 1) == "#" then do
    alt = 1
    i = i + 1
  end
  if substr(spec, i, 1) == "0" then do
    zero = 1
    i = i + 1
  end
  do while i <= n & isdigit(substr(spec, i, 1)) = 1
    width = width * 10 + (substr(spec, i, 1) as .int)
    i = i + 1
  end
  c = substr(spec, i, 1)
  if c == "," | c == "_" then do
    grp = c
    i = i + 1
  end
  if substr(spec, i, 1) == "." then do
    i = i + 1
    prec = 0
    do while i <= n & isdigit(substr(spec, i, 1)) = 1
      prec = prec * 10 + (substr(spec, i, 1) as .int)
      i = i + 1
    end
  end
  if i <= n then ty = substr(spec, i, 1)
  if zero = 1 & align == "" then do
    align = "="
    if fill == "" then fill = "0"
  end
  /* strings */
  if k = 6 | (k \= 5 & numkind(v) = 0) then do
    if k = 6 then s = ob_s[v % 2]
    else s = str_of(v)
    if unw > 0 then return ""
    if ty \== "" & ty \== "s" then do
      call raise_exc 36, "Unknown format code '" || ty || "' for object of type '" || type_name(v) || "'"
      return ""
    end
    if prec >= 0 then s = left(s, prec)
    if align == "" then align = "<"
    return fmt_pad("", s, fill, align, width)
  end
  if align == "" then align = ">"
  /* integers */
  if k \= 5 & (ty == "" | ty == "d" | ty == "n" | ty == "b" | ty == "o" | ty == "x" | ty == "X" | ty == "c") then do
    s = num_str(v)
    if ty == "c" then return fmt_pad("", d2c(ival(v)), fill, align, width)
    neg = 0
    if left(s, 1) == "-" then do
      neg = 1
      s = substr(s, 2)
    end
    pre = ""
    if ty == "b" then do
      s = radix_str(s, 2)
      if alt = 1 then pre = "0b"
    end
    else if ty == "o" then do
      s = radix_str(s, 8)
      if alt = 1 then pre = "0o"
    end
    else if ty == "x" then do
      s = radix_str(s, 16)
      if alt = 1 then pre = "0x"
    end
    else if ty == "X" then do
      s = upper(radix_str(s, 16))
      if alt = 1 then pre = "0X"
    end
    else if grp \== "" then s = group3(s, grp)
    if neg = 1 then sign = "-"
    else if sgn == "+" then sign = "+"
    else if sgn == " " then sign = " "
    else sign = ""
    sign = sign || pre
    return fmt_pad(sign, s, fill, align, width)
  end
  /* floats */
  if numkind(v) = 0 then do
    call raise_exc 36, "Unknown format code '" || ty || "' for object of type '" || type_name(v) || "'"
    return ""
  end
  f = tofloat(v)
  hasprec = 1
  if prec < 0 then do
    prec = 6
    hasprec = 0
  end
  x = f
  neg = 0
  if f < 0.0 then do
    neg = 1
    x = 0.0 - f
  end
  else if f = 0.0 then do
    if fl_negzero(f) = 1 then neg = 1
  end
  if f \= f then body = "nan"
  else if finf(x) = 1 then body = "inf"
  else if ty == "f" | ty == "F" then do
    body = float_fixed(x, prec)
    if grp \== "" then body = group_float(body, grp)
    if alt = 1 & prec = 0 then body = body || "."
  end
  else if ty == "e" | ty == "E" then do
    body = float_sci(x, prec, 0)
    if ty == "E" then body = upper(body)
  end
  else if ty == "%" then do
    body = float_fixed(x * 100.0, prec) || "%"
  end
  else if ty == "g" | ty == "G" | ty == "n" | (ty == "" & hasprec = 1) then do
    body = float_general(x, prec, alt)
    if ty == "G" then body = upper(body)
    if ty == "" & pos(".", body) = 0 & pos("e", body) = 0 & pos("n", body) = 0 then body = body || ".0"
    if grp \== "" then body = group_float(body, grp)
  end
  else do
    /* plain: repr */
    body = float_repr(x)
    if grp \== "" then body = group_float(body, grp)
  end
  if neg = 1 then sign = "-"
  else if sgn == "+" then sign = "+"
  else if sgn == " " then sign = " "
  else sign = ""
  return fmt_pad(sign, body, fill, align, width)

group_float: procedure = .string
  arg s = .string, sep = .string
  p = .int
  p = pos(".", s)
  if p = 0 then return group3(s, sep)
  return group3(left(s, p - 1), sep) || substr(s, p)

/* %g style */
float_general: procedure = .string
  arg x = .float, prec = .int, alt = .int
  d = .string
  e = .int
  l = .int
  body = .string
  es = .string
  ee = .string
  if prec = 0 then prec = 1
  if x = 0.0 then do
    if alt = 1 then return "0." || copies("0", prec - 1)
    return "0"
  end
  d = float_digits(x, prec)
  e = fx_e
  if e < -4 | e >= prec then do
    /* scientific */
    l = length(d)
    if alt = 0 then do
      do while l > 1 & substr(d, l, 1) == "0"
        l = l - 1
      end
      d = left(d, l)
    end
    body = left(d, 1)
    if length(d) > 1 then body = body || "." || substr(d, 2)
    if e < 0 then es = "-"
    else es = "+"
    ee = abs(e) as .string
    if length(ee) < 2 then ee = "0" || ee
    return body || "e" || es || ee
  end
  /* fixed with prec-1-e decimals */
  body = float_fixed(x, prec - 1 - e)
  if alt = 0 & pos(".", body) > 0 then do
    l = length(body)
    do while substr(body, l, 1) == "0"
      l = l - 1
    end
    if substr(body, l, 1) == "." then l = l - 1
    body = left(body, l)
  end
  return body

/* the % operator on strings */
fmt_percent: procedure = .int
  arg fs = .string, args = .int
  r = .string
  i = .int
  n = .int
  c = .string
  argi = .int
  items = .int
  nitems = .int
  v = .int
  flags = .string
  width = .int
  prec = .int
  ty = .string
  key = .string
  p = .int
  spec = .string
  s = .string
  istup = .int
  vv = .int
  left_ = .int
  zero = .int
  plus = .string
  alt = .int
  d = .int
  neg = .int
  body = .string
  sign = .string
  fill = .string
  al_ = .string
  x_ = .float
  istup = 0
  if kind_of(args) = 8 then do
    istup = 1
    items = args
    nitems = ob_n[args % 2]
  end
  else do
    items = 0
    nitems = 1
  end
  argi = 0
  r = ""
  n = length(fs)
  i = 1
  do while i <= n
    p = pos("%", fs, i)
    if p = 0 then do
      r = r || substr(fs, i)
      leave
    end
    r = r || substr(fs, i, p - i)
    i = p + 1
    if i > n then do
      call raise_exc 36, "incomplete format"
      return 0
    end
    key = ""
    if substr(fs, i, 1) == "(" then do
      p = pos(")", fs, i)
      key = substr(fs, i + 1, p - i - 1)
      i = p + 1
    end
    flags = ""
    do while i <= n & pos(substr(fs, i, 1), "-+ #0") > 0
      flags = flags || substr(fs, i, 1)
      i = i + 1
    end
    width = 0
    if substr(fs, i, 1) == "*" then do
      width = ival(sl[ob_p[items % 2] + argi])
      argi = argi + 1
      i = i + 1
    end
    else do
      do while i <= n & isdigit(substr(fs, i, 1)) = 1
        width = width * 10 + (substr(fs, i, 1) as .int)
        i = i + 1
      end
    end
    prec = -1
    if substr(fs, i, 1) == "." then do
      i = i + 1
      prec = 0
      if substr(fs, i, 1) == "*" then do
        prec = ival(sl[ob_p[items % 2] + argi])
        argi = argi + 1
        i = i + 1
      end
      else do
        do while i <= n & isdigit(substr(fs, i, 1)) = 1
          prec = prec * 10 + (substr(fs, i, 1) as .int)
          i = i + 1
        end
      end
    end
    do while i <= n & pos(substr(fs, i, 1), "hlL") > 0
      i = i + 1
    end
    ty = substr(fs, i, 1)
    i = i + 1
    if ty == "%" then do
      r = r || "%"
      iterate
    end
    /* fetch the argument */
    if key \== "" then do
      if kind_of(args) \= 9 then do
        call raise_exc 38, "format requires a mapping"
        return 0
      end
      d = dict_find(ob_x[args % 2], hashkey(mkstr(key)))
      if d = 0 then do
        v = raise_key(mkstr(key))
        return 0
      end
      v = de_val[d]
    end
    else if istup = 1 then do
      if argi >= nitems then do
        call raise_exc 38, "not enough arguments for format string"
        return 0
      end
      v = sl[ob_p[items % 2] + argi]
      argi = argi + 1
    end
    else do
      if argi >= 1 then do
        call raise_exc 38, "not enough arguments for format string"
        return 0
      end
      v = args
      argi = argi + 1
    end
    left_ = 0
    if pos("-", flags) > 0 then left_ = 1
    zero = 0
    if pos("0", flags) > 0 & left_ = 0 then zero = 1
    plus = ""
    if pos("+", flags) > 0 then plus = "+"
    else if pos(" ", flags) > 0 then plus = " "
    alt = 0
    if pos("#", flags) > 0 then alt = 1
    fill = " "
    if ty == "s" | ty == "r" | ty == "a" then do
      if ty == "s" then s = str_of(v)
      else s = repr_of(v)
      if unw > 0 then return 0
      if prec >= 0 then s = left(s, prec)
      if left_ = 1 then al_ = "<"
      else al_ = ">"
      r = r || fmt_pad("", s, " ", al_, width)
    end
    else if ty == "c" then do
      if kind_of(v) = 6 then s = ob_s[v % 2]
      else s = d2c(ival(v))
      r = r || fmt_pad("", s, " ", ">", width)
    end
    else do
      if numkind(v) = 0 then do
        call raise_exc 38, "%" || ty || " format: a real number is required, not " || type_name(v)
        return 0
      end
      if ty == "d" | ty == "i" | ty == "u" then do
        if kind_of(v) = 5 then v = float_to_int(ob_f[v % 2])
        s = num_str(v)
      end
      else if ty == "x" | ty == "X" | ty == "o" then do
        if kind_of(v) = 5 then do
          call raise_exc 38, "%" || ty || " format: an integer is required, not float"
          return 0
        end
        s = num_str(v)
      end
      else s = ""
      neg = 0
      if ty == "d" | ty == "i" | ty == "u" | ty == "x" | ty == "X" | ty == "o" then do
        if left(s, 1) == "-" then do
          neg = 1
          s = substr(s, 2)
        end
        if ty == "x" then do
          s = radix_str(s, 16)
          if alt = 1 then s = "0x" || s
        end
        else if ty == "X" then do
          s = upper(radix_str(s, 16))
          if alt = 1 then s = "0X" || s
        end
        else if ty == "o" then do
          s = radix_str(s, 8)
          if alt = 1 then s = "0o" || s
        end
        if prec >= 0 & length(s) < prec then s = copies("0", prec - length(s)) || s
        body = s
      end
      else do
        x_ = tofloat(v)
        if x_ < 0.0 then do
          neg = 1
          x_ = 0.0 - x_
        end
        else if x_ = 0.0 & fl_negzero(x_) = 1 then neg = 1
        if prec < 0 then prec = 6
        if x_ \= x_ then body = "nan"
        else if finf(x_) = 1 then body = "inf"
        else if ty == "f" | ty == "F" then body = float_fixed(x_, prec)
        else if ty == "e" then body = float_sci(x_, prec, 0)
        else if ty == "E" then body = float_sci(x_, prec, 1)
        else if ty == "g" then body = float_general(x_, prec, alt)
        else if ty == "G" then body = upper(float_general(x_, prec, alt))
        else do
          call raise_exc 36, "unsupported format character '" || ty || "'"
          return 0
        end
      end
      if neg = 1 then sign = "-"
      else sign = plus
      if zero = 1 then al_ = "="
      else if left_ = 1 then al_ = "<"
      else al_ = ">"
      if zero = 1 then fill = "0"
      r = r || fmt_pad(sign, body, fill, al_, width)
    end
  end
  if istup = 1 & argi < nitems then do
    call raise_exc 38, "not all arguments converted during string formatting"
    return 0
  end
  return mkstr(r)

/* str.format(*args, **kwargs): arguments at ast[base+1 ..] */
fmt_format: procedure = .int
  arg fs = .string, base = .int, na = .int, nk = .int
  r = .string
  i = .int
  n = .int
  c = .string
  p = .int
  dep = .int
  field = .string
  conv = .string
  spec = .string
  name = .string
  rest = .string
  v = .int
  auto = .int
  q = .int
  j = .int
  ch = .string
  idx = .int
  a = .int
  attr = .string
  k = .int
  nid = .int
  e = .int
  sp = .string
  r = ""
  n = length(fs)
  i = 1
  auto = 0
  do while i <= n
    c = substr(fs, i, 1)
    if c == "{" then do
      if substr(fs, i + 1, 1) == "{" then do
        r = r || "{"
        i = i + 2
        iterate
      end
      /* find matching brace */
      dep = 1
      p = i + 1
      do while p <= n & dep > 0
        ch = substr(fs, p, 1)
        if ch == "{" then dep = dep + 1
        else if ch == "}" then dep = dep - 1
        if dep > 0 then p = p + 1
      end
      if dep > 0 then do
        call raise_exc 36, "Single '{' encountered in format string"
        return 0
      end
      field = substr(fs, i + 1, p - i - 1)
      i = p + 1
      conv = ""
      spec = ""
      q = pos(":", field)
      if q > 0 then do
        spec = substr(field, q + 1)
        field = left(field, q - 1)
      end
      q = pos("!", field)
      if q > 0 then do
        conv = substr(field, q + 1, 1)
        field = left(field, q - 1)
      end
      /* split name from attribute / index accessors */
      name = field
      rest = ""
      q = verify(field, ".[", "M")
      if q > 0 then do
        name = left(field, q - 1)
        rest = substr(field, q)
      end
      if name == "" then do
        v = arg_at(base, na, nk, auto, "")
        auto = auto + 1
      end
      else if isdigit(left(name, 1)) = 1 then v = arg_at(base, na, nk, name as .int, "")
      else v = arg_at(base, na, nk, -1, name)
      if v = 0 then return 0
      do while rest \== ""
        if left(rest, 1) == "." then do
          q = verify(substr(rest, 2), ".[", "M")
          if q = 0 then do
            attr = substr(rest, 2)
            rest = ""
          end
          else do
            attr = substr(rest, 2, q - 1)
            rest = substr(rest, q + 1)
          end
          v = getattr_obj(v, nameid(attr), 0)
          if v = 0 then return 0
        end
        else do
          q = pos("]", rest)
          attr = substr(rest, 2, q - 2)
          rest = substr(rest, q + 1)
          if isdigit(left(attr, 1)) = 1 then v = getitem(v, mkint(attr as .int))
          else v = getitem(v, mkstr(attr))
          if v = 0 then return 0
        end
      end
      if conv == "r" | conv == "a" then v = mkstr(repr_of(v))
      else if conv == "s" then v = mkstr(str_of(v))
      if pos("{", spec) > 0 then do
        /* nested replacement fields in the spec */
        sp = ob_s[fmt_format(spec, base, na, nk) % 2]
        spec = sp
      end
      r = r || format_value(v, spec)
      if unw > 0 then return 0
      iterate
    end
    if c == "}" then do
      if substr(fs, i + 1, 1) == "}" then i = i + 1
      r = r || "}"
      i = i + 1
      iterate
    end
    r = r || c
    i = i + 1
  end
  return mkstr(r)

/* the idx-th positional argument (or the keyword name) of a format call */
arg_at: procedure = .int
  arg base = .int, na = .int, nk = .int, idx = .int, name = .string
  j = .int
  if idx >= 0 then do
    if idx >= na then do
      call raise_exc 34, "Replacement index " || idx || " out of range for positional args tuple"
      return 0
    end
    return ast[base + 1 + idx]
  end
  do j = 1 to nk
    if asn[base + na + j] == name then return ast[base + na + j]
  end
  return raise_key(mkstr(name))

