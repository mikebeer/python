/* ---------------------------------------------------------------------
   boot: special objects, classes, built-in functions, modules
   --------------------------------------------------------------------- */
fld: procedure = .string
  arg spec = .string, k = .int
  p = .int
  q = .int
  i = .int
  p = 1
  do i = 2 to k
    p = pos("/", spec, p) + 1
  end
  q = pos("/", spec, p)
  if q = 0 then return substr(spec, p)
  return substr(spec, p, q - p)

boot: procedure = .void
  i = .int
  c = .int
  o = .int
  nm = .string
  spec = .string
  w = .string
  p = .int
  l = .int
  t = .int
  /* None, True, False, Ellipsis, NotImplemented are objects 1 to 5 */
  o = newobj(1)
  o = newobj(2)
  o = newobj(2)
  o = newobj(27)
  o = newobj(28)
  do i = 1 to words(nameboot)
    o = nameid(word(nameboot, i))
  end
  do i = 1 to words(clsboot)
    spec = word(clsboot, i)
    c = define_class(fld(spec, 1), fld(spec, 2) as .int)
    cl_flags[c] = fld(spec, 3) as .int
    if fld(spec, 4) == "1" then bimap[fld(spec, 1)] = cl_obj[c] as .string
  end
  range_oop = cl_obj[11]
  do i = 1 to words(bboot)
    nm = word(bboot, i)
    p = lastpos(".", nm)
    bi_name[i] = substr(nm, p + 1)
    o = newobj(13)
    ob_x[o % 2] = i
    bi_oop[i] = o
    if p > 0 then modattr[nm] = o as .string
    else if left(nm, 1) \== "_" | nm == "__import__" | nm == "_sock" then bimap[nm] = o as .string
  end
  do i = 1 to words(aliasboot)
    spec = word(aliasboot, i)
    p = pos("=", spec)
    modattr[left(spec, p - 1)] = bi_oop[substr(spec, p + 1) as .int] as .string
  end
  identity_oop = bi_oop[50]
  /* kind -> class */
  kcls[1] = 12
  kcls[2] = 5
  kcls[3] = 3
  kcls[4] = 3
  kcls[5] = 4
  kcls[6] = 6
  kcls[7] = 7
  kcls[8] = 8
  kcls[9] = 9
  kcls[10] = 10
  kcls[11] = 11
  kcls[12] = 13
  kcls[13] = 14
  kcls[14] = 15
  kcls[15] = 14
  kcls[16] = 2
  kcls[18] = 18
  kcls[19] = 16
  kcls[20] = 17
  kcls[21] = 19
  kcls[22] = 22
  kcls[23] = 23
  kcls[24] = 24
  kcls[25] = 25
  kcls[26] = 26
  kcls[27] = 20
  kcls[28] = 21
  kcls[29] = 95
  kcls[31] = 83
  kcls[32] = 85
  np_nidT = nameid("T")
  modattr["numpy.pi"] = mkfloat(parse_flt("3.141592653589793")) as .string
  modattr["numpy.e"] = mkfloat(parse_flt("2.718281828459045")) as .string
  modattr["numpy.inf"] = mkfloat(f_inf()) as .string
  modattr["numpy.nan"] = mkfloat(f_nan()) as .string
  modattr["numpy.newaxis"] = 2 as .string
  modattr["numpy.float64"] = cl_obj[4] as .string
  modattr["numpy.float32"] = cl_obj[4] as .string
  modattr["numpy.int64"] = cl_obj[3] as .string
  modattr["numpy.int32"] = cl_obj[3] as .string
  modattr["numpy.bool_"] = cl_obj[5] as .string
  modattr["numpy.ndarray"] = cl_obj[95] as .string
  /* operator method names */
  w = "add sub mul truediv floordiv mod pow lshift rshift and or xor matmul"
  do i = 1 to 13
    opd[i] = nameid("__" || word(w, i) || "__")
    ropd[i] = nameid("__r" || word(w, i) || "__")
    iopd[i] = nameid("__i" || word(w, i) || "__")
  end
  cmpd[3] = nameid("__lt__")
  cmpd[4] = nameid("__le__")
  cmpd[5] = nameid("__gt__")
  cmpd[6] = nameid("__ge__")
  cmpr[3] = nameid("__gt__")
  cmpr[4] = nameid("__ge__")
  cmpr[5] = nameid("__lt__")
  cmpr[6] = nameid("__le__")
  call cls_set 27, 160, bi_oop[48]
  call cls_set 1, 160, bi_oop[49]
  /* module constants */
  modattr["math.pi"] = mkfloat(parse_flt("3.141592653589793")) as .string
  modattr["math.e"] = mkfloat(parse_flt("2.718281828459045")) as .string
  modattr["math.tau"] = mkfloat(parse_flt("6.283185307179586")) as .string
  modattr["math.inf"] = mkfloat(f_inf()) as .string
  modattr["math.nan"] = mkfloat(f_nan()) as .string
  modattr["sys.maxsize"] = mkbig("9223372036854775807") as .string
  modattr["sys.version"] = mkstr("3.12.0 (crexx)") as .string
  modattr["sys.platform"] = mkstr("linux") as .string
  modattr["sys.stdout"] = mk_file(1, "<stdout>") as .string
  modattr["sys.stderr"] = mk_file(2, "<stderr>") as .string
  modattr["sys.stdin"] = mk_file(3, "<stdin>") as .string
  l = mklist(nsargs + 1)
  if nsargs = 0 then call list_append l, mkstr("")
  do i = 1 to nsargs
    if i = 1 & sargs[1] == "-c" then call list_append l, mkstr("-c")
    else call list_append l, mkstr(sargs[i])
  end
  modattr["sys.argv"] = l as .string
  modattr["string.ascii_lowercase"] = mkstr("abcdefghijklmnopqrstuvwxyz") as .string
  modattr["string.ascii_uppercase"] = mkstr("ABCDEFGHIJKLMNOPQRSTUVWXYZ") as .string
  modattr["string.ascii_letters"] = mkstr("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ") as .string
  modattr["string.digits"] = mkstr("0123456789") as .string
  modattr["string.hexdigits"] = mkstr("0123456789abcdefABCDEF") as .string
  modattr["string.octdigits"] = mkstr("01234567") as .string
  modattr["string.punctuation"] = mkstr("!" || '"' || "#$%&'()*+,-./:;<=>?@[" || "\" || "]^_`{|}~") as .string
  modattr["string.whitespace"] = mkstr(" " || '090a0d0b0c'x) as .string
  modattr["os.sep"] = mkstr("/") as .string
  modattr["os.linesep"] = mkstr('0a'x) as .string
  modattr["os.name"] = mkstr("posix") as .string
  sys_modules = dict_new(9)
  modattr["sys.modules"] = sys_modules as .string
  call setup_path
  modattr["os.path"] = native_mod("os.path") as .string
  modattr["numpy.linalg"] = native_mod("numpy.linalg") as .string
  modattr["numpy.random"] = native_mod("numpy.random") as .string
  modattr["abc.ABC"] = cl_obj[59] as .string
  modattr["abc.ABCMeta"] = cl_obj[59] as .string
  bimap["IOError"] = cl_obj[53] as .string
  bimap["EnvironmentError"] = cl_obj[53] as .string
  bimap["NotImplemented"] = 10 as .string
  bimap["Ellipsis"] = 8 as .string
  bimap["frozenset"] = cl_obj[10] as .string
  return

/* ---------------------------------------------------------------------
   Lexer: Python source -> token arrays (with NEWLINE / INDENT / DEDENT)
   --------------------------------------------------------------------- */
isletter: procedure = .int
  arg c = .string
  if c == "" then return 0
  if c >>= "a" & c <<= "z" then return 1
  if c >>= "A" & c <<= "Z" then return 1
  if c == "_" then return 1
  if c2d(c) >= 128 then return 1
  return 0

isdigit: procedure = .int
  arg c = .string
  if c == "" then return 0
  if c >>= "0" & c <<= "9" then return 1
  return 0

addtok: procedure = .void
  arg t = .int, s = .string, i = .int
  ntk = ntk + 1
  tk_t[ntk] = t
  tk_s[ntk] = s
  tk_i[ntk] = i
  tk_l[ntk] = lnum
  return

/* process backslash escapes of a (non raw) string body */
unescape: procedure = .string
  arg raw = .string
  r = .string
  p = .int
  q = .int
  c = .string
  v = .int
  n = .int
  if pos("\", raw) = 0 then return raw
  r = ""
  p = 1
  n = length(raw)
  do while p <= n
    q = pos("\", raw, p)
    if q = 0 then do
      r = r || substr(raw, p)
      leave
    end
    r = r || substr(raw, p, q - p)
    c = substr(raw, q + 1, 1)
    p = q + 2
    select
      when c == "n" then r = r || '0a'x
      when c == "t" then r = r || '09'x
      when c == "r" then r = r || '0d'x
      when c == "0" then r = r || '00'x
      when c == "a" then r = r || '07'x
      when c == "b" then r = r || '08'x
      when c == "f" then r = r || '0c'x
      when c == "v" then r = r || '0b'x
      when c == '0a'x then nop
      when c == "x" then do
        v = x2d(substr(raw, p, 2))
        r = r || utf8_chr(v)
        p = p + 2
      end
      when c == "u" then do
        v = x2d(substr(raw, p, 4))
        r = r || utf8_chr(v)
        p = p + 4
      end
      when c == "U" then do
        v = x2d(substr(raw, p, 8))
        r = r || utf8_chr(v)
        p = p + 8
      end
      when c == "" then r = r || "\"
      when c == "\" | c == "'" | c == '"' then r = r || c
      otherwise r = r || "\" || c
    end
  end
  return r

utf8_chr: procedure = .string
  arg v = .int
  return d2c(v)

/* lex the text src into tokens appended to the token arrays.
   sub = 1: a fragment (no indentation processing) */
lex_text: procedure = .void
  arg src = .string, sub = .int
  sv_tx = .string
  sv_tlen = .int
  sv_tp = .int
  sv_brk = .int
  sv_nind = .int
  sv_line = .int
  atbol = .int
  col = .int
  q = .int
  q2 = .int
  c = .string
  d = .string
  s = .string
  id = .string
  body = .string
  isf = .int
  isr = .int
  isb = .int
  trip = .int
  p = .int
  endp = .int
  quote = .string
  nflag = .int
  v = .int
  radix = .int
  fr = .string
  ex = .string
  dg = .string
  neg = .int
  w = .int
  ok = .int
  op = .string
  lastt = .int
  sv_tx = tx
  sv_tlen = tlen
  sv_tp = tp
  sv_brk = lx_brk
  sv_nind = lx_nind
  sv_line = lnum
  tx = src
  tlen = length(tx)
  tp = 1
  lx_brk = 0
  lx_nind = 1
  ind_s[1] = 0
  if sub = 1 then atbol = 0
  else atbol = 1
  if sub = 0 then lnum = 1
  do forever
    if atbol = 1 & lx_brk = 0 then do
      col = 0
      q = tp
      do while q <= tlen
        c = substr(tx, q, 1)
        if c == " " then col = col + 1
        else if c == '09'x then col = col + 8 - (col // 8)
        else if c == '0c'x then col = 0
        else leave
        q = q + 1
      end
      if q > tlen then do
        tp = q
        leave
      end
      c = substr(tx, q, 1)
      if c == '0a'x then do
        tp = q + 1
        lnum = lnum + 1
        iterate
      end
      if c == "#" then do
        q2 = pos('0a'x, tx, q)
        if q2 = 0 then do
          tp = tlen + 1
          leave
        end
        tp = q2 + 1
        lnum = lnum + 1
        iterate
      end
      tp = q
      if col > ind_s[lx_nind] then do
        lx_nind = lx_nind + 1
        ind_s[lx_nind] = col
        call addtok 2, "", 0
      end
      else if col < ind_s[lx_nind] then do
        do while col < ind_s[lx_nind]
          lx_nind = lx_nind - 1
          call addtok 3, "", 0
        end
      end
      atbol = 0
    end
    if tp > tlen then leave
    c = substr(tx, tp, 1)
    if c == " " | c == '09'x | c == '0c'x then do
      tp = tp + 1
      iterate
    end
    if c == '0a'x then do
      tp = tp + 1
      if lx_brk = 0 then do
        if ntk > 0 then do
          if tk_t[ntk] \= 1 & sub = 0 then call addtok 1, "", 0
        end
        atbol = 1
      end
      lnum = lnum + 1
      iterate
    end
    if c == "#" then do
      q2 = pos('0a'x, tx, tp)
      if q2 = 0 then tp = tlen + 1
      else tp = q2
      iterate
    end
    if c == "\" then do
      if substr(tx, tp + 1, 1) == '0a'x then do
        tp = tp + 2
        lnum = lnum + 1
        iterate
      end
      tp = tp + 1
      iterate
    end
    d = substr(tx, tp + 1, 1)
    /* ---- identifiers, keywords, string prefixes ---- */
    if isletter(c) = 1 then do
      q = tp
      do while q <= tlen
        d = substr(tx, q, 1)
        if isletter(d) = 1 | isdigit(d) = 1 then q = q + 1
        else leave
      end
      id = substr(tx, tp, q - tp)
      d = substr(tx, q, 1)
      if (d == '"' | d == "'") & length(id) <= 2 then do
        s = lower(id)
        if s == "r" | s == "b" | s == "f" | s == "u" | s == "rb" | s == "br" | s == "fr" | s == "rf" then do
          isr = 0
          isb = 0
          isf = 0
          if pos("r", s) > 0 then isr = 1
          if pos("b", s) > 0 then isb = 1
          if pos("f", s) > 0 then isf = 1
          tp = q
          call lex_string isr, isf, isb
          iterate
        end
      end
      tp = q
      if pos(" " || id || " ", kwlist) > 0 then call addtok 10, id, 0
      else call addtok 4, id, 0
      iterate
    end
    /* ---- numbers ---- */
    if isdigit(c) = 1 | (c == "." & isdigit(d) = 1) then do
      call lex_number
      iterate
    end
    /* ---- strings ---- */
    if c == '"' | c == "'" then do
      call lex_string 0, 0, 0
      iterate
    end
    /* ---- operators ---- */
    op = substr(tx, tp, 3)
    if op == "**=" | op == "//=" | op == ">>=" | op == "<<=" | op == "..." then do
      call addtok 9, op, 0
      tp = tp + 3
      iterate
    end
    op = substr(tx, tp, 2)
    if pos(" " || op || " ", ops2) > 0 then do
      call addtok 9, op, 0
      tp = tp + 2
      iterate
    end
    if pos(c, "([{") > 0 then lx_brk = lx_brk + 1
    if pos(c, ")]}") > 0 then do
      if lx_brk > 0 then lx_brk = lx_brk - 1
    end
    call addtok 9, c, 0
    tp = tp + 1
  end
  if sub = 0 then do
    if ntk > 0 then do
      if tk_t[ntk] \= 1 & tk_t[ntk] \= 3 & tk_t[ntk] \= 2 then call addtok 1, "", 0
    end
    do while lx_nind > 1
      lx_nind = lx_nind - 1
      call addtok 3, "", 0
    end
  end
  call addtok 0, "", 0
  tx = sv_tx
  tlen = sv_tlen
  tp = sv_tp
  lx_brk = sv_brk
  lx_nind = sv_nind
  if sub = 1 then lnum = sv_line
  return

/* string literal at tx[tp] (the quote); prefix flags raw / f / bytes */
lex_string: procedure = .void
  arg isr = .int, isf = .int, isb = .int
  quote = .string
  trip = .int
  q = .int
  p = .int
  body = .string
  c = .string
  n = .int
  endp = .int
  depth = .int
  k = .int
  quote = substr(tx, tp, 1)
  trip = 0
  if substr(tx, tp + 1, 2) == quote || quote then do
    trip = 1
    q = tp + 3
  end
  else q = tp + 1
  p = q
  endp = 0
  depth = 0
  do while p <= tlen
    c = substr(tx, p, 1)
    if c == "\" then do
      p = p + 2
      iterate
    end
    if isf = 1 & trip = 0 then do
      if c == "{" then do
        if depth = 0 & substr(tx, p + 1, 1) == "{" then do
          p = p + 2
          iterate
        end
        depth = depth + 1
      end
      else if c == "}" then do
        if depth > 0 then depth = depth - 1
        else if substr(tx, p + 1, 1) == "}" then do
          p = p + 2
          iterate
        end
      end
      else if c == quote & depth > 0 then do
        k = pos(quote, tx, p + 1)
        if k > 0 then do
          p = k + 1
          iterate
        end
      end
    end
    if c == quote then do
      if trip = 0 then do
        endp = p
        leave
      end
      if substr(tx, p + 1, 2) == quote || quote then do
        endp = p
        leave
      end
    end
    if c == '0a'x & trip = 0 then leave
    p = p + 1
  end
  if endp = 0 then do
    call perr "EOL while scanning string literal"
    tp = tlen + 1
    return
  end
  body = substr(tx, q, endp - q)
  n = 0
  q = pos('0a'x, body)
  do while q > 0
    n = n + 1
    q = pos('0a'x, body, q + 1)
  end
  if trip = 1 then tp = endp + 3
  else tp = endp + 1
  if isf = 1 then do
    if isr = 1 then call addtok 8, body, 3
    else call addtok 8, body, 1
  end
  else if isb = 1 then do
    if isr = 1 then call addtok 8, body, 4
    else call addtok 8, unescape(body), 4
  end
  else if isr = 1 then call addtok 8, body, 0
  else call addtok 8, unescape(body), 0
  lnum = lnum + n
  return

lex_number: procedure = .void
  isj = .int
  q = .int
  p = .int
  c = .string
  d = .string
  dg = .string
  fr = .string
  ex = .string
  isf = .int
  v = .int
  radix = .int
  neg = .int
  nd = .int
  s = .string
  big = .string
  q = tp
  c = substr(tx, tp, 1)
  d = lower(substr(tx, tp + 1, 1))
  if c == "0" & (d == "x" | d == "o" | d == "b") then do
    if d == "x" then radix = 16
    else if d == "o" then radix = 8
    else radix = 2
    q = tp + 2
    s = ""
    do while q <= tlen
      c = lower(substr(tx, q, 1))
      if c == "_" then do
        q = q + 1
        iterate
      end
      if isdigit(c) = 1 then nd = c as .int
      else if c >>= "a" & c <<= "f" then nd = c2d(c) - 87
      else leave
      if nd >= radix then leave
      s = s || c
      q = q + 1
    end
    tp = q
    if s == "" then s = "0"
    if length(s) <= 15 & radix = 16 then call addtok 5, "", x2d(s)
    else do
      /* general: accumulate in a decimal string */
      big = "0"
      do p = 1 to length(s)
        c = substr(s, p, 1)
        if isdigit(c) = 1 then nd = c as .int
        else nd = c2d(c) - 87
        big = sadd(smul(big, radix as .string), nd as .string)
      end
      call tok_bigint big
    end
    return
  end
  dg = ""
  do while q <= tlen
    c = substr(tx, q, 1)
    if isdigit(c) = 1 then dg = dg || c
    else if c \== "_" then leave
    q = q + 1
  end
  fr = ""
  isf = 0
  if substr(tx, q, 1) == "." then do
    isf = 1
    q = q + 1
    do while q <= tlen
      c = substr(tx, q, 1)
      if isdigit(c) = 1 then fr = fr || c
      else if c \== "_" then leave
      q = q + 1
    end
  end
  ex = ""
  c = substr(tx, q, 1)
  if c == "e" | c == "E" then do
    p = q + 1
    neg = 0
    if substr(tx, p, 1) == "-" then do
      neg = 1
      p = p + 1
    end
    else if substr(tx, p, 1) == "+" then p = p + 1
    if isdigit(substr(tx, p, 1)) = 1 then do
      v = p
      do while v <= tlen & isdigit(substr(tx, v, 1)) = 1
        v = v + 1
      end
      ex = substr(tx, p, v - p)
      if neg = 1 then ex = "-" || ex
      isf = 1
      q = v
    end
  end
  isj = 0
  if substr(tx, q, 1) == "j" | substr(tx, q, 1) == "J" then do
    isj = 1
    q = q + 1
  end
  tp = q
  if isf = 1 | isj = 1 then do
    if dg == "" then dg = "0"
    if fr == "" then fr = "0"
    s = dg || "." || fr
    if ex \== "" then s = s || "e" || ex
    ntk = ntk + 1
    tk_t[ntk] = 7
    tk_s[ntk] = s
    tk_i[ntk] = isj
    tk_l[ntk] = lnum
    tk_f[ntk] = parse_flt(s)
    return
  end
  if length(dg) > 18 then call tok_bigint dg
  else call addtok 5, "", dg as .int
  return

tok_bigint: procedure = .void
  arg s = .string
  if length(s) <= 18 then call addtok 5, "", mag_clean(s) as .int
  else call addtok 6, mag_clean(s), 0
  return

/* ---------------------------------------------------------------------
   Parser: tokens -> node arrays, with scope resolution
   --------------------------------------------------------------------- */
perr: procedure = .void
  arg msg = .string
  if pe = 0 then do
    pe = 1
    pe_msg = "SyntaxError: " || msg || " (line " || tk_l[tpp] || ")"
  end
  tpp = ntk
  return

mk: procedure = .int
  arg t = .int, a = .int, b = .int, c = .int
  nnode = nnode + 1
  n_t[nnode] = t
  n_a[nnode] = a
  n_b[nnode] = b
  n_c[nnode] = c
  n_d[nnode] = 0
  n_y[nnode] = 0
  n_s[nnode] = ""
  n_ln[nnode] = tk_l[tpp]
  n_ic[nnode] = 0
  n_ig[nnode] = 0
  n_iv[nnode] = 0
  return nnode

mkc: procedure = .int
  arg oop = .int
  return mk(14, oop, 0, 0)

at: procedure = .int
  arg s = .string
  if tk_s[tpp] \== s then return 0
  if tk_t[tpp] = 9 | tk_t[tpp] = 10 then return 1
  return 0

atnext: procedure = .int
  arg s = .string
  if tk_s[tpp + 1] \== s then return 0
  if tk_t[tpp + 1] = 9 | tk_t[tpp + 1] = 10 then return 1
  return 0

accept: procedure = .int
  arg s = .string
  if at(s) = 1 then do
    tpp = tpp + 1
    return 1
  end
  return 0

expect: procedure = .void
  arg s = .string
  if at(s) = 1 then tpp = tpp + 1
  else call perr "expected '" || s || "'"
  return

expect_name: procedure = .string
  r = .string
  if tk_t[tpp] = 4 then do
    r = tk_s[tpp]
    tpp = tpp + 1
    return r
  end
  call perr "expected a name"
  return "?"

/* list of node ids pushed on ps since base -> al; returns al start */
plist: procedure = .int
  arg base = .int
  st = .int
  i = .int
  st = nal + 1
  do i = base + 1 to psp
    nal = nal + 1
    al[nal] = ps[i]
  end
  psp = base
  return st

/* ---- scopes ---- */
scope_push: procedure = .int
  arg kind = .int
  s = .int
  nsc = nsc + 1
  s = nsc
  sc_kind[s] = kind
  sc_par[s] = cursc
  sc_n[s] = 2
  sc_fl[s] = 0
  sc_id[s] = 0
  sc_rf0[s] = nrf + 1
  sc_cd[s] = 0
  if cursc > 0 then do
    sc_cd[s] = sc_cd[cursc]
    if sc_kind[cursc] = 3 then sc_cd[s] = sc_id[cursc]
  end
  cursc = s
  return s

/* bind a name in the current scope: returns its slot (0 if declared global/nonlocal) */
bind_name: procedure = .int
  arg name = .string
  key = .string
  v = .string
  sl0 = .int
  key = cursc || "|" || name
  v = scm[key]
  if v == "" then do
    sl0 = sc_n[cursc]
    sc_n[cursc] = sl0 + 1
    scm[key] = sl0 as .string
    nbn = nbn + 1
    bn_sc[nbn] = cursc
    bn_name[nbn] = name
    bn_slot[nbn] = sl0
    if sc_kind[cursc] = 3 then do
      ncv = ncv + 1
      cv_name[ncv] = name
      cv_slot[ncv] = sl0
      cv_scope[ncv] = cursc
    end
    return sl0
  end
  return v as .int

mkname: procedure = .int
  arg name = .string
  n = .int
  n = mk(36, 0, 0, 0)
  n_s[n] = name
  nrf = nrf + 1
  rf_node[nrf] = n
  rf_sc[nrf] = cursc
  rf_dep[nrf] = 0
  return n

/* mark all enclosing function scopes as having inner scopes (frames stay alive) */
mark_closure: procedure = .void
  s = .int
  s = cursc
  do while s > 0
    if (sc_fl[s] // 4) < 2 then sc_fl[s] = sc_fl[s] + 2
    s = sc_par[s]
  end
  return

builtin_lookup: procedure = .int
  arg name = .string
  v = .string
  v = bimap[name]
  if v == "" then return 0
  return v as .int

/* resolve all pending references of scope sc (called when the scope ends) */
scope_end: procedure = .void
  arg sc = .int
  r = .int
  n = .int
  name = .string
  v = .string
  slot = .int
  par = .int
  b = .int
  do r = sc_rf0[sc] to nrf
    if rf_sc[r] = sc then do
      n = rf_node[r]
      name = n_s[n]
      v = scm[sc || "|" || name]
      slot = 0
      if v \== "" then slot = v as .int
      if sc_kind[sc] = 3 & rf_dep[r] > 0 then slot = 0
      if sc_kind[sc] = 1 then do
        /* module scope: global slot, builtin, or error */
        if slot > 0 then do
          n_t[n] = 27
          n_a[n] = slot
        end
        else do
          b = builtin_lookup(name)
          if parse_dyn = 1 then do
            slot = sc_n[sc]
            sc_n[sc] = slot + 1
            scm[sc || "|" || name] = slot as .string
            nbn = nbn + 1
            bn_sc[nbn] = sc
            bn_name[nbn] = name
            bn_slot[nbn] = slot
            n_t[n] = 27
            n_a[n] = slot
            if b > 0 then do
              ndyn = ndyn + 1
              dyn_mi[ndyn] = parse_mi
              dyn_slot[ndyn] = slot
              dyn_val[ndyn] = b
            end
          end
          else if b > 0 then do
            n_t[n] = 14
            n_a[n] = b
          end
          else n_t[n] = 37
        end
        rf_sc[r] = 0
      end
      else if slot = -1 then do
        /* declared global: module slot (create when needed) */
        v = scm[cur_msc || "|" || name]
        if v == "" then do
          slot = sc_n[cur_msc]
          sc_n[cur_msc] = slot + 1
          scm[cur_msc || "|" || name] = slot as .string
          nbn = nbn + 1
          bn_sc[nbn] = cur_msc
          bn_name[nbn] = name
          bn_slot[nbn] = slot
        end
        else slot = v as .int
        n_t[n] = 27
        n_a[n] = slot
        rf_sc[r] = 0
      end
      else if slot > 0 then do
        if rf_dep[r] = 0 then do
          n_t[n] = 34
          n_a[n] = slot
        end
        else do
          n_t[n] = 52
          n_a[n] = slot
          n_b[n] = rf_dep[r]
        end
        rf_sc[r] = 0
      end
      else do
        /* not local: look in the enclosing scope */
        rf_sc[r] = sc_par[sc]
        rf_dep[r] = rf_dep[r] + 1
      end
    end
  end
  cursc = sc_par[sc]
  return

/* ---- expressions ---- */
p_test: procedure = .int
  c = .int
  e = .int
  f = .int
  if at("lambda") = 1 then return p_lambda()
  e = p_or()
  if at("if") = 1 then do
    tpp = tpp + 1
    c = p_or()
    call expect "else"
    f = p_test()
    return mk(30, c, e, f)
  end
  return e

p_or: procedure = .int
  l = .int
  r = .int
  l = p_and()
  do while at("or") = 1
    tpp = tpp + 1
    r = p_and()
    l = mk(39, l, r, 0)
  end
  return l

p_and: procedure = .int
  l = .int
  r = .int
  l = p_not()
  do while at("and") = 1
    tpp = tpp + 1
    r = p_not()
    l = mk(1, l, r, 0)
  end
  return l

p_not: procedure = .int
  x = .int
  if at("not") = 1 then do
    tpp = tpp + 1
    x = p_not()
    return mk(38, x, 0, 0)
  end
  return p_cmp()

cmp_op: procedure = .int
  t = .int
  s = .string
  t = tk_t[tpp]
  s = tk_s[tpp]
  if t = 9 then do
    if s == "==" then return 1
    if s == "!=" then return 2
    if s == "<" then return 3
    if s == "<=" then return 4
    if s == ">" then return 5
    if s == ">=" then return 6
    return 0
  end
  if t = 10 then do
    if s == "in" then return 7
    if s == "is" then do
      if tk_s[tpp + 1] == "not" & tk_t[tpp + 1] = 10 then return 10
      return 9
    end
    if s == "not" then do
      if tk_s[tpp + 1] == "in" & tk_t[tpp + 1] = 10 then return 8
    end
  end
  return 0

p_cmp: procedure = .int
  l = .int
  r = .int
  op = .int
  base = .int
  cnt = .int
  st = .int
  k = .int
  n = .int
  l = p_bin(1)
  op = cmp_op()
  if op = 0 then return l
  base = psp
  psp = psp + 1
  ps[psp] = l
  cnt = 1
  do while op > 0
    if op = 10 | op = 8 then tpp = tpp + 2
    else tpp = tpp + 1
    r = p_bin(1)
    cnt = cnt + 1
    psp = psp + 1
    ps[psp] = r
    psp = psp + 1
    ps[psp] = op
    op = cmp_op()
  end
  /* ps: l, r1, op1, r2, op2 ... -> operands then ops */
  if cnt = 2 then do
    n = mk(11, ps[base + 1], ps[base + 2], ps[base + 3])
    psp = base
    return n
  end
  st = nal + 1
  nal = nal + 1
  al[nal] = ps[base + 1]
  do k = 1 to cnt - 1
    nal = nal + 1
    al[nal] = ps[base + 1 + k * 2 - 1]
  end
  do k = 1 to cnt - 1
    nal = nal + 1
    al[nal] = ps[base + 1 + k * 2]
  end
  psp = base
  return mk(9, st, cnt, 0)

bin_op: procedure = .int
  arg lvl = .int
  s = .string
  if tk_t[tpp] \= 9 then return 0
  s = tk_s[tpp]
  select
    when lvl = 1 then do
      if s == "|" then return 11
    end
    when lvl = 2 then do
      if s == "^" then return 12
    end
    when lvl = 3 then do
      if s == "&" then return 10
    end
    when lvl = 4 then do
      if s == "<<" then return 8
      if s == ">>" then return 9
    end
    when lvl = 5 then do
      if s == "+" then return 1
      if s == "-" then return 2
    end
    otherwise do
      if s == "*" then return 3
      if s == "/" then return 4
      if s == "//" then return 5
      if s == "%" then return 6
      if s == "@" then return 13
    end
  end
  return 0

p_bin: procedure = .int
  arg lvl = .int
  l = .int
  r = .int
  op = .int
  if lvl > 6 then return p_factor()
  l = p_bin(lvl + 1)
  do forever
    op = bin_op(lvl)
    if op = 0 then leave
    tpp = tpp + 1
    r = p_bin(lvl + 1)
    l = mk(6, l, r, op)
  end
  return l

p_factor: procedure = .int
  x = .int
  v = .int
  f = .float
  if at("-") = 1 then do
    tpp = tpp + 1
    x = p_factor()
    if n_t[x] = 14 & n_a[x] // 2 \= 0 then do
      n_a[x] = 1 - (n_a[x] - 1)
      return x
    end
    if n_t[x] = 14 & n_a[x] // 2 = 0 then do
      if ob_k[n_a[x] % 2] = 5 then do
        f = ob_f[n_a[x] % 2]
        return mkc(mkfloat(fneg(f)))
      end
    end
    return mk(51, x, 0, 1)
  end
  if at("+") = 1 then do
    tpp = tpp + 1
    x = p_factor()
    return mk(51, x, 0, 2)
  end
  if at("~") = 1 then do
    tpp = tpp + 1
    x = p_factor()
    return mk(51, x, 0, 3)
  end
  return p_power()

p_power: procedure = .int
  b = .int
  e = .int
  b = p_atomexpr()
  if at("**") = 1 then do
    tpp = tpp + 1
    e = p_factor()
    return mk(6, b, e, 7)
  end
  return b

/* does the bracketed construct starting at tpp contain a 'for' at depth 0 ? */
has_for: procedure = .int
  i = .int
  dep = .int
  i = tpp
  dep = 0
  do forever
    if tk_t[i] = 0 then return 0
    if tk_t[i] = 9 then do
      if pos(tk_s[i], "([{") > 0 & length(tk_s[i]) = 1 then dep = dep + 1
      else if pos(tk_s[i], ")]}") > 0 & length(tk_s[i]) = 1 then do
        dep = dep - 1
        if dep < 0 then return 0
      end
      else if dep = 0 & tk_s[i] == "," then return 0
    end
    else if tk_t[i] = 10 & dep = 0 then do
      if tk_s[i] == "for" then return 1
    end
    i = i + 1
  end
  return 0

p_atomexpr: procedure = .int
  e = .int
  e = p_atom()
  do forever
    if at("(") = 1 then e = p_call(e)
    else if at("[") = 1 then e = p_subscript(e)
    else if at(".") = 1 then do
      tpp = tpp + 1
      e = mk(4, e, 0, 0)
      n_s[e] = expect_name()
      n_b[e] = nameid(n_s[e])
    end
    else leave
  end
  return e

/* 1 when the name is not bound in any enclosing scope seen so far */
name_free: procedure = .int
  arg nm = .string
  s = .int
  s = cursc
  do while s > 0
    if scm[s || "|" || nm] \== "" then return 0
    s = sc_par[s]
  end
  return 1

p_call: procedure = .int
  arg f = .int
  base = .int
  a = .int
  n = .int
  st = .int
  cnt = .int
  flags = .int
  nm = .string
  sc = .int
  tpp = tpp + 1
  base = psp
  flags = 0
  /* zero-argument super() inside a method */
  if n_t[f] = 36 & n_s[f] == "super" & at(")") = 1 then do
    tpp = tpp + 1
    n_t[f] = 48
    if rf_node[nrf] = f then rf_sc[nrf] = 0
    n_a[f] = sc_cd[cursc]
    n_b[f] = 0
    sc = cursc
    do while sc > 0 & sc_par[sc] > 0 & sc_kind[sc_par[sc]] \= 3
      n_b[f] = n_b[f] + 1
      sc = sc_par[sc]
    end
    return f
  end
  do while at(")") = 0 & tk_t[tpp] \= 0
    if at("*") = 1 then do
      tpp = tpp + 1
      a = p_test()
      a = mk(46, a, 0, 0)
      flags = 1
    end
    else if at("**") = 1 then do
      tpp = tpp + 1
      a = p_test()
      a = mk(19, a, 0, 0)
      flags = 1
    end
    else if tk_t[tpp] = 4 & tk_t[tpp + 1] = 9 & tk_s[tpp + 1] == "=" then do
      nm = tk_s[tpp]
      tpp = tpp + 2
      a = p_test()
      a = mk(32, a, 0, 0)
      n_s[a] = nm
      flags = 1
    end
    else if has_for() = 1 then a = p_comp(0, "")
    else a = p_test()
    psp = psp + 1
    ps[psp] = a
    if accept(",") = 0 then leave
  end
  call expect ")"
  cnt = psp - base
  if n_t[f] = 36 & flags = 0 then do
    nm = n_s[f]
    if cnt = 0 & (nm == "locals" | nm == "vars" | nm == "dir") then do
      if name_free(nm) = 1 then do
        if rf_node[nrf] = f then rf_sc[nrf] = 0
        a = 1
        if nm == "vars" then a = 2
        if nm == "dir" then a = 3
        return mk(35, cursc, a, 0)
      end
    end
    if cnt = 1 & (nm == "eval" | nm == "exec") then do
      if name_free(nm) = 1 then do
        psp = psp + 1
        ps[psp] = mkc(2)
        psp = psp + 1
        ps[psp] = mk(35, cursc, 1, 0)
        psp = psp + 1
        if sc_kind[cursc] = 1 then ps[psp] = mkc(mkint(1))
        else ps[psp] = mkc(mkint(0))
        cnt = 4
      end
    end
  end
  st = plist(base)
  n = mk(8, f, st, cnt)
  n_d[n] = flags
  return n

p_subscript: procedure = .int
  arg o = .int
  base = .int
  a = .int
  b = .int
  c = .int
  cnt = .int
  tup = .int
  st = .int
  tpp = tpp + 1
  base = psp
  tup = 0
  do forever
    a = 0
    b = 0
    c = 0
    if at(":") = 0 then a = p_test_star()
    if at(":") = 1 then do
      tpp = tpp + 1
      if at(":") = 0 & at("]") = 0 & at(",") = 0 then b = p_test()
      if at(":") = 1 then do
        tpp = tpp + 1
        if at("]") = 0 & at(",") = 0 then c = p_test()
      end
      a = mk(45, a, b, c)
    end
    psp = psp + 1
    ps[psp] = a
    if at(",") = 1 then do
      tpp = tpp + 1
      tup = 1
      if at("]") = 1 then leave
    end
    else leave
  end
  call expect "]"
  cnt = psp - base
  if cnt = 1 & tup = 0 then do
    a = ps[psp]
    psp = base
  end
  else do
    st = plist(base)
    a = mk(50, st, cnt, 0)
  end
  return mk(47, o, a, 0)

p_test_star: procedure = .int
  x = .int
  if at("*") = 1 then do
    tpp = tpp + 1
    x = p_bin(1)
    return mk(46, x, 0, 0)
  end
  return p_test()

/* comma separated expressions (a tuple when there is a comma) */
p_testlist: procedure = .int
  base = .int
  a = .int
  cnt = .int
  st = .int
  comma = .int
  base = psp
  comma = 0
  do forever
    a = p_test_star()
    psp = psp + 1
    ps[psp] = a
    if at(",") = 1 then do
      tpp = tpp + 1
      comma = 1
      if tk_t[tpp] = 1 | tk_t[tpp] = 0 | at("=") = 1 | at(")") = 1 | at(":") = 1 | at(";") = 1 | at("]") = 1 then leave
    end
    else leave
  end
  if comma = 0 then do
    a = ps[psp]
    psp = base
    return a
  end
  cnt = psp - base
  st = plist(base)
  return mk(50, st, cnt, 0)

/* target list for 'for' loops / comprehensions: stops before 'in' */
p_targetlist: procedure = .int
  base = .int
  a = .int
  cnt = .int
  st = .int
  comma = .int
  base = psp
  comma = 0
  do forever
    if at("*") = 1 then do
      tpp = tpp + 1
      a = p_bin(1)
      a = mk(46, a, 0, 0)
    end
    else a = p_bin(1)
    psp = psp + 1
    ps[psp] = a
    if at(",") = 1 then do
      tpp = tpp + 1
      comma = 1
      if at("in") = 1 then leave
    end
    else leave
  end
  if comma = 0 then do
    a = ps[psp]
    psp = base
    return a
  end
  cnt = psp - base
  st = plist(base)
  return mk(50, st, cnt, 0)

/* turn an expression node into an assignment target (binds names) */
mk_target: procedure = .void
  arg n = .int
  t = .int
  i = .int
  dmy = .int
  t = n_t[n]
  if t = 36 then dmy = bind_name(n_s[n])
  else if t = 50 | t = 33 then do
    do i = 0 to n_b[n] - 1
      call mk_target al[n_a[n] + i]
    end
  end
  else if t = 46 then call mk_target n_a[n]
  else if t = 4 | t = 47 then nop
  else call perr "cannot assign to expression"
  return

p_atom: procedure = .int
  t = .int
  s = .string
  n = .int
  x = .int
  base = .int
  cnt = .int
  st = .int
  t = tk_t[tpp]
  s = tk_s[tpp]
  if t = 4 then do
    tpp = tpp + 1
    return mkname(s)
  end
  if t = 5 then do
    n = mkc(tk_i[tpp] * 2 + 1)
    tpp = tpp + 1
    return n
  end
  if t = 6 then do
    n = mkc(mkbig(s))
    tpp = tpp + 1
    return n
  end
  if t = 7 then do
    if tk_i[tpp] = 1 then n = mkc(mkcplx(0.0, tk_f[tpp]))
    else n = mkc(mkfloat(tk_f[tpp]))
    tpp = tpp + 1
    return n
  end
  if t = 8 then return p_strings()
  if t = 10 then do
    if s == "None" then do
      tpp = tpp + 1
      return mkc(2)
    end
    if s == "True" then do
      tpp = tpp + 1
      return mkc(4)
    end
    if s == "False" then do
      tpp = tpp + 1
      return mkc(6)
    end
    if s == "yield" then return p_yield()
    if s == "await" then do
      tpp = tpp + 1
      return p_atomexpr()
    end
    if s == "lambda" then return p_lambda()
  end
  if t = 9 then do
    if s == "(" then do
      tpp = tpp + 1
      if at(")") = 1 then do
        tpp = tpp + 1
        return mk(50, 0, 0, 0)
      end
      if at("yield") = 1 then do
        x = p_yield()
        call expect ")"
        return x
      end
      if has_for() = 1 then do
        x = p_comp(0, ")")
        return x
      end
      x = p_test_star()
      if at(",") = 1 then do
        base = psp
        psp = psp + 1
        ps[psp] = x
        do while accept(",") = 1
          if at(")") = 1 then leave
          x = p_test_star()
          psp = psp + 1
          ps[psp] = x
        end
        call expect ")"
        cnt = psp - base
        st = plist(base)
        return mk(50, st, cnt, 0)
      end
      call expect ")"
      if n_t[x] = 46 then call perr "can't use starred expression here"
      return x
    end
    if s == "[" then do
      tpp = tpp + 1
      if at("]") = 1 then do
        tpp = tpp + 1
        return mk(33, 0, 0, 0)
      end
      if has_for() = 1 then return p_comp(1, "]")
      base = psp
      do forever
        x = p_test_star()
        psp = psp + 1
        ps[psp] = x
        if accept(",") = 0 then leave
        if at("]") = 1 then leave
      end
      call expect "]"
      cnt = psp - base
      st = plist(base)
      return mk(33, st, cnt, 0)
    end
    if s == "{" then return p_brace()
    if s == "..." then do
      tpp = tpp + 1
      return mkc(8)
    end
  end
  call perr "invalid syntax near '" || s || "'"
  return mkc(2)

/* adjacent string literals (with f-strings) */
p_strings: procedure = .int
  acc = .string
  base = .int
  cnt = .int
  st = .int
  n = .int
  isf = .int
  anyf = .int
  fl = .int
  x = .int
  bacc = .string
  isbyt = .int
  acc = ""
  anyf = 0
  base = psp
  bacc = ""
  isbyt = 0
  do while tk_t[tpp] = 8
    fl = tk_i[tpp]
    if fl = 0 then acc = acc || tk_s[tpp]
    else if fl = 4 then do
      isbyt = 1
      bacc = bacc || tk_s[tpp]
    end
    else do
      anyf = 1
      /* flush literal accumulated so far */
      if acc \== "" then do
        psp = psp + 1
        ps[psp] = mkc(mkstr(acc))
        acc = ""
      end
      isf = 0
      if fl = 3 then isf = 1
      call fstring_parts tk_s[tpp], isf
    end
    tpp = tpp + 1
  end
  if isbyt = 1 then return mkc(mkbytes(bacc))
  if anyf = 0 then return mkc(mkstr(acc))
  if acc \== "" then do
    psp = psp + 1
    ps[psp] = mkc(mkstr(acc))
  end
  cnt = psp - base
  st = plist(base)
  return mk(24, st, cnt, 0)

/* parse an f-string body into parts pushed on ps (raw flag: no escapes) */
fstring_parts: procedure = .void
  arg raw = .string, isr = .int
  i = .int
  n = .int
  c = .string
  lit = .string
  j = .int
  dep = .int
  q = .string
  stop = .int
  ex = .string
  conv = .int
  spec = .int
  x = .int
  f = .int
  ch = .string
  nx = .string
  sp = .string
  dbg = .int
  fm = .int
  k = .int
  endj = .int
  base2 = .int
  cnt2 = .int
  st2 = .int
  i = 1
  n = length(raw)
  lit = ""
  do while i <= n
    c = substr(raw, i, 1)
    if c == "{" then do
      if substr(raw, i + 1, 1) == "{" then do
        lit = lit || "{"
        i = i + 2
        iterate
      end
      if lit \== "" then do
        psp = psp + 1
        if isr = 1 then ps[psp] = mkc(mkstr(lit))
        else ps[psp] = mkc(mkstr(unescape(lit)))
        lit = ""
      end
      /* find the end of the expression */
      j = i + 1
      dep = 0
      stop = 0
      do while j <= n & stop = 0
        ch = substr(raw, j, 1)
        nx = substr(raw, j + 1, 1)
        if ch == "'" | ch == '"' then do
          k = pos(ch, raw, j + 1)
          if k = 0 then j = n + 1
          else j = k + 1
          iterate
        end
        if ch == "(" | ch == "[" | ch == "{" then dep = dep + 1
        else if ch == ")" | ch == "]" then dep = dep - 1
        else if ch == "}" then do
          if dep = 0 then stop = 1
          else dep = dep - 1
        end
        else if dep = 0 & ch == "!" & nx \== "=" then stop = 1
        else if dep = 0 & ch == ":" then stop = 1
        else if dep = 0 & ch == "=" & nx \== "=" & substr(raw, j - 1, 1) \== "=" & substr(raw, j - 1, 1) \== "!" & substr(raw, j - 1, 1) \== "<" & substr(raw, j - 1, 1) \== ">" then stop = 2
        if stop = 0 then j = j + 1
      end
      ex = substr(raw, i + 1, j - i - 1)
      conv = 0
      spec = 0
      dbg = 0
      if stop = 2 then do
        dbg = 1
        lit = ex || "="
        j = j + 1
        ch = substr(raw, j, 1)
      end
      ch = substr(raw, j, 1)
      if ch == "!" then do
        conv = c2d(substr(raw, j + 1, 1))
        j = j + 2
        ch = substr(raw, j, 1)
      end
      if ch == ":" then do
        /* format spec up to the matching close brace; may hold nested fields */
        k = j + 1
        dep = 0
        do while k <= n
          ch = substr(raw, k, 1)
          if ch == "{" then dep = dep + 1
          else if ch == "}" then do
            if dep = 0 then leave
            dep = dep - 1
          end
          k = k + 1
        end
        sp = substr(raw, j + 1, k - j - 1)
        j = k
        base2 = psp
        call fstring_parts sp, 1
        if psp = base2 + 1 & n_t[ps[psp]] = 14 then do
          spec = ps[psp]
          psp = base2
        end
        else if psp = base2 then spec = mkc(mkstr(""))
        else do
          cnt2 = psp - base2
          st2 = plist(base2)
          spec = mk(24, st2, cnt2, 0)
        end
      end
      if substr(raw, j, 1) \== "}" then do
        call perr "f-string: expecting '}'"
        return
      end
      x = sub_expr(ex)
      if dbg = 1 then do
        psp = psp + 1
        ps[psp] = mkc(mkstr(lit))
        lit = ""
        if conv = 0 & spec = 0 then conv = 114
      end
      f = mk(21, x, conv, spec)
      psp = psp + 1
      ps[psp] = f
      i = j + 1
      iterate
    end
    if c == "}" then do
      if substr(raw, i + 1, 1) == "}" then i = i + 1
      lit = lit || "}"
      i = i + 1
      iterate
    end
    lit = lit || c
    i = i + 1
  end
  if lit \== "" then do
    psp = psp + 1
    if isr = 1 then ps[psp] = mkc(mkstr(lit))
    else ps[psp] = mkc(mkstr(unescape(lit)))
  end
  return

/* parse an expression from text (f-string fields) */
sub_expr: procedure = .int
  arg text = .string
  svt = .int
  base = .int
  x = .int
  svt = tpp
  base = ntk + 1
  call lex_text text, 1
  tpp = base
  x = p_testlist()
  tpp = svt
  return x

p_yield: procedure = .int
  x = .int
  tpp = tpp + 1
  if (sc_fl[cursc] // 2) = 0 then sc_fl[cursc] = sc_fl[cursc] + 1
  if at("from") = 1 then do
    tpp = tpp + 1
    x = p_test()
    x = mk(56, x, 0, 0)
    n_y[x] = 1
    return x
  end
  x = 0
  if tk_t[tpp] \= 1 & at(")") = 0 & at("=") = 0 & at(";") = 0 & at("]") = 0 & tk_t[tpp] \= 0 then x = p_testlist()
  x = mk(55, x, 0, 0)
  n_y[x] = 1
  return x

/* ---- brace displays ---- */
p_brace: procedure = .int
  k = .int
  v = .int
  base = .int
  cnt = .int
  st = .int
  n = .int
  isdict = .int
  tpp = tpp + 1
  if at("}") = 1 then do
    tpp = tpp + 1
    return mk(18, 0, 0, 0)
  end
  if has_for() = 1 then return p_comp(2, "}")
  base = psp
  isdict = -1
  do forever
    if at("**") = 1 then do
      tpp = tpp + 1
      v = p_bin(1)
      psp = psp + 1
      ps[psp] = 0
      psp = psp + 1
      ps[psp] = v
      isdict = 1
    end
    else do
      k = p_test_star()
      if at(":") = 1 then do
        tpp = tpp + 1
        v = p_test()
        psp = psp + 1
        ps[psp] = k
        psp = psp + 1
        ps[psp] = v
        isdict = 1
      end
      else do
        psp = psp + 1
        ps[psp] = k
        isdict = 0
      end
    end
    if accept(",") = 0 then leave
    if at("}") = 1 then leave
  end
  call expect "}"
  cnt = psp - base
  st = plist(base)
  if isdict = 1 then return mk(18, st, cnt % 2, 0)
  return mk(44, st, cnt, 0)

/* comprehension: kind 0 generator, 1 list, 2 set or dict; closer is the closing token.
   The element has not been parsed yet. */
p_comp: procedure = .int
  arg kind = .int, closer = .string
  sc = .int
  par = .int
  fd = .int
  elt = .int
  keyn = .int
  isdict = .int
  cl0 = .int
  ncl = .int
  i = .int
  tgt = .int
  itr = .int
  firstit = .int
  body = .int
  cond = .int
  n = .int
  dmy = .int
  c0 = .int
  k = .int
  ck = .int
  x = .int
  par = cursc
  nfd = nfd + 1
  fd = nfd
  fd_mod[fd] = parse_mi
  sc = scope_push(4)
  sc_id[sc] = fd
  dmy = bind_name(".0")
  dmy = bind_name(".r")
  if kind = 0 then sc_fl[sc] = 1
  /* element (and key) */
  keyn = 0
  isdict = 0
  elt = p_test_star()
  if kind = 2 & at(":") = 1 then do
    tpp = tpp + 1
    keyn = elt
    elt = p_test()
    isdict = 1
  end
  /* for clauses: stored on the parse stack as (target, iter, ncond, conds...) */
  cl0 = psp
  ncl = 0
  firstit = 0
  do while at("for") = 1
    tpp = tpp + 1
    tgt = p_targetlist()
    call mk_target tgt
    call expect "in"
    if ncl = 0 then do
      cursc = par
      itr = p_or()
      cursc = sc
      firstit = itr
      itr = mk(34, 2, 0, 0)
    end
    else itr = p_or()
    ncl = ncl + 1
    psp = psp + 1
    ps[psp] = tgt
    psp = psp + 1
    ps[psp] = itr
    c0 = psp + 1
    psp = psp + 1
    ps[psp] = 0
    do while at("if") = 1
      tpp = tpp + 1
      cond = p_or()
      psp = psp + 1
      ps[psp] = cond
      ps[c0] = ps[c0] + 1
    end
  end
  if closer \== "" then call expect closer
  /* innermost statement */
  if kind = 0 then do
    x = mk(55, elt, 0, 0)
    n_y[x] = 1
    body = mk(20, x, 0, 0)
    n_y[body] = 1
  end
  else do
    ck = 1
    if kind = 2 & isdict = 0 then ck = 4
    if kind = 2 & isdict = 1 then ck = 3
    body = mk(13, elt, keyn, ck)
  end
  call build_comp_nest cl0, ncl, body
  body = comp_result
  psp = cl0
  fd_body[fd] = body
  call finish_scope_fd fd, sc, 0
  call scope_end sc
  if kind = 0 then call mark_closure
  if kind = 0 then n = mk(26, fd, 0, firstit)
  else n = mk(12, fd, ck, firstit)
  return n

/* nest 'for'/'if' statements around body; clauses are on ps from cl0+1 */
build_comp_nest: procedure = .void
  arg cl0 = .int, ncl = .int, body = .int
  pos0 = .int
  starts = .int[]
  i = .int
  p = .int
  nc2 = .int
  j = .int
  cur = .int
  tgt = .int
  itr = .int
  cnd = .int
  f = .int
  p = cl0 + 1
  do i = 1 to ncl
    starts[i] = p
    p = p + 3 + ps[p + 2]
  end
  cur = body
  do i = ncl to 1 by -1
    p = starts[i]
    nc2 = ps[p + 2]
    do j = nc2 to 1 by -1
      cnd = ps[p + 2 + j]
      cur = mk(29, cnd, cur, 0)
      n_y[cur] = n_y[n_b[cur]]
    end
    f = mk(22, ps[p], ps[p + 1], cur)
    n_d[f] = 0
    n_y[f] = n_y[cur]
    cur = f
  end
  comp_result = cur
  return

/* ---- lambda and parameters ---- */
p_params: procedure = .int
  arg endtok = .string, ann = .int
  base = .int
  mode = .int
  nm = .string
  d = .int
  kind = .int
  base = npq
  mode = 0
  do while at(endtok) = 0 & tk_t[tpp] \= 0
    if at("*") = 1 then do
      tpp = tpp + 1
      mode = 2
      if tk_t[tpp] = 4 then do
        nm = expect_name()
        if ann = 1 & accept(":") = 1 then d = p_test()
        npq = npq + 1
        pq_name[npq] = nm
        pq_def[npq] = 0
        pq_kind[npq] = 1
      end
    end
    else if at("**") = 1 then do
      tpp = tpp + 1
      nm = expect_name()
      if ann = 1 & accept(":") = 1 then d = p_test()
      npq = npq + 1
      pq_name[npq] = nm
      pq_def[npq] = 0
      pq_kind[npq] = 3
    end
    else if at("/") = 1 then tpp = tpp + 1
    else do
      nm = expect_name()
      if ann = 1 & accept(":") = 1 then d = p_test()
      d = 0
      if accept("=") = 1 then d = p_test()
      npq = npq + 1
      pq_name[npq] = nm
      pq_def[npq] = d
      pq_kind[npq] = mode
    end
    if accept(",") = 0 then leave
  end
  return base

/* create the function record for scope sc from the parameter records after base */
setup_params: procedure = .void
  arg fd = .int, base = .int
  i = .int
  dmy = .int
  np = .int
  nk = .int
  k = .int
  fd_ps[fd] = npr + 1
  np = 0
  nk = 0
  fd_vs[fd] = 0
  fd_ks[fd] = 0
  do i = base + 1 to npq
    npr = npr + 1
    pr_name[npr] = pq_name[i]
    pr_def[npr] = pq_def[i]
    pr_kind[npr] = pq_kind[i]
    pr_slot[npr] = bind_name(pq_name[i])
    k = pq_kind[i]
    if k = 0 then np = np + 1
    else if k = 1 then fd_vs[fd] = pr_slot[npr]
    else if k = 2 then nk = nk + 1
    else fd_ks[fd] = pr_slot[npr]
  end
  fd_np[fd] = np
  fd_nk[fd] = nk
  fd_cx[fd] = 0
  if fd_vs[fd] > 0 | fd_ks[fd] > 0 | nk > 0 then fd_cx[fd] = 1
  fd_nr[fd] = npr - fd_ps[fd] + 1
  return

finish_scope_fd: procedure = .void
  arg fd = .int, sc = .int, isl = .int
  fd_ns[fd] = sc_n[sc]
  fd_fl[fd] = sc_fl[sc]
  fd_cd[fd] = sc_cd[sc]
  return

p_lambda: procedure = .int
  fd = .int
  sc = .int
  base = .int
  body = .int
  r = .int
  n = .int
  tpp = tpp + 1
  base = p_params(":", 0)
  call expect ":"
  nfd = nfd + 1
  fd = nfd
  fd_mod[fd] = parse_mi
  sc = scope_push(2)
  sc_id[sc] = fd
  call setup_params fd, base
  npq = base
  body = p_test()
  r = mk(42, body, 0, 0)
  fd_body[fd] = r
  fd_name[fd] = "<lambda>"
  call finish_scope_fd fd, sc, 1
  call scope_end sc
  call mark_closure
  n = mk(25, fd, 0, 0)
  return n

/* ---- statements ---- */
p_file: procedure = .int
  base = .int
  s = .int
  cnt = .int
  st = .int
  base = psp
  do while tk_t[tpp] \= 0
    if tk_t[tpp] = 1 then tpp = tpp + 1
    else do
      call p_stmt
    end
  end
  cnt = psp - base
  st = plist(base)
  return mkseq(st, cnt)

mkseq: procedure = .int
  arg st = .int, cnt = .int
  n = .int
  i = .int
  y = .int
  n = mk(43, st, cnt, 0)
  y = 0
  do i = 0 to cnt - 1
    if n_y[al[st + i]] = 1 then y = 1
  end
  n_y[n] = y
  return n

/* parse one statement (possibly several simple statements) and push its node(s) on ps */
p_stmt: procedure = .void
  n = .int
  s = .string
  t = .int
  t = tk_t[tpp]
  s = tk_s[tpp]
  if t = 10 then do
    select
      when s == "if" then do
        n = p_if()
        psp = psp + 1
        ps[psp] = n
        return
      end
      when s == "while" then do
        n = p_while()
        psp = psp + 1
        ps[psp] = n
        return
      end
      when s == "for" then do
        n = p_for()
        psp = psp + 1
        ps[psp] = n
        return
      end
      when s == "try" then do
        n = p_try()
        psp = psp + 1
        ps[psp] = n
        return
      end
      when s == "with" then do
        n = p_with()
        psp = psp + 1
        ps[psp] = n
        return
      end
      when s == "def" then do
        n = p_def(0, 0)
        psp = psp + 1
        ps[psp] = n
        return
      end
      when s == "class" then do
        n = p_class(0, 0)
        psp = psp + 1
        ps[psp] = n
        return
      end
      when s == "async" then do
        tpp = tpp + 1
        return
      end
      otherwise nop
    end
  end
  if t = 9 & s == "@" then do
    n = p_decorated()
    psp = psp + 1
    ps[psp] = n
    return
  end
  if t = 2 then do
    call perr "unexpected indent"
    return
  end
  call p_simple_line
  return

/* simple statements separated by ';' up to the end of line */
p_simple_line: procedure = .void
  n = .int
  do forever
    n = p_simple()
    psp = psp + 1
    ps[psp] = n
    if accept(";") = 1 then do
      if tk_t[tpp] = 1 | tk_t[tpp] = 0 then leave
    end
    else leave
  end
  if tk_t[tpp] = 1 then tpp = tpp + 1
  else if tk_t[tpp] \= 0 & tk_t[tpp] \= 3 then call perr "invalid syntax near '" || tk_s[tpp] || "'"
  return

/* suite after ':' ; returns a node */
p_suite: procedure = .int
  base = .int
  cnt = .int
  st = .int
  n = .int
  depth_save = .int
  if tk_t[tpp] = 1 then do
    tpp = tpp + 1
    if tk_t[tpp] \= 2 then do
      call perr "expected an indented block"
      return mk(40, 0, 0, 0)
    end
    tpp = tpp + 1
    base = psp
    do while tk_t[tpp] \= 3 & tk_t[tpp] \= 0
      if tk_t[tpp] = 1 then tpp = tpp + 1
      else call p_stmt
    end
    if tk_t[tpp] = 3 then tpp = tpp + 1
    cnt = psp - base
    st = plist(base)
    return mkseq(st, cnt)
  end
  base = psp
  call p_simple_line
  cnt = psp - base
  st = plist(base)
  return mkseq(st, cnt)

p_if: procedure = .int
  c = .int
  b = .int
  e = .int
  n = .int
  tpp = tpp + 1
  c = p_test()
  call expect ":"
  b = p_suite()
  e = 0
  if at("elif") = 1 then e = p_if_elif()
  else if at("else") = 1 then do
    tpp = tpp + 1
    call expect ":"
    e = p_suite()
  end
  n = mk(29, c, b, e)
  n_y[n] = 0
  if n_y[b] = 1 then n_y[n] = 1
  if e > 0 then do
    if n_y[e] = 1 then n_y[n] = 1
  end
  return n

p_if_elif: procedure = .int
  return p_if()

p_while: procedure = .int
  c = .int
  b = .int
  e = .int
  n = .int
  tpp = tpp + 1
  c = p_test()
  call expect ":"
  b = p_suite()
  e = 0
  if at("else") = 1 then do
    tpp = tpp + 1
    call expect ":"
    e = p_suite()
  end
  n = mk(53, c, b, e)
  if n_y[b] = 1 then n_y[n] = 1
  if e > 0 then do
    if n_y[e] = 1 then n_y[n] = 1
  end
  return n

p_for: procedure = .int
  tgt = .int
  it = .int
  b = .int
  e = .int
  n = .int
  tpp = tpp + 1
  tgt = p_targetlist()
  call mk_target tgt
  call expect "in"
  it = p_testlist()
  call expect ":"
  b = p_suite()
  e = 0
  if at("else") = 1 then do
    tpp = tpp + 1
    call expect ":"
    e = p_suite()
  end
  n = mk(22, tgt, it, b)
  n_d[n] = e
  if n_y[b] = 1 then n_y[n] = 1
  if e > 0 then do
    if n_y[e] = 1 then n_y[n] = 1
  end
  return n

p_try: procedure = .int
  body = .int
  hs = .int
  hc = .int
  el = .int
  fin = .int
  n = .int
  h = .int
  ty = .int
  nm = .int
  hb = .int
  base = .int
  y = .int
  i = .int
  tpp = tpp + 1
  call expect ":"
  body = p_suite()
  base = psp
  y = n_y[body]
  el = 0
  fin = 0
  do while at("except") = 1
    tpp = tpp + 1
    ty = 0
    nm = 0
    if at(":") = 0 then do
      ty = p_test()
      if accept("as") = 1 then do
        nm = mkname(expect_name())
        call mk_target nm
      end
      else if accept(",") = 1 then do
        call perr "invalid except clause"
      end
    end
    call expect ":"
    hb = p_suite()
    if n_y[hb] = 1 then y = 1
    h = mk(28, ty, nm, hb)
    psp = psp + 1
    ps[psp] = h
  end
  hc = psp - base
  hs = plist(base)
  if at("else") = 1 then do
    tpp = tpp + 1
    call expect ":"
    el = p_suite()
    if n_y[el] = 1 then y = 1
  end
  if at("finally") = 1 then do
    tpp = tpp + 1
    call expect ":"
    fin = p_suite()
    if n_y[fin] = 1 then y = 1
  end
  n = mk(49, body, hs, hc)
  n_d[n] = el
  n_e[n] = fin
  n_y[n] = y
  return n

p_with: procedure = .int
  ctx = .int
  tgt = .int
  b = .int
  n = .int
  tpp = tpp + 1
  ctx = p_test()
  tgt = 0
  if accept("as") = 1 then do
    tgt = p_bin(1)
    call mk_target tgt
  end
  if accept(",") = 1 then do
    /* with a, b: -> nested with */
    b = p_with_rest()
  end
  else do
    call expect ":"
    b = p_suite()
  end
  n = mk(54, ctx, tgt, b)
  if n_y[b] = 1 then n_y[n] = 1
  return n

p_with_rest: procedure = .int
  ctx = .int
  tgt = .int
  b = .int
  n = .int
  ctx = p_test()
  tgt = 0
  if accept("as") = 1 then do
    tgt = p_bin(1)
    call mk_target tgt
  end
  if accept(",") = 1 then b = p_with_rest()
  else do
    call expect ":"
    b = p_suite()
  end
  n = mk(54, ctx, tgt, b)
  if n_y[b] = 1 then n_y[n] = 1
  return n

p_decorated: procedure = .int
  base = .int
  x = .int
  cnt = .int
  st = .int
  n = .int
  base = psp
  do while at("@") = 1
    tpp = tpp + 1
    x = p_test()
    psp = psp + 1
    ps[psp] = x
    if tk_t[tpp] = 1 then tpp = tpp + 1
  end
  cnt = psp - base
  st = plist(base)
  if at("def") = 1 then return p_def(st, cnt)
  if at("class") = 1 then return p_class(st, cnt)
  call perr "decorator must precede def or class"
  return mk(40, 0, 0, 0)

p_def: procedure = .int
  arg decst = .int, deccnt = .int
  name = .string
  tn = .int
  base = .int
  fd = .int
  sc = .int
  body = .int
  n = .int
  dmy = .int
  tpp = tpp + 1
  name = expect_name()
  tn = mkname(name)
  dmy = bind_name(name)
  call expect "("
  base = p_params(")", 1)
  call expect ")"
  if accept("->") = 1 then dmy = p_test()
  call expect ":"
  nfd = nfd + 1
  fd = nfd
  fd_mod[fd] = parse_mi
  sc = scope_push(2)
  sc_id[sc] = fd
  call setup_params fd, base
  fd_name[fd] = name
  npq = base
  body = p_suite()
  fd_body[fd] = body
  call finish_scope_fd fd, sc, 0
  call scope_end sc
  call mark_closure
  n = mk(16, fd, tn, decst)
  n_d[n] = deccnt
  return n

p_class: procedure = .int
  arg decst = .int, deccnt = .int
  name = .string
  tn = .int
  cd = .int
  sc = .int
  body = .int
  n = .int
  dmy = .int
  basen = .int
  nb2 = .int
  i = .int
  base = .int
  cnt = .int
  st = .int
  tpp = tpp + 1
  name = expect_name()
  tn = mkname(name)
  dmy = bind_name(name)
  basen = 0
  if accept("(") = 1 then do
    base = psp
    do while at(")") = 0 & tk_t[tpp] \= 0
      if tk_t[tpp] = 4 & tk_t[tpp + 1] = 9 & tk_s[tpp + 1] == "=" then do
        tpp = tpp + 2
        dmy = p_test()
      end
      else do
        dmy = p_test()
        psp = psp + 1
        ps[psp] = dmy
      end
      if accept(",") = 0 then leave
    end
    call expect ")"
    cnt = psp - base
    st = plist(base)
    if cnt > 0 then basen = mk(50, st, cnt, 0)
  end
  call expect ":"
  ncd = ncd + 1
  cd = ncd
  sc = scope_push(3)
  sc_id[sc] = cd
  cd_sc[cd] = sc
  cd_name[cd] = name
  cd_cv0[cd] = ncv + 1
  body = p_suite()
  cd_body[cd] = body
  cd_ns[cd] = sc_n[sc]
  cd_cv1[cd] = ncv
  call scope_end sc
  call mark_closure
  n = mk(10, cd, tn, basen)
  n_d[n] = decst
  n_e[n] = deccnt
  return n

/* ---- simple statements ---- */
p_simple: procedure = .int
  s = .string
  t = .int
  n = .int
  x = .int
  y = .int
  base = .int
  cnt = .int
  st = .int
  op = .int
  dmy = .int
  nm = .string
  t = tk_t[tpp]
  s = tk_s[tpp]
  if t = 10 then do
    select
      when s == "pass" then do
        tpp = tpp + 1
        return mk(40, 0, 0, 0)
      end
      when s == "break" then do
        tpp = tpp + 1
        return mk(7, 0, 0, 0)
      end
      when s == "continue" then do
        tpp = tpp + 1
        return mk(15, 0, 0, 0)
      end
      when s == "return" then do
        tpp = tpp + 1
        x = 0
        if tk_t[tpp] \= 1 & tk_t[tpp] \= 0 & at(";") = 0 then x = p_testlist()
        return mk(42, x, 0, 0)
      end
      when s == "raise" then do
        tpp = tpp + 1
        x = 0
        y = 0
        if tk_t[tpp] \= 1 & tk_t[tpp] \= 0 & at(";") = 0 then do
          x = p_test()
          if accept("from") = 1 then y = p_test()
        end
        return mk(41, x, y, 0)
      end
      when s == "global" | s == "nonlocal" then do
        tpp = tpp + 1
        do forever
          nm = expect_name()
          if s == "global" then scm[cursc || "|" || nm] = "-1"
          else scm[cursc || "|" || nm] = "-2"
          if accept(",") = 0 then leave
        end
        return mk(40, 0, 0, 0)
      end
      when s == "del" then do
        tpp = tpp + 1
        base = psp
        do forever
          x = p_bin(1)
          call mk_target x
          psp = psp + 1
          ps[psp] = x
          if accept(",") = 0 then leave
          if tk_t[tpp] = 1 then leave
        end
        cnt = psp - base
        st = plist(base)
        return mk(17, st, cnt, 0)
      end
      when s == "assert" then do
        tpp = tpp + 1
        x = p_test()
        y = 0
        if accept(",") = 1 then y = p_test()
        return mk(2, x, y, 0)
      end
      when s == "import" then return p_import()
      when s == "from" then return p_from()
      otherwise nop
    end
  end
  /* expression statement / assignment */
  x = p_testlist()
  if at("=") = 1 then do
    base = psp
    psp = psp + 1
    ps[psp] = x
    do while accept("=") = 1
      if at("yield") = 1 then x = p_yield()
      else x = p_testlist()
      psp = psp + 1
      ps[psp] = x
    end
    /* last is the value, others are targets */
    y = ps[psp]
    psp = psp - 1
    do op = base + 1 to psp
      call mk_target ps[op]
    end
    cnt = psp - base
    st = plist(base)
    n = mk(3, y, st, cnt)
    n_y[n] = n_y[y]
    return n
  end
  if tk_t[tpp] = 9 then do
    op = aug_op()
    if op > 0 then do
      tpp = tpp + 1
      call mk_target x
      if at("yield") = 1 then y = p_yield()
      else y = p_testlist()
      n = mk(5, x, y, op)
      return n
    end
    if at(":") = 1 then do
      /* annotated assignment */
      tpp = tpp + 1
      dmy = p_test()
      if accept("=") = 1 then do
        y = p_testlist()
        call mk_target x
        base = psp
        psp = psp + 1
        ps[psp] = x
        st = plist(base)
        return mk(3, y, st, 1)
      end
      return mk(40, 0, 0, 0)
    end
  end
  n = mk(20, x, 0, 0)
  n_y[n] = n_y[x]
  return n

aug_op: procedure = .int
  s = .string
  s = tk_s[tpp]
  if s == "+=" then return 1
  if s == "-=" then return 2
  if s == "*=" then return 3
  if s == "/=" then return 4
  if s == "//=" then return 5
  if s == "%=" then return 6
  if s == "**=" then return 7
  if s == "<<=" then return 8
  if s == ">>=" then return 9
  if s == "&=" then return 10
  if s == "|=" then return 11
  if s == "^=" then return 12
  if s == "@=" then return 13
  return 0

dotted_name: procedure = .string
  r = .string
  r = expect_name()
  do while at(".") = 1
    tpp = tpp + 1
    r = r || "." || expect_name()
  end
  return r

p_import: procedure = .int
  full = .string
  alias = .string
  tn = .int
  base = .int
  n = .int
  cnt = .int
  st = .int
  dmy = .int
  hasalias = .int
  tpp = tpp + 1
  base = psp
  do forever
    full = dotted_name()
    alias = full
    hasalias = 0
    if pos(".", full) > 0 then alias = left(full, pos(".", full) - 1)
    if accept("as") = 1 then do
      alias = expect_name()
      hasalias = 1
    end
    tn = mkname(alias)
    dmy = bind_name(alias)
    n = mk(31, tn, hasalias, 0)
    n_s[n] = full
    psp = psp + 1
    ps[psp] = n
    if accept(",") = 0 then leave
  end
  cnt = psp - base
  if cnt = 1 then do
    n = ps[psp]
    psp = base
    return n
  end
  st = plist(base)
  return mkseq(st, cnt)

p_from: procedure = .int
  full = .string
  nm = .string
  alias = .string
  tn = .int
  base = .int
  n = .int
  cnt = .int
  st = .int
  dmy = .int
  paren = .int
  level = .int
  tpp = tpp + 1
  level = 0
  do forever
    if at(".") = 1 then do
      level = level + 1
      tpp = tpp + 1
    end
    else if at("...") = 1 then do
      level = level + 3
      tpp = tpp + 1
    end
    else leave
  end
  full = ""
  if at("import") = 0 then full = dotted_name()
  call expect "import"
  paren = accept("(")
  base = psp
  if at("*") = 1 then do
    tpp = tpp + 1
    n = mk(23, 0, 0, level)
    n_s[n] = full
    n_d[n] = 1
    parse_dyn = 1
    return n
  end
  do forever
    nm = expect_name()
    alias = nm
    if accept("as") = 1 then alias = expect_name()
    tn = mkname(alias)
    dmy = bind_name(alias)
    psp = psp + 1
    ps[psp] = mkc(mkstr(nm))
    psp = psp + 1
    ps[psp] = tn
    if accept(",") = 0 then leave
    if paren = 1 & at(")") = 1 then leave
  end
  if paren = 1 then call expect ")"
  cnt = (psp - base) % 2
  st = plist(base)
  n = mk(23, st, cnt, level)
  n_s[n] = full
  return n

/* ---------------------------------------------------------------------
   Objects.  An oop is 2*index for heap objects, 2*n+1 for small integers.
   --------------------------------------------------------------------- */
newobj: procedure = .int
  arg kind = .int
  i = .int
  i = fo_head
  if i > 0 then do
    fo_head = ob_n[i]
    ob_n[i] = 0
  end
  else do
    nob = nob + 1
    i = nob
  end
  if wd > 0 then do
    ny = ny + 1
    yl[ny] = i
  end
  ob_k[i] = kind
  if kind = 7 | kind = 9 | kind = 10 | kind = 17 | kind = 20 | kind = 12 then do
    nct = nct + 1
    ctl[nct] = i
  end
  return i * 2

mkint: procedure = .int
  arg n = .int
  if n > 999999999999999999 | n < 0 - 999999999999999999 then return big_norm(n as .string)
  return n * 2 + 1

ival: procedure = .int
  arg x = .int
  if x // 2 \= 0 then return (x - 1) % 2
  if x = 4 then return 1
  if ob_k[x % 2] = 4 then do
    if ob_c[x % 2] > 0 then do
      if length(ob_s[x % 2]) <= 18 then return ob_s[x % 2] as .int
    end
  end
  return 0

mkstr: procedure = .int
  arg s = .string
  i = .int
  i = fo_head
  if i > 0 then do
    fo_head = ob_n[i]
    ob_n[i] = 0
  end
  else do
    nob = nob + 1
    i = nob
  end
  if wd > 0 then do
    ny = ny + 1
    yl[ny] = i
  end
  ob_k[i] = 6
  ob_s[i] = s
  return i * 2

mkfloat: procedure = .int
  arg f = .float
  i = .int
  i = fo_head
  if i > 0 then do
    fo_head = ob_n[i]
    ob_n[i] = 0
  end
  else do
    nob = nob + 1
    i = nob
  end
  if wd > 0 then do
    ny = ny + 1
    yl[ny] = i
  end
  ob_k[i] = 5
  ob_f[i] = f
  return i * 2

mkbool: procedure = .int
  arg b = .int
  if b = 1 then return 4
  return 6

/* big integer from a decimal string (may need normalising) */
mkbig: procedure = .int
  arg s = .string
  o = .int
  o = newobj(4)
  ob_s[o % 2] = s
  return o

alloc_slots: procedure = .int
  arg n = .int
  st = .int
  v = .string
  if n > 0 then do
    if n <= 64 then do
      st = sfl[n]
      if st > 0 then do
        sfl[n] = sl[st]
        sl[st] = 0
        return st
      end
    end
    else if nbfl > 0 then do
      v = bfl[n]
      if v \== "" then do
        st = v as .int
        if st > 0 then do
          bfl[n] = sl[st] as .string
          sl[st] = 0
          nbfl = nbfl - 1
          return st
        end
      end
    end
  end
  st = nsl + 1
  nsl = nsl + n
  if n > 0 then sl[nsl] = 0
  return st

/* give the (zeroed) block st of n slots back to the allocator */
free_block: procedure = .void
  arg st = .int, n = .int
  i = .int
  if st <= 0 | n <= 0 then return
  if gcpoison = 1 then do
    do i = 0 to n - 1
      sl[st + i] = 0 - 4
    end
    return
  end
  do i = 0 to n - 1
    sl[st + i] = 0
  end
  if n <= 64 then do
    sl[st] = sfl[n]
    sfl[n] = st
  end
  else do
    if bfl[n] == "" then sl[st] = 0
    else sl[st] = bfl[n] as .int
    bfl[n] = st as .string
    nbfl = nbfl + 1
  end
  return

/* a block that was replaced while a primitive may still hold its address: freed at the next collection */
orphan_block: procedure = .void
  arg st = .int, n = .int
  if st <= 0 | n < 2 | wd = 0 then return
  sl[st] = orph_h
  sl[st + 1] = n
  orph_h = st
  return

mklist: procedure = .int
  arg cap = .int
  o = .int
  o = newobj(7)
  if cap < 4 then cap = 4
  ob_p[o % 2] = alloc_slots(cap)
  ob_x[o % 2] = cap
  return o

mktuple: procedure = .int
  arg n = .int
  o = .int
  o = newobj(8)
  ob_p[o % 2] = alloc_slots(n)
  ob_n[o % 2] = n
  ob_x[o % 2] = n
  return o

list_append: procedure = .void
  arg o = .int, v = .int
  i = .int
  ix = .int
  n = .int
  cap = .int
  st = .int
  nst = .int
  ix = o % 2
  n = ob_n[ix]
  cap = ob_x[ix]
  if n >= cap then do
    cap = cap * 2
    if cap < 4 then cap = 4
    st = ob_p[ix]
    nst = alloc_slots(cap)
    do i = 0 to n - 1
      sl[nst + i] = sl[st + i]
    end
    ob_p[ix] = nst
    call orphan_block st, ob_x[ix]
    ob_x[ix] = cap
  end
  sl[ob_p[ix] + n] = v
  ob_n[ix] = n + 1
  return

/* make room for at least n elements */
list_reserve: procedure = .void
  arg o = .int, need = .int
  i = .int
  ix = .int
  n = .int
  st = .int
  nst = .int
  ix = o % 2
  if need <= ob_x[ix] then return
  n = ob_n[ix]
  st = ob_p[ix]
  nst = alloc_slots(need)
  do i = 0 to n - 1
    sl[nst + i] = sl[st + i]
  end
  ob_p[ix] = nst
  call orphan_block st, ob_x[ix]
  ob_x[ix] = need
  return

tup_of_list: procedure = .int
  arg l = .int
  t = .int
  i = .int
  n = .int
  n = ob_n[l % 2]
  t = mktuple(n)
  do i = 0 to n - 1
    sl[ob_p[t % 2] + i] = sl[ob_p[l % 2] + i]
  end
  return t

/* a tuple holding ast[base+from .. base+to] */
tup_from_ast: procedure = .int
  arg from = .int, upto = .int
  t = .int
  i = .int
  n = .int
  n = upto - from + 1
  if n < 0 then n = 0
  t = mktuple(n)
  do i = 0 to n - 1
    sl[ob_p[t % 2] + i] = ast[from + i]
  end
  return t

list_get: procedure = .int
  arg o = .int, i = .int
  return sl[ob_p[o % 2] + i]

/* ---- names, classes ---- */
nameid: procedure = .int
  arg name = .string
  v = .string
  v = nidm[name]
  if v \== "" then return v as .int
  nnid = nnid + 1
  nid_name[nnid] = name
  nidm[name] = nnid as .string
  return nnid

define_class: procedure = .int
  arg name = .string, base = .int
  c = .int
  o = .int
  i = .int
  ncls = ncls + 1
  c = ncls
  cl_name[c] = name
  cl_base[c] = base
  cl_ns[c] = 0
  cl_flags[c] = 0
  cl_mod[c] = cur_mi
  cl_bt[c] = 0
  o = newobj(16)
  ob_x[o % 2] = c
  cl_obj[c] = o
  if base > 0 then cl_flags[c] = cl_flags[base]
  /* linearisation: the class followed by the linearisation of its base */
  cl_ms[c] = nmro + 1
  nmro = nmro + 1
  mro_a[nmro] = c
  cl_mn[c] = 1
  cl_bs[c] = nbs + 1
  cl_bn[c] = 0
  if base > 0 then do
    do i = 0 to cl_mn[base] - 1
      nmro = nmro + 1
      mro_a[nmro] = mro_a[cl_ms[base] + i]
    end
    cl_mn[c] = cl_mn[base] + 1
    nbs = nbs + 1
    bs_a[nbs] = base
    cl_bn[c] = 1
  end
  return c

/* class c gets the bases bl_a[1 .. n]; C3 linearisation.  returns 1, or 0 with a TypeError */
set_bases: procedure = .int
  arg c = .int, n = .int
  i = .int
  j = .int
  k = .int
  b = .int
  ns = .int
  tot = .int
  cand = .int
  fin = .int
  h = .int
  ok = .int
  cnt = .int
  fl = .int
  names = .string
  cl_bs[c] = nbs + 1
  do i = 1 to n
    nbs = nbs + 1
    bs_a[nbs] = bl_a[i]
  end
  cl_bn[c] = n
  cl_base[c] = bl_a[1]
  fl = 0
  do i = 1 to n
    if (cl_flags[bl_a[i]] // 4) >= 2 then fl = fl + 2
    if fl > 2 then fl = 2
  end
  cl_flags[c] = fl
  ns = n + 1
  tot = 0
  do i = 1 to n
    b = bl_a[i]
    sq_s[i] = tot + 1
    do j = 0 to cl_mn[b] - 1
      tot = tot + 1
      sq_a[tot] = mro_a[cl_ms[b] + j]
    end
    sq_e[i] = tot
    sq_p[i] = sq_s[i]
  end
  sq_s[ns] = tot + 1
  do i = 1 to n
    tot = tot + 1
    sq_a[tot] = bl_a[i]
  end
  sq_e[ns] = tot
  sq_p[ns] = sq_s[ns]
  cl_ms[c] = nmro + 1
  nmro = nmro + 1
  mro_a[nmro] = c
  cnt = 1
  fin = 0
  do while fin = 0
    cand = 0
    fin = 1
    do i = 1 to ns
      if sq_p[i] <= sq_e[i] then do
        fin = 0
        if cand = 0 then do
          h = sq_a[sq_p[i]]
          ok = 1
          do k = 1 to ns
            do j = sq_p[k] + 1 to sq_e[k]
              if sq_a[j] = h then ok = 0
            end
          end
          if ok = 1 then cand = h
        end
      end
    end
    if fin = 0 then do
      if cand = 0 then do
        names = ""
        do i = 1 to n
          if i > 1 then names = names || ", "
          names = names || cl_name[bl_a[i]]
        end
        cl_mn[c] = cnt
        call raise_exc 38, "Cannot create a consistent method resolution order (MRO) for bases " || names
        return 0
      end
      nmro = nmro + 1
      mro_a[nmro] = cand
      cnt = cnt + 1
      do i = 1 to ns
        if sq_p[i] <= sq_e[i] then do
          if sq_a[sq_p[i]] = cand then sq_p[i] = sq_p[i] + 1
        end
      end
    end
  end
  cl_mn[c] = cnt
  return 1

/* the builtin container type among the bases of user class c (0 if none) */
set_btype: procedure = .void
  arg c = .int
  i = .int
  k = .int
  cl_bt[c] = 0
  do i = 1 to cl_mn[c] - 1
    k = mro_a[cl_ms[c] + i - 1]
    if k = 9 | k = 7 | k = 8 | k = 10 | k = 6 | k = 3 | k = 4 | k = 83 | k = 84 then do
      cl_bt[c] = k
      return
    end
  end
  return

/* look a name id up through the linearisation: oop or 0 */
cls_find: procedure = .int
  arg c = .int, nid = .int
  v = .string
  i = .int
  st = .int
  n = .int
  st = cl_ms[c]
  n = cl_mn[c]
  do i = 0 to n - 1
    v = ca[mro_a[st + i] || "." || nid]
    if v \== "" then return v as .int
  end
  return 0

/* the class in whose own table the name is found (0 when absent) */
cls_owner: procedure = .int
  arg c = .int, nid = .int
  v = .string
  i = .int
  st = .int
  n = .int
  st = cl_ms[c]
  n = cl_mn[c]
  do i = 0 to n - 1
    v = ca[mro_a[st + i] || "." || nid]
    if v \== "" then return mro_a[st + i]
  end
  return 0

cls_set: procedure = .void
  arg c = .int, nid = .int, v = .int
  if ca[c || "." || nid] == "" then do
    nca = nca + 1
    ca_c[nca] = c
    ca_n[nca] = nid
  end
  ca[c || "." || nid] = v as .string
  cgen = cgen + 1
  return

cls_issub: procedure = .int
  arg c = .int, base = .int
  i = .int
  st = .int
  n = .int
  if c = base then return 1
  st = cl_ms[c]
  n = cl_mn[c]
  do i = 0 to n - 1
    if mro_a[st + i] = base then return 1
  end
  return 0

cls_of: procedure = .int
  arg x = .int
  k = .int
  if x // 2 \= 0 then return 3
  k = ob_k[x % 2]
  if k = 17 then return ob_c[x % 2]
  if k >= 6 & k <= 10 then do
    if ob_c[x % 2] > 0 then return ob_c[x % 2]
  end
  if k = 5 | k = 4 | k = 31 then do
    if ob_c[x % 2] > 0 then return ob_c[x % 2]
  end
  if k = 31 & ob_y[x % 2] = 1 then return 84
  if k = 30 then return 56 + ob_n[x % 2] - 1
  return kcls[k]

kind_of: procedure = .int
  arg x = .int
  if x // 2 \= 0 then return 3
  return ob_k[x % 2]

/* instance attributes: slot map per class */
inst_new: procedure = .int
  arg c = .int
  o = .int
  o = newobj(17)
  ob_c[o % 2] = c
  ob_n[o % 2] = cl_ns[c] + 2
  ob_p[o % 2] = alloc_slots(cl_ns[c] + 2)
  return o

inst_get: procedure = .int
  arg o = .int, nid = .int
  v = .string
  v = sm[ob_c[o % 2] || "." || nid]
  if v == "" then return 0
  return sl[ob_p[o % 2] + (v as .int) - 1]

inst_set: procedure = .void
  arg o = .int, nid = .int, val = .int
  ix = .int
  c = .int
  v = .string
  slot = .int
  nn = .int
  st = .int
  nst = .int
  i = .int
  ix = o % 2
  c = ob_c[ix]
  v = sm[c || "." || nid]
  if v == "" then do
    cl_ns[c] = cl_ns[c] + 1
    slot = cl_ns[c]
    sm[c || "." || nid] = slot as .string
    cgen = cgen + 1
    nis = nis + 1
    is_c[nis] = c
    is_n[nis] = nid
    is_s[nis] = slot
  end
  else slot = v as .int
  if slot > ob_n[ix] then do
    nn = cl_ns[c] + 2
    if nn <= slot then nn = slot + 2
    st = ob_p[ix]
    nst = alloc_slots(nn)
    do i = 0 to ob_n[ix] - 1
      sl[nst + i] = sl[st + i]
    end
    ob_p[ix] = nst
    call orphan_block st, ob_n[ix]
    ob_n[ix] = nn
  end
  sl[ob_p[ix] + slot - 1] = val
  return

inst_del: procedure = .int
  arg o = .int, nid = .int
  v = .string
  slot = .int
  v = sm[ob_c[o % 2] || "." || nid]
  if v == "" then return 0
  slot = v as .int
  if sl[ob_p[o % 2] + slot - 1] = 0 then return 0
  sl[ob_p[o % 2] + slot - 1] = 0
  return 1

/* ---- exceptions ---- */
exc_new: procedure = .int
  arg c = .int, msg = .string
  o = .int
  t = .int
  o = inst_new(c)
  t = mktuple(1)
  sl[ob_p[t % 2]] = mkstr(msg)
  call inst_set o, 8, t
  return o

exc_new0: procedure = .int
  arg c = .int
  o = .int
  o = inst_new(c)
  call inst_set o, 8, mktuple(0)
  return o

/* raise a built-in exception: sets the unwind state and returns 0 */
raise_exc: procedure = .int
  arg c = .int, msg = .string
  unw = 4
  unw_v = exc_new(c, msg)
  return 0

raise_obj: procedure = .int
  arg e = .int
  unw = 4
  unw_v = e
  return 0

type_name: procedure = .string
  arg x = .int
  return cl_name[cls_of(x)]

/* ---- truth ---- */
truthy: procedure = .int
  arg x = .int
  k = .int
  m = .int
  r = .int
  if x // 2 \= 0 then do
    if x = 1 then return 0
    return 1
  end
  if x = 4 then return 1
  if x = 6 | x = 2 then return 0
  k = ob_k[x % 2]
  if k >= 6 & k <= 10 then do
    if ob_c[x % 2] > 0 then do
      m = cls_find(ob_c[x % 2], 137)
      if m = 0 then m = cls_find(ob_c[x % 2], 164)
      if m > 0 then do
        r = call0(m, x)
        if r = 0 then return 0
        return truthy(r)
      end
    end
  end
  select
    when k = 6 then do
      if length(ob_s[x % 2]) > 0 then return 1
      return 0
    end
    when k = 7 | k = 8 then do
      if ob_n[x % 2] > 0 then return 1
      return 0
    end
    when k = 9 | k = 10 then do
      if dd_n[ob_x[x % 2]] > 0 then return 1
      return 0
    end
    when k = 5 then do
      if ob_f[x % 2] = 0.0 then return 0
      return 1
    end
    when k = 4 then do
      if ob_s[x % 2] == "0" then return 0
      return 1
    end
    when k = 31 then do
      if length(ob_s[x % 2]) > 0 then return 1
      return 0
    end
    when k = 32 then do
      if ob_f[x % 2] \= 0.0 | ob_g[x % 2] \= 0.0 then return 1
      return 0
    end
    when k = 29 then do
      if ob_n[x % 2] = 1 then return truthy(np_scalar(x, 0))
      if ob_n[x % 2] = 0 then return 0
      r = raise_exc(36, "The truth value of an array with more than one element is ambiguous. Use a.any() or a.all()")
      return 0
    end
    when k = 11 then do
      if range_len(x) > 0 then return 1
      return 0
    end
    when k = 30 then do
      if dd_n[ob_x[ob_x[x % 2] % 2]] > 0 then return 1
      return 0
    end
    when k = 17 then do
      m = cls_find(ob_c[x % 2], 137)
      if m > 0 then do
        r = call0(m, x)
        if r = 0 then return 0
        return truthy(r)
      end
      m = cls_find(ob_c[x % 2], 164)
      if m > 0 then do
        r = call0(m, x)
        if r = 0 then return 0
        return truthy(r)
      end
      return 1
    end
    otherwise return 1
  end
  return 1

/* ---- dictionaries and sets ---- */
dict_new: procedure = .int
  arg kind = .int
  o = .int
  d = .int
  o = newobj(kind)
  if dd_fh > 0 then do
    d = dd_fh
    dd_fh = dd_tail[d]
  end
  else do
    ndd = ndd + 1
    d = ndd
  end
  dd_head[d] = 0
  dd_tail[d] = 0
  dd_n[d] = 0
  dd_own[d] = 0
  ob_x[o % 2] = d
  return o

dict_find: procedure = .int
  arg d = .int, key = .string
  v = .string
  v = dmap[d || "|" || key]
  if v == "" then return 0
  return v as .int

dict_put: procedure = .void
  arg d = .int, key = .string, k = .int, v = .int
  e = .int
  if dd_own[d] > 0 then do
    if kind_of(k) = 6 then call inst_set dd_own[d], nameid(ob_s[k % 2]), v
  end
  e = dict_find(d, key)
  if e > 0 then do
    de_val[e] = v
    return
  end
  if de_fh > 0 then do
    e = de_fh
    de_fh = de_next[e]
  end
  else do
    nde = nde + 1
    e = nde
  end
  de_key[e] = k
  de_val[e] = v
  de_next[e] = 0
  de_live[e] = 1
  de_hk[e] = key
  if dd_tail[d] > 0 then de_next[dd_tail[d]] = e
  else dd_head[d] = e
  dd_tail[d] = e
  dd_n[d] = dd_n[d] + 1
  dmap[d || "|" || key] = e as .string
  return

dict_del: procedure = .int
  arg d = .int, key = .string
  e = .int
  e = dict_find(d, key)
  if e = 0 then return 0
  if dd_own[d] > 0 & left(key, 1) == "s" then call inst_del dd_own[d], nameid(substr(key, 2))
  de_live[e] = 0
  dd_n[d] = dd_n[d] - 1
  dmap[d || "|" || key] = ""
  return e

dict_clear: procedure = .void
  arg d = .int
  e = .int
  e = dd_head[d]
  do while e > 0
    if de_live[e] = 1 then do
      de_live[e] = 0
      dmap[d || "|" || de_hk[e]] = ""
    end
    e = de_next[e]
  end
  dd_head[d] = 0
  dd_tail[d] = 0
  dd_n[d] = 0
  return

/* first live entry at or after e */
de_live_from: procedure = .int
  arg e = .int
  do while e > 0
    if de_live[e] = 1 then return e
    e = de_next[e]
  end
  return 0

/* a dict key string for hashing: ints and equal floats agree */
hashkey: procedure = .string
  arg x = .int
  k = .int
  f = .float
  s = .string
  m = .int
  r = .int
  i = .int
  n = .int
  if x // 2 \= 0 then return "i" || ((x - 1) % 2)
  k = ob_k[x % 2]
  select
    when k = 6 then return "s" || ob_s[x % 2]
    when k = 2 then do
      if x = 4 then return "i1"
      return "i0"
    end
    when k = 1 then return "N"
    when k = 31 then return "b" || ob_s[x % 2]
    when k = 32 then do
      if ob_g[x % 2] = 0.0 then return hashkey(mkfloat(ob_f[x % 2]))
      return "c" || float_repr(ob_f[x % 2]) || "," || float_repr(ob_g[x % 2])
    end
    when k = 4 then return "i" || ob_s[x % 2]
    when k = 5 then do
      f = ob_f[x % 2]
      if f = rxfloat..floor(f) & f > -900000000000000000.0 & f < 900000000000000000.0 then return "i" || (rxfloat..trunc(f) as .int)
      return "f" || float_repr(f)
    end
    when k = 8 then do
      s = "t("
      n = ob_n[x % 2]
      do i = 0 to n - 1
        s = s || length(hashkey(sl[ob_p[x % 2] + i])) || ":" || hashkey(sl[ob_p[x % 2] + i]) || ","
      end
      return s || ")"
    end
    when k = 17 then do
      m = cls_find(ob_c[x % 2], 158)
      if m > 0 then do
        r = call0(m, x)
        if r = 0 then return "?"
        return "h" || ival(r)
      end
      return "o" || x
    end
    when k = 7 | k = 9 | k = 10 then do
      r = raise_exc(38, "unhashable type: '" || type_name(x) || "'")
      return "?"
    end
    otherwise return "o" || x
  end
  return "o" || x

dget: procedure = .int
  arg d = .int, key = .int
  return dict_find(ob_x[d % 2], hashkey(key))

dset: procedure = .void
  arg d = .int, key = .int, v = .int
  call dict_put ob_x[d % 2], hashkey(key), key, v
  return

mkrange: procedure = .int
  arg a = .int, b = .int, c = .int
  o = .int
  o = newobj(11)
  ob_n[o % 2] = a
  ob_x[o % 2] = b
  ob_y[o % 2] = c
  return o

range_len: procedure = .int
  arg r = .int
  a = .int
  b = .int
  c = .int
  a = ob_n[r % 2]
  b = ob_x[r % 2]
  c = ob_y[r % 2]
  if c > 0 then do
    if b <= a then return 0
    return (b - a + c - 1) % c
  end
  if a <= b then return 0
  return (a - b - c - 1) % (0 - c)

/* ---------------------------------------------------------------------
   Arbitrary-precision integers on decimal strings (as in the Smalltalk interpreter)
   --------------------------------------------------------------------- */
mag_clean: procedure = .string
  arg s = .string
  p = .int
  p = verify(s, "0", "N")
  if p = 0 then return "0"
  return substr(s, p)

mag_cmp: procedure = .int
  arg a = .string, b = .string
  if length(a) < length(b) then return -1
  if length(a) > length(b) then return 1
  if a == b then return 0
  if a << b then return -1
  return 1

mag_add: procedure = .string
  arg a = .string, b = .string
  r = .string
  i = .int
  j = .int
  x = .int
  y = .int
  c = .int
  s = .int
  piece = .string
  i = length(a)
  j = length(b)
  c = 0
  r = ""
  do while i > 0 | j > 0 | c > 0
    x = 0
    y = 0
    if i > 0 then do
      if i > 9 then x = substr(a, i - 8, 9) as .int
      else x = substr(a, 1, i) as .int
      i = i - 9
    end
    if j > 0 then do
      if j > 9 then y = substr(b, j - 8, 9) as .int
      else y = substr(b, 1, j) as .int
      j = j - 9
    end
    s = x + y + c
    if s >= 1000000000 then do
      s = s - 1000000000
      c = 1
    end
    else c = 0
    piece = s as .string
    if i > 0 | j > 0 | c > 0 then piece = right(copies("0", 9) || piece, 9)
    r = piece || r
  end
  return mag_clean(r)

/* a >= b */
mag_sub: procedure = .string
  arg a = .string, b = .string
  r = .string
  i = .int
  j = .int
  x = .int
  y = .int
  c = .int
  s = .int
  piece = .string
  i = length(a)
  j = length(b)
  c = 0
  r = ""
  do while i > 0
    if i > 9 then x = substr(a, i - 8, 9) as .int
    else x = substr(a, 1, i) as .int
    i = i - 9
    y = 0
    if j > 0 then do
      if j > 9 then y = substr(b, j - 8, 9) as .int
      else y = substr(b, 1, j) as .int
      j = j - 9
    end
    s = x - y - c
    if s < 0 then do
      s = s + 1000000000
      c = 1
    end
    else c = 0
    piece = s as .string
    if i > 0 then piece = right(copies("0", 9) || piece, 9)
    r = piece || r
  end
  return mag_clean(r)

mag_mul: procedure = .string
  arg a = .string, b = .string
  la = .int
  lb = .int
  i = .int
  j = .int
  k = .int
  x = .int
  c = .int
  t = .int
  r = .string
  piece = .string
  al0 = .int[]
  bl0 = .int[]
  rl = .int[]
  if a == "0" | b == "0" then return "0"
  la = 0
  i = length(a)
  do while i > 0
    la = la + 1
    if i > 9 then al0[la] = substr(a, i - 8, 9) as .int
    else al0[la] = substr(a, 1, i) as .int
    i = i - 9
  end
  lb = 0
  i = length(b)
  do while i > 0
    lb = lb + 1
    if i > 9 then bl0[lb] = substr(b, i - 8, 9) as .int
    else bl0[lb] = substr(b, 1, i) as .int
    i = i - 9
  end
  do k = 1 to la + lb
    rl[k] = 0
  end
  do i = 1 to la
    c = 0
    x = al0[i]
    do j = 1 to lb
      t = x * bl0[j] + rl[i + j - 1] + c
      c = t % 1000000000
      rl[i + j - 1] = t // 1000000000
    end
    k = i + lb
    do while c > 0
      t = rl[k] + c
      c = t % 1000000000
      rl[k] = t // 1000000000
      k = k + 1
    end
  end
  k = la + lb
  do while k > 1 & rl[k] = 0
    k = k - 1
  end
  r = rl[k] as .string
  do i = k - 1 to 1 by -1
    piece = rl[i] as .string
    r = r || right(copies("0", 9) || piece, 9)
  end
  return mag_clean(r)

/* truncated division of magnitudes: quotient in bq, remainder in brm */
mag_divmod: procedure = .void
  arg a = .string, b = .string
  i = .int
  r = .string
  q = .string
  d = .int
  qd = .int
  bn = .int
  rn = .int
  chunk = .int
  cur = .int
  p = .int
  l = .int
  piece = .string
  if mag_cmp(a, b) < 0 then do
    bq = "0"
    brm = a
    return
  end
  if length(b) <= 9 then do
    bn = b as .int
    rn = 0
    q = ""
    l = length(a)
    /* first chunk length so the rest are 9 digits */
    p = l // 9
    if p = 0 then p = 9
    cur = 1
    do while cur <= l
      chunk = substr(a, cur, p) as .int
      cur = cur + p
      rn = rn * (10 ** length(substr(a, cur - p, p))) + chunk
      qd = rn % bn
      rn = rn // bn
      piece = right(copies("0", 9) || qd, 9)
      q = q || piece
      p = 9
    end
    bq = mag_clean(q)
    brm = rn as .string
    return
  end
  r = "0"
  q = ""
  do i = 1 to length(a)
    r = mag_clean(r || substr(a, i, 1))
    qd = 0
    do while mag_cmp(r, b) >= 0
      r = mag_sub(r, b)
      qd = qd + 1
    end
    q = q || qd
  end
  bq = mag_clean(q)
  brm = r
  return

/* signed string helpers: s is "123" or "-123" */
sgn_split: procedure = .void
  arg s = .string
  if left(s, 1) == "-" then do
    sg = -1
    mg = substr(s, 2)
  end
  else do
    sg = 1
    mg = s
  end
  return

sgn_make: procedure = .string
  arg sgv = .int, mgv = .string
  if mgv == "0" then return "0"
  if sgv < 0 then return "-" || mgv
  return mgv

sadd: procedure = .string
  arg a = .string, b = .string
  sa = .int
  sb = .int
  ma = .string
  mb = .string
  c = .int
  call sgn_split a
  sa = sg
  ma = mg
  call sgn_split b
  sb = sg
  mb = mg
  if sa = sb then return sgn_make(sa, mag_add(ma, mb))
  c = mag_cmp(ma, mb)
  if c = 0 then return "0"
  if c > 0 then return sgn_make(sa, mag_sub(ma, mb))
  return sgn_make(sb, mag_sub(mb, ma))

sneg: procedure = .string
  arg a = .string
  if a == "0" then return "0"
  if left(a, 1) == "-" then return substr(a, 2)
  return "-" || a

ssub: procedure = .string
  arg a = .string, b = .string
  return sadd(a, sneg(b))

smul: procedure = .string
  arg a = .string, b = .string
  sa = .int
  sb = .int
  ma = .string
  mb = .string
  call sgn_split a
  sa = sg
  ma = mg
  call sgn_split b
  sb = sg
  mb = mg
  return sgn_make(sa * sb, mag_mul(ma, mb))

/* truncated quotient and remainder: results in sq, sr */
sdivmod: procedure = .void
  arg a = .string, b = .string
  sa = .int
  sb = .int
  ma = .string
  mb = .string
  call sgn_split a
  sa = sg
  ma = mg
  call sgn_split b
  sb = sg
  mb = mg
  call mag_divmod ma, mb
  sq = sgn_make(sa * sb, bq)
  sr = sgn_make(sa, brm)
  return

scmp: procedure = .int
  arg a = .string, b = .string
  sa = .int
  sb = .int
  ma = .string
  mb = .string
  call sgn_split a
  sa = sg
  ma = mg
  call sgn_split b
  sb = sg
  mb = mg
  if ma == "0" then sa = 0
  if mb == "0" then sb = 0
  if sa < sb then return -1
  if sa > sb then return 1
  if sa = 0 then return 0
  if sa > 0 then return mag_cmp(ma, mb)
  return mag_cmp(mb, ma)


/* decimal string of an integer oop (small, bool or big) */
num_str: procedure = .string
  arg x = .int
  if x // 2 \= 0 then return ival(x) as .string
  if ob_k[x % 2] = 4 then return ob_s[x % 2]
  return ival(x) as .string

/* oop for an integer given as a (signed) decimal string */
big_norm: procedure = .int
  arg s0 = .string
  s = .string
  neg = .int
  s = s0
  neg = 0
  if left(s, 1) == "-" then do
    neg = 1
    s = substr(s, 2)
  end
  s = mag_clean(s)
  if length(s) <= 18 then do
    if neg = 1 then return (0 - (s as .int)) * 2 + 1
    return (s as .int) * 2 + 1
  end
  if neg = 1 then s = "-" || s
  return mkbig(s)

/* integer power of a decimal string (exponent >= 0) */
big_pow: procedure = .string
  arg b = .string, e = .int
  r = .string
  p = .string
  r = "1"
  p = b
  do while e > 0
    if e // 2 = 1 then r = smul(r, p)
    e = e % 2
    if e > 0 then p = smul(p, p)
  end
  return r

/* integer string of a float's truncation (|f| large) */
float_to_istr: procedure = .string
  arg f = .float
  neg = .int
  x = .float
  neg = 0
  x = f
  if x < 0.0 then do
    neg = 1
    x = 0.0 - x
  end
  call float_exact x
  if fx_q >= 0 then fx_d = fx_d || copies("0", fx_q)
  else do
    if length(fx_d) + fx_q <= 0 then fx_d = "0"
    else fx_d = left(fx_d, length(fx_d) + fx_q)
  end
  if neg = 1 & fx_d \== "0" then return "-" || fx_d
  return fx_d

/* oop for the truncation of a float (0 if nan or inf) */
float_to_int: procedure = .int
  arg f = .float
  if f \= f then return 0
  if finf(f) \= 0 then return 0
  if f > -900000000000000000.0 & f < 900000000000000000.0 then return (rxfloat..trunc(f) as .int) * 2 + 1
  return big_norm(float_to_istr(f))

/* 0 finite or nan, 1 +inf, 2 -inf */
finf: procedure = .int
  arg f = .float
  d = .float
  if f \= f then return 0
  d = f - f
  if d = 0.0 then return 0
  if f > 0.0 then return 1
  return 2

f_inf: procedure = .float
  z = .float
  z = 1.0e308
  z = z * 10.0
  return z

f_nan: procedure = .float
  z = .float
  z = f_inf()
  return z - z

/* exact decimal expansion of the finite non-negative float x:  x = fx_d * 10 ** fx_q
   (fx_d has no leading or trailing zeros; x = 0 gives "0") */
float_exact: procedure = .void
  arg f = .float
  x = .float
  e = .int
  m = .int
  k = .int
  z = .int
  x = f
  if x = 0.0 then do
    fx_d = "0"
    fx_q = 0
    return
  end
  e = 0
  do while x >= 38685626227668133590597632.0
    x = x / 4294967296.0
    e = e + 32
  end
  do while x >= 9007199254740992.0
    x = x / 2.0
    e = e + 1
  end
  do while x < 4503599627370496.0
    if x < 1048576.0 then do
      x = x * 4294967296.0
      e = e - 32
    end
    else do
      x = x * 2.0
      e = e - 1
    end
  end
  m = rxfloat..trunc(x) as .int
  if e >= 0 then do
    fx_d = smul(m as .string, big_pow("2", e))
    fx_q = 0
  end
  else do
    fx_d = smul(m as .string, big_pow("5", 0 - e))
    fx_q = e
  end
  /* strip trailing zeros */
  k = length(fx_d)
  z = k
  do while z > 1 & substr(fx_d, z, 1) == "0"
    z = z - 1
  end
  if z < k then do
    fx_q = fx_q + (k - z)
    fx_d = left(fx_d, z)
  end
  return

/* n significant digits (correctly rounded, half even) of |f|; the decimal exponent of the
   first digit is left in fx_e */
float_digits: procedure = .string
  arg f = .float, n = .int
  l = .int
  head = .string
  rest = .string
  up = .int
  first = .string
  lastd = .int
  call float_exact f
  l = length(fx_d)
  fx_e = l - 1 + fx_q
  if fx_d == "0" then do
    fx_e = 0
    return copies("0", n)
  end
  if l <= n then return fx_d || copies("0", n - l)
  head = left(fx_d, n)
  rest = substr(fx_d, n + 1)
  first = left(rest, 1)
  up = 0
  if first >>= "6" then up = 1
  else if first == "5" then do
    if length(rest) > 1 then up = 1
    else do
      lastd = right(head, 1) as .int
      if lastd // 2 = 1 then up = 1
    end
  end
  if up = 1 then do
    head = mag_add(head, "1")
    if length(head) > n then do
      head = left(head, n)
      fx_e = fx_e + 1
    end
  end
  return head

/* parse a decimal float literal string; handles overflow / underflow without a panic */
parse_flt: procedure = .float
  arg s0 = .string
  s = .string
  p = .int
  ex = .int
  mant = .string
  ip = .int
  y = .float
  z = .float
  s = lower(s0)
  p = pos("e", s)
  ex = 0
  mant = s
  if p > 0 then do
    mant = left(s, p - 1)
    s = substr(s, p + 1)
    if left(s, 1) == "+" then s = substr(s, 2)
    ex = s as .int
  end
  ip = pos(".", mant)
  if ip = 0 then ip = length(mant) + 1
  if ex + ip - 1 > 310 then return f_inf()
  if ex + ip - 1 < -330 then return 0.0
  if ex >= -290 & ex <= 290 then return (mant || "e" || ex) as .float
  if ex > 290 then do
    y = (mant || "e290") as .float
    z = rxfloat..pow10((ex - 290) as .float)
    return y * z
  end
  y = (mant || "e-290") as .float
  z = rxfloat..pow10((ex + 290) as .float)
  return y * z

/* shortest repr that round-trips (as Python's repr) */
float_repr: procedure = .string
  arg f = .float
  x = .float
  neg = .int
  n = .int
  d = .string
  dexp = .int
  ds = .string
  y = .float
  ok = .int
  l = .int
  mant = .string
  es = .string
  if f \= f then return "nan"
  if finf(f) = 1 then return "inf"
  if finf(f) = 2 then return "-inf"
  if f = 0.0 then do
    if fl_negzero(f) = 1 then return "-0.0"
    return "0.0"
  end
  x = f
  neg = 0
  if x < 0.0 then do
    neg = 1
    x = 0.0 - x
  end
  ok = 0
  do n = 15 to 17
    d = float_digits(x, n)
    dexp = fx_e
    if n = 17 | dexp < -300 | dexp > 306 then ok = 1
    else do
      y = (left(d, 1) || "." || substr(d, 2) || "e" || dexp) as .float
      if y = x then ok = 1
    end
    if ok = 1 then leave
  end
  /* strip trailing zeros */
  l = length(d)
  do while l > 1 & substr(d, l, 1) == "0"
    l = l - 1
  end
  ds = left(d, l)
  if dexp >= -4 & dexp < 16 then do
    if dexp >= 0 then do
      if length(ds) <= dexp + 1 then mant = ds || copies("0", dexp + 1 - length(ds)) || ".0"
      else mant = left(ds, dexp + 1) || "." || substr(ds, dexp + 2)
    end
    else mant = "0." || copies("0", 0 - dexp - 1) || ds
  end
  else do
    mant = left(ds, 1)
    if length(ds) > 1 then mant = mant || "." || substr(ds, 2)
    if dexp < 0 then es = "-"
    else es = "+"
    d = abs(dexp) as .string
    if length(d) < 2 then d = "0" || d
    mant = mant || "e" || es || d
  end
  if neg = 1 then return "-" || mant
  return mant

/* negation that keeps the sign of zero */
fneg: procedure = .float
  arg f = .float
  half = .float
  z = .float
  if f = 0.0 then do
    if fl_negzero(f) = 1 then return 0.0
    z = 0.0
    half = 0.5
    return rxfloat..ceil(z - half)
  end
  return 0.0 - f

fl_negzero: procedure = .int
  arg f = .float
  s = .string
  z = .float
  one = .float
  m1 = .float
  if f = 0.0 then do
    z = 0.0
    one = 1.0
    m1 = z - one
    if rxfloat..atan2(f, m1) < 0.0 then return 1
    return 0
  end
  s = f as .string
  if left(s, 1) == "-" then return 1
  return 0

/* fixed notation with nd decimals (C printf %.{nd}f) */
float_fixed: procedure = .string
  arg f = .float, nd = .int
  x = .float
  neg = .int
  d = .string
  q = .int
  r = .string
  cut = .int
  head = .string
  rest = .string
  up = .int
  first = .string
  lastd = .int
  ip = .string
  fp = .string
  if f \= f then return "nan"
  if finf(f) = 1 then return "inf"
  if finf(f) = 2 then return "-inf"
  x = f
  neg = 0
  if x < 0.0 then do
    neg = 1
    x = 0.0 - x
  end
  else if x = 0.0 then do
    if fl_negzero(f) = 1 then neg = 1
  end
  call float_exact x
  d = fx_d
  q = fx_q + nd
  if d == "0" then r = "0"
  else if q >= 0 then r = d || copies("0", q)
  else do
    cut = 0 - q
    if cut > length(d) then r = "0"
    else do
      head = left(d, length(d) - cut)
      rest = right(d, cut)
      if head == "" then head = "0"
      first = left(rest, 1)
      up = 0
      if first >>= "6" then up = 1
      else if first == "5" then do
        if length(rest) > 1 then up = 1
        else do
          lastd = right(head, 1) as .int
          if lastd // 2 = 1 then up = 1
        end
      end
      if up = 1 then head = mag_add(head, "1")
      r = head
    end
  end
  r = mag_clean(r)
  if nd > 0 then do
    if length(r) <= nd then r = copies("0", nd - length(r) + 1) || r
    ip = left(r, length(r) - nd)
    fp = right(r, nd)
    r = ip || "." || fp
  end
  if neg = 1 then return "-" || r
  return r

/* scientific notation with nd digits after the point: d.ddde+XX */
float_sci: procedure = .string
  arg f = .float, nd = .int, upper = .int
  x = .float
  neg = .int
  d = .string
  es = .string
  ee = .string
  if f \= f then return "nan"
  if finf(f) = 1 then return "inf"
  if finf(f) = 2 then return "-inf"
  x = f
  neg = 0
  if x < 0.0 then do
    neg = 1
    x = 0.0 - x
  end
  d = float_digits(x, nd + 1)
  if x = 0.0 then fx_e = 0
  if nd > 0 then d = left(d, 1) || "." || substr(d, 2)
  if fx_e < 0 then es = "-"
  else es = "+"
  ee = abs(fx_e) as .string
  if length(ee) < 2 then ee = "0" || ee
  if upper = 1 then d = d || "E" || es || ee
  else d = d || "e" || es || ee
  if neg = 1 then return "-" || d
  return d

/* ---------------------------------------------------------------------
   Arithmetic, comparison, equality, containment
   --------------------------------------------------------------------- */
numkind: procedure = .int
  arg x = .int
  k = .int
  if x // 2 \= 0 then return 1
  k = ob_k[x % 2]
  if k = 2 then return 1
  if k = 4 then return 2
  if k = 5 then return 3
  return 0

tofloat: procedure = .float
  arg x = .int
  if x // 2 \= 0 then return ((x - 1) % 2) as .float
  if ob_k[x % 2] = 2 then do
    if x = 4 then return 1.0
    return 0.0
  end
  if ob_k[x % 2] = 4 then return parse_flt(ob_s[x % 2])
  return ob_f[x % 2]

err_binop: procedure = .int
  arg sym = .string, x = .int, y = .int
  kx = .int
  ky = .int
  kx = 0
  ky = 0
  if x > 0 & x // 2 = 0 then kx = ob_k[x % 2]
  if y > 0 & y // 2 = 0 then ky = ob_k[y % 2]
  do
    if sym == "+" & (kx = 6 | kx = 7 | kx = 8) then return raise_exc(38, "can only concatenate " || type_name(x) || " (not " || '"' || type_name(y) || '"' || ") to " || type_name(x))
    if sym == "*" & (kx = 6 | kx = 7 | kx = 8) then return raise_exc(38, "can't multiply sequence by non-int of type '" || type_name(y) || "'")
    if sym == "*" & (ky = 6 | ky = 7 | ky = 8) then return raise_exc(38, "can't multiply sequence by non-int of type '" || type_name(x) || "'")
  end
  return raise_exc(38, "unsupported operand type(s) for " || sym || ": '" || type_name(x) || "' and '" || type_name(y) || "'")

op_sym: procedure = .string
  arg op = .int
  select
    when op = 1 then return "+"
    when op = 2 then return "-"
    when op = 3 then return "*"
    when op = 4 then return "/"
    when op = 5 then return "//"
    when op = 6 then return "%"
    when op = 7 then return "** or pow()"
    when op = 8 then return "<<"
    when op = 9 then return ">>"
    when op = 10 then return "&"
    when op = 11 then return "|"
    when op = 12 then return "^"
    when op = 13 then return "@"
    otherwise return "?"
  end
  return "?"

/* arithmetic on two numbers (kinds: 1 small/bool, 2 big, 3 float) */
numarith: procedure = .int
  arg op = .int, x = .int, y = .int
  kx = .int
  ky = .int
  fx = .float
  fy = .float
  a = .int
  b = .int
  q = .int
  r = .int
  sx = .string
  sy = .string
  fa = .float
  fb2 = .float
  res = .int
  m = .int
  kx = numkind(x)
  ky = numkind(y)
  if kx = 3 | ky = 3 then do
    fx = tofloat(x)
    fy = tofloat(y)
    select
      when op = 1 then return mkfloat(fx + fy)
      when op = 2 then return mkfloat(fx - fy)
      when op = 3 then return mkfloat(fx * fy)
      when op = 4 then do
        if fy = 0.0 then do
          if ky = 3 | kx = 3 then return raise_exc(30, "float division by zero")
          return raise_exc(30, "division by zero")
        end
        return mkfloat(fx / fy)
      end
      when op = 5 then do
        if fy = 0.0 then return raise_exc(30, "float floor division by zero")
        return mkfloat(rxfloat..floor(fx / fy))
      end
      when op = 6 then do
        if fy = 0.0 then return raise_exc(30, "float modulo by zero")
        fa = fx - fy * rxfloat..floor(fx / fy)
        return mkfloat(fa)
      end
      when op = 7 then do
        if fx = 0.0 & fy < 0.0 then return raise_exc(30, "0.0 cannot be raised to a negative power")
        return mkfloat(rxfloat..pow(fx, fy))
      end
      otherwise return err_binop(op_sym(op), x, y)
    end
  end
  if kx = 1 & ky = 1 then do
    a = ival(x)
    b = ival(y)
    select
      when op = 1 then return mkint(a + b)
      when op = 2 then return mkint(a - b)
      when op = 3 then do
        fa = a as .float
        fb2 = b as .float
        if rxfloat..fabs(fa * fb2) < 900000000000000000.0 then return mkint(a * b)
        return big_norm(smul(a as .string, b as .string))
      end
      when op = 4 then do
        if b = 0 then return raise_exc(30, "division by zero")
        return mkfloat((a as .float) / (b as .float))
      end
      when op = 5 | op = 6 then do
        if b = 0 then do
          if op = 6 then return raise_exc(30, "integer modulo by zero")
          return raise_exc(30, "integer division or modulo by zero")
        end
        q = a % b
        r = a // b
        if r \= 0 & ((r < 0) \= (b < 0)) then do
          q = q - 1
          r = r + b
        end
        if op = 5 then return mkint(q)
        return mkint(r)
      end
      when op = 7 then return int_pow(x, y)
      when op = 8 then do
        if b < 0 then return raise_exc(36, "negative shift count")
        if b < 60 & a > -1000000 & a < 1000000 & b < 40 then return mkint(a * (2 ** b))
        return big_norm(smul(a as .string, big_pow("2", b)))
      end
      when op = 9 then do
        if b < 0 then return raise_exc(36, "negative shift count")
        if b > 62 then do
          if a < 0 then return mkint(-1)
          return mkint(0)
        end
        assembler ishr r, a, b
        return mkint(r)
      end
      when op = 10 then do
        assembler iand r, a, b
        return mkint(r)
      end
      when op = 11 then do
        assembler ior r, a, b
        return mkint(r)
      end
      when op = 12 then do
        assembler ixor r, a, b
        return mkint(r)
      end
      otherwise return err_binop(op_sym(op), x, y)
    end
  end
  /* at least one big integer */
  sx = num_str(x)
  sy = num_str(y)
  select
    when op = 1 then return big_norm(sadd(sx, sy))
    when op = 2 then return big_norm(ssub(sx, sy))
    when op = 3 then return big_norm(smul(sx, sy))
    when op = 4 then do
      if sy == "0" then return raise_exc(30, "division by zero")
      return mkfloat(tofloat(x) / tofloat(y))
    end
    when op = 5 | op = 6 then do
      if sy == "0" then do
        if op = 6 then return raise_exc(30, "integer modulo by zero")
        return raise_exc(30, "integer division or modulo by zero")
      end
      call sdivmod sx, sy
      if sr \== "0" & ((left(sx, 1) == "-") \= (left(sy, 1) == "-")) then do
        if op = 5 then return big_norm(ssub(sq, "1"))
        return big_norm(sadd(sr, sy))
      end
      if op = 5 then return big_norm(sq)
      return big_norm(sr)
    end
    when op = 7 then return int_pow(x, y)
    when op = 8 then do
      if ky \= 1 then return raise_exc(31, "shift count too large")
      b = ival(y)
      if b < 0 then return raise_exc(36, "negative shift count")
      return big_norm(smul(sx, big_pow("2", b)))
    end
    when op = 9 then do
      if ky \= 1 then return mkint(0)
      b = ival(y)
      call sdivmod sx, big_pow("2", b)
      if sr \== "0" & left(sx, 1) == "-" then return big_norm(ssub(sq, "1"))
      return big_norm(sq)
    end
    otherwise return raise_exc(38, "bitwise operation on huge integers is not supported")
  end
  return 0

int_pow: procedure = .int
  arg x = .int, y = .int
  a = .int
  b = .int
  r = .int
  est = .float
  fa = .float
  if numkind(y) = 2 then do
    return raise_exc(31, "exponent too large")
  end
  b = ival(y)
  if b < 0 then do
    if numkind(x) = 1 & ival(x) = 0 then return raise_exc(30, "0.0 cannot be raised to a negative power")
    return mkfloat(rxfloat..pow(tofloat(x), b as .float))
  end
  if numkind(x) = 1 then do
    a = ival(x)
    if a = 0 | a = 1 then do
      if b = 0 then return mkint(1)
      return mkint(a)
    end
    if a = -1 then do
      if b // 2 = 0 then return mkint(1)
      return mkint(-1)
    end
    fa = a as .float
    est = (b as .float) * rxfloat..log10(rxfloat..fabs(fa))
    if est < 17.0 then do
      r = 1
      do while b > 0
        if b // 2 = 1 then r = r * a
        b = b % 2
        if b > 0 then a = a * a
      end
      return mkint(r)
    end
  end
  return big_norm(big_pow(num_str(x), b))

arith: procedure = .int
  arg op = .int, x = .int, y = .int
  kx = .int
  ky = .int
  m = .int
  r = .int
  o = .int
  i = .int
  n = .int
  s = .string
  cnt = .int
  e = .int
  d = .int
  p = .int
  q = .int
  kx = kind_of(x)
  ky = kind_of(y)
  if kx = 32 | ky = 32 then do
    if (kx = 32 | numkind(x) > 0) & (ky = 32 | numkind(y) > 0) then return cplx_arith(op, x, y)
  end
  if x // 2 = 0 then do
    if ob_c[x % 2] > 0 & op <= 13 then do
      m = nsov(x, opd[op])
      if m > 0 then do
        r = call2(m, x, y)
        if r \= 10 then return r
        if unw > 0 then return 0
      end
    end
  end
  if y // 2 = 0 then do
    if ob_c[y % 2] > 0 & op <= 13 then do
      m = nsov(y, ropd[op])
      if m > 0 then do
        r = call2(m, y, x)
        if r \= 10 then return r
        if unw > 0 then return 0
      end
    end
  end
  if kx = 4 then do
    if ob_c[x % 2] > 0 then do
      x = big_norm(ob_s[x % 2])
      kx = kind_of(x)
    end
  end
  if ky = 4 then do
    if ob_c[y % 2] > 0 then do
      y = big_norm(ob_s[y % 2])
      ky = kind_of(y)
    end
  end
  if numkind(x) > 0 & numkind(y) > 0 then return numarith(op, x, y)
  if kx = 29 & ky = 32 then return arith(op, cx_call1("_from_real", x), y)
  if kx = 32 & ky = 29 then return arith(op, x, cx_call1("_from_real", y))
  if (kx = 29 | ky = 29) & kx \= 17 & ky \= 17 & kx \= 6 then return np_binop(op, x, y)
  if op = 6 & kx = 6 then return fmt_percent(ob_s[x % 2], y)
  if kx = 17 | ky = 17 then do
    if kx = 17 then do
      m = cls_find(ob_c[x % 2], opd[op])
      if m > 0 then do
        r = call2(m, x, y)
        if r \= 10 then return r
        if unw > 0 then return 0
      end
    end
    if ky = 17 then do
      m = cls_find(ob_c[y % 2], ropd[op])
      if m > 0 then do
        r = call2(m, y, x)
        if r \= 10 then return r
        if unw > 0 then return 0
      end
    end
    return err_binop(op_sym(op), x, y)
  end
  if kx = 30 | ky = 30 then do
    if op = 11 | op = 10 | op = 2 | op = 12 then do
      if kx = 30 then do
        if ob_n[x % 2] = 2 then return err_binop(op_sym(op), x, y)
      end
      if ky = 30 then do
        if ob_n[y % 2] = 2 then return err_binop(op_sym(op), x, y)
      end
      o = as_set(x)
      if o = 0 then return 0
      r = as_set(y)
      if r = 0 then return 0
      return set_op(op, o, r)
    end
  end
  select
    when op = 1 then do
      if kx = 6 & ky = 6 then return mkstr(ob_s[x % 2] || ob_s[y % 2])
      if kx = 31 & ky = 31 then return bytes_like(x, ob_s[x % 2] || ob_s[y % 2])
      if kx = 7 & ky = 7 then do
        o = mklist(ob_n[x % 2] + ob_n[y % 2])
        call list_extend_from o, x
        call list_extend_from o, y
        return o
      end
      if kx = 8 & ky = 8 then do
        n = ob_n[x % 2] + ob_n[y % 2]
        o = mktuple(n)
        do i = 0 to ob_n[x % 2] - 1
          sl[ob_p[o % 2] + i] = sl[ob_p[x % 2] + i]
        end
        do i = 0 to ob_n[y % 2] - 1
          sl[ob_p[o % 2] + ob_n[x % 2] + i] = sl[ob_p[y % 2] + i]
        end
        return o
      end
    end
    when op = 3 then do
      if kx = 31 & numkind(y) = 1 then return bytes_rep(x, ival(y))
      if ky = 31 & numkind(x) = 1 then return bytes_rep(y, ival(x))
      if (kx = 6 | kx = 7 | kx = 8) & numkind(y) = 1 then return seq_repeat(x, ival(y))
      if (ky = 6 | ky = 7 | ky = 8) & numkind(x) = 1 then return seq_repeat(y, ival(x))
    end
    when op = 6 then do
      if kx = 6 then return fmt_percent(ob_s[x % 2], y)
    end
    when op = 11 | op = 10 | op = 2 | op = 12 then do
      if kx = 10 & ky = 10 then return set_op(op, x, y)
      if kx = 9 & ky = 9 & op = 11 then do
        o = dict_copy(x)
        call dict_update o, y
        return o
      end
    end
    otherwise nop
  end
  return err_binop(op_sym(op), x, y)

/* x as a set object: sets, key / item views and other iterables (0 with an exception) */
as_set: procedure = .int
  arg x = .int
  l = .int
  o = .int
  i = .int
  if kind_of(x) = 10 then return x
  l = iter_list(x)
  if l = 0 then return 0
  o = dict_new(10)
  do i = 0 to ob_n[l % 2] - 1
    call dset o, sl[ob_p[l % 2] + i], 4
  end
  return o

seq_repeat: procedure = .int
  arg x = .int, n = .int
  k = .int
  o = .int
  i = .int
  j = .int
  m = .int
  k = ob_k[x % 2]
  if n < 0 then n = 0
  if k = 6 then return mkstr(copies(ob_s[x % 2], n))
  m = ob_n[x % 2]
  if k = 7 then o = mklist(m * n)
  else o = mktuple(m * n)
  if k = 7 then do
    do i = 1 to n
      do j = 0 to m - 1
        call list_append o, sl[ob_p[x % 2] + j]
      end
    end
  end
  else do
    do i = 0 to n - 1
      do j = 0 to m - 1
        sl[ob_p[o % 2] + i * m + j] = sl[ob_p[x % 2] + j]
      end
    end
  end
  return o

list_extend_from: procedure = .void
  arg o = .int, src = .int
  i = .int
  do i = 0 to ob_n[src % 2] - 1
    call list_append o, sl[ob_p[src % 2] + i]
  end
  return

dict_copy: procedure = .int
  arg x = .int
  o = .int
  e = .int
  d = .int
  o = dict_new(ob_k[x % 2])
  d = ob_x[x % 2]
  e = dd_head[d]
  do while e > 0
    if de_live[e] = 1 then call dict_put ob_x[o % 2], de_hk[e], de_key[e], de_val[e]
    e = de_next[e]
  end
  return o

dict_update: procedure = .void
  arg o = .int, src = .int
  e = .int
  e = dd_head[ob_x[src % 2]]
  do while e > 0
    if de_live[e] = 1 then call dict_put ob_x[o % 2], de_hk[e], de_key[e], de_val[e]
    e = de_next[e]
  end
  return

set_op: procedure = .int
  arg op = .int, x = .int, y = .int
  o = .int
  e = .int
  dx = .int
  dy = .int
  dx = ob_x[x % 2]
  dy = ob_x[y % 2]
  o = dict_new(10)
  e = dd_head[dx]
  do while e > 0
    if de_live[e] = 1 then do
      if op = 11 then call dict_put ob_x[o % 2], de_hk[e], de_key[e], 4
      else if op = 10 then do
        if dict_find(dy, de_hk[e]) > 0 then call dict_put ob_x[o % 2], de_hk[e], de_key[e], 4
      end
      else if op = 2 then do
        if dict_find(dy, de_hk[e]) = 0 then call dict_put ob_x[o % 2], de_hk[e], de_key[e], 4
      end
      else do
        if dict_find(dy, de_hk[e]) = 0 then call dict_put ob_x[o % 2], de_hk[e], de_key[e], 4
      end
    end
    e = de_next[e]
  end
  if op = 11 | op = 12 then do
    e = dd_head[dy]
    do while e > 0
      if de_live[e] = 1 then do
        if op = 11 then call dict_put ob_x[o % 2], de_hk[e], de_key[e], 4
        else do
          if dict_find(dx, de_hk[e]) = 0 then call dict_put ob_x[o % 2], de_hk[e], de_key[e], 4
        end
      end
      e = de_next[e]
    end
  end
  return o

unary: procedure = .int
  arg op = .int, x = .int
  k = .int
  a = .int
  r = .int
  m = .int
  if kind_of(x) = 29 then return np_unary(op, x)
  if kind_of(x) = 32 then return cplx_unary(op, x)
  k = numkind(x)
  if op = 1 then do
    if k = 1 then return mkint(0 - ival(x))
    if k = 3 then return mkfloat(fneg(ob_f[x % 2]))
    if k = 2 then return big_norm(sneg(ob_s[x % 2]))
    if kind_of(x) = 17 then do
      m = cls_find(ob_c[x % 2], 175)
      if m > 0 then return call1(m, x)
    end
    return raise_exc(38, "bad operand type for unary -: '" || type_name(x) || "'")
  end
  if op = 2 then do
    if k = 1 then return mkint(ival(x))
    if k > 0 then return x
    if kind_of(x) = 17 then do
      m = cls_find(ob_c[x % 2], 180)
      if m > 0 then return call1(m, x)
    end
    return raise_exc(38, "bad operand type for unary +: '" || type_name(x) || "'")
  end
  if k = 1 then do
    a = ival(x)
    assembler inot r, a
    return mkint(r)
  end
  if k = 2 then return big_norm(ssub(sneg(ob_s[x % 2]), "1"))
  if kind_of(x) = 17 then do
    m = cls_find(ob_c[x % 2], 162)
    if m > 0 then return call1(m, x)
  end
  return raise_exc(38, "bad operand type for unary ~: '" || type_name(x) || "'")

/* numeric comparison: -1, 0, 1 or 2 (unordered) */
numcmp: procedure = .int
  arg x = .int, y = .int
  kx = .int
  ky = .int
  fx = .float
  fy = .float
  a = .int
  b = .int
  kx = numkind(x)
  ky = numkind(y)
  if kx = 3 | ky = 3 then do
    fx = tofloat(x)
    fy = tofloat(y)
    if fx \= fx | fy \= fy then return 2
    if fx < fy then return -1
    if fx > fy then return 1
    return 0
  end
  if kx = 1 & ky = 1 then do
    a = ival(x)
    b = ival(y)
    if a < b then return -1
    if a > b then return 1
    return 0
  end
  return scmp(num_str(x), num_str(y))

/* equality of two values; returns 0/1 (errors set unw) */
py_eq: procedure = .int
  arg x = .int, y = .int
  kx = .int
  ky = .int
  i = .int
  n = .int
  e = .int
  m = .int
  r = .int
  d = .int
  if x = y then do
    if x // 2 = 0 then do
      if ob_k[x % 2] = 5 then do
        if ob_f[x % 2] \= ob_f[x % 2] then return 0
      end
    end
    return 1
  end
  if x // 2 \= 0 & y // 2 \= 0 then return 0
  kx = kind_of(x)
  ky = kind_of(y)
  if numkind(x) > 0 & numkind(y) > 0 then do
    if numcmp(x, y) = 0 then return 1
    return 0
  end
  if kx = 6 & ky = 6 then do
    if ob_s[x % 2] == ob_s[y % 2] then return 1
    return 0
  end
  if kx = 32 | ky = 32 then return cplx_eq(x, y)
  if kx = 31 & ky = 31 then do
    if ob_s[x % 2] == ob_s[y % 2] then return 1
    return 0
  end
  if kx = 30 | ky = 30 then do
    if kx = 30 then do
      if ob_n[x % 2] = 2 then return 0
    end
    if ky = 30 then do
      if ob_n[y % 2] = 2 then return 0
    end
    if kx = 30 & ky = 30 | kx = 10 | ky = 10 then do
      m = as_set(x)
      if m = 0 then return 0
      r = as_set(y)
      if r = 0 then return 0
      return py_eq(m, r)
    end
    return 0
  end
  if kx = 21 & ky = 21 then do
    if py_eq(ob_n[x % 2], ob_n[y % 2]) = 1 & py_eq(ob_x[x % 2], ob_x[y % 2]) = 1 & py_eq(ob_y[x % 2], ob_y[y % 2]) = 1 then return 1
    return 0
  end
  if kx = 17 then do
    m = cls_find(ob_c[x % 2], 147)
    if m > 0 then do
      r = call2(m, x, y)
      if r = 0 then return 0
      if r = 10 then return 0
      return truthy(r)
    end
    return 0
  end
  if ky = 17 then do
    m = cls_find(ob_c[y % 2], 147)
    if m > 0 then do
      r = call2(m, y, x)
      if r = 0 then return 0
      if r = 10 then return 0
      return truthy(r)
    end
    return 0
  end
  if (kx = 7 & ky = 7) | (kx = 8 & ky = 8) then do
    n = ob_n[x % 2]
    if n \= ob_n[y % 2] then return 0
    do i = 0 to n - 1
      if py_eq(sl[ob_p[x % 2] + i], sl[ob_p[y % 2] + i]) = 0 then return 0
      if unw > 0 then return 0
    end
    return 1
  end
  if kx = 9 & ky = 9 then do
    if dd_n[ob_x[x % 2]] \= dd_n[ob_x[y % 2]] then return 0
    e = dd_head[ob_x[x % 2]]
    do while e > 0
      if de_live[e] = 1 then do
        d = dict_find(ob_x[y % 2], de_hk[e])
        if d = 0 then return 0
        if py_eq(de_val[e], de_val[d]) = 0 then return 0
      end
      e = de_next[e]
    end
    return 1
  end
  if kx = 10 & ky = 10 then do
    if dd_n[ob_x[x % 2]] \= dd_n[ob_x[y % 2]] then return 0
    e = dd_head[ob_x[x % 2]]
    do while e > 0
      if de_live[e] = 1 then do
        if dict_find(ob_x[y % 2], de_hk[e]) = 0 then return 0
      end
      e = de_next[e]
    end
    return 1
  end
  if kx = 11 & ky = 11 then do
    if range_len(x) = 0 & range_len(y) = 0 then return 1
    if range_len(x) = range_len(y) & ob_n[x % 2] = ob_n[y % 2] & ob_y[x % 2] = ob_y[y % 2] then return 1
    return 0
  end
  if kx = 14 & ky = 14 then do
    if ob_x[x % 2] = ob_x[y % 2] & ob_y[x % 2] = ob_y[y % 2] then return 1
  end
  return 0

cmp_res: procedure = .int
  arg op = .int, c = .int
  if op = 3 then do
    if c < 0 then return 4
    return 6
  end
  if op = 4 then do
    if c <= 0 then return 4
    return 6
  end
  if op = 5 then do
    if c > 0 then return 4
    return 6
  end
  if c >= 0 then return 4
  return 6

/* rich comparison; op is CMP_LT .. CMP_GE; result is a bool oop or 0 on error */
py_cmp: procedure = .int
  arg op = .int, x = .int, y = .int
  kx = .int
  ky = .int
  c = .int
  m = .int
  r = .int
  nid = .int
  rnid = .int
  i = .int
  n = .int
  n2 = .int
  eq = .int
  a = .int
  b = .int
  s1 = .string
  s2 = .string
  kx = numkind(x)
  ky = numkind(y)
  if kx > 0 & ky > 0 then do
    c = numcmp(x, y)
    if c = 2 then return 6
    return cmp_res(op, c)
  end
  kx = kind_of(x)
  ky = kind_of(y)
  if kx = 6 & ky = 6 then do
    s1 = ob_s[x % 2]
    s2 = ob_s[y % 2]
    c = 1
    if s1 << s2 then c = -1
    else if s1 == s2 then c = 0
    return cmp_res(op, c)
  end
  if kx = 31 & ky = 31 then do
    s1 = ob_s[x % 2]
    s2 = ob_s[y % 2]
    c = 1
    if s1 << s2 then c = -1
    else if s1 == s2 then c = 0
    return cmp_res(op, c)
  end
  if (kx = 7 & ky = 7) | (kx = 8 & ky = 8) then do
    n = ob_n[x % 2]
    n2 = ob_n[y % 2]
    i = 0
    do while i < n & i < n2
      a = sl[ob_p[x % 2] + i]
      b = sl[ob_p[y % 2] + i]
      eq = py_eq(a, b)
      if unw > 0 then return 0
      if eq = 0 then do
        /* the first differing element decides */
        return py_cmp(op, a, b)
      end
      i = i + 1
    end
    c = 1
    if n < n2 then c = -1
    else if n = n2 then c = 0
    return cmp_res(op, c)
  end
  if kx = 10 & ky = 10 then do
    return set_cmp(op, x, y)
  end
  if ocls(x) > 0 | ocls(y) > 0 then do
    nid = cmpd[op]
    rnid = cmpr[op]
    if ocls(x) > 0 then do
      m = ovr(x, nid)
      if m > 0 then do
        r = call2(m, x, y)
        if r \= 10 then return r
        if unw > 0 then return 0
      end
    end
    if ocls(y) > 0 then do
      m = ovr(y, rnid)
      if m > 0 then do
        r = call2(m, y, x)
        if r \= 10 then return r
        if unw > 0 then return 0
      end
    end
  end
  s1 = "<"
  if op = 4 then s1 = "<="
  if op = 5 then s1 = ">"
  if op = 6 then s1 = ">="
  return raise_exc(38, "'" || s1 || "' not supported between instances of '" || type_name(x) || "' and '" || type_name(y) || "'")

set_cmp: procedure = .int
  arg op = .int, x = .int, y = .int
  sub = .int
  e = .int
  dx = .int
  dy = .int
  dx = ob_x[x % 2]
  dy = ob_x[y % 2]
  /* op LE: x subset of y ; GE: y subset of x ; LT/GT proper */
  if op = 4 | op = 3 then do
    e = dd_head[dx]
    do while e > 0
      if de_live[e] = 1 then do
        if dict_find(dy, de_hk[e]) = 0 then return 6
      end
      e = de_next[e]
    end
    if op = 3 & dd_n[dx] = dd_n[dy] then return 6
    return 4
  end
  e = dd_head[dy]
  do while e > 0
    if de_live[e] = 1 then do
      if dict_find(dx, de_hk[e]) = 0 then return 6
    end
    e = de_next[e]
  end
  if op = 5 & dd_n[dx] = dd_n[dy] then return 6
  return 4

/* x in container: 0/1, errors set unw */
py_contains: procedure = .int
  arg c = .int, x = .int
  k = .int
  i = .int
  n = .int
  e = .int
  m = .int
  r = .int
  it = .int
  v = .int
  a = .int
  b = .int
  st = .int
  b = ob_x[c % 2]
  k = kind_of(c)
  if c // 2 = 0 then do
    if ob_c[c % 2] > 0 then do
      m = nsov(c, 140)
      if m > 0 then do
        r = call2(m, c, x)
        if r = 0 then return 0
        return truthy(r)
      end
    end
  end
  select
    when k = 31 then return bytes_contains(c, x)
    when k = 6 then do
      if kind_of(x) \= 6 then do
        call raise_exc 38, "'in <string>' requires string as left operand, not " || type_name(x)
        return 0
      end
      if pos(ob_s[x % 2], ob_s[c % 2]) > 0 | ob_s[x % 2] == "" then return 1
      return 0
    end
    when k = 7 | k = 8 then do
      n = ob_n[c % 2]
      do i = 0 to n - 1
        if py_eq(sl[ob_p[c % 2] + i], x) = 1 then return 1
        if unw > 0 then return 0
      end
      return 0
    end
    when k = 9 | k = 10 then do
      if dict_find(ob_x[c % 2], hashkey(x)) > 0 then return 1
      return 0
    end
    when k = 29 then do
      n = ob_n[c % 2]
      do i = 0 to n - 1
        if py_eq(np_scalar(c, i), x) = 1 then return 1
      end
      return 0
    end
    when k = 30 then do
      n = ob_n[c % 2]
      b = ob_x[ob_x[c % 2] % 2]
      if n = 1 then do
        if dict_find(b, hashkey(x)) > 0 then return 1
        return 0
      end
      e = dd_head[b]
      do while e > 0
        if de_live[e] = 1 then do
          if n = 2 then do
            if py_eq(de_val[e], x) = 1 then return 1
          end
          else if kind_of(x) = 8 then do
            if ob_n[x % 2] = 2 then do
              if py_eq(de_key[e], sl[ob_p[x % 2]]) = 1 & py_eq(de_val[e], sl[ob_p[x % 2] + 1]) = 1 then return 1
            end
          end
        end
        e = de_next[e]
      end
      return 0
    end
    when k = 11 then do
      if numkind(x) \= 1 then return 0
      v = ival(x)
      a = ob_n[c % 2]
      b = ob_x[c % 2]
      st = ob_y[c % 2]
      if st > 0 then do
        if v < a | v >= b then return 0
      end
      else do
        if v > a | v <= b then return 0
      end
      if (v - a) // st = 0 then return 1
      return 0
    end
    when k = 17 then do
      m = cls_find(ob_c[c % 2], 140)
      if m > 0 then do
        r = call2(m, c, x)
        if r = 0 then return 0
        return truthy(r)
      end
      it = iter_new(c)
      if it = 0 then return 0
      do forever
        v = iter_next(it)
        if v = 0 then leave
        if py_eq(v, x) = 1 then return 1
        if unw > 0 then return 0
      end
      return 0
    end
    when k = 19 | k = 20 then do
      do forever
        v = iter_next(c)
        if v = 0 then leave
        if py_eq(v, x) = 1 then return 1
      end
      return 0
    end
    otherwise do
      call raise_exc 38, "argument of type '" || type_name(c) || "' is not iterable"
      return 0
    end
  end
  return 0

/* ---------------------------------------------------------------------
   repr and str
   --------------------------------------------------------------------- */
repr_str: procedure = .string
  arg s = .string
  q = .string
  r = .string
  i = .int
  n = .int
  c = .string
  v = .int
  q = "'"
  if pos("'", s) > 0 & pos('"', s) = 0 then q = '"'
  r = q
  n = length(s)
  do i = 1 to n
    c = substr(s, i, 1)
    if c == q | c == "\" then r = r || "\" || c
    else if c == '0a'x then r = r || "\n"
    else if c == '09'x then r = r || "\t"
    else if c == '0d'x then r = r || "\r"
    else do
      v = c2d(c)
      if v < 32 | v = 127 then r = r || "\x" || lower(right(d2x(v), 2, "0"))
      else r = r || c
    end
  end
  return r || q

repr_of: procedure = .string
  arg x = .int
  k = .int
  s = .string
  i = .int
  n = .int
  m = .int
  r = .int
  e = .int
  d = .int
  first = .int
  c = .int
  if x // 2 \= 0 then return ((x - 1) % 2) as .string
  k = ob_k[x % 2]
  if ob_c[x % 2] > 0 then do
    m = nsov(x, 185)
    if m > 0 then do
      r = call1(m, x)
      if r = 0 then return ""
      if kind_of(r) \= 6 then do
        call raise_exc 38, "__repr__ returned non-string (type " || type_name(r) || ")"
        return ""
      end
      return ob_s[r % 2]
    end
  end
  select
    when k = 6 then return repr_str(ob_s[x % 2])
    when k = 31 then do
      if ob_y[x % 2] = 1 then return "bytearray(" || bytes_repr(ob_s[x % 2]) || ")"
      return bytes_repr(ob_s[x % 2])
    end
    when k = 32 then return cplx_repr(ob_f[x % 2], ob_g[x % 2])
    when k = 5 then return float_repr(ob_f[x % 2])
    when k = 4 then return ob_s[x % 2]
    when k = 2 then do
      if x = 4 then return "True"
      return "False"
    end
    when k = 1 then return "None"
    when k = 7 | k = 8 then do
      n = ob_n[x % 2]
      if depth_guard > 200 then return "..."
      depth_guard = depth_guard + 1
      if k = 7 then s = "["
      else s = "("
      do i = 0 to n - 1
        if i > 0 then s = s || ", "
        s = s || repr_of(sl[ob_p[x % 2] + i])
        if unw > 0 then do
          depth_guard = depth_guard - 1
          return ""
        end
      end
      depth_guard = depth_guard - 1
      if k = 8 & n = 1 then s = s || ","
      if k = 7 then return s || "]"
      return s || ")"
    end
    when k = 9 then do
      if depth_guard > 200 then return "{...}"
      depth_guard = depth_guard + 1
      s = "{"
      first = 1
      e = dd_head[ob_x[x % 2]]
      do while e > 0
        if de_live[e] = 1 then do
          if first = 0 then s = s || ", "
          first = 0
          s = s || repr_of(de_key[e]) || ": " || repr_of(de_val[e])
          if unw > 0 then do
            depth_guard = depth_guard - 1
            return ""
          end
        end
        e = de_next[e]
      end
      depth_guard = depth_guard - 1
      return s || "}"
    end
    when k = 10 then do
      if dd_n[ob_x[x % 2]] = 0 then do
        if ob_c[x % 2] > 0 then return cl_name[ob_c[x % 2]] || "()"
        return "set()"
      end
      s = "{"
      first = 1
      e = dd_head[ob_x[x % 2]]
      do while e > 0
        if de_live[e] = 1 then do
          if first = 0 then s = s || ", "
          first = 0
          s = s || repr_of(de_key[e])
        end
        e = de_next[e]
      end
      if ob_c[x % 2] > 0 then return cl_name[ob_c[x % 2]] || "(" || s || "})"
      return s || "}"
    end
    when k = 30 then do
      r = iter_list(x)
      if r = 0 then return ""
      if ob_n[x % 2] = 1 then return "dict_keys(" || repr_of(r) || ")"
      if ob_n[x % 2] = 2 then return "dict_values(" || repr_of(r) || ")"
      return "dict_items(" || repr_of(r) || ")"
    end
    when k = 21 then do
      return "slice(" || repr_of(ob_n[x % 2]) || ", " || repr_of(ob_x[x % 2]) || ", " || repr_of(ob_y[x % 2]) || ")"
    end
    when k = 11 then do
      s = "range(" || ob_n[x % 2] || ", " || ob_x[x % 2]
      if ob_y[x % 2] \= 1 then s = s || ", " || ob_y[x % 2]
      return s || ")"
    end
    when k = 12 then return "<function " || fd_name[ob_x[x % 2]] || " at 0x" || right(d2x(x * 8), 12, "0") || ">"
    when k = 13 then return "<built-in function " || bi_name[ob_x[x % 2]] || ">"
    when k = 16 then do
      c = ob_x[x % 2]
      if cl_flags[c] // 2 = 1 then return "<class '" || cl_name[c] || "'>"
      return "<class '" || modname_of(cl_mod[c]) || "." || cl_name[c] || "'>"
    end
    when k = 18 then return "<module '" || ob_s[x % 2] || "'>"
    when k = 14 then return "<bound method " || fd_name[ob_x[ob_x[x % 2] % 2]] || " of " || repr_of(ob_y[x % 2]) || ">"
    when k = 19 then return "<generator object " || fd_name[gn_fd[ob_x[x % 2]]] || " at 0x" || right(d2x(x * 8), 12, "0") || ">"
    when k = 20 then return "<iterator object at 0x" || right(d2x(x * 8), 12, "0") || ">"
    when k = 28 then return "NotImplemented"
    when k = 29 then return np_repr(x)
    when k = 27 then return "Ellipsis"
    when k = 17 then do
      m = cls_find(ob_c[x % 2], 185)
      if m > 0 then do
        r = call1(m, x)
        if r = 0 then return ""
        if kind_of(r) \= 6 then do
          call raise_exc 38, "__repr__ returned non-string (type " || type_name(r) || ")"
          return ""
        end
        return ob_s[r % 2]
      end
      return inst_repr0(x)
    end
    otherwise return "<object at 0x" || right(d2x(x * 8), 12, "0") || ">"
  end
  return "?"

inst_repr0: procedure = .string
  arg x = .int
  if cls_issub(ob_c[x % 2], 27) = 1 then return exc_repr(x)
  return "<" || modname_of(cl_mod[ob_c[x % 2]]) || "." || cl_name[ob_c[x % 2]] || " object at 0x" || right(d2x(x * 8), 12, "0") || ">"

exc_args: procedure = .int
  arg x = .int
  a = .int
  a = inst_get(x, 8)
  if a = 0 then return mktuple(0)
  return a

exc_repr: procedure = .string
  arg x = .int
  a = .int
  s = .string
  a = exc_args(x)
  s = repr_of(a)
  if ob_n[a % 2] = 1 then s = left(s, length(s) - 2) || ")"
  return cl_name[ob_c[x % 2]] || s

exc_str: procedure = .string
  arg x = .int
  a = .int
  a = exc_args(x)
  if ob_n[a % 2] = 0 then return ""
  if ob_n[a % 2] = 1 then do
    if cls_issub(ob_c[x % 2], 35) = 1 then return repr_of(sl[ob_p[a % 2]])
    return str_of(sl[ob_p[a % 2]])
  end
  if ob_n[a % 2] = 2 & cls_issub(ob_c[x % 2], 53) = 1 then do
    if sl[ob_p[a % 2]] // 2 = 1 then return "[Errno " || str_of(sl[ob_p[a % 2]]) || "] " || str_of(sl[ob_p[a % 2] + 1])
  end
  return repr_of(a)

str_of: procedure = .string
  arg x = .int
  k = .int
  m = .int
  r = .int
  if x // 2 \= 0 then return ((x - 1) % 2) as .string
  k = ob_k[x % 2]
  if ob_c[x % 2] > 0 then do
    m = nsov(x, 197)
    if m > 0 then do
      r = call1(m, x)
      if r = 0 then return ""
      if kind_of(r) \= 6 then do
        call raise_exc 38, "__str__ returned non-string (type " || type_name(r) || ")"
        return ""
      end
      return ob_s[r % 2]
    end
  end
  if k = 6 then return ob_s[x % 2]
  if k = 29 then return np_str(x)
  if k = 17 then do
    m = cls_find(ob_c[x % 2], 197)
    if m > 0 then do
      r = call1(m, x)
      if r = 0 then return ""
      if kind_of(r) \= 6 then do
        call raise_exc 38, "__str__ returned non-string (type " || type_name(r) || ")"
        return ""
      end
      return ob_s[r % 2]
    end
    if cls_issub(ob_c[x % 2], 27) = 1 then return exc_str(x)
  end
  return repr_of(x)

/* ---------------------------------------------------------------------
   Frames, calls, attributes
   --------------------------------------------------------------------- */
alloc_frame: procedure = .int
  arg size = .int
  fb = .int
  i = .int
  fb = fl_head[size]
  if fb > 0 then fl_head[size] = vp[fb]
  else do
    fb = nvp + 1
    nvp = nvp + size
  end
  do i = 0 to size - 1
    vp[fb + i] = 0
  end
  return fb

free_frame: procedure = .void
  arg fb = .int, size = .int
  if size > maxfs then maxfs = size
  vp[fb] = fl_head[size]
  fl_head[size] = fb
  return

/* push an argument on the staging stack */
push: procedure = .void
  arg v = .int
  asp = asp + 1
  ast[asp] = v
  asn[asp] = ""
  return

/* insert v before the first argument at ast[base+1 ..] (total entries = tot) */
ast_insert: procedure = .void
  arg base = .int, tot = .int, v = .int
  i = .int
  do i = tot to 1 by -1
    ast[base + i + 1] = ast[base + i]
    asn[base + i + 1] = asn[base + i]
  end
  ast[base + 1] = v
  asn[base + 1] = ""
  asp = base + tot + 1
  return

call0: procedure = .int
  arg f = .int, a = .int
  return call1(f, a)

call1: procedure = .int
  arg f = .int, a = .int
  base = .int
  r = .int
  base = asp
  call push a
  r = docall(f, base, 1, 0)
  asp = base
  return r

call2: procedure = .int
  arg f = .int, a = .int, b = .int
  base = .int
  r = .int
  base = asp
  call push a
  call push b
  r = docall(f, base, 2, 0)
  asp = base
  return r

call3: procedure = .int
  arg f = .int, a = .int, b = .int, c = .int
  base = .int
  r = .int
  base = asp
  call push a
  call push b
  call push c
  r = docall(f, base, 3, 0)
  asp = base
  return r

callz: procedure = .int
  arg f = .int
  base = .int
  r = .int
  base = asp
  r = docall(f, base, 0, 0)
  asp = base
  return r

/* call f with the arguments ast[base+1 .. base+na] positional and na+1 .. na+nk keywords */
docall: procedure = .int
  arg f = .int, base = .int, na = .int, nk = .int
  k = .int
  r = .int
  m = .int
  c = .int
  if f // 2 \= 0 then return raise_exc(38, "'int' object is not callable")
  k = ob_k[f % 2]
  select
    when k = 12 then return callfunc(f, base, na, nk)
    when k = 13 then return bcall(ob_x[f % 2], base, na, nk)
    when k = 14 then do
      call ast_insert base, na + nk, ob_y[f % 2]
      return docall(ob_x[f % 2], base, na + 1, nk)
    end
    when k = 15 then do
      if ob_c[f % 2] = 1 then return bmeth_unbound(ob_x[ob_y[f % 2] % 2], ob_x[f % 2], base, na, nk)
      return bmeth(ob_y[f % 2], ob_x[f % 2], base, na, nk)
    end
    when k = 16 then return instantiate(ob_x[f % 2], base, na, nk)
    when k = 17 then do
      m = cls_find(ob_c[f % 2], 138)
      if m = 0 then return raise_exc(38, "'" || type_name(f) || "' object is not callable")
      call ast_insert base, na + nk, f
      return docall(m, base, na + 1, nk)
    end
    when k = 23 then return docall(ob_x[f % 2], base, na, nk)
    otherwise return raise_exc(38, "'" || type_name(f) || "' object is not callable")
  end
  return 0

fd_missing: procedure = .int
  arg fd = .int, names = .string, cnt = .int
  if cnt = 1 then return raise_exc(38, fd_name[fd] || "() missing 1 required positional argument: " || names)
  return raise_exc(38, fd_name[fd] || "() missing " || cnt || " required positional arguments: " || names)

/* general argument binding; returns 1 or 0 (error) */
bind_args: procedure = .int
  arg f = .int, fd = .int, nf = .int, base = .int, na = .int, nk = .int
  i = .int
  j = .int
  np = .int
  r0 = .int
  nr = .int
  kd = .int
  nm = .string
  found = .int
  sl0 = .int
  kw = .int
  miss = .string
  nmiss = .int
  d = .int
  extra = .int
  t = .int
  np = fd_np[fd]
  r0 = fd_ps[fd]
  nr = fd_nr[fd]
  /* positional */
  do i = 1 to na
    if i <= np then vp[nf + 1 + i] = ast[base + i]
  end
  if na > np then do
    if fd_vs[fd] = 0 then do
      call raise_exc 38, fd_name[fd] || "() takes " || np || " positional argument" || plural(np) || " but " || na || " were given"
      return 0
    end
    vp[nf + fd_vs[fd]] = tup_from_ast(base + np + 1, base + na)
  end
  else if fd_vs[fd] > 0 then vp[nf + fd_vs[fd]] = mktuple(0)
  if fd_ks[fd] > 0 then vp[nf + fd_ks[fd]] = dict_new(9)
  /* keywords */
  do kw = 1 to nk
    nm = asn[base + na + kw]
    found = 0
    do j = 1 to nr
      kd = pr_kind[r0 + j - 1]
      if (kd = 0 | kd = 2) & pr_name[r0 + j - 1] == nm then do
        if vp[nf + pr_slot[r0 + j - 1]] \= 0 then do
          call raise_exc 38, fd_name[fd] || "() got multiple values for argument '" || nm || "'"
          return 0
        end
        vp[nf + pr_slot[r0 + j - 1]] = ast[base + na + kw]
        found = 1
        leave
      end
    end
    if found = 0 then do
      if fd_ks[fd] > 0 then call dset vp[nf + fd_ks[fd]], mkstr(nm), ast[base + na + kw]
      else do
        call raise_exc 38, fd_name[fd] || "() got an unexpected keyword argument '" || nm || "'"
        return 0
      end
    end
  end
  /* defaults and missing */
  nmiss = 0
  miss = ""
  do j = 1 to nr
    kd = pr_kind[r0 + j - 1]
    if kd = 0 | kd = 2 then do
      if vp[nf + pr_slot[r0 + j - 1]] = 0 then do
        d = sl[ob_p[f % 2] + j - 1]
        if d \= 0 then vp[nf + pr_slot[r0 + j - 1]] = d
        else do
          nmiss = nmiss + 1
          if nmiss > 1 then miss = miss || " and "
          miss = miss || "'" || pr_name[r0 + j - 1] || "'"
        end
      end
    end
  end
  if nmiss > 0 then do
    call fd_missing fd, miss, nmiss
    return 0
  end
  return 1

plural: procedure = .string
  arg n = .int
  if n = 1 then return ""
  return "s"

callfunc: procedure = .int
  arg f = .int, base = .int, na = .int, nk = .int
  fd = .int
  nf = .int
  size = .int
  np = .int
  i = .int
  r = .int
  d = .int
  ok = .int
  fx = .int
  mi = .int
  sv_g = .int
  pm = .int
  fd = ob_x[f % 2]
  size = fd_ns[fd]
  np = fd_np[fd]
  nf = alloc_frame(size)
  vp[nf + 1] = ob_y[f % 2]
  if nk = 0 & fd_cx[fd] = 0 & na <= np then do
    do i = 1 to na
      vp[nf + 1 + i] = ast[base + i]
    end
    if na < np then do
      do i = na + 1 to np
        d = sl[ob_p[f % 2] + i - 1]
        if d = 0 then do
          call free_frame nf, size
          return fd_missing(fd, "'" || pr_name[fd_ps[fd] + i - 1] || "'", 1)
        end
        vp[nf + 1 + i] = d
      end
    end
  end
  else do
    ok = bind_args(f, fd, nf, base, na, nk)
    if ok = 0 then do
      call free_frame nf, size
      return 0
    end
  end
  if fd_fl[fd] // 2 = 1 then return gen_new(fd, nf)
  cdepth = cdepth + 1
  if cdepth > 900 then do
    cdepth = cdepth - 1
    return raise_exc(43, "maximum recursion depth exceeded")
  end
  wd = wd + 1
  pm = ny
  mi = fd_mod[fd]
  if mi \= cur_mi then do
    sv_g = cur_mi
    cur_mi = mi
    gfb = mod_fb[mi]
    call ex fd_body[fd], nf
    cur_mi = sv_g
    gfb = mod_fb[sv_g]
  end
  else call ex fd_body[fd], nf
  cdepth = cdepth - 1
  if unw = 1 then do
    unw = 0
    r = unw_v
  end
  else if unw = 0 then r = 2
  else r = 0
  if (fd_fl[fd] // 4) < 2 then call free_frame nf, size
  else do
    ncf = ncf + 1
    cfl[ncf] = nf
    fcm[nf] = 1
    fcs[nf] = size
  end
  if ny - pm + npw >= gcthr then call gc_run pm, r
  wd = wd - 1
  if wd = 0 then ny = 0
  return r

/* instantiate a class */
instantiate: procedure = .int
  arg c = .int, base = .int, na = .int, nk = .int
  inst = .int
  init = .int
  r = .int
  fl = .int
  fl = cl_flags[c]
  if fl // 2 = 1 & (fl // 4) < 2 then return bcall_type(c, base, na, nk)
  init = cls_find(c, 176)
  if init > 0 then return inst_with_new(c, init, base, na, nk)
  if cl_bt[c] > 0 then return inst_native(c, base, na, nk)
  inst = inst_new(c)
  if (fl // 4) >= 2 then do
    call inst_set inst, 8, tup_from_ast(base + 1, base + na)
    if na >= 2 & cls_issub(c, 53) = 1 then do
      call inst_set inst, nameid("errno"), ast[base + 1]
      call inst_set inst, nameid("strerror"), ast[base + 2]
    end
  end
  init = cls_find(c, 160)
  if init > 0 then do
    call ast_insert base, na + nk, inst
    r = docall(init, base, na + 1, nk)
    if r = 0 then return 0
    if r \= 2 then return raise_exc(38, "__init__() should return None, not '" || type_name(r) || "'")
  end
  else if na + nk > 0 & (fl // 4) < 2 then return raise_exc(38, cl_name[c] || "() takes no arguments")
  return inst

/* ---------------------------------------------------------------------
   Attributes
   --------------------------------------------------------------------- */
no_attr: procedure = .int
  arg o = .int, nid = .int
  if kind_of(o) = 16 then return raise_exc(41, "type object '" || cl_name[ob_x[o % 2]] || "' has no attribute '" || nid_name[nid] || "'")
  if kind_of(o) = 18 then return raise_exc(41, "module '" || ob_s[o % 2] || "' has no attribute '" || nid_name[nid] || "'")
  return raise_exc(41, "'" || type_name(o) || "' object has no attribute '" || nid_name[nid] || "'")

mkbmeth: procedure = .int
  arg fn = .int, slf = .int
  o = .int
  o = newobj(14)
  ob_x[o % 2] = fn
  ob_y[o % 2] = slf
  return o

/* a value found in a class table, as seen from instance o (o = 0 for the class itself) */
bind_attr: procedure = .int
  arg v = .int, o = .int, c = .int
  k = .int
  k = kind_of(v)
  if k = 12 | k = 13 then do
    if o = 0 then return v
    return mkbmeth(v, o)
  end
  if k = 22 then do
    if o = 0 then return v
    return call1(ob_x[v % 2], o)
  end
  if k = 23 then return ob_x[v % 2]
  if k = 24 then return mkbmeth(ob_x[v % 2], cl_obj[c])
  if k = 15 & o > 0 then do
    if ob_c[v % 2] = 1 then return mkbmethb(o, ob_x[v % 2])
  end
  return v

getattr_obj: procedure = .int
  arg o = .int, nid = .int, node = .int
  k = .int
  ix = .int
  c = .int
  s = .string
  v = .int
  slot = .int
  m = .int
  k = kind_of(o)
  if k \= 17 then do
    if o // 2 = 0 then do
      if ob_c[o % 2] > 0 then do
        c = nsub(o)
        if c > 0 then do
          v = nat_getattr(o, c, nid)
          if v \= 0 then return v
          if unw > 0 then return 0
        end
      end
    end
  end
  if k = 17 then do
    ix = o % 2
    c = ob_c[ix]
    if node > 0 then do
      if n_ic[node] = c & n_iv[node] < 0 then do
        v = sl[ob_p[ix] - n_iv[node] - 1]
        if v \= 0 then return v
      end
    end
    s = sm[c || "." || nid]
    if s \== "" then do
      slot = s as .int
      v = sl[ob_p[ix] + slot - 1]
      if v \= 0 then do
        if node > 0 then do
          n_ic[node] = c
          n_iv[node] = 0 - slot
        end
        return v
      end
    end
    v = cls_find(c, nid)
    if v > 0 then return bind_attr(v, o, c)
    if nid = 139 then return cl_obj[c]
    m = cls_find(c, 154)
    if m > 0 then return call2(m, o, mkstr(nid_name[nid]))
    if nid = 143 then return inst_dict(o)
    return no_attr(o, nid)
  end
  if k = 21 then do
    if nid = 109 then return ob_n[o % 2]
    if nid = 113 then return ob_x[o % 2]
    if nid = 112 then return ob_y[o % 2]
  end
  if k = 16 then do
    c = ob_x[o % 2]
    v = cls_find(c, nid)
    if v > 0 then do
      if kind_of(v) = 24 then return mkbmeth(ob_x[v % 2], o)
      if kind_of(v) = 23 then return ob_x[v % 2]
      return v
    end
    if nid = 174 | nid = 182 then return mkstr(cl_name[c])
    if nid = 136 then do
      v = mktuple(cl_bn[c])
      do ix = 0 to cl_bn[c] - 1
        sl[ob_p[v % 2] + ix] = cl_obj[bs_a[cl_bs[c] + ix]]
      end
      return v
    end
    if nid = 172 then return cls_mro(c)
    if nid = 143 then return cls_dict(c)
    if nid = 170 then return mkstr(modname_of(cl_mod[c]))
    if nid = 145 then return 2
    if nid = 139 then return cl_obj[2]
    ix = c
    if cl_flags[c] // 2 \= 1 then ix = cl_bt[c]
    if ix = 1 then ix = 0
    if ix > 0 & pos(" " || nid_name[nid] || " ", bm_names) > 0 then do
      v = mkbmethb(cl_obj[ix], nid)
      ob_c[v % 2] = 1
      return v
    end
    return no_attr(o, nid)
  end
  if k = 18 then do
    v = mod_getattr(o, nid)
    if v \= 0 then return v
    if unw > 0 then return 0
    return no_attr(o, nid)
  end
  if k = 25 then do
    v = super_find(o, nid)
    if v = bi_oop[49] then do
      if nsub(ob_x[o % 2]) > 0 then return mkbmethb(ob_x[o % 2], nid)
    end
    if v = 0 then do
      c = ob_x[o % 2]
      if kind_of(c) \= 16 then return mkbmethb(c, nid)
      if nid = 176 then return mkbmethb(cl_obj[super_base(o)], nid)
      return raise_exc(41, "'super' object has no attribute '" || nid_name[nid] || "'")
    end
    return bind_attr(v, ob_x[o % 2], sup_c)
  end
  if k = 12 then do
    s = fnattr[o || "." || nid]
    if s \== "" then return s as .int
    if nid = 174 | nid = 182 then return mkstr(fd_name[ob_x[o % 2]])
    if nid = 145 then return 2
    if nid = 139 then return cl_obj[13]
    return no_attr(o, nid)
  end
  if k = 13 then do
    if nid = 174 then return mkstr(bi_name[ob_x[o % 2]])
    return no_attr(o, nid)
  end
  if k = 14 then do
    if nid = 174 then return mkstr(fd_name[ob_x[ob_x[o % 2] % 2]])
    if nid = 194 then return ob_y[o % 2]
    if nid = 152 then return ob_x[o % 2]
    return no_attr(o, nid)
  end
  if k = 22 then do
    if nid = 103 then return mkbmethb(o, nid)
    if nid = 42 then return mkbmethb(o, nid)
    return no_attr(o, nid)
  end
  if nid = 139 then return cl_obj[cls_of(o)]
  if nid = 174 & k = 19 then return mkstr(fd_name[gn_fd[ob_x[o % 2]]])
  if k = 3 | k = 2 | k = 4 then do
    if nid = 87 | nid = 77 then return o
    if nid = 44 then return mkint(0)
    if nid = 23 then return mkint(1)
  end
  if k = 5 then do
    if nid = 87 then return o
    if nid = 44 then return mkfloat(0.0)
  end
  if k = 32 then do
    if nid = 87 then return mkfloat(ob_f[o % 2])
    if nid = 44 then return mkfloat(ob_g[o % 2])
  end
  if k = 11 then do
    if nid = 109 then return mkint(ob_n[o % 2])
    if nid = 113 then return mkint(ob_x[o % 2])
    if nid = 112 then return mkint(ob_y[o % 2])
  end
  if k = 26 then do
    if nid = 75 then return mkstr(ob_s[o % 2])
    if nid = 17 then return mkbool(ob_c[o % 2])
  end
  if k = 29 then do
    v = np_attr(o, nid)
    if v \= 0 then return v
  end
  if k = 1 then return no_attr(o, nid)
  if k = 6 | k = 7 | k = 9 | k = 10 | k = 8 | k = 3 | k = 4 | k = 2 | k = 5 then do
    if known_meth(k, nid_name[nid]) = 0 then return no_attr(o, nid)
  end
  return mkbmethb(o, nid)

/* is nm a method of the built-in type of kind k? */
known_meth: procedure = .int
  arg k = .int, nm = .string
  l = .string
  if left(nm, 2) == "__" then do
    if k = 3 | k = 4 | k = 2 | k = 5 then do
      if nm == "__len__" | nm == "__iter__" | nm == "__getitem__" | nm == "__contains__" | nm == "__next__" | nm == "__call__" then return 0
    end
    else if nm == "__next__" | nm == "__call__" then return 0
    return 1
  end
  select
    when k = 6 then l = " capitalize casefold center count encode endswith expandtabs find format format_map index isalnum isalpha isascii isdecimal isdigit isidentifier islower isnumeric isprintable isspace istitle isupper join ljust lower lstrip maketrans partition removeprefix removesuffix replace rfind rindex rjust rpartition rsplit rstrip split splitlines startswith strip swapcase title translate upper zfill "
    when k = 7 then l = " append clear copy count extend index insert pop remove reverse sort "
    when k = 8 then l = " count index "
    when k = 9 then l = " clear copy fromkeys get items keys pop popitem setdefault update values "
    when k = 10 then l = " add clear copy difference difference_update discard intersection intersection_update isdisjoint issubset issuperset pop remove symmetric_difference symmetric_difference_update union update "
    when k = 5 then l = " is_integer hex fromhex as_integer_ratio conjugate "
    otherwise l = " bit_length bit_count conjugate to_bytes from_bytes as_integer_ratio is_integer "
  end
  if pos(" " || nm || " ", l) > 0 then return 1
  return 0

cls_mro: procedure = .int
  arg c = .int
  l = .int
  i = .int
  l = mklist(4)
  do i = 0 to cl_mn[c] - 1
    call list_append l, cl_obj[mro_a[cl_ms[c] + i]]
  end
  return tup_of_list(l)

/* the next definition of nid after the defining class of super object o in the linearisation
   of the receiver; sup_c is set to the receiver class */
super_find: procedure = .int
  arg o = .int, nid = .int
  selfv = .int
  dcls = .int
  start = .int
  st = .int
  n = .int
  i = .int
  p = .int
  v = .string
  selfv = ob_x[o % 2]
  dcls = ob_x[ob_y[o % 2] % 2]
  if kind_of(selfv) = 16 then start = ob_x[selfv % 2]
  else start = cls_of(selfv)
  sup_c = start
  st = cl_ms[start]
  n = cl_mn[start]
  p = n
  do i = 0 to n - 1
    if mro_a[st + i] = dcls then do
      p = i
      leave
    end
  end
  do i = p + 1 to n - 1
    v = ca[mro_a[st + i] || "." || nid]
    if v \== "" then return v as .int
  end
  return 0

mkbmethb: procedure = .int
  arg o = .int, nid = .int
  b = .int
  b = newobj(15)
  ob_x[b % 2] = nid
  ob_y[b % 2] = o
  return b

/* attribute lookup for a call: a plain function found in the class is returned unbound
   with ev_self set to the receiver; built-in type methods return 1 with ev_bm = 1 */
getattr_call: procedure = .int
  arg o = .int, nid = .int, node = .int
  k = .int
  c = .int
  v = .int
  s = .string
  ix = .int
  slot = .int
  ev_self = 0
  ev_bm = 0
  k = kind_of(o)
  if k = 17 then do
    ix = o % 2
    c = ob_c[ix]
    if node > 0 then do
      if n_ic[node] = c & n_ig[node] = cgen & n_iv[node] > 0 then do
        ev_self = o
        return n_iv[node]
      end
    end
    s = sm[c || "." || nid]
    if s \== "" then do
      slot = s as .int
      v = sl[ob_p[ix] + slot - 1]
      if v \= 0 then return v
    end
    v = cls_find(c, nid)
    if v > 0 then do
      if kind_of(v) = 12 then do
        ev_self = o
        if node > 0 & s == "" then do
          n_ic[node] = c
          n_ig[node] = cgen
          n_iv[node] = v
        end
        return v
      end
      return bind_attr(v, o, c)
    end
    v = getattr_obj(o, nid, 0)
    /* a __getattr__ body may have run calls that left ev_self / ev_bm set */
    ev_self = 0
    ev_bm = 0
    return v
  end
  if k \= 17 then do
    if o // 2 = 0 then do
      if ob_c[o % 2] > 0 then do
        c = nsub(o)
        if c > 0 then do
          v = nat_holder(o)
          if v > 0 then do
            v = inst_get(v, nid)
            if v \= 0 then return v
          end
          v = cls_find(c, nid)
          if v > 0 then do
            if kind_of(v) = 12 then do
              ev_self = o
              return v
            end
            return bind_attr(v, o, c)
          end
        end
      end
    end
  end
  if k = 6 | k = 7 | k = 9 | k = 8 | k = 10 | k = 5 | k = 3 | k = 4 | k = 2 | k = 19 | k = 26 | k = 11 | k = 29 | k = 31 | k = 32 then do
    if nid = 139 | nid = 174 then return getattr_obj(o, nid, 0)
    if (k = 3 | k = 4 | k = 2 | k = 5) & (nid = 87 | nid = 44) then return getattr_obj(o, nid, 0)
    ev_bm = 1
    ev_self = o
    return 1
  end
  if k = 25 then do
    v = super_find(o, nid)
    if v = bi_oop[49] then do
      if nsub(ob_x[o % 2]) > 0 then return mkbmethb(ob_x[o % 2], nid)
    end
    if v = 0 then do
      c = ob_x[o % 2]
      if kind_of(c) \= 16 then return mkbmethb(c, nid)
      if nid = 176 then return mkbmethb(cl_obj[super_base(o)], nid)
      return raise_exc(41, "'super' object has no attribute '" || nid_name[nid] || "'")
    end
    ev_self = ob_x[o % 2]
    if kind_of(v) = 12 | kind_of(v) = 13 then return v
    return bind_attr(v, ob_x[o % 2], sup_c)
  end
  if k = 16 then do
    c = ob_x[o % 2]
    v = cls_find(c, nid)
    if v > 0 then do
      if kind_of(v) = 24 then return mkbmeth(ob_x[v % 2], o)
      if kind_of(v) = 23 then return ob_x[v % 2]
      return v
    end
    if cl_flags[c] // 2 = 1 then do
      /* str.upper(s) style unbound call of a builtin type method */
      ev_bm = 2
      ev_self = c
      return 1
    end
  end
  v = getattr_obj(o, nid, 0)
  ev_self = 0
  ev_bm = 0
  return v

setattr_raw: procedure = .void
  arg o = .int, nid = .int, v = .int
  p = .int
  r = .int
  if nsub(o) > 0 then do
    call nat_setattr o, nsub(o), nid, v, 1
    return
  end
  if kind_of(o) \= 17 then do
    call setattr_obj o, nid, v
    return
  end
  p = cls_find(ob_c[o % 2], nid)
  if p > 0 then do
    if kind_of(p) = 22 then do
      if ob_y[p % 2] = 0 then do
        r = raise_exc(41, "can't set attribute '" || nid_name[nid] || "'")
        return
      end
      r = call2(ob_y[p % 2], o, v)
      return
    end
  end
  call inst_set o, nid, v
  return

setattr_obj: procedure = .void
  arg o = .int, nid = .int, v = .int
  k = .int
  c = .int
  p = .int
  r = .int
  k = kind_of(o)
  if k \= 17 then do
    if nsub(o) > 0 then do
      call nat_setattr o, nsub(o), nid, v, 0
      return
    end
  end
  if k = 17 then do
    c = ob_c[o % 2]
    p = cls_find(c, nid)
    if p > 0 then do
      if kind_of(p) = 22 then do
        if ob_y[p % 2] = 0 then do
          r = raise_exc(41, "can't set attribute '" || nid_name[nid] || "'")
          return
        end
        r = call2(ob_y[p % 2], o, v)
        return
      end
    end
    p = cls_find(c, 195)
    if p > 0 & nid \= 139 then do
      r = call3(p, o, mkstr(nid_name[nid]), v)
      return
    end
    call inst_set o, nid, v
    return
  end
  if k = 16 then do
    call cls_set ob_x[o % 2], nid, v
    return
  end
  if k = 12 then do
    ob_c[o % 2] = 1
    fnattr[o || "." || nid] = v as .string
    return
  end
  if k = 18 then do
    call mod_setattr o, nid, v
    return
  end
  r = raise_exc(41, "'" || type_name(o) || "' object has no attribute '" || nid_name[nid] || "'")
  return

/* ---------------------------------------------------------------------
   Items, slices, targets, iterators
   --------------------------------------------------------------------- */
mkchr: procedure = .int
  arg ch = .string
  c = .int
  c = c2d(ch)
  if c < 256 & length(ch) = 1 then do
    if chr_oop[c + 1] = 0 then chr_oop[c + 1] = mkstr(ch)
    return chr_oop[c + 1]
  end
  return mkstr(ch)

/* normalise slice bounds for a sequence of length n; result in sl_a (start), sl_b (step), sl_n (count) */
slice_calc: procedure = .int
  arg n = .int, lo = .int, hi = .int, st = .int
  step = .int
  lower = .int
  upper = .int
  start = .int
  stop = .int
  v = .int
  if st = 2 | st = 0 then step = 1
  else do
    if numkind(st) \= 1 then return raise_exc(38, "slice indices must be integers or None or have an __index__ method")
    step = ival(st)
  end
  if step = 0 then return raise_exc(36, "slice step cannot be zero")
  if step > 0 then do
    lower = 0
    upper = n
  end
  else do
    lower = -1
    upper = n - 1
  end
  if lo = 2 | lo = 0 then do
    if step > 0 then start = lower
    else start = upper
  end
  else do
    if numkind(lo) \= 1 then return raise_exc(38, "slice indices must be integers or None or have an __index__ method")
    start = ival(lo)
    if start < 0 then start = start + n
    if start < lower then start = lower
    if start > upper then start = upper
  end
  if hi = 2 | hi = 0 then do
    if step > 0 then stop = upper
    else stop = lower
  end
  else do
    if numkind(hi) \= 1 then return raise_exc(38, "slice indices must be integers or None or have an __index__ method")
    stop = ival(hi)
    if stop < 0 then stop = stop + n
    if stop < lower then stop = lower
    if stop > upper then stop = upper
  end
  sl_a = start
  sl_b = step
  if step > 0 then do
    if stop > start then sl_n = (stop - start - 1) % step + 1
    else sl_n = 0
  end
  else do
    if start > stop then sl_n = (start - stop - 1) % (0 - step) + 1
    else sl_n = 0
  end
  return 1

getslice: procedure = .int
  arg o = .int, lo = .int, hi = .int, st = .int
  k = .int
  r = .int
  i = .int
  p = .int
  s = .string
  res = .string
  t = .int
  k = kind_of(o)
  if k = 29 then do
    t = newobj(21)
    ob_n[t % 2] = lo
    ob_x[t % 2] = hi
    ob_y[t % 2] = st
    return np_getitem(o, t)
  end
  if k = 31 then return bytes_slice(o, lo, hi, st)
  if k = 6 then do
    s = ob_s[o % 2]
    r = slice_calc(length(s), lo, hi, st)
    if r = 0 then return 0
    if sl_b = 1 then return mkstr(substr(s, sl_a + 1, sl_n))
    res = ""
    p = sl_a
    do i = 1 to sl_n
      res = res || substr(s, p + 1, 1)
      p = p + sl_b
    end
    return mkstr(res)
  end
  if k = 7 | k = 8 then do
    r = slice_calc(ob_n[o % 2], lo, hi, st)
    if r = 0 then return 0
    if k = 7 then t = mklist(sl_n)
    else t = mktuple(sl_n)
    p = sl_a
    do i = 0 to sl_n - 1
      if k = 7 then call list_append t, sl[ob_p[o % 2] + p]
      else sl[ob_p[t % 2] + i] = sl[ob_p[o % 2] + p]
      p = p + sl_b
    end
    return t
  end
  if k = 11 then do
    r = slice_calc(range_len(o), lo, hi, st)
    if r = 0 then return 0
    return mkrange(ob_n[o % 2] + sl_a * ob_y[o % 2], ob_n[o % 2] + (sl_a + sl_n * sl_b) * ob_y[o % 2], sl_b * ob_y[o % 2])
  end
  if k = 17 then do
    r = cls_find(ob_c[o % 2], 155)
    if r > 0 then do
      t = newobj(21)
      ob_n[t % 2] = lo
      ob_x[t % 2] = hi
      ob_y[t % 2] = st
      return call2(r, o, t)
    end
  end
  return raise_exc(38, "'" || type_name(o) || "' object is not subscriptable")

idx_int: procedure = .int
  arg x = .int
  if x // 2 \= 0 then return (x - 1) % 2
  if ob_k[x % 2] = 2 then return ival(x)
  if ob_k[x % 2] = 4 then return ival(x)
  return 0

getitem: procedure = .int
  arg o = .int, ix = .int
  k = .int
  i = .int
  n = .int
  e = .int
  m = .int
  t = .int
  s = .string
  a = .int
  st = .int
  ix = unsub(ix)
  if o // 2 \= 0 then return raise_exc(38, "'int' object is not subscriptable")
  k = ob_k[o % 2]
  if k = 29 then return np_getitem(o, ix)
  if k = 31 then do
    if ix // 2 = 0 then do
      if ob_k[ix % 2] = 21 then return bytes_slice(o, ob_n[ix % 2], ob_x[ix % 2], ob_y[ix % 2])
    end
    if ob_c[o % 2] = 0 then return bytes_geti(o, ix)
  end
  if ob_c[o % 2] > 0 then do
    m = nsov(o, 155)
    if m > 0 then return call2(m, o, ix)
    if k = 31 then return bytes_geti(o, ix)
  end
  if k = 7 | k = 8 then do
    if ix // 2 = 0 & ob_k[ix % 2] \= 2 then do
      if ob_k[ix % 2] = 21 then return getslice(o, ob_n[ix % 2], ob_x[ix % 2], ob_y[ix % 2])
      if kind_of(ix) = 17 then do
        m = cls_find(ob_c[ix % 2], 159)
        if m > 0 then ix = call1(m, ix)
      end
      else return raise_exc(38, "list indices must be integers or slices, not " || type_name(ix))
    end
    i = idx_int(ix)
    n = ob_n[o % 2]
    if i < 0 then i = i + n
    if i < 0 | i >= n then do
      if k = 7 then return raise_exc(34, "list index out of range")
      return raise_exc(34, "tuple index out of range")
    end
    return sl[ob_p[o % 2] + i]
  end
  if k = 9 then do
    e = dict_find(ob_x[o % 2], hashkey(ix))
    if e > 0 then return de_val[e]
    if ob_y[o % 2] \= 0 then do
      t = callz(ob_y[o % 2])
      if t = 0 then return 0
      call dict_put ob_x[o % 2], hashkey(ix), ix, t
      return t
    end
    if ob_c[o % 2] > 0 then do
      m = nsov(o, 169)
      if m > 0 then return call2(m, o, ix)
    end
    return raise_key(ix)
  end
  if k = 6 then do
    if ix // 2 = 0 & ob_k[ix % 2] = 21 then return getslice(o, ob_n[ix % 2], ob_x[ix % 2], ob_y[ix % 2])
    if ix // 2 = 0 & ob_k[ix % 2] \= 2 then return raise_exc(38, "string indices must be integers, not '" || type_name(ix) || "'")
    i = idx_int(ix)
    s = ob_s[o % 2]
    n = length(s)
    if i < 0 then i = i + n
    if i < 0 | i >= n then return raise_exc(34, "string index out of range")
    return mkchr(substr(s, i + 1, 1))
  end
  if k = 11 then do
    if ix // 2 = 0 & ob_k[ix % 2] = 21 then return getslice(o, ob_n[ix % 2], ob_x[ix % 2], ob_y[ix % 2])
    i = idx_int(ix)
    n = range_len(o)
    if i < 0 then i = i + n
    if i < 0 | i >= n then return raise_exc(34, "range object index out of range")
    return mkint(ob_n[o % 2] + i * ob_y[o % 2])
  end
  if k = 17 then do
    m = cls_find(ob_c[o % 2], 155)
    if m > 0 then return call2(m, o, ix)
    return raise_exc(38, "'" || type_name(o) || "' object is not subscriptable")
  end
  if k = 16 then return o
  return raise_exc(38, "'" || type_name(o) || "' object is not subscriptable")

raise_key: procedure = .int
  arg key = .int
  e = .int
  t = .int
  e = inst_new(35)
  t = mktuple(1)
  sl[ob_p[t % 2]] = key
  call inst_set e, 8, t
  return raise_obj(e)

setitem: procedure = .void
  arg o = .int, ix = .int, v = .int
  k = .int
  i = .int
  n = .int
  m = .int
  r = .int
  it = .int
  src = .int
  newl = .int
  j = .int
  cnt = .int
  ix = unsub(ix)
  if o // 2 \= 0 then do
    r = raise_exc(38, "'int' object does not support item assignment")
    return
  end
  k = ob_k[o % 2]
  if k = 29 then do
    call np_setitem o, ix, v
    return
  end
  if ob_c[o % 2] > 0 then do
    m = nsov(o, 196)
    if m > 0 then do
      r = call3(m, o, ix, v)
      return
    end
  end
  if k = 31 then do
    call bytes_seti o, ix, v
    return
  end
  if k = 7 then do
    if ix // 2 = 0 & ob_k[ix % 2] = 21 then do
      call setslice o, ob_n[ix % 2], ob_x[ix % 2], ob_y[ix % 2], v
      return
    end
    if ix // 2 = 0 & ob_k[ix % 2] \= 2 then do
      r = raise_exc(38, "list indices must be integers or slices, not " || type_name(ix))
      return
    end
    i = idx_int(ix)
    n = ob_n[o % 2]
    if i < 0 then i = i + n
    if i < 0 | i >= n then do
      r = raise_exc(34, "list assignment index out of range")
      return
    end
    sl[ob_p[o % 2] + i] = v
    return
  end
  if k = 9 then do
    call dict_put ob_x[o % 2], hashkey(ix), ix, v
    return
  end
  if k = 17 then do
    m = cls_find(ob_c[o % 2], 196)
    if m > 0 then do
      r = call3(m, o, ix, v)
      return
    end
  end
  r = raise_exc(38, "'" || type_name(o) || "' object does not support item assignment")
  return

setslice: procedure = .void
  arg o = .int, lo = .int, hi = .int, st = .int, v = .int
  r = .int
  src = .int
  newl = .int
  i = .int
  j = .int
  n = .int
  cnt = .int
  p = .int
  n = ob_n[o % 2]
  r = slice_calc(n, lo, hi, st)
  if r = 0 then return
  src = iter_list(v)
  if src = 0 then return
  if sl_b = 1 then do
    newl = mklist(n + ob_n[src % 2])
    do i = 0 to sl_a - 1
      call list_append newl, sl[ob_p[o % 2] + i]
    end
    do i = 0 to ob_n[src % 2] - 1
      call list_append newl, sl[ob_p[src % 2] + i]
    end
    do i = sl_a + sl_n to n - 1
      call list_append newl, sl[ob_p[o % 2] + i]
    end
    call orphan_block ob_p[o % 2], ob_x[o % 2]
    ob_p[o % 2] = ob_p[newl % 2]
    ob_n[o % 2] = ob_n[newl % 2]
    ob_x[o % 2] = ob_x[newl % 2]
    ob_p[newl % 2] = 0
    ob_n[newl % 2] = 0
    ob_x[newl % 2] = 0
    return
  end
  if ob_n[src % 2] \= sl_n then do
    r = raise_exc(36, "attempt to assign sequence of size " || ob_n[src % 2] || " to extended slice of size " || sl_n)
    return
  end
  p = sl_a
  do i = 0 to sl_n - 1
    sl[ob_p[o % 2] + p] = sl[ob_p[src % 2] + i]
    p = p + sl_b
  end
  return

delitem: procedure = .void
  arg o = .int, ix = .int
  k = .int
  i = .int
  n = .int
  m = .int
  r = .int
  e = .int
  j = .int
  newl = .int
  ix = unsub(ix)
  k = kind_of(o)
  if o // 2 = 0 then do
    if ob_c[o % 2] > 0 then do
      m = nsov(o, 142)
      if m > 0 then do
        r = call2(m, o, ix)
        return
      end
    end
  end
  if k = 31 then do
    call bytes_deli o, ix
    return
  end
  if k = 7 then do
    if ix // 2 = 0 & ob_k[ix % 2] = 21 then do
      r = slice_calc(ob_n[o % 2], ob_n[ix % 2], ob_x[ix % 2], ob_y[ix % 2])
      if r = 0 then return
      newl = mklist(ob_n[o % 2])
      do i = 0 to ob_n[o % 2] - 1
        j = 0
        if sl_b > 0 then do
          if i >= sl_a & i < sl_a + sl_n * sl_b & (i - sl_a) // sl_b = 0 then j = 1
        end
        else do
          if i <= sl_a & i > sl_a + sl_n * sl_b & (sl_a - i) // (0 - sl_b) = 0 then j = 1
        end
        if j = 0 then call list_append newl, sl[ob_p[o % 2] + i]
      end
      call orphan_block ob_p[o % 2], ob_x[o % 2]
      ob_p[o % 2] = ob_p[newl % 2]
      ob_n[o % 2] = ob_n[newl % 2]
      ob_x[o % 2] = ob_x[newl % 2]
      ob_p[newl % 2] = 0
      ob_n[newl % 2] = 0
      ob_x[newl % 2] = 0
      return
    end
    i = idx_int(ix)
    n = ob_n[o % 2]
    if i < 0 then i = i + n
    if i < 0 | i >= n then do
      r = raise_exc(34, "list assignment index out of range")
      return
    end
    do j = i to n - 2
      sl[ob_p[o % 2] + j] = sl[ob_p[o % 2] + j + 1]
    end
    ob_n[o % 2] = n - 1
    return
  end
  if k = 9 | k = 10 then do
    e = dict_del(ob_x[o % 2], hashkey(ix))
    if e = 0 then r = raise_key(ix)
    return
  end
  if k = 17 then do
    m = cls_find(ob_c[o % 2], 142)
    if m > 0 then do
      r = call2(m, o, ix)
      return
    end
  end
  r = raise_exc(38, "'" || type_name(o) || "' object doesn't support item deletion")
  return

/* ---- assignment targets ---- */
store: procedure = .void
  arg t = .int, v = .int, fb = .int
  tt = .int
  f = .int
  d = .int
  o = .int
  r = .int
  tt = n_t[t]
  if tt = 34 then do
    vp[fb + n_a[t]] = v
    return
  end
  if tt = 27 then do
    vp[gfb + n_a[t]] = v
    return
  end
  if tt = 52 then do
    f = fb
    do d = 1 to n_b[t]
      f = vp[f + 1]
    end
    vp[f + n_a[t]] = v
    return
  end
  if tt = 4 then do
    o = ev(n_a[t], fb)
    if o = 0 then return
    call setattr_obj o, n_b[t], v
    return
  end
  if tt = 47 then do
    o = ev(n_a[t], fb)
    if o = 0 then return
    if n_t[n_b[t]] = 45 then do
      d = n_b[t]
      call setitem o, eval_slice(d, fb), v
      return
    end
    d = ev(n_b[t], fb)
    if d = 0 then return
    call setitem o, d, v
    return
  end
  if tt = 50 | tt = 33 then do
    call unpack t, v, fb
    return
  end
  r = raise_exc(38, "cannot assign")
  return

/* build a slice object from a N_SLICE node */
eval_slice: procedure = .int
  arg n = .int, fb = .int
  lo = .int
  hi = .int
  st = .int
  o = .int
  lo = 2
  hi = 2
  st = 2
  if n_a[n] > 0 then do
    lo = ev(n_a[n], fb)
    if lo = 0 then return 0
  end
  if n_b[n] > 0 then do
    hi = ev(n_b[n], fb)
    if hi = 0 then return 0
  end
  if n_c[n] > 0 then do
    st = ev(n_c[n], fb)
    if st = 0 then return 0
  end
  o = newobj(21)
  ob_n[o % 2] = lo
  ob_x[o % 2] = hi
  ob_y[o % 2] = st
  return o

unpack: procedure = .void
  arg t = .int, v = .int, fb = .int
  src = .int
  n = .int
  cnt = .int
  star = .int
  i = .int
  j = .int
  before = .int
  after = .int
  mid = .int
  item = .int
  r = .int
  tg = .int
  if kind_of(v) = 7 | kind_of(v) = 8 then src = v
  else do
    src = iter_list(v)
    if src = 0 then return
  end
  n = ob_n[src % 2]
  cnt = n_b[t]
  star = -1
  do i = 0 to cnt - 1
    if n_t[al[n_a[t] + i]] = 46 then star = i
  end
  if star < 0 then do
    if n \= cnt then do
      if n > cnt then r = raise_exc(36, "too many values to unpack (expected " || cnt || ")")
      else r = raise_exc(36, "not enough values to unpack (expected " || cnt || ", got " || n || ")")
      return
    end
    do i = 0 to cnt - 1
      call store al[n_a[t] + i], sl[ob_p[src % 2] + i], fb
      if unw > 0 then return
    end
    return
  end
  before = star
  after = cnt - 1 - star
  if n < before + after then do
    r = raise_exc(36, "not enough values to unpack (expected at least " || (before + after) || ", got " || n || ")")
    return
  end
  do i = 0 to before - 1
    call store al[n_a[t] + i], sl[ob_p[src % 2] + i], fb
    if unw > 0 then return
  end
  mid = mklist(n - before - after)
  do i = before to n - after - 1
    call list_append mid, sl[ob_p[src % 2] + i]
  end
  call store n_a[al[n_a[t] + star]], mid, fb
  if unw > 0 then return
  do i = 0 to after - 1
    call store al[n_a[t] + star + 1 + i], sl[ob_p[src % 2] + n - after + i], fb
    if unw > 0 then return
  end
  return

/* ---------------------------------------------------------------------
   Iterators
   --------------------------------------------------------------------- */
mkiter: procedure = .int
  arg sub = .int, x = .int, y = .int
  o = .int
  o = newobj(20)
  ob_n[o % 2] = sub
  ob_x[o % 2] = x
  ob_y[o % 2] = y
  return o

iter_new: procedure = .int
  arg x = .int
  k = .int
  m = .int
  r = .int
  it = .int
  if x // 2 \= 0 then return raise_exc(38, "'int' object is not iterable")
  k = ob_k[x % 2]
  if ob_c[x % 2] > 0 then do
    m = nsov(x, 163)
    if m > 0 then return iter_wrap(call1(m, x))
  end
  select
    when k = 7 | k = 8 then return mkiter(1, x, 0)
    when k = 31 then return mkiter(20, x, 0)
    when k = 6 then return mkiter(2, x, 0)
    when k = 11 then do
      it = mkiter(3, ob_n[x % 2], ob_x[x % 2])
      ob_c[it % 2] = ob_y[x % 2]
      return it
    end
    when k = 9 | k = 10 then return mkiter(4, x, dd_head[ob_x[x % 2]])
    when k = 30 then do
      r = ob_x[x % 2]
      if ob_n[x % 2] = 1 then return mkiter(4, r, dd_head[ob_x[r % 2]])
      if ob_n[x % 2] = 2 then return mkiter(6, r, dd_head[ob_x[r % 2]])
      return mkiter(5, r, dd_head[ob_x[r % 2]])
    end
    when k = 19 | k = 20 then return x
    when k = 17 then do
      m = cls_find(ob_c[x % 2], 163)
      if m > 0 then do
        r = call1(m, x)
        if r = 0 then return 0
        if kind_of(r) = 19 | kind_of(r) = 20 then return r
        if kind_of(r) = 17 then do
          if cls_find(ob_c[r % 2], 177) > 0 then return mkiter(7, r, 0)
        end
        if kind_of(r) = 7 | kind_of(r) = 8 then return mkiter(1, r, 0)
        return raise_exc(38, "iter() returned non-iterator of type '" || type_name(r) || "'")
      end
      m = cls_find(ob_c[x % 2], 155)
      if m > 0 then return mkiter(13, x, 0)
      return raise_exc(38, "'" || type_name(x) || "' object is not iterable")
    end
    when k = 26 then do
      return mkiter(14, x, 0)
    end
    when k = 29 then do
      if ob_x[x % 2] = 0 then return raise_exc(38, "iteration over a 0-d array")
      return mkiter(19, x, 0)
    end
    otherwise return raise_exc(38, "'" || type_name(x) || "' object is not iterable")
  end
  return 0

/* next item or 0 (exhausted, or an exception is pending in unw) */
iter_next: procedure = .int
  arg it = .int
  ix = .int
  sub = .int
  i = .int
  src = .int
  v = .int
  e = .int
  s = .string
  step = .int
  t = .int
  n = .int
  j = .int
  k = .int
  r = .int
  m = .int
  ix = it % 2
  if ob_k[ix] = 19 then return gen_resume(ob_x[ix], 2)
  sub = ob_n[ix]
  select
    when sub = 1 then do
      src = ob_x[ix]
      i = ob_y[ix]
      if i >= ob_n[src % 2] then return 0
      ob_y[ix] = i + 1
      return sl[ob_p[src % 2] + i]
    end
    when sub = 19 then do
      src = ob_x[ix]
      i = ob_y[ix]
      if i >= sl[ob_y[src % 2]] then return 0
      ob_y[ix] = i + 1
      return np_item0(src, i)
    end
    when sub = 3 then do
      v = ob_x[ix]
      step = ob_c[ix]
      if step > 0 then do
        if v >= ob_y[ix] then return 0
      end
      else do
        if v <= ob_y[ix] then return 0
      end
      ob_x[ix] = v + step
      return v * 2 + 1
    end
    when sub = 2 then do
      src = ob_x[ix]
      i = ob_y[ix]
      s = ob_s[src % 2]
      if i >= length(s) then return 0
      ob_y[ix] = i + 1
      return mkchr(substr(s, i + 1, 1))
    end
    when sub = 20 then do
      src = ob_x[ix]
      i = ob_y[ix]
      s = ob_s[src % 2]
      if i >= length(s) then return 0
      ob_y[ix] = i + 1
      return mkint(c2d(substr(s, i + 1, 1)))
    end
    when sub = 4 | sub = 5 | sub = 6 then do
      e = de_live_from(ob_y[ix])
      if e = 0 then return 0
      ob_y[ix] = de_next[e]
      if sub = 4 then return de_key[e]
      if sub = 6 then return de_val[e]
      t = mktuple(2)
      sl[ob_p[t % 2]] = de_key[e]
      sl[ob_p[t % 2] + 1] = de_val[e]
      return t
    end
    when sub = 7 then do
      r = call1(cls_find(ob_c[ob_x[ix] % 2], 177), ob_x[ix])
      if r = 0 then do
        if unw = 4 then do
          if cls_issub(ob_c[unw_v % 2], 45) = 1 then unw = 0
        end
      end
      return r
    end
    when sub = 8 then do
      v = iter_next(ob_x[ix])
      if v = 0 then return 0
      t = mktuple(2)
      sl[ob_p[t % 2]] = ob_y[ix] * 2 + 1
      sl[ob_p[t % 2] + 1] = v
      ob_y[ix] = ob_y[ix] + 1
      return t
    end
    when sub = 9 then do
      n = ob_c[ix]
      t = mktuple(n)
      do j = 0 to n - 1
        v = iter_next(sl[ob_p[ix] + j])
        if v = 0 then return 0
        sl[ob_p[t % 2] + j] = v
      end
      return t
    end
    when sub = 10 then do
      n = ob_c[ix]
      m = asp
      do j = 0 to n - 1
        v = iter_next(sl[ob_p[ix] + j])
        if v = 0 then do
          asp = m
          return 0
        end
        call push v
      end
      r = docall(ob_x[ix], m, n, 0)
      asp = m
      return r
    end
    when sub = 11 then do
      do forever
        v = iter_next(ob_y[ix])
        if v = 0 then return 0
        if ob_x[ix] = 0 then do
          if truthy(v) = 1 then return v
        end
        else do
          r = call1(ob_x[ix], v)
          if r = 0 then return 0
          if truthy(r) = 1 then return v
        end
        if unw > 0 then return 0
      end
    end
    when sub = 12 then do
      src = ob_x[ix]
      i = ob_y[ix]
      if i < 0 then return 0
      ob_y[ix] = i - 1
      if kind_of(src) = 6 then return mkchr(substr(ob_s[src % 2], i + 1, 1))
      return sl[ob_p[src % 2] + i]
    end
    when sub = 13 then do
      i = ob_y[ix]
      r = call2(cls_find(ob_c[ob_x[ix] % 2], 155), ob_x[ix], mkint(i))
      if r = 0 then do
        if unw = 4 then do
          if cls_issub(ob_c[unw_v % 2], 34) = 1 | cls_issub(ob_c[unw_v % 2], 45) = 1 then unw = 0
        end
        return 0
      end
      ob_y[ix] = i + 1
      return r
    end
    when sub = 14 then do
      return file_readline(ob_x[ix], 1)
    end
    when sub = 15 then do
      do forever
        src = ob_x[ix]
        if src = 0 then do
          if ob_y[ix] >= ob_n[ob_c[ix] % 2] then return 0
          src = iter_new(sl[ob_p[ob_c[ix] % 2] + ob_y[ix]])
          if src = 0 then return 0
          ob_x[ix] = src
          ob_y[ix] = ob_y[ix] + 1
        end
        v = iter_next(src)
        if v \= 0 then return v
        if unw > 0 then return 0
        ob_x[ix] = 0
      end
    end
    when sub = 16 then do
      v = ob_x[ix]
      ob_x[ix] = v + ob_y[ix]
      return v * 2 + 1
    end
    when sub = 17 then do
      if ob_c[ix] = 1 then return 0
      v = iter_next(ob_y[ix])
      if v = 0 then return 0
      r = call1(ob_x[ix], v)
      if r = 0 then return 0
      if truthy(r) = 1 then return v
      ob_c[ix] = 1
      return 0
    end
    when sub = 18 then do
      /* ob_x source, ob_y next index, ob_n2 handled via slots: stop, step, current */
      do while sl[ob_p[ix] + 2] < ob_y[ix]
        v = iter_next(ob_x[ix])
        if v = 0 then return 0
        sl[ob_p[ix] + 2] = sl[ob_p[ix] + 2] + 1
      end
      if sl[ob_p[ix]] >= 0 & ob_y[ix] >= sl[ob_p[ix]] then return 0
      v = iter_next(ob_x[ix])
      if v = 0 then return 0
      sl[ob_p[ix] + 2] = sl[ob_p[ix] + 2] + 1
      ob_y[ix] = ob_y[ix] + sl[ob_p[ix] + 1]
      return v
    end
    otherwise return 0
  end
  return 0

/* all items of an iterable as a new list (0 on error) */
iter_list: procedure = .int
  arg x = .int
  k = .int
  l = .int
  it = .int
  v = .int
  i = .int
  n = .int
  e = .int
  k = kind_of(x)
  if x // 2 = 0 then do
    if ob_c[x % 2] > 0 then do
      if nsub(x) > 0 then do
        if cls_find(nsub(x), 163) > 0 then k = 0
      end
    end
  end
  if k = 7 | k = 8 then do
    n = ob_n[x % 2]
    l = mklist(n)
    do i = 0 to n - 1
      sl[ob_p[l % 2] + i] = sl[ob_p[x % 2] + i]
    end
    ob_n[l % 2] = n
    return l
  end
  if k = 9 | k = 10 then do
    l = mklist(dd_n[ob_x[x % 2]])
    e = dd_head[ob_x[x % 2]]
    do while e > 0
      if de_live[e] = 1 then call list_append l, de_key[e]
      e = de_next[e]
    end
    return l
  end
  it = iter_new(x)
  if it = 0 then return 0
  l = mklist(8)
  do forever
    v = iter_next(it)
    if v = 0 then leave
    call list_append l, v
  end
  if unw > 0 then return 0
  return l

/* ---------------------------------------------------------------------
   Evaluator
   --------------------------------------------------------------------- */
unbound: procedure = .int
  arg n = .int
  mx = .string
  if n_t[n] = 37 & cur_mi > 0 then do
    mx = modx[cur_mi || "." || n_s[n]]
    if mx \== "" then return mx as .int
  end
  if n_t[n] = 27 | n_t[n] = 37 then return raise_exc(39, "name '" || n_s[n] || "' is not defined")
  return raise_exc(40, "cannot access local variable '" || n_s[n] || "' where it is not associated with a value")

make_func: procedure = .int
  arg fd = .int, fb = .int
  f = .int
  j = .int
  nr = .int
  dn = .int
  v = .int
  f = newobj(12)
  ob_x[f % 2] = fd
  ob_y[f % 2] = fb
  nr = fd_nr[fd]
  ob_p[f % 2] = alloc_slots(nr + 1)
  do j = 1 to nr
    dn = pr_def[fd_ps[fd] + j - 1]
    if dn > 0 then do
      v = ev(dn, fb)
      if v = 0 then return 0
      sl[ob_p[f % 2] + j - 1] = v
    end
  end
  return f

/* evaluate complex call arguments (star / keyword); returns 1 or 0 */
eval_cargs: procedure = .int
  arg n = .int, fb = .int, base = .int
  i = .int
  a = .int
  v = .int
  t = .int
  l = .int
  j = .int
  e = .int
  d = .int
  npp = .int
  nkk = .int
  nkk = 0
  do i = 0 to n_c[n] - 1
    a = al[n_b[n] + i]
    t = n_t[a]
    if t = 46 then do
      v = ev(n_a[a], fb)
      if v = 0 then return 0
      l = iter_list(v)
      if l = 0 then return 0
      do j = 0 to ob_n[l % 2] - 1
        call push sl[ob_p[l % 2] + j]
      end
    end
    else if t \= 32 & t \= 19 then do
      v = ev(a, fb)
      if v = 0 then return 0
      call push v
    end
  end
  npp = asp - base
  do i = 0 to n_c[n] - 1
    a = al[n_b[n] + i]
    t = n_t[a]
    if t = 32 then do
      v = ev(n_a[a], fb)
      if v = 0 then return 0
      call push v
      asn[asp] = n_s[a]
      nkk = nkk + 1
    end
    else if t = 19 then do
      v = ev(n_a[a], fb)
      if v = 0 then return 0
      if kind_of(v) \= 9 then do
        call raise_exc 38, "argument after ** must be a mapping, not " || type_name(v)
        return 0
      end
      e = dd_head[ob_x[v % 2]]
      do while e > 0
        if de_live[e] = 1 then do
          if kind_of(de_key[e]) \= 6 then do
            call raise_exc 38, "keywords must be strings"
            return 0
          end
          call push de_val[e]
          asn[asp] = ob_s[de_key[e] % 2]
          nkk = nkk + 1
        end
        e = de_next[e]
      end
    end
  end
  ea_np = npp
  ea_nk = nkk
  return 1

ev: procedure = .int
  arg n = .int, fb = .int
  t = .int
  v = .int
  l = .int
  r = .int
  op = .int
  o = .int
  ix = .int
  c = .int
  i = .int
  cnt = .int
  st = .int
  a = .int
  f = .int
  d = .int
  base = .int
  fnode = .int
  fv = .int
  selfo = .int
  bm = .int
  nargs = .int
  ck = .int
  k = .int
  s = .string
  e = .int
  fd = .int
  nf = .int
  it = .int
  size = .int
  sub = .int
  tv = .int
  s2 = .string
  t = n_t[n]
  if t = 34 then do
    v = vp[fb + n_a[n]]
    if v = 0 then return unbound(n)
    return v
  end
  if t = 14 then return n_a[n]
  if t = 6 then do
    l = ev(n_a[n], fb)
    if l = 0 then return 0
    r = ev(n_b[n], fb)
    if r = 0 then return 0
    op = n_c[n]
    if l // 2 \= 0 & r // 2 \= 0 then do
      if op = 1 then do
        v = l + r - 1
        if v < 1999999999999999999 & v > 0 - 1999999999999999999 then return v
      end
      else if op = 2 then do
        v = l - r + 1
        if v < 1999999999999999999 & v > 0 - 1999999999999999999 then return v
      end
    end
    return arith(op, l, r)
  end
  if t = 11 then do
    l = ev(n_a[n], fb)
    if l = 0 then return 0
    r = ev(n_b[n], fb)
    if r = 0 then return 0
    op = n_c[n]
    if l // 2 \= 0 & r // 2 \= 0 then do
      tv = 0
      select
        when op = 1 then do
          if l = r then tv = 1
        end
        when op = 2 then do
          if l \= r then tv = 1
        end
        when op = 3 then do
          if l < r then tv = 1
        end
        when op = 4 then do
          if l <= r then tv = 1
        end
        when op = 5 then do
          if l > r then tv = 1
        end
        when op = 6 then do
          if l >= r then tv = 1
        end
        otherwise tv = 2
      end
      if tv = 1 then return 4
      if tv = 0 then return 6
    end
    return cmp_general(op, l, r)
  end
  if t = 8 then do
    fnode = n_a[n]
    base = asp
    selfo = 0
    bm = 0
    if n_t[fnode] = 4 then do
      o = ev(n_a[fnode], fb)
      if o = 0 then return 0
      fv = getattr_call(o, n_b[fnode], fnode)
      if fv = 0 then return 0
      selfo = ev_self
      bm = ev_bm
    end
    else do
      fv = ev(fnode, fb)
      if fv = 0 then return 0
    end
    if selfo > 0 & bm = 0 then call push selfo
    ck = 0
    if n_d[n] = 0 then do
      nargs = n_c[n]
      st = n_b[n]
      do i = 0 to nargs - 1
        a = ev(al[st + i], fb)
        if a = 0 then do
          asp = base
          return 0
        end
        asp = asp + 1
        ast[asp] = a
        asn[asp] = ""
      end
      cnt = asp - base
    end
    else do
      if eval_cargs(n, fb, base) = 0 then do
        asp = base
        return 0
      end
      cnt = ea_np
      ck = ea_nk
    end
    if bm = 1 then r = bmeth(selfo, n_b[fnode], base, cnt, ck)
    else if bm = 2 then r = bmeth_unbound(selfo, n_b[fnode], base, cnt, ck)
    else r = docall(fv, base, cnt, ck)
    asp = base
    return r
  end
  if t = 4 then do
    o = ev(n_a[n], fb)
    if o = 0 then return 0
    return getattr_obj(o, n_b[n], n)
  end
  if t = 27 then do
    v = vp[gfb + n_a[n]]
    if v = 0 then return unbound(n)
    return v
  end
  if t = 47 then do
    o = ev(n_a[n], fb)
    if o = 0 then return 0
    ix = n_b[n]
    if n_t[ix] = 45 then do
      l = 2
      r = 2
      c = 2
      if n_a[ix] > 0 then do
        l = ev(n_a[ix], fb)
        if l = 0 then return 0
      end
      if n_b[ix] > 0 then do
        r = ev(n_b[ix], fb)
        if r = 0 then return 0
      end
      if n_c[ix] > 0 then do
        c = ev(n_c[ix], fb)
        if c = 0 then return 0
      end
      return getslice(o, l, r, c)
    end
    ix = ev(ix, fb)
    if ix = 0 then return 0
    if ix // 2 \= 0 & o // 2 = 0 then do
      if ob_k[o % 2] = 7 & ob_c[o % 2] = 0 then do
        i = (ix - 1) % 2
        if i >= 0 & i < ob_n[o % 2] then return sl[ob_p[o % 2] + i]
      end
    end
    return getitem(o, ix)
  end
  if t = 52 then do
    f = fb
    do d = 1 to n_b[n]
      f = vp[f + 1]
    end
    v = vp[f + n_a[n]]
    if v = 0 then return unbound(n)
    return v
  end
  if t = 1 then do
    l = ev(n_a[n], fb)
    if l = 0 then return 0
    if l = 4 then return ev(n_b[n], fb)
    if l = 6 | l = 2 | l = 1 then return l
    if truthy(l) = 0 then do
      if unw > 0 then return 0
      return l
    end
    return ev(n_b[n], fb)
  end
  if t = 39 then do
    l = ev(n_a[n], fb)
    if l = 0 then return 0
    if l = 4 then return l
    if l = 6 | l = 2 | l = 1 then return ev(n_b[n], fb)
    if truthy(l) = 1 then return l
    if unw > 0 then return 0
    return ev(n_b[n], fb)
  end
  if t = 38 then do
    l = ev(n_a[n], fb)
    if l = 0 then return 0
    if truthy(l) = 1 then return 6
    if unw > 0 then return 0
    return 4
  end
  if t = 30 then do
    c = ev(n_a[n], fb)
    if c = 0 then return 0
    if c = 4 then return ev(n_b[n], fb)
    if c = 6 | c = 2 then return ev(n_c[n], fb)
    v = truthy(c)
    if unw > 0 then return 0
    if v = 1 then return ev(n_b[n], fb)
    return ev(n_c[n], fb)
  end
  if t = 51 then do
    l = ev(n_a[n], fb)
    if l = 0 then return 0
    return unary(n_c[n], l)
  end
  if t = 9 then do
    cnt = n_b[n]
    st = n_a[n]
    l = ev(al[st], fb)
    if l = 0 then return 0
    do i = 1 to cnt - 1
      r = ev(al[st + i], fb)
      if r = 0 then return 0
      v = cmp_general(al[st + cnt + i - 1], l, r)
      if v = 0 then return 0
      if v = 6 then return v
      if truthy(v) = 0 then return 6
      l = r
    end
    return 4
  end
  if t = 50 | t = 33 | t = 44 then do
    cnt = n_b[n]
    st = n_a[n]
    if t = 44 then do
      o = dict_new(10)
      do i = 0 to cnt - 1
        a = al[st + i]
        if n_t[a] = 46 then do
          v = ev(n_a[a], fb)
          if v = 0 then return 0
          l = iter_list(v)
          if l = 0 then return 0
          do d = 0 to ob_n[l % 2] - 1
            call dset o, sl[ob_p[l % 2] + d], 4
          end
        end
        else do
          v = ev(a, fb)
          if v = 0 then return 0
          call dset o, v, 4
          if unw > 0 then return 0
        end
      end
      return o
    end
    o = mklist(cnt)
    do i = 0 to cnt - 1
      a = al[st + i]
      if n_t[a] = 46 then do
        v = ev(n_a[a], fb)
        if v = 0 then return 0
        l = iter_list(v)
        if l = 0 then return 0
        do d = 0 to ob_n[l % 2] - 1
          call list_append o, sl[ob_p[l % 2] + d]
        end
      end
      else do
        v = ev(a, fb)
        if v = 0 then return 0
        call list_append o, v
      end
    end
    if t = 50 then return tup_of_list(o)
    return o
  end
  if t = 18 then do
    o = dict_new(9)
    st = n_a[n]
    do i = 0 to n_b[n] - 1
      a = al[st + 2 * i]
      if a = 0 then do
        v = ev(al[st + 2 * i + 1], fb)
        if v = 0 then return 0
        if kind_of(v) \= 9 then return raise_exc(38, "'" || type_name(v) || "' object is not a mapping")
        call dict_update o, v
      end
      else do
        l = ev(a, fb)
        if l = 0 then return 0
        v = ev(al[st + 2 * i + 1], fb)
        if v = 0 then return 0
        call dset o, l, v
        if unw > 0 then return 0
      end
    end
    return o
  end
  if t = 24 then do
    s = ""
    st = n_a[n]
    do i = 0 to n_b[n] - 1
      a = al[st + i]
      if n_t[a] = 14 then s = s || ob_s[n_a[a] % 2]
      else do
        s2 = fmt_node(a, fb)
        if unw > 0 then return 0
        s = s || s2
      end
    end
    return mkstr(s)
  end
  if t = 25 then return make_func(n_a[n], fb)
  if t = 12 then do
    fd = n_a[n]
    it = ev(n_c[n], fb)
    if it = 0 then return 0
    size = fd_ns[fd]
    nf = alloc_frame(size)
    vp[nf + 1] = fb
    vp[nf + 2] = it
    k = n_b[n]
    if k = 1 then o = mklist(8)
    else if k = 3 then o = dict_new(9)
    else o = dict_new(10)
    vp[nf + 3] = o
    call ex fd_body[fd], nf
    if (fd_fl[fd] // 4) < 2 then call free_frame nf, size
    if unw > 0 then return 0
    return o
  end
  if t = 26 then do
    fd = n_a[n]
    it = ev(n_c[n], fb)
    if it = 0 then return 0
    size = fd_ns[fd]
    nf = alloc_frame(size)
    vp[nf + 1] = fb
    vp[nf + 2] = it
    return gen_new(fd, nf)
  end
  if t = 48 then do
    f = fb
    do d = 1 to n_b[n]
      f = vp[f + 1]
    end
    o = newobj(25)
    ob_x[o % 2] = vp[f + 2]
    ob_y[o % 2] = cd_obj[n_a[n]]
    return o
  end
  if t = 35 then return ev_locals(n, fb)
  if t = 37 then return unbound(n)
  if t = 45 then return eval_slice(n, fb)
  if t = 46 then return raise_exc(52, "can't use starred expression here")
  if t = 55 | t = 56 then return raise_exc(42, "yield used in an unsupported position")
  return raise_exc(42, "cannot evaluate node " || t)

/* comparison of any two values; returns a bool oop or 0 */
cmp_general: procedure = .int
  arg op = .int, l = .int, r = .int
  v = .int
  m = .int
  if op <= 6 then do
    if (kind_of(l) = 29 | kind_of(r) = 29) & kind_of(l) \= 17 & kind_of(r) \= 17 then return np_binop(30 + op, l, r)
  end
  if op = 1 | op = 2 then do
    if ocls(l) > 0 then do
      if op = 1 then m = ovr(l, 147)
      else m = ovr(l, 178)
      if m > 0 then do
        v = call2(m, l, r)
        if v = 0 then return 0
        if v \= 10 then return v
      end
    end
    if ocls(r) > 0 then do
      if op = 1 then m = ovr(r, 147)
      else m = ovr(r, 178)
      if m > 0 then do
        v = call2(m, r, l)
        if v = 0 then return 0
        if v \= 10 then return v
      end
    end
    v = py_eq(l, r)
    if unw > 0 then return 0
    if op = 2 then v = 1 - v
    if v = 1 then return 4
    return 6
  end
  if op = 9 then return mkbool(is_same(l, r))
  if op = 10 then return mkbool(1 - is_same(l, r))
  if op = 7 | op = 8 then do
    v = py_contains(r, l)
    if unw > 0 then return 0
    if op = 8 then v = 1 - v
    if v = 1 then return 4
    return 6
  end
  return py_cmp(op, l, r)

is_same: procedure = .int
  arg l = .int, r = .int
  if l = r then return 1
  if l // 2 = 0 & r // 2 = 0 then do
    if ob_k[l % 2] = 6 & ob_k[r % 2] = 6 then do
      if ob_s[l % 2] == ob_s[r % 2] & length(ob_s[l % 2]) <= 1 then return 1
    end
  end
  return 0

/* format one replacement field of an f-string */
fmt_node: procedure = .string
  arg a = .int, fb = .int
  v = .int
  sp = .string
  sv = .int
  conv = .int
  v = ev(n_a[a], fb)
  if v = 0 then return ""
  conv = n_b[a]
  if conv = 114 | conv = 97 then v = mkstr(repr_of(v))
  else if conv = 115 then v = mkstr(str_of(v))
  if unw > 0 then return ""
  sp = ""
  if n_c[a] > 0 then do
    sv = ev(n_c[a], fb)
    if sv = 0 then return ""
    sp = ob_s[sv % 2]
  end
  return format_value(v, sp)

/* ---------------------------------------------------------------------
   Statements
   --------------------------------------------------------------------- */
exc_matches: procedure = .int
  arg exc = .int, ty = .int
  i = .int
  k = .int
  k = kind_of(ty)
  if k = 16 then return cls_issub(ob_c[exc % 2], ob_x[ty % 2])
  if k = 8 then do
    do i = 0 to ob_n[ty % 2] - 1
      if exc_matches(exc, sl[ob_p[ty % 2] + i]) = 1 then return 1
    end
    return 0
  end
  call raise_exc 38, "catching classes that do not inherit from BaseException is not allowed"
  return 0

do_raise: procedure = .void
  arg v = .int
  e = .int
  k = .int
  r = .int
  k = kind_of(v)
  if k = 16 then do
    if cls_issub(ob_x[v % 2], 27) = 0 then do
      r = raise_exc(38, "exceptions must derive from BaseException")
      return
    end
    e = instantiate(ob_x[v % 2], asp + 0, 0, 0)
    if e = 0 then return
    unw = 4
    unw_v = e
    return
  end
  if k = 17 then do
    if cls_issub(ob_c[v % 2], 27) = 1 then do
      unw = 4
      unw_v = v
      return
    end
  end
  r = raise_exc(38, "exceptions must derive from BaseException")
  return

/* the in-place version of a binary operator */
aug_op_apply: procedure = .int
  arg op = .int, cur = .int, v = .int
  k = .int
  m = .int
  l = .int
  k = kind_of(cur)
  if k = 7 & op = 1 then do
    l = iter_list(v)
    if l = 0 then return 0
    call list_extend_from cur, l
    return cur
  end
  if k = 7 & op = 3 & numkind(v) = 1 then do
    l = seq_repeat(cur, ival(v))
    call orphan_block ob_p[cur % 2], ob_x[cur % 2]
    ob_p[cur % 2] = ob_p[l % 2]
    ob_n[cur % 2] = ob_n[l % 2]
    ob_x[cur % 2] = ob_x[l % 2]
    ob_p[l % 2] = 0
    ob_n[l % 2] = 0
    ob_x[l % 2] = 0
    return cur
  end
  if k = 10 & kind_of(v) = 10 & (op = 11 | op = 10 | op = 2 | op = 12) then do
    l = set_op(op, cur, v)
    ob_x[cur % 2] = ob_x[l % 2]
    ob_x[l % 2] = 0
    return cur
  end
  if k = 9 & op = 11 & kind_of(v) = 9 then do
    call dict_update cur, v
    return cur
  end
  if k = 31 then do
    if ob_y[cur % 2] = 1 then do
      if op = 1 then do
        if kind_of(v) = 31 then ob_s[cur % 2] = ob_s[cur % 2] || ob_s[v % 2]
        else do
          l = arith(op, cur, v)
          return l
        end
        return cur
      end
      if op = 3 & numkind(v) = 1 then do
        ob_s[cur % 2] = copies(ob_s[cur % 2], ival(v))
        return cur
      end
    end
  end
  if k = 29 then do
    l = arith(op, cur, v)
    if l = 0 then return 0
    return np_inplace(cur, l)
  end
  if k = 17 then do
    m = cls_find(ob_c[cur % 2], iopd[op])
    if m > 0 then return call2(m, cur, v)
  end
  return arith(op, cur, v)

ex_for: procedure = .void
  arg n = .int, fb = .int
  t = .int
  v = .int
  i = .int
  c = .int
  tv = .int
  r = .int
  o = .int
  ix = .int
  brk = .int
  st = .int
  cnt = .int
  it = .int
  a = .int
  b = .int
  stp = .int
  tg = .int
  itn = .int
  d = .int
  f = .int
  hs = .int
  h = .int
  ty = .int
  sv = .int
  sv2 = .int
  svc = .int
  m = .int
  ex1 = .int
  ex2 = .int
  base = .int
  tt = .int
  op = .int
  nm = .string
  s2 = .string
  ok_range = .int
  pm = .int
  ln = .int
  t = n_t[n]
  pm = 0
  ln = 0
  tg = n_a[n]
  itn = n_b[n]
  brk = 0
  /* fast path: for x in range(...) */
  if n_t[itn] = 8 then do
    if n_t[n_a[itn]] = 14 & n_a[n_a[itn]] = range_oop & n_d[itn] = 0 & n_c[itn] >= 1 & n_c[itn] <= 3 then do
      cnt = n_c[itn]
      st = n_b[itn]
      a = 0
      b = 0
      stp = 1
      ok_range = 1
      v = ev(al[st], fb)
      if v = 0 then return
      if v // 2 = 0 then ok_range = 0
      if cnt = 1 then b = (v - 1) % 2
      else do
        a = (v - 1) % 2
        v = ev(al[st + 1], fb)
        if v = 0 then return
        if v // 2 = 0 then ok_range = 0
        b = (v - 1) % 2
        if cnt = 3 then do
          v = ev(al[st + 2], fb)
          if v = 0 then return
          if v // 2 = 0 then ok_range = 0
          stp = (v - 1) % 2
          if stp = 0 then do
            r = raise_exc(36, "range() arg 3 must not be zero")
            return
          end
        end
      end
      if ok_range = 1 then do
        i = a
        pm = ny
        ln = pm
        do forever
          if stp > 0 then do
            if i >= b then leave
          end
          else do
            if i <= b then leave
          end
          if n_t[tg] = 34 then vp[fb + n_a[tg]] = i * 2 + 1
          else do
            call store tg, i * 2 + 1, fb
            if unw > 0 then return
          end
          call ex n_c[n], fb
          if unw > 0 then do
            if unw = 2 then do
              unw = 0
              brk = 1
              leave
            end
            else if unw = 3 then unw = 0
            else return
          end
          if ny - ln + npw >= gcthr then do
            call gc_run pm, 0
            ln = ny
          end
          i = i + stp
        end
        if brk = 0 & n_d[n] > 0 then call ex n_d[n], fb
        return
      end
    end
  end
  v = ev(itn, fb)
  if v = 0 then return
  it = iter_new(v)
  if it = 0 then return
  pm = ny
  ln = pm
  do forever
    v = iter_next(it)
    if v = 0 then do
      if unw > 0 then return
      leave
    end
    if n_t[tg] = 34 then vp[fb + n_a[tg]] = v
    else do
      call store tg, v, fb
      if unw > 0 then return
    end
    call ex n_c[n], fb
    if unw > 0 then do
      if unw = 2 then do
        unw = 0
        brk = 1
        leave
      end
      else if unw = 3 then unw = 0
      else return
    end
    if ny - ln + npw >= gcthr then do
      call gc_run pm, 0
      ln = ny
    end
  end
  if brk = 0 & n_d[n] > 0 then call ex n_d[n], fb
  return
  return

ex_while: procedure = .void
  arg n = .int, fb = .int
  t = .int
  v = .int
  i = .int
  c = .int
  tv = .int
  r = .int
  o = .int
  ix = .int
  brk = .int
  st = .int
  cnt = .int
  it = .int
  a = .int
  b = .int
  stp = .int
  tg = .int
  itn = .int
  d = .int
  f = .int
  hs = .int
  h = .int
  ty = .int
  sv = .int
  sv2 = .int
  svc = .int
  m = .int
  ex1 = .int
  ex2 = .int
  base = .int
  tt = .int
  op = .int
  nm = .string
  s2 = .string
