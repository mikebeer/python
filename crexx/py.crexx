  aliasboot = "functools.lru_cache=51 functools.cache=51 functools.wraps=51 sys.exit=40 warnings.warn=50 warnings.simplefilter=50 warnings.filterwarnings=50"
  aliasboot = aliasboot || " warnings.resetwarnings=50 abc.abstractmethod=50 abc.abstractproperty=50 os.getpid=50 sys.setrecursionlimit=50 numpy.absolute=150 numpy.around=185"
