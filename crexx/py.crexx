/* =========================================================================
   PY.CREXX  --  a Python 3 subset interpreter written in CREXX (Level B)

   Usage:
       crexx py.crexx -args [-c code] [file.py [arg ...]]
   With no file the program is read from standard input.
   ========================================================================= */
options levelb numeric_classic
import rxfnsb
import rxfloat
import _rxsysb
namespace py expose rc_exit obuf h_out h_err h_in stdin_eof rnd_s nsargs,
   sargs wsch nameboot clsboot bboot aliasboot kwlist ops2 tx tlen tp,
   lx_brk lx_nind lnum ntk tk_t tk_s tk_i tk_l tk_f ind_s tpp pe pe_msg,
   nnode n_t n_a n_b n_c n_d n_e n_y n_s n_ln n_ic n_ig n_iv nal al psp ps,
   nsc cursc sc_kind sc_par sc_n sc_fl sc_id sc_rf0 sc_cd scm nrf rf_node,
   rf_sc rf_dep ncv cv_name cv_slot cv_scope comp_result npq pq_name pq_def,
   pq_kind nfd fd_np fd_nk fd_ps fd_vs fd_ks fd_nr fd_ns fd_fl fd_cd,
   fd_body fd_cx fd_gd fd_name npr pr_name pr_def pr_kind pr_slot ncd,
   cd_name cd_body cd_ns cd_cv0 cd_cv1 cd_obj cd_sc nob ob_k ob_c ob_n ob_p,
   ob_x ob_y ob_s ob_f nsl sl sl_a sl_b sl_n chr_oop nnid nid_name nidm,
   ncls cl_name cl_base cl_ns cl_flags cl_obj cl_dflt ca sm cgen kcls opd,
   ropd iopd cmpd cmpr bimap modattr modo bi_name bi_oop range_oop,
   identity_oop ndd nde dd_head dd_tail dd_n de_key de_val de_next de_live,
   de_hk dmap nvp vp fl_head gfb asp ast asn cdepth unw unw_v exc_cur,
   ev_self ev_bm ea_np ea_nk depth_guard ngn ngs gn_fd gn_fb gn_st gn_sp,
   gn_rb gn_val gs_n gs_s gs_a gs_b nfl fl_h fl_mode fl_txt fl_pos bq brm,
   sg mg sq sr fx_d fx_q fx_e fneg_max

arg av = .string[]
call init
script = ""
code = ""
have_code = 0
nfiles = 0
ia = 1
do while ia <= av.0
  oa = av[ia]
  if oa == "-c" & ia < av.0 & nfiles = 0 & have_code = 0 then do
    ia = ia + 1
    code = av[ia]
    have_code = 1
    nsargs = nsargs + 1
    sargs[nsargs] = "-c"
  end
  else if (oa == "-h" | oa == "--help") & nfiles = 0 & have_code = 0 then do
    say "usage: py [-c code | file.py] [arg ...]"
    exit 0
  end
  else do
    if nfiles = 0 & have_code = 0 then do
      script = oa
      nfiles = 1
    end
    nsargs = nsargs + 1
    sargs[nsargs] = oa
  end
  ia = ia + 1
end
call boot
if have_code = 1 then rc_exit = run_source(code, "<string>")
else if nfiles = 1 then do
  utxt = read_file(script)
  if utxt == "" & file_exists(script) = 0 then do
    call errs "py: can't open file '" || script || "': [Errno 2] No such file or directory" || '0a'x
    rc_exit = 2
  end
  else rc_exit = run_source(utxt, script)
end
else do
  utxt = ""
  eofl = 0
  line = ""
  do forever
    line = ""
    assembler freadline line, h_in
    assembler feof eofl, h_in
    if eofl > 0 & length(line) = 0 then leave
    utxt = utxt || line || '0a'x
  end
  rc_exit = run_source(utxt, "<stdin>")
end
call flush_out
exit rc_exit

/* ---------------------------------------------------------------------
   Reading a whole file
   --------------------------------------------------------------------- */
read_file: procedure = .string
  arg fn = .string
  fid = .int
  eof = .int
  rcx = .int
  line = .string
  acc = .string
  chunk = .string
  nl = .int
  rmode = .string
  rmode = "r"
  fid = 0
  assembler fopen fid, fn, rmode
  if fid = 0 then return ""
  acc = ""
  chunk = ""
  nl = 0
  eof = 0
  do while eof = 0
    line = ""
    assembler freadline line, fid
    assembler feof eof, fid
    if eof > 0 & length(line) = 0 then leave
    if right(line, 1) == '0d'x then line = left(line, length(line) - 1)
    chunk = chunk || line || '0a'x
    nl = nl + 1
    if nl >= 100 then do
      acc = acc || chunk
      chunk = ""
      nl = 0
    end
  end
  assembler fclose rcx, fid
  return acc || chunk

file_exists: procedure = .int
  arg fn = .string
  fid = .int
  rcx = .int
  rmode = .string
  rmode = "r"
  fid = 0
  assembler fopen fid, fn, rmode
  if fid = 0 then return 0
  assembler fclose rcx, fid
  return 1

/* ---------------------------------------------------------------------
   Running a program text; returns the process exit code
   --------------------------------------------------------------------- */
run_source: procedure = .int
  arg src = .string, name = .string
  body = .int
  sc = .int
  rcode = .int
  e = .int
  c = .int
  a = .int
  s = .string
  v = .int
  ntk = 0
  nnode = 0
  nal = 0
  psp = 0
  pe = 0
  pe_msg = ""
  tpp = 1
  cursc = 0
  call lex_text src, 0
  sc = scope_push(1)
  sc_id[sc] = 0
  body = p_file()
  call scope_end sc
  if pe = 1 then do
    call errs "  File " || '"' || name || '"' || '0a'x || pe_msg || '0a'x
    return 1
  end
  gfb = alloc_frame(sc_n[1] + 1)
  unw = 0
  exc_cur = 0
  call ex body, gfb
  if unw = 0 then return 0
  rcode = 1
  if unw = 4 then do
    e = unw_v
    unw = 0
    c = ob_c[e % 2]
    if cls_issub(c, 47) = 1 then do
      a = exc_args(e)
      if ob_n[a % 2] = 0 then return 0
      v = sl[ob_p[a % 2]]
      if v = 2 then return 0
      if numkind(v) = 1 then return ival(v) // 256
      call errs str_of(v) || '0a'x
      return 1
    end
    s = str_of(e)
    unw = 0
    call errs "Traceback (most recent call last):" || '0a'x
    call errs '  File "' || name || '", line 1, in <module>' || '0a'x
    if s == "" then call errs cl_name[c] || '0a'x
    else call errs cl_name[c] || ": " || s || '0a'x
    return 1
  end
  unw = 0
  return 0

/* ---------------------------------------------------------------------
   init: declare and initialise all shared state
   --------------------------------------------------------------------- */
init: procedure = .void
  rc_exit = 0
  obuf = ""
  h_out = _open("stdout", "w")
  h_err = _open("stderr", "w")
  h_in = _open("stdin", "r")
  stdin_eof = 0
  rnd_s = 12345
  nsargs = 0
  sargs = .string[]
  wsch = '20090a0b0c0d'x
  nameboot = "add append appendleft args bit_length capitalize casefold center clear close closed conjugate copy count decode denominator difference"
  nameboot = nameboot || " difference_update discard encode endswith expandtabs extend find flush format fromkeys get getter imag index insert intersection intersection_update"
  nameboot = nameboot || " isalnum isalpha isascii isdecimal isdigit isdisjoint isidentifier islower isnumeric isspace issubset issuperset istitle isupper is_integer items join"
  nameboot = nameboot || " keys ljust lower lstrip most_common name numerator partition pop popitem popleft read readline readlines real remove removeprefix removesuffix replace"
  nameboot = nameboot || " reverse rfind rindex rjust rpartition rsplit rstrip send setdefault setter sort split splitlines start startswith step stop strip swapcase"
  nameboot = nameboot || " symmetric_difference title translate union update upper values write writelines zfill __bases__ __bool__ __call__ __class__ __contains__ __delitem__"
  nameboot = nameboot || " __dict__ __doc__ __enter__ __eq__ __exit__ __float__ __format__ __func__ __getattr__ __getitem__ __hash__ __index__ __init__ __int__ __iter__ __len__"
  nameboot = nameboot || " __module__ __mro__ __name__ __neg__ __next__ __qualname__ __repr__ __self__ __setattr__ __setitem__ __str__"
  clsboot = "object/0/1/1 type/1/1/1 int/1/1/1 float/1/1/1 bool/3/1/1 str/1/1/1 list/1/1/1 tuple/1/1/1 dict/1/1/1 set/1/1/1 range/1/1/1 NoneType/1/1/0"
  clsboot = clsboot || " function/1/1/0 builtin_function_or_method/1/1/0 method/1/1/0 generator/1/1/0 iterator/1/1/0 module/1/1/0 slice/1/1/0 ellipsis/1/1/0"
  clsboot = clsboot || " NotImplementedType/1/1/0 property/1/1/1 staticmethod/1/1/1 classmethod/1/1/1 super/1/1/1 TextIOWrapper/1/1/0 BaseException/1/3/1 Exception/27/3/1"
  clsboot = clsboot || " ArithmeticError/28/3/1 ZeroDivisionError/29/3/1 OverflowError/29/3/1 FloatingPointError/29/3/1 LookupError/28/3/1 IndexError/33/3/1 KeyError/33/3/1"
  clsboot = clsboot || " ValueError/28/3/1 UnicodeError/36/3/1 TypeError/28/3/1 NameError/28/3/1 UnboundLocalError/39/3/1 AttributeError/28/3/1 RuntimeError/28/3/1"
  clsboot = clsboot || " RecursionError/42/3/1 NotImplementedError/42/3/1 StopIteration/28/3/1 AssertionError/28/3/1 SystemExit/27/3/1 KeyboardInterrupt/27/3/1"
  clsboot = clsboot || " GeneratorExit/27/3/1 ImportError/28/3/1 ModuleNotFoundError/50/3/1 SyntaxError/28/3/1 OSError/28/3/1 FileNotFoundError/53/3/1 EOFError/28/3/1"
  bboot = "print len isinstance min max abs sum sorted enumerate zip map filter repr ascii any all round divmod pow chr ord hex oct bin issubclass getattr"
  bboot = bboot || " hasattr setattr delattr callable next iter id hash input open reversed format super exit quit _exc_init _obj_init _identity _decorator _second"
  bboot = bboot || " math.sqrt math.floor math.ceil math.trunc math.fabs math.pow math.sin math.cos math.tan math.asin math.acos math.atan math.atan2 math.sinh math.cosh"
  bboot = bboot || " math.exp math.log math.log10 math.log2 math.hypot math.tanh math.isnan math.isinf math.isfinite math.degrees math.radians math.copysign math.fmod"
  bboot = bboot || " math.cbrt math.fsum math.prod math.gcd math.lcm math.factorial math.isqrt math.comb math.perm random.seed random.random random.randint"
  bboot = bboot || " random.randrange random.uniform random.choice random.shuffle random.sample time.time time.perf_counter time.monotonic time.process_time time.sleep"
  bboot = bboot || " itertools.chain itertools.count itertools.islice itertools.takewhile itertools.product itertools.combinations itertools.permutations"
  bboot = bboot || " itertools.accumulate functools.reduce functools.partial collections.defaultdict collections.Counter collections.OrderedDict collections.deque"
  bboot = bboot || " copy.copy copy.deepcopy"
  aliasboot = "functools.lru_cache=45 functools.cache=45 functools.wraps=45 sys.exit=40 sys.setrecursionlimit=44"
  kwlist = " False None True and as assert async await break class continue def del elif else except finally for from global if import in is lambda nonlocal not or pass raise return try while with yield "
  ops2 = " == != <= >= ** // << >> += -= *= /= %= &= |= ^= @= -> := "
  /* ---- lexer ---- */
  tx = ""
  tlen = 0
  tp = 1
  lx_brk = 0
  lx_nind = 1
  lnum = 1
  ntk = 0
  tk_t = .int[]
  tk_s = .string[]
