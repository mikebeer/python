  ln = .int
  t = n_t[n]
  pm = ny
  ln = pm
  brk = 0
  do forever
    c = ev(n_a[n], fb)
    if c = 0 then return
    if c = 4 then tv = 1
    else if c = 6 | c = 2 then tv = 0
    else do
      tv = truthy(c)
      if unw > 0 then return
    end
    if tv = 0 then leave
    call ex n_b[n], fb
    if unw > 0 then do
      if unw = 2 then do
        unw = 0
        brk = 1
        leave
      end
      else if unw = 3 then unw = 0
      else return
    end
    if ny - ln + npw >= gcthr then do
      call gc_run pm, 0
      ln = ny
    end
  end
  if brk = 0 & n_c[n] > 0 then call ex n_c[n], fb
  return
  return

ex: procedure = .void
  arg n = .int, fb = .int
  t = .int
  v = .int
  i = .int
  c = .int
  tv = .int
  r = .int
  o = .int
  ix = .int
  brk = .int
  st = .int
  cnt = .int
  it = .int
  a = .int
  b = .int
  stp = .int
  tg = .int
  itn = .int
  d = .int
  f = .int
  hs = .int
  h = .int
  ty = .int
  sv = .int
  sv2 = .int
  svc = .int
  m = .int
  ex1 = .int
  ex2 = .int
  base = .int
  tt = .int
  op = .int
  nm = .string
  s2 = .string
  ok_range = .int
  t = n_t[n]
  if t = 20 then do
    v = ev(n_a[n], fb)
    return
  end
  if t = 3 then do
    v = ev(n_a[n], fb)
    if v = 0 then return
    st = n_b[n]
    do i = 0 to n_c[n] - 1
      tg = al[st + i]
      tt = n_t[tg]
      if tt = 34 then vp[fb + n_a[tg]] = v
      else do
        call store tg, v, fb
        if unw > 0 then return
      end
    end
    return
  end
  if t = 43 then do
    st = n_a[n]
    do i = 0 to n_b[n] - 1
      call ex al[st + i], fb
      if unw > 0 then return
    end
    return
  end
  if t = 42 then do
    if n_a[n] = 0 then unw_v = 2
    else do
      v = ev(n_a[n], fb)
      if v = 0 then return
      unw_v = v
    end
    unw = 1
    return
  end
  if t = 29 then do
    c = ev(n_a[n], fb)
    if c = 0 then return
    if c = 4 then tv = 1
    else if c = 6 | c = 2 then tv = 0
    else do
      tv = truthy(c)
      if unw > 0 then return
    end
    if tv = 1 then call ex n_b[n], fb
    else if n_c[n] > 0 then call ex n_c[n], fb
    return
  end
  if t = 22 then do
    wd = wd + 1
    call ex_for n, fb
    wd = wd - 1
    if wd = 0 then ny = 0
    return
  end
  if t = 53 then do
    wd = wd + 1
    call ex_while n, fb
    wd = wd - 1
    if wd = 0 then ny = 0
    return
  end
  if t = 5 then do
    tg = n_a[n]
    tt = n_t[tg]
    op = n_c[n]
    if tt = 4 then do
      o = ev(n_a[tg], fb)
      if o = 0 then return
