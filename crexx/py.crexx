  clsboot = clsboot || " ndarray/1/1/0 AxisError/36/3/0"
  bboot = "print len isinstance min max abs sum sorted enumerate zip map filter repr ascii any all round divmod pow chr ord hex oct bin issubclass getattr"
  bboot = bboot || " hasattr setattr delattr callable next iter id hash input open reversed format super exit quit globals eval exec vars dir __import__ _exc_init"
  bboot = bboot || " _obj_init _identity _decorator _second _sock math.sqrt math.floor math.ceil math.trunc math.fabs math.pow math.sin math.cos math.tan math.asin"
  bboot = bboot || " math.acos math.atan math.atan2 math.sinh math.cosh math.exp math.log math.log10 math.log2 math.hypot math.tanh math.isnan math.isinf math.isfinite"
