      if c = 0 then return
      v = ev(n_b[n], fb)
      if v = 0 then return
      r = aug_op_apply(op, c, v)
      if r = 0 then return
      call setattr_obj o, n_b[tg], r
      return
    end
    if tt = 47 then do
      o = ev(n_a[tg], fb)
      if o = 0 then return
      ix = ev(n_b[tg], fb)
      if ix = 0 then return
      c = getitem(o, ix)
      if c = 0 then return
      v = ev(n_b[n], fb)
      if v = 0 then return
      r = aug_op_apply(op, c, v)
      if r = 0 then return
      call setitem o, ix, r
      return
    end
    c = ev(tg, fb)
    if c = 0 then return
    v = ev(n_b[n], fb)
    if v = 0 then return
    if c // 2 \= 0 & v // 2 \= 0 & op = 1 then do
      r = c + v - 1
      if r >= 1999999999999999999 | r <= 0 - 1999999999999999999 then r = arith(op, c, v)
    end
    else r = aug_op_apply(op, c, v)
    if r = 0 then return
    call store tg, r, fb
    return
  end
  if t = 7 then do
    unw = 2
    return
  end
  if t = 15 then do
    unw = 3
    return
  end
  if t = 40 then return
  if t = 13 then do
    if n_c[n] = 3 then do
      ix = ev(n_b[n], fb)
      if ix = 0 then return
    end
    v = ev(n_a[n], fb)
    if v = 0 then return
    if n_c[n] = 1 then call list_append vp[fb + 3], v
    else if n_c[n] = 3 then call dset vp[fb + 3], ix, v
    else call dset vp[fb + 3], v, 4
    return
  end
  if t = 16 then do
    f = make_func(n_a[n], fb)
    if f = 0 then return
    do i = n_d[n] to 1 by -1
      v = ev(al[n_c[n] + i - 1], fb)
      if v = 0 then return
      f = call1(v, f)
      if f = 0 then return
    end
    call store n_b[n], f, fb
    return
  end
  if t = 10 then do
    call exec_class n, fb
    return
  end
  if t = 49 then do
    call exec_try n, fb
    return
  end
  if t = 41 then do
    if n_a[n] = 0 then do
      if exc_cur = 0 then do
        r = raise_exc(42, "No active exception to reraise")
        return
      end
      unw = 4
      unw_v = exc_cur
      return
    end
    v = ev(n_a[n], fb)
    if v = 0 then return
    call do_raise v
    return
  end
  if t = 2 then do
    c = ev(n_a[n], fb)
    if c = 0 then return
    tv = truthy(c)
    if unw > 0 then return
    if tv = 1 then return
    if n_b[n] > 0 then do
      v = ev(n_b[n], fb)
      if v = 0 then return
      unw = 4
      o = inst_new(46)
      tt = mktuple(1)
      sl[ob_p[tt % 2]] = v
      call inst_set o, 8, tt
      unw_v = o
      return
    end
    unw = 4
    unw_v = exc_new0(46)
    return
  end
  if t = 54 then do
    call exec_with n, fb
    return
  end
  if t = 17 then do
    do i = 0 to n_b[n] - 1
      call del_target al[n_a[n] + i], fb
      if unw > 0 then return
    end
    return
  end
  if t = 31 then do
    call exec_import n, fb
    return
  end
  if t = 23 then do
    call exec_from n, fb
    return
  end
  r = raise_exc(42, "cannot execute node " || t)
  return

na_const: procedure = .int
  arg n = .int
  return n_a[n]

del_target: procedure = .void
  arg tg = .int, fb = .int
  tt = .int
  o = .int
  ix = .int
  i = .int
  r = .int
  tt = n_t[tg]
  if tt = 36 | tt = 34 | tt = 27 | tt = 52 then do
    r = ev(tg, fb)
    if r = 0 then return
    call store tg, 0, fb
    return
  end
  if tt = 47 then do
    o = ev(n_a[tg], fb)
    if o = 0 then return
    if n_t[n_b[tg]] = 45 then ix = eval_slice(n_b[tg], fb)
    else ix = ev(n_b[tg], fb)
    if ix = 0 then return
    call delitem o, ix
    return
  end
  if tt = 4 then do
    o = ev(n_a[tg], fb)
    if o = 0 then return
    if kind_of(o) = 17 then do
      if inst_del(o, n_b[tg]) = 0 then r = raise_exc(41, n_s[tg])
      return
    end
    r = raise_exc(41, n_s[tg])
    return
  end
  if tt = 50 | tt = 33 then do
    do i = 0 to n_b[tg] - 1
      call del_target al[n_a[tg] + i], fb
      if unw > 0 then return
    end
    return
  end
  r = raise_exc(52, "cannot delete")
  return

exec_class: procedure = .void
  arg n = .int, fb = .int
  cd = .int
  bo = .int
  bc = .int
  c = .int
  nf = .int
  j = .int
  v = .int
  i = .int
  r = .int
  cobj = .int
  size = .int
  nb = .int
  b = .int
  isf = .int
  cd = n_a[n]
  bc = 1
  bl_n = 0
  if n_c[n] > 0 then do
    bo = ev(n_c[n], fb)
    if bo = 0 then return
    bl_n = 0
    do i = 0 to ob_n[bo % 2] - 1
      b = sl[ob_p[bo % 2] + i]
      if kind_of(b) \= 16 then do
        r = raise_exc(38, "bases must be types")
        return
      end
      bl_n = bl_n + 1
      bl_a[bl_n] = ob_x[b % 2]
    end
  end
  if bl_n = 0 then do
    bl_n = 1
    bl_a[1] = 1
  end
  bc = bl_a[1]
  nb = bl_n
  c = define_class(cd_name[cd], bc)
  if nb > 1 then do
    if set_bases(c, nb) = 0 then return
  end
  if (cl_flags[c] // 2) = 1 then cl_flags[c] = cl_flags[c] - 1
  call set_btype c
  cl_dflt[c] = cl_dflt[bc]
  cobj = cl_obj[c]
  cd_obj[cd] = cobj
  size = cd_ns[cd]
  nf = alloc_frame(size)
  vp[nf + 1] = fb
  call ex cd_body[cd], nf
  if unw > 0 then return
  do j = cd_cv0[cd] to cd_cv1[cd]
    if cv_scope[j] = cd_sc[cd] then do
      v = vp[nf + cv_slot[j]]
      if v \= 0 then call cls_set c, nameid(cv_name[j]), v
    end
  end
  if bc \= 1 then do
    isf = cls_find(bc, nameid("__init_subclass__"))
    if isf > 0 then do
      if kind_of(isf) = 24 then isf = ob_x[isf % 2]
      if kind_of(isf) = 12 then do
        r = call1(isf, cobj)
        if r = 0 then return
      end
    end
  end
  v = cobj
  do i = n_e[n] to 1 by -1
    r = ev(al[n_d[n] + i - 1], fb)
    if r = 0 then return
    v = call1(r, v)
    if v = 0 then return
  end
  call store n_b[n], v, fb
  return

exec_try: procedure = .void
  arg n = .int, fb = .int
  hs = .int
  hc = .int
  i = .int
  h = .int
  ty = .int
  tv = .int
  exc = .int
  matched = .int
  sv_unw = .int
  sv_v = .int
  sv_cur = .int
  r = .int
  hs = n_b[n]
  hc = n_c[n]
  call ex n_a[n], fb
  if unw = 4 & hc > 0 then do
    exc = unw_v
    matched = 0
    do i = 0 to hc - 1
      h = al[hs + i]
      if n_a[h] = 0 then matched = 1
      else do
        unw = 0
        ty = ev(n_a[h], fb)
        if ty = 0 then do
          /* error while evaluating the exception type */
          leave
        end
        tv = exc_matches(exc, ty)
        if unw > 0 then leave
        unw = 4
        unw_v = exc
        if tv = 1 then matched = 1
      end
      if matched = 1 then do
        unw = 0
        if n_b[h] > 0 then call store n_b[h], exc, fb
        sv_cur = exc_cur
        exc_cur = exc
        call ex n_c[h], fb
        exc_cur = sv_cur
        if n_b[h] > 0 then do
          sv_unw = unw
          sv_v = unw_v
          unw = 0
          call store n_b[h], 0, fb
          unw = sv_unw
          unw_v = sv_v
        end
        leave
      end
    end
  end
  else if unw = 0 & n_d[n] > 0 then call ex n_d[n], fb
  if n_e[n] > 0 then do
    sv_unw = unw
    sv_v = unw_v
    unw = 0
    call ex n_e[n], fb
    if unw = 0 then do
      unw = sv_unw
      unw_v = sv_v
    end
  end
  return

exec_with: procedure = .void
  arg n = .int, fb = .int
  ctx = .int
  en = .int
  exm = .int
  r = .int
  sv_unw = .int
  sv_v = .int
  exc = .int
  k = .int
  ctx = ev(n_a[n], fb)
  if ctx = 0 then return
  k = kind_of(ctx)
  if k = 26 then do
    if n_b[n] > 0 then call store n_b[n], ctx, fb
    if unw > 0 then return
    call ex n_c[n], fb
    sv_unw = unw
    sv_v = unw_v
    unw = 0
    call file_close ctx
    unw = sv_unw
    unw_v = sv_v
    return
  end
  if k \= 17 then do
    r = raise_exc(41, "__enter__")
    return
  end
  en = cls_find(ob_c[ctx % 2], 146)
  exm = cls_find(ob_c[ctx % 2], 148)
  if en = 0 | exm = 0 then do
    r = raise_exc(41, "__enter__")
    return
  end
  r = call1(en, ctx)
  if r = 0 then return
  if n_b[n] > 0 then do
    call store n_b[n], r, fb
    if unw > 0 then return
  end
  call ex n_c[n], fb
  if unw = 0 then do
    r = call_exit(exm, ctx, 2, 2)
    return
  end
  if unw = 4 then do
    exc = unw_v
    unw = 0
    r = call_exit(exm, ctx, cl_obj[ob_c[exc % 2]], exc)
    if unw > 0 then return
    if r \= 0 then do
      if truthy(r) = 1 then return
    end
    unw = 4
    unw_v = exc
    return
  end
  sv_unw = unw
  sv_v = unw_v
  unw = 0
  r = call_exit(exm, ctx, 2, 2)
  if unw = 0 then do
    unw = sv_unw
    unw_v = sv_v
  end
  return

call_exit: procedure = .int
  arg exm = .int, ctx = .int, a = .int, b = .int
  base = .int
  r = .int
  base = asp
  call push ctx
  call push a
  call push b
  call push 2
  r = docall(exm, base, 4, 0)
  asp = base
  return r

/* ---------------------------------------------------------------------
   Generators: resumable statement machine with an explicit record stack
   --------------------------------------------------------------------- */
ydepth: procedure = .int
  arg n = .int
  t = .int
  m = .int
  d = .int
  i = .int
  h = .int
  t = n_t[n]
  m = 0
  if t = 43 then do
    do i = 0 to n_b[n] - 1
      if n_y[al[n_a[n] + i]] = 1 then do
        d = ydepth(al[n_a[n] + i])
        if d > m then m = d
      end
    end
    return m + 1
  end
  if t = 29 then do
    if n_y[n_b[n]] = 1 then m = ydepth(n_b[n])
    if n_c[n] > 0 then do
      if n_y[n_c[n]] = 1 then do
        d = ydepth(n_c[n])
        if d > m then m = d
      end
    end
    return m + 1
  end
  if t = 53 then do
    if n_y[n_b[n]] = 1 then m = ydepth(n_b[n])
    if n_c[n] > 0 then do
      if n_y[n_c[n]] = 1 then do
        d = ydepth(n_c[n])
        if d > m then m = d
      end
    end
    return m + 1
  end
  if t = 22 then do
    if n_y[n_c[n]] = 1 then m = ydepth(n_c[n])
    if n_d[n] > 0 then do
      if n_y[n_d[n]] = 1 then do
        d = ydepth(n_d[n])
        if d > m then m = d
      end
    end
    return m + 1
  end
  if t = 49 then do
    if n_y[n_a[n]] = 1 then m = ydepth(n_a[n])
    do i = 0 to n_c[n] - 1
      h = al[n_b[n] + i]
      if n_y[n_c[h]] = 1 then do
        d = ydepth(n_c[h])
        if d > m then m = d
      end
    end
    if n_d[n] > 0 then do
      if n_y[n_d[n]] = 1 then do
        d = ydepth(n_d[n])
        if d > m then m = d
      end
    end
    if n_e[n] > 0 then do
      if n_y[n_e[n]] = 1 then do
        d = ydepth(n_e[n])
        if d > m then m = d
      end
    end
    return m + 1
  end
  if t = 54 then do
    if n_y[n_c[n]] = 1 then m = ydepth(n_c[n])
    return m + 1
  end
  return 1

gen_new: procedure = .int
  arg fd = .int, nf = .int
  g = .int
  o = .int
  cap = .int
  rb = .int
  if fd_gd[fd] = 0 then fd_gd[fd] = ydepth(fd_body[fd]) + 2
  cap = fd_gd[fd]
  if gn_fh > 0 then do
    g = gn_fh
    gn_fh = gn_nx[g]
  end
  else do
    ngn = ngn + 1
    g = ngn
  end
  gn_fd[g] = fd
  gn_fb[g] = nf
  gn_st[g] = 0
  gn_sp[g] = 0
  rb = gsf[cap]
  if rb > 0 then do
    gsf[cap] = gs_s[rb + 1]
    gs_s[rb + 1] = 0
  end
  else do
    rb = ngs
    ngs = ngs + cap + 1
    gs_n[ngs] = 0
  end
  gn_rb[g] = rb
  gn_val[g] = 2
  gn_ret[g] = 2
  o = newobj(19)
  ob_x[o % 2] = g
  return o

gpush: procedure = .void
  arg rb = .int, sp = .int, node = .int
  gs_n[rb + sp] = node
  gs_s[rb + sp] = 0
  gs_a[rb + sp] = 0
  gs_b[rb + sp] = 0
  return

/* an error / control transfer is pending: find the record that handles it.
   returns the new stack pointer, or -1 when the generator is finished. */
gx_unw: procedure = .int
  arg g = .int, sp = .int
  rb = .int
  fb = .int
  n = .int
  t = .int
  st = .int
  i = .int
  h = .int
  exc = .int
  ty = .int
  tv = .int
  matched = .int
  body = .int
  sv_cur = .int
  ctx = .int
  exm = .int
  r = .int
  sv_unw = .int
  sv_v = .int
  rb = gn_rb[g]
  fb = gn_fb[g]
  do while sp > 0
    n = gs_n[rb + sp]
    t = n_t[n]
    if t = 53 | t = 22 then do
      if unw = 2 then do
        unw = 0
        return sp - 1
      end
      if unw = 3 then do
        unw = 0
        return sp
      end
    end
    else if t = 49 then do
      st = gs_s[rb + sp]
      if st = 1 & unw = 4 & n_c[n] > 0 then do
        exc = unw_v
        matched = 0
        do i = 0 to n_c[n] - 1
          h = al[n_b[n] + i]
          if n_a[h] = 0 then matched = 1
          else do
            unw = 0
            ty = ev(n_a[h], fb)
            if ty = 0 then leave
            tv = exc_matches(exc, ty)
            if unw > 0 then leave
            unw = 4
            unw_v = exc
            if tv = 1 then matched = 1
          end
          if matched = 1 then do
            unw = 0
            if n_b[h] > 0 then call store n_b[h], exc, fb
            gs_s[rb + sp] = 2
            body = n_c[h]
            if n_y[body] = 1 then do
              sp = sp + 1
              call gpush rb, sp, body
              return sp
            end
            sv_cur = exc_cur
            exc_cur = exc
            call ex body, fb
            exc_cur = sv_cur
            if unw = 0 then return sp
            leave
          end
        end
        if unw = 0 then return sp
      end
      st = gs_s[rb + sp]
      if n_e[n] > 0 & st >= 1 & st <= 3 then do
        gs_b[rb + sp] = unw
        gs_a[rb + sp] = unw_v
        unw = 0
        gs_s[rb + sp] = 4
        if n_y[n_e[n]] = 1 then do
          sp = sp + 1
          call gpush rb, sp, n_e[n]
          return sp
        end
        call ex n_e[n], fb
        if unw = 0 then do
          unw = gs_b[rb + sp]
          unw_v = gs_a[rb + sp]
        end
      end
    end
    else if t = 54 then do
      if gs_s[rb + sp] = 1 then do
        ctx = gs_a[rb + sp]
        exm = gs_b[rb + sp]
        sv_unw = unw
        sv_v = unw_v
        unw = 0
        r = 0
        if sv_unw = 4 then do
          if exm = 0 then call file_close ctx
          else r = call_exit(exm, ctx, cl_obj[ob_c[sv_v % 2]], sv_v)
          if unw = 0 then do
            if r \= 0 then do
              if truthy(r) = 1 then return sp - 1
            end
            unw = sv_unw
            unw_v = sv_v
          end
        end
        else do
          if exm = 0 then call file_close ctx
          else r = call_exit(exm, ctx, 2, 2)
          if unw = 0 then do
            unw = sv_unw
            unw_v = sv_v
          end
        end
      end
    end
    sp = sp - 1
  end
  return -1

gen_resume: procedure = .int
  arg g = .int, sent = .int
  mi = .int
  sv = .int
  r = .int
  mi = fd_mod[gn_fd[g]]
  if mi = cur_mi then return gen_resume0(g, sent)
  sv = cur_mi
  cur_mi = mi
  gfb = mod_fb[mi]
  r = gen_resume0(g, sent)
  cur_mi = sv
  gfb = mod_fb[sv]
  return r

gen_resume0: procedure = .int
  arg g = .int, sent = .int
  rb = .int
  sp = .int
  fb = .int
  n = .int
  t = .int
  st = .int
  ch = .int
  v = .int
  y = .int
  c = .int
  tv = .int
  b = .int
  it = .int
  fd = .int
  r = .int
  h = .int
  ctx = .int
  exm = .int
  en = .int
  k = .int
  if gn_st[g] = 3 then return 0
  if gn_st[g] = 2 then return raise_exc(36, "generator already executing")
  rb = gn_rb[g]
  fb = gn_fb[g]
  fd = gn_fd[g]
  if gn_st[g] = 0 then do
    sp = 1
    call gpush rb, 1, fd_body[fd]
  end
  else sp = gn_sp[g]
  gn_val[g] = sent
  gn_st[g] = 2
  if gen_throw \= 0 then do
    unw = 4
    unw_v = gen_throw
    gen_throw = 0
    sp = gx_unw(g, sp)
    if sp < 0 then do
      gn_st[g] = 3
      return 0
    end
  end
  do forever
    if sp = 0 then do
      gn_st[g] = 3
      return 0
    end
    n = gs_n[rb + sp]
    st = gs_s[rb + sp]
    t = n_t[n]
    if t = 43 then do
      if st >= n_b[n] then sp = sp - 1
      else do
        ch = al[n_a[n] + st]
        gs_s[rb + sp] = st + 1
        if n_y[ch] = 1 then do
          sp = sp + 1
          call gpush rb, sp, ch
        end
        else do
          call ex ch, fb
          if unw > 0 then do
            sp = gx_unw(g, sp)
            if sp < 0 then leave
          end
        end
      end
    end
    else if t = 20 | t = 3 then do
      if t = 20 then y = n_a[n]
      else y = n_a[n]
      if n_t[y] = 55 then do
        if st = 0 then do
          if n_a[y] = 0 then v = 2
          else v = ev(n_a[y], fb)
          if v = 0 then do
            sp = gx_unw(g, sp)
            if sp < 0 then leave
          end
          else do
            gs_s[rb + sp] = 1
            gn_sp[g] = sp
            gn_st[g] = 1
            return v
          end
        end
        else do
          if t = 3 then do
            do b = 0 to n_c[n] - 1
              call store al[n_b[n] + b], gn_val[g], fb
            end
            if unw > 0 then do
              sp = gx_unw(g, sp)
              if sp < 0 then leave
              iterate
            end
          end
          sp = sp - 1
        end
      end
      else if n_t[y] = 56 then do
        if st = 0 then do
          v = ev(n_a[y], fb)
          if v \= 0 then it = iter_new(v)
          else it = 0
          if it = 0 then do
            sp = gx_unw(g, sp)
            if sp < 0 then leave
            iterate
          end
          gs_a[rb + sp] = it
          gs_s[rb + sp] = 1
        end
        it = gs_a[rb + sp]
        if st > 0 & kind_of(it) = 19 then v = gen_resume(ob_x[it % 2], gn_val[g])
        else v = iter_next(it)
        if v = 0 then do
          if unw > 0 then do
            sp = gx_unw(g, sp)
            if sp < 0 then leave
          end
          else do
            if t = 3 then do
              it = gs_a[rb + sp]
              if kind_of(it) = 19 then v = gn_ret[ob_x[it % 2]]
              else v = 2
              do b = 0 to n_c[n] - 1
                call store al[n_b[n] + b], v, fb
              end
              if unw > 0 then do
                sp = gx_unw(g, sp)
                if sp < 0 then leave
                iterate
              end
            end
            sp = sp - 1
          end
        end
        else do
          gn_sp[g] = sp
          gn_st[g] = 1
          return v
        end
      end
      else sp = sp - 1
    end
    else if t = 29 then do
      if st = 0 then do
        c = ev(n_a[n], fb)
        if c = 0 then tv = -1
        else tv = truthy(c)
        if unw > 0 then do
          sp = gx_unw(g, sp)
          if sp < 0 then leave
          iterate
        end
        gs_s[rb + sp] = 1
        if tv = 1 then b = n_b[n]
        else b = n_c[n]
        if b > 0 then do
          if n_y[b] = 1 then do
            sp = sp + 1
            call gpush rb, sp, b
          end
          else do
            call ex b, fb
            if unw > 0 then do
              sp = gx_unw(g, sp)
              if sp < 0 then leave
            end
          end
        end
      end
      else sp = sp - 1
    end
    else if t = 53 then do
      if st = 0 then do
        c = ev(n_a[n], fb)
        if c = 0 then tv = -1
        else tv = truthy(c)
        if unw > 0 then do
          sp = gx_unw(g, sp)
          if sp < 0 then leave
          iterate
        end
        if tv = 1 then do
          if n_y[n_b[n]] = 1 then do
            sp = sp + 1
            call gpush rb, sp, n_b[n]
          end
          else do
            call ex n_b[n], fb
            if unw > 0 then do
              sp = gx_unw(g, sp)
              if sp < 0 then leave
            end
          end
        end
        else do
          gs_s[rb + sp] = 2
          if n_c[n] > 0 then do
            if n_y[n_c[n]] = 1 then do
              sp = sp + 1
              call gpush rb, sp, n_c[n]
            end
            else do
              call ex n_c[n], fb
              if unw > 0 then do
                sp = gx_unw(g, sp)
                if sp < 0 then leave
              end
            end
          end
        end
      end
      else sp = sp - 1
    end
    else if t = 22 then do
      if st = 0 then do
        v = ev(n_b[n], fb)
        if v \= 0 then it = iter_new(v)
        else it = 0
        if it = 0 then do
          sp = gx_unw(g, sp)
          if sp < 0 then leave
          iterate
        end
        gs_a[rb + sp] = it
        gs_s[rb + sp] = 1
        st = 1
      end
      if st = 1 then do
        v = iter_next(gs_a[rb + sp])
        if v = 0 then do
          if unw > 0 then do
            sp = gx_unw(g, sp)
            if sp < 0 then leave
            iterate
          end
          gs_s[rb + sp] = 2
          if n_d[n] > 0 then do
            if n_y[n_d[n]] = 1 then do
              sp = sp + 1
              call gpush rb, sp, n_d[n]
            end
            else do
              call ex n_d[n], fb
              if unw > 0 then do
                sp = gx_unw(g, sp)
                if sp < 0 then leave
              end
            end
          end
        end
        else do
          call store n_a[n], v, fb
          if unw > 0 then do
            sp = gx_unw(g, sp)
            if sp < 0 then leave
            iterate
          end
          if n_y[n_c[n]] = 1 then do
            sp = sp + 1
            call gpush rb, sp, n_c[n]
          end
          else do
            call ex n_c[n], fb
            if unw > 0 then do
              sp = gx_unw(g, sp)
              if sp < 0 then leave
            end
          end
        end
      end
      else sp = sp - 1
    end
    else if t = 49 then do
      if st = 0 then do
        gs_s[rb + sp] = 1
        sp = sp + 1
        call gpush rb, sp, n_a[n]
      end
      else if st = 1 then do
        /* body finished normally */
        if n_d[n] > 0 then do
          gs_s[rb + sp] = 3
          if n_y[n_d[n]] = 1 then do
            sp = sp + 1
            call gpush rb, sp, n_d[n]
          end
          else do
            call ex n_d[n], fb
            if unw > 0 then do
              sp = gx_unw(g, sp)
              if sp < 0 then leave
            end
          end
        end
        else if n_e[n] > 0 then do
          gs_s[rb + sp] = 4
          gs_b[rb + sp] = 0
          if n_y[n_e[n]] = 1 then do
            sp = sp + 1
            call gpush rb, sp, n_e[n]
          end
          else do
            call ex n_e[n], fb
            if unw > 0 then do
              sp = gx_unw(g, sp)
              if sp < 0 then leave
            end
          end
        end
        else sp = sp - 1
      end
      else if st = 2 | st = 3 then do
        if n_e[n] > 0 then do
          gs_s[rb + sp] = 4
          gs_b[rb + sp] = 0
          if n_y[n_e[n]] = 1 then do
            sp = sp + 1
            call gpush rb, sp, n_e[n]
          end
          else do
            call ex n_e[n], fb
            if unw > 0 then do
              sp = gx_unw(g, sp)
              if sp < 0 then leave
            end
          end
        end
        else sp = sp - 1
      end
      else do
        /* finally finished: re-raise what was pending */
        b = gs_b[rb + sp]
        if b > 0 then do
          unw = b
          unw_v = gs_a[rb + sp]
          sp = gx_unw(g, sp - 1)
          if sp < 0 then leave
        end
        else sp = sp - 1
      end
    end
    else if t = 54 then do
      if st = 0 then do
        ctx = ev(n_a[n], fb)
        if ctx = 0 then do
          sp = gx_unw(g, sp)
          if sp < 0 then leave
          iterate
        end
        k = kind_of(ctx)
        exm = 0
        r = 0
        if k = 17 then do
          en = cls_find(ob_c[ctx % 2], 146)
          exm = cls_find(ob_c[ctx % 2], 148)
          if en = 0 | exm = 0 then r = raise_exc(41, "__enter__")
          else r = call1(en, ctx)
        end
        else if k = 26 then r = ctx
        else r = raise_exc(41, "__enter__")
        if r \= 0 & n_b[n] > 0 then call store n_b[n], r, fb
        if unw > 0 then do
          sp = gx_unw(g, sp)
          if sp < 0 then leave
          iterate
        end
        gs_a[rb + sp] = ctx
        gs_b[rb + sp] = exm
        gs_s[rb + sp] = 1
        sp = sp + 1
        call gpush rb, sp, n_c[n]
      end
      else do
        ctx = gs_a[rb + sp]
        exm = gs_b[rb + sp]
        sp = sp - 1
        if exm = 0 then call file_close ctx
        else r = call_exit(exm, ctx, 2, 2)
        if unw > 0 then do
          sp = gx_unw(g, sp)
          if sp < 0 then leave
        end
      end
    end
    else do
      r = raise_exc(42, "unsupported statement containing yield")
      sp = gx_unw(g, sp)
      if sp < 0 then leave
    end
  end
  /* the generator ended: sp < 0 */
  gn_st[g] = 3
  if unw = 1 then do
    gn_ret[g] = unw_v
    unw = 0
  end
  return 0

/* ---------------------------------------------------------------------
   Built-in functions, type constructors, exceptions
   --------------------------------------------------------------------- */
kwarg: procedure = .int
  arg base = .int, na = .int, nk = .int, name = .string
  j = .int
  do j = 1 to nk
    if asn[base + na + j] == name then return ast[base + na + j]
  end
  return 0

nargs_err: procedure = .int
  arg fname = .string, na = .int, lo = .int, hi = .int
  if lo = hi then do
    if lo = 1 then return raise_exc(38, fname || "() takes exactly one argument (" || na || " given)")
    return raise_exc(38, fname || "() takes exactly " || lo || " arguments (" || na || " given)")
  end
  if na < lo then return raise_exc(38, fname || "() takes at least " || lo || " argument" || plural(lo) || " (" || na || " given)")
  return raise_exc(38, fname || "() takes at most " || hi || " argument" || plural(hi) || " (" || na || " given)")

/* integer argument check: 1 when v is an int-like small integer, else raises */
chk_int: procedure = .int
  arg v = .int
  if numkind(v) = 1 then return 1
  if numkind(v) = 2 then do
    if unsub(v) \= v then return 1
  end
  if numkind(v) = 2 then do
    call raise_exc 31, "Python int too large to convert to C long"
    return 0
  end
  call raise_exc 38, "'" || type_name(v) || "' object cannot be interpreted as an integer"
  return 0

py_lt: procedure = .int
  arg a = .int, b = .int
  r = .int
  if a // 2 \= 0 & b // 2 \= 0 then do
    if a < b then return 1
    return 0
  end
  r = py_cmp(3, a, b)
  if r = 0 then return 0
  if r = 4 then return 1
  if r = 6 then return 0
  return truthy(r)

/* ---- output ---- */
outs: procedure = .void
  arg s = .string
  obuf = obuf || s
  if length(obuf) > 3000 then call flush_out
  return

flush_out: procedure = .void
  rcx = .int
  if length(obuf) > 0 then do
    assembler fwrite h_out, obuf
    obuf = ""
  end
  assembler fflush rcx, h_out
  return

errs: procedure = .void
  arg s = .string
  rcx = .int
  call flush_out
  assembler fwrite h_err, s
  assembler fflush rcx, h_err
  return

bi_print: procedure = .int
  arg base = .int, na = .int, nk = .int
  sep = .string
  endv = .string
  out = .string
  i = .int
  j = .int
  v = .int
  fo = .int
  s = .string
  nm = .string
  sep = " "
  endv = '0a'x
  fo = 0
  do j = 1 to nk
    nm = asn[base + na + j]
    v = ast[base + na + j]
    if nm == "sep" then do
      if v \= 2 then do
        if kind_of(v) \= 6 then return raise_exc(38, "sep must be None or a string, not " || type_name(v))
        sep = ob_s[v % 2]
      end
    end
    else if nm == "end" then do
      if v \= 2 then do
        if kind_of(v) \= 6 then return raise_exc(38, "end must be None or a string, not " || type_name(v))
        endv = ob_s[v % 2]
      end
    end
    else if nm == "file" then fo = v
    else if nm == "flush" then nop
    else return raise_exc(38, "'" || nm || "' is an invalid keyword argument for print()")
  end
  out = ""
  do i = 1 to na
    if i > 1 then out = out || sep
    v = ast[base + i]
    if v // 2 = 0 then do
      if ob_k[v % 2] = 6 & ob_c[v % 2] = 0 then do
        out = out || ob_s[v % 2]
        iterate
      end
    end
    s = str_of(v)
    if unw > 0 then return 0
    out = out || s
  end
  out = out || endv
  if fo > 0 & fo \= 2 then do
    if kind_of(fo) = 17 then do
      v = getattr_obj(fo, 130, 0)
      if v = 0 then return 0
      if call1(v, mkstr(out)) = 0 then return 0
      return 2
    end
    if kind_of(fo) \= 26 then return raise_exc(41, "'" || type_name(fo) || "' object has no attribute 'write'")
    call file_write fo, out
    if unw > 0 then return 0
  end
  else call outs out
  return 2

bi_len: procedure = .int
  arg x = .int
  k = .int
  m = .int
  k = kind_of(x)
  if x // 2 = 0 then do
    if ob_c[x % 2] > 0 then do
      m = nsov(x, 164)
      if m > 0 then return call1(m, x)
    end
  end
  select
    when k = 6 then return mkint(length(ob_s[x % 2]))
    when k = 31 then return mkint(length(ob_s[x % 2]))
    when k = 7 | k = 8 then return mkint(ob_n[x % 2])
    when k = 9 | k = 10 then return mkint(dd_n[ob_x[x % 2]])
    when k = 30 then return mkint(dd_n[ob_x[ob_x[x % 2] % 2]])
    when k = 11 then return mkint(range_len(x))
    when k = 29 then do
      if ob_x[x % 2] = 0 then return raise_exc(38, "len() of unsized object")
      return mkint(sl[ob_y[x % 2]])
    end
    when k = 17 then do
      m = cls_find(ob_c[x % 2], 164)
      if m > 0 then do
        m = call1(m, x)
        if m = 0 then return 0
        return m
      end
    end
    otherwise nop
  end
  return raise_exc(38, "object of type '" || type_name(x) || "' has no len()")

bi_abs: procedure = .int
  arg x = .int
  s = .string
  m = .int
  if x // 2 \= 0 then do
    if x < 1 then return mkint(0 - ival(x))
    return x
  end
  select
    when ob_k[x % 2] = 5 then return mkfloat(rxfloat..fabs(ob_f[x % 2]))
    when ob_k[x % 2] = 4 then do
      s = ob_s[x % 2]
      if left(s, 1) == "-" then return big_norm(substr(s, 2))
      if ob_c[x % 2] > 0 then return big_norm(s)
      return x
    end
    when ob_k[x % 2] = 2 then return mkint(ival(x))
    when ob_k[x % 2] = 32 then return cplx_abs(x)
    when ob_k[x % 2] = 29 then return np_math1(150, x)
    otherwise nop
  end
  if kind_of(x) = 17 then do
    m = cls_find(ob_c[x % 2], 133)
    if m > 0 then return call1(m, x)
  end
  return raise_exc(38, "bad operand type for abs(): '" || type_name(x) || "'")

bi_minmax: procedure = .int
  arg base = .int, na = .int, nk = .int, ismax = .int
  keyf = .int
  dflt = .int
  l = .int
  i = .int
  best = .int
  bestk = .int
  v = .int
  kv = .int
  c = .int
  n = .int
  fname = .string
  fname = "min"
  if ismax = 1 then fname = "max"
  keyf = kwarg(base, na, nk, "key")
  if keyf = 2 then keyf = 0
  dflt = kwarg(base, na, nk, "default")
  if na = 0 then return raise_exc(38, fname || " expected at least 1 argument, got 0")
  if na = 1 then do
    l = iter_list(ast[base + 1])
    if l = 0 then return 0
  end
  else l = tup_from_ast(base + 1, base + na)
  n = ob_n[l % 2]
  if n = 0 then do
    if dflt \= 0 then return dflt
    return raise_exc(36, fname || "() iterable argument is empty")
  end
  best = sl[ob_p[l % 2]]
  bestk = best
  if keyf \= 0 then do
    bestk = call1(keyf, best)
    if bestk = 0 then return 0
  end
  do i = 1 to n - 1
    v = sl[ob_p[l % 2] + i]
    kv = v
    if keyf \= 0 then do
      kv = call1(keyf, v)
      if kv = 0 then return 0
    end
    if ismax = 1 then c = py_lt(bestk, kv)
    else c = py_lt(kv, bestk)
    if unw > 0 then return 0
    if c = 1 then do
      best = v
      bestk = kv
    end
  end
  return best

bi_sum: procedure = .int
  arg base = .int, na = .int, nk = .int
  acc = .int
  it = .int
  v = .int
  st = .int
  fm = .int
  fr = .float
  cc = .float
  x = .float
  tt = .float
  ok = .int
  if na < 1 then return nargs_err("sum", na, 1, 2)
  acc = mkint(0)
  if na >= 2 then acc = ast[base + 2]
  st = kwarg(base, na, nk, "start")
  if st \= 0 then acc = st
  it = iter_new(ast[base + 1])
  if it = 0 then return 0
  fm = 0
  cc = 0.0
  if acc // 2 = 0 then do
    if ob_k[acc % 2] = 5 then do
      fm = 1
      fr = ob_f[acc % 2]
    end
  end
  do forever
    v = iter_next(it)
    if fm = 1 then do
      if v = 0 then do
        if cc \= 0.0 & cc = cc & finf(cc) = 0 & fr = fr & finf(fr) = 0 then fr = fr + cc
        acc = mkfloat(fr)
        leave
      end
      if v // 2 \= 0 then do
        x = ((v - 1) % 2) as .float
        ok = 1
      end
      else if ob_k[v % 2] = 5 then do
        x = ob_f[v % 2]
        ok = 1
      end
      else ok = 0
      if ok = 1 then do
        if x = x & finf(x) = 0 & fr = fr & finf(fr) = 0 then do
          tt = fr + x
          if rxfloat..fabs(fr) >= rxfloat..fabs(x) then cc = cc + ((fr - tt) + x)
          else cc = cc + ((x - tt) + fr)
          fr = tt
        end
        else fr = fr + x
        iterate
      end
      if cc \= 0.0 & cc = cc & finf(cc) = 0 & fr = fr & finf(fr) = 0 then fr = fr + cc
      acc = mkfloat(fr)
      fm = 0
    end
    if v = 0 then leave
    if acc // 2 \= 0 & v // 2 \= 0 then do
      acc = acc + v - 1
      if acc >= 1999999999999999999 | acc <= 0 - 1999999999999999999 then acc = arith(1, acc - v + 1, v)
    end
    else acc = arith(1, acc, v)
    if acc = 0 then return 0
    if acc // 2 = 0 then do
      if ob_k[acc % 2] = 5 then do
        fm = 1
        fr = ob_f[acc % 2]
        cc = 0.0
      end
    end
  end
  if unw > 0 then return 0
  return acc

/* in-place stable merge sort of list o by key function keyf (0 = none) */
sort_list: procedure = .int
  arg o = .int, keyf = .int, rev = .int
  n = .int
  i = .int
  w = .int
  lo = .int
  mid = .int
  hi = .int
  a = .int
  b = .int
  d = .int
  p = .int
  x = .int
  y = .int
  t = .int
  kv = .int
  vals = .int[]
  keys = .int[]
  src = .int[]
  dst = .int[]
  n = ob_n[o % 2]
  if n < 2 then return 1
  p = ob_p[o % 2]
  do i = 1 to n
    vals[i] = sl[p + i - 1]
    keys[i] = vals[i]
    if keyf \= 0 then do
      kv = call1(keyf, vals[i])
      if kv = 0 then return 0
      keys[i] = kv
    end
    src[i] = i
  end
  w = 1
  do while w < n
    lo = 1
    do while lo <= n
      mid = lo + w
      hi = lo + 2 * w
      if mid > n + 1 then mid = n + 1
      if hi > n + 1 then hi = n + 1
      a = lo
      b = mid
      d = lo
      do while a < mid & b < hi
        x = keys[src[b]]
        y = keys[src[a]]
        if rev = 1 then do
          t = x
          x = y
          y = t
        end
        if x // 2 \= 0 & y // 2 \= 0 then do
          if x < y then t = 1
          else t = 0
        end
        else do
          t = py_lt(x, y)
          if unw > 0 then return 0
        end
        if t = 1 then do
          dst[d] = src[b]
          b = b + 1
        end
        else do
          dst[d] = src[a]
          a = a + 1
        end
        d = d + 1
      end
      do while a < mid
        dst[d] = src[a]
        a = a + 1
        d = d + 1
      end
      do while b < hi
        dst[d] = src[b]
        b = b + 1
        d = d + 1
      end
      lo = lo + 2 * w
    end
    do i = 1 to n
      src[i] = dst[i]
    end
    w = w * 2
  end
  p = ob_p[o % 2]
  do i = 1 to n
    sl[p + i - 1] = vals[src[i]]
  end
  return 1

bi_sorted: procedure = .int
  arg base = .int, na = .int, nk = .int
  l = .int
  keyf = .int
  rev = .int
  r = .int
  if na \= 1 then return nargs_err("sorted", na, 1, 1)
  l = iter_list(ast[base + 1])
  if l = 0 then return 0
  keyf = kwarg(base, na, nk, "key")
  if keyf = 2 then keyf = 0
  rev = 0
  r = kwarg(base, na, nk, "reverse")
  if r \= 0 then do
    rev = truthy(r)
    if unw > 0 then return 0
  end
  if sort_list(l, keyf, rev) = 0 then return 0
  return l

bi_round: procedure = .int
  arg base = .int, na = .int, nk = .int
  x = .int
  nd = .int
  hasnd = .int
  f = .float
  fl = .float
  df = .float
  p = .int
  q = .int
  r = .int
  s = .string
  if na < 1 | na > 2 then return nargs_err("round", na, 1, 2)
  x = ast[base + 1]
  if kind_of(x) = 17 then do
    p = cls_find(ob_c[x % 2], 189)
    if p > 0 then do
      if na = 1 then return call1(p, x)
      return call2(p, x, ast[base + 2])
    end
  end
  hasnd = 0
  if na = 2 then do
    if ast[base + 2] \= 2 then do
      if chk_int(ast[base + 2]) = 0 then return 0
      hasnd = 1
      nd = ival(ast[base + 2])
    end
  end
  if numkind(x) = 1 | numkind(x) = 2 then do
    if hasnd = 0 | nd >= 0 then return mkint(ival(x))
    if numkind(x) = 2 then return x
    p = 10 ** (0 - nd)
    if nd < -17 then return mkint(0)
    q = ival(x) % p
    r = ival(x) // p
    if r < 0 then do
      q = q - 1
      r = r + p
    end
    if r * 2 > p then q = q + 1
    else if r * 2 = p then do
      if q // 2 \= 0 then q = q + 1
    end
    return mkint(q * p)
  end
  if numkind(x) = 3 then do
    f = ob_f[x % 2]
    if hasnd = 0 then do
      if f \= f then return raise_exc(36, "cannot convert float NaN to integer")
      if finf(f) \= 0 then return raise_exc(31, "cannot convert float infinity to integer")
      fl = rxfloat..floor(f)
      df = f - fl
      if df < 0.5 then return float_to_int(fl)
      if df > 0.5 then return float_to_int(fl + 1.0)
      if rxfloat..floor(fl / 2.0) * 2.0 = fl then return float_to_int(fl)
      return float_to_int(fl + 1.0)
    end
    if f \= f | finf(f) \= 0 then return x
    if nd > 300 then return x
    if nd < 0 then do
      p = 0 - nd
      fl = rxfloat..pow10(p as .float)
      return mkfloat(ob_f[bi_round_f(f / fl) % 2] * fl)
    end
    s = float_fixed(f, nd)
    return mkfloat(parse_flt(s))
  end
  return raise_exc(38, "type " || type_name(x) || " doesn't define __round__ method")

/* round a float half-even to an integral float */
bi_round_f: procedure = .int
  arg f = .float
  fl = .float
  df = .float
  fl = rxfloat..floor(f)
  df = f - fl
  if df < 0.5 then return mkfloat(fl)
  if df > 0.5 then return mkfloat(fl + 1.0)
  if rxfloat..floor(fl / 2.0) * 2.0 = fl then return mkfloat(fl)
  return mkfloat(fl + 1.0)

bi_divmod: procedure = .int
  arg a = .int, b = .int
  q = .int
  r = .int
  t = .int
  if kind_of(a) = 17 then do
    q = cls_find(ob_c[a % 2], 144)
    if q > 0 then do
      r = call2(q, a, b)
      if r \= 10 then return r
      if unw > 0 then return 0
    end
  end
  if kind_of(b) = 17 then do
    q = cls_find(ob_c[b % 2], 184)
    if q > 0 then do
      r = call2(q, b, a)
      if r \= 10 then return r
      if unw > 0 then return 0
    end
  end
  q = arith(5, a, b)
  if q = 0 then return 0
  r = arith(6, a, b)
  if r = 0 then return 0
  t = mktuple(2)
  sl[ob_p[t % 2]] = q
  sl[ob_p[t % 2] + 1] = r
  return t

bi_pow: procedure = .int
  arg base = .int, na = .int
  r = .int
  e = .int
  m = .int
  b = .int
  one = .int
  if na < 2 | na > 3 then return nargs_err("pow", na, 2, 3)
  if na = 2 then return arith(7, ast[base + 1], ast[base + 2])
  b = ast[base + 1]
  e = ast[base + 2]
  m = ast[base + 3]
  if numkind(b) \= 1 & numkind(b) \= 2 then return raise_exc(38, "pow() 3rd argument not allowed unless all arguments are integers")
  if numkind(e) \= 1 | numkind(m) = 0 then return raise_exc(38, "pow() 3rd argument not allowed unless all arguments are integers")
  if ival(e) < 0 & numkind(e) = 1 then return raise_exc(36, "pow() 2nd argument cannot be negative when 3rd argument specified")
  if num_str(m) == "0" then return raise_exc(36, "pow() 3rd argument cannot be 0")
  one = mkint(1)
  r = arith(6, one, m)
  b = arith(6, b, m)
  e = ival(e)
  do while e > 0
    if e // 2 = 1 then do
      r = arith(6, arith(3, r, b), m)
    end
    e = e % 2
    if e > 0 then b = arith(6, arith(3, b, b), m)
  end
  return r

bi_chr: procedure = .int
  arg x = .int
  v = .int
  if chk_int(x) = 0 then return 0
  v = ival(x)
  if v < 0 | v > 1114111 then return raise_exc(36, "chr() arg not in range(0x110000)")
  return mkchr(utf8_chr(v))

bi_ord: procedure = .int
  arg x = .int
  s = .string
  n = .int
  c = .int
  if kind_of(x) = 31 then do
    s = ob_s[x % 2]
    if length(s) \= 1 then return raise_exc(38, "ord() expected a character, but string of length " || length(s) || " found")
    return mkint(c2d(s))
  end
  if kind_of(x) \= 6 then return raise_exc(38, "ord() expected string of length 1, but " || type_name(x) || " found")
  s = ob_s[x % 2]
  n = length(s)
  if n \= 1 then return raise_exc(38, "ord() expected a character, but string of length " || n || " found")
  c = c2d(s)
  return mkint(c)

bi_radix: procedure = .int
  arg x = .int, rdx = .int
  s = .string
  neg = .string
  pre = .string
  if numkind(x) = 0 | numkind(x) = 3 then return raise_exc(38, "'" || type_name(x) || "' object cannot be interpreted as an integer")
  s = num_str(x)
  neg = ""
  if left(s, 1) == "-" then do
    neg = "-"
    s = substr(s, 2)
  end
  if rdx = 16 then pre = "0x"
  else if rdx = 8 then pre = "0o"
  else pre = "0b"
  return mkstr(neg || pre || radix_str(s, rdx))

/* is class c (or any class of the tuple t) a base of class d */
bi_isinstance: procedure = .int
  arg x = .int, ty = .int, sub = .int
  k = .int
  i = .int
  r = .int
  c = .int
  k = kind_of(ty)
  if k = 16 then do
    if sub = 0 & ob_x[ty % 2] = 95 then do
      if is_carr(x) = 1 then return 4
    end
    if sub = 1 then c = x
    else c = cls_of(x)
    return mkbool(cls_issub(c, ob_x[ty % 2]))
  end
  if k = 8 then do
    do i = 0 to ob_n[ty % 2] - 1
      r = bi_isinstance(x, sl[ob_p[ty % 2] + i], sub)
      if r = 0 then return 0
      if r = 4 then return r
    end
    return 6
  end
  if sub = 1 then return raise_exc(38, "issubclass() arg 2 must be a class, a tuple of classes, or a union")
  return raise_exc(38, "isinstance() arg 2 must be a type, a tuple of types, or a union")

/* clear a pending AttributeError; 1 if there was one */
swallow_attr: procedure = .int
  if unw = 4 then do
    if cls_issub(ob_c[unw_v % 2], 41) = 1 then do
      unw = 0
      return 1
    end
  end
  return 0

bi_getattr: procedure = .int
  arg base = .int, na = .int
  r = .int
  o = .int
  if na < 2 | na > 3 then return nargs_err("getattr", na, 2, 3)
  o = ast[base + 1]
  if kind_of(ast[base + 2]) \= 6 then return raise_exc(38, "getattr(): attribute name must be string")
  r = getattr_obj(o, nameid(ob_s[ast[base + 2] % 2]), 0)
  if r = 0 & na = 3 then do
    if swallow_attr() = 1 then return ast[base + 3]
  end
  return r

bi_hasattr: procedure = .int
  arg o = .int, nm = .int
  r = .int
  if kind_of(nm) \= 6 then return raise_exc(38, "hasattr(): attribute name must be string")
  r = getattr_obj(o, nameid(ob_s[nm % 2]), 0)
  if r = 0 then do
    if swallow_attr() = 1 then return 6
    return 0
  end
  return 4

bi_setattr: procedure = .int
  arg o = .int, nm = .int, v = .int
  if kind_of(nm) \= 6 then return raise_exc(38, "setattr(): attribute name must be string")
  call setattr_obj o, nameid(ob_s[nm % 2]), v
  if unw > 0 then return 0
  return 2

bi_delattr: procedure = .int
  arg o = .int, nm = .int
  if kind_of(nm) \= 6 then return raise_exc(38, "delattr(): attribute name must be string")
  if kind_of(o) = 17 then do
    if inst_del(o, nameid(ob_s[nm % 2])) = 1 then return 2
  end
  return raise_exc(41, ob_s[nm % 2])

bi_callable: procedure = .int
  arg x = .int
  k = .int
  k = kind_of(x)
  if k = 12 | k = 13 | k = 14 | k = 15 | k = 16 then return 4
  if k = 17 then do
    if cls_find(ob_c[x % 2], 138) > 0 then return 4
  end
  return 6

bi_next: procedure = .int
  arg base = .int, na = .int
  it = .int
  v = .int
  m = .int
  if na < 1 | na > 2 then return nargs_err("next", na, 1, 2)
  it = ast[base + 1]
  if kind_of(it) = 17 then do
    m = cls_find(ob_c[it % 2], 177)
    if m = 0 then return raise_exc(38, "'" || type_name(it) || "' object is not an iterator")
    v = call1(m, it)
    if v = 0 & na = 2 then do
      if unw = 4 then do
        if cls_issub(ob_c[unw_v % 2], 45) = 1 then do
          unw = 0
          return ast[base + 2]
        end
      end
    end
    return v
  end
  if kind_of(it) \= 19 & kind_of(it) \= 20 then return raise_exc(38, "'" || type_name(it) || "' object is not an iterator")
  v = iter_next(it)
  if v = 0 then do
    if unw > 0 then return 0
    if na = 2 then return ast[base + 2]
    unw = 4
    unw_v = stop_exc(it)
    return 0
  end
  return v

bi_iter: procedure = .int
  arg x = .int
  return iter_new(x)

bi_anyall: procedure = .int
  arg x = .int, isany = .int
  it = .int
  v = .int
  t = .int
  it = iter_new(x)
  if it = 0 then return 0
  do forever
    v = iter_next(it)
    if v = 0 then leave
    t = truthy(v)
    if unw > 0 then return 0
    if isany = 1 & t = 1 then return 4
    if isany = 0 & t = 0 then return 6
  end
  if unw > 0 then return 0
  if isany = 1 then return 6
  return 4

strhash: procedure = .int
  arg s = .string
  h = .int
  i = .int
  n = .int
  h = 5381
  n = length(s)
  do i = 1 to n
    h = (h * 33 + c2d(substr(s, i, 1))) // 1000000007
  end
  return h

bi_hash: procedure = .int
  arg x = .int
  k = .int
  m = .int
  r = .int
  h = .int
  i = .int
  if x // 2 \= 0 then return x
  k = ob_k[x % 2]
  if ob_c[x % 2] > 0 then do
    m = nsov(x, 158)
    if m > 0 then return call1(m, x)
  end
  select
    when k = 6 then return mkint(strhash(ob_s[x % 2]))
    when k = 31 then return mkint(strhash(ob_s[x % 2]))
    when k = 32 then do
      if ob_g[x % 2] = 0.0 then return bi_hash(mkfloat(ob_f[x % 2]))
      r = bi_hash(mkfloat(ob_f[x % 2]))
      h = bi_hash(mkfloat(ob_g[x % 2]))
      return mkint(ival(r) + 1000003 * ival(h))
    end
    when k = 2 then return mkint(ival(x))
    when k = 5 then do
      if ob_f[x % 2] = rxfloat..floor(ob_f[x % 2]) & rxfloat..fabs(ob_f[x % 2]) < 900000000000000000.0 then return float_to_int(ob_f[x % 2])
      return mkint(strhash(float_repr(ob_f[x % 2])))
    end
    when k = 4 then do
      if ob_c[x % 2] > 0 then return bi_hash(big_norm(ob_s[x % 2]))
      return mkint(strhash(ob_s[x % 2]))
    end
    when k = 8 then do
      h = 3430008
      do i = 0 to ob_n[x % 2] - 1
        r = bi_hash(sl[ob_p[x % 2] + i])
        if r = 0 then return 0
        h = (h * 1000003 + ival(r)) // 1000000007
      end
      return mkint(h)
    end
    when k = 1 then return mkint(1)
    when k = 7 | k = 9 | k = 10 then return raise_exc(38, "unhashable type: '" || type_name(x) || "'")
    when k = 17 then do
      m = cls_find(ob_c[x % 2], 158)
      if m > 0 then return call1(m, x)
      return mkint(x)
    end
    otherwise return mkint(x)
  end
  return mkint(x)

bi_input: procedure = .int
  arg base = .int, na = .int
  line = .string
  e = .int
  if na >= 1 then call outs str_of(ast[base + 1])
  call flush_out
  if stdin_eof = 1 then return raise_exc(55, "EOF when reading a line")
  line = ""
  assembler freadline line, h_in
  assembler feof e, h_in
  if e > 0 & length(line) = 0 then do
    stdin_eof = 1
    return raise_exc(55, "EOF when reading a line")
  end
  if right(line, 1) == '0d'x then line = left(line, length(line) - 1)
  return mkstr(line)

bi_reversed: procedure = .int
  arg x = .int
  k = .int
  l = .int
  k = kind_of(x)
  if k = 7 | k = 8 then return mkiter(12, x, ob_n[x % 2] - 1)
  if k = 6 then return mkiter(12, x, length(ob_s[x % 2]) - 1)
  l = iter_list(x)
  if l = 0 then return 0
  return mkiter(12, l, ob_n[l % 2] - 1)

bi_enumerate: procedure = .int
  arg base = .int, na = .int, nk = .int
  it = .int
  st = .int
  if na < 1 | na > 2 then return nargs_err("enumerate", na, 1, 2)
  it = iter_new(ast[base + 1])
  if it = 0 then return 0
  st = 0
  if na = 2 then st = ast[base + 2]
  if kwarg(base, na, nk, "start") \= 0 then st = kwarg(base, na, nk, "start")
  if st = 0 then st = mkint(0)
  if chk_int(st) = 0 then return 0
  return mkiter(8, it, ival(st))

bi_zip: procedure = .int
  arg base = .int, na = .int
  o = .int
  j = .int
  it = .int
  if na = 0 then return mkiter(1, mktuple(0), 0)
  o = mkiter(9, 0, 0)
  ob_p[o % 2] = alloc_slots(na)
  ob_c[o % 2] = na
  do j = 0 to na - 1
    it = iter_new(ast[base + 1 + j])
    if it = 0 then return 0
    sl[ob_p[o % 2] + j] = it
  end
  return o

bi_map: procedure = .int
  arg base = .int, na = .int
  o = .int
  j = .int
  it = .int
  if na < 2 then return nargs_err("map", na, 2, 2)
  o = mkiter(10, ast[base + 1], 0)
  ob_p[o % 2] = alloc_slots(na - 1)
  ob_c[o % 2] = na - 1
  do j = 1 to na - 1
    it = iter_new(ast[base + 1 + j])
    if it = 0 then return 0
    sl[ob_p[o % 2] + j - 1] = it
  end
  return o

bi_filter: procedure = .int
  arg f = .int, x = .int
  it = .int
  o = .int
  it = iter_new(x)
  if it = 0 then return 0
  if f = 2 then f = 0
  return mkiter(11, f, it)

bi_format: procedure = .int
  arg base = .int, na = .int
  sp = .string
  s = .string
  if na < 1 | na > 2 then return nargs_err("format", na, 1, 2)
  sp = ""
  if na = 2 then do
    if kind_of(ast[base + 2]) \= 6 then return raise_exc(38, "format() argument 2 must be str, not " || type_name(ast[base + 2]))
    sp = ob_s[ast[base + 2] % 2]
  end
  s = format_value(ast[base + 1], sp)
  if unw > 0 then return 0
  return mkstr(s)

/* exception __init__(slf, *args) */
bi_exc_init: procedure = .int
  arg base = .int, na = .int
  call inst_set ast[base + 1], 8, tup_from_ast(base + 2, base + na)
  return 2

bi_super: procedure = .int
  arg base = .int, na = .int
  o = .int
  if na \= 2 then return raise_exc(38, "super() argument 1 must be type, not nothing")
  o = newobj(25)
  ob_x[o % 2] = ast[base + 2]
  ob_y[o % 2] = ast[base + 1]
  return o

bi_exit: procedure = .int
  arg base = .int, na = .int
  e = .int
  e = inst_new(47)
  if na >= 1 then call inst_set e, 8, tup_from_ast(base + 1, base + 1)
  else call inst_set e, 8, mktuple(0)
  return raise_obj(e)

/* integer value of a decimal / radix string; 0 with ValueError when invalid */
parse_int: procedure = .int
  arg s0 = .string, bs = .int
  s = .string
  neg = .int
  i = .int
  n = .int
  c = .string
  d = .int
  v = .int
  acc = .string
  digs = .string
  ok = .int
  ch2 = .string
  s = strip(s0)
  neg = 0
  if left(s, 1) == "-" then do
    neg = 1
    s = substr(s, 2)
  end
  else if left(s, 1) == "+" then s = substr(s, 2)
  ch2 = lower(left(s, 2))
  if (bs = 16 | bs = 0) & ch2 == "0x" then do
    s = substr(s, 3)
    bs = 16
  end
  else if (bs = 8 | bs = 0) & ch2 == "0o" then do
    s = substr(s, 3)
    bs = 8
  end
  else if (bs = 2 | bs = 0) & ch2 == "0b" then do
    s = substr(s, 3)
    bs = 2
  end
  if bs = 0 then bs = 10
  ok = 1
  if s == "" then ok = 0
  if left(s, 1) == "_" | right(s, 1) == "_" | pos("__", s) > 0 then ok = 0
  if ok = 1 then do
    if pos("_", s) > 0 then s = changestr("_", s, "")
    n = length(s)
    digs = ""
    do i = 1 to n
      c = lower(substr(s, i, 1))
      if isdigit(c) = 1 then d = c as .int
      else if c >>= "a" & c <<= "z" then d = c2d(c) - 87
      else d = 99
      if d >= bs then do
        ok = 0
        leave
      end
    end
  end
  if ok = 0 then return raise_exc(36, "invalid literal for int() with base " || bs || ": " || repr_str(s0))
  if bs = 10 then do
    if neg = 1 then return big_norm("-" || s)
    return big_norm(s)
  end
  if n <= 12 then do
    v = 0
    do i = 1 to n
      c = lower(substr(s, i, 1))
      if isdigit(c) = 1 then d = c as .int
      else d = c2d(c) - 87
      v = v * bs + d
    end
    if neg = 1 then v = 0 - v
    return mkint(v)
  end
  acc = "0"
  do i = 1 to n
    c = lower(substr(s, i, 1))
    if isdigit(c) = 1 then d = c as .int
    else d = c2d(c) - 87
    acc = sadd(smul(acc, bs as .string), d as .string)
  end
  if neg = 1 then acc = sneg(acc)
  return big_norm(acc)

parse_float_str: procedure = .int
  arg s0 = .string
  s = .string
  neg = .int
  i = .int
  n = .int
  c = .string
  seen_dot = .int
  seen_e = .int
  nd = .int
  ok = .int
  mant = .string
  ex = .string
  p = .int
  l = .string
  f = .float
  s = strip(s0)
  neg = 0
  if left(s, 1) == "-" then do
    neg = 1
    s = substr(s, 2)
  end
  else if left(s, 1) == "+" then s = substr(s, 2)
  l = lower(s)
  if l == "inf" | l == "infinity" then do
    f = f_inf()
    if neg = 1 then f = fneg(f)
    return mkfloat(f)
  end
  if l == "nan" then return mkfloat(f_nan())
  if pos("_", s) > 0 then s = changestr("_", s, "")
  n = length(s)
  ok = 1
  seen_dot = 0
  seen_e = 0
  nd = 0
  i = 1
  do while i <= n
    c = substr(s, i, 1)
    if isdigit(c) = 1 then nd = nd + 1
    else if c == "." & seen_dot = 0 & seen_e = 0 then seen_dot = 1
    else if (c == "e" | c == "E") & seen_e = 0 & nd > 0 then do
      seen_e = 1
      if substr(s, i + 1, 1) == "+" | substr(s, i + 1, 1) == "-" then i = i + 1
      if isdigit(substr(s, i + 1, 1)) = 0 then ok = 0
    end
    else do
      ok = 0
      leave
    end
    i = i + 1
  end
  if nd = 0 | n = 0 then ok = 0
  if ok = 0 then return raise_exc(36, "could not convert string to float: " || repr_str(s0))
  l = lower(s)
  p = pos("e", l)
  ex = ""
  mant = l
  if p > 0 then do
    mant = left(l, p - 1)
    ex = substr(l, p)
  end
  if left(mant, 1) == "." then mant = "0" || mant
  if right(mant, 1) == "." then mant = mant || "0"
  if pos(".", mant) = 0 then mant = mant || ".0"
  f = parse_flt(mant || ex)
  if neg = 1 then f = fneg(f)
  return mkfloat(f)

/* int(...) */
ctor_int: procedure = .int
  arg base = .int, na = .int, nk = .int
  x = .int
  bs = .int
  f = .float
  m = .int
  if na = 0 then return mkint(0)
  x = ast[base + 1]
  bs = 10
  if na >= 2 then do
    if chk_int(ast[base + 2]) = 0 then return 0
    bs = ival(ast[base + 2])
  end
  else if kwarg(base, na, nk, "base") \= 0 then bs = ival(kwarg(base, na, nk, "base"))
  else bs = -1
  if kind_of(x) = 6 | kind_of(x) = 31 then do
    if bs = -1 then bs = 10
    return parse_int(ob_s[x % 2], bs)
  end
  if bs \= -1 then return raise_exc(38, "int() can't convert non-string with explicit base")
  select
    when numkind(x) = 1 then return mkint(ival(x))
    when numkind(x) = 2 then do
      if ob_c[x % 2] = 0 then return x
      return big_norm(ob_s[x % 2])
    end
    when numkind(x) = 3 then do
      f = ob_f[x % 2]
      if f \= f then return raise_exc(36, "cannot convert float NaN to integer")
      if finf(f) \= 0 then return raise_exc(31, "cannot convert float infinity to integer")
      return float_to_int(f)
    end
    when kind_of(x) = 17 then do
      m = cls_find(ob_c[x % 2], 161)
      if m = 0 then m = cls_find(ob_c[x % 2], 159)
      if m > 0 then return call1(m, x)
    end
    otherwise nop
  end
  return raise_exc(38, "int() argument must be a string, a bytes-like object or a real number, not '" || type_name(x) || "'")

ctor_float: procedure = .int
  arg base = .int, na = .int
  x = .int
  m = .int
  if na = 0 then return mkfloat(0.0)
  x = ast[base + 1]
  if kind_of(x) = 6 | kind_of(x) = 31 then return parse_float_str(ob_s[x % 2])
  if numkind(x) > 0 then return mkfloat(tofloat(x))
  if kind_of(x) = 17 then do
    m = cls_find(ob_c[x % 2], 149)
    if m > 0 then return call1(m, x)
  end
  return raise_exc(38, "float() argument must be a string or a real number, not '" || type_name(x) || "'")

ctor_dict: procedure = .int
  arg base = .int, na = .int, nk = .int
  o = .int
  x = .int
  j = .int
  it = .int
  v = .int
  p = .int
  l = .int
  o = dict_new(9)
  if na > 1 then return raise_exc(38, "dict expected at most 1 argument, got " || na)
  if na = 1 then do
    x = ast[base + 1]
    if kind_of(x) = 9 then call dict_update o, x
    else if kind_of(x) = 17 & cls_find(ob_c[x % 2], 67) > 0 then do
      it = iter_new(callz(getattr_obj(x, 67, 0)))
      if it = 0 then return 0
      do forever
        v = iter_next(it)
        if v = 0 then leave
        p = getitem(x, v)
        if p = 0 then return 0
        call dset o, v, p
      end
      if unw > 0 then return 0
    end
    else do
      it = iter_new(x)
      if it = 0 then return 0
      do forever
        v = iter_next(it)
        if v = 0 then leave
        l = iter_list(v)
        if l = 0 then return 0
        if ob_n[l % 2] \= 2 then return raise_exc(36, "dictionary update sequence element has length " || ob_n[l % 2] || "; 2 is required")
        call dset o, sl[ob_p[l % 2]], sl[ob_p[l % 2] + 1]
      end
      if unw > 0 then return 0
    end
  end
  do j = 1 to nk
    call dset o, mkstr(asn[base + na + j]), ast[base + na + j]
  end
  return o

ctor_set: procedure = .int
  arg base = .int, na = .int
  o = .int
  l = .int
  i = .int
  o = dict_new(10)
  if na = 0 then return o
  l = iter_list(ast[base + 1])
  if l = 0 then return 0
  do i = 0 to ob_n[l % 2] - 1
    call dset o, sl[ob_p[l % 2] + i], 4
  end
  return o

ctor_range: procedure = .int
  arg base = .int, na = .int
  a = .int
  b = .int
  c = .int
  i = .int
  if na < 1 | na > 3 then return nargs_err("range", na, 1, 3)
  do i = 1 to na
    if chk_int(ast[base + i]) = 0 then return 0
  end
  a = 0
  c = 1
  if na = 1 then b = ival(ast[base + 1])
  else do
    a = ival(ast[base + 1])
    b = ival(ast[base + 2])
    if na = 3 then c = ival(ast[base + 3])
  end
  if c = 0 then return raise_exc(36, "range() arg 3 must not be zero")
  return mkrange(a, b, c)

/* constructor call of a built-in type class c */
bcall_type: procedure = .int
  arg c = .int, base = .int, na = .int, nk = .int
  x = .int
  l = .int
  o = .int
  ss = .string
  select
    when c = 19 then do
      if na < 1 | na > 3 then return nargs_err("slice", na, 1, 3)
      o = newobj(21)
      if na = 1 then do
        ob_n[o % 2] = 2
        ob_x[o % 2] = ast[base + 1]
        ob_y[o % 2] = 2
      end
      else do
        ob_n[o % 2] = ast[base + 1]
        ob_x[o % 2] = ast[base + 2]
        if na = 3 then ob_y[o % 2] = ast[base + 3]
        else ob_y[o % 2] = 2
      end
      return o
    end
    when c = 11 then return ctor_range(base, na)
    when c = 3 then return ctor_int(base, na, nk)
    when c = 6 then do
      if na = 0 then return mkstr("")
      x = ast[base + 1]
      if kind_of(x) = 31 & (na >= 2 | nk > 0) then return meth_bytes(x, 22, base + 1, na - 1, nk)
      if kind_of(x) = 6 & ob_c[x % 2] = 0 then return x
      ss = str_of(x)
      if unw > 0 then return 0
      return mkstr(ss)
    end
    when c = 83 then return ctor_bytes(0, base, na, nk)
    when c = 84 then return ctor_bytes(1, base, na, nk)
    when c = 85 then return ctor_complex(base, na, nk)
    when c = 4 then return ctor_float(base, na)
    when c = 5 then do
      if na = 0 then return 6
      return mkbool(truthy(ast[base + 1]))
    end
    when c = 7 then do
      if na = 0 then return mklist(4)
      return iter_list(ast[base + 1])
    end
    when c = 8 then do
      if na = 0 then return mktuple(0)
      if kind_of(ast[base + 1]) = 8 & ob_c[ast[base + 1] % 2] = 0 then return ast[base + 1]
      l = iter_list(ast[base + 1])
      if l = 0 then return 0
      return tup_of_list(l)
    end
    when c = 9 then return ctor_dict(base, na, nk)
    when c = 10 then return ctor_set(base, na)
    when c = 1 then return inst_new(1)
    when c = 2 then do
      if na = 1 then return cl_obj[cls_of(ast[base + 1])]
      if na = 3 then return type_new(ast[base + 1], ast[base + 2], ast[base + 3])
      return raise_exc(38, "type() takes 1 or 3 arguments")
    end
    when c = 22 then do
      o = newobj(22)
      ob_x[o % 2] = ast[base + 1]
      ob_y[o % 2] = 0
      if na >= 2 then ob_y[o % 2] = ast[base + 2]
      return o
    end
    when c = 23 then do
      o = newobj(23)
      ob_x[o % 2] = ast[base + 1]
      return o
    end
    when c = 24 then do
      o = newobj(24)
      ob_x[o % 2] = ast[base + 1]
      return o
    end
    otherwise nop
  end
  return raise_exc(38, "cannot create '" || cl_name[c] || "' instances")

/* call of a built-in function */
bcall: procedure = .int
  arg bid = .int, base = .int, na = .int, nk = .int
  r = .int
  x = .int
  rs = .string
  select
    when bid = 1 then return bi_print(base, na, nk)
    when bid = 2 then do
      if na \= 1 then return nargs_err("len", na, 1, 1)
      return bi_len(ast[base + 1])
    end
    when bid = 3 then do
      if na \= 2 then return nargs_err("isinstance", na, 2, 2)
      return bi_isinstance(ast[base + 1], ast[base + 2], 0)
    end
    when bid = 4 then return bi_minmax(base, na, nk, 0)
    when bid = 5 then return bi_minmax(base, na, nk, 1)
    when bid = 6 then do
      if na \= 1 then return nargs_err("abs", na, 1, 1)
      return bi_abs(ast[base + 1])
    end
    when bid = 7 then return bi_sum(base, na, nk)
    when bid = 8 then return bi_sorted(base, na, nk)
    when bid = 9 then return bi_enumerate(base, na, nk)
    when bid = 10 then return bi_zip(base, na)
    when bid = 11 then return bi_map(base, na)
    when bid = 12 then do
      if na \= 2 then return nargs_err("filter", na, 2, 2)
      return bi_filter(ast[base + 1], ast[base + 2])
    end
    when bid = 13 then do
      if na \= 1 then return nargs_err("repr", na, 1, 1)
      rs = repr_of(ast[base + 1])
      if unw > 0 then return 0
      return mkstr(rs)
    end
    when bid = 14 then do
      if na \= 1 then return nargs_err("ascii", na, 1, 1)
      rs = repr_of(ast[base + 1])
      if unw > 0 then return 0
      return mkstr(rs)
    end
    when bid = 15 then do
      if na \= 1 then return nargs_err("any", na, 1, 1)
      return bi_anyall(ast[base + 1], 1)
    end
    when bid = 16 then do
      if na \= 1 then return nargs_err("all", na, 1, 1)
      return bi_anyall(ast[base + 1], 0)
    end
    when bid = 17 then return bi_round(base, na, nk)
    when bid = 18 then do
      if na \= 2 then return nargs_err("divmod", na, 2, 2)
      return bi_divmod(ast[base + 1], ast[base + 2])
    end
    when bid = 19 then return bi_pow(base, na)
    when bid = 20 then do
      if na \= 1 then return nargs_err("chr", na, 1, 1)
      return bi_chr(ast[base + 1])
    end
    when bid = 21 then do
      if na \= 1 then return nargs_err("ord", na, 1, 1)
      return bi_ord(ast[base + 1])
    end
    when bid = 22 then do
      if na \= 1 then return nargs_err("hex", na, 1, 1)
      return bi_radix(ast[base + 1], 16)
    end
    when bid = 23 then do
      if na \= 1 then return nargs_err("oct", na, 1, 1)
      return bi_radix(ast[base + 1], 8)
    end
    when bid = 24 then do
      if na \= 1 then return nargs_err("bin", na, 1, 1)
      return bi_radix(ast[base + 1], 2)
    end
    when bid = 25 then do
      if na \= 2 then return nargs_err("issubclass", na, 2, 2)
      if kind_of(ast[base + 1]) \= 16 then return raise_exc(38, "issubclass() arg 1 must be a class")
      return bi_isinstance(ob_x[ast[base + 1] % 2], ast[base + 2], 1)
    end
    when bid = 26 then return bi_getattr(base, na)
    when bid = 27 then do
      if na \= 2 then return nargs_err("hasattr", na, 2, 2)
      return bi_hasattr(ast[base + 1], ast[base + 2])
    end
    when bid = 28 then do
      if na \= 3 then return nargs_err("setattr", na, 3, 3)
      return bi_setattr(ast[base + 1], ast[base + 2], ast[base + 3])
    end
    when bid = 29 then do
      if na \= 2 then return nargs_err("delattr", na, 2, 2)
      return bi_delattr(ast[base + 1], ast[base + 2])
    end
    when bid = 30 then do
      if na \= 1 then return nargs_err("callable", na, 1, 1)
      return bi_callable(ast[base + 1])
    end
    when bid = 31 then return bi_next(base, na)
    when bid = 32 then do
      if na \= 1 then return nargs_err("iter", na, 1, 1)
      return iter_new(ast[base + 1])
    end
    when bid = 33 then do
      if na \= 1 then return nargs_err("id", na, 1, 1)
      return mkint(ast[base + 1])
    end
    when bid = 34 then do
      if na \= 1 then return nargs_err("hash", na, 1, 1)
      return bi_hash(ast[base + 1])
    end
    when bid = 35 then return bi_input(base, na)
    when bid = 36 then return bi_open(base, na, nk)
    when bid = 37 then do
      if na \= 1 then return nargs_err("reversed", na, 1, 1)
      return bi_reversed(ast[base + 1])
    end
    when bid = 38 then return bi_format(base, na)
    when bid = 39 then return bi_super(base, na)
    when bid = 48 then return bi_exc_init(base, na)
    when bid = 49 then return 2
    when bid = 42 then return bi_globals()
    when bid = 43 then return bi_evalexec(1, base, na)
    when bid = 44 then return bi_evalexec(0, base, na)
    when bid = 47 then return bi_import(base, na)
    when bid = 45 then do
      if na \= 1 then return nargs_err("vars", na, 1, 1)
      return bi_vars(ast[base + 1])
    end
    when bid = 46 then do
      if na \= 1 then return nargs_err("dir", na, 1, 1)
      return bi_dir(ast[base + 1])
    end
    when bid = 40 then return bi_exit(base, na)
    when bid = 41 then return bi_exit(base, na)
    when bid = 52 then do
      return sl[ob_p[ast[base + 1] % 2] + 1]
    end
    when bid = 53 then return sock_call(base, na)
    when bid = 50 then do
      if na >= 1 then return ast[base + 1]
      return 2
    end
    when bid = 51 then do
      if na >= 1 & (kind_of(ast[base + 1]) = 12 | kind_of(ast[base + 1]) = 16) then return ast[base + 1]
      return identity_oop
    end
    otherwise nop
  end
  if bid >= 54 then return bcall_mod(bid, base, na, nk)
  return raise_exc(38, "unsupported built-in function")

/* ---------------------------------------------------------------------
   Methods of the built-in types
   --------------------------------------------------------------------- */
/* a method called on a built-in value; arguments at ast[base+1 ..] */
bmeth: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  k = .int
  k = kind_of(o)
  select
    when k = 6 then return meth_str(o, nid, base, na, nk)
    when k = 7 then return meth_list(o, nid, base, na, nk)
    when k = 9 then return meth_dict(o, nid, base, na, nk)
    when k = 10 then return meth_set(o, nid, base, na, nk)
    when k = 8 then return meth_tuple(o, nid, base, na, nk)
    when k = 3 | k = 4 | k = 2 | k = 5 then return meth_num(o, nid, base, na, nk)
    when k = 19 | k = 20 then return meth_gen(o, nid, base, na, nk)
    when k = 26 then return meth_file(o, nid, base, na, nk)
    when k = 29 then return meth_arr(o, nid, base, na, nk)
    when k = 31 then return meth_bytes(o, nid, base, na, nk)
    when k = 32 then return meth_complex(o, nid, base, na, nk)
    when k = 16 then do
      if nid = 176 then return cls_new(ob_x[o % 2], base, na, nk)
    end
    when k = 22 then do
      if nid = 103 | nid = 42 then do
        k = newobj(22)
        ob_x[k % 2] = ob_x[o % 2]
        ob_y[k % 2] = ob_y[o % 2]
        if nid = 103 then ob_y[k % 2] = ast[base + 1]
        else ob_x[k % 2] = ast[base + 1]
        return k
      end
    end
    otherwise nop
  end
  return meth_common(o, nid, base, na, nk)

/* unbound call  type.method(receiver, args...) */
bmeth_unbound: procedure = .int
  arg c = .int, nid = .int, base = .int, na = .int, nk = .int
  if c = 9 & nid = 39 then return dict_fromkeys(base, na)
  if nid = 176 then return cls_new(c, base, na, nk)
  if nid = 38 & (c = 83 | c = 84) then do
    if c = 84 then return bytes_fromhex(1, base, na)
    return bytes_fromhex(0, base, na)
  end
  if nid = 40 & c = 3 then return int_from_bytes(base, na, nk)
  if nid = 39 & c \= 9 then return raise_exc(41, "type object '" || cl_name[c] || "' has no attribute 'fromkeys'")
  if na < 1 then return raise_exc(38, "descriptor '" || nid_name[nid] || "' of '" || cl_name[c] || "' object needs an argument")
  return bmeth(ast[base + 1], nid, base + 1, na - 1, nk)

meth_common: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  r = .int
  if nsub(o) = 0 then return meth_common0(o, nid, base, na, nk)
  nat_skip = o
  r = meth_common0(o, nid, base, na, nk)
  nat_skip = 0
  return r

meth_common0: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  r = .int
  rs = .string
  if nid = 160 & kind_of(o) \= 17 then return 2
  if kind_of(o) = 17 then do
    select
      when nid = 195 & na = 2 then do
        call setattr_raw o, nameid(ob_s[ast[base + 1] % 2]), ast[base + 2]
        if unw > 0 then return 0
        return 2
      end
      when nid = 153 & na = 1 then return getattr_obj(o, nameid(ob_s[ast[base + 1] % 2]), 0)
      when nid = 141 & na = 1 then return bi_delattr(o, ast[base + 1])
      when nid = 160 then return 2
      when nid = 178 & na = 1 then do
        r = py_eq(o, ast[base + 1])
        if unw > 0 then return 0
        return mkbool(1 - r)
      end
      when nid = 147 & na = 1 then do
        if o = ast[base + 1] then return 4
        return 10
      end
      when nid = 158 then return mkint(o)
      when nid = 185 | nid = 197 then return mkstr(inst_repr0(o))
      otherwise nop
    end
  end
  select
    when nid = 134 then return arith(1, o, ast[base + 1])
    when nid = 198 then return arith(2, o, ast[base + 1])
    when nid = 173 then return arith(3, o, ast[base + 1])
    when nid = 199 then return arith(4, o, ast[base + 1])
    when nid = 150 then return arith(5, o, ast[base + 1])
    when nid = 171 then return arith(6, o, ast[base + 1])
    when nid = 181 then return arith(7, o, ast[base + 1])
    when nid = 166 then return arith(8, o, ast[base + 1])
    when nid = 191 then return arith(9, o, ast[base + 1])
    when nid = 135 then return arith(10, o, ast[base + 1])
    when nid = 179 then return arith(11, o, ast[base + 1])
    when nid = 200 then return arith(12, o, ast[base + 1])
    when nid = 168 then return arith(13, o, ast[base + 1])
    when nid = 183 then return arith(1, ast[base + 1], o)
    when nid = 192 then return arith(2, ast[base + 1], o)
    when nid = 188 then return arith(3, ast[base + 1], o)
    when nid = 193 then return arith(4, ast[base + 1], o)
    when nid = 186 then return arith(5, ast[base + 1], o)
    when nid = 187 then return arith(6, ast[base + 1], o)
    when nid = 190 then return arith(7, ast[base + 1], o)
    when nid = 167 then return py_cmp(3, o, ast[base + 1])
    when nid = 165 then return py_cmp(4, o, ast[base + 1])
    when nid = 157 then return py_cmp(5, o, ast[base + 1])
    when nid = 156 then return py_cmp(6, o, ast[base + 1])
    when nid = 178 then do
      r = py_eq(o, ast[base + 1])
      if unw > 0 then return 0
      return mkbool(1 - r)
    end
    when nid = 175 then return unary(1, o)
    when nid = 180 then return unary(2, o)
    when nid = 162 then return unary(3, o)
    when nid = 133 then return bi_abs(o)
    when nid = 196 then do
      call setitem o, ast[base + 1], ast[base + 2]
      if unw > 0 then return 0
      return 2
    end
    when nid = 142 then do
      call delitem o, ast[base + 1]
      if unw > 0 then return 0
      return 2
    end
    when nid = 164 then return bi_len(o)
    when nid = 197 then do
      rs = str_of(o)
      if unw > 0 then return 0
      return mkstr(rs)
    end
    when nid = 185 then do
      rs = repr_of(o)
      if unw > 0 then return 0
      return mkstr(rs)
    end
    when nid = 163 then return iter_new(o)
    when nid = 177 then do
      r = iter_next(o)
      if r = 0 then do
        if unw > 0 then return 0
        unw = 4
        unw_v = stop_exc(o)
        return 0
      end
      return r
    end
    when nid = 140 then do
      r = py_contains(o, ast[base + 1])
      if unw > 0 then return 0
      return mkbool(r)
    end
    when nid = 155 then return getitem(o, ast[base + 1])
    when nid = 147 then do
      r = py_eq(o, ast[base + 1])
      if unw > 0 then return 0
      return mkbool(r)
    end
    when nid = 158 then return bi_hash(o)
    when nid = 137 then do
      r = truthy(o)
      if unw > 0 then return 0
      return mkbool(r)
    end
    otherwise nop
  end
  return no_attr(o, nid)

/* ---------------------------------------------------------------------
   str
   --------------------------------------------------------------------- */
is_ws: procedure = .int
  arg c = .string
  if c == "" then return 0
  if pos(c, wsch) > 0 then return 1
  return 0

/* mode: 1 left, 2 right, 3 both ; chars "" = white space */
str_strip: procedure = .string
  arg s = .string, chars = .string, mode = .int
  i = .int
  j = .int
  n = .int
  n = length(s)
  i = 1
  j = n
  if mode // 2 = 1 then do
    if chars == "" then do
      do while i <= n & is_ws(substr(s, i, 1)) = 1
        i = i + 1
      end
    end
    else do
      do while i <= n & pos(substr(s, i, 1), chars) > 0
        i = i + 1
      end
    end
  end
  if mode >= 2 then do
    if chars == "" then do
      do while j >= i & is_ws(substr(s, j, 1)) = 1
        j = j - 1
      end
    end
    else do
      do while j >= i & pos(substr(s, j, 1), chars) > 0
        j = j - 1
      end
    end
  end
  if j < i then return ""
  return substr(s, i, j - i + 1)

split_ws: procedure = .int
  arg s = .string, maxsplit = .int
  l = .int
  n = .int
  i = .int
  j = .int
  l = mklist(8)
  n = length(s)
  i = 1
  do forever
    do while i <= n & is_ws(substr(s, i, 1)) = 1
      i = i + 1
    end
    if i > n then leave
    if maxsplit >= 0 & ob_n[l % 2] >= maxsplit then do
      call list_append l, mkstr(substr(s, i))
      leave
    end
    j = i
    do while j <= n & is_ws(substr(s, j, 1)) = 0
      j = j + 1
    end
    call list_append l, mkstr(substr(s, i, j - i))
    i = j
  end
  return l

rsplit_ws: procedure = .int
  arg s = .string, maxsplit = .int
  l = .int
  n = .int
  j = .int
  i = .int
  t = .int
  a = .int
  b = .int
  l = mklist(8)
  n = length(s)
  j = n
  do forever
    do while j >= 1 & is_ws(substr(s, j, 1)) = 1
      j = j - 1
    end
    if j < 1 then leave
    if maxsplit >= 0 & ob_n[l % 2] >= maxsplit then do
      call list_append l, mkstr(left(s, j))
      leave
    end
    i = j
    do while i >= 1 & is_ws(substr(s, i, 1)) = 0
      i = i - 1
    end
    call list_append l, mkstr(substr(s, i + 1, j - i))
    j = i
  end
  /* reverse */
  a = 0
  b = ob_n[l % 2] - 1
  do while a < b
    t = sl[ob_p[l % 2] + a]
    sl[ob_p[l % 2] + a] = sl[ob_p[l % 2] + b]
    sl[ob_p[l % 2] + b] = t
    a = a + 1
    b = b - 1
  end
  return l

split_sep: procedure = .int
  arg s = .string, sep = .string, maxsplit = .int
  l = .int
  p = .int
  i = .int
  ls = .int
  l = mklist(8)
  ls = length(sep)
  i = 1
  do forever
    if maxsplit >= 0 & ob_n[l % 2] >= maxsplit then leave
    p = pos(sep, s, i)
    if p = 0 then leave
    call list_append l, mkstr(substr(s, i, p - i))
    i = p + ls
  end
  call list_append l, mkstr(substr(s, i))
  return l

rsplit_sep: procedure = .int
  arg s = .string, sep = .string, maxsplit = .int
  l = .int
  p = .int
  e = .int
  ls = .int
  a = .int
  b = .int
  t = .int
  l = mklist(8)
  ls = length(sep)
  e = length(s)
  do forever
    if maxsplit >= 0 & ob_n[l % 2] >= maxsplit then leave
    p = 0
    if e >= ls then p = lastpos(sep, s, e)
    if p = 0 then leave
    call list_append l, mkstr(substr(s, p + ls, e - p - ls + 1))
    e = p - 1
  end
  call list_append l, mkstr(left(s, e))
  a = 0
  b = ob_n[l % 2] - 1
  do while a < b
    t = sl[ob_p[l % 2] + a]
    sl[ob_p[l % 2] + a] = sl[ob_p[l % 2] + b]
    sl[ob_p[l % 2] + b] = t
    a = a + 1
    b = b - 1
  end
  return l

str_replace: procedure = .string
  arg s = .string, old = .string, new = .string, cnt = .int
  r = .string
  p = .int
  i = .int
  n = .int
  lo = .int
  c = .int
  if old == "" then do
    n = length(s)
    r = ""
    c = 0
    do i = 1 to n
      if cnt < 0 | c < cnt then do
        r = r || new
        c = c + 1
      end
      r = r || substr(s, i, 1)
    end
    if cnt < 0 | c < cnt then r = r || new
    return r
  end
  lo = length(old)
  r = ""
  i = 1
  c = 0
  do forever
    if cnt >= 0 & c >= cnt then leave
    p = pos(old, s, i)
    if p = 0 then leave
    r = r || substr(s, i, p - i) || new
    i = p + lo
    c = c + 1
  end
  return r || substr(s, i)

/* normalise optional [start, end] arguments (from ast[base+first ..]) to 0-based start and end */
slice_args: procedure = .int
  arg n = .int, base = .int, na = .int, first = .int
  st = .int
  en = .int
  st = 0
  en = n
  if na >= first then do
    if ast[base + first] \= 2 then do
      if chk_int(ast[base + first]) = 0 then return 0
      st = ival(ast[base + first])
      if st < 0 then st = st + n
      if st < 0 then st = 0
    end
  end
  if na >= first + 1 then do
    if ast[base + first + 1] \= 2 then do
      if chk_int(ast[base + first + 1]) = 0 then return 0
      en = ival(ast[base + first + 1])
      if en < 0 then en = en + n
      if en < 0 then en = 0
      if en > n then en = n
    end
  end
  sl_a = st
  sl_n = en
  return 1

str_title: procedure = .string
  arg s = .string
  r = .string
  i = .int
  n = .int
  c = .string
  prev = .int
  r = ""
  prev = 0
  n = length(s)
  do i = 1 to n
    c = substr(s, i, 1)
    if isletter(c) = 1 & c \== "_" then do
      if prev = 1 then r = r || lower(c)
      else r = r || upper(c)
      prev = 1
    end
    else do
      r = r || c
      prev = 0
    end
  end
  return r

str_swapcase: procedure = .string
  arg s = .string
  r = .string
  i = .int
  n = .int
  c = .string
  r = ""
  n = length(s)
  do i = 1 to n
    c = substr(s, i, 1)
    if c >>= "a" & c <<= "z" then r = r || upper(c)
    else if c >>= "A" & c <<= "Z" then r = r || lower(c)
    else r = r || c
  end
  return r

/* character class test: 1 alpha, 2 digit, 3 alnum, 4 space, 5 identifier */
str_isclass: procedure = .int
  arg s = .string, cls = .int
  i = .int
  n = .int
  c = .string
  a = .int
  d = .int
  n = length(s)
  if n = 0 then return 0
  do i = 1 to n
    c = substr(s, i, 1)
    a = 0
    if c >>= "a" & c <<= "z" then a = 1
    else if c >>= "A" & c <<= "Z" then a = 1
    else if c2d(c) >= 128 then a = 1
    d = isdigit(c)
    if cls = 1 & a = 0 then return 0
    if cls = 2 & d = 0 then return 0
    if cls = 3 & a = 0 & d = 0 then return 0
    if cls = 4 & is_ws(c) = 0 then return 0
    if cls = 5 then do
      if a = 0 & c \== "_" then do
        if d = 0 | i = 1 then return 0
      end
    end
  end
  return 1

str_pad_arg: procedure = .string
  arg base = .int, na = .int, idx = .int
  v = .int
  if na < idx then return " "
  v = ast[base + idx]
  if kind_of(v) \= 6 | length(ob_s[v % 2]) \= 1 then do
    call raise_exc 38, "The fill character must be exactly one character long"
    return " "
  end
  return ob_s[v % 2]

meth_str: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  s = .string
  a = .string
  b = .string
  n = .int
  i = .int
  j = .int
  p = .int
  r = .int
  v = .int
  l = .int
  c = .int
  t = .string
  w = .int
  m = .int
  f = .string
  st = .int
  en = .int
  x = .string
  s = ob_s[o % 2]
  select
    when nid = 66 then do
      if na \= 1 then return nargs_err("join", na, 1, 1)
      l = iter_list(ast[base + 1])
      if l = 0 then return 0
      n = ob_n[l % 2]
      t = ""
      do i = 0 to n - 1
        v = sl[ob_p[l % 2] + i]
        if kind_of(v) \= 6 then return raise_exc(38, "sequence item " || i || ": expected str instance, " || type_name(v) || " found")
        if i > 0 then t = t || s
        t = t || ob_s[v % 2]
      end
      return mkstr(t)
    end
    when nid = 126 then return mkstr(upper(s))
    when nid = 69 | nid = 12 then return mkstr(lower(s))
    when nid = 114 | nid = 70 | nid = 100 then do
      a = ""
      if na >= 1 then do
        if ast[base + 1] \= 2 then a = ob_s[ast[base + 1] % 2]
      end
      m = 3
      if nid = 70 then m = 1
      if nid = 100 then m = 2
      return mkstr(str_strip(s, a, m))
    end
    when nid = 107 | nid = 99 then do
      a = ""
      w = 0
      m = -1
      if na >= 1 then do
        if ast[base + 1] \= 2 then do
          if kind_of(ast[base + 1]) \= 6 then return raise_exc(38, "must be str or None, not " || type_name(ast[base + 1]))
          a = ob_s[ast[base + 1] % 2]
          w = 1
          if a == "" then return raise_exc(36, "empty separator")
        end
      end
      if na >= 2 then m = ival(ast[base + 2])
      if kwarg(base, na, nk, "maxsplit") \= 0 then m = ival(kwarg(base, na, nk, "maxsplit"))
      if kwarg(base, na, nk, "sep") \= 0 then do
        if kwarg(base, na, nk, "sep") \= 2 then do
          a = ob_s[kwarg(base, na, nk, "sep") % 2]
          w = 1
        end
      end
      if nid = 107 then do
        if w = 0 then return split_ws(s, m)
        return split_sep(s, a, m)
      end
      if w = 0 then return rsplit_ws(s, m)
      return rsplit_sep(s, a, m)
    end
    when nid = 91 then do
      if na < 2 then return nargs_err("replace", na, 2, 3)
      if kind_of(ast[base + 1]) \= 6 | kind_of(ast[base + 2]) \= 6 then return raise_exc(38, "replace() argument must be str")
      m = -1
      if na >= 3 then m = ival(ast[base + 3])
      return mkstr(str_replace(s, ob_s[ast[base + 1] % 2], ob_s[ast[base + 2] % 2], m))
    end
    when nid = 34 | nid = 94 | nid = 45 | nid = 95 | nid = 20 then do
      if na < 1 then return nargs_err(nid_name[nid], na, 1, 3)
      if kind_of(ast[base + 1]) \= 6 then return raise_exc(38, "must be str, not " || type_name(ast[base + 1]))
      a = ob_s[ast[base + 1] % 2]
      if slice_args(length(s), base, na, 2) = 0 then return 0
      st = sl_a
      en = sl_n
      if st > en | st > length(s) then do
        if nid = 20 then return mkint(0)
        if nid = 34 | nid = 94 then return mkint(-1)
        return raise_exc(36, "substring not found")
      end
      t = substr(s, st + 1, en - st)
      if nid = 20 then do
        if a == "" then return mkint(length(t) + 1)
        return mkint(countstr(a, t))
      end
      if a == "" then do
        if nid = 94 | nid = 95 then return mkint(en)
        return mkint(st)
      end
      if nid = 34 | nid = 45 then p = pos(a, t)
      else p = lastpos(a, t)
      if p = 0 then do
        if nid = 34 | nid = 94 then return mkint(-1)
        return raise_exc(36, "substring not found")
      end
      return mkint(p - 1 + st)
    end
    when nid = 110 | nid = 30 then do
      if na < 1 then return nargs_err(nid_name[nid], na, 1, 3)
      if slice_args(length(s), base, na, 2) = 0 then return 0
      st = sl_a
      en = sl_n
      if st > en then return 6
      t = substr(s, st + 1, en - st)
      v = ast[base + 1]
      if kind_of(v) = 6 then do
        l = 1
        i = 0
        j = 0
      end
      else if kind_of(v) = 8 then do
        l = ob_n[v % 2]
        i = 0
      end
      else return raise_exc(38, nid_name[nid] || " first arg must be str or a tuple of str, not " || type_name(v))
      do j = 0 to l - 1
        if kind_of(v) = 6 then a = ob_s[v % 2]
        else a = ob_s[sl[ob_p[v % 2] + j] % 2]
        n = length(a)
        if n <= length(t) then do
          if nid = 110 then do
            if left(t, n) == a then return 4
          end
          else do
            if n = 0 then return 4
            if right(t, n) == a then return 4
          end
        end
      end
      return 6
    end
    when nid = 50 then return mkbool(str_isclass(s, 1))
    when nid = 53 | nid = 52 | nid = 57 then return mkbool(str_isclass(s, 2))
    when nid = 49 then return mkbool(str_isclass(s, 3))
    when nid = 58 then return mkbool(str_isclass(s, 4))
    when nid = 55 then return mkbool(str_isclass(s, 5))
    when nid = 62 then do
      if upper(s) == s & lower(s) \== s then return 4
      return 6
    end
    when nid = 56 then do
      if lower(s) == s & upper(s) \== s then return 4
      return 6
    end
    when nid = 61 then do
      if str_title(s) == s & upper(s) \== lower(s) then return 4
      return 6
    end
    when nid = 51 then do
      do i = 1 to length(s)
        if c2d(substr(s, i, 1)) >= 128 then return 6
      end
      return 4
    end
    when nid = 11 then return mkstr(upper(left(s, 1)) || lower(substr(s, 2)))
    when nid = 119 then return mkstr(str_title(s))
    when nid = 116 then return mkstr(str_swapcase(s))
    when nid = 13 | nid = 68 | nid = 96 then do
      if na < 1 then return nargs_err(nid_name[nid], na, 1, 2)
      if chk_int(ast[base + 1]) = 0 then return 0
      w = ival(ast[base + 1])
      f = str_pad_arg(base, na, 2)
      if unw > 0 then return 0
      n = length(s)
      if w <= n then return o
      m = w - n
      if nid = 68 then return mkstr(s || copies(f, m))
      if nid = 96 then return mkstr(copies(f, m) || s)
      i = m % 2 + (m // 2) * (w // 2)
      return mkstr(copies(f, i) || s || copies(f, m - i))
    end
    when nid = 132 then do
      if chk_int(ast[base + 1]) = 0 then return 0
      w = ival(ast[base + 1])
      n = length(s)
      if w <= n then return o
      if left(s, 1) == "-" | left(s, 1) == "+" then return mkstr(left(s, 1) || copies("0", w - n) || substr(s, 2))
      return mkstr(copies("0", w - n) || s)
    end
    when nid = 78 | nid = 98 then do
      if na \= 1 then return nargs_err(nid_name[nid], na, 1, 1)
      if kind_of(ast[base + 1]) \= 6 then return raise_exc(38, "must be str, not " || type_name(ast[base + 1]))
      a = ob_s[ast[base + 1] % 2]
      if a == "" then return raise_exc(36, "empty separator")
      if nid = 78 then p = pos(a, s)
      else p = lastpos(a, s)
      v = mktuple(3)
      if p = 0 then do
        if nid = 78 then do
          sl[ob_p[v % 2]] = o
          sl[ob_p[v % 2] + 1] = mkstr("")
          sl[ob_p[v % 2] + 2] = mkstr("")
        end
        else do
          sl[ob_p[v % 2]] = mkstr("")
          sl[ob_p[v % 2] + 1] = mkstr("")
          sl[ob_p[v % 2] + 2] = o
        end
        return v
      end
      sl[ob_p[v % 2]] = mkstr(left(s, p - 1))
      sl[ob_p[v % 2] + 1] = ast[base + 1]
      sl[ob_p[v % 2] + 2] = mkstr(substr(s, p + length(a)))
      return v
    end
    when nid = 37 then return fmt_format(s, base, na, nk)
    when nid = 108 then do
      l = mklist(8)
      m = 0
      if na >= 1 then m = truthy(ast[base + 1])
      if kwarg(base, na, nk, "keepends") \= 0 then m = truthy(kwarg(base, na, nk, "keepends"))
      n = length(s)
      i = 1
      do while i <= n
        j = i
        do while j <= n & substr(s, j, 1) \== '0a'x & substr(s, j, 1) \== '0d'x
          j = j + 1
        end
        p = j
        if j <= n then do
          if substr(s, j, 1) == '0d'x & substr(s, j + 1, 1) == '0a'x then j = j + 2
          else j = j + 1
        end
        if m = 1 then call list_append l, mkstr(substr(s, i, j - i))
        else call list_append l, mkstr(substr(s, i, p - i))
        i = j
      end
      return l
    end
    when nid = 29 then do
      a = enc_arg(base, na, nk, 1)
      if unw > 0 then return 0
      t = str_encode(s, a, err_arg(base, na, nk, 2))
      if unw > 0 then return 0
      return mkbytes(t)
    end
    when nid = 22 then return o
    when nid = 89 then do
      a = ob_s[ast[base + 1] % 2]
      if length(a) <= length(s) then do
        if left(s, length(a)) == a then return mkstr(substr(s, length(a) + 1))
      end
      return o
    end
    when nid = 90 then do
      a = ob_s[ast[base + 1] % 2]
      if length(a) <= length(s) & length(a) > 0 then do
        if right(s, length(a)) == a then return mkstr(left(s, length(s) - length(a)))
      end
      return o
    end
    when nid = 31 then do
      w = 8
      if na >= 1 then w = ival(ast[base + 1])
      t = ""
      c = 0
      do i = 1 to length(s)
        a = substr(s, i, 1)
        if a == '09'x then do
          m = w - (c // w)
          t = t || copies(" ", m)
          c = c + m
        end
        else if a == '0a'x then do
          t = t || a
          c = 0
        end
        else do
          t = t || a
          c = c + 1
        end
      end
      return mkstr(t)
    end
    when nid = 122 then return o
    otherwise nop
  end
  return meth_common(o, nid, base, na, nk)

/* ---------------------------------------------------------------------
   list
   --------------------------------------------------------------------- */
meth_list: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  ix = .int
  n = .int
  p = .int
  i = .int
  j = .int
  v = .int
  l = .int
  r = .int
  keyf = .int
  rev = .int
  st = .int
  en = .int
  t = .int
  ix = o % 2
  select
    when nid = 160 then do
      ob_n[ix] = 0
      if na >= 1 then do
        l = iter_list(ast[base + 1])
        if l = 0 then return 0
        call list_extend_from o, l
      end
      return 2
    end
    when nid = 4 then do
      if na \= 1 then return nargs_err("append", na, 1, 1)
      call list_append o, ast[base + 1]
      return 2
    end
    when nid = 79 then do
      n = ob_n[ix]
      if n = 0 then return raise_exc(34, "pop from empty list")
      i = n - 1
      if na >= 1 then do
        if chk_int(ast[base + 1]) = 0 then return 0
        i = ival(ast[base + 1])
        if i < 0 then i = i + n
        if i < 0 | i >= n then return raise_exc(34, "pop index out of range")
      end
      p = ob_p[ix]
      v = sl[p + i]
      do j = i to n - 2
        sl[p + j] = sl[p + j + 1]
      end
      ob_n[ix] = n - 1
      return v
    end
    when nid = 32 then do
      if na \= 1 then return nargs_err("extend", na, 1, 1)
      l = iter_list(ast[base + 1])
      if l = 0 then return 0
      call list_extend_from o, l
      return 2
    end
    when nid = 46 then do
      if na \= 2 then return nargs_err("insert", na, 2, 2)
      if chk_int(ast[base + 1]) = 0 then return 0
      n = ob_n[ix]
      i = ival(ast[base + 1])
      if i < 0 then i = i + n
      if i < 0 then i = 0
      if i > n then i = n
      call list_reserve o, n + 1
      p = ob_p[ix]
      do j = n - 1 to i by -1
        sl[p + j + 1] = sl[p + j]
      end
      sl[p + i] = ast[base + 2]
      ob_n[ix] = n + 1
      return 2
    end
    when nid = 88 then do
      if na \= 1 then return nargs_err("remove", na, 1, 1)
      n = ob_n[ix]
      p = ob_p[ix]
      do i = 0 to n - 1
        r = py_eq(sl[p + i], ast[base + 1])
        if unw > 0 then return 0
        if r = 1 then do
          do j = i to n - 2
            sl[p + j] = sl[p + j + 1]
          end
          ob_n[ix] = n - 1
          return 2
        end
      end
      return raise_exc(36, "list.remove(x): x not in list")
    end
    when nid = 45 | nid = 20 then do
      if na < 1 then return nargs_err(nid_name[nid], na, 1, 3)
      n = ob_n[ix]
      p = ob_p[ix]
      st = 0
      en = n
      if nid = 45 then do
        if slice_args(n, base, na, 2) = 0 then return 0
        st = sl_a
        en = sl_n
      end
      j = 0
      do i = st to en - 1
        r = py_eq(sl[p + i], ast[base + 1])
        if unw > 0 then return 0
        if r = 1 then do
          if nid = 45 then return mkint(i)
          j = j + 1
        end
      end
      if nid = 20 then return mkint(j)
      return raise_exc(36, repr_of(ast[base + 1]) || " is not in list")
    end
    when nid = 106 then do
      keyf = kwarg(base, na, nk, "key")
      if keyf = 2 then keyf = 0
      rev = 0
      r = kwarg(base, na, nk, "reverse")
      if r \= 0 then rev = truthy(r)
      if sort_list(o, keyf, rev) = 0 then return 0
      return 2
    end
    when nid = 93 then do
      n = ob_n[ix]
      p = ob_p[ix]
      i = 0
      j = n - 1
      do while i < j
        t = sl[p + i]
        sl[p + i] = sl[p + j]
        sl[p + j] = t
        i = i + 1
        j = j - 1
      end
      return 2
    end
    when nid = 19 then return iter_list(o)
    when nid = 14 then do
      ob_n[ix] = 0
      return 2
    end
    when nid = 81 then do
      n = ob_n[ix]
      if n = 0 then return raise_exc(34, "pop from an empty deque")
      p = ob_p[ix]
      v = sl[p]
      do j = 0 to n - 2
        sl[p + j] = sl[p + j + 1]
      end
      ob_n[ix] = n - 1
      return v
    end
    when nid = 5 then do
      n = ob_n[ix]
      call list_reserve o, n + 1
      p = ob_p[ix]
      do j = n - 1 to 0 by -1
        sl[p + j + 1] = sl[p + j]
      end
      sl[p] = ast[base + 1]
      ob_n[ix] = n + 1
      return 2
    end
    otherwise nop
  end
  return meth_common(o, nid, base, na, nk)

meth_tuple: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  n = .int
  p = .int
  i = .int
  j = .int
  r = .int
  n = ob_n[o % 2]
  p = ob_p[o % 2]
  if nid = 45 | nid = 20 then do
    if na < 1 then return nargs_err(nid_name[nid], na, 1, 3)
    j = 0
    do i = 0 to n - 1
      r = py_eq(sl[p + i], ast[base + 1])
      if unw > 0 then return 0
      if r = 1 then do
        if nid = 45 then return mkint(i)
        j = j + 1
      end
    end
    if nid = 20 then return mkint(j)
    return raise_exc(36, "tuple.index(x): x not in tuple")
  end
  return meth_common(o, nid, base, na, nk)

/* ---------------------------------------------------------------------
   dict
   --------------------------------------------------------------------- */
dict_fill: procedure = .int
  arg o = .int, x = .int
  it = .int
  v = .int
  l = .int
  if kind_of(x) = 9 then do
    call dict_update o, x
    return 1
  end
  it = iter_new(x)
  if it = 0 then return 0
  do forever
    v = iter_next(it)
    if v = 0 then leave
    l = iter_list(v)
    if l = 0 then return 0
    if ob_n[l % 2] \= 2 then do
      call raise_exc 36, "dictionary update sequence element has length " || ob_n[l % 2] || "; 2 is required"
      return 0
    end
    call dset o, sl[ob_p[l % 2]], sl[ob_p[l % 2] + 1]
  end
  if unw > 0 then return 0
  return 1

dict_fromkeys: procedure = .int
  arg base = .int, na = .int
  o = .int
  l = .int
  i = .int
  v = .int
  if na < 1 | na > 2 then return nargs_err("fromkeys", na, 1, 2)
  o = dict_new(9)
  v = 2
  if na = 2 then v = ast[base + 2]
  l = iter_list(ast[base + 1])
  if l = 0 then return 0
  do i = 0 to ob_n[l % 2] - 1
    call dset o, sl[ob_p[l % 2] + i], v
  end
  return o

meth_dict: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  d = .int
  e = .int
  l = .int
  t = .int
  v = .int
  j = .int
  last = .int
  r = .int
  it = .int
  a = .int
  d = ob_x[o % 2]
  select
    when nid = 160 then do
      call dict_clear d
      if na >= 1 then do
        if dict_fill(o, ast[base + 1]) = 0 then return 0
      end
      do j = 1 to nk
        call dset o, mkstr(asn[base + na + j]), ast[base + na + j]
      end
      return 2
    end
    when nid = 41 then do
      if na < 1 | na > 2 then return nargs_err("get", na, 1, 2)
      e = dict_find(d, hashkey(ast[base + 1]))
      if e > 0 then return de_val[e]
      if na = 2 then return ast[base + 2]
      return 2
    end
    when nid = 65 | nid = 67 | nid = 128 then do
      t = newobj(30)
      ob_x[t % 2] = o
      if nid = 67 then ob_n[t % 2] = 1
      else if nid = 128 then ob_n[t % 2] = 2
      else ob_n[t % 2] = 3
      return t
    end
    when nid = 102 then do
      if na < 1 | na > 2 then return nargs_err("setdefault", na, 1, 2)
      e = dict_find(d, hashkey(ast[base + 1]))
      if e > 0 then return de_val[e]
      v = 2
      if na = 2 then v = ast[base + 2]
      call dset o, ast[base + 1], v
      return v
    end
    when nid = 79 then do
      if na < 1 | na > 2 then return nargs_err("pop", na, 1, 2)
      e = dict_find(d, hashkey(ast[base + 1]))
      if e = 0 then do
        if na = 2 then return ast[base + 2]
        return raise_key(ast[base + 1])
      end
      v = de_val[e]
      r = dict_del(d, de_hk[e])
      return v
    end
    when nid = 80 then do
      last = 0
      e = dd_head[d]
      do while e > 0
        if de_live[e] = 1 then last = e
        e = de_next[e]
      end
      if last = 0 then return raise_exc(35, "popitem(): dictionary is empty")
      t = mktuple(2)
      sl[ob_p[t % 2]] = de_key[last]
      sl[ob_p[t % 2] + 1] = de_val[last]
      r = dict_del(d, de_hk[last])
      return t
    end
    when nid = 125 then do
      if na >= 1 then do
        if dict_fill(o, ast[base + 1]) = 0 then return 0
      end
      do j = 1 to nk
        call dset o, mkstr(asn[base + na + j]), ast[base + na + j]
      end
      return 2
    end
    when nid = 19 then do
      t = dict_copy(o)
      ob_y[t % 2] = ob_y[o % 2]
      return t
    end
    when nid = 14 then do
      call dict_clear d
      return 2
    end
    when nid = 74 then do
      l = iter_list(meth_dict(o, 65, base, 0, 0))
      /* stable sort by count, descending */
      a = newobj(13)
      ob_x[a % 2] = 52
      if sort_list(l, a, 1) = 0 then return 0
      if na >= 1 then do
        t = mklist(4)
        do j = 0 to ival(ast[base + 1]) - 1
          if j < ob_n[l % 2] then call list_append t, sl[ob_p[l % 2] + j]
        end
        return t
      end
      return l
    end
    otherwise nop
  end
  return meth_common(o, nid, base, na, nk)

/* ---------------------------------------------------------------------
   set
   --------------------------------------------------------------------- */
meth_set: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  d = .int
  e = .int
  l = .int
  t = .int
  v = .int
  i = .int
  j = .int
  r = .int
  x = .int
  ok = .int
  d = ob_x[o % 2]
  select
    when nid = 160 then do
      call dict_clear d
      if na >= 1 then do
        l = iter_list(ast[base + 1])
        if l = 0 then return 0
        do i = 0 to ob_n[l % 2] - 1
          call dset o, sl[ob_p[l % 2] + i], 4
        end
      end
      return 2
    end
    when nid = 1 then do
      if na \= 1 then return nargs_err("add", na, 1, 1)
      call dset o, ast[base + 1], 4
      return 2
    end
    when nid = 26 then do
      r = dict_del(d, hashkey(ast[base + 1]))
      return 2
    end
    when nid = 88 then do
      r = dict_del(d, hashkey(ast[base + 1]))
      if r = 0 then return raise_key(ast[base + 1])
      return 2
    end
    when nid = 79 then do
      e = de_live_from(dd_head[d])
      if e = 0 then return raise_exc(35, "pop from an empty set")
      v = de_key[e]
      r = dict_del(d, de_hk[e])
      return v
    end
    when nid = 19 then do
      return dict_copy(o)
    end
    when nid = 14 then do
      call dict_clear d
      return 2
    end
    when nid = 124 | nid = 47 | nid = 24 | nid = 117 then do
      t = dict_copy(o)
      do i = 1 to na
        x = ast[base + i]
        if kind_of(x) \= 10 then do
          l = iter_list(x)
          if l = 0 then return 0
          x = dict_new(10)
          do j = 0 to ob_n[l % 2] - 1
            call dset x, sl[ob_p[l % 2] + j], 4
          end
        end
        if nid = 124 then t = set_op(11, t, x)
        else if nid = 47 then t = set_op(10, t, x)
        else if nid = 24 then t = set_op(2, t, x)
        else t = set_op(12, t, x)
      end
      return t
    end
    when nid = 125 | nid = 48 | nid = 25 then do
      do i = 1 to na
        x = ast[base + i]
        if kind_of(x) \= 10 then do
          l = iter_list(x)
          if l = 0 then return 0
          x = dict_new(10)
          do j = 0 to ob_n[l % 2] - 1
            call dset x, sl[ob_p[l % 2] + j], 4
          end
        end
        if nid = 125 then t = set_op(11, o, x)
        else if nid = 48 then t = set_op(10, o, x)
        else t = set_op(2, o, x)
        ob_x[o % 2] = ob_x[t % 2]
        ob_x[t % 2] = 0
      end
      return 2
    end
    when nid = 59 | nid = 60 | nid = 54 then do
      x = ast[base + 1]
      if kind_of(x) \= 10 then do
        l = iter_list(x)
        if l = 0 then return 0
        x = dict_new(10)
        do j = 0 to ob_n[l % 2] - 1
          call dset x, sl[ob_p[l % 2] + j], 4
        end
      end
      if nid = 59 then return set_cmp(4, o, x)
      if nid = 60 then return set_cmp(6, o, x)
      t = set_op(10, o, x)
      if dd_n[ob_x[t % 2]] = 0 then return 4
      return 6
    end
    otherwise nop
  end
  return meth_common(o, nid, base, na, nk)

/* ---------------------------------------------------------------------
   numbers, generators, files
   --------------------------------------------------------------------- */
meth_num: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  s = .string
  f = .float
  if nid = 10 then do
    s = num_str(o)
    if left(s, 1) == "-" then s = substr(s, 2)
    if s == "0" then return mkint(0)
    return mkint(length(radix_str(s, 2)))
  end
  if nid = 63 then do
    if kind_of(o) \= 5 then return 4
    f = ob_f[o % 2]
    if f = rxfloat..floor(f) & rxfloat..fabs(f) < 1.0e300 then return 4
    return 6
  end
  if nid = 18 then return o
  if nid = 121 & kind_of(o) \= 5 then return int_to_bytes(o, base, na, nk)
  if nid = 97 & kind_of(o) = 5 then do
    if na = 0 then return o
    return mkfloat(np_round1(ob_f[o % 2], ival(ast[base + 1])))
  end
  return meth_common(o, nid, base, na, nk)

stop_exc: procedure = .int
  arg o = .int
  e = .int
  e = exc_new0(45)
  if kind_of(o) = 19 then call inst_set e, 127, gn_ret[ob_x[o % 2]]
  else call inst_set e, 127, 2
  return e

meth_gen: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  v = .int
  g = .int
  e = .int
  if nid = 101 then do
    if kind_of(o) \= 19 then return no_attr(o, nid)
    v = gen_resume(ob_x[o % 2], ast[base + 1])
    if v = 0 then do
      if unw > 0 then return 0
      unw = 4
      unw_v = stop_exc(o)
      return 0
    end
    return v
  end
  if nid = 118 & kind_of(o) = 19 then do
    g = ob_x[o % 2]
    e = ast[base + 1]
    if kind_of(e) = 16 then e = exc_new0(ob_x[e % 2])
    if gn_st[g] = 0 | gn_st[g] = 3 then do
      gn_st[g] = 3
      unw = 4
      unw_v = e
      return 0
    end
    gen_throw = e
    v = gen_resume(g, 2)
    gen_throw = 0
    if v = 0 then do
      if unw > 0 then return 0
      unw = 4
      unw_v = stop_exc(o)
      return 0
    end
    return v
  end
  if nid = 16 then do
    if kind_of(o) = 19 then do
      g = ob_x[o % 2]
      if gn_st[g] = 1 then do
        gen_throw = exc_new0(49)
        v = gen_resume(g, 2)
        gen_throw = 0
        if v = 0 then do
          if unw = 4 then do
            if cls_issub(ob_c[unw_v % 2], 49) = 1 | cls_issub(ob_c[unw_v % 2], 45) = 1 then unw = 0
          end
          if unw > 0 then return 0
        end
        else do
          gn_st[g] = 3
          return raise_exc(42, "generator ignored GeneratorExit")
        end
      end
      gn_st[g] = 3
    end
    return 2
  end
  return meth_common(o, nid, base, na, nk)

/* ---------------------------------------------------------------------
   Files, modules (math random sys time itertools functools collections copy)
   --------------------------------------------------------------------- */
mk_file: procedure = .int
  arg id = .int, name = .string
  o = .int
  o = newobj(26)
  ob_x[o % 2] = id
  ob_s[o % 2] = name
  ob_c[o % 2] = 0
  return o

bi_open: procedure = .int
  arg base = .int, na = .int, nk = .int
  fn = .string
  mode = .string
  md = .string
  fid = .int
  rcx = .int
  eof = .int
  line = .string
  acc = .string
  chunk = .string
  nl = .int
  id = .int
  v = .int
  if na < 1 then return nargs_err("open", na, 1, 2)
  if kind_of(ast[base + 1]) \= 6 then return raise_exc(38, "expected str, bytes or os.PathLike object, not " || type_name(ast[base + 1]))
  fn = ob_s[ast[base + 1] % 2]
  mode = "r"
  if na >= 2 then mode = ob_s[ast[base + 2] % 2]
  v = kwarg(base, na, nk, "mode")
  if v \= 0 then mode = ob_s[v % 2]
  md = left(mode, 1)
  if md \== "r" & md \== "w" & md \== "a" & md \== "x" then return raise_exc(36, "invalid mode: " || repr_str(mode))
  nfl = nfl + 1
  id = nfl
  fl_mode[id] = md
  fl_pos[id] = 1
  fl_txt[id] = ""
  fid = 0
  if md == "r" then do
    md = "r"
    assembler fopen fid, fn, md
    if fid = 0 then do
      nfl = nfl - 1
      return raise_exc(54, "[Errno 2] No such file or directory: " || repr_str(fn))
    end
    acc = ""
    chunk = ""
    nl = 0
    eof = 0
    do while eof = 0
      line = ""
      assembler freadline line, fid
      assembler feof eof, fid
      if eof > 0 & length(line) = 0 then leave
      chunk = chunk || line || '0a'x
      nl = nl + 1
      if nl >= 100 then do
        acc = acc || chunk
        chunk = ""
        nl = 0
      end
    end
    assembler fclose rcx, fid
    fl_txt[id] = acc || chunk
    fl_h[id] = 0
  end
  else do
    if md == "x" then md = "w"
    assembler fopen fid, fn, md
    if fid = 0 then do
      nfl = nfl - 1
      return raise_exc(53, "[Errno 13] Permission denied: " || repr_str(fn))
    end
    fl_h[id] = fid
  end
  return mk_file(id, fn)

file_write: procedure = .void
  arg fo = .int, txt = .string
  id = .int
  r = .int
  fid = .int
  id = ob_x[fo % 2]
  if ob_c[fo % 2] = 1 then do
    r = raise_exc(36, "I/O operation on closed file.")
    return
  end
  if id = 1 then call outs txt
  else if id = 2 then call errs txt
  else if id = 3 | fl_mode[id] == "r" then r = raise_exc(53, "not writable")
  else do
    fid = fl_h[id]
    assembler fwrite fid, txt
  end
  return

file_close: procedure = .void
  arg fo = .int
  id = .int
  rcx = .int
  fid = .int
  id = ob_x[fo % 2]
  if ob_c[fo % 2] = 1 | id <= 3 then return
  ob_c[fo % 2] = 1
  if fl_mode[id] \== "r" then do
    fid = fl_h[id]
    assembler fclose rcx, fid
  end
  return

/* next line including its newline; 0 at the end of the file in iteration mode, "" otherwise */
file_readline: procedure = .int
  arg fo = .int, itermode = .int
  id = .int
  line = .string
  e = .int
  p = .int
  t = .string
  id = ob_x[fo % 2]
  if ob_c[fo % 2] = 1 then return raise_exc(36, "I/O operation on closed file.")
  if id = 3 then do
    if stdin_eof = 1 then do
      if itermode = 1 then return 0
      return mkstr("")
    end
    line = ""
    assembler freadline line, h_in
    assembler feof e, h_in
    if e > 0 & length(line) = 0 then do
      stdin_eof = 1
      if itermode = 1 then return 0
      return mkstr("")
    end
    if right(line, 1) == '0d'x then line = left(line, length(line) - 1)
    return mkstr(line || '0a'x)
  end
  if fl_mode[id] \== "r" then return raise_exc(53, "not readable")
  t = fl_txt[id]
  if fl_pos[id] > length(t) then do
    if itermode = 1 then return 0
    return mkstr("")
  end
  p = pos('0a'x, t, fl_pos[id])
  if p = 0 then p = length(t)
  line = substr(t, fl_pos[id], p - fl_pos[id] + 1)
  fl_pos[id] = p + 1
  return mkstr(line)

meth_file: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  id = .int
  l = .int
  v = .int
  s = .string
  it = .int
  n = .int
  line = .string
  e = .int
  id = ob_x[o % 2]
  select
    when nid = 130 then do
      if na \= 1 then return nargs_err("write", na, 1, 1)
      if kind_of(ast[base + 1]) \= 6 then return raise_exc(38, "write() argument must be str, not " || type_name(ast[base + 1]))
      call file_write o, ob_s[ast[base + 1] % 2]
      if unw > 0 then return 0
      return mkint(length(ob_s[ast[base + 1] % 2]))
    end
    when nid = 85 then return file_readline(o, 0)
    when nid = 84 then do
      if ob_c[o % 2] = 1 then return raise_exc(36, "I/O operation on closed file.")
      s = ""
      if id = 3 then do
        do while stdin_eof = 0
          line = ""
          assembler freadline line, h_in
          assembler feof e, h_in
          if e > 0 & length(line) = 0 then do
            stdin_eof = 1
            leave
          end
          s = s || line || '0a'x
        end
        return mkstr(s)
      end
      if fl_mode[id] \== "r" then return raise_exc(53, "not readable")
      s = substr(fl_txt[id], fl_pos[id])
      if na >= 1 then do
        if ast[base + 1] \= 2 then do
          n = ival(ast[base + 1])
          if n >= 0 then s = left(s, n)
        end
      end
      fl_pos[id] = fl_pos[id] + length(s)
      return mkstr(s)
    end
    when nid = 86 then do
      l = mklist(8)
      do forever
        v = file_readline(o, 1)
        if v = 0 then leave
        call list_append l, v
      end
      if unw > 0 then return 0
      return l
    end
    when nid = 131 then do
      it = iter_new(ast[base + 1])
      if it = 0 then return 0
      do forever
        v = iter_next(it)
        if v = 0 then leave
        call file_write o, str_of(v)
        if unw > 0 then return 0
      end
      return 2
    end
    when nid = 16 then do
      call file_close o
      return 2
    end
    when nid = 36 then do
      if id = 1 then call flush_out
      return 2
    end
    when nid = 146 then return o
    when nid = 148 then do
      call file_close o
      return 6
    end
    otherwise nop
  end
  return meth_common(o, nid, base, na, nk)

/* ---------------------------------------------------------------------
   modules
   --------------------------------------------------------------------- */
/* float value of a numeric argument; raises TypeError otherwise */
mf: procedure = .float
  arg v = .int
  if numkind(v) = 0 then do
    call raise_exc 38, "must be real number, not " || type_name(v)
    return 0.0
  end
  return tofloat(v)

domain_err: procedure = .int
  return raise_exc(36, "math domain error")

rnd_next: procedure = .int
  rnd_s = (rnd_s * 48271) // 2147483647
  return rnd_s

rnd_below: procedure = .int
  arg n = .int
  r = .int
  r = rnd_next()
  if n > 2000000000 then r = r * 2147483647 + rnd_next()
  return r // n

rnd_float: procedure = .float
  a = .int
  b = .int
  a = rnd_next()
  b = rnd_next()
  return ((a * 2147483647 + b) as .float) / 4611686014132420609.0

gcd2: procedure = .int
  arg a = .int, b = .int
  t = .int
  do while b \= 1
    if b = 0 then leave
    t = arith(6, a, b)
    a = b
    b = t
  end
  if numkind(a) = 3 then return a
  return bi_abs(a)

seq_items: procedure = .int
  arg x = .int
  return iter_list(x)

/* itertools.product / permutations / combinations: eager, result is an iterator over a list */
it_combin: procedure = .int
  arg kind = .int, pool = .int, r = .int
  n = .int
  res = .int
  idx = .int[]
  i = .int
  j = .int
  t = .int
  used = .int[]
  k = .int
  n = ob_n[pool % 2]
  res = mklist(16)
  if r > n | r < 0 then return mkiter(1, res, 0)
  if kind = 1 then do
    /* combinations: idx[1..r] hold 0-based positions */
    do i = 1 to r
      idx[i] = i - 1
    end
    do forever
      t = mktuple(r)
      do i = 1 to r
        sl[ob_p[t % 2] + i - 1] = sl[ob_p[pool % 2] + idx[i]]
      end
      call list_append res, t
      i = r
      do while i >= 1 & idx[i] = i - 1 + n - r
        i = i - 1
      end
      if i < 1 then leave
      idx[i] = idx[i] + 1
      do j = i + 1 to r
        idx[j] = idx[j - 1] + 1
      end
    end
    return mkiter(1, res, 0)
  end
  /* permutations: odometer over positions without repetition (lexicographic by index) */
  if r = 0 then do
    call list_append res, mktuple(0)
    return mkiter(1, res, 0)
  end
  do i = 1 to n
    used[i] = 0
  end
  k = 1
  idx[1] = 0
  do while k >= 1
    /* idx[k] is the last index tried at position k (0 = none yet); advance to the next unused one */
    if idx[k] >= 1 then used[idx[k]] = 0
    j = idx[k] + 1
    do while j <= n & used[j] = 1
      j = j + 1
    end
    if j > n then do
      idx[k] = 0
      k = k - 1
      iterate
    end
    idx[k] = j
    used[j] = 1
    if k = r then do
      t = mktuple(r)
      do i = 1 to r
        sl[ob_p[t % 2] + i - 1] = sl[ob_p[pool % 2] + idx[i] - 1]
      end
      call list_append res, t
    end
    else do
      k = k + 1
      idx[k] = 0
    end
  end
  return mkiter(1, res, 0)

it_product: procedure = .int
  arg base = .int, na = .int
  pools = .int
  i = .int
  j = .int
  l = .int
  res = .int
  t = .int
  idx = .int[]
  sz = .int[]
  p = .int
  pools = mklist(na + 1)
  do i = 1 to na
    l = iter_list(ast[base + i])
    if l = 0 then return 0
    call list_append pools, l
    sz[i] = ob_n[l % 2]
    idx[i] = 0
    if sz[i] = 0 then return mkiter(1, mklist(4), 0)
  end
  res = mklist(16)
  do forever
    t = mktuple(na)
    do i = 1 to na
      sl[ob_p[t % 2] + i - 1] = sl[ob_p[sl[ob_p[pools % 2] + i - 1] % 2] + idx[i]]
    end
    call list_append res, t
    p = na
    do while p >= 1
      idx[p] = idx[p] + 1
      if idx[p] < sz[p] then leave
      idx[p] = 0
      p = p - 1
    end
    if p < 1 then leave
  end
  return mkiter(1, res, 0)

deep_copy: procedure = .int
  arg x = .int
  k = .int
  o = .int
  i = .int
  e = .int
  v = .int
  c = .int
  k = kind_of(x)
  if k = 7 | k = 8 then do
    if k = 7 then o = mklist(ob_n[x % 2])
    else o = mktuple(ob_n[x % 2])
    do i = 0 to ob_n[x % 2] - 1
      v = deep_copy(sl[ob_p[x % 2] + i])
      if v = 0 then return 0
      if k = 7 then call list_append o, v
      else sl[ob_p[o % 2] + i] = v
    end
    return o
  end
  if k = 31 then do
    if ob_y[x % 2] = 1 then return mkbytearr(ob_s[x % 2])
    return x
  end
  if k = 9 | k = 10 then do
    o = dict_new(k)
    ob_y[o % 2] = ob_y[x % 2]
    ob_c[o % 2] = ob_c[x % 2]
    e = dd_head[ob_x[x % 2]]
    do while e > 0
      if de_live[e] = 1 then do
        v = deep_copy(de_val[e])
        call dict_put ob_x[o % 2], de_hk[e], deep_copy(de_key[e]), v
      end
      e = de_next[e]
    end
    return o
  end
  if k = 17 then do
    c = ob_c[x % 2]
    o = inst_new(c)
    ob_n[o % 2] = ob_n[x % 2]
    ob_p[o % 2] = alloc_slots(ob_n[x % 2])
    do i = 0 to ob_n[x % 2] - 1
      v = sl[ob_p[x % 2] + i]
      if v \= 0 then v = deep_copy(v)
      sl[ob_p[o % 2] + i] = v
    end
    return o
  end
  return x

/* built-in functions of the library modules */
bcall_mod: procedure = .int
  arg bid = .int, base = .int, na = .int, nk = .int
  x = .float
  y = .float
  z = .float
  v = .int
  w = .int
  r = .int
  l = .int
  i = .int
  n = .int
  o = .int
  it = .int
  acc = .int
  f = .int
  s = .string
  a = .int
  b = .int
  st = .int
  if bid >= 136 then return bcall_np(bid, base, na, nk)
  if bid >= 120 & bid <= 135 then return bcall_os(bid, base, na, nk)
  if bid <= 90 & na >= 1 then do
    /* functions of one or two floats */
    if bid <= 74 | bid = 73 then do
      x = mf(ast[base + 1])
      if unw > 0 then return 0
      if na >= 2 then do
        y = mf(ast[base + 2])
        if unw > 0 then return 0
      end
    end
  end
  select
    when bid = 54 then do
      if x < 0.0 then return domain_err()
      return mkfloat(rxfloat..sqrt(x))
    end
    when bid = 55 | bid = 56 | bid = 57 then do
      v = ast[base + 1]
      if numkind(v) = 1 | numkind(v) = 2 then return mkint(ival(v))
      if numkind(v) \= 3 then do
        if kind_of(v) = 17 then do
          w = cls_find(ob_c[v % 2], nameid("__floor__"))
          if w > 0 then return call1(w, v)
        end
        return raise_exc(38, "must be real number, not " || type_name(v))
      end
      if x \= x then return raise_exc(36, "cannot convert float NaN to integer")
      if finf(x) \= 0 then return raise_exc(31, "cannot convert float infinity to integer")
      if bid = 55 then return float_to_int(rxfloat..floor(x))
      if bid = 56 then return float_to_int(rxfloat..ceil(x))
      return float_to_int(rxfloat..trunc(x))
    end
    when bid = 58 then return mkfloat(rxfloat..fabs(x))
    when bid = 59 then do
      if x = 0.0 & y < 0.0 then return domain_err()
      if x < 0.0 & y \= rxfloat..floor(y) then return domain_err()
      return mkfloat(rxfloat..pow(x, y))
    end
    when bid = 60 then return mkfloat(rxfloat..sin(x))
    when bid = 61 then return mkfloat(rxfloat..cos(x))
    when bid = 62 then return mkfloat(rxfloat..tan(x))
    when bid = 63 then do
      if x > 1.0 | x < -1.0 then return domain_err()
      return mkfloat(rxfloat..asin(x))
    end
    when bid = 64 then do
      if x > 1.0 | x < -1.0 then return domain_err()
      return mkfloat(rxfloat..acos(x))
    end
    when bid = 65 then return mkfloat(rxfloat..atan(x))
    when bid = 66 then return mkfloat(rxfloat..atan2(x, y))
    when bid = 67 then return mkfloat(rxfloat..sinh(x))
    when bid = 68 then return mkfloat(rxfloat..cosh(x))
    when bid = 74 then return mkfloat(rxfloat..tanh(x))
    when bid = 69 then do
      z = rxfloat..exp(x)
      if finf(z) = 1 & x < 1000000.0 then return raise_exc(31, "math range error")
      return mkfloat(z)
    end
    when bid = 70 | bid = 71 | bid = 72 then do
      if numkind(ast[base + 1]) = 2 then do
        /* huge integers: use the digit count */
        s = ob_s[ast[base + 1] % 2]
        if left(s, 1) == "-" then return domain_err()
        z = rxfloat..log10(parse_flt("0." || s)) + (length(s) as .float)
        if bid = 71 then return mkfloat(z)
        if bid = 72 then return mkfloat(z / rxfloat..log10(2.0))
        z = z * 2.302585092994046
      end
      else do
        if x <= 0.0 then return domain_err()
        if bid = 71 then return mkfloat(rxfloat..log10(x))
        if bid = 72 then return mkfloat(rxfloat..log2(x))
        z = rxfloat..log(x)
      end
      if na >= 2 then do
        if y <= 0.0 then return domain_err()
        z = z / rxfloat..log(y)
      end
      return mkfloat(z)
    end
    when bid = 73 then return mkfloat(rxfloat..hypot(x, y))
    when bid = 75 then do
      x = mf(ast[base + 1])
      if x \= x then return 4
      return 6
    end
    when bid = 76 then do
      x = mf(ast[base + 1])
      if finf(x) \= 0 then return 4
      return 6
    end
    when bid = 77 then do
      x = mf(ast[base + 1])
      if x \= x then return 6
      if finf(x) \= 0 then return 6
      return 4
    end
    when bid = 78 then do
      x = mf(ast[base + 1])
      return mkfloat(x * 180.0 / 3.141592653589793)
    end
    when bid = 79 then do
      x = mf(ast[base + 1])
      return mkfloat(x * 3.141592653589793 / 180.0)
    end
    when bid = 80 then do
      x = mf(ast[base + 1])
      y = mf(ast[base + 2])
      x = rxfloat..fabs(x)
      if y < 0.0 | fl_negzero(y) = 1 then x = 0.0 - x
      return mkfloat(x)
    end
    when bid = 81 then do
      x = mf(ast[base + 1])
      y = mf(ast[base + 2])
      if y = 0.0 then return domain_err()
      return mkfloat(rxfloat..fmod(x, y))
    end
    when bid = 82 then do
      x = mf(ast[base + 1])
      return mkfloat(rxfloat..cbrt(x))
    end
    when bid = 83 then do
      it = iter_new(ast[base + 1])
      if it = 0 then return 0
      z = 0.0
      do forever
        v = iter_next(it)
        if v = 0 then leave
        z = z + mf(v)
      end
      if unw > 0 then return 0
      return mkfloat(z)
    end
    when bid = 84 then do
      it = iter_new(ast[base + 1])
      if it = 0 then return 0
      acc = mkint(1)
      if na >= 2 then acc = ast[base + 2]
      do forever
        v = iter_next(it)
        if v = 0 then leave
        acc = arith(3, acc, v)
        if acc = 0 then return 0
      end
      if unw > 0 then return 0
      return acc
    end
    when bid = 85 | bid = 86 then do
      acc = mkint(0)
      if bid = 86 then acc = mkint(1)
      do i = 1 to na
        v = ast[base + i]
        if numkind(v) \= 1 & numkind(v) \= 2 then return raise_exc(38, "'" || type_name(v) || "' object cannot be interpreted as an integer")
        if bid = 85 then acc = gcd2(acc, v)
        else do
          if num_str(acc) == "0" | num_str(v) == "0" then acc = mkint(0)
          else do
            w = gcd2(acc, v)
            acc = bi_abs(arith(5, arith(3, acc, v), w))
          end
        end
      end
      return acc
    end
    when bid = 87 then do
      v = ast[base + 1]
      if numkind(v) \= 1 then return raise_exc(38, "'" || type_name(v) || "' object cannot be interpreted as an integer")
      n = ival(v)
      if n < 0 then return raise_exc(36, "factorial() not defined for negative values")
      acc = mkint(1)
      do i = 2 to n
        acc = arith(3, acc, mkint(i))
      end
      return acc
    end
    when bid = 88 then do
      v = ast[base + 1]
      if numkind(v) \= 1 & numkind(v) \= 2 then return raise_exc(38, "'" || type_name(v) || "' object cannot be interpreted as an integer")
      if left(num_str(v), 1) == "-" then return raise_exc(36, "isqrt() argument must be nonnegative")
      if numkind(v) = 1 then do
        n = rxfloat..floor(rxfloat..sqrt(ival(v) as .float)) as .int
        do while n * n > ival(v)
          n = n - 1
        end
        do while (n + 1) * (n + 1) <= ival(v)
          n = n + 1
        end
        return mkint(n)
      end
      /* Newton iteration on big integers */
      a = v
      b = arith(5, arith(1, a, mkint(1)), mkint(2))
      do while py_lt(b, a) = 1
        a = b
        b = arith(5, arith(1, a, arith(5, v, a)), mkint(2))
      end
      return a
    end
    when bid = 89 | bid = 90 then do
      if numkind(ast[base + 1]) \= 1 | numkind(ast[base + 2]) \= 1 then return raise_exc(38, "comb() arguments must be integers")
      n = ival(ast[base + 1])
      i = ival(ast[base + 2])
      if n < 0 | i < 0 then return raise_exc(36, "n must be a non-negative integer")
      if i > n then return mkint(0)
      if bid = 89 & i > n - i then i = n - i
      acc = mkint(1)
      do w = 0 to i - 1
        acc = arith(3, acc, mkint(n - w))
        if bid = 89 then acc = arith(5, acc, mkint(w + 1))
      end
      return acc
    end
    when bid = 91 then do
      if na >= 1 & numkind(ast[base + 1]) = 1 then rnd_s = (abs(ival(ast[base + 1])) // 2147483646) + 1
      else if na >= 1 then rnd_s = (strhash(str_of(ast[base + 1])) // 2147483646) + 1
      else rnd_s = (time("US") as .int) // 2147483646 + 1
      return 2
    end
    when bid = 92 then return mkfloat(rnd_float())
    when bid = 93 then do
      if chk_int(ast[base + 1]) = 0 | chk_int(ast[base + 2]) = 0 then return 0
      a = ival(ast[base + 1])
      b = ival(ast[base + 2])
      if b < a then return raise_exc(36, "empty range for randrange() (" || a || ", " || (b + 1) || ", " || (b + 1 - a) || ")")
      return mkint(a + rnd_below(b - a + 1))
    end
    when bid = 94 then do
      if chk_int(ast[base + 1]) = 0 then return 0
      a = 0
      st = 1
      if na = 1 then b = ival(ast[base + 1])
      else do
        a = ival(ast[base + 1])
        b = ival(ast[base + 2])
        if na >= 3 then st = ival(ast[base + 3])
      end
      if st = 0 then return raise_exc(36, "zero step for randrange()")
      if st > 0 then n = (b - a + st - 1) % st
      else n = (a - b - st - 1) % (0 - st)
      if n <= 0 then return raise_exc(36, "empty range in randrange(" || a || ", " || b || ")")
      return mkint(a + st * rnd_below(n))
    end
    when bid = 95 then do
      x = mf(ast[base + 1])
      y = mf(ast[base + 2])
      return mkfloat(x + (y - x) * rnd_float())
    end
    when bid = 96 then do
      l = iter_list(ast[base + 1])
      if l = 0 then return 0
      n = ob_n[l % 2]
      if n = 0 then return raise_exc(34, "Cannot choose from an empty sequence")
      return sl[ob_p[l % 2] + rnd_below(n)]
    end
    when bid = 97 then do
      l = ast[base + 1]
      if kind_of(l) \= 7 then return raise_exc(38, "shuffle() requires a list")
      n = ob_n[l % 2]
      do i = n - 1 to 1 by -1
        w = rnd_below(i + 1)
        v = sl[ob_p[l % 2] + i]
        sl[ob_p[l % 2] + i] = sl[ob_p[l % 2] + w]
        sl[ob_p[l % 2] + w] = v
      end
      return 2
    end
    when bid = 98 then do
      l = iter_list(ast[base + 1])
      if l = 0 then return 0
      if chk_int(ast[base + 2]) = 0 then return 0
      n = ob_n[l % 2]
      b = ival(ast[base + 2])
      if b > n | b < 0 then return raise_exc(36, "Sample larger than population or is negative")
      do i = 0 to b - 1
        w = i + rnd_below(n - i)
        v = sl[ob_p[l % 2] + i]
        sl[ob_p[l % 2] + i] = sl[ob_p[l % 2] + w]
        sl[ob_p[l % 2] + w] = v
      end
      o = mklist(b)
      do i = 0 to b - 1
        call list_append o, sl[ob_p[l % 2] + i]
      end
      return o
    end
    when bid = 99 then do
      z = ((date("UN") as .int) * 86400) as .float
      z = z + ((time("US") as .int) as .float) / 1000000.0
      return mkfloat(z)
    end
    when bid = 100 | bid = 101 | bid = 102 then do
      z = ((time("US") as .int) as .float) / 1000000.0
      return mkfloat(z)
    end
    when bid = 103 then do
      if na \= 1 then return nargs_err("sleep", na, 1, 1)
      if numkind(ast[base + 1]) = 0 then return raise_exc(38, "'" || type_name(ast[base + 1]) || "' object cannot be interpreted as an integer")
      z = tofloat(ast[base + 1])
      if z < 0.0 then return raise_exc(36, "sleep length must be non-negative")
      n = ival(float_to_int(z * 1000.0 + 0.5))
      if n > 0 then st = rxplatform..sleep(n)
      return 2
    end
    when bid = 104 then do
      o = mkiter(15, 0, 0)
      ob_c[o % 2] = tup_from_ast(base + 1, base + na)
      return o
    end
    when bid = 105 then do
      a = 0
      b = 1
      if na >= 1 then a = ival(ast[base + 1])
      if na >= 2 then b = ival(ast[base + 2])
      return mkiter(16, a, b)
    end
    when bid = 106 then do
      it = iter_new(ast[base + 1])
      if it = 0 then return 0
      a = 0
      b = -1
      st = 1
      if na = 2 then do
        if ast[base + 2] \= 2 then b = ival(ast[base + 2])
      end
      else do
        if ast[base + 2] \= 2 then a = ival(ast[base + 2])
        if ast[base + 3] \= 2 then b = ival(ast[base + 3])
        if na >= 4 then st = ival(ast[base + 4])
      end
      o = mkiter(18, it, a)
      ob_p[o % 2] = alloc_slots(3)
      sl[ob_p[o % 2]] = b
      sl[ob_p[o % 2] + 1] = st
      sl[ob_p[o % 2] + 2] = 0
      return o
    end
    when bid = 107 then do
      it = iter_new(ast[base + 2])
      if it = 0 then return 0
      o = mkiter(17, ast[base + 1], it)
      ob_c[o % 2] = 0
      return o
    end
    when bid = 108 then do
      v = kwarg(base, na, nk, "repeat")
      if v \= 0 then do
        l = iter_list(ast[base + 1])
        if l = 0 then return 0
        n = ival(v)
        do i = 2 to n
          ast[base + i] = l
        end
        na = n
        ast[base + 1] = l
      end
      return it_product(base, na)
    end
    when bid = 109 | bid = 110 then do
      l = iter_list(ast[base + 1])
      if l = 0 then return 0
      n = ob_n[l % 2]
      b = n
      if na >= 2 then b = ival(ast[base + 2])
      if bid = 109 then return it_combin(1, l, b)
      return it_combin(2, l, b)
    end
    when bid = 111 then do
      it = iter_new(ast[base + 1])
      if it = 0 then return 0
      o = mklist(8)
      acc = 0
      do forever
        v = iter_next(it)
        if v = 0 then leave
        if acc = 0 then acc = v
        else if na >= 2 then do
          acc = call2(ast[base + 2], acc, v)
          if acc = 0 then return 0
        end
        else do
          acc = arith(1, acc, v)
          if acc = 0 then return 0
        end
        call list_append o, acc
      end
      if unw > 0 then return 0
      return mkiter(1, o, 0)
    end
    when bid = 112 then do
      if na < 2 then return nargs_err("reduce", na, 2, 3)
      it = iter_new(ast[base + 2])
      if it = 0 then return 0
      if na >= 3 then acc = ast[base + 3]
      else do
        acc = iter_next(it)
        if acc = 0 then do
          if unw > 0 then return 0
          return raise_exc(38, "reduce() of empty iterable with no initial value")
        end
      end
      f = ast[base + 1]
      do forever
        v = iter_next(it)
        if v = 0 then leave
        acc = call2(f, acc, v)
        if acc = 0 then return 0
      end
      if unw > 0 then return 0
      return acc
    end
    when bid = 113 then do
      if na \= 2 then return raise_exc(38, "partial() supports one bound argument")
      return mkbmeth(ast[base + 1], ast[base + 2])
    end
    when bid = 114 then do
      o = dict_new(9)
      if na >= 1 then do
        if ast[base + 1] \= 2 then ob_y[o % 2] = ast[base + 1]
      end
      return o
    end
    when bid = 115 then do
      o = dict_new(9)
      if na >= 1 then do
        it = iter_new(ast[base + 1])
        if it = 0 then return 0
        do forever
          v = iter_next(it)
          if v = 0 then leave
          a = dict_find(ob_x[o % 2], hashkey(v))
          if a > 0 then de_val[a] = de_val[a] + 2
          else call dset o, v, 3
        end
        if unw > 0 then return 0
      end
      return o
    end
    when bid = 116 then return ctor_dict(base, na, nk)
    when bid = 117 then do
      if na = 0 then return mklist(4)
      return iter_list(ast[base + 1])
    end
    when bid = 118 then do
      v = ast[base + 1]
      if kind_of(v) = 7 then return iter_list(v)
      if kind_of(v) = 9 then return dict_copy(v)
      if kind_of(v) = 10 then return dict_copy(v)
      if kind_of(v) = 17 then do
        o = deep_copy(v)
        return o
      end
      return v
    end
    when bid = 119 then return deep_copy(ast[base + 1])
    otherwise nop
  end
  return raise_exc(38, "unsupported library function")

/* ---------------------------------------------------------------------
   Import system: modules from files, packages, relative imports,
   sys.modules, native modules and the pylib fall-back
   --------------------------------------------------------------------- */
new_module: procedure = .int
  arg name = .string, fname = .string, ispkg = .int, pdir = .string
  o = .int
  p = .int
  nmod = nmod + 1
  mod_name[nmod] = name
  mod_file[nmod] = fname
  mod_ispkg[nmod] = ispkg
  mod_pdir[nmod] = pdir
  mod_sc[nmod] = 0
  mod_fb[nmod] = 0
  mod_dyn[nmod] = 0
  if ispkg = 1 then mod_pkg[nmod] = name
  else do
    p = lastpos(".", name)
    if p > 0 then mod_pkg[nmod] = left(name, p - 1)
    else mod_pkg[nmod] = ""
  end
  o = newobj(18)
  ob_s[o % 2] = name
  ob_x[o % 2] = nmod
  mod_obj[nmod] = o
  return nmod

native_mod: procedure = .int
  arg name = .string
  v = .string
  o = .int
  v = modo[name]
  if v \== "" then return v as .int
  o = newobj(18)
  ob_s[o % 2] = name
  ob_x[o % 2] = 0
  modo[name] = o as .string
  return o

reg_module: procedure = .void
  arg key = .string, o = .int
  call dict_put ob_x[sys_modules % 2], "s" || key, mkstr(key), o
  return

unreg_module: procedure = .void
  arg key = .string
  e = .int
  e = dict_del(ob_x[sys_modules % 2], "s" || key)
  return

/* is there a file module leaf in directory dir (leaf.py or leaf/__init__.py) */
imp_find: procedure = .int
  arg dir = .string, leaf = .string
  p = .string
  if dir \== "" then p = dir || "/" || leaf
  else p = leaf
  if file_exists(p || ".py") = 1 then do
    imp_file = p || ".py"
    imp_ispkg = 0
    imp_pdir = dir
    return 1
  end
  if file_exists(p || "/__init__.py") = 1 then do
    imp_file = p || "/__init__.py"
    imp_ispkg = 1
    imp_pdir = p
    return 1
  end
  return 0

/* parse the source of module mi; returns the body node or 0 (pe_msg set) */
parse_module: procedure = .int
  arg src = .string, mi = .int
  body = .int
  sc = .int
  dmy = .int
  wd_save = .int
  wd_save = wd
  wd = 0
  ntk = 0
  tpp = 1
  psp = 0
  pe = 0
  pe_msg = ""
  cursc = 0
  parse_dyn = parse_dyn_init
  parse_mi = mi
  call lex_text src, 0
  sc = scope_push(1)
  sc_id[sc] = 0
  mod_sc[mi] = sc
  cur_msc = sc
  dmy = bind_name("__name__")
  dmy = bind_name("__file__")
  dmy = bind_name("__package__")
  body = p_file()
  call scope_end sc
  mod_dyn[mi] = parse_dyn
  wd = wd_save
  if pe = 1 then return 0
  return body

setg: procedure = .void
  arg mi = .int, nm = .string, v = .int
  s = .string
  s = scm[mod_sc[mi] || "|" || nm]
  if s \== "" then vp[mod_fb[mi] + (s as .int)] = v
  return

/* parse and run the source of module mi in a fresh global frame; 1 on success */
module_exec: procedure = .int
  arg mi = .int, src = .string
  body = .int
  sz = .int
  fbm = .int
  i = .int
  sv_g = .int
  sv_m = .int
  body = parse_module(src, mi)
  if body = 0 then do
    call raise_exc 52, mod_file[mi] || ": " || pe_msg
    return 0
  end
  sz = sc_n[mod_sc[mi]] + 1 + 64
  if mod_dyn[mi] = 1 then sz = sz + 512
  mod_fsz[mi] = sz
  fbm = alloc_frame(sz)
  mod_fb[mi] = fbm
  call setg mi, "__name__", mkstr(mod_name[mi])
  call setg mi, "__file__", mkstr(mod_file[mi])
  call setg mi, "__package__", mkstr(mod_pkg[mi])
  do i = 1 to ndyn
    if dyn_mi[i] = mi then vp[fbm + dyn_slot[i]] = dyn_val[i]
  end
  sv_g = gfb
  sv_m = cur_mi
  gfb = fbm
  cur_mi = mi
  call ex body, fbm
  gfb = sv_g
  cur_mi = sv_m
  if unw > 0 then return 0
  return 1

module_load: procedure = .int
  arg mi = .int
  src = .string
  src = read_file(mod_file[mi])
  return module_exec(mi, src)

/* import a module by its full dotted name: the module object, or 0 with an exception */
import_mod: procedure = .int
  arg full = .string
  e = .int
  p = .int
  parent = .string
  leaf = .string
  pm = .int
  mi = .int
  found = .int
  i = .int
  o = .int
  q = .int
  q = imp_quiet
  imp_quiet = 0
  e = dict_find(ob_x[sys_modules % 2], "s" || full)
  if e > 0 then return de_val[e]
  p = lastpos(".", full)
  parent = ""
  leaf = full
  pm = 0
  if p > 0 then do
    parent = left(full, p - 1)
    leaf = substr(full, p + 1)
    pm = import_mod(parent)
    if pm = 0 then return 0
  end
  if pos(" " || full || " ", natives) > 0 then do
    o = native_mod(full)
    call reg_module full, o
    return o
  end
  found = 0
  if parent == "" then do
    do i = 1 to nsyspath
      if found = 0 then found = imp_find(syspath[i], leaf)
    end
  end
  else if ob_x[pm % 2] > 0 then do
    if mod_ispkg[ob_x[pm % 2]] = 1 then found = imp_find(mod_pdir[ob_x[pm % 2]], leaf)
  end
  else do
    /* submodule of a native module (collections.abc): a library file */
    do i = 2 to nsyspath
      if found = 0 then found = imp_find(syspath[i], changestr(".", full, "/"))
    end
  end
  if found = 0 then do
    if q = 1 then return 0
    return raise_exc(51, "No module named '" || full || "'")
  end
  mi = new_module(full, imp_file, imp_ispkg, imp_pdir)
  o = mod_obj[mi]
  call reg_module full, o
  if module_load(mi) = 0 then do
    call unreg_module full
    return 0
  end
  if pm > 0 then do
    if ob_x[pm % 2] > 0 then call mod_setx pm, leaf, o
    else modattr[parent || "." || leaf] = o as .string
  end
  return o

/* attribute leaf of package module pm := o */
mod_setx: procedure = .void
  arg pm = .int, leaf = .string, o = .int
  mi = .int
  s = .string
  mi = ob_x[pm % 2]
  if mi > 0 then do
    s = scm[mod_sc[mi] || "|" || leaf]
    if s \== "" & mod_fb[mi] > 0 then do
      if (s as .int) > 0 then do
        vp[mod_fb[mi] + (s as .int)] = o
        return
      end
    end
    modx[mi || "." || leaf] = o as .string
  end
  else modattr[ob_s[pm % 2] || "." || leaf] = o as .string
  return

/* value of attribute nm of file module mi, or 0 */
fmod_attr: procedure = .int
  arg mi = .int, nm = .string
  s = .string
  v = .int
  l = .int
  s = scm[mod_sc[mi] || "|" || nm]
  if s \== "" & mod_fb[mi] > 0 then do
    if (s as .int) > 0 then do
      v = vp[mod_fb[mi] + (s as .int)]
      if v \= 0 then return v
    end
  end
  s = modx[mi || "." || nm]
  if s \== "" then return s as .int
  if nm == "__dict__" then return mod_dict(mi)
  if nm == "__path__" & mod_ispkg[mi] = 1 then do
    l = mklist(4)
    call list_append l, mkstr(mod_pdir[mi])
    return l
  end
  if nm == "__spec__" | nm == "__loader__" then return 2
  if nm == "__doc__" then return 2
  return 0

mod_dict: procedure = .int
  arg mi = .int
  d = .int
  j = .int
  v = .int
  d = dict_new(9)
  do j = 1 to nbn
    if bn_sc[j] = mod_sc[mi] & mod_fb[mi] > 0 then do
      v = vp[mod_fb[mi] + bn_slot[j]]
      if v \= 0 & mod_dyn[mi] = 1 then do
        if builtin_lookup(bn_name[j]) = v then v = 0
      end
      if v \= 0 then call dset d, mkstr(bn_name[j]), v
    end
  end
  return d

/* the module attribute lookup: value or 0 (no exception raised for a plain miss) */
mod_getattr: procedure = .int
  arg o = .int, nid = .int
  mi = .int
  nm = .string
  mn = .string
  key = .string
  s = .string
  v = .int
  mi = ob_x[o % 2]
  nm = nid_name[nid]
  if mi > 0 then return fmod_attr(mi, nm)
  mn = ob_s[o % 2]
  key = mn || "." || nm
  if pos(" " || key || " ", shadow) > 0 then do
    v = hybrid_get(mn, nm)
    if v \= 0 then return v
    if unw > 0 then return 0
  end
  s = modattr[key]
  if s \== "" then return s as .int
  if mn == "typing" | mn == "__future__" then do
    if nm == "TYPE_CHECKING" then return 6
    return cl_obj[60]
  end
  if nm == "__name__" then return mkstr(mn)
  if nm == "__doc__" then return 2
  if nm == "__file__" then return mkstr("<built-in>")
  return hybrid_get(mn, nm)

mod_setattr: procedure = .void
  arg o = .int, nid = .int, v = .int
  mi = .int
  s = .string
  mi = ob_x[o % 2]
  if mi > 0 then do
    s = scm[mod_sc[mi] || "|" || nid_name[nid]]
    if s \== "" & mod_fb[mi] > 0 then do
      if (s as .int) > 0 then do
        vp[mod_fb[mi] + (s as .int)] = v
        return
      end
    end
    modx[mi || "." || nid_name[nid]] = v as .string
    return
  end
  modattr[ob_s[o % 2] || "." || nid_name[nid]] = v as .string
  return

/* names of a pure Python fall-back module for a native module: the attribute or 0 */
hybrid_get: procedure = .int
  arg mname = .string, attr = .string
  h = .string
  i = .int
  mi = .int
  rel = .string
  found = .int
  h = hyb[mname]
  if h == "" then do
    h = "0"
    rel = changestr(".", mname, "/")
    found = 0
    do i = 2 to nsyspath
      if found = 0 then found = imp_find(syspath[i], rel)
    end
    if found = 1 then do
      mi = new_module(mname, imp_file, imp_ispkg, imp_pdir)
      hyb[mname] = mi as .string
      call reg_module "@lib:" || mname, mod_obj[mi]
      if module_load(mi) = 0 then do
        hyb[mname] = "0"
        return 0
      end
      h = mi as .string
    end
    else hyb[mname] = "0"
  end
  if h == "0" then return 0
  return fmod_attr(h as .int, attr)

/* absolute name for a (possibly relative) import in the running module; "" with an exception */
resolve_name: procedure = .string
  arg name = .string, level = .int
  pkg = .string
  i = .int
  p = .int
  if level = 0 then return name
  pkg = mod_pkg[cur_mi]
  if pkg == "" then do
    call raise_exc 50, "attempted relative import with no known parent package"
    return ""
  end
  do i = 2 to level
    p = lastpos(".", pkg)
    if p = 0 then do
      call raise_exc 50, "attempted relative import beyond top-level package"
      return ""
    end
    pkg = left(pkg, p - 1)
  end
  if name == "" then return pkg
  return pkg || "." || name

exec_import: procedure = .void
  arg n = .int, fb = .int
  full = .string
  m = .int
  top = .int
  p = .int
  full = n_s[n]
  m = import_mod(full)
  if m = 0 then return
  if n_b[n] = 1 then call store n_a[n], m, fb
  else do
    p = pos(".", full)
    if p = 0 then top = m
    else top = import_mod(left(full, p - 1))
    call store n_a[n], top, fb
  end
  return

exec_from: procedure = .void
  arg n = .int, fb = .int
  full = .string
  m = .int
  i = .int
  nm = .string
  v = .int
  r = .int
  full = resolve_name(n_s[n], n_c[n])
  if unw > 0 then return
  m = import_mod(full)
  if m = 0 then return
  if n_d[n] = 1 then do
    call import_star m, full
    return
  end
  do i = 0 to n_b[n] - 1
    nm = ob_s[na_const(al[n_a[n] + 2 * i]) % 2]
    v = mod_getattr(m, nameid(nm))
    if v = 0 then do
      if unw > 0 then return
      imp_quiet = 1
      v = import_mod(full || "." || nm)
      imp_quiet = 0
      if unw > 0 then return
      if v = 0 then do
        if ob_x[m % 2] > 0 then r = raise_exc(50, "cannot import name '" || nm || "' from '" || full || "' (" || mod_file[ob_x[m % 2]] || ")")
        else r = raise_exc(50, "cannot import name '" || nm || "' from '" || full || "' (unknown location)")
        return
      end
    end
    call store al[n_a[n] + 2 * i + 1], v, fb
  end
  return

star_extra: procedure = .string
  arg mn = .string
  if mn == "math" then return "pi e tau inf nan"
  if mn == "numpy" then return "pi e inf nan newaxis float64 float32 int64 int32 bool_ ndarray linalg random"
  if mn == "string" then return "ascii_lowercase ascii_uppercase ascii_letters digits hexdigits octdigits punctuation whitespace"
  if mn == "sys" then return "maxsize version platform stdout stderr stdin argv modules path"
  if mn == "os" then return "sep linesep name path environ"
  return ""

import_star: procedure = .void
  arg m = .int, full = .string
  mi = .int
  lst = .int
  v = .int
  j = .int
  w = .string
  pre = .string
  nm = .string
  s = .string
  x = .int
  mi = ob_x[m % 2]
  lst = mklist(16)
  if mi > 0 then do
    v = fmod_attr(mi, "__all__")
    if v \= 0 & (kind_of(v) = 7 | kind_of(v) = 8) then call list_extend_from lst, v
    else do
      do j = 1 to nbn
        if bn_sc[j] = mod_sc[mi] then do
          nm = bn_name[j]
          if left(nm, 1) \== "_" & vp[mod_fb[mi] + bn_slot[j]] \= 0 then call list_append lst, mkstr(nm)
        end
      end
    end
  end
  else do
    pre = full || "."
    do j = 1 to words(bboot)
      w = word(bboot, j)
      if left(w, length(pre)) == pre then do
        nm = substr(w, length(pre) + 1)
        if pos(".", nm) = 0 then call list_append lst, mkstr(nm)
      end
    end
    w = star_extra(full)
    do j = 1 to words(w)
      call list_append lst, mkstr(word(w, j))
    end
  end
  do j = 0 to ob_n[lst % 2] - 1
    x = sl[ob_p[lst % 2] + j]
    if kind_of(x) = 6 then do
      nm = ob_s[x % 2]
      s = scm[mod_sc[cur_mi] || "|" || nm]
      if s == "" then s = dyn_alloc(cur_mi, nm)
      if s \== "" then do
        if (s as .int) > 0 then do
          v = mod_getattr(m, nameid(nm))
          if v \= 0 then vp[gfb + (s as .int)] = v
          if unw > 0 then return
        end
      end
    end
  end
  return

addpaths: procedure = .void
  arg s = .string
  p = .int
  q = .int
  d = .string
  i = .int
  dup = .int
  p = 1
  do while p <= length(s)
    q = pos(":", s, p)
    if q = 0 then q = length(s) + 1
    d = substr(s, p, q - p)
    p = q + 1
    if d \== "" then do
      dup = 0
      do i = 1 to nsyspath
        if syspath[i] == d then dup = 1
      end
      if dup = 0 then do
        nsyspath = nsyspath + 1
        syspath[nsyspath] = d
      end
    end
  end
  return

setup_path: procedure = .void
  i = .int
  l = .int
  nsyspath = 1
  syspath[1] = script_dir
  call addpaths getenv("PYLIB")
  call addpaths pypath
  call addpaths "/home/claude/python/pylib"
  l = mklist(nsyspath)
  do i = 1 to nsyspath
    call list_append l, mkstr(syspath[i])
  end
  modattr["sys.path"] = l as .string
  return

modname_of: procedure = .string
  arg i = .int
  if i = 0 then return "builtins"
  return mod_name[i]

/* ---------------------------------------------------------------------
   os, os.path and a few sys / time functions
   --------------------------------------------------------------------- */
path_norm: procedure = .string
  arg p = .string
  isabs = .int
  n = .int
  i = .int
  w = .string
  parts = .string[]
  np2 = .int
  r = .string
  isabs = 0
  if left(p, 1) == "/" then isabs = 1
  np2 = 0
  n = words(translate(p, " ", "/"))
  do i = 1 to n
    w = word(translate(p, " ", "/"), i)
    if w == "." then nop
    else if w == ".." then do
      if np2 > 0 then do
        if parts[np2] \== ".." then np2 = np2 - 1
        else do
          np2 = np2 + 1
          parts[np2] = w
        end
      end
      else if isabs = 0 then do
        np2 = np2 + 1
        parts[np2] = w
      end
    end
    else do
      np2 = np2 + 1
      parts[np2] = w
    end
  end
  r = ""
  do i = 1 to np2
    if i > 1 then r = r || "/"
    r = r || parts[i]
  end
  if isabs = 1 then r = "/" || r
  if r == "" then r = "."
  return r

path_join2: procedure = .string
  arg a = .string, b = .string
  if left(b, 1) == "/" then return b
  if a == "" then return b
  if right(a, 1) == "/" then return a || b
  return a || "/" || b

bcall_os: procedure = .int
  arg bid = .int, base = .int, na = .int, nk = .int
  s = .string
  t = .string
  p = .int
  i = .int
  v = .int
  z = .float
  if bid = 120 then do
    if na < 1 then return nargs_err("getenv", na, 1, 2)
    s = getenv(ob_s[ast[base + 1] % 2])
    if s == "" then do
      if na >= 2 then return ast[base + 2]
      return 2
    end
    return mkstr(s)
  end
  if bid = 121 then do
    s = getenv("PWD")
    if s == "" then s = "."
    return mkstr(s)
  end
  if bid = 135 then return mkint(900)
  if bid = 133 then do
    z = ((date("UN") as .int) * 86400) as .float
    z = z * 1000000000.0 + ((time("US") as .int) as .float) * 1000.0
    return float_to_int(z)
  end
  if bid = 134 then return mkint((time("US") as .int) * 1000)
  /* the os.path functions take strings */
  if na < 1 then return nargs_err("path function", na, 1, 2)
  do i = 1 to na
    if kind_of(ast[base + i]) \= 6 then return raise_exc(38, "expected str, bytes or os.PathLike object, not " || type_name(ast[base + i]))
  end
  s = ob_s[ast[base + 1] % 2]
  if bid = 122 then do
    do i = 2 to na
      s = path_join2(s, ob_s[ast[base + i] % 2])
    end
    return mkstr(s)
  end
  if bid = 123 | bid = 127 | bid = 128 then do
    if s == "" then return 6
    return mkbool(file_exists(s))
  end
  if bid = 124 | bid = 125 | bid = 130 then do
    p = lastpos("/", s)
    t = left(s, p)
    if t \== "" & t \== copies("/", length(t)) then do
      do while right(t, 1) == "/"
        t = left(t, length(t) - 1)
      end
    end
    if bid = 124 then return mkstr(substr(s, p + 1))
    if bid = 125 then return mkstr(t)
    v = mktuple(2)
    sl[ob_p[v % 2]] = mkstr(t)
    sl[ob_p[v % 2] + 1] = mkstr(substr(s, p + 1))
    return v
  end
  if bid = 126 then do
    p = lastpos(".", s)
    i = lastpos("/", s)
    if p <= i + 1 then p = 0
    v = mktuple(2)
    if p = 0 then do
      sl[ob_p[v % 2]] = ast[base + 1]
      sl[ob_p[v % 2] + 1] = mkstr("")
    end
    else do
      sl[ob_p[v % 2]] = mkstr(left(s, p - 1))
      sl[ob_p[v % 2] + 1] = mkstr(substr(s, p))
    end
    return v
  end
  if bid = 132 then return mkstr(path_norm(s))
  if bid = 129 then do
    if left(s, 1) \== "/" then do
      t = getenv("PWD")
      if t == "" then t = "."
      s = path_join2(t, s)
    end
    return mkstr(path_norm(s))
  end
  if bid = 131 then do
    if s == "~" | left(s, 2) == "~/" then do
      t = getenv("HOME")
      if t == "" then t = "/"
      return mkstr(t || substr(s, 2))
    end
    return ast[base + 1]
  end
  return raise_exc(38, "unsupported library function")

/* ---------------------------------------------------------------------
   Namespaces: globals() locals() vars() dir() eval() exec() __import__()
   --------------------------------------------------------------------- */

/* instance __dict__: a snapshot whose writes are mirrored into the instance */
inst_dict: procedure = .int
  arg o = .int
  d = .int
  c = .int
  i = .int
  v = .int
  d = dict_new(9)
  c = ob_c[o % 2]
  do i = 1 to nis
    if is_c[i] = c then do
      if is_s[i] <= ob_n[o % 2] then do
        v = sl[ob_p[o % 2] + is_s[i] - 1]
        if v \= 0 then call dset d, mkstr(nid_name[is_n[i]]), v
      end
    end
  end
  dd_own[ob_x[d % 2]] = o
  return d

/* class attributes (own table only) */
cls_dict: procedure = .int
  arg c = .int
  d = .int
  i = .int
  v = .string
  d = dict_new(9)
  do i = 1 to nca
    if ca_c[i] = c then do
      v = ca[c || "." || ca_n[i]]
      if v \== "" then call dset d, mkstr(nid_name[ca_n[i]]), v as .int
    end
  end
  return d

/* fill d with the bound names of scope sc in frame fb */
ns_scope_dict: procedure = .void
  arg sc = .int, fb = .int, d = .int, skipb = .int
  j = .int
  v = .int
  nm = .string
  do j = 1 to nbn
    if bn_sc[j] = sc then do
      v = vp[fb + bn_slot[j]]
      if v \= 0 then do
        nm = bn_name[j]
        if skipb = 1 then do
          if builtin_lookup(nm) = v then iterate
        end
        call dset d, mkstr(nm), v
      end
    end
  end
  return

dict_sorted_keys: procedure = .int
  arg d = .int
  l = .int
  e = .int
  l = mklist(8)
  e = dd_head[ob_x[d % 2]]
  do while e > 0
    if de_live[e] = 1 then call list_append l, de_key[e]
    e = de_next[e]
  end
  if sort_list(l, 0, 0) = 0 then return 0
  return l

/* N_LOCALS: locals() (mode 1), vars() (2), dir() (3) with no argument */
ev_locals: procedure = .int
  arg n = .int, fb = .int
  d = .int
  sc = .int
  sc = n_a[n]
  d = dict_new(9)
  if sc_kind[sc] = 1 then call ns_scope_dict sc, fb, d, 1
  else call ns_scope_dict sc, fb, d, 0
  if n_b[n] = 3 then return dict_sorted_keys(d)
  return d

bi_globals: procedure = .int
  return mod_dict(cur_mi)

bi_vars: procedure = .int
  arg x = .int
  k = .int
  k = kind_of(x)
  if k = 17 then return inst_dict(x)
  if k = 16 then return cls_dict(ob_x[x % 2])
  if k = 18 then do
    if ob_x[x % 2] > 0 then return mod_dict(ob_x[x % 2])
  end
  return raise_exc(38, "vars() argument must have __dict__ attribute")

bi_dir: procedure = .int
  arg x = .int
  d = .int
  k = .int
  c = .int
  i = .int
  j = .int
  v = .string
  k = kind_of(x)
  d = dict_new(9)
  if k = 17 | k = 16 then do
    if k = 17 then do
      c = ob_c[x % 2]
      do i = 1 to nis
        if is_c[i] = c then do
          if is_s[i] <= ob_n[x % 2] then do
            if sl[ob_p[x % 2] + is_s[i] - 1] \= 0 then call dset d, mkstr(nid_name[is_n[i]]), 4
          end
        end
      end
    end
    else c = ob_x[x % 2]
    do j = 0 to cl_mn[c] - 1
      do i = 1 to nca
        if ca_c[i] = mro_a[cl_ms[c] + j] then call dset d, mkstr(nid_name[ca_n[i]]), 4
      end
    end
  end
  else if k = 18 then do
    if ob_x[x % 2] > 0 then d = mod_dict(ob_x[x % 2])
  end
  return dict_sorted_keys(d)

/* copy every entry of dict s into dict d */
dict_copy_into: procedure = .void
  arg s = .int, d = .int
  e = .int
  e = dd_head[ob_x[s % 2]]
  do while e > 0
    if de_live[e] = 1 then call dset d, de_key[e], de_val[e]
    e = de_next[e]
  end
  return

/* run source text src in the namespace dict nsd (mode 0 exec, 1 eval); eval returns the value */
ns_exec: procedure = .int
  arg src = .string, mode = .int, nsd = .int
  mi = .int
  sc = .int
  body = .int
  sz = .int
  fbm = .int
  i = .int
  e = .int
  s = .string
  v = .int
  nm = .string
  sv_g = .int
  sv_m = .int
  res = .int
  sv_pe = .int
  if mode = 1 then src = "__eval_result__ = (" || src || '0a'x || ")"
  mi = new_module("<string>", "<string>", 0, "")
  parse_dyn_init = 1
  body = parse_module(src, mi)
  parse_dyn_init = 0
  if body = 0 then return raise_exc(52, pe_msg)
  sc = mod_sc[mi]
  sz = sc_n[sc] + 1 + 512
  mod_fsz[mi] = sz
  fbm = alloc_frame(sz)
  mod_fb[mi] = fbm
  call setg mi, "__name__", mkstr("<string>")
  call setg mi, "__file__", mkstr("<string>")
  call setg mi, "__package__", mkstr("")
  do i = 1 to ndyn
    if dyn_mi[i] = mi then vp[fbm + dyn_slot[i]] = dyn_val[i]
  end
  e = dd_head[ob_x[nsd % 2]]
  do while e > 0
    if de_live[e] = 1 & kind_of(de_key[e]) = 6 then do
      s = scm[sc || "|" || ob_s[de_key[e] % 2]]
      if s \== "" then vp[fbm + (s as .int)] = de_val[e]
    end
    e = de_next[e]
  end
  sv_g = gfb
  sv_m = cur_mi
  gfb = fbm
  cur_mi = mi
  call ex body, fbm
  gfb = sv_g
  cur_mi = sv_m
  if unw > 0 then return 0
  res = 2
  if mode = 1 then do
    s = scm[sc || "|__eval_result__"]
    res = vp[fbm + (s as .int)]
    if res = 0 then res = 2
    return res
  end
  do i = 1 to nbn
    if bn_sc[i] = sc then do
      v = vp[fbm + bn_slot[i]]
      if v \= 0 then do
        nm = bn_name[i]
        if nm \== "__eval_result__" then do
          e = dict_find(ob_x[nsd % 2], hashkey(mkstr(nm)))
          if e = 0 then do
            if left(nm, 2) == "__" & right(nm, 2) == "__" then iterate
            if builtin_lookup(nm) = v then iterate
          end
          call dset nsd, mkstr(nm), v
        end
      end
    end
  end
  return 2

/* store the entries of dict nsd back into the namespace of the running module */
ns_writeback: procedure = .void
  arg nsd = .int
  e = .int
  s = .string
  nm = .string
  sc = .int
  sc = mod_sc[cur_mi]
  e = dd_head[ob_x[nsd % 2]]
  do while e > 0
    if de_live[e] = 1 & kind_of(de_key[e]) = 6 then do
      nm = ob_s[de_key[e] % 2]
      s = scm[sc || "|" || nm]
      if s == "" then s = dyn_alloc(cur_mi, nm)
      if s \== "" then vp[gfb + (s as .int)] = de_val[e]
      else modx[cur_mi || "." || nm] = de_val[e] as .string
    end
    e = de_next[e]
  end
  return

/* eval(src[, globals[, locals[, module_level_flag]]]) and exec(...) */
bi_evalexec: procedure = .int
  arg mode = .int, base = .int, na = .int
  src = .int
  g = .int
  l = .int
  nsd = .int
  r = .int
  modlvl = .int
  if na < 1 then return nargs_err("eval", na, 1, 3)
  src = ast[base + 1]
  if kind_of(src) \= 6 then return raise_exc(38, "eval() arg 1 must be a string, bytes or code object")
  g = 2
  l = 2
  modlvl = 0
  if na >= 2 then g = ast[base + 2]
  if na >= 3 then l = ast[base + 3]
  if na >= 4 then modlvl = ival(ast[base + 4])
  if g = 2 then do
    nsd = mod_dict(cur_mi)
    if l \= 2 & kind_of(l) = 9 then call dict_copy_into l, nsd
    r = ns_exec(ob_s[src % 2], mode, nsd)
    if r = 0 then return 0
    if mode = 0 & modlvl = 1 then call ns_writeback nsd
    return r
  end
  if kind_of(g) \= 9 then return raise_exc(38, "globals must be a dict")
  nsd = g
  if l \= 2 & l \= g & kind_of(l) = 9 then do
    nsd = dict_new(9)
    call dict_copy_into g, nsd
    call dict_copy_into l, nsd
    r = ns_exec(ob_s[src % 2], mode, nsd)
    if r = 0 then return 0
    if mode = 0 then call dict_copy_into nsd, l
    return r
  end
  return ns_exec(ob_s[src % 2], mode, nsd)

/* __import__(name, globals, locals, fromlist, level) */
bi_import: procedure = .int
  arg base = .int, na = .int
  nm = .string
  p = .int
  m = .int
  if na < 1 | kind_of(ast[base + 1]) \= 6 then return raise_exc(38, "__import__() argument 'name' must be str")
  nm = ob_s[ast[base + 1] % 2]
  m = import_mod(nm)
  if m = 0 then return 0
  if na >= 4 then do
    if truthy(ast[base + 4]) = 1 then return m
  end
  p = pos(".", nm)
  if p > 0 then return import_mod(left(nm, p - 1))
  return m

/* find / allocate a global slot for a new name of a dynamic module; "" when the frame is full */
dyn_alloc: procedure = .string
  arg mi = .int, nm = .string
  sc = .int
  slot = .int
  sc = mod_sc[mi]
  slot = sc_n[sc]
  if mod_dyn[mi] = 0 | slot >= mod_fsz[mi] then return ""
  sc_n[sc] = slot + 1
  scm[sc || "|" || nm] = slot as .string
  nbn = nbn + 1
  bn_sc[nbn] = sc
  bn_name[nbn] = nm
  bn_slot[nbn] = slot
  return slot as .string

/* type(name, bases, dict) */
type_new: procedure = .int
  arg nm = .int, bo = .int, d = .int
  i = .int
  b = .int
  c = .int
  nb = .int
  e = .int
  if kind_of(nm) \= 6 | kind_of(bo) \= 8 | kind_of(d) \= 9 then return raise_exc(38, "type() argument types are (str, tuple, dict)")
  bl_n = 0
  do i = 0 to ob_n[bo % 2] - 1
    b = sl[ob_p[bo % 2] + i]
    if kind_of(b) \= 16 then return raise_exc(38, "bases must be types")
    bl_n = bl_n + 1
    bl_a[bl_n] = ob_x[b % 2]
  end
  if bl_n = 0 then do
    bl_n = 1
    bl_a[1] = 1
  end
  nb = bl_n
  b = bl_a[1]
  c = define_class(ob_s[nm % 2], b)
  if nb > 1 then do
    if set_bases(c, nb) = 0 then return 0
  end
  if (cl_flags[c] // 2) = 1 then cl_flags[c] = cl_flags[c] - 1
  call set_btype c
  cl_dflt[c] = cl_dflt[b]
  e = dd_head[ob_x[d % 2]]
  do while e > 0
    if de_live[e] = 1 & kind_of(de_key[e]) = 6 then call cls_set c, nameid(ob_s[de_key[e] % 2]), de_val[e]
    e = de_next[e]
  end
  return cl_obj[c]

/* ---------------------------------------------------------------------
   Formatting: format specs, % operator, str.format
   --------------------------------------------------------------------- */
group3: procedure = .string
  arg d = .string, sep = .string
  r = .string
  n = .int
  i = .int
  n = length(d)
  if n <= 3 then return d
  r = ""
  do i = n to 1 by -3
    if i - 3 >= 1 then r = sep || substr(d, i - 2, 3) || r
    else r = substr(d, 1, i) || r
  end
  return r

radix_str: procedure = .string
  arg s = .string, rdx = .int
  digs = .string
  neg = .int
  r = .string
  q = .string
  d = .int
  n = .int
  v = .int
  digs = "0123456789abcdef"
  neg = 0
  if left(s, 1) == "-" then do
    neg = 1
    s = substr(s, 2)
  end
  if s == "0" then return "0"
  r = ""
  if length(s) <= 18 then do
    v = s as .int
    do while v > 0
      d = v // rdx
      r = substr(digs, d + 1, 1) || r
      v = v % rdx
    end
  end
  else do
    do while s \== "0"
      call mag_divmod s, rdx as .string
      d = brm as .int
      r = substr(digs, d + 1, 1) || r
      s = bq
    end
  end
  if neg = 1 then return "-" || r
  return r

/* pad / align a field.  align: < > ^ = ; numeric parts: sign, prefix, body */
fmt_pad: procedure = .string
  arg sign = .string, body = .string, fill = .string, align = .string, width = .int
  n = .int
  pad = .int
  lp = .int
  s = .string
  s = sign || body
  n = length(s)
  if n >= width then return s
  pad = width - n
  if fill == "" then fill = " "
  if align == "<" then return s || copies(fill, pad)
  if align == "^" then do
    lp = pad % 2
    return copies(fill, lp) || s || copies(fill, pad - lp)
  end
  if align == "=" then return sign || copies(fill, pad) || body
  return copies(fill, pad) || s

format_value: procedure = .string
  arg v = .int, spec = .string
  fill = .string
  align = .string
  sgn = .string
  alt = .int
  zero = .int
  width = .int
  grp = .string
  prec = .int
  ty = .string
  i = .int
  n = .int
  c = .string
  k = .int
  s = .string
  neg = .int
  body = .string
  f = .float
  x = .float
  sign = .string
  m = .int
  r = .int
  pre = .string
  hasprec = .int
  if spec == "" then return str_of(v)
  k = kind_of(v)
  if k = 32 then return format_complex(v, spec)
  if ocls(v) > 0 then do
    m = ovr(v, 151)
    if m > 0 then do
      r = call2(m, v, mkstr(spec))
      if r = 0 then return ""
      return ob_s[r % 2]
    end
  end
  fill = ""
  align = ""
  sgn = ""
  alt = 0
  zero = 0
  width = 0
  grp = ""
  prec = -1
  ty = ""
  i = 1
  n = length(spec)
  if n >= 2 & pos(substr(spec, 2, 1), "<>^=") > 0 then do
    fill = substr(spec, 1, 1)
    align = substr(spec, 2, 1)
    i = 3
  end
  else if n >= 1 & pos(substr(spec, 1, 1), "<>^=") > 0 then do
    align = substr(spec, 1, 1)
    i = 2
  end
  c = substr(spec, i, 1)
  if c == "+" | c == "-" | c == " " then do
    sgn = c
    i = i + 1
  end
  if substr(spec, i, 1) == "#" then do
    alt = 1
    i = i + 1
  end
  if substr(spec, i, 1) == "0" then do
    zero = 1
    i = i + 1
  end
  do while i <= n & isdigit(substr(spec, i, 1)) = 1
    width = width * 10 + (substr(spec, i, 1) as .int)
    i = i + 1
  end
  c = substr(spec, i, 1)
  if c == "," | c == "_" then do
    grp = c
    i = i + 1
  end
  if substr(spec, i, 1) == "." then do
    i = i + 1
    prec = 0
    do while i <= n & isdigit(substr(spec, i, 1)) = 1
      prec = prec * 10 + (substr(spec, i, 1) as .int)
      i = i + 1
    end
  end
  if i <= n then ty = substr(spec, i, 1)
  if zero = 1 & align == "" then do
    align = "="
    if fill == "" then fill = "0"
  end
  /* strings */
  if k = 6 | (k \= 5 & numkind(v) = 0) then do
    if k = 6 then s = ob_s[v % 2]
    else s = str_of(v)
    if unw > 0 then return ""
    if ty \== "" & ty \== "s" then do
      call raise_exc 36, "Unknown format code '" || ty || "' for object of type '" || type_name(v) || "'"
      return ""
    end
    if prec >= 0 then s = left(s, prec)
    if align == "" then align = "<"
    return fmt_pad("", s, fill, align, width)
  end
  if align == "" then align = ">"
  /* integers */
  if k \= 5 & (ty == "" | ty == "d" | ty == "n" | ty == "b" | ty == "o" | ty == "x" | ty == "X" | ty == "c") then do
    s = num_str(v)
    if ty == "c" then return fmt_pad("", d2c(ival(v)), fill, align, width)
    neg = 0
    if left(s, 1) == "-" then do
      neg = 1
      s = substr(s, 2)
    end
    pre = ""
    if ty == "b" then do
      s = radix_str(s, 2)
      if alt = 1 then pre = "0b"
    end
    else if ty == "o" then do
      s = radix_str(s, 8)
      if alt = 1 then pre = "0o"
    end
    else if ty == "x" then do
      s = radix_str(s, 16)
      if alt = 1 then pre = "0x"
    end
    else if ty == "X" then do
      s = upper(radix_str(s, 16))
      if alt = 1 then pre = "0X"
    end
    else if grp \== "" then s = group3(s, grp)
    if neg = 1 then sign = "-"
    else if sgn == "+" then sign = "+"
    else if sgn == " " then sign = " "
    else sign = ""
    sign = sign || pre
    return fmt_pad(sign, s, fill, align, width)
  end
  /* floats */
  if numkind(v) = 0 then do
    call raise_exc 36, "Unknown format code '" || ty || "' for object of type '" || type_name(v) || "'"
    return ""
  end
  f = tofloat(v)
  hasprec = 1
  if prec < 0 then do
    prec = 6
    hasprec = 0
  end
  x = f
  neg = 0
  if f < 0.0 then do
    neg = 1
    x = 0.0 - f
  end
  else if f = 0.0 then do
    if fl_negzero(f) = 1 then do
      neg = 1
      x = 0.0
    end
  end
  if f \= f then body = "nan"
  else if finf(x) = 1 then body = "inf"
  else if ty == "f" | ty == "F" then do
    body = float_fixed(x, prec)
    if grp \== "" then body = group_float(body, grp)
    if alt = 1 & prec = 0 then body = body || "."
  end
  else if ty == "e" | ty == "E" then do
    body = float_sci(x, prec, 0)
    if ty == "E" then body = upper(body)
  end
  else if ty == "%" then do
    body = float_fixed(x * 100.0, prec) || "%"
  end
  else if ty == "g" | ty == "G" | ty == "n" | (ty == "" & hasprec = 1) then do
    body = float_general(x, prec, alt)
    if ty == "G" then body = upper(body)
    if ty == "" & pos(".", body) = 0 & pos("e", body) = 0 & pos("n", body) = 0 then body = body || ".0"
    if grp \== "" then body = group_float(body, grp)
  end
  else do
    /* plain: repr */
    body = float_repr(x)
    if grp \== "" then body = group_float(body, grp)
  end
  if neg = 1 then sign = "-"
  else if sgn == "+" then sign = "+"
  else if sgn == " " then sign = " "
  else sign = ""
  return fmt_pad(sign, body, fill, align, width)

group_float: procedure = .string
  arg s = .string, sep = .string
  p = .int
  p = pos(".", s)
  if p = 0 then return group3(s, sep)
  return group3(left(s, p - 1), sep) || substr(s, p)

/* %g style */
float_general: procedure = .string
  arg x = .float, prec = .int, alt = .int
  d = .string
  e = .int
  l = .int
  body = .string
  es = .string
  ee = .string
  if prec = 0 then prec = 1
  if x = 0.0 then do
    if alt = 1 then return "0." || copies("0", prec - 1)
    return "0"
  end
  d = float_digits(x, prec)
  e = fx_e
  if e < -4 | e >= prec then do
    /* scientific */
    l = length(d)
    if alt = 0 then do
      do while l > 1 & substr(d, l, 1) == "0"
        l = l - 1
      end
      d = left(d, l)
    end
    body = left(d, 1)
    if length(d) > 1 then body = body || "." || substr(d, 2)
    if e < 0 then es = "-"
    else es = "+"
    ee = abs(e) as .string
    if length(ee) < 2 then ee = "0" || ee
    return body || "e" || es || ee
  end
  /* fixed with prec-1-e decimals */
  body = float_fixed(x, prec - 1 - e)
  if alt = 0 & pos(".", body) > 0 then do
    l = length(body)
    do while substr(body, l, 1) == "0"
      l = l - 1
    end
    if substr(body, l, 1) == "." then l = l - 1
    body = left(body, l)
  end
  return body

/* the % operator on strings */
fmt_percent: procedure = .int
  arg fs = .string, args = .int
  r = .string
  i = .int
  n = .int
  c = .string
  argi = .int
  items = .int
  nitems = .int
  v = .int
  flags = .string
  width = .int
  prec = .int
  ty = .string
  key = .string
  p = .int
  spec = .string
  s = .string
  istup = .int
  vv = .int
  left_ = .int
  zero = .int
  plus = .string
  alt = .int
  d = .int
  neg = .int
  body = .string
  sign = .string
  fill = .string
  al_ = .string
  x_ = .float
  istup = 0
  if kind_of(args) = 8 then do
    istup = 1
    items = args
    nitems = ob_n[args % 2]
  end
  else do
    items = 0
    nitems = 1
  end
  argi = 0
  r = ""
  n = length(fs)
  i = 1
  do while i <= n
    p = pos("%", fs, i)
    if p = 0 then do
      r = r || substr(fs, i)
      leave
    end
    r = r || substr(fs, i, p - i)
    i = p + 1
    if i > n then do
      call raise_exc 36, "incomplete format"
      return 0
    end
    key = ""
    if substr(fs, i, 1) == "(" then do
      p = pos(")", fs, i)
      key = substr(fs, i + 1, p - i - 1)
      i = p + 1
    end
    flags = ""
    do while i <= n & pos(substr(fs, i, 1), "-+ #0") > 0
      flags = flags || substr(fs, i, 1)
      i = i + 1
    end
    width = 0
    if substr(fs, i, 1) == "*" then do
      width = ival(sl[ob_p[items % 2] + argi])
      argi = argi + 1
      i = i + 1
    end
    else do
      do while i <= n & isdigit(substr(fs, i, 1)) = 1
        width = width * 10 + (substr(fs, i, 1) as .int)
        i = i + 1
      end
    end
    prec = -1
    if substr(fs, i, 1) == "." then do
      i = i + 1
      prec = 0
      if substr(fs, i, 1) == "*" then do
        prec = ival(sl[ob_p[items % 2] + argi])
        argi = argi + 1
        i = i + 1
      end
      else do
        do while i <= n & isdigit(substr(fs, i, 1)) = 1
          prec = prec * 10 + (substr(fs, i, 1) as .int)
          i = i + 1
        end
      end
    end
    do while i <= n & pos(substr(fs, i, 1), "hlL") > 0
      i = i + 1
    end
    ty = substr(fs, i, 1)
    i = i + 1
    if ty == "%" then do
      r = r || "%"
      iterate
    end
    /* fetch the argument */
    if key \== "" then do
      if kind_of(args) \= 9 then do
        call raise_exc 38, "format requires a mapping"
        return 0
      end
      d = dict_find(ob_x[args % 2], hashkey(mkstr(key)))
      if d = 0 then do
        v = raise_key(mkstr(key))
        return 0
      end
      v = de_val[d]
    end
    else if istup = 1 then do
      if argi >= nitems then do
        call raise_exc 38, "not enough arguments for format string"
        return 0
      end
      v = sl[ob_p[items % 2] + argi]
      argi = argi + 1
    end
    else do
      if argi >= 1 then do
        call raise_exc 38, "not enough arguments for format string"
        return 0
      end
      v = args
      argi = argi + 1
    end
    left_ = 0
    if pos("-", flags) > 0 then left_ = 1
    zero = 0
    if pos("0", flags) > 0 & left_ = 0 then zero = 1
    plus = ""
    if pos("+", flags) > 0 then plus = "+"
    else if pos(" ", flags) > 0 then plus = " "
    alt = 0
    if pos("#", flags) > 0 then alt = 1
    fill = " "
    if ty == "s" | ty == "r" | ty == "a" then do
      if ty == "s" then s = str_of(v)
      else s = repr_of(v)
      if unw > 0 then return 0
      if prec >= 0 then s = left(s, prec)
      if left_ = 1 then al_ = "<"
      else al_ = ">"
      r = r || fmt_pad("", s, " ", al_, width)
    end
    else if ty == "c" then do
      if kind_of(v) = 6 then s = ob_s[v % 2]
      else s = d2c(ival(v))
      r = r || fmt_pad("", s, " ", ">", width)
    end
    else do
      if kind_of(v) = 17 then do
        vv = 0
        if pos(ty, "diuxXoc") > 0 then do
          if pos(ty, "diu") > 0 then vv = cls_find(ob_c[v % 2], 161)
          if vv = 0 then vv = cls_find(ob_c[v % 2], 159)
        end
        else vv = cls_find(ob_c[v % 2], 149)
        if vv > 0 then do
          v = call1(vv, v)
          if unw > 0 then return 0
        end
      end
      if numkind(v) = 0 then do
        call raise_exc 38, "%" || ty || " format: a real number is required, not " || type_name(v)
        return 0
      end
      if ty == "d" | ty == "i" | ty == "u" then do
        if kind_of(v) = 5 then v = float_to_int(ob_f[v % 2])
        s = num_str(v)
      end
      else if ty == "x" | ty == "X" | ty == "o" then do
        if kind_of(v) = 5 then do
          call raise_exc 38, "%" || ty || " format: an integer is required, not float"
          return 0
        end
        s = num_str(v)
      end
      else s = ""
      neg = 0
      if ty == "d" | ty == "i" | ty == "u" | ty == "x" | ty == "X" | ty == "o" then do
        if left(s, 1) == "-" then do
          neg = 1
          s = substr(s, 2)
        end
        if ty == "x" then do
          s = radix_str(s, 16)
          if alt = 1 then s = "0x" || s
        end
        else if ty == "X" then do
          s = upper(radix_str(s, 16))
          if alt = 1 then s = "0X" || s
        end
        else if ty == "o" then do
          s = radix_str(s, 8)
          if alt = 1 then s = "0o" || s
        end
        if prec >= 0 & length(s) < prec then s = copies("0", prec - length(s)) || s
        body = s
      end
      else do
        x_ = tofloat(v)
        if x_ < 0.0 then do
          neg = 1
          x_ = 0.0 - x_
        end
        else if x_ = 0.0 & fl_negzero(x_) = 1 then do
          neg = 1
          x_ = 0.0
        end
        if prec < 0 then prec = 6
        if x_ \= x_ then body = "nan"
        else if finf(x_) = 1 then body = "inf"
        else if ty == "f" | ty == "F" then body = float_fixed(x_, prec)
        else if ty == "e" then body = float_sci(x_, prec, 0)
        else if ty == "E" then body = float_sci(x_, prec, 1)
        else if ty == "g" then body = float_general(x_, prec, alt)
        else if ty == "G" then body = upper(float_general(x_, prec, alt))
        else do
          call raise_exc 36, "unsupported format character '" || ty || "'"
          return 0
        end
      end
      if neg = 1 then sign = "-"
      else sign = plus
      if zero = 1 then al_ = "="
      else if left_ = 1 then al_ = "<"
      else al_ = ">"
      if zero = 1 then fill = "0"
      r = r || fmt_pad(sign, body, fill, al_, width)
    end
  end
  if istup = 1 & argi < nitems then do
    call raise_exc 38, "not all arguments converted during string formatting"
    return 0
  end
  return mkstr(r)

/* str.format(*args, **kwargs): arguments at ast[base+1 ..] */
fmt_format: procedure = .int
  arg fs = .string, base = .int, na = .int, nk = .int
  r = .string
  i = .int
  n = .int
  c = .string
  p = .int
  dep = .int
  field = .string
  conv = .string
  spec = .string
  name = .string
  rest = .string
  v = .int
  auto = .int
  q = .int
  j = .int
  ch = .string
  idx = .int
  a = .int
  attr = .string
  k = .int
  nid = .int
  e = .int
  sp = .string
  r = ""
  n = length(fs)
  i = 1
  auto = 0
  if fmt_nested = 1 then do
    auto = fmt_auto_in
    fmt_nested = 0
  end
  do while i <= n
    c = substr(fs, i, 1)
    if c == "{" then do
      if substr(fs, i + 1, 1) == "{" then do
        r = r || "{"
        i = i + 2
        iterate
      end
      /* find matching brace */
      dep = 1
      p = i + 1
      do while p <= n & dep > 0
        ch = substr(fs, p, 1)
        if ch == "{" then dep = dep + 1
        else if ch == "}" then dep = dep - 1
        if dep > 0 then p = p + 1
      end
      if dep > 0 then do
        call raise_exc 36, "Single '{' encountered in format string"
        return 0
      end
      field = substr(fs, i + 1, p - i - 1)
      i = p + 1
      conv = ""
      spec = ""
      q = pos(":", field)
      if q > 0 then do
        spec = substr(field, q + 1)
        field = left(field, q - 1)
      end
      q = pos("!", field)
      if q > 0 then do
        conv = substr(field, q + 1, 1)
        field = left(field, q - 1)
      end
      /* split name from attribute / index accessors */
      name = field
      rest = ""
      q = verify(field, ".[", "M")
      if q > 0 then do
        name = left(field, q - 1)
        rest = substr(field, q)
      end
      if name == "" then do
        v = arg_at(base, na, nk, auto, "")
        auto = auto + 1
      end
      else if isdigit(left(name, 1)) = 1 then v = arg_at(base, na, nk, name as .int, "")
      else v = arg_at(base, na, nk, -1, name)
      if v = 0 then return 0
      do while rest \== ""
        if left(rest, 1) == "." then do
          q = verify(substr(rest, 2), ".[", "M")
          if q = 0 then do
            attr = substr(rest, 2)
            rest = ""
          end
          else do
            attr = substr(rest, 2, q - 1)
            rest = substr(rest, q + 1)
          end
          v = getattr_obj(v, nameid(attr), 0)
          if v = 0 then return 0
        end
        else do
          q = pos("]", rest)
          attr = substr(rest, 2, q - 2)
          rest = substr(rest, q + 1)
          if isdigit(left(attr, 1)) = 1 then v = getitem(v, mkint(attr as .int))
          else v = getitem(v, mkstr(attr))
          if v = 0 then return 0
        end
      end
      if conv == "r" | conv == "a" then v = mkstr(repr_of(v))
      else if conv == "s" then v = mkstr(str_of(v))
      if pos("{", spec) > 0 then do
        /* nested replacement fields in the spec */
        fmt_auto_in = auto
        fmt_nested = 1
        sp = ob_s[fmt_format(spec, base, na, nk) % 2]
        auto = fmt_auto_out
        spec = sp
      end
      r = r || format_value(v, spec)
      if unw > 0 then return 0
      iterate
    end
    if c == "}" then do
      if substr(fs, i + 1, 1) == "}" then i = i + 1
      r = r || "}"
      i = i + 1
      iterate
    end
    r = r || c
    i = i + 1
  end
  fmt_auto_out = auto
  return mkstr(r)

/* the idx-th positional argument (or the keyword name) of a format call */
arg_at: procedure = .int
  arg base = .int, na = .int, nk = .int, idx = .int, name = .string
  j = .int
  if idx >= 0 then do
    if idx >= na then do
      call raise_exc 34, "Replacement index " || idx || " out of range for positional args tuple"
      return 0
    end
    return ast[base + 1 + idx]
  end
  do j = 1 to nk
    if asn[base + na + j] == name then return ast[base + na + j]
  end
  return raise_key(mkstr(name))

/* ---------------------------------------------------------------------
   numpy subset, part 1: ndarray objects (kind K_ARRAY), construction, broadcasting, operators.
   Object fields:  ob_c dtype (1 int64, 2 float64, 3 bool)   ob_n size   ob_x ndim
                   ob_y start of the shape (ndim raw integers in sl)
                   ob_p start of the data: raw integers in sl (int, bool) or floats in npf
   --------------------------------------------------------------------- */
np_dtname: procedure = .string
  arg dt = .int
  if dt = 2 then return "float64"
  if dt = 3 then return "bool"
  return "int64"

np_new: procedure = .int
  arg dt = .int, nd = .int, sz = .int
  o = .int
  ix = .int
  o = newobj(29)
  ix = o % 2
  ob_c[ix] = dt
  ob_x[ix] = nd
  ob_n[ix] = sz
  ob_y[ix] = 0
  if nd > 0 then ob_y[ix] = alloc_slots(nd)
  npw = npw + sz % 8
  if dt = 2 then ob_p[ix] = np_falloc(sz)
  else ob_p[ix] = alloc_slots(sz)
  return o

/* float data: a block of sz slots of the float store npf (recycled through size lists) */
np_falloc: procedure = .int
  arg sz = .int
  st = .int
  v = .string
  nx = .int
  if sz > 0 then do
    v = nfh[sz]
    if v \== "" then do
      st = v as .int
      if st > 0 then do
        nx = rxfloat..trunc(npf[st]) as .int
        nfh[sz] = nx as .string
        npf[st] = 0.0
        return st
      end
    end
  end
  st = npn + 1
  npn = npn + sz
  if sz > 0 then npf[npn] = 0.0
  return st

np_ffree: procedure = .void
  arg st = .int, sz = .int
  i = .int
  v = .string
  nx = .int
  if st <= 0 | sz <= 0 then return
  if gcpoison = 1 then do
    do i = 0 to sz - 1
      npf[st + i] = 7.7e77
    end
    return
  end
  do i = 0 to sz - 1
    npf[st + i] = 0.0
  end
  v = nfh[sz]
  nx = 0
  if v \== "" then nx = v as .int
  npf[st] = nx as .float
  nfh[sz] = st as .string
  return

/* copy the scratch shape nprs[1..nprn] into array r */
np_shape_from_scratch: procedure = .void
  arg r = .int
  d = .int
  do d = 1 to nprn
    sl[ob_y[r % 2] + d - 1] = nprs[d]
  end
  return

np_scalar: procedure = .int
  arg a = .int, i = .int
  ix = .int
  ix = a % 2
  if ob_c[ix] = 2 then return mkfloat(npf[ob_p[ix] + i])
  if ob_c[ix] = 3 then return mkbool(sl[ob_p[ix] + i])
  return mkint(sl[ob_p[ix] + i])

np_f2i: procedure = .int
  arg f = .float
  if f \= f then return 0
  if f > 900000000000000000.0 then return 900000000000000000
  if f < -900000000000000000.0 then return -900000000000000000
  return rxfloat..trunc(f) as .int

np_getf: procedure = .float
  arg a = .int, j = .int
  ix = .int
  v = .int
  ix = a % 2
  if ob_c[ix] = 2 then return npf[ob_p[ix] + j]
  v = sl[ob_p[ix] + j]
  return v as .float

np_geti: procedure = .int
  arg a = .int, j = .int
  ix = .int
  ix = a % 2
  if ob_c[ix] = 2 then return np_f2i(npf[ob_p[ix] + j])
  return sl[ob_p[ix] + j]

/* r[j] = s[i] converting to the dtype of r */
np_copyel: procedure = .void
  arg r = .int, j = .int, s = .int, i = .int
  dr = .int
  ds = .int
  v = .int
  f = .float
  dr = ob_c[r % 2]
  ds = ob_c[s % 2]
  if dr = 2 then do
    if ds = 2 then npf[ob_p[r % 2] + j] = npf[ob_p[s % 2] + i]
    else do
      v = sl[ob_p[s % 2] + i]
      npf[ob_p[r % 2] + j] = v as .float
    end
    return
  end
  if dr = 1 then do
    if ds = 2 then sl[ob_p[r % 2] + j] = np_f2i(npf[ob_p[s % 2] + i])
    else sl[ob_p[r % 2] + j] = sl[ob_p[s % 2] + i]
    return
  end
  if ds = 2 then do
    f = npf[ob_p[s % 2] + i]
    if f \= 0.0 then sl[ob_p[r % 2] + j] = 1
    else sl[ob_p[r % 2] + j] = 0
  end
  else do
    v = sl[ob_p[s % 2] + i]
    if v \= 0 then sl[ob_p[r % 2] + j] = 1
    else sl[ob_p[r % 2] + j] = 0
  end
  return

np_shape_tuple: procedure = .int
  arg a = .int
  t = .int
  d = .int
  ix = .int
  ix = a % 2
  t = mktuple(ob_x[ix])
  do d = 0 to ob_x[ix] - 1
    sl[ob_p[t % 2] + d] = mkint(sl[ob_y[ix] + d])
  end
  return t

np_shape_str: procedure = .string
  arg a = .int
  s = .string
  d = .int
  ix = .int
  ix = a % 2
  s = "("
  do d = 0 to ob_x[ix] - 1
    if d > 0 then s = s || ","
    s = s || sl[ob_y[ix] + d]
  end
  if ob_x[ix] = 1 then s = s || ","
  return s || ")"

/* a 0-d array holding the Python number x */
np_scalar_arr: procedure = .int
  arg x = .int
  o = .int
  if numkind(x) >= 2 then do
    o = np_new(2, 0, 1)
    npf[ob_p[o % 2]] = tofloat(x)
    return o
  end
  if kind_of(x) = 2 then o = np_new(3, 0, 1)
  else o = np_new(1, 0, 1)
  sl[ob_p[o % 2]] = ival(x)
  return o

np_seqlen: procedure = .int
  arg x = .int
  k = .int
  k = kind_of(x)
  if k = 7 | k = 8 then return ob_n[x % 2]
  if k = 29 then do
    if ob_x[x % 2] >= 1 then return sl[ob_y[x % 2]]
  end
  return -1

/* element i along the first axis: a scalar, or a new array */
np_item0: procedure = .int
  arg a = .int, i = .int
  ix = .int
  nd = .int
  sub = .int
  r = .int
  ir = .int
  d = .int
  j = .int
  ix = a % 2
  nd = ob_x[ix]
  if nd = 1 then return np_scalar(a, i)
  return np_mkview(a, i, 1, 1)

/* a view sharing the data of a: rows start .. start+cnt-1 of the first axis (or just row start when drop = 1) */
np_mkview: procedure = .int
  arg a = .int, start = .int, cnt = .int, drop = .int
  ia = .int
  ir = .int
  r = .int
  nd = .int
  d = .int
  sub = .int
  ia = a % 2
  nd = ob_x[ia]
  sub = 1
  do d = 1 to nd - 1
    sub = sub * sl[ob_y[ia] + d]
  end
  r = newobj(29)
  ir = r % 2
  ob_c[ir] = ob_c[ia]
  if ob_s[ia] \== "" then ob_s[ir] = ob_s[ia]
  else ob_s[ir] = a as .string
  ob_p[ir] = ob_p[ia] + start * sub
  if drop = 1 then do
    ob_x[ir] = nd - 1
    ob_n[ir] = sub
    ob_y[ir] = 0
    if nd > 1 then ob_y[ir] = alloc_slots(nd - 1)
    do d = 1 to nd - 1
      sl[ob_y[ir] + d - 1] = sl[ob_y[ia] + d]
    end
  end
  else do
    ob_x[ir] = nd
    ob_n[ir] = cnt * sub
    ob_y[ir] = alloc_slots(nd)
    sl[ob_y[ir]] = cnt
    do d = 1 to nd - 1
      sl[ob_y[ir] + d] = sl[ob_y[ia] + d]
    end
  end
  return r

/* in-place update for augmented assignment: cur takes the values of nw */
np_inplace: procedure = .int
  arg cur = .int, nw = .int
  i = .int
  if ob_n[nw % 2] \= ob_n[cur % 2] | ob_x[nw % 2] \= ob_x[cur % 2] then return nw
  do i = 0 to ob_n[cur % 2] - 1
    call np_copyel cur, i, nw, i
  end
  return cur

np_seqitem: procedure = .int
  arg x = .int, i = .int
  if kind_of(x) = 29 then return np_item0(x, i)
  return sl[ob_p[x % 2] + i]

np_inhom: procedure = .int
  return raise_exc(36, "setting an array element with a sequence. The requested array has an inhomogeneous shape")

/* flatten the nested sequence x (depth dep) into nti / ntf; 1 on success */
np_walk: procedure = .int
  arg x = .int, dep = .int
  n = .int
  i = .int
  k = .int
  v = .int
  w = .int
  f = .float
  if dep < ntnd then do
    n = np_seqlen(x)
    if n < 0 | n \= nts[dep + 1] then return np_inhom()
    do i = 0 to n - 1
      v = np_seqitem(x, i)
      if np_walk(v, dep + 1) = 0 then return 0
    end
    return 1
  end
  if np_seqlen(x) >= 0 then return np_inhom()
  w = x
  if kind_of(w) = 29 then w = np_scalar(w, 0)
  k = kind_of(w)
  if k = 32 then do
    npcx_f = 1
    return 0
  end
  if numkind(w) = 1 then do
    ntn = ntn + 1
    v = ival(w)
    nti[ntn] = v
    ntf[ntn] = v as .float
    if k = 2 then ntfb = 1
    else ntfi = 1
    return 1
  end
  if numkind(w) >= 2 then do
    ntn = ntn + 1
    f = tofloat(w)
    nti[ntn] = 0
    ntf[ntn] = f
    ntff = 1
    return 1
  end
  call raise_exc 38, "unsupported array element type '" || type_name(w) || "'"
  return 0

/* a new array from a (nested) sequence or a scalar */
np_from_obj: procedure = .int
  arg x = .int
  y = .int
  n = .int
  d = .int
  dt = .int
  r = .int
  ir = .int
  j = .int
  ntnd = 0
  y = x
  do forever
    n = np_seqlen(y)
    if n < 0 then leave
    ntnd = ntnd + 1
    nts[ntnd] = n
    if n = 0 then leave
    y = np_seqitem(y, 0)
  end
  ntn = 0
  ntfb = 0
  ntfi = 0
  ntff = 0
  npcx_f = 0
  if np_walk(x, 0) = 0 then do
    if npcx_f = 1 then do
      npcx_f = 0
      return cx_call1("_from_obj", x)
    end
    return 0
  end
  if ntff = 1 then dt = 2
  else if ntfi = 1 then dt = 1
  else if ntfb = 1 then dt = 3
  else dt = 2
  r = np_new(dt, ntnd, ntn)
  ir = r % 2
  do d = 1 to ntnd
    sl[ob_y[ir] + d - 1] = nts[d]
  end
  if dt = 2 then do
    do j = 1 to ntn
      npf[ob_p[ir] + j - 1] = ntf[j]
    end
  end
  else do
    do j = 1 to ntn
      sl[ob_p[ir] + j - 1] = nti[j]
    end
  end
  return r

np_coerce: procedure = .int
  arg x = .int
  k = .int
  k = kind_of(x)
  if k = 29 then return x
  if numkind(x) > 0 then return np_scalar_arr(x)
  if k = 7 | k = 8 then return np_from_obj(x)
  return raise_exc(38, "unsupported operand type: '" || type_name(x) || "'")

/* copy of a converted to dtype dt */
np_cast: procedure = .int
  arg a = .int, dt = .int
  r = .int
  ix = .int
  ir = .int
  n = .int
  j = .int
  d = .int
  ix = a % 2
  n = ob_n[ix]
  r = np_new(dt, ob_x[ix], n)
  ir = r % 2
  do d = 0 to ob_x[ix] - 1
    sl[ob_y[ir] + d] = sl[ob_y[ix] + d]
  end
  if ob_c[ix] = dt then do
    if dt = 2 then do
      do j = 0 to n - 1
        npf[ob_p[ir] + j] = npf[ob_p[ix] + j]
      end
    end
    else do
      do j = 0 to n - 1
        sl[ob_p[ir] + j] = sl[ob_p[ix] + j]
      end
    end
  end
  else do
    do j = 0 to n - 1
      call np_copyel r, j, a, j
    end
  end
  return r

/* a copy of a with a new shape taken from nprs / nprn (sizes must agree) */
np_with_shape: procedure = .int
  arg a = .int
  r = .int
  r = np_cast(a, ob_c[a % 2])
  ob_x[r % 2] = nprn
  ob_y[r % 2] = alloc_slots(nprn)
  call np_shape_from_scratch r
  return r

np_flat: procedure = .int
  arg a = .int
  nprn = 1
  nprs[1] = ob_n[a % 2]
  return np_with_shape(a)

/* ---- broadcasting ---- */
np_bs_init: procedure = .void
  arg a = .int
  d = .int
  nprn = ob_x[a % 2]
  do d = 1 to nprn
    nprs[d] = sl[ob_y[a % 2] + d - 1]
  end
  return

np_bs_merge: procedure = .int
  arg a = .int, b = .int
  nda = .int
  nd2 = .int
  j = .int
  da = .int
  db = .int
  dr = .int
  k1 = .int
  k2 = .int
  ns = .int[]
  nda = ob_x[b % 2]
  nd2 = nprn
  if nda > nd2 then nd2 = nda
  do j = 1 to nd2
    k1 = nprn - nd2 + j
    if k1 >= 1 then da = nprs[k1]
    else da = 1
    k2 = nda - nd2 + j
    if k2 >= 1 then db = sl[ob_y[b % 2] + k2 - 1]
    else db = 1
    if da = db then dr = da
    else if da = 1 then dr = db
    else if db = 1 then dr = da
    else return raise_exc(36, "operands could not be broadcast together with shapes " || np_shape_str(a) || " " || np_shape_str(b) || " ")
    ns[j] = dr
  end
  nprn = nd2
  do j = 1 to nd2
    nprs[j] = ns[j]
  end
  return 1

/* 0: same shape as the scratch shape, 1: single element, 2: needs an index table */
np_mode: procedure = .int
  arg a = .int
  ix = .int
  d = .int
  ix = a % 2
  if ob_n[ix] = 1 then return 1
  if ob_x[ix] \= nprn then return 2
  do d = 1 to nprn
    if sl[ob_y[ix] + d - 1] \= nprs[d] then return 2
  end
  return 0

/* index table (1-based, flat source offsets) of a broadcast to the scratch shape; which = 1, 2 or 3 */
np_btab: procedure = .int
  arg a = .int, which = .int
  ix = .int
  nda = .int
  j = .int
  jj = .int
  dimn = .int
  run = .int
  tot = .int
  i = .int
  off = .int
  st = .int[]
  cnt = .int[]
  ix = a % 2
  nda = ob_x[ix]
  tot = 1
  do j = 1 to nprn
    tot = tot * nprs[j]
    cnt[j] = 0
  end
  run = 1
  do j = nprn to 1 by -1
    jj = j - (nprn - nda)
    if jj < 1 then st[j] = 0
    else do
      dimn = sl[ob_y[ix] + jj - 1]
      if dimn = 1 then st[j] = 0
      else st[j] = run
      run = run * dimn
    end
  end
  off = 0
  do i = 1 to tot
    if which = 1 then npta[i] = off
    else if which = 2 then nptb[i] = off
    else nptc[i] = off
    j = nprn
    do while j >= 1
      cnt[j] = cnt[j] + 1
      off = off + st[j]
      if cnt[j] < nprs[j] then leave
      off = off - st[j] * nprs[j]
      cnt[j] = 0
      j = j - 1
    end
  end
  return tot

np_divz: procedure = .float
  arg x = .float
  if x \= x then return x
  if x = 0.0 then return f_nan()
  if x > 0.0 then return f_inf()
  return 0.0 - f_inf()

np_powf: procedure = .float
  arg x = .float, y = .float
  if y = 0.0 then return 1.0
  if x = 0.0 & y < 0.0 then return f_inf()
  return rxfloat..pow(x, y)

np_powi: procedure = .int
  arg x = .int, y = .int
  r = .int
  b = .int
  e = .int
  r = 1
  b = x
  e = y
  do while e > 0
    if e // 2 = 1 then r = r * b
    e = e % 2
    if e > 0 then b = b * b
  end
  return r

/* binary operation with broadcasting.  op: O_xxx, O_MAXIMUM, O_MINIMUM, or O_CEQ .. O_CGE */
np_binop: procedure = .int
  arg op = .int, x = .int, y = .int
  a = .int
  b = .int
  ia = .int
  ib = .int
  ir = .int
  r = .int
  da = .int
  db = .int
  rd = .int
  total = .int
  ma = .int
  mb = .int
  i = .int
  ja = .int
  jb = .int
  pa = .int
  pb = .int
  pr = .int
  xa = .float
  xb = .float
  z = .float
  ya = .int
  yb = .int
  zi = .int
  q = .int
  rm = .int
  cf = .int
  a = np_coerce(x)
  if a = 0 then return 0
  b = np_coerce(y)
  if b = 0 then return 0
  if op = 13 then return np_dot(a, b)
  ia = a % 2
  ib = b % 2
  da = ob_c[ia]
  db = ob_c[ib]
  rd = 1
  if da = 2 | db = 2 then rd = 2
  if op = 4 then rd = 2
  if op >= 31 then rd = 3
  if op = 10 | op = 11 | op = 12 then do
    if rd = 2 then return raise_exc(38, "ufunc 'bitwise_op' not supported for the input types, and the inputs could not be safely coerced to any supported types according to the casting rule ''safe''")
    if da = 3 & db = 3 then rd = 3
  end
  if (op = 8 | op = 9) & rd = 2 then return raise_exc(38, "ufunc 'shift' not supported for the input types")
  call np_bs_init a
  if np_bs_merge(a, b) = 0 then return 0
  total = 1
  do i = 1 to nprn
    total = total * nprs[i]
  end
  r = np_new(rd, nprn, total)
  ir = r % 2
  call np_shape_from_scratch r
  ma = np_mode(a)
  mb = np_mode(b)
  if ma = 2 then call np_btab a, 1
  if mb = 2 then call np_btab b, 2
  pa = ob_p[ia]
  pb = ob_p[ib]
  pr = ob_p[ir]
  if op >= 31 then do
    cf = 0
    if da = 2 | db = 2 then cf = 1
    do i = 0 to total - 1
      if ma = 0 then ja = i
      else if ma = 1 then ja = 0
      else ja = npta[i + 1]
      if mb = 0 then jb = i
      else if mb = 1 then jb = 0
      else jb = nptb[i + 1]
      zi = 0
      if cf = 1 then do
        if da = 2 then xa = npf[pa + ja]
        else do
          ya = sl[pa + ja]
          xa = ya as .float
        end
        if db = 2 then xb = npf[pb + jb]
        else do
          yb = sl[pb + jb]
          xb = yb as .float
        end
        select
          when op = 31 then do
            if xa = xb then zi = 1
          end
          when op = 32 then do
            if xa \= xb then zi = 1
          end
          when op = 33 then do
            if xa < xb then zi = 1
          end
          when op = 34 then do
            if xa <= xb then zi = 1
          end
          when op = 35 then do
            if xa > xb then zi = 1
          end
          when op = 36 then do
            if xa >= xb then zi = 1
          end
          otherwise nop
        end
      end
      else do
        ya = sl[pa + ja]
        yb = sl[pb + jb]
        select
          when op = 31 then do
            if ya = yb then zi = 1
          end
          when op = 32 then do
            if ya \= yb then zi = 1
          end
          when op = 33 then do
            if ya < yb then zi = 1
          end
          when op = 34 then do
            if ya <= yb then zi = 1
          end
          when op = 35 then do
            if ya > yb then zi = 1
          end
          when op = 36 then do
            if ya >= yb then zi = 1
          end
          otherwise nop
        end
      end
      sl[pr + i] = zi
    end
    return r
  end
  if rd = 2 then do
    do i = 0 to total - 1
      if ma = 0 then ja = i
      else if ma = 1 then ja = 0
      else ja = npta[i + 1]
      if mb = 0 then jb = i
      else if mb = 1 then jb = 0
      else jb = nptb[i + 1]
      if da = 2 then xa = npf[pa + ja]
      else do
        ya = sl[pa + ja]
        xa = ya as .float
      end
      if db = 2 then xb = npf[pb + jb]
      else do
        yb = sl[pb + jb]
        xb = yb as .float
      end
      z = 0.0
      select
        when op = 1 then z = xa + xb
        when op = 2 then z = xa - xb
        when op = 3 then z = xa * xb
        when op = 4 then do
          if xb = 0.0 then z = np_divz(xa)
          else z = xa / xb
        end
        when op = 5 then do
          if xb = 0.0 then z = np_divz(xa)
          else z = rxfloat..floor(xa / xb)
        end
        when op = 6 then do
          if xb = 0.0 then z = f_nan()
          else do
            z = rxfloat..fmod(xa, xb)
            if z \= 0.0 then do
              if (z < 0.0) \= (xb < 0.0) then z = z + xb
            end
          end
        end
        when op = 7 then z = np_powf(xa, xb)
        when op = 21 then do
          if xa \= xa then z = xa
          else if xb \= xb then z = xb
          else if xa >= xb then z = xa
          else z = xb
        end
        when op = 22 then do
          if xa \= xa then z = xa
          else if xb \= xb then z = xb
          else if xa <= xb then z = xa
          else z = xb
        end
        otherwise nop
      end
      npf[pr + i] = z
    end
    return r
  end
  do i = 0 to total - 1
    if ma = 0 then ja = i
    else if ma = 1 then ja = 0
    else ja = npta[i + 1]
    if mb = 0 then jb = i
    else if mb = 1 then jb = 0
    else jb = nptb[i + 1]
    ya = sl[pa + ja]
    yb = sl[pb + jb]
    zi = 0
    select
      when op = 1 then zi = ya + yb
      when op = 2 then zi = ya - yb
      when op = 3 then zi = ya * yb
      when op = 5 | op = 6 then do
        if yb = 0 then zi = 0
        else do
          q = ya % yb
          rm = ya // yb
          if rm \= 0 & ((rm < 0) \= (yb < 0)) then do
            q = q - 1
            rm = rm + yb
          end
          if op = 5 then zi = q
          else zi = rm
        end
      end
      when op = 7 then do
        if yb < 0 then return raise_exc(36, "Integers to negative integer powers are not allowed.")
        zi = np_powi(ya, yb)
      end
      when op = 10 then do
        assembler iand zi, ya, yb
      end
      when op = 11 then do
        assembler ior zi, ya, yb
      end
      when op = 12 then do
        assembler ixor zi, ya, yb
      end
      when op = 8 then do
        if yb < 0 | yb > 62 then zi = 0
        else zi = ya * np_powi(2, yb)
      end
      when op = 9 then do
        if yb < 0 then zi = 0
        else if yb > 62 then do
          if ya < 0 then zi = -1
          else zi = 0
        end
        else do
          assembler ishr zi, ya, yb
        end
      end
      when op = 21 then do
        if ya >= yb then zi = ya
        else zi = yb
      end
      when op = 22 then do
        if ya <= yb then zi = ya
        else zi = yb
      end
      otherwise nop
    end
    sl[pr + i] = zi
  end
  return r

np_unary: procedure = .int
  arg op = .int, x = .int
  a = .int
  r = .int
  ia = .int
  ir = .int
  n = .int
  i = .int
  dt = .int
  v = .int
  ia = x % 2
  dt = ob_c[ia]
  n = ob_n[ia]
  if op = 3 & dt = 2 then return raise_exc(38, "ufunc 'invert' not supported for the input types, and the inputs could not be safely coerced to any supported types according to the casting rule ''safe''")
  if op = 1 & dt = 3 then return raise_exc(38, "The numpy boolean negative, the `-` operator, is not supported, use the `~` operator or the logical_not function instead.")
  r = np_cast(x, dt)
  if op = 2 then return r
  ir = r % 2
  if dt = 2 then do
    do i = 0 to n - 1
      npf[ob_p[ir] + i] = npf[ob_p[ir] + i] * (0.0 - 1.0)
    end
    return r
  end
  do i = 0 to n - 1
    v = sl[ob_p[ir] + i]
    if op = 1 then sl[ob_p[ir] + i] = 0 - v
    else if dt = 3 then sl[ob_p[ir] + i] = 1 - v
    else sl[ob_p[ir] + i] = 0 - v - 1
  end
  return r

/* ---- element-wise functions of one array ---- */
np_math1: procedure = .int
  arg fid = .int, a = .int
  ia = .int
  ir = .int
  r = .int
  n = .int
  i = .int
  dt = .int
  rd = .int
  pa = .int
  pr = .int
  f = .float
  g = .float
  v = .int
  ia = a % 2
  n = ob_n[ia]
  dt = ob_c[ia]
  pa = ob_p[ia]
  rd = 2
  if fid = 150 | fid = 160 then rd = dt
  if fid = 161 then rd = 3
  r = np_new(rd, ob_x[ia], n)
  ir = r % 2
  pr = ob_p[ir]
  do i = 0 to ob_x[ia] - 1
    sl[ob_y[ir] + i] = sl[ob_y[ia] + i]
  end
  if fid = 150 | fid = 160 then do
    if dt = 2 then do
      do i = 0 to n - 1
        f = npf[pa + i]
        if fid = 150 then npf[pr + i] = rxfloat..fabs(f)
        else npf[pr + i] = f * f
      end
    end
    else do
      do i = 0 to n - 1
        v = sl[pa + i]
        if fid = 150 then do
          if v < 0 then v = 0 - v
        end
        else v = v * v
        sl[pr + i] = v
      end
    end
    return r
  end
  do i = 0 to n - 1
    if dt = 2 then f = npf[pa + i]
    else do
      v = sl[pa + i]
      f = v as .float
    end
    g = 0.0
    select
      when fid = 161 then do
        if f \= f then sl[pr + i] = 1
        else sl[pr + i] = 0
      end
      when fid = 149 then do
        if f \= f then g = f
        else if f < 0.0 then g = f_nan()
        else g = rxfloat..sqrt(f)
      end
      when fid = 151 then do
        if f \= f then g = f
        else if f > 709.78 then g = f_inf()
        else g = rxfloat..exp(f)
      end
      when fid = 152 then g = rxfloat..sin(f)
      when fid = 153 then g = rxfloat..cos(f)
      when fid = 154 then g = rxfloat..tan(f)
      when fid = 155 | fid = 156 | fid = 157 then do
        if f \= f then g = f
        else if f < 0.0 then g = f_nan()
        else if f = 0.0 then g = 0.0 - f_inf()
        else if fid = 155 then g = rxfloat..log(f)
        else if fid = 156 then g = rxfloat..log10(f)
        else g = rxfloat..log2(f)
      end
      when fid = 158 then do
        if f \= f | finf(f) \= 0 then g = f
        else g = rxfloat..floor(f)
      end
      when fid = 159 then do
        if f \= f | finf(f) \= 0 then g = f
        else g = rxfloat..ceil(f)
      end
      otherwise nop
    end
    if fid \= 161 then npf[pr + i] = g
  end
  return r

/* round half to even to an integral float */
np_rint: procedure = .float
  arg y = .float
  fl = .float
  df = .float
  fl = rxfloat..floor(y)
  df = y - fl
  if df < 0.5 then return fl
  if df > 0.5 then return fl + 1.0
  if rxfloat..floor(fl / 2.0) * 2.0 = fl then return fl
  return fl + 1.0

np_round1: procedure = .float
  arg f = .float, d = .int
  pw = .float
  r = .float
  if f \= f | finf(f) \= 0 then return f
  if d > 300 | d < -300 then return f
  if d >= 0 then do
    pw = rxfloat..pow10(d as .float)
    r = np_rint(f * pw) / pw
  end
  else do
    pw = rxfloat..pow10((0 - d) as .float)
    r = np_rint(f / pw) * pw
  end
  if r = 0.0 & f < 0.0 then return fneg(0.0)
  return r

np_round_arr: procedure = .int
  arg a = .int, d = .int
  r = .int
  ia = .int
  ir = .int
  i = .int
  n = .int
  p = .int
  q = .int
  v = .int
  rm = .int
  ia = a % 2
  r = np_cast(a, ob_c[ia])
  ir = r % 2
  n = ob_n[ia]
  if ob_c[ia] = 2 then do
    do i = 0 to n - 1
      npf[ob_p[ir] + i] = np_round1(npf[ob_p[ir] + i], d)
    end
    return r
  end
  if d >= 0 | d < -17 then return r
  p = 10 ** (0 - d)
  do i = 0 to n - 1
    v = sl[ob_p[ir] + i]
    q = v % p
    rm = v // p
    if rm < 0 then do
      q = q - 1
      rm = rm + p
    end
    if rm * 2 > p then q = q + 1
    else if rm * 2 = p then do
      if q // 2 \= 0 then q = q + 1
    end
    sl[ob_p[ir] + i] = q * p
  end
  return r

/* ---- dot / matmul for 1-d and 2-d arrays ---- */
np_dot: procedure = .int
  arg a = .int, b = .int
  ia = .int
  ib = .int
  na = .int
  nb = .int
  m = .int
  k = .int
  n = .int
  k2 = .int
  r = .int
  ir = .int
  rd = .int
  i = .int
  j = .int
  t = .int
  s = .float
  xa = .float
  xb = .float
  si = .int
  ya = .int
  yb = .int
  pa = .int
  pb = .int
  pr = .int
  da = .int
  db = .int
  ia = a % 2
  ib = b % 2
  na = ob_x[ia]
  nb = ob_x[ib]
  if na = 0 | nb = 0 then return np_binop(3, a, b)
  if na > 2 | nb > 2 then return raise_exc(36, "dot of arrays with more than two dimensions is not supported")
  if na = 1 then do
    m = 1
    k = sl[ob_y[ia]]
  end
  else do
    m = sl[ob_y[ia]]
    k = sl[ob_y[ia] + 1]
  end
  if nb = 1 then do
    k2 = sl[ob_y[ib]]
    n = 1
  end
  else do
    k2 = sl[ob_y[ib]]
    n = sl[ob_y[ib] + 1]
  end
  if k \= k2 then return raise_exc(36, "shapes " || np_shape_str(a) || " and " || np_shape_str(b) || " not aligned: " || k || " (dim " || (na - 1) || ") != " || k2 || " (dim 0)")
  da = ob_c[ia]
  db = ob_c[ib]
  rd = 1
  if da = 2 | db = 2 then rd = 2
  nprn = 0
  if na = 2 then do
    nprn = nprn + 1
    nprs[nprn] = m
  end
  if nb = 2 then do
    nprn = nprn + 1
    nprs[nprn] = n
  end
  r = np_new(rd, nprn, m * n)
  ir = r % 2
  call np_shape_from_scratch r
  pa = ob_p[ia]
  pb = ob_p[ib]
  pr = ob_p[ir]
  do i = 0 to m - 1
    do j = 0 to n - 1
      if rd = 2 then do
        s = 0.0
        do t = 0 to k - 1
          if da = 2 then xa = npf[pa + i * k + t]
          else do
            ya = sl[pa + i * k + t]
            xa = ya as .float
          end
          if db = 2 then xb = npf[pb + t * n + j]
          else do
            yb = sl[pb + t * n + j]
            xb = yb as .float
          end
          s = s + xa * xb
        end
        npf[pr + i * n + j] = s
      end
      else do
        si = 0
        do t = 0 to k - 1
          si = si + sl[pa + i * k + t] * sl[pb + t * n + j]
        end
        sl[pr + i * n + j] = si
      end
    end
  end
  if nprn = 0 then return np_scalar(r, 0)
  return r

/* ---- transpose (reverse the axes) ---- */
np_transpose: procedure = .int
  arg a = .int
  ia = .int
  ir = .int
  r = .int
  nd = .int
  j = .int
  i = .int
  n = .int
  off = .int
  run = .int
  ss = .int[]
  st = .int[]
  cnt = .int[]
  rs = .int[]
  ia = a % 2
  nd = ob_x[ia]
  if nd < 2 then return np_cast(a, ob_c[ia])
  n = ob_n[ia]
  r = np_new(ob_c[ia], nd, n)
  ir = r % 2
  run = 1
  do j = nd to 1 by -1
    ss[j] = run
    run = run * sl[ob_y[ia] + j - 1]
  end
  do j = 1 to nd
    rs[j] = sl[ob_y[ia] + nd - j]
    st[j] = ss[nd + 1 - j]
    sl[ob_y[ir] + j - 1] = rs[j]
    cnt[j] = 0
  end
  off = 0
  do i = 0 to n - 1
    if ob_c[ia] = 2 then npf[ob_p[ir] + i] = npf[ob_p[ia] + off]
    else sl[ob_p[ir] + i] = sl[ob_p[ia] + off]
    j = nd
    do while j >= 1
      cnt[j] = cnt[j] + 1
      off = off + st[j]
      if cnt[j] < rs[j] then leave
      off = off - st[j] * rs[j]
      cnt[j] = 0
      j = j - 1
    end
  end
  return r

/* ---- indexing ---- */
/* tables for the axes: npco[d] first entry, npcc[d] count, npcd[d] dropped flag, npcat entries;
   builds npsel (flat offsets), np_sc (count), and the result shape nprs / nprn */
np_sel_build: procedure = .void
  arg a = .int
  ia = .int
  nd = .int
  d = .int
  tot = .int
  i = .int
  j = .int
  off = .int
  old = .int
  cur = .int[]
  ia = a % 2
  nd = ob_x[ia]
  tot = 1
  nprn = 0
  do d = nd to 1 by -1
    if d = nd then npcs[d] = 1
    else npcs[d] = npcs[d + 1] * sl[ob_y[ia] + d]
  end
  do d = 1 to nd
    tot = tot * npcc[d]
    do j = 1 to npnb[d]
      nprn = nprn + 1
      nprs[nprn] = 1
    end
    if npcd[d] = 0 then do
      nprn = nprn + 1
      nprs[nprn] = npcc[d]
    end
    cur[d] = 0
  end
  do j = 1 to npnb[nd + 1]
    nprn = nprn + 1
    nprs[nprn] = 1
  end
  np_sc = tot
  if tot = 0 then return
  off = 0
  do d = 1 to nd
    off = off + npcat[npco[d]] * npcs[d]
  end
  do i = 1 to tot
    npsel[i] = off
    j = nd
    do while j >= 1
      old = npcat[npco[j] + cur[j]]
      cur[j] = cur[j] + 1
      if cur[j] < npcc[j] then do
        off = off + (npcat[npco[j] + cur[j]] - old) * npcs[j]
        leave
      end
      cur[j] = 0
      off = off + (npcat[npco[j]] - old) * npcs[j]
      j = j - 1
    end
  end
  return

np_plan: procedure = .int
  arg a = .int, ix = .int
  ia = .int
  nd = .int
  nit = .int
  i = .int
  d = .int
  v = .int
  nel = .int
  real = .int
  ax = .int
  dimn = .int
  k = .int
  tq = .int
  c = .int
  w = .int
  m = .int
  r = .int
  n = .int
  e = .int
  kv = .int
  ia = a % 2
  nd = ob_x[ia]
  if nd = 0 then return raise_exc(34, "too many indices for array: array is 0-dimensional, but 1 were indexed")
  if kind_of(ix) = 8 then do
    nit = ob_n[ix % 2]
    do i = 1 to nit
      npit[i] = sl[ob_p[ix % 2] + i - 1]
    end
  end
  else do
    nit = 1
    npit[1] = ix
  end
  nel = 0
  real = 0
  do i = 1 to nit
    if npit[i] = 8 then nel = nel + 1
    else if npit[i] \= 2 then real = real + 1
  end
  do i = 1 to nd + 1
    npnb[i] = 0
  end
  if nel > 1 then return raise_exc(34, "an index can only have a single ellipsis ('...')")
  if real > nd then return raise_exc(34, "too many indices for array: array is " || nd || "-dimensional, but " || real || " were indexed")
  ax = 0
  do i = 1 to nit
    if npit[i] = 8 then do
      do k = 1 to nd - real
        ax = ax + 1
        npax[ax] = 0
      end
    end
    else if npit[i] = 2 then npnb[ax + 1] = npnb[ax + 1] + 1
    else do
      ax = ax + 1
      npax[ax] = npit[i]
    end
  end
  do while ax < nd
    ax = ax + 1
    npax[ax] = 0
  end
  tq = 0
  do d = 1 to nd
    dimn = sl[ob_y[ia] + d - 1]
    v = npax[d]
    npco[d] = tq + 1
    npcd[d] = 0
    kv = 0
    if v \= 0 then kv = kind_of(v)
    if v = 0 then do
      do c = 0 to dimn - 1
        npcat[tq + 1 + c] = c
      end
      npcc[d] = dimn
      tq = tq + dimn
    end
    else if numkind(v) = 1 then do
      w = ival(v)
      m = w
      if w < 0 then w = w + dimn
      if w < 0 | w >= dimn then return raise_exc(34, "index " || m || " is out of bounds for axis " || (d - 1) || " with size " || dimn)
      npcat[tq + 1] = w
      npcc[d] = 1
      npcd[d] = 1
      tq = tq + 1
    end
    else if kv = 21 then do
      r = slice_calc(dimn, ob_n[v % 2], ob_x[v % 2], ob_y[v % 2])
      if r = 0 then return 0
      w = sl_a
      do c = 0 to sl_n - 1
        npcat[tq + 1 + c] = w
        w = w + sl_b
      end
      npcc[d] = sl_n
      tq = tq + sl_n
    end
    else if kv = 29 then do
      if ob_c[v % 2] = 3 then do
        if ob_x[v % 2] \= 1 | ob_n[v % 2] \= dimn then return raise_exc(34, "boolean index did not match indexed array along axis " || (d - 1) || "; size of axis is " || dimn || " but size of corresponding boolean axis is " || ob_n[v % 2])
        n = 0
        do c = 0 to dimn - 1
          if sl[ob_p[v % 2] + c] \= 0 then do
            npcat[tq + 1 + n] = c
            n = n + 1
          end
        end
        npcc[d] = n
        tq = tq + n
      end
      else do
        if ob_c[v % 2] = 2 then return raise_exc(34, "arrays used as indices must be of integer (or boolean) type")
        if ob_x[v % 2] \= 1 then return raise_exc(34, "only one-dimensional index arrays are supported")
        n = ob_n[v % 2]
        do c = 0 to n - 1
          w = sl[ob_p[v % 2] + c]
          m = w
          if w < 0 then w = w + dimn
          if w < 0 | w >= dimn then return raise_exc(34, "index " || m || " is out of bounds for axis " || (d - 1) || " with size " || dimn)
          npcat[tq + 1 + c] = w
        end
        npcc[d] = n
        tq = tq + n
      end
    end
    else if kv = 7 | kv = 8 then do
      n = ob_n[v % 2]
      do c = 0 to n - 1
        e = sl[ob_p[v % 2] + c]
        if numkind(e) \= 1 then return raise_exc(34, "arrays used as indices must be of integer (or boolean) type")
        w = ival(e)
        m = w
        if w < 0 then w = w + dimn
        if w < 0 | w >= dimn then return raise_exc(34, "index " || m || " is out of bounds for axis " || (d - 1) || " with size " || dimn)
        npcat[tq + 1 + c] = w
      end
      npcc[d] = n
      tq = tq + n
    end
    else return raise_exc(34, "only integers, slices (`:`), ellipsis (`...`), numpy.newaxis (`None`) and integer or boolean arrays are valid indices")
  end
  call np_sel_build a
  return 1

/* boolean mask of the same shape as a: selects the flat positions */
np_maskplan: procedure = .int
  arg a = .int, m = .int
  ia = .int
  im = .int
  d = .int
  same = .int
  i = .int
  n = .int
  ia = a % 2
  im = m % 2
  same = 0
  if ob_x[im] = ob_x[ia] & ob_x[ia] >= 1 then do
    same = 1
    do d = 0 to ob_x[ia] - 1
      if sl[ob_y[ia] + d] \= sl[ob_y[im] + d] then same = 0
    end
  end
  if same = 0 then return np_plan(a, m)
  n = 0
  do i = 0 to ob_n[ia] - 1
    if sl[ob_p[im] + i] \= 0 then do
      n = n + 1
      npsel[n] = i
    end
  end
  np_sc = n
  nprn = 1
  nprs[1] = n
  return 1

np_gather: procedure = .int
  arg a = .int
  ia = .int
  ir = .int
  r = .int
  i = .int
  pa = .int
  pr = .int
  ia = a % 2
  r = np_new(ob_c[ia], nprn, np_sc)
  ir = r % 2
  call np_shape_from_scratch r
  pa = ob_p[ia]
  pr = ob_p[ir]
  if ob_c[ia] = 2 then do
    do i = 1 to np_sc
      npf[pr + i - 1] = npf[pa + npsel[i]]
    end
  end
  else do
    do i = 1 to np_sc
      sl[pr + i - 1] = sl[pa + npsel[i]]
    end
  end
  return r

np_getitem: procedure = .int
  arg a = .int, ix = .int
  ia = .int
  i = .int
  n = .int
  ok = .int
  ia = a % 2
  if ix // 2 \= 0 & ob_x[ia] = 1 then do
    i = (ix - 1) % 2
    n = sl[ob_y[ia]]
    if i < 0 then i = i + n
    if i < 0 | i >= n then return raise_exc(34, "index " || ((ix - 1) % 2) || " is out of bounds for axis 0 with size " || n)
    return np_scalar(a, i)
  end
  if ix // 2 \= 0 & ob_x[ia] >= 2 then do
    i = (ix - 1) % 2
    n = sl[ob_y[ia]]
    if i < 0 then i = i + n
    if i < 0 | i >= n then return raise_exc(34, "index " || ((ix - 1) % 2) || " is out of bounds for axis 0 with size " || n)
    return np_mkview(a, i, 1, 1)
  end
  if kind_of(ix) = 21 & ob_x[ia] >= 1 then do
    ok = slice_calc(sl[ob_y[ia]], ob_n[ix % 2], ob_x[ix % 2], ob_y[ix % 2])
    if ok = 0 then return 0
    if sl_b = 1 then return np_mkview(a, sl_a, sl_n, 0)
  end
  if kind_of(ix) = 29 then do
    if ob_c[ix % 2] = 3 then ok = np_maskplan(a, ix)
    else ok = np_plan(a, ix)
  end
  else ok = np_plan(a, ix)
  if ok = 0 then return 0
  if nprn = 0 then return np_scalar(a, npsel[1])
  return np_gather(a)

np_setitem: procedure = .void
  arg a = .int, ix = .int, v = .int
  ia = .int
  iv = .int
  vv = .int
  ok = .int
  mode = .int
  i = .int
  j = .int
  d = .int
  jj = .int
  r = .int
  ia = a % 2
  if kind_of(ix) = 29 then do
    if ob_c[ix % 2] = 3 then ok = np_maskplan(a, ix)
    else ok = np_plan(a, ix)
  end
  else ok = np_plan(a, ix)
  if ok = 0 then return
  vv = np_coerce(v)
  if vv = 0 then return
  if vv = v & ob_n[vv % 2] > 1 then vv = np_cast(vv, ob_c[vv % 2])
  iv = vv % 2
  if ob_n[iv] = 1 then mode = 1
  else do
    mode = 2
    if ob_x[iv] <= nprn then do
      do d = 1 to ob_x[iv]
        jj = nprn - ob_x[iv] + d
        if sl[ob_y[iv] + d - 1] \= nprs[jj] & sl[ob_y[iv] + d - 1] \= 1 then do
          r = raise_exc(36, "could not broadcast input array from shape " || np_shape_str(vv) || " into shape (" || nprs[1] || ")")
          return
        end
      end
      call np_btab vv, 1
    end
    else do
      if ob_n[iv] \= np_sc then do
        r = raise_exc(36, "could not broadcast input array from shape " || np_shape_str(vv) || " into shape (" || nprs[1] || ")")
        return
      end
      mode = 0
    end
  end
  do i = 1 to np_sc
    if mode = 1 then j = 0
    else if mode = 0 then j = i - 1
    else j = npta[i]
    call np_copyel a, npsel[i], vv, j
  end
  return

/* ---- shapes and dimension arguments ---- */
/* dimensions given as an int, a tuple/list of ints or several ints at ast[base+first ..] -> nts[1..ntnd] */
np_dims: procedure = .int
  arg base = .int, first = .int, cnt = .int
  v = .int
  i = .int
  n = .int
  e = .int
  ntnd = 0
  if cnt = 1 then do
    v = ast[base + first]
    if kind_of(v) = 8 | kind_of(v) = 7 then do
      n = ob_n[v % 2]
      do i = 0 to n - 1
        e = sl[ob_p[v % 2] + i]
        if numkind(e) \= 1 then return raise_exc(38, "'" || type_name(e) || "' object cannot be interpreted as an integer")
        ntnd = ntnd + 1
        nts[ntnd] = ival(e)
      end
      return 1
    end
  end
  do i = 0 to cnt - 1
    e = ast[base + first + i]
    if numkind(e) \= 1 then return raise_exc(38, "'" || type_name(e) || "' object cannot be interpreted as an integer")
    ntnd = ntnd + 1
    nts[ntnd] = ival(e)
  end
  return 1

/* new array with the shape nts[1..ntnd], filled with fi (int / bool) or ff (float) */
np_make: procedure = .int
  arg dt = .int, fi = .int, ff = .float
  total = .int
  d = .int
  r = .int
  ir = .int
  j = .int
  total = 1
  do d = 1 to ntnd
    if nts[d] < 0 then return raise_exc(36, "negative dimensions are not allowed")
    total = total * nts[d]
  end
  r = np_new(dt, ntnd, total)
  ir = r % 2
  do d = 1 to ntnd
    sl[ob_y[ir] + d - 1] = nts[d]
  end
  if dt = 2 then do
    if ff \= 0.0 then do
      do j = 0 to total - 1
        npf[ob_p[ir] + j] = ff
      end
    end
  end
  else do
    if fi \= 0 then do
      do j = 0 to total - 1
        sl[ob_p[ir] + j] = fi
      end
    end
  end
  return r

np_dtype_of: procedure = .int
  arg v = .int
  k = .int
  s = .string
  k = kind_of(v)
  if k = 16 then do
    if ob_x[v % 2] = 85 then do
      npcx_d = 1
      return 2
    end
    if ob_x[v % 2] = 4 then return 2
    if ob_x[v % 2] = 3 then return 1
    if ob_x[v % 2] = 5 then return 3
  end
  if k = 6 then do
    s = ob_s[v % 2]
    if left(s, 7) == "complex" | s == "c16" | s == "D" then do
      npcx_d = 1
      return 2
    end
    if left(s, 5) == "float" | s == "f8" | s == "double" then return 2
    if left(s, 3) == "int" | s == "i8" | s == "long" then return 1
    if left(s, 4) == "bool" | s == "?" then return 3
  end
  call raise_exc 38, "data type not understood"
  return 0

/* ---------------------------------------------------------------------
   numpy subset, part 2: reductions, sorting, joining, printing, methods and module functions
   --------------------------------------------------------------------- */
/* outer / n / inner split of the array a along the axis (np_outer, np_n, np_inner, np_axn) */
np_lanes: procedure = .int
  arg a = .int, hasax = .int, axis = .int
  ia = .int
  nd = .int
  axn = .int
  d = .int
  ia = a % 2
  nd = ob_x[ia]
  np_outer = 1
  np_inner = 1
  np_n = ob_n[ia]
  np_axn = 0
  if hasax = 0 then return 1
  axn = axis
  if axn < 0 then axn = axn + nd
  if axn < 0 | axn >= nd then return raise_exc(96, "axis " || axis || " is out of bounds for array of dimension " || nd)
  np_axn = axn
  np_n = sl[ob_y[ia] + axn]
  do d = 0 to axn - 1
    np_outer = np_outer * sl[ob_y[ia] + d]
  end
  do d = axn + 1 to nd - 1
    np_inner = np_inner * sl[ob_y[ia] + d]
  end
  return 1

/* numpy's pairwise summation of npfl[st .. st+n-1] */
np_pw2: procedure = .float
  arg st = .int, n = .int
  r0 = .float
  r1 = .float
  r2 = .float
  r3 = .float
  r4 = .float
  r5 = .float
  r6 = .float
  r7 = .float
  res = .float
  i = .int
  n2 = .int
  lim = .int
  if n < 8 then do
    res = 0.0
    do i = 0 to n - 1
      res = res + npfl[st + i]
    end
    return res
  end
  if n <= 128 then do
    r0 = npfl[st]
    r1 = npfl[st + 1]
    r2 = npfl[st + 2]
    r3 = npfl[st + 3]
    r4 = npfl[st + 4]
    r5 = npfl[st + 5]
    r6 = npfl[st + 6]
    r7 = npfl[st + 7]
    lim = n - (n // 8)
    i = 8
    do while i < lim
      r0 = r0 + npfl[st + i]
      r1 = r1 + npfl[st + i + 1]
      r2 = r2 + npfl[st + i + 2]
      r3 = r3 + npfl[st + i + 3]
      r4 = r4 + npfl[st + i + 4]
      r5 = r5 + npfl[st + i + 5]
      r6 = r6 + npfl[st + i + 6]
      r7 = r7 + npfl[st + i + 7]
      i = i + 8
    end
    res = ((r0 + r1) + (r2 + r3)) + ((r4 + r5) + (r6 + r7))
    do while i < n
      res = res + npfl[st + i]
      i = i + 1
    end
    return res
  end
  n2 = n % 2
  n2 = n2 - (n2 // 8)
  return np_pw2(st, n2) + np_pw2(st + n2, n - n2)

np_sumlane: procedure = .float
  arg n = .int, inner = .int
  s = .float
  k = .int
  if inner = 1 then return np_pw2(1, n)
  s = 0.0
  do k = 1 to n
    s = s + npfl[k]
  end
  return s

/* kinds: 1 sum 2 mean 3 min 4 max 5 prod 6 argmax 7 argmin 8 cumsum 9 any 10 all 11 std 12 var */
np_reduce: procedure = .int
  arg a = .int, kind = .int, hasax = .int, axis = .int
  ia = .int
  ir = .int
  r = .int
  nd = .int
  dt = .int
  sz = .int
  p = .int
  outer = .int
  n = .int
  inner = .int
  o = .int
  i = .int
  k = .int
  b0 = .int
  rd = .int
  rp = .int
  ridx = .int
  ff = .int
  d = .int
  total = .int
  vi = .int
  bi = .int
  si = .int
  s = .float
  m = .float
  t = .float
  ia = a % 2
  nd = ob_x[ia]
  dt = ob_c[ia]
  sz = ob_n[ia]
  p = ob_p[ia]
  if np_lanes(a, hasax, axis) = 0 then return 0
  outer = np_outer
  n = np_n
  inner = np_inner
  if kind = 3 & n = 0 then return raise_exc(36, "zero-size array to reduction operation minimum which has no identity")
  if kind = 4 & n = 0 then return raise_exc(36, "zero-size array to reduction operation maximum which has no identity")
  if (kind = 6 | kind = 7) & n = 0 then return raise_exc(36, "attempt to get argmax of an empty sequence")
  ff = 0
  if dt = 2 | kind = 2 | kind = 11 | kind = 12 then ff = 1
  rd = 1
  select
    when kind = 1 | kind = 5 | kind = 8 then do
      if dt = 2 then rd = 2
      else rd = 1
    end
    when kind = 2 | kind = 11 | kind = 12 then rd = 2
    when kind = 3 | kind = 4 then rd = dt
    when kind = 9 | kind = 10 then rd = 3
    otherwise rd = 1
  end
  nprn = 0
  if kind = 8 then do
    if hasax = 0 then do
      nprn = 1
      nprs[1] = sz
    end
    else do
      nprn = nd
      do d = 1 to nd
        nprs[d] = sl[ob_y[ia] + d - 1]
      end
    end
  end
  else if hasax = 1 then do
    do d = 0 to nd - 1
      if d \= np_axn then do
        nprn = nprn + 1
        nprs[nprn] = sl[ob_y[ia] + d]
      end
    end
  end
  total = outer * inner
  if kind = 8 then total = sz
  r = np_new(rd, nprn, total)
  ir = r % 2
  call np_shape_from_scratch r
  rp = ob_p[ir]
  do o = 0 to outer - 1
    do i = 0 to inner - 1
      b0 = o * n * inner + i
      ridx = o * inner + i
      if ff = 1 then do
        do k = 0 to n - 1
          if dt = 2 then npfl[k + 1] = npf[p + b0 + k * inner]
          else do
            vi = sl[p + b0 + k * inner]
            npfl[k + 1] = vi as .float
          end
        end
      end
      else do
        do k = 0 to n - 1
          npil[k + 1] = sl[p + b0 + k * inner]
        end
      end
      select
        when kind = 1 then do
          if rd = 2 then npf[rp + ridx] = np_sumlane(n, inner)
          else do
            si = 0
            do k = 1 to n
              si = si + npil[k]
            end
            sl[rp + ridx] = si
          end
        end
        when kind = 2 then do
          if n = 0 then npf[rp + ridx] = f_nan()
          else npf[rp + ridx] = np_sumlane(n, inner) / (n as .float)
        end
        when kind = 3 | kind = 4 then do
          if ff = 1 then do
            m = npfl[1]
            do k = 2 to n
              t = npfl[k]
              if t \= t then m = t
              else if m = m then do
                if kind = 3 & t < m then m = t
                if kind = 4 & t > m then m = t
              end
            end
            npf[rp + ridx] = m
          end
          else do
            bi = npil[1]
            do k = 2 to n
              if kind = 3 & npil[k] < bi then bi = npil[k]
              if kind = 4 & npil[k] > bi then bi = npil[k]
            end
            sl[rp + ridx] = bi
          end
        end
        when kind = 5 then do
          if rd = 2 then do
            m = 1.0
            do k = 1 to n
              m = m * npfl[k]
            end
            npf[rp + ridx] = m
          end
          else do
            si = 1
            do k = 1 to n
              si = si * npil[k]
            end
            sl[rp + ridx] = si
          end
        end
        when kind = 6 | kind = 7 then do
          bi = 0
          if ff = 1 then do
            m = npfl[1]
            do k = 2 to n
              t = npfl[k]
              if kind = 6 & t > m then do
                m = t
                bi = k - 1
              end
              if kind = 7 & t < m then do
                m = t
                bi = k - 1
              end
            end
          end
          else do
            si = npil[1]
            do k = 2 to n
              if kind = 6 & npil[k] > si then do
                si = npil[k]
                bi = k - 1
              end
              if kind = 7 & npil[k] < si then do
                si = npil[k]
                bi = k - 1
              end
            end
          end
          sl[rp + ridx] = bi
        end
        when kind = 8 then do
          if rd = 2 then do
            s = 0.0
            do k = 1 to n
              s = s + npfl[k]
              npf[rp + b0 + (k - 1) * inner] = s
            end
          end
          else do
            si = 0
            do k = 1 to n
              si = si + npil[k]
              sl[rp + b0 + (k - 1) * inner] = si
            end
          end
        end
        when kind = 9 | kind = 10 then do
          if kind = 9 then bi = 0
          else bi = 1
          do k = 1 to n
            if ff = 1 then vi = 0
            else vi = 0
            if ff = 1 then do
              if npfl[k] \= 0.0 then vi = 1
            end
            else do
              if npil[k] \= 0 then vi = 1
            end
            if kind = 9 & vi = 1 then bi = 1
            if kind = 10 & vi = 0 then bi = 0
          end
          sl[rp + ridx] = bi
        end
        when kind = 11 | kind = 12 then do
          if n - np_ddof <= 0 then npf[rp + ridx] = f_nan()
          else do
            m = np_sumlane(n, inner) / (n as .float)
            do k = 1 to n
              t = npfl[k] - m
              npfl[k] = t * t
            end
            s = np_sumlane(n, inner) / ((n - np_ddof) as .float)
            if kind = 11 then s = rxfloat..sqrt(s)
            npf[rp + ridx] = s
          end
        end
        otherwise nop
      end
    end
  end
  if nprn = 0 then return np_scalar(r, 0)
  return r

/* ---- sorting ---- */
np_shell_f: procedure = .void
  arg n = .int
  gap = .int
  i = .int
  j = .int
  t = .float
  ok = .int
  gap = 1
  do while gap < n % 3
    gap = gap * 3 + 1
  end
  do while gap >= 1
    do i = gap + 1 to n
      t = npfl[i]
      j = i
      ok = 1
      do while ok = 1
        if j <= gap then ok = 0
        else if npfl[j - gap] > t then do
          npfl[j] = npfl[j - gap]
          j = j - gap
        end
        else ok = 0
      end
      npfl[j] = t
    end
    gap = (gap - 1) % 3
  end
  return

np_shell_i: procedure = .void
  arg n = .int
  gap = .int
  i = .int
  j = .int
  t = .int
  ok = .int
  gap = 1
  do while gap < n % 3
    gap = gap * 3 + 1
  end
  do while gap >= 1
    do i = gap + 1 to n
      t = npil[i]
      j = i
      ok = 1
      do while ok = 1
        if j <= gap then ok = 0
        else if npil[j - gap] > t then do
          npil[j] = npil[j - gap]
          j = j - gap
        end
        else ok = 0
      end
      npil[j] = t
    end
    gap = (gap - 1) % 3
  end
  return

/* sorted copy along an axis (hasax = 0: of the flattened array) */
np_sort: procedure = .int
  arg a0 = .int, hasax = .int, axis = .int
  a = .int
  r = .int
  ir = .int
  dt = .int
  outer = .int
  n = .int
  inner = .int
  o = .int
  i = .int
  k = .int
  b0 = .int
  p = .int
  ax = .int
  a = a0
  ax = axis
  if hasax = 0 then do
    a = np_flat(a0)
    ax = 0
  end
  if ob_x[a % 2] = 0 then return np_cast(a, ob_c[a % 2])
  r = np_cast(a, ob_c[a % 2])
  ir = r % 2
  dt = ob_c[ir]
  if np_lanes(r, 1, ax) = 0 then return 0
  outer = np_outer
  n = np_n
  inner = np_inner
  p = ob_p[ir]
  do o = 0 to outer - 1
    do i = 0 to inner - 1
      b0 = o * n * inner + i
      if dt = 2 then do
        do k = 0 to n - 1
          npfl[k + 1] = npf[p + b0 + k * inner]
        end
        call np_shell_f n
        do k = 0 to n - 1
          npf[p + b0 + k * inner] = npfl[k + 1]
        end
      end
      else do
        do k = 0 to n - 1
          npil[k + 1] = sl[p + b0 + k * inner]
        end
        call np_shell_i n
        do k = 0 to n - 1
          sl[p + b0 + k * inner] = npil[k + 1]
        end
      end
    end
  end
  return r

np_unique: procedure = .int
  arg a = .int
  s = .int
  isx = .int
  n = .int
  i = .int
  cnt = .int
  r = .int
  ir = .int
  dt = .int
  s = np_sort(a, 0, 0)
  if s = 0 then return 0
  isx = s % 2
  n = ob_n[isx]
  dt = ob_c[isx]
  cnt = 0
  do i = 0 to n - 1
    if i = 0 then cnt = cnt + 1
    else if dt = 2 then do
      if npf[ob_p[isx] + i] \= npf[ob_p[isx] + i - 1] then cnt = cnt + 1
    end
    else do
      if sl[ob_p[isx] + i] \= sl[ob_p[isx] + i - 1] then cnt = cnt + 1
    end
  end
  r = np_new(dt, 1, cnt)
  ir = r % 2
  sl[ob_y[ir]] = cnt
  cnt = 0
  do i = 0 to n - 1
    if i = 0 then do
      call np_copyel r, 0, s, 0
      cnt = 1
    end
    else if dt = 2 then do
      if npf[ob_p[isx] + i] \= npf[ob_p[isx] + i - 1] then do
        call np_copyel r, cnt, s, i
        cnt = cnt + 1
      end
    end
    else do
      if sl[ob_p[isx] + i] \= sl[ob_p[isx] + i - 1] then do
        call np_copyel r, cnt, s, i
        cnt = cnt + 1
      end
    end
  end
  return r

np_median: procedure = .int
  arg a = .int
  s = .int
  n = .int
  x = .float
  y = .float
  s = np_sort(a, 0, 0)
  if s = 0 then return 0
  n = ob_n[s % 2]
  if n = 0 then return mkfloat(f_nan())
  if n // 2 = 1 then return mkfloat(np_getf(s, n % 2))
  x = np_getf(s, n % 2 - 1)
  y = np_getf(s, n % 2)
  return mkfloat((x + y) / 2.0)

/* ---- joining ---- */
np_promote: procedure = .int
  arg d1 = .int, d2 = .int
  if d1 = 2 | d2 = 2 then return 2
  if d1 = 1 | d2 = 1 then return 1
  return 3

np_concat: procedure = .int
  arg lst = .int, axis = .int
  n = .int
  i = .int
  d = .int
  j = .int
  o = .int
  nd = .int
  ax = .int
  first = .int
  ai = .int
  dt = .int
  totax = .int
  outer = .int
  inner = .int
  r = .int
  ir = .int
  chunk = .int
  pos = .int
  n = ob_n[lst % 2]
  if n = 0 then return raise_exc(36, "need at least one array to concatenate")
  first = sl[ob_p[lst % 2]]
  nd = ob_x[first % 2]
  if nd = 0 then return raise_exc(36, "zero-dimensional arrays cannot be concatenated")
  ax = axis
  if ax < 0 then ax = ax + nd
  if ax < 0 | ax >= nd then return raise_exc(96, "axis " || axis || " is out of bounds for array of dimension " || nd)
  dt = ob_c[first % 2]
  totax = 0
  do i = 0 to n - 1
    ai = sl[ob_p[lst % 2] + i]
    if ob_x[ai % 2] \= nd then return raise_exc(36, "all the input array dimensions except for the concatenation axis must match exactly, but along dimension 0, the array at index 0 has " || nd || " dimension(s) and the array at index " || i || " has " || ob_x[ai % 2] || " dimension(s)")
    do d = 0 to nd - 1
      if d \= ax & sl[ob_y[ai % 2] + d] \= sl[ob_y[first % 2] + d] then return raise_exc(36, "all the input array dimensions except for the concatenation axis must match exactly, but along dimension " || d || ", the array at index 0 has size " || sl[ob_y[first % 2] + d] || " and the array at index " || i || " has size " || sl[ob_y[ai % 2] + d])
    end
    totax = totax + sl[ob_y[ai % 2] + ax]
    dt = np_promote(dt, ob_c[ai % 2])
  end
  outer = 1
  inner = 1
  do d = 0 to ax - 1
    outer = outer * sl[ob_y[first % 2] + d]
  end
  do d = ax + 1 to nd - 1
    inner = inner * sl[ob_y[first % 2] + d]
  end
  nprn = nd
  do d = 0 to nd - 1
    nprs[d + 1] = sl[ob_y[first % 2] + d]
  end
  nprs[ax + 1] = totax
  r = np_new(dt, nd, outer * totax * inner)
  ir = r % 2
  call np_shape_from_scratch r
  pos = 0
  do o = 0 to outer - 1
    do i = 0 to n - 1
      ai = sl[ob_p[lst % 2] + i]
      chunk = sl[ob_y[ai % 2] + ax] * inner
      do j = 0 to chunk - 1
        call np_copyel r, pos, ai, o * chunk + j
        pos = pos + 1
      end
    end
  end
  return r

/* a copy of a with at least minnd dimensions (new axes in front) */
np_atleast: procedure = .int
  arg a = .int, minnd = .int
  nd = .int
  d = .int
  nd = ob_x[a % 2]
  if nd >= minnd then return a
  nprn = minnd
  do d = 1 to minnd - nd
    nprs[d] = 1
  end
  do d = 1 to nd
    nprs[minnd - nd + d] = sl[ob_y[a % 2] + d - 1]
  end
  return np_with_shape(a)

/* list of arrays from an iterable of array-likes, each at least minnd dimensional */
np_array_list: procedure = .int
  arg v = .int, minnd = .int
  l = .int
  res = .int
  i = .int
  e = .int
  l = iter_list(v)
  if l = 0 then return 0
  res = mklist(ob_n[l % 2])
  do i = 0 to ob_n[l % 2] - 1
    e = np_coerce(sl[ob_p[l % 2] + i])
    if e = 0 then return 0
    e = np_atleast(e, minnd)
    call list_append res, e
  end
  return res

np_where3: procedure = .int
  arg c = .int, x = .int, y = .int
  total = .int
  i = .int
  mc = .int
  mx = .int
  my = .int
  jc = .int
  jx = .int
  jy = .int
  r = .int
  ir = .int
  dt = .int
  t = .int
  call np_bs_init c
  if np_bs_merge(c, x) = 0 then return 0
  if np_bs_merge(c, y) = 0 then return 0
  total = 1
  do i = 1 to nprn
    total = total * nprs[i]
  end
  dt = np_promote(ob_c[x % 2], ob_c[y % 2])
  r = np_new(dt, nprn, total)
  ir = r % 2
  call np_shape_from_scratch r
  mc = np_mode(c)
  mx = np_mode(x)
  my = np_mode(y)
  if mc = 2 then call np_btab c, 1
  if mx = 2 then call np_btab x, 2
  if my = 2 then call np_btab y, 3
  do i = 0 to total - 1
    if mc = 0 then jc = i
    else if mc = 1 then jc = 0
    else jc = npta[i + 1]
    t = 0
    if ob_c[c % 2] = 2 then do
      if npf[ob_p[c % 2] + jc] \= 0.0 then t = 1
    end
    else do
      if sl[ob_p[c % 2] + jc] \= 0 then t = 1
    end
    if t = 1 then do
      if mx = 0 then jx = i
      else if mx = 1 then jx = 0
      else jx = nptb[i + 1]
      call np_copyel r, i, x, jx
    end
    else do
      if my = 0 then jy = i
      else if my = 1 then jy = 0
      else jy = nptc[i + 1]
      call np_copyel r, i, y, jy
    end
  end
  return r

/* tuple of index arrays of the non-zero elements */
np_nonzero: procedure = .int
  arg c = .int
  ic = .int
  nd = .int
  n = .int
  i = .int
  cnt = .int
  d = .int
  tmp = .int
  t = .int
  res = .int
  ar = .int
  ok = .int
  dims = .int[]
  ic = c % 2
  nd = ob_x[ic]
  n = ob_n[ic]
  cnt = 0
  do i = 0 to n - 1
    ok = 0
    if ob_c[ic] = 2 then do
      if npf[ob_p[ic] + i] \= 0.0 then ok = 1
    end
    else do
      if sl[ob_p[ic] + i] \= 0 then ok = 1
    end
    if ok = 1 then do
      cnt = cnt + 1
      npsel[cnt] = i
    end
  end
  if nd = 0 then nd = 1
  res = mktuple(nd)
  do d = 1 to nd
    if ob_x[ic] = 0 then dims[d] = 1
    else dims[d] = sl[ob_y[ic] + d - 1]
    ar = np_new(1, 1, cnt)
    sl[ob_y[ar % 2]] = cnt
    sl[ob_p[res % 2] + d - 1] = ar
  end
  do t = 1 to cnt
    tmp = npsel[t]
    do d = nd to 1 by -1
      ar = sl[ob_p[res % 2] + d - 1]
      sl[ob_p[ar % 2] + t - 1] = tmp // dims[d]
      tmp = tmp % dims[d]
    end
  end
  return res

np_eye: procedure = .int
  arg n = .int, m = .int
  r = .int
  i = .int
  ntnd = 2
  nts[1] = n
  nts[2] = m
  r = np_make(2, 0, 0.0)
  if r = 0 then return 0
  do i = 0 to n - 1
    if i < m then npf[ob_p[r % 2] + i * m + i] = 1.0
  end
  return r

np_diag: procedure = .int
  arg a = .int
  ia = .int
  nd = .int
  n = .int
  m = .int
  r = .int
  i = .int
  l = .int
  ia = a % 2
  nd = ob_x[ia]
  if nd = 1 then do
    n = sl[ob_y[ia]]
    ntnd = 2
    nts[1] = n
    nts[2] = n
    r = np_make(ob_c[ia], 0, 0.0)
    do i = 0 to n - 1
      call np_copyel r, i * n + i, a, i
    end
    return r
  end
  if nd = 2 then do
    m = sl[ob_y[ia]]
    n = sl[ob_y[ia] + 1]
    l = m
    if n < l then l = n
    r = np_new(ob_c[ia], 1, l)
    sl[ob_y[r % 2]] = l
    do i = 0 to l - 1
      call np_copyel r, i, a, i * n + i
    end
    return r
  end
  return raise_exc(36, "Input must be 1- or 2-d.")

/* reshape to the dimensions in nts[1..ntnd] (one of them may be -1) */
np_reshape: procedure = .int
  arg a = .int
  size = .int
  d = .int
  neg = .int
  known = .int
  s = .string
  size = ob_n[a % 2]
  neg = 0
  known = 1
  do d = 1 to ntnd
    if nts[d] = -1 then do
      if neg > 0 then return raise_exc(36, "can only specify one unknown dimension")
      neg = d
    end
    else known = known * nts[d]
  end
  s = "("
  do d = 1 to ntnd
    if d > 1 then s = s || ","
    s = s || nts[d]
  end
  if ntnd = 1 then s = s || ","
  s = s || ")"
  if neg > 0 then do
    if known = 0 then return raise_exc(36, "cannot reshape array of size " || size || " into shape " || s)
    if size // known \= 0 then return raise_exc(36, "cannot reshape array of size " || size || " into shape " || s)
    nts[neg] = size % known
  end
  else if known \= size then return raise_exc(36, "cannot reshape array of size " || size || " into shape " || s)
  nprn = ntnd
  do d = 1 to ntnd
    nprs[d] = nts[d]
  end
  return np_with_shape(a)

np_tl: procedure = .int
  arg a = .int, d = .int, off = .int
  ix = .int
  nd = .int
  n = .int
  stride = .int
  j = .int
  l = .int
  ix = a % 2
  nd = ob_x[ix]
  n = sl[ob_y[ix] + d]
  stride = 1
  do j = d + 1 to nd - 1
    stride = stride * sl[ob_y[ix] + j]
  end
  l = mklist(n)
  do j = 0 to n - 1
    if d = nd - 1 then call list_append l, np_scalar(a, off + j)
    else call list_append l, np_tl(a, d + 1, off + j * stride)
  end
  return l

np_tolist: procedure = .int
  arg a = .int
  if ob_x[a % 2] = 0 then return np_scalar(a, 0)
  return np_tl(a, 0, 0)

np_allclose: procedure = .int
  arg a = .int, b = .int, rtol = .float, atol = .float
  total = .int
  i = .int
  ma = .int
  mb = .int
  ja = .int
  jb = .int
  x = .float
  y = .float
  df = .float
  call np_bs_init a
  if np_bs_merge(a, b) = 0 then return 0
  total = 1
  do i = 1 to nprn
    total = total * nprs[i]
  end
  ma = np_mode(a)
  mb = np_mode(b)
  if ma = 2 then call np_btab a, 1
  if mb = 2 then call np_btab b, 2
  do i = 0 to total - 1
    if ma = 0 then ja = i
    else if ma = 1 then ja = 0
    else ja = npta[i + 1]
    if mb = 0 then jb = i
    else if mb = 1 then jb = 0
    else jb = nptb[i + 1]
    x = np_getf(a, ja)
    y = np_getf(b, jb)
    if x \= x | y \= y then return 6
    if x \= y then do
      df = rxfloat..fabs(x - y)
      if finf(x) \= 0 | finf(y) \= 0 then return 6
      if df > atol + rtol * rxfloat..fabs(y) then return 6
    end
  end
  return 4

np_array_equal: procedure = .int
  arg a = .int, b = .int
  ia = .int
  ib = .int
  d = .int
  i = .int
  ia = a % 2
  ib = b % 2
  if ob_x[ia] \= ob_x[ib] then return 6
  do d = 0 to ob_x[ia] - 1
    if sl[ob_y[ia] + d] \= sl[ob_y[ib] + d] then return 6
  end
  do i = 0 to ob_n[ia] - 1
    if ob_c[ia] = 2 | ob_c[ib] = 2 then do
      if np_getf(a, i) \= np_getf(b, i) then return 6
    end
    else do
      if sl[ob_p[ia] + i] \= sl[ob_p[ib] + i] then return 6
    end
  end
  return 4

np_clip: procedure = .int
  arg a = .int, lo = .int, hi = .int
  r = .int
  r = a
  if lo \= 0 & lo \= 2 then do
    r = np_binop(21, r, lo)
    if r = 0 then return 0
  end
  if hi \= 0 & hi \= 2 then do
    r = np_binop(22, r, hi)
    if r = 0 then return 0
  end
  if r = a then return np_cast(a, ob_c[a % 2])
  return r

/* ---- axis / ddof arguments ---- */
np_axisarg: procedure = .int
  arg base = .int, na = .int, nk = .int, pos = .int
  v = .int
  w = .int
  v = 0
  if na >= pos then v = ast[base + pos]
  w = kwarg(base, na, nk, "axis")
  if w \= 0 then v = w
  np_hasax = 0
  np_axv = 0
  np_ddof = 0
  w = kwarg(base, na, nk, "ddof")
  if w \= 0 then np_ddof = ival(w)
  if v \= 0 & v \= 2 then do
    if numkind(v) \= 1 then return raise_exc(38, "'" || type_name(v) || "' object cannot be interpreted as an integer")
    np_hasax = 1
    np_axv = ival(v)
  end
  return 1

np_red_call: procedure = .int
  arg a = .int, kind = .int, base = .int, na = .int, nk = .int, pos = .int
  if np_axisarg(base, na, nk, pos) = 0 then return 0
  return np_reduce(a, kind, np_hasax, np_axv)

/* ---------------------------------------------------------------------
   printing
   --------------------------------------------------------------------- */
np_rstrip: procedure = .string
  arg s = .string
  l = .int
  l = length(s)
  do while l > 0 & substr(s, l, 1) == " "
    l = l - 1
  end
  if l = 0 then return ""
  return left(s, l)

/* shortest digits of the finite f >= 0: np_ds (no trailing zeros), np_de (decimal exponent of the first digit) */
np_digits: procedure = .void
  arg f = .float
  n = .int
  d = .string
  dexp = .int
  y = .float
  ok = .int
  l = .int
  if f = 0.0 then do
    np_ds = "0"
    np_de = 0
    return
  end
  ok = 0
  dexp = 0
  d = ""
  do n = 15 to 17
    d = float_digits(f, n)
    dexp = fx_e
    if n = 17 | dexp < -300 then ok = 1
    else do
      y = (left(d, 1) || "." || substr(d, 2) || "e" || dexp) as .float
      if y = f then ok = 1
    end
    if ok = 1 then leave
  end
  l = length(d)
  do while l > 1 & substr(d, l, 1) == "0"
    l = l - 1
  end
  np_ds = left(d, l)
  np_de = dexp
  return

/* positional format: np_ip (sign and integer digits), np_fp (fraction digits, at most 8) */
np_pos: procedure = .void
  arg f = .float
  af = .float
  neg = .int
  nf = .int
  s = .string
  p = .int
  l = .int
  neg = 0
  af = f
  if f < 0.0 then do
    neg = 1
    af = 0.0 - f
  end
  else if f = 0.0 then do
    if fl_negzero(f) = 1 then neg = 1
  end
  call np_digits af
  nf = length(np_ds) - 1 - np_de
  if nf < 0 then nf = 0
  if nf > 8 then do
    s = float_fixed(af, 8)
    p = pos(".", s)
    np_ip = left(s, p - 1)
    np_fp = substr(s, p + 1)
    l = length(np_fp)
    do while l > 0 & substr(np_fp, l, 1) == "0"
      l = l - 1
    end
    if l = 0 then np_fp = ""
    else np_fp = left(np_fp, l)
  end
  else if np_de >= 0 then do
    if length(np_ds) <= np_de + 1 then do
      np_ip = np_ds || copies("0", np_de + 1 - length(np_ds))
      np_fp = ""
    end
    else do
      np_ip = left(np_ds, np_de + 1)
      np_fp = substr(np_ds, np_de + 2)
    end
  end
  else do
    np_ip = "0"
    np_fp = copies("0", 0 - np_de - 1) || np_ds
  end
  if neg = 1 then np_ip = "-" || np_ip
  return

/* scientific format: np_ip, np_fp (at most 8 digits), np_es ("e+05") */
np_expo: procedure = .void
  arg f = .float
  af = .float
  neg = .int
  ds = .string
  de = .int
  d9 = .string
  l = .int
  es = .string
  ee = .string
  neg = 0
  af = f
  if f < 0.0 then do
    neg = 1
    af = 0.0 - f
  end
  else if f = 0.0 then do
    if fl_negzero(f) = 1 then neg = 1
  end
  call np_digits af
  ds = np_ds
  de = np_de
  if length(ds) > 9 then do
    d9 = float_digits(af, 9)
    de = fx_e
    l = length(d9)
    do while l > 1 & substr(d9, l, 1) == "0"
      l = l - 1
    end
    ds = left(d9, l)
  end
  np_ip = left(ds, 1)
  np_fp = substr(ds, 2)
  if neg = 1 then np_ip = "-" || np_ip
  if de < 0 then es = "-"
  else es = "+"
  ee = abs(de) as .string
  if length(ee) < 2 then ee = "0" || ee
  np_es = "e" || es || ee
  return

/* format all elements of c into npes[1..size] with numpy's common padding */
np_fmt_all: procedure = .void
  arg c = .int
  ic = .int
  n = .int
  dt = .int
  p = .int
  i = .int
  v = .int
  w = .int
  s = .string
  f = .float
  af = .float
  maxv = .float
  minv = .float
  hasnz = .int
  expf = .int
  padl = .int
  padr = .int
  nfl = .int
  wnf = .int
  fr = .string
  ic = c % 2
  n = ob_n[ic]
  dt = ob_c[ic]
  p = ob_p[ic]
  if dt = 3 then do
    do i = 1 to n
      if sl[p + i - 1] \= 0 then npes[i] = " True"
      else npes[i] = "False"
    end
    return
  end
  if dt = 1 then do
    w = 0
    do i = 1 to n
      v = sl[p + i - 1]
      s = v as .string
      npes[i] = s
      if length(s) > w then w = length(s)
    end
    do i = 1 to n
      npes[i] = right(npes[i], w)
    end
    return
  end
  hasnz = 0
  maxv = 0.0
  minv = 0.0
  do i = 1 to n
    f = npf[p + i - 1]
    if f \= f then iterate
    if finf(f) \= 0 then iterate
    af = rxfloat..fabs(f)
    if af \= 0.0 then do
      if hasnz = 0 then do
        maxv = af
        minv = af
        hasnz = 1
      end
      else do
        if af > maxv then maxv = af
        if af < minv then minv = af
      end
    end
  end
  expf = 0
  if hasnz = 1 then do
    if maxv >= 100000000.0 then expf = 1
    else if minv < 0.0001 then expf = 1
    else if maxv / minv > 1000.0 then expf = 1
  end
  padl = 0
  padr = 0
  nfl = 0
  do i = 1 to n
    f = npf[p + i - 1]
    npnf[i] = 0
    if f \= f then do
      npnf[i] = 1
      npip[i] = "nan"
      if nfl < 3 then nfl = 3
      iterate
    end
    if finf(f) = 1 then do
      npnf[i] = 1
      npip[i] = "inf"
      if nfl < 3 then nfl = 3
      iterate
    end
    if finf(f) = 2 then do
      npnf[i] = 1
      npip[i] = "-inf"
      if nfl < 4 then nfl = 4
      iterate
    end
    if expf = 1 then call np_expo f
    else do
      call np_pos f
      np_es = ""
    end
    npip[i] = np_ip
    npfp[i] = np_fp
    npxp[i] = np_es
    if length(np_ip) > padl then padl = length(np_ip)
    if length(np_fp) > padr then padr = length(np_fp)
  end
  if expf = 1 then do
    if nfl - padr - 5 > padl then padl = nfl - padr - 5
  end
  else if nfl - padr - 1 > padl then padl = nfl - padr - 1
  wnf = padl + 1 + padr
  if expf = 1 then wnf = wnf + 4
  do i = 1 to n
    if npnf[i] = 1 then npes[i] = right(npip[i], wnf)
    else do
      fr = npfp[i]
      if padr = 0 then fr = ""
      else if expf = 1 then fr = left(fr, padr, "0")
      else fr = left(fr, padr)
      npes[i] = right(npip[i], padl) || "." || fr || npxp[i]
    end
  end
  return

/* the nested layout of numpy's array2string (axis is 1-based, off the flat offset of the sub-array) */
np_lay: procedure = .string
  arg axis = .int, off = .int, hang = .string, curw = .int
  axl = .int
  cnt = .int
  nxt = .string
  nextw = .int
  stride = .int
  s = .string
  line = .string
  word = .string
  elemw = .int
  j = .int
  linesep = .string
  nested = .string
  axl = npnd - axis + 1
  cnt = npls[axis]
  nxt = hang || " "
  nextw = curw - 1
  stride = npstr[axis]
  elemw = curw - 1
  s = ""
  if axl = 1 then do
    line = hang
    do j = 0 to cnt - 1
      if npsm[axis] = 1 & j = 3 then do
        word = "..."
        if length(line) + length(word) > elemw & length(line) > length(hang) then do
          s = s || np_rstrip(line) || '0a'x
          line = hang
        end
        line = line || word || np_sep
      end
      word = npes[off + j * stride + 1]
      if length(line) + length(word) > elemw & length(line) > length(hang) then do
        s = s || np_rstrip(line) || '0a'x
        line = hang
      end
      line = line || word
      if j < cnt - 1 then line = line || np_sep
    end
    s = s || line
  end
  else do
    linesep = np_rstrip(np_sep) || copies('0a'x, axl - 1)
    do j = 0 to cnt - 1
      if npsm[axis] = 1 & j = 3 then s = s || hang || "..." || linesep
      nested = np_lay(axis + 1, off + j * stride, nxt, nextw)
      s = s || hang || nested
      if j < cnt - 1 then s = s || linesep
    end
  end
  return "[" || substr(s, length(hang) + 1) || "]"

/* the array with at most 3 leading and trailing items per long axis; marks them in npsm */
np_condense: procedure = .int
  arg a = .int
  ia = .int
  nd = .int
  d = .int
  dimn = .int
  tq = .int
  c = .int
  ia = a % 2
  nd = ob_x[ia]
  tq = 0
  do d = 1 to nd + 1
    npnb[d] = 0
  end
  do d = 1 to nd
    dimn = sl[ob_y[ia] + d - 1]
    npco[d] = tq + 1
    npcd[d] = 0
    if dimn > 6 then do
      npsm[d] = 1
      npcat[tq + 1] = 0
      npcat[tq + 2] = 1
      npcat[tq + 3] = 2
      npcat[tq + 4] = dimn - 3
      npcat[tq + 5] = dimn - 2
      npcat[tq + 6] = dimn - 1
      npcc[d] = 6
      tq = tq + 6
    end
    else do
      do c = 0 to dimn - 1
        npcat[tq + 1 + c] = c
      end
      npcc[d] = dimn
      tq = tq + dimn
    end
  end
  call np_sel_build a
  return np_gather(a)

np_str_core: procedure = .string
  arg a = .int, sepv = .string, hang = .string, w = .int
  c = .int
  ic = .int
  ia = .int
  nd = .int
  d = .int
  st = .int
  ia = a % 2
  nd = ob_x[ia]
  if ob_n[ia] = 0 then return "[]"
  np_sep = sepv
  npnd = nd
  do d = 1 to nd
    npsm[d] = 0
  end
  c = a
  if ob_n[ia] > 1000 then c = np_condense(a)
  call np_fmt_all c
  ic = c % 2
  st = 1
  do d = nd to 1 by -1
    npls[d] = sl[ob_y[ic] + d - 1]
    npstr[d] = st
    st = st * npls[d]
  end
  return np_lay(1, 0, hang, w)

np_str: procedure = .string
  arg a = .int
  if ob_x[a % 2] = 0 then return repr_of(np_scalar(a, 0))
  return np_str_core(a, " ", " ", 75)

np_repr: procedure = .string
  arg a = .int
  if ob_x[a % 2] = 0 then return "array(" || repr_of(np_scalar(a, 0)) || ")"
  if ob_n[a % 2] = 0 then return "array([], dtype=" || np_dtname(ob_c[a % 2]) || ")"
  return "array(" || np_str_core(a, ", ", copies(" ", 7), 74) || ")"

/* ---------------------------------------------------------------------
   methods of ndarray
   --------------------------------------------------------------------- */
np_attr: procedure = .int
  arg o = .int, nid = .int
  r = .int
  if nid = 104 then return np_shape_tuple(o)
  if nid = 76 then return mkint(ob_x[o % 2])
  if nid = 105 then return mkint(ob_n[o % 2])
  if nid = 28 then do
    r = cx_call1_in("numpy._dt", "_dt", mkstr(np_dtname(ob_c[o % 2])))
    if r = 0 then return 0
    return r
  end
  if nid = np_nidT then return np_transpose(o)
  if nid = 87 then return o
  return 0

meth_arr: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  dt = .int
  w = .int
  r = .int
  i = .int
  s = .int
  v = .int
  select
    when nid = 120 then return np_tolist(o)
    when nid = 19 then return np_cast(o, ob_c[o % 2])
    when nid = 92 then do
      if na = 0 then return nargs_err("reshape", 0, 1, 1)
      if np_dims(base, 1, na) = 0 then return 0
      return np_reshape(o)
    end
    when nid = 35 | nid = 83 then return np_flat(o)
    when nid = 9 then do
      if na < 1 then return nargs_err("astype", na, 1, 1)
      npcx_d = 0
      dt = np_dtype_of(ast[base + 1])
      if dt = 0 then return 0
      if npcx_d = 1 then do
        npcx_d = 0
        return cx_call1("_from_real", np_cast(o, 2))
      end
      return np_cast(o, dt)
    end
    when nid = 115 then return np_red_call(o, 1, base, na, nk, 1)
    when nid = 72 then return np_red_call(o, 2, base, na, nk, 1)
    when nid = 73 then return np_red_call(o, 3, base, na, nk, 1)
    when nid = 71 then return np_red_call(o, 4, base, na, nk, 1)
    when nid = 82 then return np_red_call(o, 5, base, na, nk, 1)
    when nid = 6 then return np_red_call(o, 6, base, na, nk, 1)
    when nid = 7 then return np_red_call(o, 7, base, na, nk, 1)
    when nid = 21 then return np_red_call(o, 8, base, na, nk, 1)
    when nid = 3 then return np_red_call(o, 9, base, na, nk, 1)
    when nid = 2 then return np_red_call(o, 10, base, na, nk, 1)
    when nid = 111 then return np_red_call(o, 11, base, na, nk, 1)
    when nid = 129 then return np_red_call(o, 12, base, na, nk, 1)
    when nid = 97 then do
      w = 0
      if na >= 1 then w = ival(ast[base + 1])
      v = kwarg(base, na, nk, "decimals")
      if v \= 0 then w = ival(v)
      return np_round_arr(o, w)
    end
    when nid = 27 then do
      if na < 1 then return nargs_err("dot", na, 1, 1)
      r = np_coerce(ast[base + 1])
      if r = 0 then return 0
      return np_dot(o, r)
    end
    when nid = 15 then do
      if na < 1 then return nargs_err("clip", na, 1, 2)
      if na >= 2 then return np_clip(o, ast[base + 1], ast[base + 2])
      return np_clip(o, ast[base + 1], 0)
    end
    when nid = 123 then return np_transpose(o)
    when nid = 106 then do
      r = np_sort(o, 1, -1)
      if r = 0 then return 0
      do i = 0 to ob_n[o % 2] - 1
        call np_copyel o, i, r, i
      end
      return 2
    end
    when nid = 33 then do
      if na < 1 then return nargs_err("fill", na, 1, 1)
      r = np_coerce(ast[base + 1])
      if r = 0 then return 0
      do i = 0 to ob_n[o % 2] - 1
        call np_copyel o, i, r, 0
      end
      return 2
    end
    when nid = 64 then do
      if ob_n[o % 2] \= 1 then return raise_exc(36, "can only convert an array of size 1 to a Python scalar")
      return np_scalar(o, 0)
    end
    otherwise nop
  end
  return meth_common(o, nid, base, na, nk)

/* ---------------------------------------------------------------------
   module functions
   --------------------------------------------------------------------- */
np_dt_arg: procedure = .int
  arg base = .int, na = .int, nk = .int, pos = .int, dflt = .int
  w = .int
  w = kwarg(base, na, nk, "dtype")
  if w = 0 & na >= pos then w = ast[base + pos]
  if w = 0 | w = 2 then return dflt
  return np_dtype_of(w)

bcall_np: procedure = .int
  arg bid = .int, base = .int, na = .int, nk = .int
  a = .int
  b = .int
  r = .int
  v = .int
  w = .int
  i = .int
  j = .int
  n = .int
  dt = .int
  c = .int
  fi = .int
  x = .float
  y = .float
  z = .float
  stp = .float
  rtl = .float
  atl = .float
  l = .int
  isf = .int
  if bid \= 136 & bid \= 137 then do
    do i = 1 to na
      if is_cx(ast[base + i]) = 1 then return cx_dispatch(bid, base, na, nk)
    end
  end
  else if na >= 1 then do
    if is_carr(ast[base + 1]) = 1 then return cx_dispatch(bid, base, na, nk)
  end
  select
    when bid = 136 | bid = 137 then do
      if na < 1 then return nargs_err("array", na, 1, 2)
      v = ast[base + 1]
      if bid = 137 & kind_of(v) = 29 then r = v
      else if kind_of(v) = 29 then r = np_cast(v, ob_c[v % 2])
      else r = np_from_obj(v)
      if r = 0 then return 0
      npcx_d = 0
      dt = np_dt_arg(base, na, nk, 2, -1)
      if dt = 0 then return 0
      if dt > 0 then r = np_cast(r, dt)
      if npcx_d = 1 then do
        npcx_d = 0
        return cx_call1("_from_real", r)
      end
      return r
    end
    when bid = 138 | bid = 139 | bid = 140 then do
      if na < 1 then return nargs_err("zeros", na, 1, 2)
      if np_dims(base, 1, 1) = 0 then return 0
      npcx_d = 0
      dt = np_dt_arg(base, na, nk, 2, 2)
      if dt = 0 then return 0
      fi = 0
      z = 0.0
      if bid = 139 then do
        fi = 1
        z = 1.0
      end
      r = np_make(dt, fi, z)
      if npcx_d = 1 & r \= 0 then do
        npcx_d = 0
        return cx_call1("_from_real", r)
      end
      return r
    end
    when bid = 141 then do
      if na < 2 then return nargs_err("full", na, 2, 3)
      if np_dims(base, 1, 1) = 0 then return 0
      v = ast[base + 2]
      if numkind(v) = 0 then return raise_exc(38, "full() fill value must be a number")
      dt = 1
      if numkind(v) >= 2 then dt = 2
      else if kind_of(v) = 2 then dt = 3
      w = np_dt_arg(base, na, nk, 3, -1)
      if w = 0 then return 0
      if w > 0 then dt = w
      fi = 0
      z = 0.0
      if numkind(v) >= 2 then do
        z = tofloat(v)
        if dt \= 2 then do
          fi = np_f2i(z)
          if dt = 3 & z \= 0.0 then fi = 1
        end
      end
      else do
        fi = ival(v)
        z = fi as .float
      end
      if dt = 3 & fi \= 0 then fi = 1
      return np_make(dt, fi, z)
    end
    when bid = 142 | bid = 143 | bid = 144 then do
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      ntnd = ob_x[a % 2]
      do i = 1 to ntnd
        nts[i] = sl[ob_y[a % 2] + i - 1]
      end
      dt = ob_c[a % 2]
      fi = 0
      z = 0.0
      if bid = 143 then do
        fi = 1
        z = 1.0
      end
      if bid = 144 then do
        v = ast[base + 2]
        if numkind(v) >= 2 then do
          z = tofloat(v)
          fi = np_f2i(z)
        end
        else do
          fi = ival(v)
          z = fi as .float
        end
      end
      if dt = 3 & fi \= 0 then fi = 1
      return np_make(dt, fi, z)
    end
    when bid = 145 | bid = 146 then do
      if numkind(ast[base + 1]) \= 1 then return raise_exc(38, "'" || type_name(ast[base + 1]) || "' object cannot be interpreted as an integer")
      n = ival(ast[base + 1])
      j = n
      if na >= 2 & bid = 145 then do
        if ast[base + 2] \= 2 then j = ival(ast[base + 2])
      end
      return np_eye(n, j)
    end
    when bid = 147 then do
      if na < 1 then return nargs_err("arange", na, 1, 3)
      isf = 0
      do i = 1 to na
        if numkind(ast[base + i]) = 0 then return raise_exc(38, "unsupported operand type for arange: '" || type_name(ast[base + i]) || "'")
        if numkind(ast[base + i]) >= 2 then isf = 1
      end
      if na = 1 then do
        x = 0.0
        y = tofloat(ast[base + 1])
        stp = 1.0
      end
      else do
        x = tofloat(ast[base + 1])
        y = tofloat(ast[base + 2])
        stp = 1.0
        if na >= 3 then stp = tofloat(ast[base + 3])
      end
      if stp = 0.0 then return raise_exc(30, "division by zero")
      if isf = 0 then do
        w = 0
        if na >= 2 then w = ival(ast[base + 1])
        if na = 1 then n = ival(ast[base + 1])
        else n = ival(ast[base + 2])
        c = 1
        if na >= 3 then c = ival(ast[base + 3])
        if c > 0 then do
          if n > w then j = (n - w + c - 1) % c
          else j = 0
        end
        else do
          if w > n then j = (w - n - c - 1) % (0 - c)
          else j = 0
        end
        r = np_new(1, 1, j)
        sl[ob_y[r % 2]] = j
        do i = 0 to j - 1
          sl[ob_p[r % 2] + i] = w + i * c
        end
      end
      else do
        z = rxfloat..ceil((y - x) / stp)
        if z <= 0.0 then j = 0
        else j = np_f2i(z)
        r = np_new(2, 1, j)
        sl[ob_y[r % 2]] = j
        rtl = (x + stp) - x
        do i = 0 to j - 1
          npf[ob_p[r % 2] + i] = x + (i as .float) * rtl
        end
      end
      dt = np_dt_arg(base, na, nk, 99, -1)
      if dt = 0 then return 0
      if dt > 0 then r = np_cast(r, dt)
      return r
    end
    when bid = 148 then do
      if na < 2 then return nargs_err("linspace", na, 2, 3)
      x = mf(ast[base + 1])
      y = mf(ast[base + 2])
      if unw > 0 then return 0
      n = 50
      if na >= 3 then n = ival(ast[base + 3])
      v = kwarg(base, na, nk, "num")
      if v \= 0 then n = ival(v)
      c = 1
      v = kwarg(base, na, nk, "endpoint")
      if v \= 0 then c = truthy(v)
      if n < 0 then return raise_exc(36, "Number of samples, " || n || ", must be non-negative.")
      r = np_new(2, 1, n)
      sl[ob_y[r % 2]] = n
      if c = 1 then j = n - 1
      else j = n
      if j > 0 then do
        stp = (y - x) / (j as .float)
        do i = 0 to n - 1
          npf[ob_p[r % 2] + i] = (i as .float) * stp + x
        end
        if c = 1 then npf[ob_p[r % 2] + n - 1] = y
      end
      else if n = 1 then npf[ob_p[r % 2]] = x
      return r
    end
    when bid = 149 | bid = 150 | bid = 151 | bid = 152 | bid = 153 | bid = 154 | bid = 155 | bid = 156 | bid = 157 | bid = 158 | bid = 159 | bid = 160 | bid = 161 then do
      if na < 1 then return nargs_err("ufunc", na, 1, 1)
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      r = np_math1(bid, a)
      if r = 0 then return 0
      if ob_x[r % 2] = 0 then return np_scalar(r, 0)
      return r
    end
    when bid = 162 then do
      if na = 1 then do
        a = np_coerce(ast[base + 1])
        if a = 0 then return 0
        return np_nonzero(a)
      end
      if na \= 3 then return nargs_err("where", na, 3, 3)
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      b = np_coerce(ast[base + 2])
      if b = 0 then return 0
      c = np_coerce(ast[base + 3])
      if c = 0 then return 0
      return np_where3(a, b, c)
    end
    when bid = 163 then do
      if na < 1 then return nargs_err("concatenate", na, 1, 2)
      l = np_array_list(ast[base + 1], 0)
      if l = 0 then return 0
      w = 0
      if na >= 2 then w = ival(ast[base + 2])
      v = kwarg(base, na, nk, "axis")
      if v \= 0 then w = ival(v)
      return np_concat(l, w)
    end
    when bid = 164 then do
      l = np_array_list(ast[base + 1], 2)
      if l = 0 then return 0
      return np_concat(l, 0)
    end
    when bid = 165 then do
      l = np_array_list(ast[base + 1], 1)
      if l = 0 then return 0
      if ob_n[l % 2] > 0 then do
        if ob_x[sl[ob_p[l % 2]] % 2] = 1 then return np_concat(l, 0)
      end
      return np_concat(l, 1)
    end
    when bid = 166 then do
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      w = -1
      c = 1
      v = 0
      if na >= 2 then v = ast[base + 2]
      if kwarg(base, na, nk, "axis") \= 0 then v = kwarg(base, na, nk, "axis")
      if v = 2 then c = 0
      else if v \= 0 then w = ival(v)
      return np_sort(a, c, w)
    end
    when bid = 167 then do
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      return np_unique(a)
    end
    when bid = 168 | bid = 169 then do
      if na < 2 then return nargs_err("dot", na, 2, 2)
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      b = np_coerce(ast[base + 2])
      if b = 0 then return 0
      return np_dot(a, b)
    end
    when bid = 170 then do
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      return np_transpose(a)
    end
    when bid = 171 then do
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      return np_diag(a)
    end
    when bid = 172 then do
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      if ob_x[a % 2] \= 2 then return raise_exc(36, "diag requires an array of at least two dimensions")
      b = np_diag(a)
      if b = 0 then return 0
      return np_reduce(b, 1, 0, 0)
    end
    when bid = 174 | bid = 175 | bid = 176 then do
      if na < 2 then return nargs_err("ufunc", na, 2, 2)
      if bid = 174 then w = 21
      else if bid = 175 then w = 22
      else w = 7
      return np_binop(w, ast[base + 1], ast[base + 2])
    end
    when bid = 177 then do
      if na < 3 then return nargs_err("clip", na, 3, 3)
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      return np_clip(a, ast[base + 2], ast[base + 3])
    end
    when bid = 180 then do
      if na < 2 then return nargs_err("allclose", na, 2, 4)
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      b = np_coerce(ast[base + 2])
      if b = 0 then return 0
      rtl = 0.00001
      atl = 0.00000001
      if na >= 3 then rtl = mf(ast[base + 3])
      if na >= 4 then atl = mf(ast[base + 4])
      v = kwarg(base, na, nk, "rtol")
      if v \= 0 then rtl = mf(v)
      v = kwarg(base, na, nk, "atol")
      if v \= 0 then atl = mf(v)
      if unw > 0 then return 0
      return np_allclose(a, b, rtl, atl)
    end
    when bid = 181 then do
      if na < 2 then return nargs_err("array_equal", na, 2, 2)
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      b = np_coerce(ast[base + 2])
      if b = 0 then return 0
      return np_array_equal(a, b)
    end
    when bid = 182 then do
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      return np_median(a)
    end
    when bid = 185 then do
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      w = 0
      if na >= 2 then w = ival(ast[base + 2])
      v = kwarg(base, na, nk, "decimals")
      if v \= 0 then w = ival(v)
      r = np_round_arr(a, w)
      if r = 0 then return 0
      if ob_x[r % 2] = 0 then return np_scalar(r, 0)
      return r
    end
    when bid = 193 then do
      if na < 2 then return nargs_err("reshape", na, 2, 2)
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      if np_dims(base, 2, na - 1) = 0 then return 0
      return np_reshape(a)
    end
    when bid = 194 then do
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      return np_flat(a)
    end
    when bid = 186 | bid = 187 | bid = 188 | bid = 189 | bid = 190 | bid = 191 | bid = 192 | bid = 173 | bid = 178 | bid = 179 | bid = 183 | bid = 184 then do
      if na < 1 then return nargs_err("reduction", na, 1, 2)
      a = np_coerce(ast[base + 1])
      if a = 0 then return 0
      if bid = 186 then w = 1
      else if bid = 187 then w = 2
      else if bid = 188 then w = 3
      else if bid = 189 then w = 4
      else if bid = 190 then w = 5
      else if bid = 191 then w = 6
      else if bid = 192 then w = 7
      else if bid = 173 then w = 8
      else if bid = 178 then w = 9
      else if bid = 179 then w = 10
      else if bid = 183 then w = 11
      else w = 12
      return np_red_call(a, w, base, na, nk, 2)
    end
    otherwise nop
  end
  return raise_exc(38, "unsupported numpy function")

/* ---------------------------------------------------------------------
   bytes and bytearray (kind K_BYTES: ob_s holds one character per byte, code 0 .. 255;
   ob_y = 1 for a bytearray), encodings, int.to_bytes / from_bytes
   --------------------------------------------------------------------- */
mkbytes: procedure = .int
  arg s = .string
  o = .int
  o = newobj(31)
  ob_s[o % 2] = s
  return o

mkbytearr: procedure = .int
  arg s = .string
  o = .int
  o = newobj(31)
  ob_s[o % 2] = s
  ob_y[o % 2] = 1
  return o

/* a bytes-like object of the same type as o */
bytes_like: procedure = .int
  arg o = .int, s = .string
  if ob_y[o % 2] = 1 then return mkbytearr(s)
  return mkbytes(s)

bytes_rep: procedure = .int
  arg o = .int, n = .int
  if n < 0 then n = 0
  return bytes_like(o, copies(ob_s[o % 2], n))

hex2: procedure = .string
  arg v = .int
  return lower(right(d2x(v), 2, "0"))

bytes_repr: procedure = .string
  arg s = .string
  q = .string
  r = .string
  i = .int
  n = .int
  c = .string
  v = .int
  q = "'"
  if pos("'", s) > 0 & pos('"', s) = 0 then q = '"'
  r = "b" || q
  n = length(s)
  do i = 1 to n
    c = substr(s, i, 1)
    v = c2d(c)
    if c == q | c == "\" then r = r || "\" || c
    else if v = 10 then r = r || "\n"
    else if v = 9 then r = r || "\t"
    else if v = 13 then r = r || "\r"
    else if v < 32 | v >= 127 then r = r || "\x" || hex2(v)
    else r = r || c
  end
  return r || q

/* normalise an encoding name: "utf-8", "ascii", "latin-1" or "" when unknown */
enc_name: procedure = .string
  arg e = .string
  l = .string
  l = lower(changestr("_", e, "-"))
  if l == "utf-8" | l == "utf8" | l == "u8" | l == "utf" then return "utf-8"
  if l == "ascii" | l == "us-ascii" | l == "646" then return "ascii"
  if l == "latin-1" | l == "latin1" | l == "iso-8859-1" | l == "iso8859-1" | l == "l1" | l == "latin" | l == "cp1252" | l == "windows-1252" then return "latin-1"
  return ""

/* the encoding argument (positional idx or keyword) as a normalised name; "" with an exception set when unknown */
enc_arg: procedure = .string
  arg base = .int, na = .int, nk = .int, idx = .int
  v = .int
  e = .string
  v = 0
  if na >= idx then v = ast[base + idx]
  if kwarg(base, na, nk, "encoding") \= 0 then v = kwarg(base, na, nk, "encoding")
  if v = 0 then return "utf-8"
  if kind_of(v) \= 6 then do
    call raise_exc 38, "encode() argument 'encoding' must be str, not " || type_name(v)
    return ""
  end
  e = enc_name(ob_s[v % 2])
  if e == "" then do
    call raise_exc 33, "unknown encoding: " || ob_s[v % 2]
    return ""
  end
  return e

err_arg: procedure = .string
  arg base = .int, na = .int, nk = .int, idx = .int
  v = .int
  v = 0
  if na >= idx then v = ast[base + idx]
  if kwarg(base, na, nk, "errors") \= 0 then v = kwarg(base, na, nk, "errors")
  if v = 0 then return "strict"
  if kind_of(v) \= 6 then return "strict"
  return ob_s[v % 2]

/* characters (codepoints) to bytes; returns the byte string, or "" with an exception set */
str_encode: procedure = .string
  arg s = .string, enc = .string, errs = .string
  r = .string
  i = .int
  n = .int
  c = .int
  ch = .string
  bad = .int
  n = length(s)
  r = ""
  do i = 1 to n
    ch = substr(s, i, 1)
    c = c2d(ch)
    bad = 0
    if c < 128 then r = r || ch
    else if enc == "utf-8" then do
      if c < 2048 then r = r || d2c(192 + c % 64) || d2c(128 + c // 64)
      else if c < 65536 then r = r || d2c(224 + c % 4096) || d2c(128 + (c % 64) // 64) || d2c(128 + c // 64)
      else r = r || d2c(240 + c % 262144) || d2c(128 + (c % 4096) // 64) || d2c(128 + (c % 64) // 64) || d2c(128 + c // 64)
    end
    else if enc == "latin-1" & c < 256 then r = r || ch
    else bad = 1
    if bad = 1 then do
      if errs == "ignore" then nop
      else if errs == "replace" then r = r || "?"
      else if errs == "xmlcharrefreplace" then r = r || "&#" || c || ";"
      else if errs == "backslashreplace" then do
        if c < 256 then r = r || "\x" || hex2(c)
        else if c < 65536 then r = r || "\u" || right(lower(d2x(c)), 4, "0")
        else r = r || "\U" || right(lower(d2x(c)), 8, "0")
      end
      else do
        if c < 256 then ch = "\x" || hex2(c)
        else if c < 65536 then ch = "\u" || right(lower(d2x(c)), 4, "0")
        else ch = "\U" || right(lower(d2x(c)), 8, "0")
        if enc == "ascii" then call raise_exc 80, "'ascii' codec can't encode character '" || ch || "' in position " || (i - 1) || ": ordinal not in range(128)"
        else call raise_exc 80, "'latin-1' codec can't encode character '" || ch || "' in position " || (i - 1) || ": ordinal not in range(256)"
        return ""
      end
    end
  end
  return r

/* bytes to characters; "" with an exception set on a strict error */
str_decode: procedure = .string
  arg s = .string, enc = .string, errs = .string
  r = .string
  i = .int
  n = .int
  b = .int
  need = .int
  cp = .int
  j = .int
  cb = .int
  why = .string
  bad = .int
  lo = .int
  hi = .int
  n = length(s)
  r = ""
  i = 1
  do while i <= n
    b = c2d(substr(s, i, 1))
    if b < 128 then do
      r = r || d2c(b)
      i = i + 1
      iterate
    end
    if enc == "latin-1" then do
      r = r || d2c(b)
      i = i + 1
      iterate
    end
    bad = 0
    why = ""
    need = 0
    cp = 0
    if enc == "ascii" then do
      bad = 1
      why = "ordinal not in range(128)"
    end
    else if b >= 194 & b <= 223 then do
      need = 1
      cp = b - 192
    end
    else if b >= 224 & b <= 239 then do
      need = 2
      cp = b - 224
    end
    else if b >= 240 & b <= 244 then do
      need = 3
      cp = b - 240
    end
    else do
      bad = 1
      why = "invalid start byte"
    end
    j = 1
    if bad = 0 then do
      lo = 128
      hi = 191
      if b = 224 then lo = 160
      if b = 237 then hi = 159
      if b = 240 then lo = 144
      if b = 244 then hi = 143
      do while j <= need
        if i + j > n then do
          bad = 2
          why = "unexpected end of data"
          leave
        end
        cb = c2d(substr(s, i + j, 1))
        if cb < lo | cb > hi then do
          bad = 1
          why = "invalid continuation byte"
          leave
        end
        lo = 128
        hi = 191
        cp = cp * 64 + (cb - 128)
        j = j + 1
      end
    end
    if bad = 0 then do
      r = r || d2c(cp)
      i = i + need + 1
      iterate
    end
    if errs == "strict" then do
      if bad = 2 & j > 1 then call raise_exc 79, "'" || enc || "' codec can't decode bytes in position " || (i - 1) || "-" || (n - 1) || ": " || why
      else call raise_exc 79, "'" || enc || "' codec can't decode byte 0x" || hex2(b) || " in position " || (i - 1) || ": " || why
      return ""
    end
    if errs == "replace" then r = r || d2c(65533)
    else if errs == "backslashreplace" then r = r || "\x" || hex2(b)
    else if errs == "surrogateescape" then r = r || d2c(56320 + b)
    if bad = 2 then i = n + 1
    else i = i + 1
  end
  return r

/* bytes of an iterable of ints; "" with an exception set on error */
bytes_from_iter: procedure = .string
  arg x = .int
  l = .int
  i = .int
  v = .int
  r = .string
  l = iter_list(x)
  if l = 0 then return ""
  r = ""
  do i = 0 to ob_n[l % 2] - 1
    v = sl[ob_p[l % 2] + i]
    if numkind(v) \= 1 then do
      call raise_exc 38, "'" || type_name(v) || "' object cannot be interpreted as an integer"
      return ""
    end
    if ival(v) < 0 | ival(v) > 255 then do
      call raise_exc 36, "bytes must be in range(0, 256)"
      return ""
    end
    r = r || d2c(ival(v))
  end
  return r

/* bytes(...) / bytearray(...) */
ctor_bytes: procedure = .int
  arg isba = .int, base = .int, na = .int, nk = .int
  x = .int
  s = .string
  enc = .string
  nm = .string
  nm = "bytes"
  if isba = 1 then nm = "bytearray"
  if na = 0 & nk = 0 then s = ""
  else do
    x = 0
    if na >= 1 then x = ast[base + 1]
    if x = 0 then x = kwarg(base, na, nk, "source")
    if x = 0 then s = ""
    else if kind_of(x) = 6 then do
      if na < 2 & kwarg(base, na, nk, "encoding") = 0 then return raise_exc(38, "string argument without an encoding")
      enc = enc_arg(base, na, nk, 2)
      if unw > 0 then return 0
      s = str_encode(ob_s[x % 2], enc, err_arg(base, na, nk, 3))
      if unw > 0 then return 0
    end
    else if kind_of(x) = 31 then s = ob_s[x % 2]
    else if numkind(x) = 1 then do
      if ival(x) < 0 then return raise_exc(36, "negative count")
      s = copies(d2c(0), ival(x))
    end
    else if numkind(x) = 2 then return raise_exc(31, "cannot fit 'int' into an index-sized integer")
    else if numkind(x) = 3 | kind_of(x) = 32 then return raise_exc(38, "cannot convert '" || type_name(x) || "' object to " || nm)
    else do
      s = bytes_from_iter(x)
      if unw > 0 then return 0
    end
  end
  if isba = 1 then return mkbytearr(s)
  return mkbytes(s)

/* hex string of s with an optional separator */
bytes_hex: procedure = .string
  arg s = .string, sep = .string
  r = .string
  i = .int
  n = .int
  r = ""
  n = length(s)
  do i = 1 to n
    if i > 1 then r = r || sep
    r = r || hex2(c2d(substr(s, i, 1)))
  end
  return r

/* bytes.fromhex(s) */
bytes_fromhex: procedure = .int
  arg isba = .int, base = .int, na = .int
  h = .string
  r = .string
  i = .int
  n = .int
  c = .string
  d1 = .int
  d2 = .int
  if na \= 1 then return nargs_err("fromhex", na, 1, 1)
  if kind_of(ast[base + 1]) \= 6 then return raise_exc(38, "fromhex() argument must be str, not " || type_name(ast[base + 1]))
  h = ob_s[ast[base + 1] % 2]
  n = length(h)
  r = ""
  i = 1
  do while i <= n
    c = substr(h, i, 1)
    if is_ws(c) = 1 then do
      i = i + 1
      iterate
    end
    d1 = hexval(c)
    d2 = -1
    if i < n then d2 = hexval(substr(h, i + 1, 1))
    if d1 < 0 | d2 < 0 then do
      if d1 >= 0 then i = i + 1
      return raise_exc(36, "non-hexadecimal number found in fromhex() arg at position " || (i - 1))
    end
    r = r || d2c(d1 * 16 + d2)
    i = i + 2
  end
  if isba = 1 then return mkbytearr(r)
  return mkbytes(r)

hexval: procedure = .int
  arg c = .string
  v = .int
  if isdigit(c) = 1 then return c as .int
  v = c2d(lower(c))
  if v >= 97 & v <= 102 then return v - 87
  return -1

/* the needle argument of find / count / startswith ...: a byte string, or "" with an exception */
bytes_needle: procedure = .string
  arg x = .int
  if kind_of(x) = 31 then return ob_s[x % 2]
  if numkind(x) = 1 then do
    if ival(x) < 0 | ival(x) > 255 then do
      call raise_exc 36, "byte must be in range(0, 256)"
      return ""
    end
    return d2c(ival(x))
  end
  call raise_exc 38, "a bytes-like object is required, not '" || type_name(x) || "'"
  return ""

/* turn a list of str objects (from the str splitters) into bytes objects of the type of o */
bytes_list: procedure = .int
  arg l = .int, o = .int
  i = .int
  do i = 0 to ob_n[l % 2] - 1
    sl[ob_p[l % 2] + i] = bytes_like(o, ob_s[sl[ob_p[l % 2] + i] % 2])
  end
  return l

meth_bytes: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  s = .string
  a = .string
  t = .string
  n = .int
  i = .int
  j = .int
  p = .int
  m = .int
  v = .int
  l = .int
  w = .int
  st = .int
  en = .int
  f = .string
  ba = .int
  enc = .string
  c = .int
  s = ob_s[o % 2]
  ba = ob_y[o % 2]
  select
    when nid = 22 then do
      enc = enc_arg(base, na, nk, 1)
      if unw > 0 then return 0
      t = str_decode(s, enc, err_arg(base, na, nk, 2))
      if unw > 0 then return 0
      return mkstr(t)
    end
    when nid = 43 then do
      a = ""
      if na >= 1 then do
        if kind_of(ast[base + 1]) = 6 then a = ob_s[ast[base + 1] % 2]
        else if kind_of(ast[base + 1]) = 31 then a = ob_s[ast[base + 1] % 2]
      end
      if kwarg(base, na, nk, "sep") \= 0 then a = ob_s[kwarg(base, na, nk, "sep") % 2]
      return mkstr(bytes_hex(s, a))
    end
    when nid = 66 then do
      if na \= 1 then return nargs_err("join", na, 1, 1)
      l = iter_list(ast[base + 1])
      if l = 0 then return 0
      n = ob_n[l % 2]
      t = ""
      do i = 0 to n - 1
        v = sl[ob_p[l % 2] + i]
        if kind_of(v) \= 31 then return raise_exc(38, "sequence item " || i || ": expected a bytes-like object, " || type_name(v) || " found")
        if i > 0 then t = t || s
        t = t || ob_s[v % 2]
      end
      return bytes_like(o, t)
    end
    when nid = 126 then return bytes_like(o, upper(s))
    when nid = 69 then return bytes_like(o, lower(s))
    when nid = 11 then return bytes_like(o, upper(left(s, 1)) || lower(substr(s, 2)))
    when nid = 116 then return bytes_like(o, str_swapcase(s))
    when nid = 119 then return bytes_like(o, str_title(s))
    when nid = 114 | nid = 70 | nid = 100 then do
      a = ""
      if na >= 1 then do
        if ast[base + 1] \= 2 then do
          a = bytes_needle(ast[base + 1])
          if unw > 0 then return 0
        end
      end
      m = 3
      if nid = 70 then m = 1
      if nid = 100 then m = 2
      return bytes_like(o, str_strip(s, a, m))
    end
    when nid = 107 | nid = 99 then do
      a = ""
      w = 0
      m = -1
      if na >= 1 then do
        if ast[base + 1] \= 2 then do
          a = bytes_needle(ast[base + 1])
          if unw > 0 then return 0
          w = 1
          if a == "" then return raise_exc(36, "empty separator")
        end
      end
      if na >= 2 then m = ival(ast[base + 2])
      if kwarg(base, na, nk, "maxsplit") \= 0 then m = ival(kwarg(base, na, nk, "maxsplit"))
      if kwarg(base, na, nk, "sep") \= 0 then do
        if kwarg(base, na, nk, "sep") \= 2 then do
          a = bytes_needle(kwarg(base, na, nk, "sep"))
          if unw > 0 then return 0
          w = 1
        end
      end
      if nid = 107 then do
        if w = 0 then return bytes_list(split_ws(s, m), o)
        return bytes_list(split_sep(s, a, m), o)
      end
      if w = 0 then return bytes_list(rsplit_ws(s, m), o)
      return bytes_list(rsplit_sep(s, a, m), o)
    end
    when nid = 91 then do
      if na < 2 then return nargs_err("replace", na, 2, 3)
      a = bytes_needle(ast[base + 1])
      if unw > 0 then return 0
      t = bytes_needle(ast[base + 2])
      if unw > 0 then return 0
      m = -1
      if na >= 3 then m = ival(ast[base + 3])
      return bytes_like(o, str_replace(s, a, t, m))
    end
    when nid = 34 | nid = 94 | nid = 45 | nid = 95 | nid = 20 then do
      if na < 1 then return nargs_err(nid_name[nid], na, 1, 3)
      a = bytes_needle(ast[base + 1])
      if unw > 0 then return 0
      if slice_args(length(s), base, na, 2) = 0 then return 0
      st = sl_a
      en = sl_n
      if st > en | st > length(s) then do
        if nid = 20 then return mkint(0)
        if nid = 34 | nid = 94 then return mkint(-1)
        return raise_exc(36, "subsection not found")
      end
      t = substr(s, st + 1, en - st)
      if nid = 20 then do
        if a == "" then return mkint(length(t) + 1)
        return mkint(countstr(a, t))
      end
      if a == "" then do
        if nid = 94 | nid = 95 then return mkint(en)
        return mkint(st)
      end
      if nid = 34 | nid = 45 then p = pos(a, t)
      else p = lastpos(a, t)
      if p = 0 then do
        if nid = 34 | nid = 94 then return mkint(-1)
        return raise_exc(36, "subsection not found")
      end
      return mkint(p - 1 + st)
    end
    when nid = 110 | nid = 30 then do
      if na < 1 then return nargs_err(nid_name[nid], na, 1, 3)
      if slice_args(length(s), base, na, 2) = 0 then return 0
      st = sl_a
      en = sl_n
      if st > en then return 6
      t = substr(s, st + 1, en - st)
      v = ast[base + 1]
      if kind_of(v) = 8 then l = ob_n[v % 2]
      else l = 1
      do j = 0 to l - 1
        if kind_of(v) = 8 then a = bytes_needle(sl[ob_p[v % 2] + j])
        else a = bytes_needle(v)
        if unw > 0 then return 0
        n = length(a)
        if n <= length(t) then do
          if nid = 110 then do
            if left(t, n) == a then return 4
          end
          else do
            if n = 0 then return 4
            if right(t, n) == a then return 4
          end
        end
      end
      return 6
    end
    when nid = 50 then return mkbool(by_isclass(s, 1))
    when nid = 53 then return mkbool(by_isclass(s, 2))
    when nid = 49 then return mkbool(by_isclass(s, 3))
    when nid = 58 then return mkbool(by_isclass(s, 4))
    when nid = 62 then do
      if upper(s) == s & lower(s) \== s then return 4
      return 6
    end
    when nid = 56 then do
      if lower(s) == s & upper(s) \== lower(s) then return 4
      return 6
    end
    when nid = 51 then do
      do i = 1 to length(s)
        if c2d(substr(s, i, 1)) >= 128 then return 6
      end
      return 4
    end
    when nid = 13 | nid = 68 | nid = 96 then do
      if na < 1 then return nargs_err(nid_name[nid], na, 1, 2)
      if chk_int(ast[base + 1]) = 0 then return 0
      w = ival(ast[base + 1])
      f = " "
      if na >= 2 then do
        f = bytes_needle(ast[base + 2])
        if unw > 0 then return 0
        if length(f) \= 1 then return raise_exc(38, nid_name[nid] || "() argument 2 must be a byte string of length 1")
      end
      n = length(s)
      if w <= n then return bytes_like(o, s)
      m = w - n
      if nid = 68 then return bytes_like(o, s || copies(f, m))
      if nid = 96 then return bytes_like(o, copies(f, m) || s)
      i = m % 2 + (m // 2) * (w // 2)
      return bytes_like(o, copies(f, i) || s || copies(f, m - i))
    end
    when nid = 132 then do
      if chk_int(ast[base + 1]) = 0 then return 0
      w = ival(ast[base + 1])
      n = length(s)
      if w <= n then return bytes_like(o, s)
      if left(s, 1) == "-" | left(s, 1) == "+" then return bytes_like(o, left(s, 1) || copies("0", w - n) || substr(s, 2))
      return bytes_like(o, copies("0", w - n) || s)
    end
    when nid = 78 | nid = 98 then do
      if na \= 1 then return nargs_err(nid_name[nid], na, 1, 1)
      a = bytes_needle(ast[base + 1])
      if unw > 0 then return 0
      if a == "" then return raise_exc(36, "empty separator")
      if nid = 78 then p = pos(a, s)
      else p = lastpos(a, s)
      v = mktuple(3)
      if p = 0 then do
        if nid = 78 then do
          sl[ob_p[v % 2]] = bytes_like(o, s)
          sl[ob_p[v % 2] + 1] = bytes_like(o, "")
          sl[ob_p[v % 2] + 2] = bytes_like(o, "")
        end
        else do
          sl[ob_p[v % 2]] = bytes_like(o, "")
          sl[ob_p[v % 2] + 1] = bytes_like(o, "")
          sl[ob_p[v % 2] + 2] = bytes_like(o, s)
        end
        return v
      end
      sl[ob_p[v % 2]] = bytes_like(o, left(s, p - 1))
      sl[ob_p[v % 2] + 1] = bytes_like(o, a)
      sl[ob_p[v % 2] + 2] = bytes_like(o, substr(s, p + length(a)))
      return v
    end
    when nid = 108 then do
      l = mklist(8)
      m = 0
      if na >= 1 then m = truthy(ast[base + 1])
      n = length(s)
      i = 1
      do while i <= n
        j = i
        do while j <= n & substr(s, j, 1) \== '0a'x & substr(s, j, 1) \== '0d'x
          j = j + 1
        end
        p = j
        if j <= n then do
          if substr(s, j, 1) == '0d'x & substr(s, j + 1, 1) == '0a'x then j = j + 2
          else j = j + 1
        end
        if m = 1 then call list_append l, bytes_like(o, substr(s, i, j - i))
        else call list_append l, bytes_like(o, substr(s, i, p - i))
        i = j
      end
      return l
    end
    when nid = 89 then do
      a = bytes_needle(ast[base + 1])
      if unw > 0 then return 0
      if length(a) <= length(s) & length(a) > 0 then do
        if left(s, length(a)) == a then return bytes_like(o, substr(s, length(a) + 1))
      end
      return bytes_like(o, s)
    end
    when nid = 90 then do
      a = bytes_needle(ast[base + 1])
      if unw > 0 then return 0
      if length(a) <= length(s) & length(a) > 0 then do
        if right(s, length(a)) == a then return bytes_like(o, left(s, length(s) - length(a)))
      end
      return bytes_like(o, s)
    end
    when nid = 19 & ba = 1 then return mkbytearr(s)
    when nid = 4 & ba = 1 then do
      a = bytes_needle(ast[base + 1])
      if unw > 0 then return 0
      ob_s[o % 2] = s || a
      return 2
    end
    when nid = 32 & ba = 1 then do
      if kind_of(ast[base + 1]) = 31 then a = ob_s[ast[base + 1] % 2]
      else do
        a = bytes_from_iter(ast[base + 1])
        if unw > 0 then return 0
      end
      ob_s[o % 2] = s || a
      return 2
    end
    when nid = 46 & ba = 1 then do
      if chk_int(ast[base + 1]) = 0 then return 0
      a = bytes_needle(ast[base + 2])
      if unw > 0 then return 0
      i = ival(ast[base + 1])
      n = length(s)
      if i < 0 then i = i + n
      if i < 0 then i = 0
      if i > n then i = n
      ob_s[o % 2] = left(s, i) || a || substr(s, i + 1)
      return 2
    end
    when nid = 79 & ba = 1 then do
      n = length(s)
      if n = 0 then return raise_exc(34, "pop from empty bytearray")
      i = n - 1
      if na >= 1 then do
        if chk_int(ast[base + 1]) = 0 then return 0
        i = ival(ast[base + 1])
        if i < 0 then i = i + n
        if i < 0 | i >= n then return raise_exc(34, "pop index out of range")
      end
      c = c2d(substr(s, i + 1, 1))
      ob_s[o % 2] = left(s, i) || substr(s, i + 2)
      return mkint(c)
    end
    when nid = 88 & ba = 1 then do
      a = bytes_needle(ast[base + 1])
      if unw > 0 then return 0
      p = pos(a, s)
      if p = 0 then return raise_exc(36, "value not found in bytearray")
      ob_s[o % 2] = left(s, p - 1) || substr(s, p + length(a))
      return 2
    end
    when nid = 14 & ba = 1 then do
      ob_s[o % 2] = ""
      return 2
    end
    when nid = 93 & ba = 1 then do
      t = ""
      do i = length(s) to 1 by -1
        t = t || substr(s, i, 1)
      end
      ob_s[o % 2] = t
      return 2
    end
    otherwise nop
  end
  return meth_common(o, nid, base, na, nk)

by_isclass: procedure = .int
  arg s = .string, cls = .int
  i = .int
  n = .int
  c = .string
  a = .int
  d = .int
  n = length(s)
  if n = 0 then return 0
  do i = 1 to n
    c = substr(s, i, 1)
    a = 0
    if c >>= "a" & c <<= "z" then a = 1
    else if c >>= "A" & c <<= "Z" then a = 1
    d = 0
    if c >>= "0" & c <<= "9" then d = 1
    if cls = 1 & a = 0 then return 0
    if cls = 2 & d = 0 then return 0
    if cls = 3 & a = 0 & d = 0 then return 0
    if cls = 4 & (c2d(c) >= 128 | is_ws(c) = 0) then return 0
  end
  return 1

/* index into a bytes object: an int, or a bytes slice handled by the caller */
bytes_geti: procedure = .int
  arg o = .int, ix = .int
  s = .string
  i = .int
  n = .int
  s = ob_s[o % 2]
  if ix // 2 = 0 & ob_k[ix % 2] \= 2 then return raise_exc(38, "byte indices must be integers or slices, not " || type_name(ix))
  i = idx_int(ix)
  n = length(s)
  if i < 0 then i = i + n
  if i < 0 | i >= n then do
    if ob_y[o % 2] = 1 then return raise_exc(34, "bytearray index out of range")
    return raise_exc(34, "index out of range")
  end
  return mkint(c2d(substr(s, i + 1, 1)))

bytes_slice: procedure = .int
  arg o = .int, lo = .int, hi = .int, st = .int
  s = .string
  r = .int
  res = .string
  p = .int
  i = .int
  s = ob_s[o % 2]
  r = slice_calc(length(s), lo, hi, st)
  if r = 0 then return 0
  if sl_b = 1 then return bytes_like(o, substr(s, sl_a + 1, sl_n))
  res = ""
  p = sl_a
  do i = 1 to sl_n
    res = res || substr(s, p + 1, 1)
    p = p + sl_b
  end
  return bytes_like(o, res)

/* bytearray item / slice assignment */
bytes_seti: procedure = .void
  arg o = .int, ix = .int, v = .int
  s = .string
  i = .int
  n = .int
  r = .int
  t = .string
  src = .string
  s = ob_s[o % 2]
  if ob_y[o % 2] \= 1 then do
    r = raise_exc(38, "'bytes' object does not support item assignment")
    return
  end
  if ix // 2 = 0 & ob_k[ix % 2] = 21 then do
    if kind_of(v) = 31 then src = ob_s[v % 2]
    else do
      src = bytes_from_iter(v)
      if unw > 0 then return
    end
    r = slice_calc(length(s), ob_n[ix % 2], ob_x[ix % 2], ob_y[ix % 2])
    if r = 0 then return
    if sl_b = 1 then do
      ob_s[o % 2] = left(s, sl_a) || src || substr(s, sl_a + sl_n + 1)
      return
    end
    if length(src) \= sl_n then do
      r = raise_exc(36, "attempt to assign bytes of size " || length(src) || " to extended slice of size " || sl_n)
      return
    end
    i = sl_a
    do n = 1 to sl_n
      s = left(s, i) || substr(src, n, 1) || substr(s, i + 2)
      i = i + sl_b
    end
    ob_s[o % 2] = s
    return
  end
  if numkind(v) \= 1 then do
    r = raise_exc(38, "'" || type_name(v) || "' object cannot be interpreted as an integer")
    return
  end
  if ival(v) < 0 | ival(v) > 255 then do
    r = raise_exc(36, "byte must be in range(0, 256)")
    return
  end
  i = idx_int(ix)
  n = length(s)
  if i < 0 then i = i + n
  if i < 0 | i >= n then do
    r = raise_exc(34, "bytearray assignment index out of range")
    return
  end
  ob_s[o % 2] = left(s, i) || d2c(ival(v)) || substr(s, i + 2)
  return

bytes_deli: procedure = .void
  arg o = .int, ix = .int
  s = .string
  i = .int
  n = .int
  r = .int
  s = ob_s[o % 2]
  if ob_y[o % 2] \= 1 then do
    r = raise_exc(38, "'bytes' object doesn't support item deletion")
    return
  end
  if ix // 2 = 0 & ob_k[ix % 2] = 21 then do
    r = slice_calc(length(s), ob_n[ix % 2], ob_x[ix % 2], ob_y[ix % 2])
    if r = 0 then return
    if sl_b = 1 then do
      ob_s[o % 2] = left(s, sl_a) || substr(s, sl_a + sl_n + 1)
      return
    end
    do n = 1 to sl_n
      i = sl_a + (n - 1) * sl_b
      s = left(s, i) || "@@" || substr(s, i + 2)
    end
    ob_s[o % 2] = changestr("@@", s, "")
    return
  end
  i = idx_int(ix)
  n = length(s)
  if i < 0 then i = i + n
  if i < 0 | i >= n then do
    r = raise_exc(34, "bytearray index out of range")
    return
  end
  ob_s[o % 2] = left(s, i) || substr(s, i + 2)
  return

bytes_contains: procedure = .int
  arg c = .int, x = .int
  a = .string
  a = bytes_needle(x)
  if unw > 0 then return 0
  if pos(a, ob_s[c % 2]) > 0 | a == "" then return 1
  return 0

/* ---- int.to_bytes / int.from_bytes ---- */
int_to_bytes: procedure = .int
  arg o = .int, base = .int, na = .int, nk = .int
  nlen = .int
  order = .string
  v = .int
  s = .string
  neg = .int
  r = .string
  i = .int
  a = .int
  q = .string
  m = .string
  signed = .int
  nlen = 1
  order = "big"
  signed = 0
  if na >= 1 then v = ast[base + 1]
  else v = kwarg(base, na, nk, "length")
  if v \= 0 then do
    if chk_int(v) = 0 then return 0
    nlen = ival(v)
  end
  v = 0
  if na >= 2 then v = ast[base + 2]
  if kwarg(base, na, nk, "byteorder") \= 0 then v = kwarg(base, na, nk, "byteorder")
  if v \= 0 then order = ob_s[v % 2]
  if kwarg(base, na, nk, "signed") \= 0 then signed = truthy(kwarg(base, na, nk, "signed"))
  if order \== "big" & order \== "little" then return raise_exc(36, "byteorder must be either 'little' or 'big'")
  if nlen < 0 then return raise_exc(36, "length argument must be non-negative")
  s = num_str(o)
  neg = 0
  if left(s, 1) == "-" then do
    neg = 1
    s = substr(s, 2)
    if signed = 0 then return raise_exc(31, "can't convert negative int to unsigned")
    s = ssub(big_pow("256", nlen), s)
    if left(s, 1) == "-" then return raise_exc(31, "int too big to convert")
  end
  r = ""
  do i = 1 to nlen
    call sdivmod s, "256"
    a = sr as .int
    s = sq
    r = d2c(a) || r
  end
  if s \== "0" then return raise_exc(31, "int too big to convert")
  if signed = 1 & neg = 0 & nlen > 0 then do
    if c2d(left(r, 1)) >= 128 then return raise_exc(31, "int too big to convert")
  end
  if signed = 1 & neg = 1 & nlen > 0 then do
    if c2d(left(r, 1)) < 128 then return raise_exc(31, "int too big to convert")
  end
  if order == "little" then do
    q = ""
    do i = length(r) to 1 by -1
      q = q || substr(r, i, 1)
    end
    r = q
  end
  return mkbytes(r)

int_from_bytes: procedure = .int
  arg base = .int, na = .int, nk = .int
  x = .int
  s = .string
  order = .string
  v = .int
  signed = .int
  acc = .string
  i = .int
  n = .int
  b = .int
  small = .int
  order = "big"
  signed = 0
  x = 0
  if na >= 1 then x = ast[base + 1]
  if x = 0 then x = kwarg(base, na, nk, "bytes")
  if x = 0 then return nargs_err("from_bytes", na, 1, 3)
  if kind_of(x) = 31 then s = ob_s[x % 2]
  else do
    s = bytes_from_iter(x)
    if unw > 0 then return 0
  end
  v = 0
  if na >= 2 then v = ast[base + 2]
  if kwarg(base, na, nk, "byteorder") \= 0 then v = kwarg(base, na, nk, "byteorder")
  if v \= 0 then order = ob_s[v % 2]
  if kwarg(base, na, nk, "signed") \= 0 then signed = truthy(kwarg(base, na, nk, "signed"))
  if order \== "big" & order \== "little" then return raise_exc(36, "byteorder must be either 'little' or 'big'")
  n = length(s)
  if order == "little" then do
    acc = ""
    do i = n to 1 by -1
      acc = acc || substr(s, i, 1)
    end
    s = acc
  end
  if n = 0 then return mkint(0)
  small = 0
  if n <= 7 then small = 1
  if small = 1 then do
    b = 0
    do i = 1 to n
      b = b * 256 + c2d(substr(s, i, 1))
    end
    if signed = 1 & c2d(left(s, 1)) >= 128 then b = b - 256 ** n
    return mkint(b)
  end
  acc = "0"
  do i = 1 to n
    acc = sadd(smul(acc, "256"), c2d(substr(s, i, 1)) as .string)
  end
  if signed = 1 & c2d(left(s, 1)) >= 128 then acc = ssub(acc, big_pow("256", n))
  return big_norm(acc)

/* ---------------------------------------------------------------------
   complex numbers (kind K_COMPLEX: ob_f = real part, ob_g = imaginary part)
   Results of the c_xxx helpers are left in cr_r / cr_i.
   --------------------------------------------------------------------- */
mkcplx: procedure = .int
  arg re = .float, im = .float
  o = .int
  o = newobj(32)
  ob_f[o % 2] = re
  ob_g[o % 2] = im
  return o

/* real and imaginary part of a number into cx_re / cx_im (first) or cx_re2 / cx_im2 (second) */
cplx_get: procedure = .void
  arg x = .int
  if kind_of(x) = 32 then do
    cx_re = ob_f[x % 2]
    cx_im = ob_g[x % 2]
  end
  else do
    cx_re = tofloat(x)
    cx_im = 0.0
  end
  return

cplx_get2: procedure = .void
  arg x = .int
  if kind_of(x) = 32 then do
    cx_re2 = ob_f[x % 2]
    cx_im2 = ob_g[x % 2]
  end
  else do
    cx_re2 = tofloat(x)
    cx_im2 = 0.0
  end
  return

c_mul: procedure = .void
  arg ar = .float, ai = .float, br = .float, bi = .float
  cr_r = ar * br - ai * bi
  cr_i = ar * bi + ai * br
  return

/* a / b; 0 on division by zero */
c_quot: procedure = .int
  arg ar = .float, ai = .float, br = .float, bi = .float
  abr = .float
  abi = .float
  ratio = .float
  denom = .float
  abr = rxfloat..fabs(br)
  abi = rxfloat..fabs(bi)
  if abr >= abi then do
    if abr = 0.0 then return 0
    ratio = bi / br
    denom = br + bi * ratio
    cr_r = (ar + ai * ratio) / denom
    cr_i = (ai - ar * ratio) / denom
    return 1
  end
  if abi >= abr then do
    ratio = br / bi
    denom = br * ratio + bi
    cr_r = (ar * ratio + ai) / denom
    cr_i = (ai * ratio - ar) / denom
    return 1
  end
  cr_r = f_nan()
  cr_i = f_nan()
  return 1

/* x ** n for 0 < n <= 100 by binary exponentiation (as CPython) */
c_powu: procedure = .void
  arg ar = .float, ai = .float, n = .int
  rr = .float
  ri = .float
  pr = .float
  pi = .float
  mask = .int
  rr = 1.0
  ri = 0.0
  pr = ar
  pi = ai
  mask = 1
  do while n >= mask
    if ((n % mask) // 2) = 1 then do
      call c_mul rr, ri, pr, pi
      rr = cr_r
      ri = cr_i
    end
    mask = mask * 2
    call c_mul pr, pi, pr, pi
    pr = cr_r
    pi = cr_i
  end
  cr_r = rr
  cr_i = ri
  return

/* a ** b; 0 when 0 is raised to a negative or complex power */
c_pow: procedure = .int
  arg ar = .float, ai = .float, br = .float, bi = .float
  vabs = .float
  ln = .float
  at = .float
  phase = .float
  n = .int
  if bi = 0.0 & br = rxfloat..floor(br) & rxfloat..fabs(br) <= 100.0 then do
    n = rxfloat..trunc(br) as .int
    if n > 0 then do
      call c_powu ar, ai, n
      return 1
    end
    if n = 0 then do
      call c_powu ar, ai, 0
      return c_quot(1.0, 0.0, cr_r + 0.0, cr_i + 0.0)
    end
    call c_powu ar, ai, 0 - n
    return c_quot(1.0, 0.0, cr_r + 0.0, cr_i + 0.0)
  end
  if br = 0.0 & bi = 0.0 then do
    cr_r = 1.0
    cr_i = 0.0
    return 1
  end
  if ar = 0.0 & ai = 0.0 then do
    cr_r = 0.0
    cr_i = 0.0
    if bi \= 0.0 | br < 0.0 then return 0
    return 1
  end
  vabs = rxfloat..hypot(ar, ai)
  ln = rxfloat..pow(vabs, br)
  at = rxfloat..atan2(ai, ar)
  phase = at * br
  if bi \= 0.0 then do
    ln = ln / rxfloat..exp(at * bi)
    phase = phase + bi * rxfloat..log(vabs)
  end
  cr_r = ln * rxfloat..cos(phase)
  cr_i = ln * rxfloat..sin(phase)
  return 1

cplx_arith: procedure = .int
  arg op = .int, x = .int, y = .int
  ar = .float
  ai = .float
  br = .float
  bi = .float
  call cplx_get x
  call cplx_get2 y
  ar = cx_re
  ai = cx_im
  br = cx_re2
  bi = cx_im2
  select
    when op = 1 then return mkcplx(ar + br, ai + bi)
    when op = 2 then return mkcplx(ar - br, ai - bi)
    when op = 3 then do
      call c_mul ar, ai, br, bi
      return mkcplx(cr_r, cr_i)
    end
    when op = 4 then do
      if c_quot(ar, ai, br, bi) = 0 then return raise_exc(30, "complex division by zero")
      return mkcplx(cr_r, cr_i)
    end
    when op = 7 then do
      if c_pow(ar, ai, br, bi) = 0 then return raise_exc(30, "0.0 to a negative or complex power")
      return mkcplx(cr_r, cr_i)
    end
    otherwise return err_binop(op_sym(op), x, y)
  end
  return 0

cplx_unary: procedure = .int
  arg op = .int, x = .int
  if op = 1 then return mkcplx(fneg(ob_f[x % 2]), fneg(ob_g[x % 2]))
  if op = 2 then return x
  return raise_exc(38, "bad operand type for unary ~: 'complex'")

cplx_abs: procedure = .int
  arg x = .int
  return mkfloat(rxfloat..hypot(ob_f[x % 2], ob_g[x % 2]))

/* equality of x and y where at least one is complex */
cplx_eq: procedure = .int
  arg x = .int, y = .int
  if kind_of(x) \= 32 & numkind(x) = 0 then return 0
  if kind_of(y) \= 32 & numkind(y) = 0 then return 0
  call cplx_get x
  call cplx_get2 y
  if cx_re = cx_re2 & cx_im = cx_im2 then return 1
  return 0

/* repr of a float part without a trailing .0 */
cplx_part: procedure = .string
  arg f = .float
  s = .string
  s = float_repr(f)
  if right(s, 2) == ".0" then s = left(s, length(s) - 2)
  return s

cplx_repr: procedure = .string
  arg re = .float, im = .float
  sg2 = .string
  it = .string
  if re = 0.0 & fl_negzero(re) = 0 then return cplx_part(im) || "j"
  if im < 0.0 | fl_negzero(im) = 1 then do
    sg2 = "-"
    it = cplx_part(fneg(im))
  end
  else do
    sg2 = "+"
    it = cplx_part(im)
  end
  return "(" || cplx_part(re) || sg2 || it || "j)"

/* format(z, spec) */
format_complex: procedure = .string
  arg v = .int, spec = .string
  fill = .string
  align = .string
  sgn = .string
  alt = .string
  width = .int
  prec = .int
  ty = .string
  i = .int
  n = .int
  c = .string
  re = .float
  im = .float
  rs = .string
  ims = .string
  s2 = .string
  parens = .int
  skipre = .int
  sp = .string
  fill = ""
  align = ""
  sgn = ""
  alt = ""
  width = 0
  prec = -1
  ty = ""
  i = 1
  n = length(spec)
  if n >= 2 & pos(substr(spec, 2, 1), "<>^=") > 0 then do
    fill = substr(spec, 1, 1)
    align = substr(spec, 2, 1)
    i = 3
  end
  else if n >= 1 & pos(substr(spec, 1, 1), "<>^=") > 0 then do
    align = substr(spec, 1, 1)
    i = 2
  end
  c = substr(spec, i, 1)
  if c == "+" | c == "-" | c == " " then do
    sgn = c
    i = i + 1
  end
  if substr(spec, i, 1) == "#" then do
    alt = "#"
    i = i + 1
  end
  if substr(spec, i, 1) == "0" then i = i + 1
  do while i <= n & isdigit(substr(spec, i, 1)) = 1
    width = width * 10 + (substr(spec, i, 1) as .int)
    i = i + 1
  end
  if substr(spec, i, 1) == "." then do
    i = i + 1
    prec = 0
    do while i <= n & isdigit(substr(spec, i, 1)) = 1
      prec = prec * 10 + (substr(spec, i, 1) as .int)
      i = i + 1
    end
  end
  if i <= n then ty = substr(spec, i, 1)
  if i < n then do
    call raise_exc 36, "Invalid format specifier"
    return ""
  end
  if align == "=" then do
    call raise_exc 36, "'=' alignment flag is not allowed in complex format specifier"
    return ""
  end
  if ty \== "" & pos(ty, "eEfFgGn") = 0 then do
    call raise_exc 36, "Unknown format code '" || ty || "' for object of type 'complex'"
    return ""
  end
  re = ob_f[v % 2]
  im = ob_g[v % 2]
  parens = 0
  skipre = 0
  if ty == "" then do
    if re = 0.0 & fl_negzero(re) = 0 then skipre = 1
    else parens = 1
  end
  if ty == "" & prec < 0 then do
    /* like repr, without the trailing .0 */
    if skipre = 0 then do
      if sgn == "+" & re >= 0.0 then rs = "+" || cplx_part(re)
      else if sgn == " " & re >= 0.0 then rs = " " || cplx_part(re)
      else rs = cplx_part(re)
    end
    else rs = ""
    if im < 0.0 | fl_negzero(im) = 1 then ims = "-" || cplx_part(fneg(im))
    else if skipre = 0 | sgn == "+" then ims = "+" || cplx_part(im)
    else if sgn == " " then ims = " " || cplx_part(im)
    else ims = cplx_part(im)
  end
  else do
    sp = "." || prec
    if prec < 0 then sp = ""
    if ty == "" then s2 = "g"
    else s2 = ty
    if skipre = 0 then rs = format_value(mkfloat(re), sgn || alt || sp || s2)
    else rs = ""
    if unw > 0 then return ""
    if skipre = 0 then ims = format_value(mkfloat(im), "+" || alt || sp || s2)
    else ims = format_value(mkfloat(im), sgn || alt || sp || s2)
    if unw > 0 then return ""
  end
  s2 = rs || ims || "j"
  if parens = 1 then s2 = "(" || s2 || ")"
  if align == "" then align = ">"
  return fmt_pad("", s2, fill, align, width)

/* complex("1+2j") */
cplx_parse: procedure = .int
  arg s0 = .string
  s = .string
  n = .int
  i = .int
  c = .string
  p = .int
  rs = .string
  ims = .string
  re = .float
  im = .float
  v = .int
  hasj = .int
  s = strip(s0)
  if left(s, 1) == "(" & right(s, 1) == ")" then s = strip(substr(s, 2, length(s) - 2))
  n = length(s)
  if n = 0 then return raise_exc(36, "complex() arg is a malformed string")
  re = 0.0
  im = 0.0
  hasj = 0
  if lower(right(s, 1)) == "j" then hasj = 1
  if hasj = 0 then do
    v = parse_float_str(s)
    if v = 0 then do
      unw = 0
      return raise_exc(36, "complex() arg is a malformed string")
    end
    return mkcplx(ob_f[v % 2], 0.0)
  end
  s = left(s, n - 1)
  n = n - 1
  /* split at the last + or - that is not at the start and does not follow an exponent letter */
  p = 0
  do i = n to 2 by -1
    c = substr(s, i, 1)
    if c == "+" | c == "-" then do
      if lower(substr(s, i - 1, 1)) \== "e" then do
        p = i
        leave
      end
    end
  end
  if p = 0 then do
    rs = ""
    ims = s
  end
  else do
    rs = left(s, p - 1)
    ims = substr(s, p)
  end
  if ims == "" | ims == "+" then ims = "1"
  else if ims == "-" then ims = "-1"
  if rs \== "" then do
    v = parse_float_str(rs)
    if v = 0 then do
      unw = 0
      return raise_exc(36, "complex() arg is a malformed string")
    end
    re = ob_f[v % 2]
  end
  v = parse_float_str(ims)
  if v = 0 then do
    unw = 0
    return raise_exc(36, "complex() arg is a malformed string")
  end
  im = ob_f[v % 2]
  return mkcplx(re, im)

/* complex(...) */
ctor_complex: procedure = .int
  arg base = .int, na = .int, nk = .int
  a = .int
  b = .int
  ar = .float
  ai = .float
  br = .float
  bi = .float
  m = .int
  a = 0
  b = 0
  if na >= 1 then a = ast[base + 1]
  if na >= 2 then b = ast[base + 2]
  if kwarg(base, na, nk, "real") \= 0 then a = kwarg(base, na, nk, "real")
  if kwarg(base, na, nk, "imag") \= 0 then b = kwarg(base, na, nk, "imag")
  if na > 2 then return nargs_err("complex", na, 0, 2)
  if a = 0 & b = 0 then return mkcplx(0.0, 0.0)
  if a \= 0 then do
    if kind_of(a) = 6 then do
      if b \= 0 then return raise_exc(38, "complex() can't take second arg if first is a string")
      return cplx_parse(ob_s[a % 2])
    end
    if kind_of(a) \= 32 & numkind(a) = 0 then do
      m = ovr(a, nameid("__complex__"))
      if m > 0 then return call1(m, a)
      return raise_exc(38, "complex() first argument must be a string or a number, not '" || type_name(a) || "'")
    end
  end
  if b \= 0 then do
    if kind_of(b) = 6 then return raise_exc(38, "complex() second arg can't be a string")
    if kind_of(b) \= 32 & numkind(b) = 0 then return raise_exc(38, "complex() second argument must be a number, not '" || type_name(b) || "'")
  end
  if b = 0 then do
    if kind_of(a) = 32 then return a
    return mkcplx(tofloat(a), 0.0)
  end
  if kind_of(b) \= 32 then do
    if a = 0 then return mkcplx(0.0, tofloat(b))
    if kind_of(a) \= 32 then return mkcplx(tofloat(a), tofloat(b))
  end
  ar = 0.0
  ai = 0.0
  if a \= 0 then do
    call cplx_get a
    ar = cx_re
    ai = cx_im
  end
  call cplx_get b
  br = cx_re
  bi = cx_im
  /* a + b*1j */
  return mkcplx(ar - bi, ai + br)

meth_complex: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  if nid = 18 then return mkcplx(ob_f[o % 2], fneg(ob_g[o % 2]))
  return meth_common(o, nid, base, na, nk)

/* ---- elementary functions on a complex number (re, im) -> cr_r, cr_i (as CPython's cmath / C99) ---- */
c_sqrt: procedure = .void
  arg re = .float, im = .float
  ar = .float
  ai = .float
  s = .float
  d = .float
  if re = 0.0 & im = 0.0 then do
    cr_r = 0.0
    cr_i = im
    return
  end
  ar = rxfloat..fabs(re) / 8.0
  ai = rxfloat..fabs(im)
  s = 2.0 * rxfloat..sqrt(ar + rxfloat..hypot(ar, ai / 8.0))
  d = ai / (2.0 * s)
  if re >= 0.0 then do
    cr_r = s
    cr_i = d
    if im < 0.0 | fl_negzero(im) = 1 then cr_i = fneg(d)
  end
  else do
    cr_r = d
    cr_i = s
    if im < 0.0 | fl_negzero(im) = 1 then cr_i = fneg(s)
  end
  return

c_exp: procedure = .void
  arg re = .float, im = .float
  l = .float
  if im = 0.0 then do
    cr_r = rxfloat..exp(re)
    cr_i = im
    return
  end
  l = rxfloat..exp(re)
  cr_r = l * rxfloat..cos(im)
  cr_i = l * rxfloat..sin(im)
  return

c_log: procedure = .void
  arg re = .float, im = .float
  cr_r = rxfloat..log(rxfloat..hypot(re, im))
  cr_i = rxfloat..atan2(im, re)
  return

/* ---- bridge to pylib numpy/_cplx.py (complex128 arrays are implemented there) ---- */
is_cx: procedure = .int
  arg v = .int
  k = .int
  if v // 2 \= 0 then return 0
  k = ob_k[v % 2]
  if k = 32 then return 1
  if k = 17 then do
    if cl_name[ob_c[v % 2]] == "_CArr" then return 1
  end
  return 0

/* a _CArr instance (complex128 array) */
is_carr: procedure = .int
  arg v = .int
  if v // 2 \= 0 then return 0
  if ob_k[v % 2] = 17 then do
    if cl_name[ob_c[v % 2]] == "_CArr" then return 1
  end
  return 0

cx_func: procedure = .int
  arg fname = .string
  m = .int
  m = import_mod("numpy._cplx")
  if m = 0 then return 0
  return getattr_obj(m, nameid(fname), 0)

/* call function fname of module mname with one argument */
cx_call1_in: procedure = .int
  arg mname = .string, fname = .string, a = .int
  m = .int
  f = .int
  m = import_mod(mname)
  if m = 0 then return 0
  f = getattr_obj(m, nameid(fname), 0)
  if f = 0 then return 0
  return call1(f, a)

cx_call1: procedure = .int
  arg fname = .string, a = .int
  f = .int
  f = cx_func(fname)
  if f = 0 then return 0
  return call1(f, a)

cx_dispatch: procedure = .int
  arg bid = .int, base = .int, na = .int, nk = .int
  f = .int
  t = .int
  d = .int
  j = .int
  f = cx_func("_dispatch")
  if f = 0 then return 0
  t = tup_from_ast(base + 1, base + na)
  d = dict_new(9)
  do j = 1 to nk
    call dict_put d, "s" || asn[base + na + j], mkstr(asn[base + na + j]), ast[base + na + j]
  end
  return call3(f, mkstr(bi_name[bid]), t, d)

/* ---------------------------------------------------------------------
   User subclasses of built-in types, __new__

   An instance of class Sub(list) is an ordinary native list object (K_LIST) whose ob_c field holds
   the class id of Sub.  Instance attributes live in a K_INST "holder" object (stem xa).  The
   interpreter operations ask nsov(x, name) for a user-defined override before the native action.
   --------------------------------------------------------------------- */

/* class id when x is a native object that is an instance of a user subclass, else 0 */
nsub: procedure = .int
  arg x = .int
  k = .int
  if x // 2 \= 0 then return 0
  k = ob_k[x % 2]
  if k >= 6 & k <= 10 then return ob_c[x % 2]
  if k = 5 | k = 4 | k = 31 then return ob_c[x % 2]
  return 0

/* the user-defined method nid of a subclass instance (0 if none or when explicitly bypassed) */
nsov: procedure = .int
  arg x = .int, nid = .int
  c = .int
  c = nsub(x)
  if c = 0 then return 0
  if nat_skip = x then do
    nat_skip = 0
    return 0
  end
  return cls_find(c, nid)

/* class id of a K_INST or a native subclass instance, else 0 */
ocls: procedure = .int
  arg x = .int
  if x // 2 \= 0 then return 0
  if ob_k[x % 2] = 17 then return ob_c[x % 2]
  return nsub(x)

/* like nsov for K_INST and native subclass instances */
ovr: procedure = .int
  arg x = .int, nid = .int
  c = .int
  c = ocls(x)
  if c = 0 then return 0
  if nat_skip = x then do
    nat_skip = 0
    return 0
  end
  return cls_find(c, nid)

nat_holder: procedure = .int
  arg x = .int
  v = .string
  v = nat_at["h" || x]
  if v == "" then return 0
  return v as .int

nat_holder_make: procedure = .int
  arg x = .int
  h = .int
  h = nat_holder(x)
  if h = 0 then do
    h = inst_new(ob_c[x % 2])
    nat_at["h" || x] = h as .string
  end
  return h

/* attribute of a subclass instance found in its own attributes or its class; 0 when absent */
nat_getattr: procedure = .int
  arg o = .int, c = .int, nid = .int
  h = .int
  v = .int
  h = nat_holder(o)
  if h > 0 then do
    v = inst_get(h, nid)
    if v \= 0 then return v
  end
  v = cls_find(c, nid)
  if v > 0 then return bind_attr(v, o, c)
  if nid = 139 then return cl_obj[c]
  if nid = 143 then return inst_dict(nat_holder_make(o))
  return 0

nat_setattr: procedure = .void
  arg o = .int, c = .int, nid = .int, v = .int, raw = .int
  p = .int
  r = .int
  p = cls_find(c, nid)
  if p > 0 then do
    if kind_of(p) = 22 then do
      if ob_y[p % 2] = 0 then do
        r = raise_exc(41, "can't set attribute '" || nid_name[nid] || "'")
        return
      end
      r = call2(ob_y[p % 2], o, v)
      return
    end
  end
  if raw = 0 then do
    p = cls_find(c, 195)
    if p > 0 then do
      r = call3(p, o, mkstr(nid_name[nid]), v)
      return
    end
  end
  call inst_set nat_holder_make(o), nid, v
  return

/* an empty mutable native object of built-in type bt, an instance of class c */
nat_empty: procedure = .int
  arg bt = .int, c = .int
  o = .int
  if bt = 7 then o = mklist(4)
  else if bt = 9 then o = dict_new(9)
  else if bt = 10 then o = dict_new(10)
  else if bt = 84 then o = mkbytearr("")
  else o = mklist(4)
  ob_c[o % 2] = c
  return o

/* a copy of the plain native value v (built-in type bt) as an instance of class c */
nat_wrap: procedure = .int
  arg v = .int, bt = .int, c = .int
  o = .int
  i = .int
  if bt = 8 then do
    o = mktuple(ob_n[v % 2])
    do i = 0 to ob_n[v % 2] - 1
      sl[ob_p[o % 2] + i] = sl[ob_p[v % 2] + i]
    end
  end
  else if bt = 6 then o = mkstr(ob_s[v % 2])
  else if bt = 3 then o = mkbig(num_str(v))
  else if bt = 4 then o = mkfloat(tofloat(v))
  else if bt = 83 then o = mkbytes(ob_s[v % 2])
  else if bt = 84 then o = mkbytearr(ob_s[v % 2])
  else if bt = 7 then do
    o = mklist(ob_n[v % 2])
    call list_extend_from o, v
  end
  else if bt = 9 | bt = 10 then do
    o = dict_new(ob_k[v % 2])
    call dict_update o, v
    ob_y[o % 2] = ob_y[v % 2]
  end
  else return v
  ob_c[o % 2] = c
  return o

/* fill the empty mutable object o from constructor arguments (list(x), dict(x, **kw), set(x)) */
nat_fill: procedure = .int
  arg o = .int, bt = .int, base = .int, na = .int, nk = .int
  tmp = .int
  tmp = bcall_type(bt, base, na, nk)
  if tmp = 0 then return 0
  if bt = 7 then call list_extend_from o, tmp
  else if bt = 84 then ob_s[o % 2] = ob_s[tmp % 2]
  else call dict_update o, tmp
  return 1

/* call the user-defined __init__ init with the receiver o and the call arguments; 0 on error */
call_init: procedure = .int
  arg init = .int, o = .int, base = .int, na = .int, nk = .int
  r = .int
  call ast_insert base, na + nk, o
  r = docall(init, base, na + 1, nk)
  if r = 0 then return 0
  if r \= 2 then return raise_exc(38, "__init__() should return None, not '" || type_name(r) || "'")
  return 1

/* instantiate a class that derives from a built-in container / value type */
inst_native: procedure = .int
  arg c = .int, base = .int, na = .int, nk = .int
  bt = .int
  init = .int
  userinit = .int
  o = .int
  v = .int
  bt = cl_bt[c]
  init = cls_find(c, 160)
  userinit = 0
  if init > 0 then do
    if kind_of(init) = 12 then userinit = 1
  end
  if bt = 7 | bt = 9 | bt = 10 | bt = 84 then do
    o = nat_empty(bt, c)
    if userinit = 1 then do
      if call_init(init, o, base, na, nk) = 0 then return 0
    end
    else if na + nk > 0 then do
      if nat_fill(o, bt, base, na, nk) = 0 then return 0
    end
    return o
  end
  v = bcall_type(bt, base, na, nk)
  if v = 0 then return 0
  o = nat_wrap(v, bt, c)
  if userinit = 1 then do
    if call_init(init, o, base, na, nk) = 0 then return 0
  end
  return o

/* class c has a user-defined __new__ nw: new = nw(cls, *args); then __init__ when it is an instance */
inst_with_new: procedure = .int
  arg c = .int, nw = .int, base = .int, na = .int, nk = .int
  r = .int
  init = .int
  call ast_insert base, na + nk, cl_obj[c]
  r = docall(nw, base, na + 1, nk)
  if r = 0 then return 0
  if cls_issub(cls_of(r), c) = 0 then return r
  init = cls_find(c, 160)
  if init > 0 then do
    if kind_of(init) = 12 then do
      ast[base + 1] = r
      if docall_init(init, base, na + 1, nk) = 0 then return 0
    end
  end
  return r

docall_init: procedure = .int
  arg init = .int, base = .int, na = .int, nk = .int
  r = .int
  r = docall(init, base, na, nk)
  if r = 0 then return 0
  if r \= 2 then return raise_exc(38, "__init__() should return None, not '" || type_name(r) || "'")
  return 1

/* X.__new__(cls, args...) for the built-in type bc: ast[base+1] = cls */
cls_new: procedure = .int
  arg bc = .int, base = .int, na = .int, nk = .int
  tc = .int
  v = .int
  o = .int
  if na < 1 then return raise_exc(38, cl_name[bc] || ".__new__(): not enough arguments")
  if kind_of(ast[base + 1]) \= 16 then return raise_exc(38, cl_name[bc] || ".__new__(X): X is not a type object (" || type_name(ast[base + 1]) || ")")
  tc = ob_x[ast[base + 1] % 2]
  if cls_issub(tc, bc) = 0 then return raise_exc(38, cl_name[bc] || ".__new__(" || cl_name[tc] || "): " || cl_name[tc] || " is not a subtype of " || cl_name[bc])
  if bc = 1 | (cl_flags[bc] // 4) >= 2 then do
    if cl_bt[tc] > 0 then return nat_empty(cl_bt[tc], tc)
    o = inst_new(tc)
    if (cl_flags[tc] // 4) >= 2 then call inst_set o, 8, tup_from_ast(base + 2, base + na)
    return o
  end
  if bc = 7 | bc = 9 | bc = 10 | bc = 84 then do
    o = nat_empty(bc, tc)
    if bc = 10 & na > 1 then do
      if nat_fill(o, bc, base + 1, na - 1, nk) = 0 then return 0
    end
    return o
  end
  v = bcall_type(bc, base + 1, na - 1, nk)
  if v = 0 then return 0
  if tc = bc then return v
  return nat_wrap(v, bc, tc)

/* the built-in base class that follows the defining class of super object o in the linearisation */
super_base: procedure = .int
  arg o = .int
  selfv = .int
  dcls = .int
  start = .int
  i = .int
  p = .int
  k = .int
  selfv = ob_x[o % 2]
  dcls = ob_x[ob_y[o % 2] % 2]
  if kind_of(selfv) = 16 then start = ob_x[selfv % 2]
  else start = cls_of(selfv)
  p = cl_mn[start]
  do i = 0 to cl_mn[start] - 1
    if mro_a[cl_ms[start] + i] = dcls then do
      p = i
      leave
    end
  end
  do i = p + 1 to cl_mn[start] - 1
    k = mro_a[cl_ms[start] + i]
    if cl_flags[k] // 2 = 1 then return k
  end
  return 1

/* iterator for the result of a user-defined __iter__ */
iter_wrap: procedure = .int
  arg r = .int
  if r = 0 then return 0
  if kind_of(r) = 19 | kind_of(r) = 20 then return r
  if kind_of(r) = 17 then do
    if cls_find(ob_c[r % 2], 177) > 0 then return mkiter(7, r, 0)
  end
  if kind_of(r) = 7 | kind_of(r) = 8 then return mkiter(1, r, 0)
  return raise_exc(38, "iter() returned non-iterator of type '" || type_name(r) || "'")

/* the plain int for an instance of an int subclass (small values are stored as K_BIG), else x */
unsub: procedure = .int
  arg x = .int
  if x // 2 \= 0 then return x
  if ob_k[x % 2] = 4 then do
    if ob_c[x % 2] > 0 then return big_norm(ob_s[x % 2])
  end
  return x

/* ---------------------------------------------------------------------
   _sock(op, h, a, b): thin access to the rxsocket library for pylib/socket.py
   --------------------------------------------------------------------- */
sock_call: procedure = .int
  arg base = .int, na = .int
  op = .int
  h = .int
  r = .int
  s = .string
  bin = .binary
  if na < 2 then return raise_exc(38, "_sock() needs an operation and a handle")
  op = ival(ast[base + 1])
  h = ival(ast[base + 2])
  select
    when op = 1 then return mkint(socketcreate())
    when op = 2 then return mkint(socketclose(h))
    when op = 3 then return mkint(socketconnect(h, ob_s[ast[base + 3] % 2], ival(ast[base + 4])))
    when op = 4 then return mkint(socketbind(h, ob_s[ast[base + 3] % 2], ival(ast[base + 4])))
    when op = 5 then return mkint(socketlisten(h, ival(ast[base + 3])))
    when op = 6 then return mkint(socketaccept(h))
    when op = 7 then do
      s = ob_s[ast[base + 3] % 2]
      if length(s) = 0 then return mkint(0)
      bin = x2bin(c2x(s))
      return mkint(socketsendb(h, bin))
    end
    when op = 8 then do
      bin = socketrecvb(h, ival(ast[base + 3]))
      s = bin2x(bin)
      if length(s) = 0 then return mkbytes("")
      return mkbytes(x2c(s))
    end
    when op = 9 then return mkint(sockettimeout(h, ival(ast[base + 3])))
    when op = 10 then return mkint(socketstatus(h))
    when op = 11 then return mkstr(socketerror(h))
    when op = 12 then return mkstr(socketpeer(h))
    when op = 13 then return mkstr(socketlocal(h))
    when op = 14 then return mkint(socketshutdown(h, ival(ast[base + 3])))
    when op = 15 then return mkint(socketblocking(h, ival(ast[base + 3])))
    when op = 16 then return mkint(socketnodelay(h, ival(ast[base + 3])))
    when op = 17 then return mkint(socketpending(h))
    otherwise nop
  end
  return 2

/* ---------------------------------------------------------------------
   Garbage collector for the object table.

   Objects that are allocated while a "window" is open (a loop or a function call in progress) are
   recorded in the young list yl[1 .. ny].  A loop calls gc_run at the end of an iteration, a function
   call calls it just before it returns, with pm = ny as it was when the loop / call started.  The
   objects yl[pm+1 .. ny] were created by code that has finished (the iteration, the call): no
   CREXX register of an enclosing evaluation can hold them, except the return value rv.  They are
   live only if they are reachable from an object that is not young (an "old" mutable container),
   from the frames / argument stack / tables below, or from rv.  Everything else is freed to the
   object free list; the slot blocks, dictionary entries and dictionary numbers they own are
   recycled.  Classes, modules, generators, files and builtins are never freed.
   --------------------------------------------------------------------- */
gc_mark: procedure = .void
  arg v = .int
  i = .int
  k = .int
  if v < 2 then return
  if v // 2 \= 0 then return
  i = v % 2
  if i > nob then return
  k = ob_k[i]
  if k < 200 | k >= 400 then return
  ob_k[i] = k + 200
  k = k - 200
  if (k >= 7 & k <= 10) | k = 12 | k = 14 | k = 15 | k = 17 | (k >= 20 & k <= 25) | k = 29 | k = 30 then do
    gsp = gsp + 1
    gstk[gsp] = i
  end
  return

/* mark the children of object i (real kind k) */
/* mark a finished function frame that a closure can still reach, and what it holds */
fr_mark: procedure = .void
  arg fb = .int
  j = .int
  w = .int
  ix = .int
  kk = .int
  fcm[fb] = 2
  do j = 1 to fcs[fb] - 1
    w = vp[fb + j]
    if w > 1 then do
      if w // 2 = 0 then do
        ix = w % 2
        if ix <= nob then do
          kk = ob_k[ix]
          if kk >= 200 & kk < 400 then call gc_mark w
        end
      end
      if w <= nvp then do
        if fcm[w] = 1 then call fr_mark w
      end
    end
  end
  return

gc_scan: procedure = .void
  arg i = .int, k = .int
  j = .int
  n = .int
  st = .int
  v = .int
  e = .int
  d = .int
  ix = .int
  kk = .int
  hv = .string
  if k = 7 | k = 8 | k = 17 then do
    n = ob_n[i]
    st = ob_p[i]
    do j = 0 to n - 1
      v = sl[st + j]
      if v > 1 then do
        if v // 2 = 0 then do
          ix = v % 2
          kk = ob_k[ix]
          if kk >= 200 & kk < 400 then call gc_mark v
        end
      end
    end
    if k \= 17 & ob_c[i] > 0 then do
      hv = nat_at["h" || (i * 2)]
      if hv \== "" then call gc_mark hv as .int
    end
    return
  end
  if k = 9 | k = 10 then do
    d = ob_x[i]
    e = dd_head[d]
    do while e > 0
      if de_live[e] = 1 then do
        call gc_mark de_key[e]
        call gc_mark de_val[e]
      end
      e = de_next[e]
    end
    if dd_own[d] > 0 then call gc_mark dd_own[d]
    if ob_c[i] > 0 then do
      hv = nat_at["h" || (i * 2)]
      if hv \== "" then call gc_mark hv as .int
    end
    return
  end
  if k = 12 then do
    n = ob_y[i]
    if n > 1 & n <= nvp then do
      if fcm[n] = 1 then call fr_mark n
    end
    n = fd_nr[ob_x[i]]
    st = ob_p[i]
    do j = 0 to n - 1
      call gc_mark sl[st + j]
    end
    return
  end
  if k = 14 then do
    call gc_mark ob_x[i]
    call gc_mark ob_y[i]
    return
  end
  if k = 29 then do
    hv = ob_s[i]
    if hv \== "" then call gc_mark hv as .int
    return
  end
  if k = 15 then do
    call gc_mark ob_y[i]
    return
  end
  if k = 30 then do
    call gc_mark ob_x[i]
    return
  end
  if k = 20 then do
    if ob_n[i] = 9 | ob_n[i] = 10 then do
      n = ob_c[i]
      st = ob_p[i]
      do j = 0 to n - 1
        call gc_mark sl[st + j]
      end
    end
  end
  /* iterators, slices, property / static / class methods, super: any field may hold an object */
  call gc_mark ob_c[i]
  call gc_mark ob_n[i]
  call gc_mark ob_x[i]
  call gc_mark ob_y[i]
  return

/* release the storage owned by the unreachable object i (kind k) and put it on the free list */
gc_free: procedure = .void
  arg i = .int, k = .int
  d = .int
  e = .int
  nx = .int
  g = .int
  fd = .int
  cap = .int
  rb = .int
  j = .int
  if k = 5 & gcpoison = 0 then do
    if ob_c[i] \= 0 then ob_c[i] = 0
    ob_k[i] = 0
    ob_n[i] = fo_head
    fo_head = i
    return
  end
  if k = 7 | k = 8 then do
    if ob_c[i] > 0 then nat_at["h" || (i * 2)] = ""
    call free_block ob_p[i], ob_x[i]
  end
  else if k = 17 then call free_block ob_p[i], ob_n[i]
  else if k = 20 then do
    if ob_n[i] = 9 | ob_n[i] = 10 then call free_block ob_p[i], ob_c[i]
    else if ob_n[i] = 18 then call free_block ob_p[i], 3
  end
  else if k = 12 then call free_block ob_p[i], fd_nr[ob_x[i]] + 1
  else if k = 29 then do
    if ob_y[i] > 0 & ob_x[i] > 0 then call free_block ob_y[i], ob_x[i]
    if ob_s[i] == "" then do
      if ob_c[i] = 2 then call np_ffree ob_p[i], ob_n[i]
      else call free_block ob_p[i], ob_n[i]
    end
  end
  else if k = 19 then do
    g = ob_x[i]
    fd = gn_fd[g]
    if gn_st[g] \= 2 & fd > 0 then do
      if (fd_fl[fd] // 4) < 2 then call free_frame gn_fb[g], fd_ns[fd]
      cap = fd_gd[fd]
      rb = gn_rb[g]
      do j = 1 to cap + 1
        gs_n[rb + j] = 0
        gs_s[rb + j] = 0
        gs_a[rb + j] = 0
        gs_b[rb + j] = 0
      end
      if gcpoison = 0 then do
        gs_s[rb + 1] = gsf[cap]
        gsf[cap] = rb
        gn_fd[g] = 0
        gn_val[g] = 0
        gn_ret[g] = 0
        gn_st[g] = 3
        gn_nx[g] = gn_fh
        gn_fh = g
      end
    end
  end
  else if k = 9 | k = 10 then do
    if ob_c[i] > 0 then nat_at["h" || (i * 2)] = ""
    d = ob_x[i]
    if d > 0 then do
      e = dd_head[d]
      do while e > 0
        nx = de_next[e]
        if de_live[e] = 1 then dmap[d || "|" || de_hk[e]] = ""
        de_key[e] = 0
        de_val[e] = 0
        de_live[e] = 0
        de_hk[e] = ""
        de_next[e] = de_fh
        de_fh = e
        e = nx
      end
      dd_head[d] = 0
      dd_n[d] = 0
      dd_own[d] = 0
      dd_tail[d] = dd_fh
      dd_fh = d
    end
  end
  if gcpoison = 1 then do
    /* stress mode: the slot is never reused, every field is poisoned so that a dangling reference fails loudly */
    ob_c[i] = 0 - 4
    ob_x[i] = 0 - 4
    ob_y[i] = 0 - 4
    ob_p[i] = 0 - 4
    ob_n[i] = 0 - 4
    ob_s[i] = "@@freed@@"
    ob_k[i] = 0
    return
  end
  ob_c[i] = 0
  ob_x[i] = 0
  ob_y[i] = 0
  ob_p[i] = 0
  ob_s[i] = ""
  ob_f[i] = 0.0
  ob_g[i] = 0.0
  ob_k[i] = 0
  ob_n[i] = fo_head
  fo_head = i
  return

gc_run: procedure = .void
  arg pm = .int, rv = .int
  i = .int
  j = .int
  k = .int
  n = .int
  st = .int
  sz = .int
  fb = .int
  nx = .int
  nk = .int
  cnt = .int
  v = .int
  sv = .string
  imm = .int
  ix = .int
  kk = .int
  cnt = 0
  gc_count = gc_count + 1
  /* blocks that were replaced by list growth */
  do while orph_h > 0
    st = orph_h
    orph_h = sl[st]
    n = sl[st + 1]
    call free_block st, n
  end
  /* free frames hold stale values */
  do sz = 1 to maxfs
    fb = fl_head[sz]
    do while fb > 0
      nx = vp[fb]
      do j = 1 to sz - 1
        vp[fb + j] = 0
      end
      fb = nx
    end
  end
  /* compact the list of containers */
  n = 0
  do j = 1 to nct
    i = ctl[j]
    k = ob_k[i]
    if k = 7 | k = 9 | k = 10 | k = 17 | k = 20 | k = 12 then do
      ob_k[i] = k + 1000
      n = n + 1
      ctl[n] = i
    end
  end
  do j = 1 to n
    i = ctl[j]
    ob_k[i] = ob_k[i] - 1000
  end
  nct = n
  /* phase 0: flag the window as young */
  do j = pm + 1 to ny
    i = yl[j]
    k = ob_k[i]
    if k = 5 | k = 6 then ob_k[i] = k + 200
    else do
      imm = 0
      if k = 16 | k = 18 | k = 26 | k = 13 | k = 1 | k = 2 | k = 27 | k = 28 then imm = 1
      else if k = 12 & ob_c[i] = 1 then imm = 1
      if imm = 0 then ob_k[i] = k + 200
    end
  end
  gsp = 0
  /* phase 1: roots */
  call gc_mark rv
  call gc_mark unw_v
  call gc_mark exc_cur
  call gc_mark ev_self
  call gc_mark gen_throw
  j = 1
  do while j <= nvp
    if fcm[j] > 0 then j = j + fcs[j]
    else do
      v = vp[j]
      if v > 1 then do
        if v // 2 = 0 then do
          ix = v % 2
          if ix <= nob then do
            kk = ob_k[ix]
            if kk >= 200 & kk < 400 then call gc_mark v
          end
        end
        if v <= nvp then do
          if fcm[v] = 1 then call fr_mark v
        end
      end
      j = j + 1
    end
  end
  n = ast.0
  if n > asp + 256 then n = asp + 256
  do j = 1 to n
    v = ast[j]
    if v > 1 then do
      if v // 2 = 0 then do
        ix = v % 2
        if ix <= nob then do
          kk = ob_k[ix]
          if kk >= 200 & kk < 400 then call gc_mark v
        end
      end
    end
  end
  n = chr_oop.0
  do j = 1 to n
    call gc_mark chr_oop[j]
  end
  n = bi_oop.0
  do j = 1 to n
    call gc_mark bi_oop[j]
  end
  n = cl_obj.0
  do j = 1 to n
    call gc_mark cl_obj[j]
  end
  n = cl_dflt.0
  do j = 1 to n
    call gc_mark cl_dflt[j]
  end
  n = mod_obj.0
  do j = 1 to n
    call gc_mark mod_obj[j]
  end
  n = dyn_val.0
  do j = 1 to n
    call gc_mark dyn_val[j]
  end
  n = cd_obj.0
  do j = 1 to n
    call gc_mark cd_obj[j]
  end
  n = gn_val.0
  do j = 1 to n
    call gc_mark gn_val[j]
  end
  n = gn_ret.0
  do j = 1 to n
    call gc_mark gn_ret[j]
  end
  n = gs_a.0
  do j = 1 to n
    call gc_mark gs_a[j]
  end
  n = gs_b.0
  do j = 1 to n
    call gc_mark gs_b[j]
  end
  n = ca.size()
  do j = 1 to n
    sv = ca.value(j)
    if sv \== "" then call gc_mark sv as .int
  end
  n = fnattr.size()
  do j = 1 to n
    sv = fnattr.value(j)
    if sv \== "" then call gc_mark sv as .int
  end
  n = modo.size()
  do j = 1 to n
    sv = modo.value(j)
    if sv \== "" then call gc_mark sv as .int
  end
  n = modattr.size()
  do j = 1 to n
    sv = modattr.value(j)
    if sv \== "" then call gc_mark sv as .int
  end
  n = modx.size()
  do j = 1 to n
    sv = modx.value(j)
    if sv \== "" then call gc_mark sv as .int
  end
  n = nat_at.size()
  do j = 1 to n
    sv = nat_at.value(j)
    if sv \== "" then call gc_mark sv as .int
  end
  n = bimap.size()
  do j = 1 to n
    sv = bimap.value(j)
    if sv \== "" then call gc_mark sv as .int
  end
  /* old mutable containers may point to young objects */
  do j = 1 to nct
    i = ctl[j]
    k = ob_k[i]
    if k < 100 then call gc_scan i, k
  end
  /* transitive closure */
  do while gsp > 0
    i = gstk[gsp]
    gsp = gsp - 1
    call gc_scan i, ob_k[i] - 400
  end
  /* finished closure frames that nothing reaches any more */
  n = 0
  do j = 1 to ncf
    fb = cfl[j]
    if fcm[fb] = 2 then do
      fcm[fb] = 1
      n = n + 1
      cfl[n] = fb
    end
    else do
      fcm[fb] = 0
      call free_frame fb, fcs[fb]
    end
  end
  ncf = n
  npw = 0
  /* phase 2: sweep the window */
  nk = pm
  do j = pm + 1 to ny
    i = yl[j]
    k = ob_k[i]
    if k >= 400 then do
      ob_k[i] = k - 400
      nk = nk + 1
      yl[nk] = i
    end
    else if k >= 200 then do
      call gc_free i, k - 200
      cnt = cnt + 1
    end
  end
  ny = nk
  gc_freed = gc_freed + cnt
  /* next collection after as many allocations as there are survivors, and live objects / 2 */
  gcthr = nk - pm
  if gcthr < nct then gcthr = nct
  if gcthr < gcmin then gcthr = gcmin
  if gcfix > 0 then gcthr = gcfix
  return

