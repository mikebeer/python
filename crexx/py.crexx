  bboot = bboot || " sys.getrecursionlimit numpy.array numpy.asarray numpy.zeros numpy.ones numpy.empty numpy.full numpy.zeros_like numpy.ones_like numpy.full_like"
  bboot = bboot || " numpy.eye numpy.identity numpy.arange numpy.linspace numpy.sqrt numpy.abs numpy.exp numpy.sin numpy.cos numpy.tan numpy.log numpy.log10 numpy.log2"
