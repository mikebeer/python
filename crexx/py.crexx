  clsboot = clsboot || " BytesWarning/61/3/1 ResourceWarning/61/3/1 MemoryError/28/3/1 BufferError/28/3/1 TimeoutError/53/3/1 PermissionError/53/3/1 FileExistsError/53/3/1"
  clsboot = clsboot || " IsADirectoryError/53/3/1 NotADirectoryError/53/3/1 UnicodeDecodeError/37/3/1 UnicodeEncodeError/37/3/1 IndentationError/52/3/1"
  clsboot = clsboot || " StopAsyncIteration/28/3/1 bytes/1/1/1 bytearray/1/1/1 complex/1/1/1 ConnectionError/53/3/1 ConnectionRefusedError/86/3/1 ConnectionResetError/86/3/1"
