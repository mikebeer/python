/* ---------------------------------------------------------------------
   Objects.  An oop is 2*index for heap objects, 2*n+1 for small integers.
   --------------------------------------------------------------------- */
newobj: procedure = .int
  arg kind = .int
  i = .int
  i = fo_head
  if i > 0 then do
    fo_head = ob_n[i]
    ob_n[i] = 0
  end
  else do
    nob = nob + 1
    i = nob
  end
  if wd > 0 then do
    ny = ny + 1
    yl[ny] = i
  end
  ob_k[i] = kind
  if kind = K_LIST | kind = K_DICT | kind = K_SET | kind = K_INST | kind = K_ITER | kind = K_FUNC then do
    nct = nct + 1
    ctl[nct] = i
  end
  return i * 2

mkint: procedure = .int
  arg n = .int
  if n > SMALLMAX | n < 0 - SMALLMAX then return big_norm(n as .string)
  return n * 2 + 1

ival: procedure = .int
  arg x = .int
  if x // 2 \= 0 then return (x - 1) % 2
  if x = TRUE_OOP then return 1
  if ob_k[x % 2] = K_BIG then do
    if ob_c[x % 2] > 0 then do
      if length(ob_s[x % 2]) <= 18 then return ob_s[x % 2] as .int
    end
  end
  return 0

mkstr: procedure = .int
  arg s = .string
  i = .int
  i = fo_head
  if i > 0 then do
    fo_head = ob_n[i]
    ob_n[i] = 0
  end
  else do
    nob = nob + 1
    i = nob
  end
  if wd > 0 then do
    ny = ny + 1
    yl[ny] = i
  end
  ob_k[i] = K_STR
  ob_s[i] = s
  return i * 2

mkfloat: procedure = .int
  arg f = .float
  i = .int
  i = fo_head
  if i > 0 then do
    fo_head = ob_n[i]
    ob_n[i] = 0
  end
  else do
    nob = nob + 1
    i = nob
  end
  if wd > 0 then do
    ny = ny + 1
    yl[ny] = i
  end
  ob_k[i] = K_FLOAT
  ob_f[i] = f
  return i * 2

mkbool: procedure = .int
  arg b = .int
  if b = 1 then return TRUE_OOP
  return FALSE_OOP

/* big integer from a decimal string (may need normalising) */
mkbig: procedure = .int
  arg s = .string
  o = .int
  o = newobj(K_BIG)
  ob_s[o % 2] = s
  return o

alloc_slots: procedure = .int
  arg n = .int
  st = .int
  v = .string
  if n > 0 then do
    if n <= 64 then do
      st = sfl[n]
      if st > 0 then do
        sfl[n] = sl[st]
        sl[st] = 0
        return st
      end
    end
    else if nbfl > 0 then do
      v = bfl[n]
      if v \== "" then do
        st = v as .int
        if st > 0 then do
          bfl[n] = sl[st] as .string
          sl[st] = 0
          nbfl = nbfl - 1
          return st
        end
      end
    end
  end
  st = nsl + 1
  nsl = nsl + n
  if n > 0 then sl[nsl] = 0
  return st

/* give the (zeroed) block st of n slots back to the allocator */
free_block: procedure = .void
  arg st = .int, n = .int
  i = .int
  if st <= 0 | n <= 0 then return
  if gcpoison = 1 then do
    do i = 0 to n - 1
      sl[st + i] = 0 - 4
    end
    return
  end
  do i = 0 to n - 1
    sl[st + i] = 0
  end
  if n <= 64 then do
    sl[st] = sfl[n]
    sfl[n] = st
  end
  else do
    if bfl[n] == "" then sl[st] = 0
    else sl[st] = bfl[n] as .int
    bfl[n] = st as .string
    nbfl = nbfl + 1
  end
  return

/* a block that was replaced while a primitive may still hold its address: freed at the next collection */
orphan_block: procedure = .void
  arg st = .int, n = .int
  if st <= 0 | n < 2 | wd = 0 then return
  sl[st] = orph_h
  sl[st + 1] = n
  orph_h = st
  return

mklist: procedure = .int
  arg cap = .int
  o = .int
  o = newobj(K_LIST)
  if cap < 4 then cap = 4
  ob_p[o % 2] = alloc_slots(cap)
  ob_x[o % 2] = cap
  return o

mktuple: procedure = .int
  arg n = .int
  o = .int
  o = newobj(K_TUPLE)
  ob_p[o % 2] = alloc_slots(n)
  ob_n[o % 2] = n
  ob_x[o % 2] = n
  return o

list_append: procedure = .void
  arg o = .int, v = .int
  i = .int
  ix = .int
  n = .int
  cap = .int
  st = .int
  nst = .int
  ix = o % 2
  n = ob_n[ix]
  cap = ob_x[ix]
  if n >= cap then do
    cap = cap * 2
    if cap < 4 then cap = 4
    st = ob_p[ix]
    nst = alloc_slots(cap)
    do i = 0 to n - 1
      sl[nst + i] = sl[st + i]
    end
    ob_p[ix] = nst
    call orphan_block st, ob_x[ix]
    ob_x[ix] = cap
  end
  sl[ob_p[ix] + n] = v
  ob_n[ix] = n + 1
  return

/* make room for at least n elements */
list_reserve: procedure = .void
  arg o = .int, need = .int
  i = .int
  ix = .int
  n = .int
  st = .int
  nst = .int
  ix = o % 2
  if need <= ob_x[ix] then return
  n = ob_n[ix]
  st = ob_p[ix]
  nst = alloc_slots(need)
  do i = 0 to n - 1
    sl[nst + i] = sl[st + i]
  end
  ob_p[ix] = nst
  call orphan_block st, ob_x[ix]
  ob_x[ix] = need
  return

tup_of_list: procedure = .int
  arg l = .int
  t = .int
  i = .int
  n = .int
  n = ob_n[l % 2]
  t = mktuple(n)
  do i = 0 to n - 1
    sl[ob_p[t % 2] + i] = sl[ob_p[l % 2] + i]
  end
  return t

/* a tuple holding ast[base+from .. base+to] */
tup_from_ast: procedure = .int
  arg from = .int, upto = .int
  t = .int
  i = .int
  n = .int
  n = upto - from + 1
  if n < 0 then n = 0
  t = mktuple(n)
  do i = 0 to n - 1
    sl[ob_p[t % 2] + i] = ast[from + i]
  end
  return t

list_get: procedure = .int
  arg o = .int, i = .int
  return sl[ob_p[o % 2] + i]

/* ---- names, classes ---- */
nameid: procedure = .int
  arg name = .string
  v = .string
  v = nidm[name]
  if v \== "" then return v as .int
  nnid = nnid + 1
  nid_name[nnid] = name
  nidm[name] = nnid as .string
  return nnid

define_class: procedure = .int
  arg name = .string, base = .int
  c = .int
  o = .int
  i = .int
  ncls = ncls + 1
  c = ncls
  cl_name[c] = name
  cl_base[c] = base
  cl_ns[c] = 0
  cl_flags[c] = 0
  cl_mod[c] = cur_mi
  cl_bt[c] = 0
  o = newobj(K_CLASS)
  ob_x[o % 2] = c
  cl_obj[c] = o
  if base > 0 then cl_flags[c] = cl_flags[base]
  /* linearisation: the class followed by the linearisation of its base */
  cl_ms[c] = nmro + 1
  nmro = nmro + 1
  mro_a[nmro] = c
  cl_mn[c] = 1
  cl_bs[c] = nbs + 1
  cl_bn[c] = 0
  if base > 0 then do
    do i = 0 to cl_mn[base] - 1
      nmro = nmro + 1
      mro_a[nmro] = mro_a[cl_ms[base] + i]
    end
    cl_mn[c] = cl_mn[base] + 1
    nbs = nbs + 1
    bs_a[nbs] = base
    cl_bn[c] = 1
  end
  return c

/* class c gets the bases bl_a[1 .. n]; C3 linearisation.  returns 1, or 0 with a TypeError */
set_bases: procedure = .int
  arg c = .int, n = .int
  i = .int
  j = .int
  k = .int
  b = .int
  ns = .int
  tot = .int
  cand = .int
  fin = .int
  h = .int
  ok = .int
  cnt = .int
  fl = .int
  names = .string
  cl_bs[c] = nbs + 1
  do i = 1 to n
    nbs = nbs + 1
    bs_a[nbs] = bl_a[i]
  end
  cl_bn[c] = n
  cl_base[c] = bl_a[1]
  fl = 0
  do i = 1 to n
    if (cl_flags[bl_a[i]] // 4) >= 2 then fl = fl + 2
    if fl > 2 then fl = 2
  end
  cl_flags[c] = fl
  ns = n + 1
  tot = 0
  do i = 1 to n
    b = bl_a[i]
    sq_s[i] = tot + 1
    do j = 0 to cl_mn[b] - 1
      tot = tot + 1
      sq_a[tot] = mro_a[cl_ms[b] + j]
    end
    sq_e[i] = tot
    sq_p[i] = sq_s[i]
  end
  sq_s[ns] = tot + 1
  do i = 1 to n
    tot = tot + 1
    sq_a[tot] = bl_a[i]
  end
  sq_e[ns] = tot
  sq_p[ns] = sq_s[ns]
  cl_ms[c] = nmro + 1
  nmro = nmro + 1
  mro_a[nmro] = c
  cnt = 1
  fin = 0
  do while fin = 0
    cand = 0
    fin = 1
    do i = 1 to ns
      if sq_p[i] <= sq_e[i] then do
        fin = 0
        if cand = 0 then do
          h = sq_a[sq_p[i]]
          ok = 1
          do k = 1 to ns
            do j = sq_p[k] + 1 to sq_e[k]
              if sq_a[j] = h then ok = 0
            end
          end
          if ok = 1 then cand = h
        end
      end
    end
    if fin = 0 then do
      if cand = 0 then do
        names = ""
        do i = 1 to n
          if i > 1 then names = names || ", "
          names = names || cl_name[bl_a[i]]
        end
        cl_mn[c] = cnt
        call raise_exc C_TYPEERROR, "Cannot create a consistent method resolution order (MRO) for bases " || names
        return 0
      end
      nmro = nmro + 1
      mro_a[nmro] = cand
      cnt = cnt + 1
      do i = 1 to ns
        if sq_p[i] <= sq_e[i] then do
          if sq_a[sq_p[i]] = cand then sq_p[i] = sq_p[i] + 1
        end
      end
    end
  end
  cl_mn[c] = cnt
  return 1

/* the builtin container type among the bases of user class c (0 if none) */
set_btype: procedure = .void
  arg c = .int
  i = .int
  k = .int
  cl_bt[c] = 0
  do i = 1 to cl_mn[c] - 1
    k = mro_a[cl_ms[c] + i - 1]
    if k = C_DICT | k = C_LIST | k = C_TUPLE | k = C_SET | k = C_FROZENSET | k = C_STR | k = C_INT | k = C_FLOAT | k = C_BYTES | k = C_BYTEARRAY then do
      cl_bt[c] = k
      return
    end
  end
  return

/* look a name id up through the linearisation: oop or 0 */
cls_find: procedure = .int
  arg c = .int, nid = .int
  v = .string
  i = .int
  st = .int
  n = .int
  st = cl_ms[c]
  n = cl_mn[c]
  do i = 0 to n - 1
    v = ca[mro_a[st + i] || "." || nid]
    if v \== "" then return v as .int
  end
  return 0

/* the class in whose own table the name is found (0 when absent) */
cls_owner: procedure = .int
  arg c = .int, nid = .int
  v = .string
  i = .int
  st = .int
  n = .int
  st = cl_ms[c]
  n = cl_mn[c]
  do i = 0 to n - 1
    v = ca[mro_a[st + i] || "." || nid]
    if v \== "" then return mro_a[st + i]
  end
  return 0

cls_set: procedure = .void
  arg c = .int, nid = .int, v = .int
  if ca[c || "." || nid] == "" then do
    nca = nca + 1
    ca_c[nca] = c
    ca_n[nca] = nid
  end
  ca[c || "." || nid] = v as .string
  cgen = cgen + 1
  return

cls_issub: procedure = .int
  arg c = .int, base = .int
  i = .int
  st = .int
  n = .int
  if c = base then return 1
  st = cl_ms[c]
  n = cl_mn[c]
  do i = 0 to n - 1
    if mro_a[st + i] = base then return 1
  end
  return 0

cls_of: procedure = .int
  arg x = .int
  k = .int
  if x // 2 \= 0 then return C_INT
  k = ob_k[x % 2]
  if k = K_INST then return ob_c[x % 2]
  if k >= K_STR & k <= K_SET then do
    if ob_c[x % 2] > 0 then return ob_c[x % 2]
  end
  if k = K_FLOAT | k = K_BIG | k = K_BYTES then do
    if ob_c[x % 2] > 0 then return ob_c[x % 2]
  end
  if k = K_BYTES & ob_y[x % 2] = 1 then return C_BYTEARRAY
  if k = K_DVIEW then return C_DICT_KEYS + ob_n[x % 2] - 1
  return kcls[k]

kind_of: procedure = .int
  arg x = .int
  if x // 2 \= 0 then return K_INT
  return ob_k[x % 2]

/* instance attributes: slot map per class */
inst_new: procedure = .int
  arg c = .int
  o = .int
  o = newobj(K_INST)
  ob_c[o % 2] = c
  ob_n[o % 2] = cl_ns[c] + 2
  ob_p[o % 2] = alloc_slots(cl_ns[c] + 2)
  return o

inst_get: procedure = .int
  arg o = .int, nid = .int
  v = .string
  v = sm[ob_c[o % 2] || "." || nid]
  if v == "" then return 0
  return sl[ob_p[o % 2] + (v as .int) - 1]

inst_set: procedure = .void
  arg o = .int, nid = .int, val = .int
  ix = .int
  c = .int
  v = .string
  slot = .int
  nn = .int
  st = .int
  nst = .int
  i = .int
  ix = o % 2
  c = ob_c[ix]
  v = sm[c || "." || nid]
  if v == "" then do
    cl_ns[c] = cl_ns[c] + 1
    slot = cl_ns[c]
    sm[c || "." || nid] = slot as .string
    cgen = cgen + 1
    nis = nis + 1
    is_c[nis] = c
    is_n[nis] = nid
    is_s[nis] = slot
  end
  else slot = v as .int
  if slot > ob_n[ix] then do
    nn = cl_ns[c] + 2
    if nn <= slot then nn = slot + 2
    st = ob_p[ix]
    nst = alloc_slots(nn)
    do i = 0 to ob_n[ix] - 1
      sl[nst + i] = sl[st + i]
    end
    ob_p[ix] = nst
    call orphan_block st, ob_n[ix]
    ob_n[ix] = nn
  end
  sl[ob_p[ix] + slot - 1] = val
  return

inst_del: procedure = .int
  arg o = .int, nid = .int
  v = .string
  slot = .int
  v = sm[ob_c[o % 2] || "." || nid]
  if v == "" then return 0
  slot = v as .int
  if sl[ob_p[o % 2] + slot - 1] = 0 then return 0
  sl[ob_p[o % 2] + slot - 1] = 0
  return 1

/* ---- exceptions ---- */
exc_new: procedure = .int
  arg c = .int, msg = .string
  o = .int
  t = .int
  o = inst_new(c)
  t = mktuple(1)
  sl[ob_p[t % 2]] = mkstr(msg)
  call inst_set o, M_ARGS, t
  return o

exc_new0: procedure = .int
  arg c = .int
  o = .int
  o = inst_new(c)
  call inst_set o, M_ARGS, mktuple(0)
  return o

/* raise a built-in exception: sets the unwind state and returns 0 */
raise_exc: procedure = .int
  arg c = .int, msg = .string
  unw = U_RAISE
  unw_v = exc_new(c, msg)
  return 0

raise_obj: procedure = .int
  arg e = .int
  unw = U_RAISE
  unw_v = e
  return 0

type_name: procedure = .string
  arg x = .int
  return cl_name[cls_of(x)]

/* ---- truth ---- */
truthy: procedure = .int
  arg x = .int
  k = .int
  m = .int
  r = .int
  if x // 2 \= 0 then do
    if x = 1 then return 0
    return 1
  end
  if x = TRUE_OOP then return 1
  if x = FALSE_OOP | x = NONE_OOP then return 0
  k = ob_k[x % 2]
  if k >= K_STR & k <= K_SET then do
    if ob_c[x % 2] > 0 then do
      m = cls_find(ob_c[x % 2], M___BOOL__)
      if m = 0 then m = cls_find(ob_c[x % 2], M___LEN__)
      if m > 0 then do
        r = call0(m, x)
        if r = 0 then return 0
        return truthy(r)
      end
    end
  end
  select
    when k = K_STR then do
      if length(ob_s[x % 2]) > 0 then return 1
      return 0
    end
    when k = K_LIST | k = K_TUPLE then do
      if ob_n[x % 2] > 0 then return 1
      return 0
    end
    when k = K_DICT | k = K_SET then do
      if dd_n[ob_x[x % 2]] > 0 then return 1
      return 0
    end
    when k = K_FLOAT then do
      if ob_f[x % 2] = 0.0 then return 0
      return 1
    end
    when k = K_BIG then do
      if ob_s[x % 2] == "0" then return 0
      return 1
    end
    when k = K_BYTES then do
      if length(ob_s[x % 2]) > 0 then return 1
      return 0
    end
    when k = K_COMPLEX then do
      if ob_f[x % 2] \= 0.0 | ob_g[x % 2] \= 0.0 then return 1
      return 0
    end
    when k = K_ARRAY then do
      if ob_n[x % 2] = 1 then return truthy(np_scalar(x, 0))
      if ob_n[x % 2] = 0 then return 0
      r = raise_exc(C_VALUEERROR, "The truth value of an array with more than one element is ambiguous. Use a.any() or a.all()")
      return 0
    end
    when k = K_RANGE then do
      if ob_s[x % 2] \== "" then do
        call rg_split x
        if rg_lenstr(rg_sa, rg_sb, rg_sc) \== "0" then return 1
        return 0
      end
      if range_len(x) > 0 then return 1
      return 0
    end
    when k = K_DVIEW then do
      if dd_n[ob_x[ob_x[x % 2] % 2]] > 0 then return 1
      return 0
    end
    when k = K_INST then do
      m = cls_find(ob_c[x % 2], M___BOOL__)
      if m > 0 then do
        r = call0(m, x)
        if r = 0 then return 0
        return truthy(r)
      end
      m = cls_find(ob_c[x % 2], M___LEN__)
      if m > 0 then do
        r = call0(m, x)
        if r = 0 then return 0
        return truthy(r)
      end
      return 1
    end
    otherwise return 1
  end
  return 1

/* ---- dictionaries and sets ---- */
dict_new: procedure = .int
  arg kind = .int
  o = .int
  d = .int
  o = newobj(kind)
  if dd_fh > 0 then do
    d = dd_fh
    dd_fh = dd_tail[d]
  end
  else do
    ndd = ndd + 1
    d = ndd
  end
  dd_head[d] = 0
  dd_tail[d] = 0
  dd_n[d] = 0
  dd_own[d] = 0
  ob_x[o % 2] = d
  return o

dict_find: procedure = .int
  arg d = .int, key = .string
  v = .string
  v = dmap[d || "|" || key]
  if v == "" then return 0
  return v as .int

dict_put: procedure = .void
  arg d = .int, key = .string, k = .int, v = .int
  e = .int
  if key == "?" then return
  if dd_own[d] > 0 then do
    if kind_of(k) = K_STR then call inst_set dd_own[d], nameid(ob_s[k % 2]), v
  end
  e = dict_find(d, key)
  if e > 0 then do
    de_val[e] = v
    return
  end
  if de_fh > 0 then do
    e = de_fh
    de_fh = de_next[e]
  end
  else do
    nde = nde + 1
    e = nde
  end
  de_key[e] = k
  de_val[e] = v
  de_next[e] = 0
  de_live[e] = 1
  de_hk[e] = key
  if dd_tail[d] > 0 then de_next[dd_tail[d]] = e
  else dd_head[d] = e
  dd_tail[d] = e
  dd_n[d] = dd_n[d] + 1
  dmap[d || "|" || key] = e as .string
  return

dict_del: procedure = .int
  arg d = .int, key = .string
  e = .int
  e = dict_find(d, key)
  if e = 0 then return 0
  if dd_own[d] > 0 & left(key, 1) == "s" then call inst_del dd_own[d], nameid(substr(key, 2))
  de_live[e] = 0
  dd_n[d] = dd_n[d] - 1
  dmap[d || "|" || key] = ""
  return e

dict_clear: procedure = .void
  arg d = .int
  e = .int
  e = dd_head[d]
  do while e > 0
    if de_live[e] = 1 then do
      de_live[e] = 0
      dmap[d || "|" || de_hk[e]] = ""
    end
    e = de_next[e]
  end
  dd_head[d] = 0
  dd_tail[d] = 0
  dd_n[d] = 0
  return

/* first live entry at or after e */
de_live_from: procedure = .int
  arg e = .int
  do while e > 0
    if de_live[e] = 1 then return e
    e = de_next[e]
  end
  return 0

/* a set or frozenset as a dict key: order independent key of its elements */
hk_set: procedure = .string
  arg x = .int
  s = .string
  r = .int
  i = .int
  n = .int
  e = .int
  j = .int
  ka = .string[]
      n = 0
      e = dd_head[ob_x[x % 2]]
      do while e > 0
        if de_live[e] = 1 then do
          n = n + 1
          ka[n] = hashkey(de_key[e])
        end
        e = de_next[e]
      end
      do i = 2 to n
        s = ka[i]
        j = i - 1
        do while j >= 1
          if ka[j] >> s then do
            ka[j + 1] = ka[j]
            j = j - 1
          end
          else leave
        end
        ka[j + 1] = s
      end
      s = "z("
      do i = 1 to n
        s = s || length(ka[i]) || ":" || ka[i] || ","
      end
      return s || ")"

/* dict key text of an object with a user __hash__ m: its result must be an integer */
hk_user: procedure = .string
  arg m = .int, x = .int
  r = .int
  r = call0(m, x)
  if r = 0 then return "?"
  if r // 2 = 0 then do
    if ob_k[r % 2] = K_BOOL then return "h" || ival(r)
    if ob_k[r % 2] \= K_BIG then do
      r = raise_exc(C_TYPEERROR, "__hash__ method should return an integer")
      return "?"
    end
  end
  return "h" || num_str(r)

/* key of an unhashable list / dict / set / bytearray: a subclass may define __hash__ */
hk_unhash: procedure = .string
  arg x = .int
  m = .int
  r = .int
  if ob_c[x % 2] > 0 then do
    m = cls_find(ob_c[x % 2], M___HASH__)
    if m > 0 then return hk_user(m, x)
  end
  r = raise_exc(C_TYPEERROR, "unhashable type: '" || type_name(x) || "'")
  return "?"

/* key for a membership test / discard / remove on a set: a set probe is compared as a frozenset */
hashkeyp: procedure = .string
  arg x = .int
  if x // 2 = 0 then do
    if ob_k[x % 2] = K_SET then return hk_set(x)
  end
  return hashkey(x)

/* a dict key string for hashing: ints and equal floats agree */
hashkey: procedure = .string
  arg x = .int
  k = .int
  f = .float
  s = .string
  m = .int
  r = .int
  i = .int
  n = .int
  e = .int
  j = .int
  ka = .string[]
  if x // 2 \= 0 then return "i" || ((x - 1) % 2)
  k = ob_k[x % 2]
  select
    when k = K_STR then return "s" || ob_s[x % 2]
    when k = K_BOOL then do
      if x = TRUE_OOP then return "i1"
      return "i0"
    end
    when k = K_NONE then return "N"
    when k = K_BYTES then do
      if ob_y[x % 2] = 1 then return hk_unhash(x)
      return "b" || ob_s[x % 2]
    end
    when k = K_COMPLEX then do
      if ob_g[x % 2] = 0.0 & ob_f[x % 2] = ob_f[x % 2] then return hashkey(mkfloat(ob_f[x % 2]))
      return "c" || float_repr(ob_f[x % 2]) || "," || float_repr(ob_g[x % 2])
    end
    when k = K_BIG then return "i" || ob_s[x % 2]
    when k = K_FLOAT then do
      f = ob_f[x % 2]
      if f = rxfloat..floor(f) & f > -900000000000000000.0 & f < 900000000000000000.0 then return "i" || f2i(f)
      if f = rxfloat..floor(f) & finf(f) = 0 then return "i" || float_to_istr(f)
      return "f" || float_repr(f)
    end
    when k = K_TUPLE then do
      s = "t("
      n = ob_n[x % 2]
      do i = 0 to n - 1
        s = s || length(hashkey(sl[ob_p[x % 2] + i])) || ":" || hashkey(sl[ob_p[x % 2] + i]) || ","
      end
      return s || ")"
    end
    when k = K_INST then do
      m = cls_find(ob_c[x % 2], M___HASH__)
      if m > 0 then do
        /* numbers written in Python (Fraction, Decimal) that equal an int or a float key like it */
        n = cls_find(ob_c[x % 2], M___FLOAT__)
        if n > 0 then do
          r = cls_find(ob_c[x % 2], M___INT__)
          if r > 0 then do
            i = call1(r, x)
            if i \= 0 then do
              if py_eq(x, i) = 1 then return hashkey(i)
            end
          end
          i = call1(n, x)
          if i \= 0 then do
            if py_eq(x, i) = 1 then return hashkey(i)
          end
          if unw > 0 then return "?"
        end
        return hk_user(m, x)
      end
      return "o" || x
    end
    when k = K_SET then do
      /* only a frozenset is hashable; a set is a TypeError (lookups use hashkeyp) */
      if is_fs(x) = 0 then return hk_unhash(x)
      return hk_set(x)
    end
    when k = K_LIST | k = K_DICT then return hk_unhash(x)
    otherwise return "o" || x
  end
  return "o" || x

dget: procedure = .int
  arg d = .int, key = .int
  return dict_find(ob_x[d % 2], hashkey(key))

dset: procedure = .void
  arg d = .int, key = .int, v = .int
  call dict_put ob_x[d % 2], hashkey(key), key, v
  return

mkrange: procedure = .int
  arg a = .int, b = .int, c = .int
  o = .int
  o = newobj(K_RANGE)
  ob_n[o % 2] = a
  ob_x[o % 2] = b
  ob_y[o % 2] = c
  return o

range_len: procedure = .int
  arg r = .int
  a = .int
  b = .int
  c = .int
  a = ob_n[r % 2]
  b = ob_x[r % 2]
  c = ob_y[r % 2]
  if c > 0 then do
    if b <= a then return 0
    return (b - a + c - 1) % c
  end
  if a <= b then return 0
  return (a - b - c - 1) % (0 - c)
