/* ---------------------------------------------------------------------
   range objects.  A range whose start, stop and step are small ints keeps them raw in ob_n / ob_x /
   ob_y (ob_s empty); one with a bound, step or length beyond the small range keeps the three decimal
   strings joined with "|" in ob_s.  Everything below works for both.
   --------------------------------------------------------------------- */

/* the three parts of range r as decimal strings: rg_sa, rg_sb, rg_sc */
rg_split: procedure = .void
  arg r = .int
  s = .string
  p = .int
  s = ob_s[r % 2]
  if s == "" then do
    rg_sa = ob_n[r % 2] as .string
    rg_sb = ob_x[r % 2] as .string
    rg_sc = ob_y[r % 2] as .string
    return
  end
  p = pos("|", s)
  rg_sa = left(s, p - 1)
  s = substr(s, p + 1)
  p = pos("|", s)
  rg_sb = left(s, p - 1)
  rg_sc = substr(s, p + 1)
  return

/* range from three int objects (any size) */
mkrange_o: procedure = .int
  arg a = .int, b = .int, c = .int
  o = .int
  if numkind(a) = 1 & numkind(b) = 1 & numkind(c) = 1 then return mkrange(ival(a), ival(b), ival(c))
  o = newobj(K_RANGE)
  ob_n[o % 2] = 0
  ob_x[o % 2] = 0
  ob_y[o % 2] = 0
  ob_s[o % 2] = num_str(a) || "|" || num_str(b) || "|" || num_str(c)
  return o

/* number of elements of the range described by the strings, as a decimal string */
rg_lenstr: procedure = .string
  arg sa = .string, sb = .string, sc = .string
  if left(sc, 1) \== "-" then do
    if scmp(sb, sa) <= 0 then return "0"
    call sdivmod ssub(ssub(sb, sa), "1"), sc
    return sadd(sq, "1")
  end
  if scmp(sa, sb) <= 0 then return "0"
  call sdivmod ssub(ssub(sa, sb), "1"), sneg(sc)
  return sadd(sq, "1")

/* length of range r as an int object */
range_len_o: procedure = .int
  arg r = .int
  if ob_s[r % 2] == "" then return mkint(range_len(r))
  call rg_split r
  return big_norm(rg_lenstr(rg_sa, rg_sb, rg_sc))

/* len(range): OverflowError beyond the C ssize_t */
range_len_c: procedure = .int
  arg r = .int
  l = .string
  if ob_s[r % 2] == "" then return mkint(range_len(r))
  call rg_split r
  l = rg_lenstr(rg_sa, rg_sb, rg_sc)
  if length(l) > 19 | (length(l) = 19 & l >> "9223372036854775807") then return raise_exc(C_OVERFLOWERROR, "Python int too large to convert to C ssize_t")
  return big_norm(l)

/* position of the integer string sx in the range (a "0".. index as a decimal string), "" when absent */
rg_find: procedure = .string
  arg sx = .string
  c = .int
  if left(rg_sc, 1) \== "-" then do
    if scmp(sx, rg_sa) < 0 | scmp(sx, rg_sb) >= 0 then return ""
    call sdivmod ssub(sx, rg_sa), rg_sc
  end
  else do
    if scmp(sx, rg_sa) > 0 | scmp(sx, rg_sb) <= 0 then return ""
    call sdivmod ssub(rg_sa, sx), sneg(rg_sc)
  end
  if sr \== "0" then return ""
  return sq

/* index of x in range r, "" when x is not an element; non-ints compare equal to an int element */
rg_pos: procedure = .int
  arg r = .int, x = .int
  f = .float
  s = .string
  if numkind(x) = 3 then do
    f = ob_f[x % 2]
    if f \= f | finf(f) \= 0 then return 0
    if f \= rxfloat..floor(f) then return 0
    x = float_to_int(f)
  end
  if numkind(x) \= 1 & numkind(x) \= 2 then do
    if kind_of(x) = K_COMPLEX then do
      if ob_g[x % 2] \= 0.0 then return 0
      f = ob_f[x % 2]
      if f \= f | finf(f) \= 0 then return 0
      if f \= rxfloat..floor(f) then return 0
      x = float_to_int(f)
    end
    else return 0
  end
  call rg_split r
  s = rg_find(num_str(x))
  if s == "" then return 0
  rg_idx = s
  return 1

/* x in range */
range_contains: procedure = .int
  arg r = .int, x = .int
  v = .int
  a = .int
  b = .int
  st = .int
  if ob_s[r % 2] == "" & numkind(x) = 1 then do
    v = ival(x)
    a = ob_n[r % 2]
    b = ob_x[r % 2]
    st = ob_y[r % 2]
    if st > 0 then do
      if v < a | v >= b then return 0
    end
    else do
      if v > a | v <= b then return 0
    end
    if (v - a) // st = 0 then return 1
    return 0
  end
  return rg_pos(r, x)

/* r[ix] for an int object ix of any size */
range_getitem: procedure = .int
  arg o = .int, ix = .int
  n = .int
  i = .string
  v = .string
  call rg_split o
  n = 0
  i = num_str(ix)
  if left(i, 1) == "-" then i = sadd(i, rg_lenstr(rg_sa, rg_sb, rg_sc))
  if left(i, 1) == "-" | scmp(i, rg_lenstr(rg_sa, rg_sb, rg_sc)) >= 0 then return raise_exc(C_INDEXERROR, "range object index out of range")
  return big_norm(sadd(rg_sa, smul(i, rg_sc)))

/* an int object clipped to the C ssize_t range as a decimal string comparison helper:
   returns the index object clamped into [lo, hi] (all int objects) */
rg_clamp: procedure = .int
  arg x = .int, lo = .int, hi = .int
  if numcmp(x, lo) < 0 then return lo
  if numcmp(x, hi) > 0 then return hi
  return x

/* r[lo:hi:st] */
range_slice: procedure = .int
  arg o = .int, lo = .int, hi = .int, st = .int
  n = .int
  a = .int
  c = .int
  step = .int
  lower = .int
  upper = .int
  start = .int
  stop = .int
  zero = .int
  neg = .int
  call rg_split o
  n = range_len_o(o)
  a = big_norm(rg_sa)
  c = big_norm(rg_sc)
  zero = mkint(0)
  if st = NONE_OOP | st = 0 then step = mkint(1)
  else do
    if numkind(st) \= 1 & numkind(st) \= 2 then return raise_exc(C_TYPEERROR, "slice indices must be integers or None or have an __index__ method")
    step = st
  end
  if numcmp(step, zero) = 0 then return raise_exc(C_VALUEERROR, "slice step cannot be zero")
  neg = 0
  if numcmp(step, zero) < 0 then neg = 1
  if neg = 0 then do
    lower = zero
    upper = n
  end
  else do
    lower = mkint(-1)
    upper = arith(O_SUB, n, mkint(1))
  end
  if lo = NONE_OOP | lo = 0 then do
    if neg = 0 then start = lower
    else start = upper
  end
  else do
    if numkind(lo) \= 1 & numkind(lo) \= 2 then return raise_exc(C_TYPEERROR, "slice indices must be integers or None or have an __index__ method")
    start = lo
    if numcmp(start, zero) < 0 then start = arith(O_ADD, start, n)
    start = rg_clamp(start, lower, upper)
  end
  if hi = NONE_OOP | hi = 0 then do
    if neg = 0 then stop = upper
    else stop = lower
  end
  else do
    if numkind(hi) \= 1 & numkind(hi) \= 2 then return raise_exc(C_TYPEERROR, "slice indices must be integers or None or have an __index__ method")
    stop = hi
    if numcmp(stop, zero) < 0 then stop = arith(O_ADD, stop, n)
    stop = rg_clamp(stop, lower, upper)
  end
  return mkrange_o(arith(O_ADD, a, arith(O_MUL, start, c)), arith(O_ADD, a, arith(O_MUL, stop, c)), arith(O_MUL, c, step))

/* iterator over range x */
range_iter: procedure = .int
  arg x = .int
  it = .int
  if ob_s[x % 2] == "" then do
    it = mkiter(IT_RANGE, ob_n[x % 2], ob_x[x % 2])
    ob_c[it % 2] = ob_y[x % 2]
    return it
  end
  call rg_split x
  it = mkiter(IT_RANGEB, big_norm(rg_sa), big_norm(rg_sb))
  ob_c[it % 2] = big_norm(rg_sc)
  return it

/* next element of a big range iterator, 0 at the end */
rangeb_next: procedure = .int
  arg ix = .int
  v = .int
  v = ob_x[ix]
  if numcmp(ob_c[ix], mkint(0)) > 0 then do
    if numcmp(v, ob_y[ix]) >= 0 then return 0
  end
  else do
    if numcmp(v, ob_y[ix]) <= 0 then return 0
  end
  ob_x[ix] = arith(O_ADD, v, ob_c[ix])
  return v

/* range(a, b, c) == range(d, e, f) */
range_eq: procedure = .int
  arg x = .int, y = .int
  la = .string
  lb = .string
  sa = .string
  sc = .string
  call rg_split x
  la = rg_lenstr(rg_sa, rg_sb, rg_sc)
  sa = rg_sa
  sc = rg_sc
  call rg_split y
  lb = rg_lenstr(rg_sa, rg_sb, rg_sc)
  if la \== lb then return 0
  if la == "0" then return 1
  if sa \== rg_sa then return 0
  if la == "1" then return 1
  if sc \== rg_sc then return 0
  return 1

range_repr: procedure = .string
  arg x = .int
  call rg_split x
  if rg_sc == "1" then return "range(" || rg_sa || ", " || rg_sb || ")"
  return "range(" || rg_sa || ", " || rg_sb || ", " || rg_sc || ")"

/* start / stop / step */
range_attr: procedure = .int
  arg o = .int, nid = .int
  call rg_split o
  if nid = M_START then return big_norm(rg_sa)
  if nid = M_STOP then return big_norm(rg_sb)
  return big_norm(rg_sc)

/* reversed(range) */
range_reversed: procedure = .int
  arg x = .int
  l = .string
  a = .int
  c = .int
  call rg_split x
  l = rg_lenstr(rg_sa, rg_sb, rg_sc)
  if l == "0" then return range_iter(mkrange(0, 0, 1))
  a = big_norm(rg_sa)
  c = big_norm(rg_sc)
  /* start + (n - 1) * step down to start - step, stepping by -step */
  return range_iter(mkrange_o(big_norm(sadd(rg_sa, smul(ssub(l, "1"), rg_sc))), arith(O_SUB, a, c), arith(O_MUL, c, mkint(-1))))

/* range methods count / index */
meth_range: procedure = .int
  arg o = .int, nid = .int, base = .int, na = .int, nk = .int
  x = .int
  if nid = M_COUNT | nid = M_INDEX then do
    if na \= 1 then return nargs_err(nid_name[nid], na, 1, 1)
    x = ast[base + 1]
    call rg_split o
    if rg_pos(o, x) = 0 then do
      if nid = M_COUNT then return mkint(0)
      return raise_exc(C_VALUEERROR, repr_of(x) || " is not in range")
    end
    if nid = M_COUNT then return mkint(1)
    return big_norm(rg_idx)
  end
  return meth_common(o, nid, base, na, nk)
