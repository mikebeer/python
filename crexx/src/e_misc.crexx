/* ---------------------------------------------------------------------
   odds and ends: unprintable characters, str.translate / maketrans, slice.indices
   --------------------------------------------------------------------- */
/* code points that str.isprintable() / repr() treat as not printable (categories C* and Z* except the
   space), as far as can be told without the whole Unicode table */
uni_nonprint: procedure = .int
  arg c = .int
  if c < 128 then return 0
  if c <= 160 then return 1
  if c = 173 | c = 888 | c = 889 | c = 1564 | c = 1757 | c = 1807 | c = 2274 | c = 5760 | c = 6158 then return 1
  if c >= 1536 & c <= 1541 then return 1
  if c >= 8192 & c <= 8207 then return 1
  if c >= 8232 & c <= 8239 then return 1
  if c >= 8287 & c <= 8303 then return 1
  if c = 12288 | c = 65279 then return 1
  if c >= 55296 & c <= 63743 then return 1
  if c >= 65520 & c <= 65531 then return 1
  if c >= 65534 & c <= 65535 then return 1
  if c >= 119155 & c <= 119162 then return 1
  if c >= 917504 & c <= 917759 then return 1
  if c >= 917936 & c <= 921599 then return 1
  if c >= 983040 then return 1
  return 0

/* str.isprintable */
str_isprintable: procedure = .int
  arg s = .string
  i = .int
  v = .int
  do i = 1 to length(s)
    v = c2d(substr(s, i, 1))
    if v < 32 | v = 127 then return 0
    if v >= 128 then do
      if uni_nonprint(v) = 1 then return 0
    end
  end
  return 1

/* str.translate(table) */
str_translate: procedure = .int
  arg s = .string, tbl = .int
  r = .string
  i = .int
  v = .int
  e = .int
  t = .int
  ch = .string
  r = ""
  do i = 1 to length(s)
    ch = substr(s, i, 1)
    v = c2d(ch)
    t = 0
    if kind_of(tbl) = K_DICT then do
      e = dict_find(ob_x[tbl % 2], hashkey(mkint(v)))
      if e > 0 then t = de_val[e]
      else t = -1
    end
    else do
      t = getitem(tbl, mkint(v))
      if t = 0 then do
        if unw = U_RAISE then do
          if cls_issub(ob_c[unw_v % 2], C_LOOKUPERROR) = 1 then do
            unw = 0
            t = -1
          end
        end
        if t = 0 then return 0
      end
    end
    if t = -1 then r = r || ch
    else if t = NONE_OOP then nop
    else if kind_of(t) = K_STR then r = r || ob_s[t % 2]
    else if numkind(t) = 1 then r = r || utf8_chr(ival(t))
    else do
      call raise_exc C_TYPEERROR, "character mapping must return integer, None or str"
      return 0
    end
  end
  return mkstr(r)

/* str.maketrans(x [, y [, z]]) */
str_maketrans: procedure = .int
  arg a1 = .int, a2 = .int, a3 = .int, n = .int
  d = .int
  e = .int
  k = .int
  i = .int
  s1 = .string
  s2 = .string
  if n < 1 | n > 3 then return nargs_err("maketrans", n, 1, 3)
  d = dict_new(K_DICT)
  if n = 1 then do
    if kind_of(a1) \= K_DICT then return raise_exc(C_TYPEERROR, "if you give only one argument to maketrans it must be a dict")
    e = dd_head[ob_x[a1 % 2]]
    do while e > 0
      if de_live[e] = 1 then do
        k = de_key[e]
        if kind_of(k) = K_STR then do
          if length(ob_s[k % 2]) \= 1 then return raise_exc(C_VALUEERROR, "string keys in translate table must be of length 1")
          k = mkint(c2d(ob_s[k % 2]))
        end
        else if numkind(k) \= 1 then return raise_exc(C_TYPEERROR, "keys in translate table must be strings or integers")
        call dset d, k, de_val[e]
      end
      e = de_next[e]
    end
    return d
  end
  if kind_of(a1) \= K_STR | kind_of(a2) \= K_STR then return raise_exc(C_TYPEERROR, "maketrans() argument 1 must be str, not " || type_name(a1))
  s1 = ob_s[a1 % 2]
  s2 = ob_s[a2 % 2]
  if length(s1) \= length(s2) then return raise_exc(C_VALUEERROR, "the first two maketrans arguments must have equal length")
  do i = 1 to length(s1)
    call dset d, mkint(c2d(substr(s1, i, 1))), mkint(c2d(substr(s2, i, 1)))
  end
  if n = 3 then do
    if kind_of(a3) \= K_STR then return raise_exc(C_TYPEERROR, "maketrans() argument 3 must be str, not " || type_name(a3))
    s1 = ob_s[a3 % 2]
    do i = 1 to length(s1)
      call dset d, mkint(c2d(substr(s1, i, 1))), NONE_OOP
    end
  end
  return d

/* slice.indices(n) */
slice_indices: procedure = .int
  arg o = .int, nn = .int
  n = .int
  lo = .int
  hi = .int
  st = .int
  t = .int
  zero = .int
  neg = .int
  lower = .int
  upper = .int
  start = .int
  stop = .int
  step = .int
  if numkind(nn) \= 1 & numkind(nn) \= 2 then return raise_exc(C_TYPEERROR, "'" || type_name(nn) || "' object cannot be interpreted as an integer")
  n = nn
  zero = mkint(0)
  if numcmp(n, zero) < 0 then return raise_exc(C_VALUEERROR, "length should not be negative")
  lo = ob_n[o % 2]
  hi = ob_x[o % 2]
  st = ob_y[o % 2]
  if st = NONE_OOP | st = 0 then step = mkint(1)
  else do
    if numkind(st) \= 1 & numkind(st) \= 2 then return raise_exc(C_TYPEERROR, "slice indices must be integers or None or have an __index__ method")
    step = st
  end
  if numcmp(step, zero) = 0 then return raise_exc(C_VALUEERROR, "slice step cannot be zero")
  neg = 0
  if numcmp(step, zero) < 0 then neg = 1
  if neg = 0 then do
    lower = zero
    upper = n
  end
  else do
    lower = mkint(-1)
    upper = arith(O_SUB, n, mkint(1))
  end
  if lo = NONE_OOP | lo = 0 then do
    if neg = 0 then start = lower
    else start = upper
  end
  else do
    if numkind(lo) \= 1 & numkind(lo) \= 2 then return raise_exc(C_TYPEERROR, "slice indices must be integers or None or have an __index__ method")
    start = lo
    if numcmp(start, zero) < 0 then start = arith(O_ADD, start, n)
    start = rg_clamp(start, lower, upper)
  end
  if hi = NONE_OOP | hi = 0 then do
    if neg = 0 then stop = upper
    else stop = lower
  end
  else do
    if numkind(hi) \= 1 & numkind(hi) \= 2 then return raise_exc(C_TYPEERROR, "slice indices must be integers or None or have an __index__ method")
    stop = hi
    if numcmp(stop, zero) < 0 then stop = arith(O_ADD, stop, n)
    stop = rg_clamp(stop, lower, upper)
  end
  t = mktuple(3)
  sl[ob_p[t % 2]] = start
  sl[ob_p[t % 2] + 1] = stop
  sl[ob_p[t % 2] + 2] = step
  return t
