  say "t_mv" sc(rxscipy..sp_mean("t", 7.0, 0.0, 0.0, 1.0)) sc(rxscipy..sp_var("t", 7.0, 0.0, 0.0, 1.0))
  say "chi2" sc(rxscipy..sp_pdf("chi2", 0.5, 4.0, 0.0, 0.0, 1.0)) sc(rxscipy..sp_cdf("chi2", 0.5, 4.0, 0.0, 0.0, 1.0)) sc(rxscipy..sp_sf("chi2", 0.5, 4.0, 0.0, 0.0, 1.0))
