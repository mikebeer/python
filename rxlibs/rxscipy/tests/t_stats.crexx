options levelb floats_binary
import rxfnsb
import rxnumpy
import rxscipy

rr: procedure = .string
  arg x = .binary
  return rxnumpy..np_tolist(rxnumpy..np_divs(rxnumpy..np_round(rxnumpy..np_muls(x, 1000000000.0)), 1000000000.0))

sc: procedure = .string
  arg x = .float
  return rr(rxnumpy..np_array("[" || x || "]"))

main: procedure = .int
  r = 0.0
  p = 0.0
  df = 0.0
  dof = 0
  ex = rxnumpy..np_zeros("1")
  say "gamma" sc(rxscipy..sp_gamma(0.3))
  say "lgamma" sc(rxscipy..sp_lgamma(0.3))
  say "gamma" sc(rxscipy..sp_gamma(2.0))
  say "lgamma" sc(rxscipy..sp_lgamma(2.0))
  say "gamma" sc(rxscipy..sp_gamma(5.5))
  say "lgamma" sc(rxscipy..sp_lgamma(5.5))
  say "gamma" sc(rxscipy..sp_gamma(7.25))
  say "lgamma" sc(rxscipy..sp_lgamma(7.25))
  say "erf" sc(rxscipy..sp_erf(0.2))
  say "erfc" sc(rxscipy..sp_erfc(0.2))
  say "erf" sc(rxscipy..sp_erf(1.1))
  say "erfc" sc(rxscipy..sp_erfc(1.1))
  say "erf" sc(rxscipy..sp_erf(2.7))
  say "erfc" sc(rxscipy..sp_erfc(2.7))
  say "erf" sc(rxscipy..sp_erf(4.0))
  say "erfc" sc(rxscipy..sp_erfc(4.0))
  say "erfinv" sc(rxscipy..sp_erfinv(0.1))
  say "erfinv" sc(rxscipy..sp_erfinv(0.75))
  say "erfinv" sc(rxscipy..sp_erfinv(0.999))
  say "erfinv" sc(rxscipy..sp_erfinv(-0.3))
  say "beta" sc(rxscipy..sp_beta(2.5, 3.5))
  say "betainc" sc(rxscipy..sp_betainc(2.0, 5.0, 0.3))
  say "betainc" sc(rxscipy..sp_betainc(10.0, 3.5, 0.8))
  say "gammainc" sc(rxscipy..sp_gammainc(0.5, 0.4))
  say "gammaincc" sc(rxscipy..sp_gammaincc(0.5, 0.4))
  say "gammainc" sc(rxscipy..sp_gammainc(3.0, 2.0))
  say "gammaincc" sc(rxscipy..sp_gammaincc(3.0, 2.0))
  say "gammainc" sc(rxscipy..sp_gammainc(12.0, 15.5))
  say "gammaincc" sc(rxscipy..sp_gammaincc(12.0, 15.5))
  say "norm" sc(rxscipy..sp_pdf("norm", -1.0, 0.0, 0.0, 1.0, 2.0)) sc(rxscipy..sp_cdf("norm", -1.0, 0.0, 0.0, 1.0, 2.0)) sc(rxscipy..sp_sf("norm", -1.0, 0.0, 0.0, 1.0, 2.0))
  say "norm" sc(rxscipy..sp_pdf("norm", 0.5, 0.0, 0.0, 1.0, 2.0)) sc(rxscipy..sp_cdf("norm", 0.5, 0.0, 0.0, 1.0, 2.0)) sc(rxscipy..sp_sf("norm", 0.5, 0.0, 0.0, 1.0, 2.0))
  say "norm" sc(rxscipy..sp_pdf("norm", 2.8, 0.0, 0.0, 1.0, 2.0)) sc(rxscipy..sp_cdf("norm", 2.8, 0.0, 0.0, 1.0, 2.0)) sc(rxscipy..sp_sf("norm", 2.8, 0.0, 0.0, 1.0, 2.0))
  say "norm_ppf" sc(rxscipy..sp_ppf("norm", 0.05, 0.0, 0.0, 1.0, 2.0)) sc(rxscipy..sp_ppf("norm", 0.5, 0.0, 0.0, 1.0, 2.0)) sc(rxscipy..sp_ppf("norm", 0.975, 0.0, 0.0, 1.0, 2.0))
  say "norm_mv" sc(rxscipy..sp_mean("norm", 0.0, 0.0, 1.0, 2.0)) sc(rxscipy..sp_var("norm", 0.0, 0.0, 1.0, 2.0))
  say "t" sc(rxscipy..sp_pdf("t", -2.1, 7.0, 0.0, 0.0, 1.0)) sc(rxscipy..sp_cdf("t", -2.1, 7.0, 0.0, 0.0, 1.0)) sc(rxscipy..sp_sf("t", -2.1, 7.0, 0.0, 0.0, 1.0))
  say "t" sc(rxscipy..sp_pdf("t", 0.0, 7.0, 0.0, 0.0, 1.0)) sc(rxscipy..sp_cdf("t", 0.0, 7.0, 0.0, 0.0, 1.0)) sc(rxscipy..sp_sf("t", 0.0, 7.0, 0.0, 0.0, 1.0))
